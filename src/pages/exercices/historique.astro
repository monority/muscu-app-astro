---

import { t, setLocale, defaultLocale, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.historique.title}>
  <PageHeader
    title={L.historique.title}
    description={L.historique.description}
  />

  <div
    class="hist"
    x-data="exerciseHistoryApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Back link ── */}
    <a href={localizedPath("/exercices")} class="hist__back">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>{L.historique.back}</span>
    </a>

    {/* ── Not found state ── */}
    <template x-if="notFound">
      <Card>
        <div class="hist__error">
          <div class="hist__error-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h2 class="hist__error-title">{L.historique.notFound}</h2>
          <p class="hist__error-text">
            {L.historique.notFoundDesc}
          </p>
          <a href={localizedPath("/exercices")} class="hist__error-link">
            {L.historique.viewExercises}
          </a>
        </div>
      </Card>
    </template>

    {/* ── Loaded exercise ── */}
    <template x-if="!notFound && exercise">
      <div class="hist__content">
        {/* ── Header ── */}
        <header class="hist__header">
          <div class="hist__header-row">
            <div class="hist__title-block">
              <div class="hist__title-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6.5 6.5h11v11h-11z"></path>
                  <path d="M2 9v6"></path>
                  <path d="M22 9v6"></path>
                  <path d="M6.5 6.5L2 9"></path>
                  <path d="M17.5 6.5L22 9"></path>
                  <path d="M6.5 17.5L2 15"></path>
                  <path d="M17.5 17.5L22 15"></path>
                </svg>
              </div>
              <h1 class="hist__title" x-text="trExercise(exercise.name)"></h1>
            </div>
            <div class="hist__badges">
              <Badge
                variant="category"
                size="sm"
                :class="'badge--cat-' + muscleHue(exercise.muscle)"
                x-text="trMuscle(exercise.muscle)"
              ></Badge>
              <Badge variant="default" size="sm" x-text="trCategory(exercise.category)"></Badge>
            </div>
          </div>
        </header>

        {/* ── Chart ── */}
        <Card padding="lg">
          <div class="hist__chart-section">
            <header class="hist__section-head">
              <h2 class="hist__section-title">{L.historique.historyTitle}</h2>
              <span class="hist__section-meta" x-text="chartMeta"></span>
            </header>

            <template x-if="chartData.length === 0">
              <p class="hist__chart-empty">
                {L.historique.historyEmpty}
              </p>
            </template>

            <template x-if="chartData.length > 0">
              <div class="hist__chart-wrap">
                <svg
                  class="hist__chart"
                  viewBox="0 0 800 300"
                  preserveAspectRatio="xMidYMid meet"
                  role="img"
                  aria-label={L.historique.historyTitle}
                >
                  {/* Horizontal grid lines + Y labels (SVG string: Alpine x-for breaks inside <svg>) */}
                  <g x-html="chartGridMarkup"></g>

                  {/* X axis baseline */}
                  <line
                    x1="0"
                    y1="300"
                    x2="800"
                    y2="300"
                    stroke="var(--color-border)"
                    stroke-width="1"
                  />

                  {/* Soft area under the line */}
                  <polygon
                    :points="chartAreaPoints"
                    fill="url(#hist-gradient)"
                    opacity="0.18"
                  />

                  {/* Line */}
                  <polyline
                    :points="chartLinePoints"
                    fill="none"
                    stroke="var(--color-accent)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />

                  {/* Dots (SVG string: Alpine x-for breaks inside <svg>) */}
                  <g x-html="chartDotsMarkup"></g>

                  {/* Gradient defs */}
                  <defs>
                    <linearGradient id="hist-gradient" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.55" />
                      <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                </svg>

                {/* X axis date labels (subset to avoid overlap) */}
                <div class="hist__chart-x" x-show="chartData.length > 0">
                  <template x-for="(d, i) in chartData" :key="'l' + i">
                    <span
                      class="hist__chart-tick"
                      :class="{ 'hist__chart-tick--start': i === 0, 'hist__chart-tick--end': i === chartData.length - 1 }"
                      x-show="i === 0 || i === chartData.length - 1 || i === Math.floor(chartData.length / 2)"
                      x-text="formatDateShort(d.date)"
                    ></span>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </Card>

        {/* ── Stats grid ── */}
        <template x-if="history.length > 0">
          <div class="hist__stats">
            {/* Best 1RM */}
            <div class="hist__stat hist__stat--hero">
              <div class="hist__stat-head">
                <svg
                  class="hist__stat-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                  <polyline points="16 7 22 7 22 13"></polyline>
                </svg>
                <span class="hist__stat-label">{L.historique.best1RM}</span>
              </div>
              <div class="hist__stat-value-row">
                <span class="hist__stat-value" x-text="formatNumber(best1RM)"></span>
                <span class="hist__stat-unit">kg</span>
              </div>
              <span class="hist__stat-foot" x-text="best1RMDate ? formatDate(best1RMDate) : '—'"></span>
            </div>

            {/* Best weight */}
            <div class="hist__stat">
              <div class="hist__stat-head">
                <svg
                  class="hist__stat-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6.5 6.5h11"></path>
                  <path d="M6.5 17.5h11"></path>
                  <path d="M3 9v6"></path>
                  <path d="M21 9v6"></path>
                  <path d="M6.5 6.5 3 9v6l3.5 2.5h11L21 15V9l-3.5-2.5Z"></path>
                </svg>
                <span class="hist__stat-label">{L.historique.bestWeight}</span>
              </div>
              <div class="hist__stat-value-row">
                <span class="hist__stat-value" x-text="formatNumber(bestWeight)"></span>
                <span class="hist__stat-unit">kg</span>
              </div>
              <span class="hist__stat-foot" x-text="bestWeightDate ? formatDate(bestWeightDate) : '—'"></span>
            </div>

            {/* Max reps */}
            <div class="hist__stat">
              <div class="hist__stat-head">
                <svg
                  class="hist__stat-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="17 1 21 5 17 9"></polyline>
                  <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                  <polyline points="7 23 3 19 7 15"></polyline>
                  <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                </svg>
                <span class="hist__stat-label">{L.historique.maxReps}</span>
              </div>
              <div class="hist__stat-value-row">
                <span class="hist__stat-value" x-text="maxReps"></span>
                <span class="hist__stat-unit">reps</span>
              </div>
              <span class="hist__stat-foot" x-text="maxRepsDate ? formatDate(maxRepsDate) : '—'"></span>
            </div>

            {/* Total volume */}
            <div class="hist__stat">
              <div class="hist__stat-head">
                <svg
                  class="hist__stat-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 3v18h18"></path>
                  <path d="M7 14l4-4 4 4 5-5"></path>
                </svg>
                <span class="hist__stat-label">{L.historique.totalVolume}</span>
              </div>
              <div class="hist__stat-value-row">
                <span class="hist__stat-value" x-text="formatNumber(totalVolume)"></span>
                <span class="hist__stat-unit">kg</span>
              </div>
              <span class="hist__stat-foot" x-text="sessionCountLabel"></span>
            </div>
          </div>
        </template>

        {/* ── History table ── */}
        <section class="hist__table-section">
          <header class="hist__section-head">
            <h2 class="hist__section-title">{L.historique.tableTitle}</h2>
            <span class="hist__section-meta" x-text="tableMeta"></span>
          </header>

          <template x-if="history.length === 0">
            <Card>
              <EmptyState
                title={L.common.noData}
                description={L.historique.historyEmpty}
                actionLabel={L.historique.viewExercises}
                actionHref={localizedPath("/exercices")}
              />
            </Card>
          </template>

          <template x-if="history.length > 0">
            <div class="hist__table-wrap">
              <table class="hist__table">
                <thead>
                  <tr>
                    <th scope="col">{L.historique.colDate}</th>
                    <th scope="col">{L.historique.colWeight}</th>
                    <th scope="col">{L.historique.colReps}</th>
                    <th scope="col" class="hist__th-num">{L.historique.col1RM}</th>
                    <th scope="col" class="hist__th-num">{L.historique.colRpe}</th>
                    <th scope="col">{L.historique.colType}</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="(row, idx) in historyDesc" :key="idx">
                    <tr class="hist__tr">
                      <td data-label={L.historique.colDate}>
                        <div class="hist__date">
                          <span class="hist__date-main" x-text="formatDate(row.date)"></span>
                          <span class="hist__date-sub" x-text="row.sessionName"></span>
                        </div>
                      </td>
                      <td class="hist__num" data-label={L.historique.colWeight} x-text="formatNumber(row.weight) + ' kg'"></td>
                      <td class="hist__num" data-label={L.historique.colReps} x-text="row.reps"></td>
                      <td class="hist__num hist__num--accent" data-label={L.historique.col1RM} x-text="formatNumber(row.estimated1RM) + ' kg'"></td>
                      <td class="hist__num" data-label={L.historique.colRpe} x-text="formatRpe(row)"></td>
                      <td data-label={L.historique.colType}>
                        <span
                          class="hist__type"
                          :class="'hist__type--' + row.type"
                          x-text="typeLabel(row.type)"
                        ></span>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </template>
        </section>
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import { t, getLocale } from '../../i18n';
  import {
    getExerciseById,
    getSessions,
    calculate1RM,
    type Exercise,
    type RpeType,
    type SetType,
  } from '../../lib/storage';

  const LABELS = t();

  /**
   * One row of the exercise history.
   * - `estimated1RM` is recomputed at read time via the Epley formula.
   * - `sessionName` is denormalised so the table can show context without
   *   a second join.
   */
  interface HistoryRow {
    date: string;
    weight: number;
    reps: number;
    rpe: number | null;
    rpeType?: RpeType;
    type: SetType;
    estimated1RM: number;
    sessionName: string;
  }

  /** One data point on the 1RM evolution chart (best 1RM per date). */
  interface ChartPoint {
    date: string;
    rm: number;
  }

  // Chart geometry — kept as constants so the template stays readable.
  const CHART_W = 800;
  const CHART_H = 300;

  function fmtNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US');
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }

  function fmtDateShort(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'short',
    });
  }

  function typeLabelFn(t: SetType): string {
    switch (t) {
      case 'warmup':  return LABELS.historique.typeWarmup;
      case 'work':    return LABELS.historique.typeWork;
      case 'top':     return LABELS.historique.typeTop;
      case 'drop':    return LABELS.historique.typeDrop;
      case 'failure': return LABELS.historique.typeFailure;
    }
  }

  /**
   * Per-set RPE display label: "RPE 7.5" or "uRPE 7".
   * Absent rpeType falls back to plain RPE; missing value renders '—'.
   */
  function fmtRpe(rpe: number | string | null | undefined, rpeType?: RpeType): string {
    const v = typeof rpe === 'string' ? Number(rpe) : rpe;
    if (v == null || !Number.isFinite(v)) return '—';
    return (rpeType === 'urpe' ? 'uRPE ' : 'RPE ') + v.toString();
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('exerciseHistoryApp', () => ({
      // ── State ──
      exercise: null as Exercise | null,
      notFound: false,
      history: [] as HistoryRow[],
      chartData: [] as ChartPoint[],

      // Aggregates
      best1RM: 0,
      best1RMDate: '',
      bestWeight: 0,
      bestWeightDate: '',
      maxReps: 0,
      maxRepsDate: '',
      totalVolume: 0,
      sessionCount: 0,

      // ── Init ──
      init() {
        const params = new URLSearchParams(window.location.search);
        const exerciseId = params.get('id');
        if (!exerciseId) {
          this.notFound = true;
          return;
        }
        const found = getExerciseById(exerciseId);
        if (!found) {
          this.notFound = true;
          return;
        }
        this.exercise = found;
        this.computeHistory();
      },

      // ── Pure computations ──
      computeHistory() {
        if (!this.exercise) return;
        const exerciseId = this.exercise.id;
        const sessions = getSessions();
        const rows: HistoryRow[] = [];

        for (const session of sessions) {
          for (const ex of session.exercises) {
            if (ex.exerciseId !== exerciseId) continue;
            for (const set of ex.sets) {
              if (!set.completed) continue;
              rows.push({
                date: session.date,
                weight: set.weight,
                reps: set.reps,
                rpe: set.rpe ?? null,
                rpeType: set.rpeType,
                type: set.type,
                estimated1RM: calculate1RM(set.weight, set.reps),
                sessionName: session.name,
              });
            }
          }
        }

        // Sort ascending by date for chart and time-based lookups.
        this.history = rows.sort(
          (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
        );

        // Best 1RM per date → chart points.
        const byDate = new Map<string, number>();
        for (const row of this.history) {
          const current = byDate.get(row.date) ?? 0;
          if (row.estimated1RM > current) byDate.set(row.date, row.estimated1RM);
        }
        this.chartData = Array.from(byDate.entries())
          .map(([date, rm]) => ({ date, rm }))
          .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

        // Stats.
        this.computeStats();
      },

      computeStats() {
        if (this.history.length === 0) {
          this.best1RM = 0;
          this.best1RMDate = '';
          this.bestWeight = 0;
          this.bestWeightDate = '';
          this.maxReps = 0;
          this.maxRepsDate = '';
          this.totalVolume = 0;
          this.sessionCount = 0;
          return;
        }

        let bestRm = 0;
        let bestRmDate = '';
        let bestW = 0;
        let bestWDate = '';
        let maxR = 0;
        let maxRDate = '';
        let volume = 0;
        const uniqueSessions = new Set<string>();

        for (const row of this.history) {
          if (row.estimated1RM > bestRm) {
            bestRm = row.estimated1RM;
            bestRmDate = row.date;
          }
          if (row.weight > bestW) {
            bestW = row.weight;
            bestWDate = row.date;
          }
          if (row.reps > maxR) {
            maxR = row.reps;
            maxRDate = row.date;
          }
          volume += row.weight * row.reps;
          uniqueSessions.add(row.date + '|' + row.sessionName);
        }

        this.best1RM = bestRm;
        this.best1RMDate = bestRmDate;
        this.bestWeight = bestW;
        this.bestWeightDate = bestWDate;
        this.maxReps = maxR;
        this.maxRepsDate = maxRDate;
        this.totalVolume = volume;
        this.sessionCount = uniqueSessions.size;
      },

      // ── Derived (display) ──
      get chartMeta(): string {
        return (
          this.chartData.length +
          ' ' +
          LABELS.historique.sessions +
          ' — ' +
          LABELS.historique.best1RM +
          ' : ' +
          this.formatNumber(this.best1RM) +
          ' ' +
          LABELS.common.kg
        );
      },

      get tableMeta(): string {
        return this.history.length + ' ' + LABELS.historique.sets;
      },

      get sessionCountLabel(): string {
        return (
          this.sessionCount +
          ' ' +
          (this.sessionCount > 1
            ? LABELS.historique.sessions
            : LABELS.historique.sessionSingular)
        );
      },

      get historyDesc(): HistoryRow[] {
        // Most recent first for the table.
        return this.history.slice().reverse();
      },

      get chartMax(): number {
        // Scale headroom: 10% above the peak so the top dot doesn't kiss the border.
        const peak = this.chartData.reduce((m, d) => (d.rm > m ? d.rm : m), 0);
        return Math.max(peak * 1.1, 10);
      },

      // ── Chart geometry helpers ──
      chartX(i: number): number {
        const n = this.chartData.length;
        if (n <= 1) return CHART_W / 2;
        return (i / (n - 1)) * CHART_W;
      },

      chartY(rm: number): number {
        const max = this.chartMax;
        if (max <= 0) return CHART_H;
        return CHART_H - (rm / max) * CHART_H;
      },

      get chartLinePoints(): string {
        return this.chartData
          .map((d, i) => `${this.chartX(i)},${this.chartY(d.rm)}`)
          .join(' ');
      },

      get chartAreaPoints(): string {
        if (this.chartData.length === 0) return '';
        const top = this.chartData
          .map((d, i) => `${this.chartX(i)},${this.chartY(d.rm)}`)
          .join(' ');
        // Close the polygon along the X axis at y = CHART_H.
        const last = this.chartData.length - 1;
        return `${top} ${this.chartX(last)},${CHART_H} ${this.chartX(0)},${CHART_H}`;
      },

      get chartGridMarkup(): string {
        let s = '';
        for (let i = 1; i <= 5; i++) {
          const y = (i - 1) * 75;
          s += `<line x1="0" y1="${y}" x2="800" y2="${y}" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="2 4"></line>`;
          s += `<text x="6" y="${y - 4}" fill="var(--color-muted)" font-size="11" font-family="var(--font-body)">${this.formatNumber(this.chartMax * (1 - (i - 1) / 5))} kg</text>`;
        }
        return s;
      },

      get chartDotsMarkup(): string {
        return this.chartData
          .map(
            (d, i) =>
              `<g><circle cx="${this.chartX(i)}" cy="${this.chartY(d.rm)}" r="6" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="2.5"></circle><title>${this.formatDate(d.date)} — ${this.formatNumber(d.rm)} kg</title></g>`
          )
          .join('');
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return fmtDate(iso);
      },
      formatDateShort(iso: string): string {
        return fmtDateShort(iso);
      },
      typeLabel(t: SetType): string {
        return typeLabelFn(t);
      },
      formatRpe(row: HistoryRow): string {
        return fmtRpe(row.rpe, row.rpeType);
      },
    }));
  });
</script>

{/* Alpine.js CDN — MUST be AFTER the app script (type="module" runs before defer) */}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<style>
  /* Hide Alpine elements until initialized (prevents flash) */
  [x-cloak] {
    display: none !important;
  }

  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .hist {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hist__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ════════════════════════════════════════════════════
     BACK LINK
     ════════════════════════════════════════════════════ */
  .hist__back {
    display: inline-flex;
