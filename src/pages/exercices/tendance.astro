---
import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import Segmented from '../../components/ui/Segmented.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.tendance.title}>
  <PageHeader
    title={L.tendance.title}
    description={L.tendance.description}
  />

  <div
    class="max-w-[96rem] mx-auto pb-[6rem] flex flex-col gap-5"
    x-data="exerciseTrendApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Back link ── */}
    <a href={localizedPath("/exercices")} class="trend__back-custom inline-flex items-center gap-[0.6rem] text-muted text-[1.3rem] font-semibold no-underline self-start py-1 pr-[0.6rem] pl-1 -ml-1 rounded-sm">
      <Fragment set:html={icons.arrowLeft()} />
      <span>{L.tendance.back}</span>
    </a>

    {/* ── Not found state ── */}
    <template x-if="notFound">
      <Card>
        <div class="flex flex-col items-center text-center gap-3 py-5 max-w-[32rem] mx-auto">
          <div class="trend__error-icon-bg inline-flex items-center justify-center w-[6rem] h-[6rem] rounded-full text-destructive" aria-hidden="true">
            <Fragment set:html={icons.infoCircle(30, 30)} />
          </div>
          <h2 class="font-display text-[2rem] text-text">{L.tendance.notFound}</h2>
          <p class="text-muted text-[1.3rem] leading-[1.5]">{L.tendance.notFoundDesc}</p>
          <a href={localizedPath("/exercices")} class="trend__error-link-custom inline-flex items-center h-[4.2rem] px-[1.8rem] bg-accent text-accent-foreground rounded-md font-bold text-[1.3rem] no-underline mt-1 hover:bg-accent-hover">
            {L.tendance.viewExercises}
          </a>
        </div>
      </Card>
    </template>

    {/* ── Loaded exercise ── */}
    <template x-if="!notFound && exercise">
      <div class="flex flex-col gap-5">
        {/* ── Controls ── */}
        <Card padding="md">
          <div class="flex flex-col gap-[1.4rem] sm:flex-row sm:items-end sm:gap-4 sm:flex-wrap">
            {/* Exercise selector */}
            <div class="flex flex-col gap-[0.6rem] min-w-0 flex-[1_1_24rem]">
              <label class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold" for="trend-exercise">
                {L.tendance.exercise}
              </label>
              <div class="relative min-w-0 w-full sm:min-w-[22rem] sm:w-auto">
                <select
                  id="trend-exercise"
                  class="trend__select-custom w-full truncate h-[4.4rem] pl-[1.4rem] pr-[4rem] bg-surface-2 border border-border rounded-sm text-text font-body text-[1.4rem] leading-[1.2] outline-none cursor-pointer"
                  :value="selectedId"
                  @change="onExerciseChange($event.target.value)"
                >
                  <template x-for="ex in exercises" :key="ex.id">
                    <option :value="ex.id" x-text="trExercise(ex.name)"></option>
                  </template>
                </select>
                <Fragment set:html={icons.chevronDown(16, 16)} />
              </div>
            </div>

            {/* Metric toggle */}
            <div class="flex flex-col gap-[0.6rem] min-w-0">
              <span class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold" id="trend-metric-label">
                {L.tendance.metric}
              </span>
              <Segmented
                items={[
                  { value: 'volume', label: L.tendance.metricVolume },
                  { value: 'rm', label: L.tendance.metric1RM },
                ]}
                model="metric"
                ariaLabel={L.tendance.metric}
              />
            </div>

            {/* Period toggle */}
            <div class="flex flex-col gap-[0.6rem] min-w-0">
              <span class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold" id="trend-period-label">
                {L.tendance.period}
              </span>
              <Segmented
                items={[
                  { value: 'all', label: L.tendance.periodAll },
                  { value: '3m', label: L.tendance.period3m },
                  { value: '1y', label: L.tendance.period1y },
                ]}
                model="period"
                ariaLabel={L.tendance.period}
              />
            </div>
          </div>
        </Card>

        {/* ── Chart ── */}
        <Card padding="lg">
          <div class="flex flex-col">
            <header class="flex items-baseline justify-between gap-3 flex-wrap mb-[1.4rem]">
              <h2 class="font-display text-[1.4rem] font-bold uppercase tracking-[0.14em] text-text m-0 break-words" x-text="chartTitle"></h2>
              <span class="text-[1.2rem] text-muted font-medium" x-text="chartMeta"></span>
            </header>

            {/* Empty state: 0 points, or <2 points (not enough to draw a curve) */}
            <template x-if="points.length < 2">
              <div class="flex flex-col items-center gap-2 pt-[2.8rem] px-3 pb-[2.4rem] text-center" role="status">
                <div class="inline-flex items-center justify-center w-[4.4rem] h-[4.4rem] border border-border rounded-full text-accent font-display text-[2rem] font-bold" aria-hidden="true">—</div>
                <h3 class="mt-1 text-text font-display text-[1.6rem] font-bold">{L.tendance.emptyTitle}</h3>
                <p class="max-w-[34rem] m-0 text-muted text-[1.3rem] leading-[1.5]" x-text="emptyMessage"></p>
                <a href={localizedPath("/seances/rapide")} class="trend__empty-link-custom inline-flex items-center justify-center min-h-[4.2rem] mt-[0.6rem] px-4 rounded-md bg-accent text-accent-foreground text-[1.3rem] font-bold no-underline hover:bg-accent-hover">
                  {L.common.startSession}
                </a>
              </div>
            </template>

            <template x-if="points.length >= 2">
              <div class="flex flex-col gap-2">
                <svg
                  class="trend__chart"
                  viewBox="0 0 800 300"
                  preserveAspectRatio="xMidYMid meet"
                  role="img"
                  :aria-label="chartTitle"
                >
                  {/* Horizontal grid lines + Y labels (SVG string: Alpine x-for breaks inside <svg>) */}
                  <g x-html="chartGridMarkup"></g>

                  {/* X axis baseline */}
                  <line
                    x1="0"
                    y1="300"
                    x2="800"
                    y2="300"
                    stroke="var(--color-border)"
                    stroke-width="1"
                  />

                  {/* Soft area under the line */}
                  <polygon
                    :points="chartAreaPoints"
                    fill="url(#trend-gradient)"
                    opacity="0.18"
                  />

                  {/* Line */}
                  <polyline
                    :points="chartLinePoints"
                    fill="none"
                    stroke="var(--color-accent)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />

                  {/* Dots (SVG string: Alpine x-for breaks inside <svg>) */}
                  <g x-html="chartDotsMarkup"></g>

                  {/* Gradient defs */}
                  <defs>
                    <linearGradient id="trend-gradient" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.55" />
                      <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                </svg>

                {/* X axis date labels (subset to avoid overlap) */}
                <div class="trend__chart-x" x-show="points.length > 0">
                  <template x-for="(d, i) in points" :key="'l' + i">
                    <span
                      class="trend__chart-tick"
                      :class="{ 'trend__chart-tick--start': i === 0, 'trend__chart-tick--end': i === points.length - 1 }"
                      x-show="i === 0 || i === points.length - 1 || i === Math.floor(points.length / 2)"
                      x-text="formatDateShort(d.date)"
                    ></span>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </Card>
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import { t, getLocale, trExercise } from '../../i18n';
  import {
    getExercises,
    getExerciseById,
    getSessions,
    calculate1RM,
    type Exercise,
    type Session,
  } from '../../lib/storage';

  const LABELS = t();

  /** One data point on the trend chart (per-session date aggregation). */
  interface TrendPoint {
    date: string;
    value: number;
  }

  type Metric = 'volume' | 'rm';
  type Period = 'all' | '3m' | '1y';

  // Chart geometry — same convention as /exercices/historique.
  const CHART_W = 800;
  const CHART_H = 300;

  function monthAgo(months: number): number {
    const d = new Date();
    d.setMonth(d.getMonth() - months);
    return d.getTime();
  }

  function fmtNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US');
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }

  function fmtDateShort(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'short',
    });
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('exerciseTrendApp', () => ({
      // ── State ──
      exercises: [] as Exercise[],
      selectedId: '',
      exercise: null as Exercise | null,
      notFound: false,
      metric: 'volume' as Metric,
      period: 'all' as Period,

      // ── Init ──
      init() {
        this.exercises = getExercises();

        const params = new URLSearchParams(window.location.search);
        const exParam = params.get('ex');
        let found: Exercise | undefined;
        if (exParam) {
          found = getExerciseById(exParam);
          if (!found) found = this.exercises.find((e) => e.name === exParam);
          if (!found) {
            this.notFound = true;
            return;
          }
        } else {
          found = this.exercises[0];
          if (!found) {
            this.notFound = true;
            return;
          }
        }

        this.selectedId = found.id;
        this.exercise = found;
      },

      onExerciseChange(value: string) {
        this.selectedId = value;
        this.exercise = this.exercises.find((e) => e.id === value) ?? null;
      },

      // ── Data aggregation ──
      // Per date: Volume = Σ (weight × reps) / 1RM = max Epley estimate,
      // over completed sets only (same convention as /exercices/historique).
      get points(): TrendPoint[] {
        if (!this.exercise) return [];
        const sessions: Session[] = getSessions();

        const byDate = new Map<string, { vol: number; rm: number }>();
        for (const session of sessions) {
          for (const ex of session.exercises) {
            if (ex.exerciseId !== this.exercise.id) continue;
            let vol = 0;
            let rm = 0;
            for (const set of ex.sets) {
              if (!set.completed) continue;
              vol += set.weight * set.reps;
              const estimate = calculate1RM(set.weight, set.reps);
              if (estimate > rm) rm = estimate;
            }
            const cur = byDate.get(session.date) ?? { vol: 0, rm: 0 };
            cur.vol += vol;
            cur.rm = Math.max(cur.rm, rm);
            byDate.set(session.date, cur);
          }
        }

        // Period filter.
        const minTime =
          this.period === '3m'
            ? monthAgo(3)
            : this.period === '1y'
              ? monthAgo(12)
              : null;

        let pts = Array.from(byDate.entries()).map(([date, v]) => ({
          date,
          value: this.metric === 'volume' ? v.vol : v.rm,
        }));
        if (minTime !== null) {
          pts = pts.filter((p) => new Date(p.date).getTime() >= minTime);
        }

        return pts.sort(
          (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
        );
      },

      // ── Derived (display) ──
      get chartTitle(): string {
        if (!this.exercise) return '';
        const t = trExercise(this.exercise.name);
        return this.metric === 'volume'
          ? `${t} — ${LABELS.tendance.chartVolumeTitle}`
          : `${t} — ${LABELS.tendance.chart1RMTitle}`;
      },

      get chartMeta(): string {
        const n = this.points.length;
        return `${n} ${n > 1 ? LABELS.historique.sessions : LABELS.historique.sessionSingular}`;
      },

      get emptyMessage(): string {
        return this.points.length === 0
          ? LABELS.tendance.noSessions
          : LABELS.tendance.minPoints;
      },

      get chartMax(): number {
        // Scale headroom: 10% above the peak so the top dot doesn't kiss the border.
        const peak = this.points.reduce((m, d) => (d.value > m ? d.value : m), 0);
        return Math.max(peak * 1.1, 10);
      },

      // ── Chart geometry helpers ──
      chartX(i: number): number {
        const n = this.points.length;
        if (n <= 1) return CHART_W / 2;
        return (i / (n - 1)) * CHART_W;
      },

      chartY(v: number): number {
        const max = this.chartMax;
        if (max <= 0) return CHART_H;
        return CHART_H - (v / max) * CHART_H;
      },

      get chartLinePoints(): string {
        return this.points
          .map((d, i) => `${this.chartX(i)},${this.chartY(d.value)}`)
          .join(' ');
      },

      get chartAreaPoints(): string {
        if (this.points.length === 0) return '';
        const top = this.points
          .map((d, i) => `${this.chartX(i)},${this.chartY(d.value)}`)
          .join(' ');
        const last = this.points.length - 1;
        return `${top} ${this.chartX(last)},${CHART_H} ${this.chartX(0)},${CHART_H}`;
      },

      get chartGridMarkup(): string {
        let s = '';
        for (let i = 1; i <= 5; i++) {
          const y = (i - 1) * 75;
          s += `<line x1="0" y1="${y}" x2="800" y2="${y}" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="2 4"></line>`;
          s += `<text x="6" y="${y - 4}" fill="var(--color-muted)" font-size="11" font-family="var(--font-body)">${this.formatNumber(this.chartMax * (1 - (i - 1) / 5))} ${LABELS.common.kg}</text>`;
        }
        return s;
      },

      get chartDotsMarkup(): string {
        return this.points
          .map(
            (d, i) =>
              `<g><circle cx="${this.chartX(i)}" cy="${this.chartY(d.value)}" r="6" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="2.5"></circle><title>${this.formatDate(d.date)} — ${this.formatNumber(d.value)} ${LABELS.common.kg}</title></g>`
          )
          .join('');
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return fmtDate(iso);
      },
      formatDateShort(iso: string): string {
        return fmtDateShort(iso);
      },
    }));
  });
</script>

<style>
  .trend__back-custom {
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .trend__back-custom:hover {
    color: var(--color-accent);
    background-color: var(--alpha-bg-subtle);
  }
  .trend__back-custom:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .trend__back-custom svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .trend__select-custom {
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    -webkit-appearance: none;
    appearance: none;
  }
  .trend__select-custom:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .trend__empty-link-custom {
    transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .trend__empty-link-custom:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .trend__error-icon-bg {
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
  }
  .trend__error-icon-bg svg {
    width: 3rem;
    height: 3rem;
  }

  .trend__error-link-custom {
    transition: background-color var(--transition-fast);
  }

  .trend__chart {
    width: 100%;
    height: auto;
    max-height: 32rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.2rem;
  }

  .trend__chart-x {
    display: flex;
    justify-content: space-between;
    padding: 0 1.2rem;
    color: var(--color-muted);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .trend__chart-tick {
    font-variant-numeric: tabular-nums;
  }

  .trend__chart-tick--start,
  .trend__chart-tick--end {
    color: var(--color-text);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .trend__back-custom,
    .trend__empty-link-custom,
    .trend__error-link-custom,
    .trend__select-custom {
      transition: none;
    }
  }
</style>
