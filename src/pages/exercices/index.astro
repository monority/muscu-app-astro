    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .exo__card-icon {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .exo__set-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.4rem;
    padding: 0 0.9rem;
    background-color: color-mix(in srgb, var(--color-success) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-success) 30%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-success);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .exo__set-icon {
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
  }

  .exo__set-label {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .exo__card-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    word-break: break-word;
  }

  /* ── Tip toggle + tip body (added 2026-08-04) ── */
  .exo__tip-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.0rem;
    height: 3.0rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform var(--transition-fast);
  }

  .exo__tip-toggle:hover {
    background-color: var(--color-surface-3);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .exo__tip-toggle:active {
    transform: scale(0.94);
  }

  .exo__tip-toggle svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .exo__tip {
    margin: 0;
    padding: 1.0rem 1.2rem;
    background-color: var(--color-surface-2);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  /* ── YouTube technique link (added 2026-08-04) ── */
  .exo__tip-video {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
    padding: 0.5rem 0.9rem;
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 32%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-destructive);
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform var(--transition-fast);
  }

  .exo__tip-video:hover {
    background-color: color-mix(in srgb, var(--color-destructive) 18%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 50%, transparent);
    color: var(--color-destructive);
  }

  .exo__tip-video:active {
    transform: scale(0.97);
  }

  .exo__tip-video svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: currentColor;
    stroke: currentColor;
    flex-shrink: 0;
  }

  .exo__tip-video svg polygon {
    fill: currentColor;
    stroke: none;
  }

  .exo__card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .exo__card-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .exo__icon-btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    width: 4.4rem;
    height: 4.4rem;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast);
  }

  .exo__icon-btn:hover {
    background-color: var(--alpha-bg-soft);
    border-color: var(--alpha-border-faint);
    color: var(--color-text);
  }

  .exo__icon-btn:active {
    transform: scale(0.94);
  }

  .exo__icon-btn--danger:hover {
    background-color: color-mix(in srgb, var(--color-destructive) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 40%, transparent);
    color: var(--color-destructive);
  }

  .exo__icon-btn--accent:hover {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    color: var(--color-accent);
  }

  .exo__icon-btn--trend:hover {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    color: var(--color-accent);
  }

  .exo__fav-btn {
    color: var(--color-muted);
  }

  .exo__fav-btn.is-fav {
    color: var(--color-warning);
  }

  .exo__fav-btn.is-fav:hover {
    color: var(--color-warning);
  }

  .exo__icon {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  /* ════════════════════════════════════════════════════
     EMPTY STATE CTA
     ════════════════════════════════════════════════════ */
  .exo__empty-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.4rem 0 0.8rem;
  }

  .exo__reset-btn {
    display: inline-flex;
    align-items: center;
    height: 4.4rem;
    padding: 0 1.6rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                color var(--transition-fast),
                border-color var(--transition-fast);
  }

  .exo__reset-btn:hover {
    background-color: var(--color-surface-2);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  /* ════════════════════════════════════════════════════
     FORM
     ════════════════════════════════════════════════════ */
  .exo__form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-top: 0.8rem;
  }

  .exo__field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .exo__label {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--color-muted);
    line-height: 1.2;
  }

  .exo__label-req {
    color: var(--color-destructive);
    margin-left: 0.2rem;
  }

  .exo__input,
  .exo__select {
    width: 100%;
    height: 4.4rem;
    padding: 0 1.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    line-height: 1.2;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .exo__input::placeholder {
    color: var(--alpha-text-faint);
  }

  .exo__input:focus,
  .exo__select:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .exo__select-wrap {
    position: relative;
  }

  .exo__select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    cursor: pointer;
    padding-right: 4rem;
  }

  .exo__select-icon {
    position: absolute;
    right: 1.4rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-muted);
    pointer-events: none;
  }

  .exo__form-error {
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 35%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-destructive);
    font-size: 1.2rem;
    font-weight: 500;
    padding: 0.8rem 1.2rem;
  }

  .exo__form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-top: 0.6rem;
  }

  /* ── Buttons (form) ── */
  .exo__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 4.4rem;
    padding: 0 2rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    min-width: 8rem;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                box-shadow var(--transition-fast),
                transform var(--transition-fast);
  }

  .exo__btn:active {
    transform: scale(0.97);
  }

  .exo__btn--primary {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    border-color: var(--color-accent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .exo__btn--primary:hover {
    background-color: var(--color-accent-hover);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .exo__btn--secondary {
    background-color: transparent;
    color: var(--color-muted);
    border-color: var(--color-border);
  }

  .exo__btn--secondary:hover {
    background-color: var(--alpha-bg-soft);
    border-color: var(--alpha-border);
    color: var(--color-text);
  }

  .exo__btn--destructive {
    background-color: var(--color-destructive);
    color: var(--color-accent-foreground);
    border-color: var(--color-destructive);
  }

  .exo__btn--destructive:hover {
    background-color: var(--color-destructive);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-destructive) 35%, transparent);
  }

  /* ════════════════════════════════════════════════════
     CONFIRM DIALOG
     ════════════════════════════════════════════════════ */
  .exo__confirm-text {
    color: var(--color-text);
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .exo__confirm-text strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  /* ════════════════════════════════════════════════════
     RESPONSIVE — small screens
     ════════════════════════════════════════════════════ */
  @media (max-width: 480px) {
    .exo__toolbar {
      gap: 1.2rem;
    }
    .exo__search-input {
      height: 4.4rem;
      font-size: 1.3rem;
    }
    .exo__filter {
      height: 4.0rem;
      font-size: 1.2rem;
      padding: 0 1.4rem;
    }
    .exo__card {
      padding: 1.6rem;
    }
    .exo__card-name {
      font-size: 1.5rem;
    }
  }

  /* ════════════════════════════════════════════════════
     ADD-TO-SESSION DIALOG
     ════════════════════════════════════════════════════ */
  :global(#exo-add-to-session-dialog) {
    max-width: 56rem;
    width: auto;
  }

  .exo__add-dialog {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .exo__add-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.2rem;
  }

  .exo__add-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .exo__add-title {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    word-break: break-word;
  }

  .exo__add-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    flex-shrink: 0;
    background-color: var(--alpha-bg-soft);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color var(--transition-fast),
                color var(--transition-fast);
  }

  .exo__add-close:hover {
    background-color: var(--alpha-border-faint);
    color: var(--color-text);
  }

  .exo__add-close svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .exo__add-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* ════════════════════════════════════════════════════
     SETS TABLE — desktop grid, mobile stacked cards
     ════════════════════════════════════════════════════ */
  .exo__add-sets {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .exo__add-sets-header {
    display: grid;
    grid-template-columns: 3.2rem 1fr 8rem 6rem 3.2rem;
    gap: 0.6rem;
    align-items: center;
    padding: 0 0.2rem;
    font-family: var(--font-body);
    font-size: 1.0rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--color-muted);
    line-height: 1.2;
  }

  .exo__add-sets-header span:nth-child(3),
  .exo__add-sets-header span:nth-child(4) {
    text-align: center;
  }

  .exo__add-sets-row {
    display: grid;
    grid-template-columns: 3.2rem 1fr 8rem 6rem 3.2rem;
    gap: 0.6rem;
    align-items: center;
  }

  .exo__add-sets-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    margin-left: 0.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .exo__add-sets-type,
  .exo__add-sets-weight,
  .exo__add-sets-reps {
    min-width: 0;
  }

  .exo__add-sets-label {
    display: none;
    font-size: 1.0rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.3rem;
  }

  .exo__select--compact,
  .exo__input--compact {
    height: 4.0rem;
    font-size: 1.3rem;
    padding: 0 1.2rem;
  }

  .exo__select--compact {
    padding-right: 3.4rem;
  }

  .exo__add-sets-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast);
  }

  .exo__add-sets-remove:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--color-destructive) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 40%, transparent);
    color: var(--color-destructive);
  }

  .exo__add-sets-remove:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .exo__add-sets-remove svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .exo__add-sets-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    height: 4.0rem;
    margin-top: 0.4rem;
    background-color: transparent;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast);
  }

  .exo__add-sets-add:hover {
    background-color: var(--alpha-bg-subtle);
    border-color: var(--alpha-border);
    border-style: solid;
    color: var(--color-text);
  }

  .exo__add-sets-add svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* ── Sets table action row (warmup + add) ── */
  .exo__add-sets-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  @media (min-width: 640px) {
    .exo__add-sets-actions {
      flex-direction: row;
      align-items: stretch;
    }
    .exo__add-sets-actions .exo__add-sets-warmup {
      flex: 0 0 auto;
    }
    .exo__add-sets-actions .exo__add-sets-add {
      flex: 1 1 auto;
      margin-top: 0;
    }
  }

  /* ── Warmup auto-generation button (dashed accent) ── */
  .exo__add-sets-warmup {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    height: 4.0rem;
    padding: 0 1.4rem;
    background-color: transparent;
    border: 1px dashed var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                border-style var(--transition-fast),
                color var(--transition-fast);
  }

  .exo__add-sets-warmup:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-style: solid;
  }

  .exo__add-sets-warmup:disabled {
    opacity: 0.40;
    cursor: not-allowed;
    background-color: transparent;
    color: var(--color-muted);
    border-color: var(--color-border);
  }

  .exo__add-sets-warmup svg {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  /* ── Sets table: mobile (stacked cards) ── */
  @media (max-width: 640px) {
    .exo__add-sets-header {
      display: none;
    }
    .exo__add-sets-row {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "num    remove"
        "type   type"
        "weight reps";
      gap: 0.8rem;
      padding: 1rem;
      background-color: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
    }
    .exo__add-sets-num { grid-area: num; justify-self: start; }
    .exo__add-sets-remove { grid-area: remove; justify-self: end; }
    .exo__add-sets-type { grid-area: type; }
    .exo__add-sets-weight { grid-area: weight; }
    .exo__add-sets-reps { grid-area: reps; }
    .exo__add-sets-label { display: block; }
  }

  .exo__add-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-top: 0.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
  }

  /* ════════════════════════════════════════════════════
     SUCCESS TOAST
     ════════════════════════════════════════════════════ */
  .exo__toast {
    position: fixed;
    left: 50%;
    bottom: 2.4rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    max-width: calc(100vw - 3.2rem);
    padding: 1.0rem 1.6rem;
    background-color: var(--color-surface-3);
    border: 1px solid var(--color-success);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.2;
    box-shadow: 0 10px 30px color-mix(in srgb, #000 50%, transparent),
                0 0 0 1px color-mix(in srgb, var(--color-success) 15%, transparent);
    z-index: 1000;
    pointer-events: none;
  }

  .exo__toast-icon {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-success);
    flex-shrink: 0;
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .exo__card,
    .exo__add-btn,
    .exo__filter,
    .exo__icon-btn,
    .exo__add-sets-warmup,
    .exo__add-sets-add,
    .exo__tip-toggle,
    .exo__tip-toggle:active {
      transition: none;
      transform: none;
    }
