---

import { t, setLocale, defaultLocale } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import EmptyState from '../../components/ui/EmptyState.astro';

setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();

/**
 * Static list of categories offered in the form. Kept on the
 * frontmatter so the markup stays declarative. Values are the
 * storage keys (kept stable for data compat); labels are
 * localized.
 */
const categories = [
  { value: 'Barre', label: L.exercices.categories.barre },
  { value: 'Halt\u00e8re', label: L.exercices.categories.haltere },
  { value: 'Machine', label: L.exercices.categories.machine },
  { value: 'Poids du corps', label: L.exercices.categories.poidsCorps },
  { value: 'C\u00e2ble', label: L.exercices.categories.cable },
  { value: 'Autre', label: L.exercices.categories.autre },
] as const;
---

<AppLayout title={L.exercices.title}>
  <PageHeader
    title={L.exercices.title}
    description={L.exercices.description}
  />

  <div
    class="exo"
    x-data="exercisesApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: search + filter ── */}
    <div class="exo__toolbar">
      <div class="exo__search">
        <svg
          class="exo__search-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          class="exo__search-input"
          placeholder={L.exercices.searchPlaceholder}
          x-model="search"
          aria-label={L.exercices.search}
        />
      </div>

      <div class="exo__filters" role="group" aria-label={L.exercices.filterAria}>
        <button
          type="button"
          class="exo__filter"
          :class="{ 'is-active': muscleFilter === '' }"
          :aria-pressed="muscleFilter === ''"
          @click="muscleFilter = ''"
        >
          {L.common.all}
        </button>
        <button
          type="button"
          class="exo__filter"
          :class="{ 'is-active': favFilter }"
          :aria-pressed="favFilter"
          @click="favFilter = !favFilter"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          {L.exercices.favorites}
        </button>
        <template x-for="m in muscleGroups" :key="m">
          <button
            type="button"
            class="exo__filter"
            :class="{ 'is-active': muscleFilter === m }"
            :aria-pressed="muscleFilter === m"
            @click="muscleFilter = m"
            x-text="m"
          ></button>
        </template>
      </div>
    </div>

    {/* ── Meta row: count + add button ── */}
    <div class="exo__meta">
      <span class="exo__count" x-text="countLabel"></span>
      <button
        type="button"
        class="exo__add-btn"
        @click="openAdd()"
        aria-label={L.exercices.add}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="exo__add-icon"
          aria-hidden="true"
        >
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>{L.exercices.add}</span>
      </button>
    </div>

    {/* ── Grid ── */}
    <template x-if="filtered.length > 0">
          <div class="exo__grid">
            <template x-for="ex in filtered" :key="ex.id">
              <article class="exo__card">
                <header class="exo__card-head">
                  <div class="exo__card-title">
                    <svg
                      class="exo__card-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6.5 6.5h11v11h-11z"></path>
                      <path d="M2 9v6"></path>
                      <path d="M22 9v6"></path>
                      <path d="M6.5 6.5L2 9"></path>
                      <path d="M17.5 6.5L22 9"></path>
                      <path d="M6.5 17.5L2 15"></path>
                      <path d="M17.5 17.5L22 15"></path>
                    </svg>
                    <h3 class="exo__card-name" x-text="trExercise(ex.name)"></h3>
                    <button
                      type="button"
                      class="exo__tip-toggle"
                      @click="toggleTip(ex.id)"
                      :aria-expanded="isTipOpen(ex.id).toString()"
                      :aria-label="labels.showTipAria + ' ' + ex.name"
                      title={L.exercices.tipLabel}
                      x-show="hasTip(ex.name)"
                      x-cloak
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                      </svg>
                    </button>
                  </div>
                  <span
                    class="exo__set-badge"
                    x-show="getSetCount(ex.id) > 0"
                    x-cloak
                    x-transition.opacity.duration.200ms
                    :title="getSetCount(ex.id) + ' ' + labels.sets"
                  >
                    <svg
                      class="exo__set-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="8" y1="6" x2="21" y2="6"></line>
                      <line x1="8" y1="12" x2="21" y2="12"></line>
                      <line x1="8" y1="18" x2="21" y2="18"></line>
                      <line x1="3" y1="6" x2="3.01" y2="6"></line>
                      <line x1="3" y1="12" x2="3.01" y2="12"></line>
                      <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                    <span x-text="getSetCount(ex.id)"></span>
                    <span class="exo__set-label">{L.exercices.setsCount}</span>
                  </span>
                  <button
                    type="button"
                    class="exo__icon-btn exo__fav-btn"
                    :class="{ 'is-fav': ex.favorite }"
                    @click.stop="toggleFav(ex)"
                    :aria-label="(ex.favorite ? labels.unfavoriteAria : labels.favoriteAria) + ' ' + ex.name"
                    :title="ex.favorite ? labels.unfavorite : labels.favorite"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      class="exo__icon"
                      :fill="ex.favorite ? 'currentColor' : 'none'"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  </button>
                </header>

                <p
                  class="exo__tip"
                  x-show="isTipOpen(ex.id) && hasTip(ex.name)"
                  x-cloak
                  x-transition.opacity.duration.180ms
                >
                  <span x-text="getTip(ex.name)"></span>
                  <a
                    class="exo__tip-video"
                    :href="getVideoUrl(ex.name)"
                    target="_blank"
                    rel="noopener noreferrer"
                    :aria-label="labels.videoAria + ' ' + ex.name + ' ' + labels.onYoutube"
                    title={L.exercices.seeTechnique}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polygon points="6 4 20 12 6 20 6 4"></polygon>
                    </svg>
                    <span>{L.exercices.seeTechnique}</span>
                  </a>
                </p>

            <div class="exo__card-badges">
              <Badge
                variant="category"
                size="sm"
                :class="'badge--cat-' + muscleHue(ex.muscle)"
                x-text="trMuscle(ex.muscle)"
              ></Badge>
              <Badge variant="default" size="sm" x-text="trCategory(ex.category)"></Badge>
            </div>

            <footer class="exo__card-foot">
              <button
                type="button"
                class="exo__icon-btn"
                @click="edit(ex)"
                aria-label={L.exercices.edit}
                title={L.exercices.edit}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="exo__icon"
                  aria-hidden="true"
                >
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </button>
              <button
                type="button"
                class="exo__icon-btn exo__icon-btn--accent"
                @click="openAddToSession(ex)"
                aria-label={L.exercices.addToSession}
                title={L.exercices.addToSession}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="exo__icon"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="16"></line>
                  <line x1="8" y1="12" x2="16" y2="12"></line>
                </svg>
              </button>
              <a
                class="exo__icon-btn exo__icon-btn--trend"
                :href="trendUrl(ex)"
                :aria-label="labels.trendAria + ' ' + ex.name"
                :title="labels.trendTitle"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="exo__icon"
                  aria-hidden="true"
                >
                  <path d="M3 3v18h18"></path>
                  <path d="M7 14l4-4 4 4 5-5"></path>
                </svg>
              </a>
              <button
                type="button"
                class="exo__icon-btn exo__icon-btn--danger"
                @click="askDelete(ex)"
                aria-label={L.exercices.delete}
                title={L.exercices.delete}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="exo__icon"
                  aria-hidden="true"
                >
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                </svg>
              </button>
            </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state: library has no exercises at all ── */}
    <template x-if="exercises.length === 0">
      <Card>
        <EmptyState
          icon="package"
          title={L.exercices.emptyLibrary}
        />
        <div class="exo__empty-cta">
          <button
            type="button"
            class="exo__add-btn exo__add-btn--centered"
            @click="openAdd()"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="exo__add-icon"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>{L.exercices.add}</span>
          </button>
        </div>
      </Card>
    </template>

    {/* ── Empty state: search/filters match nothing ── */}
    <template x-if="exercises.length > 0 && filtered.length === 0">
      <Card>
        <EmptyState
          title={L.common.noResult}
          description={L.exercices.noResults}
        />
        <div class="exo__empty-cta">
          <button
            type="button"
            class="exo__add-btn exo__add-btn--centered"
            @click="openAdd()"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="exo__add-icon"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>{L.exercices.add}</span>
          </button>
          <button
            type="button"
            class="exo__reset-btn"
            @click="search = ''; muscleFilter = ''; favFilter = false"
            x-show="hasFilters"
          >
            {L.common.reset}
          </button>
        </div>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        ADD / EDIT DIALOG
        ════════════════════════════════════════════════════ */}
    <Dialog id="exo-form-dialog" :title="editingId ? labels.editTitle : labels.addTitle">
      <form class="exo__form" @submit.prevent="save()">
        <div class="exo__field">
          <label for="exo-name" class="exo__label">
            {L.exercices.nameLabel}
            <span class="exo__label-req" aria-hidden="true">*</span>
          </label>
          <input
            id="exo-name"
            type="text"
            class="exo__input"
            placeholder={L.exercices.namePlaceholder}
            x-model="form.name"
            required
            autocomplete="off"
          />
        </div>

        <div class="exo__field">
          <label for="exo-muscle" class="exo__label">
            {L.exercices.muscleLabel}
            <span class="exo__label-req" aria-hidden="true">*</span>
          </label>
          <div class="exo__select-wrap">
            <select
              id="exo-muscle"
              class="exo__select"
              x-model="form.muscle"
              required
            >
              <option value="" disabled>{L.common.select}</option>
              <template x-for="opt in muscleOptionsForSelect" :key="opt.value">
                <option :value="opt.value" x-text="opt.label"></option>
              </template>
            </select>
            <svg
              class="exo__select-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </div>

        <div class="exo__field" x-show="form.muscle === '__custom__'" x-cloak x-transition.opacity.duration.200ms>
          <label for="exo-muscle-custom" class="exo__label">
            {L.exercices.customMuscleLabel}
            <span class="exo__label-req" aria-hidden="true">*</span>
          </label>
          <input
            id="exo-muscle-custom"
            type="text"
            class="exo__input"
            placeholder="Ex. Mollets"
            x-model="form.customMuscle"
            autocomplete="off"
          />
        </div>

        <div class="exo__field">
          <label for="exo-category" class="exo__label">
            {L.exercices.categoryLabel}
            <span class="exo__label-req" aria-hidden="true">*</span>
          </label>
          <div class="exo__select-wrap">
            <select
              id="exo-category"
              class="exo__select"
              x-model="form.category"
              required
            >
              <option value="" disabled>{L.common.select}</option>
              {categories.map((c) => (
                <option value={c.value}>{c.label}</option>
              ))}
            </select>
            <svg
              class="exo__select-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </div>

        <div class="exo__form-error" x-show="formError" x-text="formError" x-cloak x-transition.opacity.duration.200ms></div>

        <div class="exo__form-actions">
          <button
            type="button"
            class="exo__btn exo__btn--secondary"
            @click="closeForm()"
          >
            {L.common.cancel}
          </button>
          <button
            type="submit"
            class="exo__btn exo__btn--primary"
            x-text="editingId ? labels.save : labels.add"
          ></button>
        </div>
      </form>
    </Dialog>

    {/* ════════════════════════════════════════════════════
        DELETE CONFIRMATION DIALOG
        ════════════════════════════════════════════════════ */}
    <Dialog id="exo-delete-dialog" title={L.exercices.deleteTitle}>
      <p class="exo__confirm-text">
        <strong x-text="deletingName || 'cet exercice'"></strong>
      </p>
      <p class="exo__confirm-text">
        {L.exercices.deleteDesc}
      </p>

      <div slot="footer">
        <button
          type="button"
          class="exo__btn exo__btn--secondary"
          data-dialog-close
        >
          {L.common.cancel}
        </button>
        <button
          type="button"
          class="exo__btn exo__btn--destructive"
          @click="confirmDelete()"
        >
          {L.common.delete}
        </button>
      </div>
    </Dialog>

    {/* ════════════════════════════════════════════════════
        ADD TO SESSION DIALOG
        ════════════════════════════════════════════════════ */}
    <Dialog id="exo-add-to-session-dialog" class="exo__add-dialog-host">
      <div class="exo__add-dialog">
        <header class="exo__add-header">
          <div class="exo__add-header-text">
            <h2 class="exo__add-title" x-text="trExercise(addingExercise?.name)"></h2>
            <Badge
              variant="category"
              size="sm"
              :class="'badge--cat-' + muscleHue(addingExercise?.muscle)"
              x-text="trMuscle(addingExercise?.muscle)"
            ></Badge>
          </div>
          <button
            type="button"
            class="exo__add-close"
            data-dialog-close
            aria-label={L.common.close}
            @click="closeAddToSession()"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>

        {/* ── Session picker ── */}
        <div class="exo__add-field">
          <label for="exo-add-session" class="exo__label">{L.sessions.seanceSingular}</label>
          <div class="exo__select-wrap">
            <select
              id="exo-add-session"
              class="exo__select"
              x-model="addToSessionId"
            >
              <option value="">{L.rapide.selectSession}</option>
              <option value="new">+ {L.exercices.newSession}</option>
              <template x-for="s in sessions" :key="s.id">
                <option :value="s.id" x-text="s.name + ' (' + s.date + ')'"></option>
              </template>
            </select>
            <svg
              class="exo__select-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </div>

        {/* ── New session name (conditional) ── */}
        <div
          class="exo__add-field"
          x-show="addToSessionId === 'new'"
          x-cloak
          x-transition.opacity.duration.180ms
        >
          <label for="exo-add-session-name" class="exo__label">
            {L.builder.name}
          </label>
          <input
            id="exo-add-session-name"
            type="text"
            class="exo__input"
            x-model="newSessionName"
            placeholder="Ex. Push day"
            autocomplete="off"
          />
        </div>

        {/* ── Sets table ── */}
        <div class="exo__add-sets">
          <div class="exo__add-sets-header" aria-hidden="true">
            <span>#</span>
            <span>{L.builder.type}</span>
            <span>{L.builder.weight} (kg)</span>
            <span>{L.common.reps}</span>
            <span></span>
          </div>
          <template x-for="(set, i) in addSets" :key="i">
            <div class="exo__add-sets-row">
              <span class="exo__add-sets-num" x-text="i + 1"></span>
              <div class="exo__add-sets-type">
                <span class="exo__add-sets-label">{L.builder.type}</span>
                <div class="exo__select-wrap">
                  <select class="exo__select exo__select--compact" x-model="set.type">
                    <option value="warmup">{L.builder.types.warmup}</option>
                    <option value="work">{L.builder.types.work}</option>
                    <option value="top">{L.builder.types.top}</option>
                    <option value="drop">{L.builder.types.drop}</option>
                    <option value="failure">{L.builder.types.failure}</option>
                  </select>
                  <svg
                    class="exo__select-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
              </div>
              <div class="exo__add-sets-weight">
                <span class="exo__add-sets-label">{L.builder.weight} (kg)</span>
                <input
                  type="number"
                  class="exo__input exo__input--compact"
                  x-model.number="set.weight"
                  min="0"
                  step="0.5"
                  inputmode="decimal"
                />
              </div>
              <div class="exo__add-sets-reps">
                <span class="exo__add-sets-label">{L.common.reps}</span>
                <input
                  type="number"
                  class="exo__input exo__input--compact"
                  x-model.number="set.reps"
                  min="0"
                  inputmode="numeric"
                />
              </div>
              <button
                type="button"
                class="exo__add-sets-remove"
                @click="removeSetFromConfig(i)"
                :disabled="addSets.length <= 1"
                :aria-label="labels.deleteSet + ' ' + (i + 1)"
                title={L.builder.deleteSet}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </template>
          <div class="exo__add-sets-actions">
            <button
              type="button"
              class="exo__add-sets-warmup"
              @click="generateWarmup()"
              :disabled="!hasWorkingWeight()"
              :title="hasWorkingWeight() ? labels.warmupTitle : labels.warmupHint"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
              </svg>
              <span>{L.builder.warmupBtn}</span>
            </button>
            <button
              type="button"
              class="exo__add-sets-add"
              @click="addSetToConfig()"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>{L.builder.addSet}</span>
            </button>
          </div>
        </div>
      </div>

      <div slot="footer" class="exo__add-actions">
        <button
          type="button"
          class="exo__btn exo__btn--secondary"
          data-dialog-close
          @click="closeAddToSession()"
        >
          {L.common.cancel}
        </button>
        <button
          type="button"
          class="exo__btn exo__btn--primary"
          @click="submitAddToSession()"
          :disabled="!addToSessionId"
        >
          {L.exercices.addToSession}
        </button>
      </div>
    </Dialog>

    {/* ════════════════════════════════════════════════════
        SUCCESS TOAST
        ════════════════════════════════════════════════════ */}
    <div
      class="exo__toast"
      x-show="toast.visible"
      x-cloak
      x-transition.opacity.duration.200ms
      role="status"
      aria-live="polite"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="exo__toast-icon"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span x-text="toast.message"></span>
    </div>
  </div>
</AppLayout>

<script>
  import { t, getLocale, localizedPath } from '../../i18n';
  import {
    getExercises,
    saveExercise,
    updateExercise,
    deleteExercise,
    toggleExerciseFavorite,
    getSessions,
    saveSession,
    updateSession,
    type Exercise,
    type Session,
    type SessionExercise,
    type SessionSet,
    type SetType,
  } from '../../lib/storage';
  import { getExerciseTip } from '../../lib/exercise-tips';

  const LABELS = t();

  // Default muscle groups always surfaced in the filter bar
  // (mirrors the seed list in src/lib/storage.ts).
  const EXO_DEFAULT_MUSCLES = [
    'Pectoraux',
    'Dos',
    'Épaules',
    'Biceps',
    'Triceps',
    'Quadriceps',
    'Ischio-jambiers',
    'Fessiers',
    'Abdominaux',
    'Mollets',
    'Avant-bras',
  ];

  // Sentinel value used by the muscle <select> to reveal the
  // "custom muscle" input.
  const CUSTOM_MUSCLE = '__custom__';

  interface AlpineFormState {
    name: string;
    muscle: string;
    customMuscle: string;
    category: string;
  }

  interface AddSetRow {
    type: SetType;
    weight: number;
    reps: number;
  }

  function resolveForm(form: AlpineFormState): { name: string; muscle: string; category: string } | null {
    const name = form.name.trim();
    const muscle = form.muscle === CUSTOM_MUSCLE ? form.customMuscle.trim() : form.muscle.trim();
    const category = form.category.trim();
    if (!name || !muscle || !category) return null;
    return { name, muscle, category };
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('exercisesApp', () => ({
      // ── State ──
      exercises: [] as Exercise[],
      sessions: [] as Session[],
      setCounts: {} as Record<string, number>,
      search: '',
      muscleFilter: '',
      favFilter: false,
      form: { name: '', muscle: '', customMuscle: '', category: '' } as AlpineFormState,
      formError: '',
      editingId: '' as string,
      deletingExercise: null as Exercise | null,
      deletingName: '',

      // ── Add-to-session state ──
      addingExercise: null as Exercise | null,
      addToSessionId: '' as string,
      newSessionName: '' as string,
      addSets: [
        { type: 'work', weight: 0, reps: 0 },
        { type: 'work', weight: 0, reps: 0 },
        { type: 'work', weight: 0, reps: 0 },
      ] as AddSetRow[],
      toast: { visible: false, message: '' },
      _toastTimer: 0,

      // ── Labels (i18n) ──
      labels: {
        editTitle: LABELS.exercices.editTitle,
        addTitle: LABELS.exercices.addTitle,
        save: LABELS.common.save,
        add: LABELS.common.add,
        deleteSet: LABELS.builder.deleteSet,
        warmupTitle: LABELS.builder.warmupTitle,
        warmupHint: LABELS.builder.warmupHint,
        showTipAria: LABELS.exercices.showTipAria,
        videoAria: LABELS.exercices.videoAria,
        onYoutube: LABELS.exercices.onYoutube,
        sets: LABELS.exercices.sets,
        trendAria: LABELS.tendance.trendAria,
        trendTitle: LABELS.tendance.title,
      },

      // ── Tips (added 2026-08-04) ──
      openTips: [] as string[],

      // ── Init ──
      init() {
        this.refresh();
      },

      refresh() {
        this.exercises = getExercises();
        this.sessions = getSessions();
        this.recomputeSetCounts();
      },

      recomputeSetCounts() {
        const counts: Record<string, number> = {};
        for (const session of this.sessions) {
          for (const ex of session.exercises) {
            counts[ex.exerciseId] = (counts[ex.exerciseId] ?? 0) + ex.sets.length;
          }
        }
        this.setCounts = counts;
      },

      getSetCount(exerciseId: string): number {
        return this.setCounts[exerciseId] ?? 0;
      },

      // Deep-link to the trend chart page, scoped to this exercise.
      trendUrl(ex: Exercise): string {
        const q = new URLSearchParams({ ex: ex.name });
        return `${localizedPath('/exercices/tendance')}?${q.toString()}`;
      },

      // ── Derived ──
      get muscleGroups(): string[] {
        const fromData = this.exercises.map((e) => e.muscle);
        const set = new Set<string>([...EXO_DEFAULT_MUSCLES, ...fromData]);
        return Array.from(set).sort((a, b) => a.localeCompare(b, 'fr'));
      },

      get muscleOptionsForSelect(): { value: string; label: string }[] {
        const groups = this.muscleGroups;
        return [
          ...groups.map((m) => ({ value: m, label: m })),
          { value: CUSTOM_MUSCLE, label: LABELS.exercices.categories.autre },
        ];
      },

      get filtered(): Exercise[] {
        const q = this.search.trim().toLowerCase();
        const muscle = this.muscleFilter;
        return this.exercises.filter((ex) => {
          if (muscle && ex.muscle !== muscle) return false;
          if (this.favFilter && !ex.favorite) return false;
          if (q && !ex.name.toLowerCase().includes(q)) return false;
          return true;
        });
      },

      get countLabel(): string {
        const n = this.filtered.length;
        return `${n} ${n > 1 ? LABELS.sessions.exoPlural : LABELS.sessions.exoSingular}`;
      },

      get hasFilters(): boolean {
        return Boolean(this.search.trim() || this.muscleFilter || this.favFilter);
      },

      // ── Actions ──
      openAdd() {
        this.editingId = '';
        this.form = { name: '', muscle: '', customMuscle: '', category: '' };
        this.formError = '';
        this.openDialogById('exo-form-dialog');
      },

      edit(exercise: Exercise) {
        this.editingId = exercise.id;
        const known = this.muscleGroups.includes(exercise.muscle);
        this.form = {
          name: exercise.name,
          muscle: known ? exercise.muscle : CUSTOM_MUSCLE,
          customMuscle: known ? '' : exercise.muscle,
          category: exercise.category,
        };
        this.formError = '';
        this.openDialogById('exo-form-dialog');
      },

      toggleFav(ex: Exercise) {
        toggleExerciseFavorite(ex.id);
        this.refresh();
      },

      save() {
        const resolved = resolveForm(this.form);
        if (!resolved) {
          this.formError = LABELS.exercices.formRequired;
          return;
        }
        try {
          if (this.editingId) {
            updateExercise(this.editingId, resolved);
          } else {
            saveExercise(resolved);
          }
          this.refresh();
          this.closeDialogById('exo-form-dialog');
        } catch (err) {
          this.formError = LABELS.exercices.formError;
        }
      },

      closeForm() {
        this.closeDialogById('exo-form-dialog');
      },

      askDelete(exercise: Exercise) {
        this.deletingExercise = exercise;
        this.deletingName = exercise.name;
        this.openDialogById('exo-delete-dialog');
      },

      confirmDelete() {
        if (!this.deletingExercise) return;
        deleteExercise(this.deletingExercise.id);
        this.deletingExercise = null;
        this.deletingName = '';
        this.refresh();
        this.closeDialogById('exo-delete-dialog');
      },

      // ── Add-to-session actions ──
      openAddToSession(exercise: Exercise) {
        this.addingExercise = exercise;
        this.addToSessionId = '';
        this.newSessionName = '';
        this.addSets = [
          { type: 'work', weight: 0, reps: 0 },
          { type: 'work', weight: 0, reps: 0 },
          { type: 'work', weight: 0, reps: 0 },
        ];
        // Refresh the sessions list so the picker is up to date.
        this.sessions = getSessions();
        this.openDialogById('exo-add-to-session-dialog');
      },

      closeAddToSession() {
        this.addingExercise = null;
        this.addToSessionId = '';
        this.newSessionName = '';
        this.closeDialogById('exo-add-to-session-dialog');
      },

      // ── Tips (added 2026-08-04) ──
      hasTip(name: string): boolean {
        return getExerciseTip(name) != null;
      },
      getTip(name: string): string {
        return getExerciseTip(name)?.description ?? '';
      },
      getVideoUrl(name: string): string {
        return getExerciseTip(name)?.videoUrl ?? '';
      },
      isTipOpen(exId: string): boolean {
        return this.openTips.includes(exId);
      },
      toggleTip(exId: string) {
        if (this.isTipOpen(exId)) {
          this.openTips = this.openTips.filter((id) => id !== exId);
        } else {
          this.openTips = [...this.openTips, exId];
        }
      },

      addSetToConfig() {
        this.addSets.push({ type: 'work', weight: 0, reps: 0 });
      },

      removeSetFromConfig(index: number) {
        if (this.addSets.length <= 1) return;
        this.addSets.splice(index, 1);
      },

      hasWorkingWeight(): boolean {
        return this.addSets.some((s) => s.type === 'work' && s.weight > 0);
      },

      generateWarmup() {
        // Find the max working weight from existing sets.
        const workingSets = this.addSets.filter((s) => s.type === 'work' && s.weight > 0);
        if (workingSets.length === 0) {
          this.showToast(LABELS.builder.warmupHint);
          return;
        }

        const maxWeight = Math.max(...workingSets.map((s) => s.weight));

        // Generate warmup sets: 40%, 60%, 80% of working weight.
        const warmupPercents = [0.4, 0.6, 0.8] as const;
        const warmupReps = [12, 8, 5] as const;
        const warmups: AddSetRow[] = warmupPercents.map((p, i) => ({
          type: 'warmup',
          weight: Math.round(maxWeight * p),
          reps: warmupReps[i],
        }));

        // Prepend warmups to the working sets.
        this.addSets = [...warmups, ...this.addSets];
      },

      showToast(message: string) {
        this.toast = { visible: true, message };
        if (this._toastTimer) window.clearTimeout(this._toastTimer);
        this._toastTimer = window.setTimeout(() => {
          this.toast = { visible: false, message: '' };
        }, 2800);
      },

      submitAddToSession() {
        if (!this.addingExercise) return;
        if (!this.addToSessionId) return;

        let sessionId = this.addToSessionId;

        // Create a new session if requested.
        if (sessionId === 'new') {
          const name =
            this.newSessionName.trim() ||
            `${LABELS.sessions.seanceSingular} ${new Date().toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US')}`;
          const created = saveSession({
            name,
            date: new Date().toISOString().split('T')[0],
            exercises: [],
            status: 'planned',
          });
          sessionId = created.id;
        }

        const sessions = getSessions();
        const session = sessions.find((s) => s.id === sessionId);
        if (!session) return;

        const exerciseId = this.addingExercise.id;
        const exerciseEntry: SessionExercise = {
          exerciseId,
          name: this.addingExercise.name,
          muscle: this.addingExercise.muscle,
          sets: this.addSets.map<SessionSet>((s, i) => ({
            exerciseId,
            setNumber: i + 1,
            type: s.type,
            weight: s.weight,
            reps: s.reps,
            completed: false,
          })),
        };

        session.exercises.push(exerciseEntry);
        updateSession(session.id, { exercises: session.exercises });

        this.closeAddToSession();
        this.refresh();
        this.showToast(LABELS.exercices.toastAdded);
      },

      // ── Dialog helpers (wrap the global Dialog API) ──
      openDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
      closeDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
    }));
  });
</script>

