---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Badge from '../../components/ui/Badge.astro';
import { icons } from '../../lib/icons';
import BackLink from '../../components/ui/BackLink.astro';
const L = t();
---

<AppLayout title={L.comparer.title}>
  <div
    class="flex flex-col gap-[var(--spacing-5)] pb-24"
    x-data="comparisonApp()"
    x-init="init()"
    x-cloak
  >
    <PageHeader
      title={L.comparer.title}
      description={L.comparer.description}
    />

    <BackLink href={localizedPath("/sessions")} label={L.comparer.back} />

    {/* ═══════════════════════════════════════════════════
        SESSION PICKERS
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <Card>
      <CardHeader>
        <CardTitle>{L.comparer.selection}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="comp__pickers">
          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0">
            <label for="comp-s1" class="font-[family-name:var(--font-body)] text-[1.1rem] text-[var(--color-muted)] uppercase tracking-[0.12em] font-bold leading-[1.2]">{L.comparer.session1Ref}</label>
            <div class="relative">
              <Fragment set:html={icons.dumbbellBox(18, 18)} />
              <select
                class="comp__select"
                x-model="session1Id"
                @change="onSession1Change($event.target.value)"
                :aria-label="'{L.comparer.pickFirst}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session2Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>

          <div class="flex items-center justify-center h-[4.8rem] self-end" aria-hidden="true">
            <span class="inline-flex items-center justify-center min-w-[4.8rem] h-[4.8rem] px-[1.4rem] rounded-full bg-gradient-to-br from-[color-mix(in_srgb,var(--color-accent)_18%,transparent)] to-[color-mix(in_srgb,var(--color-accent)_5%,transparent)] border border-[color-mix(in_srgb,var(--color-accent)_35%,transparent)] text-[var(--color-accent)] font-[family-name:var(--font-display)] text-[1.8rem] font-bold tracking-[0.04em] leading-none">{L.comparer.vs}</span>
          </div>

          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0">
            <label for="comp-s2" class="font-[family-name:var(--font-body)] text-[1.1rem] text-[var(--color-muted)] uppercase tracking-[0.12em] font-bold leading-[1.2]">{L.comparer.session2}</label>
            <div class="relative">
              <Fragment set:html={icons.dumbbellBox(18, 18)} />
              <select
                id="comp-s2"
                class="comp__select"
                x-model="session2Id"
                @change="onSession2Change($event.target.value)"
                :aria-label="'{L.comparer.pickSecond}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session1Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        HINT — show "select both" message
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="allSessions.length < 2">
      <Card>
        <div class="flex items-center gap-[var(--spacing-3)] px-[var(--spacing-4)] py-[var(--spacing-3)] text-[var(--color-muted)] text-[1.3rem] leading-[1.5]">
          <div class="inline-flex items-center justify-center w-[3.4rem] h-[3.4rem] shrink-0 rounded-full bg-[color-mix(in_srgb,var(--color-accent)_10%,transparent)] text-[var(--color-accent)]" aria-hidden="true">
            <Fragment set:html={icons.infoCircle(18, 18)} />
          </div>
          <p>
            {L.comparer.needTwo}
            <a href={localizedPath("/sessions/create")} class="text-[var(--color-accent)] font-bold ml-[0.4rem] focus-visible:outline-none focus-visible:box-shadow-[var(--focus-ring)] focus-visible:rounded-[var(--radius-sm)]">{L.comparer.createSession}</a>
          </p>
        </div>
      </Card>
    </template>

    <template x-if="allSessions.length >= 2 && (!session1 || !session2)">
      <Card>
        <div class="flex items-center gap-[var(--spacing-3)] px-[var(--spacing-4)] py-[var(--spacing-3)] text-[var(--color-muted)] text-[1.3rem] leading-[1.5]">
          <div class="inline-flex items-center justify-center w-[3.4rem] h-[3.4rem] shrink-0 rounded-full bg-[color-mix(in_srgb,var(--color-accent)_10%,transparent)] text-[var(--color-accent)]" aria-hidden="true">
            <Fragment set:html={icons.trendingUpLine(18, 18)} />
          </div>
          <p>{L.comparer.selectBoth}</p>
        </div>
      </Card>
    </template>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        COMPARISON COLUMNS
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="session1 && session2">
      <div class="flex flex-col gap-[var(--spacing-5)]">
        {/* â”€â”€ Summary deltas at the top â”€â”€ */}
        <div class="flex flex-col">
          <h2 class="font-[family-name:var(--font-display)] text-[1.1rem] font-bold uppercase tracking-[0.16em] text-[var(--color-muted)] mb-[var(--spacing-3)]">{L.comparer.summaryTitle}</h2>
          <div class="comp__summary-grid">
            {/* Volume delta */}
            <article class="flex flex-col gap-[var(--spacing-3)] p-[var(--spacing-4)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-lg)]">
              <div class="inline-flex items-center gap-[var(--spacing-2)]">
                <Fragment set:html={icons.volumeBox(20, 20)} />
                <span class="font-[family-name:var(--font-display)] text-[1.1rem] uppercase tracking-[0.14em] font-bold text-[var(--color-muted)]">{L.comparer.volume}</span>
              </div>
              <div class="comp__summary-body">
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session1Ref}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="formatVolume(totalVolume(session1))"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + volumeDelta.direction"
                >
                  <span class="inline-flex items-center justify-center shrink-0" aria-hidden="true">
                    <template x-if="volumeDelta.direction === 'up'">
                      <span class="inline-flex rotate-180"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="volumeDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="volumeDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span x-text="volumeDelta.label"></span>
                </div>
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session2}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="formatVolume(totalVolume(session2))"></div>
                </div>
              </div>
            </article>

            {/* Exercises delta */}
            <article class="flex flex-col gap-[var(--spacing-3)] p-[var(--spacing-4)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-lg)]">
              <div class="inline-flex items-center gap-[var(--spacing-2)]">
                <Fragment set:html={icons.list(20, 20)} />
                <span class="font-[family-name:var(--font-display)] text-[1.1rem] uppercase tracking-[0.14em] font-bold text-[var(--color-muted)]">{L.comparer.exercises}</span>
              </div>
              <div class="comp__summary-body">
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session1Ref}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="session1.exercises.length"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + exercisesDelta.direction"
                >
                  <span class="inline-flex items-center justify-center shrink-0" aria-hidden="true">
                    <template x-if="exercisesDelta.direction === 'up'">
                      <span class="inline-flex rotate-180"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="exercisesDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="exercisesDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span x-text="exercisesDelta.label"></span>
                </div>
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session2}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="session2.exercises.length"></div>
                </div>
              </div>
            </article>

            {/* Sets delta */}
            <article class="flex flex-col gap-[var(--spacing-3)] p-[var(--spacing-4)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-lg)]">
              <div class="inline-flex items-center gap-[var(--spacing-2)]">
                <Fragment set:html={icons.list(20, 20)} />
                <span class="font-[family-name:var(--font-display)] text-[1.1rem] uppercase tracking-[0.14em] font-bold text-[var(--color-muted)]">{L.comparer.sets}</span>
              </div>
              <div class="comp__summary-body">
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session1Ref}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="totalSets(session1)"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + setsDelta.direction"
                >
                  <span class="inline-flex items-center justify-center shrink-0" aria-hidden="true">
                    <template x-if="setsDelta.direction === 'up'">
                      <span class="inline-flex rotate-180"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="setsDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="setsDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span x-text="setsDelta.label"></span>
                </div>
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session2}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="totalSets(session2)"></div>
                </div>
              </div>
            </article>

            {/* Best 1RM delta */}
            <article class="flex flex-col gap-[var(--spacing-3)] p-[var(--spacing-4)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-lg)]">
              <div class="inline-flex items-center gap-[var(--spacing-2)]">
                <Fragment set:html={icons.dumbbell(20, 20)} />
                <span class="font-[family-name:var(--font-display)] text-[1.1rem] uppercase tracking-[0.14em] font-bold text-[var(--color-muted)]">{L.comparer.best1RM}</span>
              </div>
              <div class="comp__summary-body">
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session1Ref}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="formatVolume(bestSet(session1))"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + bestSetDelta.direction"
                >
                  <span class="inline-flex items-center justify-center shrink-0" aria-hidden="true">
                    <template x-if="bestSetDelta.direction === 'up'">
                      <span class="inline-flex rotate-180"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="bestSetDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="bestSetDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span x-text="bestSetDelta.label"></span>
                </div>
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <div class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.session2}</div>
                  <div class="font-[family-name:var(--font-display)] text-[2.0rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1] tracking-[-0.01em]" x-text="formatVolume(bestSet(session2))"></div>
                </div>
              </div>
            </article>
          </div>
        </div>

        {/* â€”â€” Per-session columns â€”â€” */}
        <div class="comp__columns">
          {/* Session 1 column */}
          <section class="flex flex-col gap-[var(--spacing-4)] p-[var(--spacing-4)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-lg)]" aria-label={L.comparer.detailsAria1}>
            <header class="flex flex-col gap-[var(--spacing-2)] pb-[var(--spacing-3)] border-b border-[var(--color-border)]">
              <span class="inline-flex items-center self-start h-[2.4rem] px-[1.0rem] bg-[var(--alpha-bg-soft)] border border-[var(--color-border)] rounded-full text-[var(--color-muted)] font-[family-name:var(--font-display)] text-[1.0rem] font-bold uppercase tracking-[0.10em]">{L.comparer.session1Ref}</span>
              <h3 class="font-[family-name:var(--font-display)] text-[2.2rem] font-bold text-[var(--color-text)] leading-[1.15] tracking-[-0.01em] break-words m-0" x-text="session1.name"></h3>
              <div class="flex items-center gap-[var(--spacing-2)] flex-wrap">
                <span
                  class="comp__status"
                  :class="'comp__status--' + session1.status"
                  x-text="statusLabel(session1.status)"
                ></span>
                <span class="text-[1.2rem] text-[var(--color-muted)] leading-[1.3]" x-text="formatDate(session1.date)"></span>
              </div>
              <div class="flex gap-[var(--spacing-4)] pt-[var(--spacing-1)] flex-wrap">
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <span class="text-[1.05rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.duration}</span>
                  <span class="font-[family-name:var(--font-display)] text-[1.6rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatDuration(session1.duration)"></span>
                </div>
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <span class="text-[1.05rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.sessions.volume}</span>
                  <span class="font-[family-name:var(--font-display)] text-[1.6rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatVolume(totalVolume(session1))"></span>
                </div>
              </div>
            </header>

            <div class="flex flex-col gap-[var(--spacing-3)]">
              <template x-if="unionExercises.length === 0">
                <p class="text-center text-[var(--color-muted)] text-[1.3rem] py-[var(--spacing-4)]">{L.comparer.noExercises}</p>
              </template>

              <template x-for="item in unionExercises" :key="item.exerciseId">
                <article
                  class="comp__exo"
                  :class="{ 'comp__exo--missing': !item.session1Ex }"
                >
                  <header class="flex items-start justify-between gap-[var(--spacing-3)] flex-wrap">
                    <div class="flex flex-col gap-[0.4rem] min-w-0 flex-[1_1_auto]">
                      <h4 class="font-[family-name:var(--font-display)] text-[1.5rem] font-bold text-[var(--color-text)] leading-[1.2] break-words m-0" x-text="trExercise(item.name)"></h4>
                      <Badge
                        variant="category"
                        size="sm"
                        :class="'badge--cat-' + muscleHue(item.muscle)"
                        class="self-start"
                        x-text="trMuscle(item.muscle)"
                      ></Badge>
                    </div>
                    <div class="flex flex-col items-end gap-[0.2rem] shrink-0" x-show="item.session1Ex">
                      <span class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold leading-none">{L.sessions.volume}</span>
                      <span
                        class="font-[family-name:var(--font-display)] text-[1.7rem] font-bold text-[var(--color-accent)] tabular-nums leading-[1.1] tracking-[-0.01em]"
                        x-text="formatVolume(exerciseVolume(item.session1Ex))"
                      ></span>
                    </div>
                    <div class="inline-flex items-center h-[3.0rem] px-[1.2rem] bg-[var(--alpha-bg-subtle)] border border-dashed border-[var(--color-border)] rounded-full text-[var(--color-muted)] text-[1.1rem] font-bold uppercase tracking-[0.08em] shrink-0" x-show="!item.session1Ex">
                      <span>{L.comparer.notPerformed}</span>
                    </div>
                  </header>

                  <div class="comp__exo-table" x-show="item.session1Ex">
                    <div class="comp__exo-thead">
                      <div class="flex items-center min-w-0 justify-center">#</div>
                      <div class="flex items-center min-w-0">{L.builder.type}</div>
                      <div class="flex items-center min-w-0 justify-center">{L.common.weight}</div>
                      <div class="flex items-center min-w-0 justify-center">{L.common.reps}</div>
                      <div class="flex items-center min-w-0 justify-end">{L.sessions.volume}</div>
                    </div>
                    <template x-for="set in (item.session1Ex ? item.session1Ex.sets : [])" :key="set.setNumber">
                      <div
                        class="comp__exo-row"
                        :class="{ 'is-completed': set.completed }"
                      >
                        <div class="flex items-center justify-center min-w-0 font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="set.setNumber"></div>
                        <div class="flex items-center justify-center min-w-0">
                          <span
                            class="type-pill"
                            :class="'type-pill--' + set.type"
                            x-text="typeLabel(set.type)"
                          ></span>
                        </div>
                        <div class="flex items-center justify-center min-w-0 font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="formatWeight(set.weight)"></div>
                        <div class="flex items-center justify-center min-w-0 font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="set.reps"></div>
                        <div class="flex items-center justify-center min-w-0 justify-end font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="formatVolume(set.weight * set.reps)"></div>
                      </div>
                    </template>
                  </div>
                </article>
              </template>
            </div>
          </section>

          {/* Session 2 column */}
          <section class="flex flex-col gap-[var(--spacing-4)] p-[var(--spacing-4)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-lg)]" aria-label={L.comparer.detailsAria2}>
            <header class="flex flex-col gap-[var(--spacing-2)] pb-[var(--spacing-3)] border-b border-[var(--color-border)]">
              <span class="inline-flex items-center self-start h-[2.4rem] px-[1.0rem] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] border border-[color-mix(in_srgb,var(--color-accent)_30%,transparent)] rounded-full text-[var(--color-accent)] font-[family-name:var(--font-display)] text-[1.0rem] font-bold uppercase tracking-[0.10em]">{L.comparer.session2}</span>
              <h3 class="font-[family-name:var(--font-display)] text-[2.2rem] font-bold text-[var(--color-text)] leading-[1.15] tracking-[-0.01em] break-words m-0" x-text="session2.name"></h3>
              <div class="flex items-center gap-[var(--spacing-2)] flex-wrap">
                <span
                  class="comp__status"
                  :class="'comp__status--' + session2.status"
                  x-text="statusLabel(session2.status)"
                ></span>
                <span class="text-[1.2rem] text-[var(--color-muted)] leading-[1.3]" x-text="formatDate(session2.date)"></span>
              </div>
              <div class="flex gap-[var(--spacing-4)] pt-[var(--spacing-1)] flex-wrap">
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <span class="text-[1.05rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.comparer.duration}</span>
                  <span class="font-[family-name:var(--font-display)] text-[1.6rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatDuration(session2.duration)"></span>
                </div>
                <div class="flex flex-col gap-[0.2rem] min-w-0">
                  <span class="text-[1.05rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold">{L.sessions.volume}</span>
                  <span class="font-[family-name:var(--font-display)] text-[1.6rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatVolume(totalVolume(session2))"></span>
                </div>
              </div>
            </header>

            <div class="flex flex-col gap-[var(--spacing-3)]">
              <template x-if="unionExercises.length === 0">
                <p class="text-center text-[var(--color-muted)] text-[1.3rem] py-[var(--spacing-4)]">{L.comparer.noExercises}</p>
              </template>

              <template x-for="item in unionExercises" :key="item.exerciseId + '-s2'">
                <article
                  class="comp__exo"
                  :class="{ 'comp__exo--missing': !item.session2Ex }"
                >
                  <header class="flex items-start justify-between gap-[var(--spacing-3)] flex-wrap">
                    <div class="flex flex-col gap-[0.4rem] min-w-0 flex-[1_1_auto]">
                      <h4 class="font-[family-name:var(--font-display)] text-[1.5rem] font-bold text-[var(--color-text)] leading-[1.2] break-words m-0" x-text="trExercise(item.name)"></h4>
                      <Badge
                        variant="category"
                        size="sm"
                        :class="'badge--cat-' + muscleHue(item.muscle)"
                        class="self-start"
                        x-text="trMuscle(item.muscle)"
                      ></Badge>
                    </div>
                    <div class="flex flex-col items-end gap-[0.2rem] shrink-0" x-show="item.session2Ex">
                      <span class="text-[1.0rem] text-[var(--color-muted)] uppercase tracking-[0.10em] font-bold leading-none">{L.sessions.volume}</span>
                      <span
                        class="font-[family-name:var(--font-display)] text-[1.7rem] font-bold text-[var(--color-accent)] tabular-nums leading-[1.1] tracking-[-0.01em]"
                        x-text="formatVolume(exerciseVolume(item.session2Ex))"
                      ></span>
                    </div>
                    <div class="inline-flex items-center h-[3.0rem] px-[1.2rem] bg-[var(--alpha-bg-subtle)] border border-dashed border-[var(--color-border)] rounded-full text-[var(--color-muted)] text-[1.1rem] font-bold uppercase tracking-[0.08em] shrink-0" x-show="!item.session2Ex">
                      <span>{L.comparer.notPerformed}</span>
                    </div>
                  </header>

                  <div class="comp__exo-table" x-show="item.session2Ex">
                    <div class="comp__exo-thead">
                      <div class="flex items-center min-w-0 justify-center">#</div>
                      <div class="flex items-center min-w-0">{L.builder.type}</div>
                      <div class="flex items-center min-w-0 justify-center">{L.common.weight}</div>
                      <div class="flex items-center min-w-0 justify-center">{L.common.reps}</div>
                      <div class="flex items-center min-w-0 justify-end">{L.sessions.volume}</div>
                    </div>
                    <template x-for="set in (item.session2Ex ? item.session2Ex.sets : [])" :key="set.setNumber">
                      <div
                        class="comp__exo-row"
                        :class="{ 'is-completed': set.completed }"
                      >
                        <div class="flex items-center justify-center min-w-0 font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="set.setNumber"></div>
                        <div class="flex items-center justify-center min-w-0">
                          <span
                            class="type-pill"
                            :class="'type-pill--' + set.type"
                            x-text="typeLabel(set.type)"
                          ></span>
                        </div>
                        <div class="flex items-center justify-center min-w-0 font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="formatWeight(set.weight)"></div>
                        <div class="flex items-center justify-center min-w-0 font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="set.reps"></div>
                        <div class="flex items-center justify-center min-w-0 justify-end font-[family-name:var(--font-display)] text-[1.2rem] font-bold text-[var(--color-text)] tabular-nums" x-text="formatVolume(set.weight * set.reps)"></div>
                      </div>
                    </template>
                  </div>
                </article>
              </template>
            </div>
          </section>
        </div>
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type Session,
    type SessionExercise,
    type SessionStatus,
    type SetType,
    } from '../../lib/storage';
  import { t, getLocale } from '../../i18n';

  const LABELS = t();

  // â€"â€" Pure helpers (module scope) â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"
  function statusLabelFn(s: SessionStatus): string {
    if (s === 'completed') return LABELS.comparer.completed;
    if (s === 'in-progress') return LABELS.comparer.inProgress;
    return LABELS.comparer.planned;
  }

  function typeLabelFn(t: SetType): string {
    switch (t) {
      case 'warmup': return LABELS.rapide.typeWarmup;
      case 'work':   return LABELS.rapide.typeWork;
      case 'top':    return LABELS.rapide.typeTop;
      case 'drop':   return LABELS.rapide.typeDrop;
      case 'failure': return LABELS.rapide.typeFailure;
    }
  }

  function formatDateFn(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const date = d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
    const time = d.toLocaleTimeString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      hour: '2-digit',
      minute: '2-digit',
    });
    return date + ' Â· ' + time;
  }

  function formatDurationFn(seconds?: number): string {
    if (!seconds || seconds <= 0) return 'â€"';
    const total = Math.floor(seconds);
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    if (h > 0) return `${h}h ${m.toString().padStart(2, '0')}m`;
    if (m > 0) return `${m}m ${s.toString().padStart(2, '0')}s`;
    return `${s}s`;
  }

  function formatVolumeFn(v: number): string {
    if (!Number.isFinite(v) || v <= 0) return '0 kg';
    return Math.round(v).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US') + ' kg';
  }

  function formatWeightFn(w: number): string {
    if (!Number.isFinite(w) || w <= 0) return '0 kg';
    return Math.round(w).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US') + ' kg';
  }

  function exerciseVolumeFn(ex: SessionExercise | undefined): number {
    if (!ex) return 0;
    return ex.sets.reduce(
      (s, set) => s + (set.completed ? set.weight * set.reps : 0),
      0,
    );
  }

  function totalSetsFn(session: Session | null): number {
    if (!session) return 0;
    return session.exercises.reduce((sum, ex) => sum + ex.sets.length, 0);
  }

  function bestSetFn(session: Session | null): number {
    if (!session) return 0;
    let best = 0;
    for (const ex of session.exercises) {
      for (const set of ex.sets) {
        if (!set.completed) continue;
        const e = calculate1RM(set.weight, set.reps);
        if (e > best) best = e;
      }
    }
    return best;
  }

  // â€"â€" Delta computation â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"â€"
  // Direction is from session2's perspective: "up" if session2 > session1.
  type Direction = 'up' | 'down' | 'equal';
  function deltaFn(
    a: number,
    b: number,
    upLabel: string,
    downLabel: string,
    equalLabel: string,
    formatter: (n: number) => string,
  ): { direction: Direction; label: string; diff: number } {
    if (a === b) {
      return { direction: 'equal', label: equalLabel, diff: 0 };
    }
    if (b > a) {
      return {
        direction: 'up',
        label: upLabel + ' (+' + formatter(b - a) + ')',
        diff: b - a,
      };
    }
    return {
      direction: 'down',
      label: downLabel + ' (\u2212' + formatter(a - b) + ')',
      diff: a - b,
    };
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('comparisonApp', () => ({
      // â€"â€" State â€"â€"
      allSessions: [] as Session[],
      session1Id: '' as string,
      session2Id: '' as string,
      session1: null as Session | null,
      session2: null as Session | null,

      // â€"â€" Init â€"â€"
      init() {
        this.allSessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
        const params = new URLSearchParams(window.location.search);
        const id1 = params.get('id1');
        const id2 = params.get('id2');
        if (id1) {
          const found = this.allSessions.find((s) => s.id === id1);
          if (found) {
            this.session1Id = found.id;
            this.session1 = found;
          }
        }
        if (id2) {
          const found = this.allSessions.find((s) => s.id === id2);
          if (found) {
            this.session2Id = found.id;
            this.session2 = found;
          }
        }
      },

      // â€"â€" Computed â€"â€"
      get unionExercises(): Array<{
        exerciseId: string;
        name: string;
        muscle: string;
        session1Ex: SessionExercise | undefined;
        session2Ex: SessionExercise | undefined;
      }> {
        if (!this.session1 && !this.session2) return [];
        const map = new Map<
          string,
          {
            exerciseId: string;
            name: string;
            muscle: string;
            session1Ex: SessionExercise | undefined;
            session2Ex: SessionExercise | undefined;
          }
        >();
        if (this.session1) {
          for (const ex of this.session1.exercises) {
            map.set(ex.exerciseId, {
              exerciseId: ex.exerciseId,
              name: ex.name,
              muscle: ex.muscle,
              session1Ex: ex,
              session2Ex: undefined,
            });
          }
        }
        if (this.session2) {
          for (const ex of this.session2.exercises) {
            const existing = map.get(ex.exerciseId);
            if (existing) {
              existing.session2Ex = ex;
            } else {
              map.set(ex.exerciseId, {
                exerciseId: ex.exerciseId,
                name: ex.name,
                muscle: ex.muscle,
                session1Ex: undefined,
                session2Ex: ex,
              });
            }
          }
        }
        return Array.from(map.values());
      },

      get volumeDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€"', diff: 0 };
        }
        return deltaFn(
          this.totalVolume(this.session1),
          this.totalVolume(this.session2),
          LABELS.comparer.volumeMore,
          LABELS.comparer.volumeLess,
          LABELS.comparer.volumeEqual,
          formatVolumeFn,
        );
      },

      get exercisesDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€"', diff: 0 };
        }
        return deltaFn(
          this.session1.exercises.length,
          this.session2.exercises.length,
          LABELS.comparer.exercisesMore,
          LABELS.comparer.exercisesLess,
          LABELS.comparer.exercisesEqual,
          (n) => Math.round(n).toString(),
        );
      },

      get setsDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€"', diff: 0 };
        }
        return deltaFn(
          this.totalSets(this.session1),
          this.totalSets(this.session2),
          LABELS.comparer.setsMore,
          LABELS.comparer.setsLess,
          LABELS.comparer.setsEqual,
          (n) => Math.round(n).toString(),
        );
      },

      get bestSetDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€"', diff: 0 };
        }
        return deltaFn(
          this.bestSet(this.session1),
          this.bestSet(this.session2),
          LABELS.comparer.best1RM,
          LABELS.comparer.best1RMLower,
          LABELS.comparer.best1RMSame,
          formatVolumeFn,
        );
      },

      // â€"â€" Helpers â€"â€"
      formatOption(s: Session) {
        const date = formatDateFn(s.date);
        return s.name + ' â€" ' + date;
      },

      statusLabel(s: SessionStatus) {
        return statusLabelFn(s);
      },

      typeLabel(t: SetType) {
        return typeLabelFn(t);
      },

      formatDate(iso: string) {
        return formatDateFn(iso);
      },

      formatDuration(seconds?: number) {
        return formatDurationFn(seconds);
      },

      formatVolume(v: number) {
        return formatVolumeFn(v);
      },

      formatWeight(w: number) {
        return formatWeightFn(w);
      },

      totalVolume(session: Session | null): number {
        if (!session) return 0;
        return session.exercises.reduce(
          (sum, ex) => sum + exerciseVolumeFn(ex),
          0,
        );
      },

      exerciseVolume(ex: SessionExercise | undefined): number {
        return exerciseVolumeFn(ex);
      },

      totalSets(session: Session | null): number {
        return totalSetsFn(session);
      },

      bestSet(session: Session | null): number {
        return bestSetFn(session);
      },

      // â€"â€" Actions â€"â€"
      onSession1Change(id: string) {
        this.session1 = id ? this.allSessions.find((s) => s.id === id) || null : null;
        this.syncUrl();
      },

      onSession2Change(id: string) {
        this.session2 = id ? this.allSessions.find((s) => s.id === id) || null : null;
        this.syncUrl();
      },

      syncUrl() {
        if (typeof window === 'undefined') return;
        const params = new URLSearchParams();
        if (this.session1Id) params.set('id1', this.session1Id);
        if (this.session2Id) params.set('id2', this.session2Id);
        const qs = params.toString();
        const newUrl = qs
          ? window.location.pathname + '?' + qs
          : window.location.pathname;
        window.history.replaceState({}, '', newUrl);
      },
    }));
  });
</script>


