---
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import Icon from '../../components/ui/Icon.astro';
import { t, localizedPath } from '../../i18n';
import BackLink from '../../components/ui/BackLink.astro';
import DialogFooter from '../../components/ui/DialogFooter.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SessionHeader from '../../components/session-detail/SessionHeader.astro';
import StatusSection from '../../components/session-detail/StatusSection.astro';
import StatsGrid from '../../components/session-detail/StatsGrid.astro';
import SessionActions from '../../components/session-detail/SessionActions.astro';
import NotesSection from '../../components/session-detail/NotesSection.astro';
import ExerciseList from '../../components/session-detail/ExerciseList.astro';

const L = t();
---

<AppLayout title={L.detail.title}>
  <div
    class="detail"
    x-data="sessionDetailApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Back link ── */}
    <BackLink href={localizedPath("/sessions")} label={L.detail.backToSessions} />

    <template x-if="notFound">
      <EmptyState
        variant="error"
        title={L.detail.notFound}
        description={L.detail.notFoundDesc}
        actionLabel={L.detail.viewAllSessions}
        actionHref={localizedPath("/sessions")}
      />
    </template>

    {/* ── Loaded session ── */}
    <template x-if="!notFound && session">
      <div class="detail__content">
        <SessionHeader />
        <StatusSection />
        <StatsGrid />
        <SessionActions />

        {/* RPE-based progression suggestions */}
        <template x-if="session.status === 'completed' && rpeSuggestion">
          <section class="detail__suggestion">
            <h2 class="detail__section-title" x-text="labels.suggestionTitle"></h2>
            <Card>
              <div
                class="suggestion"
                :class="'suggestion--' + rpeSuggestion.tone"
              >
                <div class="suggestion__icon" aria-hidden="true">
                  <Icon name="sun" size={20} />
                </div>
                <div class="suggestion__body">
                  <div class="suggestion__headline" x-text="rpeSuggestion.headline"></div>
                  <p class="suggestion__detail" x-text="rpeSuggestion.detail"></p>
                  <div class="suggestion__meta">
                    <span>
                      <span x-text="labels.rpeAvg"></span>
                      <strong x-text="formatRpe(rpeStats.avg)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.rpeMax"></span>
                      <strong x-text="formatRpe(rpeStats.max)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.setsAnalyzed"></span>
                      <strong x-text="rpeStats.count"></strong>
                    </span>
                  </div>
                </div>
              </div>
            </Card>
          </section>
        </template>

        <NotesSection />
        <ExerciseList />
      </div>
    </template>

    <Dialog
      id="delete-session-dialog"
      title={L.detail.confirmDelete}
    >
      <p class="detail__confirm-text">
        {L.detail.confirmDeleteIntro}
        <strong x-text="session ? session.name : '{L.detail.thisSession}'"></strong>.
        {L.detail.irreversible}
      </p>

      <div slot="footer">
        <DialogFooter
          cancelLabel={L.common.cancel}
          confirmLabel={L.detail.deletePermanently}
          confirmClick="confirmDelete"
        />
      </div>
    </Dialog>

    {/* ════════════════════════════════════════════════════
        HIDDEN SHARE CARD
        DOM reference for the shareable image. The actual PNG
        is generated by generateShareCard() via the canvas API,
        but this hidden element keeps the markup in one place
        and lets the structure be inspected/edited.
        ════════════════════════════════════════════════════ */}
    <div
      id="share-card"
      class="share-card"
      x-show="false"
      aria-hidden="true"
    >
      <div class="share-card__inner">
        <header class="share-card__header">
          <span class="share-card__logo">Gym Empire</span>
          <span
            class="share-card__date"
            x-text="formatShareDate(session?.date)"
          ></span>
        </header>
        <h2 class="share-card__title" x-text="session?.name"></h2>
        <div class="share-card__stats">
          <div class="share-card__stat">
            <span
              class="share-card__stat-value"
              x-text="session?.exercises?.length || 0"
            ></span>
            <span class="share-card__stat-label">{L.detail.exercises}</span>
          </div>
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="totalSets"></span>
            <span class="share-card__stat-label">{L.detail.sets}</span>
          </div>
          <div class="share-card__stat">
            <span
              class="share-card__stat-value"
              x-text="formatVolume(sessionTotalVolume)"
            ></span>
            <span class="share-card__stat-label">{L.sessions.volume}</span>
          </div>
        </div>
        <div class="share-card__exercises">
          <template x-for="ex in session?.exercises || []" :key="ex.exerciseId">
            <div class="share-card__exercise">
              <span x-text="trExercise(ex.name)"></span>
              <span
                x-text="`${ex.sets.length} ${ex.sets.length > 1 ? labels.setPlural : labels.setSingular}`"
              ></span>
            </div>
          </template>
        </div>
        <div class="share-card__footer">
          {L.detail.shareFooter}
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSessionById,
    updateSession,
    deleteSession,
    calculate1RM,
    exportSessionAsCsv,
    type Session,
    type SessionExercise,
    type SessionMood,
    type SessionStatus,
    type RpeType,
    type SetType,
  } from '../../lib/storage';
  import { t, localizedPath } from '../../i18n';
  import { formatDateTime, formatVolume, formatDuration } from '../../lib/format';
  import { statusLabel as statusLabelFn, type StatusLabels } from '../../lib/session-utils';
  import { typeLabel as typeLabelFn, formatSetRpe as formatSetRpeFn, exerciseVolume as exerciseVolumeFn } from '../../lib/workout-helpers';
  import { moodSvg as moodSvgFn, moodLabel as moodLabelFn } from '../../lib/mood';
  import {
    computeRpeStats,
    computeRpeSuggestion,
    computeSessionTotalVolume,
    computeTotalSets,
    hasNotes as hasNotesFn,
    rpeTone as rpeToneFn,
    rpeLabel as rpeLabelFn,
    fatigueLabel as fatigueLabelFn,
  } from '../../lib/session-detail-stats';
  import { generateSessionShareCard, downloadDataUrl } from '../../lib/share-card';
  import { downloadBlob, slugify } from '../../lib/csv-export';

  const LABELS = t();
  const statusLabels: StatusLabels = { completed: LABELS.detail.completed, inProgress: LABELS.detail.inProgress, planned: LABELS.detail.planned };

  // ── Pure helpers (module scope) ────────────────────────────
  function sessionStatusLabel(s: SessionStatus): string {
    return statusLabelFn(s, statusLabels);
  }

  function typeLabelLocalized(t: SetType): string {
    return typeLabelFn(t, {
      warmup: LABELS.detail.typeWarmup,
      work: LABELS.detail.typeWork,
      top: LABELS.detail.typeTop,
      drop: LABELS.detail.typeDrop,
      failure: LABELS.detail.typeFailure,
    });
  }

  function formatDateTimeFn(iso: string): string {
    return formatDateTime(iso);
  }

  function formatDurationFn(seconds?: number): string {
    if (!seconds || seconds <= 0) return '—';
    return formatDuration(seconds);
  }

  function formatVolumeFn(v: number): string {
    return formatVolume(v);
  }

  function formatWeightFn(w: number): string {
    return formatVolume(w);
  }

  function formatRpeFn(rpe: number): string {
    if (!Number.isFinite(rpe)) return '—';
    return rpe.toString();
  }

  // Mood rendering uses the centralized helpers from src/lib/mood.ts.

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionDetailApp', () => ({
      // ── State ──
      labels: {
        ...LABELS.detail,
        printHref: localizedPath('/sessions/print'),
      },
      session: null as Session | null,
      sessionId: '',
      notFound: false,

      // ── Init ──
      init() {
        const params = new URLSearchParams(window.location.search);
        this.sessionId = params.get('id') || '';
        if (!this.sessionId) {
          this.notFound = true;
          return;
        }
        const found = getSessionById(this.sessionId);
        if (!found) {
          this.notFound = true;
          return;
        }
        this.session = found;
      },

      // ── Computed ──
      get sessionTotalVolume(): number {
        return computeSessionTotalVolume(this.session);
      },

      get totalSets(): number {
        return computeTotalSets(this.session);
      },

      get hasNotes(): boolean {
        return hasNotesFn(this.session);
      },

      get rpeStats(): { count: number; avg: number; max: number; allTen: boolean } {
        return computeRpeStats(this.session);
      },

      get rpeSuggestion(): { headline: string; detail: string; tone: 'up' | 'maintain' | 'down' } | null {
        return computeRpeSuggestion(this.rpeStats, {
          allTenHeadline: LABELS.detail.suggestionAllTenHeadline,
          allTenDetail: LABELS.detail.suggestionAllTenDetail,
          increaseHeadline: LABELS.detail.suggestionIncreaseHeadline,
          increaseDetail: LABELS.detail.suggestionIncreaseDetail,
          maintainHeadline: LABELS.detail.suggestionMaintainHeadline,
          maintainDetail: LABELS.detail.suggestionMaintainDetail,
          continueHeadline: LABELS.detail.suggestionContinueHeadline,
          continueDetail: LABELS.detail.suggestionContinueDetail,
        });
      },

      // ── Helpers ──
      exerciseVolume(ex: SessionExercise): number {
        return exerciseVolumeFn(ex);
      },

      best1RM(ex: SessionExercise): number {
        let best = 0;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          const e = calculate1RM(set.weight, set.reps);
          if (e > best) best = e;
        }
        return best;
      },

      // ── Supersets (rendered 2026-08-09) ──
      // Pure presentation over the persisted `Session.supersets` array.
      // Older sessions lack the field → the helpers return null/'' and
      // the badge stays hidden, so nothing crashes.
      trName(ex: SessionExercise): string {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).trExercise as ((n: string) => string) | undefined;
        return fn ? fn(ex.name) : ex.name;
      },

      /**
       * 1-based group ordinal + colour index for an exercise belonging
       * to a persisted superset, or null. Colour cycled g1..g5 so it
       * matches the builder badge palette.
       */
      supersetGroup(ex: SessionExercise): { n: number; color: number } | null {
        if (!this.session?.supersets) return null;
        const idx = this.session.supersets.findIndex((g) =>
          g.exercises.includes(ex.exerciseId),
        );
        if (idx === -1) return null;
        return { n: idx + 1, color: (idx % 5) + 1 };
      },

      /** Row tint class for grouped exercises, '' when not grouped. */
      supersetTint(ex: SessionExercise): string {
        const g = this.supersetGroup(ex);
        return g ? 'exo-row--g' + g.color : '';
      },

      /** "Superset 1" badge copy, '' when not grouped. */
      supersetLabelFor(ex: SessionExercise): string {
        const g = this.supersetGroup(ex);
        return g ? `${LABELS.detail.supersetLabel} ${g.n}` : '';
      },

      /** Member names of the group, joined for the tooltip. */
      supersetMembers(ex: SessionExercise): string {
        if (!this.session?.supersets) return '';
        const group = this.session.supersets.find((g) =>
          g.exercises.includes(ex.exerciseId),
        );
        if (!group) return '';
        return this.session.exercises
          .filter((e) => group.exercises.includes(e.exerciseId))
          .map((e) => this.trName(e))
          .join(' · ');
      },

      statusLabel(s: SessionStatus): string {
        return sessionStatusLabel(s);
      },

      typeLabel(t: SetType): string {
        return typeLabelLocalized(t);
      },

      formatDateTime(iso: string): string {
        return formatDateTimeFn(iso);
      },

      compareHref(): string {
        return localizedPath('/sessions/compare?id1=' + encodeURIComponent(this.session?.id || ''));
      },

      formatDuration(seconds?: number): string {
        return formatDurationFn(seconds);
      },

      formatVolume(v: number): string {
        return formatVolumeFn(v);
      },

      formatWeight(w: number): string {
        return formatWeightFn(w);
      },

      formatRpe(rpe: number): string {
        return formatRpeFn(rpe);
      },

      formatSetRpe(set: { rpe?: number | null; rpeType?: RpeType }): string {
        return formatSetRpeFn(set.rpe, set.rpeType);
      },

      /**
       * Long-form French date for the share card (no time, capitalised).
       * Falls back to the raw string if the input isn't a valid date.
       */
      formatShareDate(iso?: string): string {
        if (!iso) return '';
        return formatDateTime(iso);
      },

      rpeTone(rpe: number | undefined | null) {
        return rpeToneFn(rpe);
      },

      rpeLabel(rpe: number | undefined | null) {
        return rpeLabelFn(rpe, {
          easy: LABELS.detail.rpeEasy,
          moderate: LABELS.detail.rpeModerate,
          hard: LABELS.detail.rpeHard,
          max: LABELS.detail.rpeMaxTone,
        });
      },

      fatigueLabel(level: number | undefined | null) {
        return fatigueLabelFn(level, {
          veryFresh: LABELS.detail.fatigueVeryFresh,
          fresh: LABELS.detail.fatigueFresh,
          normal: LABELS.detail.fatigueNormal,
          tired: LABELS.detail.fatigueTired,
          exhausted: LABELS.detail.fatigueExhausted,
        });
      },

      moodEmoji(mood: SessionMood | undefined | null) {
        return moodSvgFn(mood);
      },

      moodLabel(mood: SessionMood | undefined | null) {
        return moodLabelFn(mood);
      },

      // ── Actions ──
      quickSessionHref(): string {
        if (!this.session) return localizedPath('/sessions/quick');
        return `${localizedPath('/sessions/quick')}?session=${encodeURIComponent(this.session.id)}`;
      },

      editHref(): string {
        return `${localizedPath('/sessions/create')}?edit=${encodeURIComponent(this.session?.id || '')}`;
      },

      updateStatus(status: SessionStatus) {
        if (!this.session) return;
        this.session.status = status;
        updateSession(this.session.id, { status });
      },

      openDeleteDialog() {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as
          | ((id: string) => void)
          | undefined;
        if (fn) fn('delete-session-dialog');
      },

      confirmDelete() {
        if (!this.session) return;
        const id = this.session.id;
        deleteSession(id);
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as
          | ((i: string) => void)
          | undefined;
        if (fn) fn('delete-session-dialog');
        window.location.href = localizedPath('/sessions');
      },

      // ── Fiche de séance (PDF/CSV, added 2026-08-09) ──
      /** URL of the print-friendly sheet route for the loaded session. */
      printHref(): string {
        const base = this.labels.printHref as string;
        return base + (this.session ? `?id=${encodeURIComponent(this.session.id)}` : '');
      },

      /** Downloads THIS session only as CSV (`<slug>_<date>.csv`). */
      downloadSessionCsv() {
        if (!this.session) return;
        try {
          const csv = exportSessionAsCsv(this.session);
          const datePart = (this.session.date || '').split('T')[0] || 'seance';
          downloadBlob(
            `${slugify(this.session.name)}_${datePart}.csv`,
            csv,
            'text/csv;charset=utf-8',
          );
          window.showToast(this.labels.csvDownloaded, 'success');
        } catch (err) {
          window.showToast(
            err instanceof Error ? err.message : this.labels.csvDownloadFailed,
            'error',
          );
        }
      },

      // ── Share image generation ──
      async generateShareCard(): Promise<void> {
        if (!this.session) return;
        const datePart = (this.session.date || '').split('T')[0] || 'seance';
        const filename = `muscu-${datePart}.png`;

        try {
          const dataUrl = await generateSessionShareCard(this.session, {
            labels: {
              exercises: LABELS.detail.exercises,
              shareSetsLabel: LABELS.detail.shareSetsLabel,
              volume: LABELS.sessions.volume,
              setSingular: LABELS.detail.setSingular,
              setPlural: LABELS.detail.setPlural,
              moreSingular: LABELS.detail.moreSingular,
              morePlural: LABELS.detail.morePlural,
              shareFooter: LABELS.detail.shareFooter,
              completed: LABELS.detail.completed,
              inProgress: LABELS.detail.inProgress,
              planned: LABELS.detail.planned,
            },
          });
          if (dataUrl) downloadDataUrl(dataUrl, filename);
        } catch {
          // canvas unsupported or toBlob failed — silently ignore
        }
      },
    }));
  });
</script>

<style is:global>
  /* ── Layout ── */
  .detail {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 9.6rem;
  }

  .detail__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── Header ── */
  .detail__header {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .detail__header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .detail__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: -0.01em;
    word-break: break-word;
    margin: 0;
  }

  .detail__badges {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .detail__date {
    color: var(--color-muted);
    font-size: 1.3rem;
    text-transform: capitalize;
  }

  /* ── Status section ── */
  .detail__status-section {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .detail__status-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    line-height: 1;
  }

  .detail__status-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  @media (min-width: 480px) {
    .detail__status-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Stats grid ── */
  .detail__stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 640px) {
    .detail__stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ════════════════════════════════════════════════════
     STATUS PICKER — Alpine dynamic states
     ════════════════════════════════════════════════════ */
  .detail__status-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 4.4rem;
    padding: 0 1.2rem;
    background-color: var(--color-surface);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .detail__status-btn:hover:not(.is-active) {
    background-color: var(--color-surface-2);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  .detail__status-btn:active {
    transform: scale(0.98);
  }

  .detail__status-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .detail__status-btn.is-active {
    cursor: default;
  }

  .detail__status-btn:has(.detail__status-dot--planned).is-active {
    background-color: var(--alpha-bg-soft);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  .detail__status-btn:has(.detail__status-dot--in-progress).is-active {
    background-color: color-mix(in srgb, var(--color-info) 12%, transparent);
    color: var(--color-info);
    border-color: color-mix(in srgb, var(--color-info) 40%, transparent);
  }

  .detail__status-btn:has(.detail__status-dot--completed).is-active {
    background-color: color-mix(in srgb, var(--color-success) 12%, transparent);
    color: var(--color-success);
    border-color: color-mix(in srgb, var(--color-success) 40%, transparent);
  }

  .detail__status-dot {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--color-muted);
    box-shadow: 0 0 0 2px var(--color-surface-2);
  }

  .detail__status-dot--planned {
    background-color: var(--color-muted);
  }

  .detail__status-dot--in-progress {
    background-color: var(--color-info);
  }

  .detail__status-dot--completed {
    background-color: var(--color-success);
  }

  /* ════════════════════════════════════════════════════
     STATS CARDS
     ════════════════════════════════════════════════════ */
  .detail__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.8rem 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .detail__stat-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .detail__stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background-color: var(--alpha-bg-subtle);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .detail__stat-icon svg {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }

  .detail__stat-value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .detail__stat--volume .detail__stat-icon {
    background-color: var(--color-stat-volume-bg);
    color: var(--color-stat-volume);
  }

  .detail__stat--volume .detail__stat-value {
    color: var(--color-stat-volume);
  }

  /* ════════════════════════════════════════════════════
     ACTIONS + SHEET
     ════════════════════════════════════════════════════ */
  .detail__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .detail__actions > :global(.button) {
    min-height: 4.4rem;
  }

  .detail__sheet {
    display: inline-flex;
    align-items: center;
