---
import AppLayout from "../../../layouts/AppLayout.astro";
import PageHeader from "../../../components/layout/PageHeader.astro";
import Card from "../../../components/ui/Card.astro";
import CardHeader from "../../../components/ui/CardHeader.astro";
import CardTitle from "../../../components/ui/CardTitle.astro";
import CardContent from "../../../components/ui/CardContent.astro";
import Badge from "../../../components/ui/Badge.astro";
import Button from "../../../components/ui/Button.astro";
import IconButton from "../../../components/ui/IconButton.astro";
import Input from "../../../components/ui/Input.astro";
import Dialog from "../../../components/ui/Dialog.astro";
import { TRAINING_TEMPLATES } from "../../../lib/templates";
import {
  t,
  localizedPath,
  trTemplateName,
  trTemplateDesc,
} from "../../../i18n";
import { icons } from "../../../lib/icons";
import Icon from "../../../components/ui/Icon.astro";

const L = t();
const editId = Astro.url.searchParams.get("edit");
const isEditMode = Boolean(editId);
const setTypes = [
  { value: "warmup", label: L.builder.types.warmup },
  { value: "work", label: L.builder.types.work },
  { value: "top", label: L.builder.types.top },
  { value: "drop", label: L.builder.types.drop },
  { value: "failure", label: L.builder.types.failure },
] as const;
---

<AppLayout title={isEditMode ? L.builder.editTitle : L.builder.title}>
  <PageHeader
    title={isEditMode ? L.builder.editTitle : L.builder.title}
    description={L.builder.description}
  />

  <div
    class="create__main"
    x-data="sessionBuilder()"
    x-init="init()"
    x-cloak
    @builder:remove-exercise.window="removeExercise($event.detail.index)"
    @builder:remove-superset.window="removeFromSuperset($event.detail.index)"
  >

    <div class="create__action-bar">
      <div class="create__summary" x-show="exercises.length > 0" aria-live="polite">
        <span class="create__summary-item">
          <strong x-text="exercises.length"></strong>
          <span>{L.builder.exercisesWord}</span>
        </span>
        <span class="create__summary-separator" aria-hidden="true">/</span>
        <span class="create__summary-item">
          <strong x-text="exercises.reduce((total, exercise) => total + exercise.sets.length, 0)"></strong>
          <span>{L.builder.setsPlural}</span>
        </span>
      </div>
      <Button variant="secondary" @click="discard()">
        {L.common.cancel}
      </Button>
      <Button
        variant="ghost"
        x-show="exercises.length > 1"
        @click="allExpanded ? collapseAll() : expandAll()"
        :aria-label="allExpanded ? labels.collapseAll : labels.expandAll"
      >
        <span x-text="allExpanded ? labels.collapseAll : labels.expandAll">
          {L.builder.expandAll}
        </span>
      </Button>
      <Button variant="primary" :disabled="!canSave" @click="save()">
        <Fragment set:html={icons.save(18, 18)} />
        <span x-text="editSessionId ? labels.editSaveSession : labels.saveSession">
          {L.builder.saveSession}
        </span>
      </Button>
    </div>

    <Card>
      <CardHeader>
        <CardTitle>{L.builder.infoTitle}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="create__info-grid">
          <Input
            label={L.builder.name}
            id="ses-name"
            type="text"
            required
            placeholder={L.builder.namePlaceholder}
            x-model="sessionName"
            autocomplete="off"
            maxlength={80}
          />
          <Input
            label={L.builder.date}
            id="ses-date"
            type="date"
            x-model="sessionDate"
          />
        </div>
      </CardContent>
    </Card>

    <template x-if="exercises.length === 0">
      <Card>
        <div class="create__empty-state">
          <div class="create__empty-icon" aria-hidden="true">
            <Fragment set:html={icons.dumbbellBox(48, 48)} />
          </div>
          <h3
            class="create__empty-title"
            x-text="labels.noExoAdded"
          >
            {L.builder.noExoAdded}
          </h3>
          <p class="create__empty-desc" x-text="labels.noExoDesc">
            {L.builder.noExoDesc}
          </p>
          <Button
            class="create__empty-add-btn"
            @click="openPicker()"
          >
            <Fragment set:html={icons.plus(20, 20)} />
            <span>{L.builder.addExercise}</span>
          </Button>
        </div>
      </Card>
    </template>

    <template
      x-for="(ex, exIdx) in exercises"
      :key="ex.exerciseId + '-' + exIdx"
    >
      <div x-data="exerciseCard(ex, exIdx)">
        <Card>
          <div
            class="ses-ex-superset-bar create__superset-bar"
            x-show="exercise.supersetId != null"
            x-cloak
            :class="'ses-superset-bar--g' + exercise.supersetId"
          >
            <span class="ses-superset-dot" aria-hidden="true"></span>
            <Icon name="link" size={16} class="create__superset-bar-icon" />
            <span class="create__superset-bar-label">
              <span x-text="labels.supersetLabel + ' ' + exercise.supersetId"
                >Superset</span
              >
            </span>
            <IconButton
              variant="ghost"
              icon={icons.closeX(18, 18)}
              label={L.builder.supersetRemove}
              title={L.builder.supersetRemove}
              @click="$dispatch('builder:remove-superset', { index: exerciseIndex })"
            />
          </div>

          <div class="ses-ex-header create__ex-header">
            <button
              type="button"
              class="ses-ex-toggle create__ex-toggle"
              @click="toggle()"
              :aria-expanded="expanded.toString()"
              :aria-controls="'ses-ex-body-' + exerciseIndex"
            >
              <div class="create__toggle-body">
                <div class="ses-ex-head create__ex-head">
                  <h3 class="create__ex-name" x-text="trExercise(exercise.name)">
                  </h3>
                  <Badge
                    variant="category"
                    :class="'badge--cat-' + muscleHue(exercise.muscle)"
                    x-text="trMuscle(exercise.muscle)"
                  />
                </div>
                <p
                  class="create__ex-summary"
                  x-show="!expanded"
                  x-cloak
                  x-text="summary"
                >
                </p>
              </div>
              <span
                class="ses-chevron create__ex-chevron"
                :class="{ 'is-open': expanded }"
                ><Fragment set:html={icons.chevronDown(20, 20)} /></span
              >
            </button>
            <IconButton
              variant="danger"
              icon={icons.trash(18, 18)}
              label={L.builder.removeExerciseAria}
              title={L.builder.removeExerciseTitle}
              @click="remove()"
            />
          </div>

          <div
            :id="'ses-ex-body-' + exerciseIndex"
            class="create__ex-body"
            x-show="expanded"
            x-cloak
          >
            <CardContent>
              <div
                class="create__sets-scroll"
                role="table"
                :aria-label="labels.setsFor + ' ' + exercise.name"
              >
                <div class="ses-table-head" role="row">
                  <div class="ses-cell ses-cell-num" role="columnheader">#</div>
                  <div class="ses-cell ses-cell-type" role="columnheader">
                    {L.builder.setTypeHeader}
                  </div>
                  <div class="ses-cell ses-cell-num" role="columnheader">
                    {L.builder.weightHeader}
                  </div>
                  <div class="ses-cell ses-cell-num" role="columnheader">
                    Reps
                  </div>
                  <div
                    class="ses-cell ses-cell-action"
                    role="columnheader"
                    aria-label="Actions"
                  >
                  </div>
                </div>
                <template
                  x-for="(set, setIdx) in exercise.sets"
                  :key="setIdx"
                >
                  <div class="ses-table-row" role="row">
                    <div
                      class="ses-cell ses-cell-num"
                      role="cell"
                      x-text="set.setNumber"
                    >
                    </div>
                    <div class="ses-cell ses-cell-type" role="cell">
                      <select
                        class="create__select"
                        x-model="set.type"
                        :aria-label="labels.setTypeLabel + ' ' + (setIdx + 1)"
                      >
                        {
                          setTypes.map((t) => (
                            <option value={t.value}>{t.label}</option>
                          ))
                        }
                      </select>
                    </div>
                    <div class="ses-cell ses-cell-num" role="cell">
                      <input
                        type="number"
                        class="create__input ses-input-inline"
                        min="0"
                        step="0.5"
                        x-model.number="set.weight"
                        inputmode="decimal"
                        :aria-label="labels.weightForSet + ' ' + (setIdx + 1)"
                      />
                    </div>
                    <div class="ses-cell ses-cell-num" role="cell">
                      <input
                        type="number"
                        class="create__input ses-input-inline"
                        min="0"
                        step="1"
                        x-model.number="set.reps"
                        inputmode="numeric"
                        :aria-label="labels.repsForSet + ' ' + (setIdx + 1)"
                      />
                    </div>
                    <div class="ses-cell ses-cell-action" role="cell">
                      <IconButton
                        variant="danger"
                        size="sm"
                        icon={icons.closeX(18, 18)}
                        label={L.builder.deleteSet}
                        :aria-label="labels.deleteSet + ' ' + (setIdx + 1)"
                        title={L.builder.deleteSet}
                        :disabled="exercise.sets.length <= 1"
                        @click="removeSet(setIdx)"
                      />
                    </div>
                  </div>
                </template>
              </div>

              <div class="ses-ex-actions create__ex-actions">
                <Button variant="secondary" size="sm" @click="addSet()">
                  <Fragment set:html={icons.plus(18, 18)} />
                  <span>{L.builder.addSet}</span>
                </Button>
              </div>
            </CardContent>
          </div>
        </Card>
      </div>
    </template>

    <template x-if="exercises.length > 0">
      <div class="create__add-wrap">
        <Button class="create__add-btn" @click="openPicker()">
          <Fragment set:html={icons.plus(20, 20)} />
          <span>{L.builder.addExercise}</span>
        </Button>
      </div>
    </template>

    <template x-if="exercises.length > 0">
      <Card>
        <CardHeader>
          <CardTitle>{L.builder.notesTitle}</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="create__notes">
            <div class="create__field">
              <div class="create__field-row">
                <label for="ses-rpe" class="create__label"
                  >{L.builder.rpe}</label
                >
                <span
                  class="rpe-value"
                  :class="'tone--' + rpeTone"
                  x-text="sessionRpe"></span>
              </div>
              <div class="create__rpe-slider">
                <input
                  id="ses-rpe"
                  type="range"
                  min="1"
                  max="10"
                  step="1"
                  class="ses-rpe-input create__rpe-input"
                  :class="'ses-rpe-input--' + rpeTone"
                  x-model.number="sessionRpe"
                  aria-label={L.builder.rpeAria}
                />
                <div class="create__rpe-label">
                  <span x-text="rpeLabel"></span>
                </div>
              </div>
            </div>

            <div class="create__field">
              <label class="create__label">{L.builder.fatigueTitle}</label>
              <div
                class="create__fatigue-group"
                role="radiogroup"
                aria-label={L.builder.fatigueAria}
              >
                <template x-for="i in 5" :key="'fat-' + i">
                  <button
                    type="button"
                    class="ses-fatigue-btn create__fatigue-btn"
                    :class="{ 'is-active': sessionFatigue >= i }"
                    :aria-pressed="sessionFatigue >= i"
                    :aria-label="labels.fatigueOn + ' ' + i + ' ' + labels.fatigueOutOf5"
                    @click="setFatigue(i)"
                  >
                    <Icon name="flame" size={20} />
                  </button>
                </template>
              </div>
            </div>

            <div class="create__field">
              <label class="create__label">{L.builder.moodTitle}</label>
              <div
                class="create__mood-group"
                role="radiogroup"
                aria-label={L.builder.moodAria}
              >
                <button
                  type="button"
                  class="ses-mood-btn create__mood-btn"
                  :class="{ 'is-active': sessionMood === 'great' }"
                  :aria-pressed="sessionMood === 'great'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodGreat"
                  @click="setMood('great')"
                >
                  <Icon name="smile" size={22} />
                </button>
                <button
                  type="button"
                  class="ses-mood-btn create__mood-btn"
                  :class="{ 'is-active': sessionMood === 'good' }"
                  :aria-pressed="sessionMood === 'good'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodGood"
                  @click="setMood('good')"
                >
                  <Icon name="heart" size={22} />
                </button>
                <button
                  type="button"
                  class="ses-mood-btn create__mood-btn"
                  :class="{ 'is-active': sessionMood === 'ok' }"
                  :aria-pressed="sessionMood === 'ok'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodOk"
                  @click="setMood('ok')"
                >
                  <Icon name="Meh" size={22} />
                </button>
                <button
                  type="button"
                  class="ses-mood-btn create__mood-btn"
                  :class="{ 'is-active': sessionMood === 'tired' }"
                  :aria-pressed="sessionMood === 'tired'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodTired"
                  @click="setMood('tired')"
                >
                  <Icon name="frown" size={22} />
                </button>
                <button
                  type="button"
                  class="ses-mood-btn create__mood-btn"
                  :class="{ 'is-active': sessionMood === 'bad' }"
                  :aria-pressed="sessionMood === 'bad'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodBad"
                  @click="setMood('bad')"
                >
                  <Icon name="sad" size={22} />
                </button>
              </div>
            </div>

            <div class="create__field">
              <label for="ses-notes" class="create__label"
                >{L.builder.notesLabel}</label
              >
              <textarea
                id="ses-notes"
                class="create__textarea"
                x-model="sessionNotes"
                placeholder={L.builder.notesPlaceholder}
                rows="3"
                maxlength="500"></textarea>
            </div>
          </div>
        </CardContent>
      </Card>
    </template>

    <div
      class="create__validation"
      x-show="!canSave && (sessionName.trim() || exercises.length > 0)"
      x-cloak
    >
      <template x-if="!sessionName.trim()">
        <span x-text="labels.needName">{L.builder.needName}</span>
      </template>
      <template x-if="sessionName.trim() && exercises.length === 0">
        <span x-text="labels.needExo">{L.builder.needExo}</span>
      </template>
      <template x-if="sessionName.trim() && exercises.length > 0 && exercises.some((exercise) => exercise.sets.length === 0)">
        <span x-text="labels.needSets">{L.builder.needSets}</span>
      </template>
    </div>

    <Dialog id="ses-picker-dialog" title={L.builder.pickerTitle}>
      <div class="create__picker">
        <div class="create__picker-search">
          <span class="create__picker-search-icon"
            ><Fragment set:html={icons.searchLine(20, 20)} /></span
          >
          <Input
            type="search"
            class="create__picker-input ses-search-input"
            placeholder={L.builder.searchPlaceholder}
            x-model="exerciseSearch"
            aria-label={L.builder.searchAria}
            x-ref="pickerSearch"
            @keydown.escape="closeDialogById('ses-picker-dialog')"
            autocomplete="off"
          />
        </div>

        <div
          class="create__picker-templates"
          x-show="exerciseSearch.trim() === ''"
        >
          <div class="create__picker-templates-head">
            <span class="create__picker-templates-title"
              >Templates</span
            >
            <span class="create__picker-templates-hint">{L.builder.templateHint}</span>
          </div>
          <div class="create__picker-templates-grid">
            {
              TRAINING_TEMPLATES.map((tpl) => (
                <button
                  type="button"
                  class="create__picker-tpl"
                  @click={`loadTemplate('${tpl.id}')`}
                >
                  <span class="create__picker-tpl-name">
                    {trTemplateName(tpl.name)}
                  </span>
                  <span class="create__picker-tpl-desc">
                    {trTemplateDesc(tpl.id)}
                  </span>
                  <span class="create__picker-tpl-count">
                    {tpl.exercises.length} {L.builder.exercisesWord}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="create__picker-list" role="list">
          <template x-if="availableExercises.length === 0">
            <div class="create__picker-empty">
              <p x-text="labels.emptyLibrary">{L.builder.emptyLibrary}</p>
              <a
                href={localizedPath("/exercises")}
                class="create__picker-empty-link"
                x-text="labels.createExoLink"
              >
                {L.builder.createExoLink}
              </a>
            </div>
          </template>

          <template
            x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() === ''"
          >
            <div class="create__picker-empty">
              <p x-text="labels.allAdded">{L.builder.allAdded}</p>
            </div>
          </template>

          <template
            x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() !== ''"
          >
            <div class="create__picker-empty">
              <p x-text="labels.noSearchMatch">{L.builder.noSearchMatch}</p>
            </div>
          </template>

          <template x-for="ex in filteredExercises" :key="ex.id">
            <div
              class="create__picker-item"
              role="listitem"
            >
              <button
                type="button"
                class="create__picker-item-btn"
                @click="addExercise(ex)"
                :aria-label="labels.addExoAria + ' ' + ex.name + ' ' + labels.toSession"
              >
                <span class="create__picker-item-name" x-text="trExercise(ex.name)"
                ></span>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(ex.muscle)"
                  x-text="trMuscle(ex.muscle)"
                />
              </button>
              <button
                type="button"
                class="create__picker-tip-toggle"
                @click="toggleTip(ex.id)"
                :aria-expanded="isTipOpen(ex.id).toString()"
                :aria-label="labels.showTipAria + ' ' + ex.name"
                title={L.builder.tipTitle}
                x-show="hasTip(ex.name)"
              >
                <Fragment set:html={icons.infoCircle(18, 18)} />
              </button>
              <p
                class="create__picker-tip ses-picker-tip"
                x-show="isTipOpen(ex.id) && hasTip(ex.name)"
                x-cloak
              >
                <span x-text="getTip(ex.name)"></span>
                <a
                  class="create__picker-tip-video ses-tip-video"
                  :href="getVideoUrl(ex.name)"
                  target="_blank"
                  rel="noopener noreferrer"
                  :aria-label="labels.videoAria + ' ' + ex.name + ' ' + labels.onYoutube"
                  title={L.builder.videoTitle}
                >
                  <Icon name="play" size={20} />
                  <span x-text="labels.seeTechnique">Voir la technique</span>
                </a>
              </p>
            </div>
          </template>
        </div>
      </div>

      <div slot="footer">
        <Button variant="secondary" data-dialog-close> {L.builder.close} </Button>
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import {
    getExercises,
    getSessions,
    type Exercise,
    type Session,
    type SessionMood,
  } from "../../../lib/storage";
  import { t, localizedPath } from "../../../i18n";
  import {
    rpeTone,
    type BuilderExercise,
  } from "../../../lib/session-builder-stats";
  import { exerciseCard } from "../../../components/builder/exerciseCard";
  import {
    filterExercises,
    buildNewExercise,
    loadTemplate as loadPickerTemplate,
    hasExerciseTip,
    getExerciseTipText,
    getExerciseTipVideoUrl,
  } from "../../../components/builder/exercisePicker";
  import {
    rpeLabel as rpeLabelFn,
    toggleFatigue,
    toggleMood,
  } from "../../../components/builder/sessionMeta";
  import {
    availableSupersetIds as getAvailableSupersetIds,
    nextSupersetId as getNextSupersetIdFn,
    normalizeSupersetId,
    buildSupersetChain,
    trName,
  } from "../../../components/builder/superset";
  import {
    saveSessionBuilder,
    shouldConfirmDiscard,
  } from "../../../components/builder/sessionSave";
  import {
    toggleId,
    addId,
    removeId,
    isIdIn,
    allExpanded as checkAllExpanded,
    openDialogById,
    closeDialogById,
  } from "../../../components/builder/builderState";
  import { loadEditSession } from "../../../components/builder/editSessionLoader";
  import { pickBuilderLabels } from "../../../components/builder/builderLabels";

  const LABELS = t();

  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data("exerciseCard", (...args: any[]) => exerciseCard(args[0], args[1]));

    Alpine.data("sessionBuilder", () => ({
      sessionName: "",
      sessionDate: new Date().toISOString().split("T")[0],
      exercises: [] as BuilderExercise[],
      availableExercises: [] as Exercise[],
      allSessions: [] as Session[],
      exerciseSearch: "",

      sessionRpe: 5,
      sessionFatigue: 0,
      sessionMood: "" as SessionMood | "",
      sessionNotes: "",

      expandedExercises: [] as string[],

      openTips: [] as string[],

      labels: pickBuilderLabels(LABELS as unknown as { builder: Record<string, string> }),

      editSessionId: null as string | null,

      init() {
        this.availableExercises = getExercises();
        this.allSessions = getSessions();
        (window as any).__builderSessions = this.allSessions;
        (window as any).__builderLabels = this.labels;

        window.addEventListener("builder:exercise-toggled", ((e: CustomEvent) => {
          const { exerciseId, expanded } = e.detail;
          this.expandedExercises = expanded
            ? addId(this.expandedExercises, exerciseId)
            : removeId(this.expandedExercises, exerciseId);
        }) as EventListener);

        const requestedId = new URLSearchParams(window.location.search).get("edit");
        if (!requestedId) return;
        const data = loadEditSession(requestedId);
        if (!data) return;
        this.editSessionId = data.sessionId;
        this.sessionName = data.name;
        this.sessionDate = data.date;
        this.sessionRpe = data.rpe;
        this.sessionFatigue = data.fatigue;
        this.sessionMood = data.mood as SessionMood | "";
        this.sessionNotes = data.notes;
        this.exercises = data.exercises;
        this.expandAll();
      },

      get filteredExercises(): Exercise[] {
        const addedIds = new Set(this.exercises.map((se) => se.exerciseId));
        return filterExercises(this.availableExercises, addedIds, this.exerciseSearch);
      },

      get canSave(): boolean {
        return Boolean(this.sessionName.trim()) && this.exercises.length > 0 &&
          this.exercises.every((exercise) => exercise.sets.length > 0);
      },

      get rpeTone(): "easy" | "moderate" | "hard" | "max" {
        return rpeTone(this.sessionRpe);
      },

      get rpeLabel(): string {
        return rpeLabelFn(this.sessionRpe, LABELS.builder);
      },

      isExpanded(exerciseIndex: number): boolean {
        const ex = this.exercises[exerciseIndex];
        return ex ? isIdIn(this.expandedExercises, ex.exerciseId) : false;
      },

      toggleExpand(exerciseIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;
        this.expandedExercises = toggleId(this.expandedExercises, ex.exerciseId);
      },

      expandAll() {
        this.expandedExercises = this.exercises.map((ex) => ex.exerciseId);
        window.dispatchEvent(new CustomEvent("builder:expand-all"));
      },

      collapseAll() {
        this.expandedExercises = [];
        window.dispatchEvent(new CustomEvent("builder:collapse-all"));
      },

      get allExpanded(): boolean {
        return checkAllExpanded(this.exercises.length, this.expandedExercises.length);
      },

      openPicker() {
        this.exerciseSearch = "";
        this.openDialogById("ses-picker-dialog");
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const ref = (this as any).$refs?.pickerSearch as
          HTMLInputElement | undefined;
        if (ref) {
          requestAnimationFrame(() => ref.focus());
        }
      },

      addExercise(exercise: Exercise) {
        const newEx = buildNewExercise(exercise);
        this.exercises.push(newEx);
        this.expandedExercises = [
          ...this.expandedExercises,
          newEx.exerciseId,
        ];
        this.exerciseSearch = "";
        this.closeDialogById("ses-picker-dialog");
      },

      loadTemplate(templateId: string) {
        const result = loadPickerTemplate(templateId, this.availableExercises);
        if (!result) return;
        this.availableExercises = result.newAvailable;
        const added: string[] = [];
        for (const ex of result.exercises) {
          this.exercises.push(ex);
          added.push(ex.exerciseId);
        }
        if (added.length > 0) {
          this.expandedExercises = [...this.expandedExercises, ...added];
        }
        this.exerciseSearch = "";
        this.closeDialogById("ses-picker-dialog");
      },

      findExerciseByName(name: string): Exercise | undefined {
        return this.availableExercises.find((e) => e.name === name);
      },

      hasTip(name: string): boolean {
        return hasExerciseTip(name);
      },
      getTip(name: string): string {
        return getExerciseTipText(name);
      },
      getVideoUrl(name: string): string {
        return getExerciseTipVideoUrl(name);
      },
      isTipOpen(exId: string): boolean {
        return isIdIn(this.openTips, exId);
      },
      toggleTip(exId: string) {
        this.openTips = toggleId(this.openTips, exId);
      },

      availableSupersetIds() {
        return getAvailableSupersetIds(this.exercises);
      },

      nextSupersetId() {
        return getNextSupersetIdFn(this.exercises);
      },

      onSupersetChange(exIdx: number) {
        const ex = this.exercises[exIdx];
        if (!ex) return;
        ex.supersetId = normalizeSupersetId(ex.supersetId);
      },

      removeFromSuperset(exIdx: number) {
        const ex = this.exercises[exIdx];
        if (!ex) return;
        ex.supersetId = null;
      },

      supersetChainFor(gid: number | null): string[] {
        return buildSupersetChain(this.exercises, gid, (n) => trName({ name: n } as BuilderExercise));
      },

      removeExercise(exerciseIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (ex) {
          this.expandedExercises = this.expandedExercises.filter(
            (id) => id !== ex.exerciseId,
          );
        }
        this.exercises.splice(exerciseIndex, 1);
      },

      setFatigue(level: number) {
        this.sessionFatigue = toggleFatigue(this.sessionFatigue, level);
      },

      setMood(mood: SessionMood) {
        this.sessionMood = toggleMood(this.sessionMood, mood);
      },

      discard() {
        if (shouldConfirmDiscard(this.exercises.length, this.sessionName)) {
          const ok = window.confirm(this.labels.discardConfirm);
          if (!ok) return;
        }
        window.location.href = localizedPath("/sessions");
      },

      save() {
        if (!this.canSave) return;
        saveSessionBuilder({
          name: this.sessionName,
          date: this.sessionDate,
          exercises: this.exercises,
          rpe: this.sessionRpe,
          fatigue: this.sessionFatigue,
          mood: this.sessionMood,
          notes: this.sessionNotes,
          editSessionId: this.editSessionId,
        });
        window.location.href = localizedPath("/sessions");
      },

      openDialogById,
      closeDialogById,
    }));
  });
</script>

