---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import Badge from '../../components/ui/Badge.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import Button from '../../components/ui/Button.astro';
import SearchInput from '../../components/ui/SearchInput.astro';
import IconButton from '../../components/ui/IconButton.astro';
import DialogFooter from '../../components/ui/DialogFooter.astro';
import EmptyFilterState from '../../components/ui/EmptyFilterState.astro';
import { icons } from '../../lib/icons';
import { t, localizedPath } from '../../i18n';

const L = t();
---

<AppLayout title={L.sessions.title}>
  <PageHeader
    title={L.sessions.title}
    description={L.sessions.description}
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/sessions/create")}
  />

  <div
    class="sess-list"
    x-data="sessionsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: search ── */}
    <div class="sess-list__search">
      <SearchInput
        class="relative w-full max-w-44rem"
        placeholder={L.sessions.search}
        x-model="search"
        label={L.sessions.search}
      />
    </div>

    {/* ── Meta row: count ── */}
    <div class="sess-list__meta">
      <span class="sess-list__count" x-text="countLabel"></span>
    </div>

    {/* ── Grid (when there are sessions) ── */}
    <template x-if="filtered.length > 0">
      <div class="sess__grid">
        <template x-for="session in filtered" :key="session.id">
          <article
            class="sess__card"
            :class="'sess__card--' + session.status"
            @click="navigateTo(session.id)"
            @keydown.enter="navigateTo(session.id)"
            @keydown.space.prevent="navigateTo(session.id)"
            tabindex="0"
            role="link"
            :aria-label="labels.seenAriaPrefix + session.name + ' · ' + statusLabel(session.status)"
          >
            <header class="sess__card-header">
              <div class="sess__card-title-row">
                <span class="sess__card-icon" aria-hidden="true">
                  <Fragment set:html={icons.dumbbellBox()} />
                </span>
                <div class="sess__card-title-wrap">
                  <span
                    class="sess__card-dot"
                    aria-hidden="true"
                    :class="session.status === 'completed' ? 'sess__dot--completed' : session.status === 'in-progress' ? 'sess__dot--in-progress' : 'sess__dot--planned'"
                  ></span>
                  <h3 class="sess__card-name" x-text="session.name"></h3>
                  <span
                    class="sess__card-mood"
                    x-show="session.mood"
                    :title="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                    :aria-label="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                  >
                    <span class="sess__card-mood-emoji" x-html="moodEmoji(session.mood)" aria-hidden="true"></span>
                  </span>
                </div>
              </div>
              <div class="sess__card-badges">
                <StatusBadge statusExpr="session.status" />
              </div>
            </header>

            <div
              class="sess__card-date"
              x-text="formatDate(session.date)"
            ></div>

            <div class="sess__card-stats">
              <div class="sess__card-stat">
                <span class="sess__card-stat-icon" set:html={icons.dumbbell()} />
                <span class="sess__card-stat-value" x-text="session.exercises.length"></span>
                <span class="sess__card-stat-label" x-text="session.exercises.length > 1 ? labels.exoPlural : labels.exoSingular"></span>
              </div>
              <div class="sess__volume-badge">
                <span class="sess__volume-icon" set:html={icons.volumeBox()} />
                <span x-text="formatVolume(totalVolume(session))"></span>
              </div>
              <div class="sess__card-muscle" x-show="primaryMuscle(session)">
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(primaryMuscle(session))"
                >
                  <span x-text="muscleLabel(primaryMuscle(session))"></span>
                </Badge>
              </div>
            </div>

            <footer class="sess__card-footer">
              <IconButton
                variant="ghost"
                icon={icons.dots()}
                label={L.sessions.moreActions}
                @click.stop="menuId = menuId === session.id ? '' : session.id"
                @keydown.enter.stop
                @keydown.space.stop
                :aria-expanded="(menuId === session.id).toString()"
                title={L.sessions.moreActions}
              />
              <IconButton
                variant="danger"
                icon={icons.trash()}
                label={L.sessions.delete}
                title={L.sessions.delete}
                @click.stop="deleteSession(session.id)"
                @keydown.enter.stop
                @keydown.space.stop
              />

              <template x-if="menuId === session.id">
                {/* Enter/Space inside the popover must NOT bubble to the
                    card article's navigate() keydown handlers. */}
                <div class="sess__menu" @click.stop @keydown.enter.stop @keydown.space.stop>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    x-show="session.status !== 'in-progress'"
                    @click="menuId = ''; setStatus(session.id, 'in-progress')"
                  >
                    <span x-text="labels.resume"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    x-show="session.status !== 'completed'"
                    @click="menuId = ''; setStatus(session.id, 'completed')"
                  >
                    <span x-text="labels.markComplete"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    @click="menuId = ''; duplicateSession(session.id)"
                  >
                    <span x-text="labels.duplicate"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    @click="menuId = ''; openMove(session.id)"
                  >
                    <span x-text="labels.moveDate"></span>
                  </Button>
                </div>
              </template>
            </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state: no sessions at all ── */}
    <template x-if="!hasSessions">
      <Card>
        <EmptyState
          iconName="dumbbell"
          title={L.sessions.emptyTitle}
          description={L.sessions.emptyDesc}
          actionLabel={L.sessions.createAction}
          actionHref={localizedPath("/sessions/create")}
        />
      </Card>
    </template>

    {/* ── Empty state: no results matching search ── */}
    <template x-if="hasSessions && filtered.length === 0">
      <EmptyFilterState
        titleExpr="labels.noResult"
        textExpr="labels.noMatchPrefix + ' &laquo; ' + search + ' &raquo;.'"
        resetLabel={L.sessions.resetSearch}
      />
    </template>

    {/* ── Backdrop for the quick-actions menu ── */}
    <div
      class="sess-list__backdrop"
      x-show="menuId !== ''"
      x-cloak
      @click="menuId = ''"
    ></div>

    {/* ── Move session dialog ── */}
    <Dialog id="sess-move-dialog" title={L.sessions.moveTitle}>
      <label class="sess-list__move-label">
        <span class="sess-list__move-label-text">{L.sessions.moveDateLabel}</span>
        <input
          type="date"
          class="sess-list__move-input"
          x-model="moveDate"
          :max="todayIso"
        />
      </label>
      <div slot="footer">
        <DialogFooter
          cancelLabel={L.common.cancel}
          confirmLabel={L.sessions.move}
          confirmDisabled="!moveDate"
          confirmClick="confirmMove()"
        />
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getSessionById,
    saveSession,
    updateSession,
    deleteSession,
    type Session,
    type SessionMood,
    type SessionStatus,
  } from '../../lib/storage';
  import { t, localizedPath } from '../../i18n';
  import { formatDateTime as formatDate, formatVolume } from '../../lib/format';
  import { statusLabel as statusLabelFn, type StatusLabels } from '../../lib/session-utils';
  import { moodSvg } from '../../lib/mood';

  const LABELS = t();
  const statusLabels: StatusLabels = { completed: LABELS.sessions.completed, inProgress: LABELS.sessions.inProgress, planned: LABELS.sessions.planned };
  function statusLabel(status: SessionStatus): string { return statusLabelFn(status, statusLabels); }

  function moodEmojiFn(mood: SessionMood | undefined | null): string {
    return moodSvg(mood);
  }

  function moodLabelFn(mood: SessionMood | undefined | null): string {
    if (!mood) return '';
    if (mood === 'great') return LABELS.sessions.moodGreat;
    if (mood === 'good') return LABELS.sessions.moodGood;
    if (mood === 'ok') return LABELS.sessions.moodOk;
    if (mood === 'tired') return LABELS.sessions.moodTired;
    return LABELS.sessions.moodBad;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionsApp', () => ({
      // ── State ──
      sessions: [] as Session[],
      search: '',
      menuId: '',
      moveSessionId: '',
      moveDate: '',
      labels: {
        exoPlural: LABELS.sessions.exoPlural,
        exoSingular: LABELS.sessions.exoSingular,
        moodLabel: LABELS.sessions.moodLabel,
        noResult: LABELS.sessions.noResult,
        noMatchPrefix: LABELS.sessions.noMatchPrefix,
        resetSearch: LABELS.sessions.resetSearch,
        noSession: LABELS.sessions.noSession,
        noMatch: LABELS.sessions.noMatch,
        seanceSingular: LABELS.sessions.seanceSingular,
        seancePlural: LABELS.sessions.seancePlural,
        pluralS: LABELS.sessions.pluralS,
        deleteConfirm: LABELS.sessions.deleteConfirm,
        seenAriaPrefix: LABELS.sessions.seenAriaPrefix,
        moreActions: LABELS.sessions.moreActions,
        resume: LABELS.sessions.resume,
        markComplete: LABELS.sessions.markComplete,
        duplicate: LABELS.sessions.duplicate,
        moveDate: LABELS.sessions.moveDate,
      },

      get todayIso(): string {
        return new Date().toISOString().slice(0, 10);
      },

      // ── Init ──
      init() {
        this.refresh();
      },

      refresh() {
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
      },

      // ── Derived ──
      get filtered(): Session[] {
        const q = this.search.trim().toLowerCase();
        if (!q) return this.sessions;
        return this.sessions.filter((s) =>
          s.name.toLowerCase().includes(q),
        );
      },

      get countLabel(): string {
        const n = this.filtered.length;
        if (n === 0) return this.sessions.length === 0 ? this.labels.noSession : this.labels.noMatch;
        return `${n} ${this.labels.seanceSingular}${n > 1 ? this.labels.pluralS : ''}`;
      },

      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      // ── Computations ──
      totalVolume(session: Session): number {
        return session.exercises.reduce(
          (sum, ex) =>
            sum + ex.sets.reduce(
              (s, set) => s + (set.completed ? set.weight * set.reps : 0),
              0,
            ),
          0,
        );
      },

      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDate(iso);
      },

      formatVolume(volume: number): string {
        return formatVolume(volume);
      },

      moodEmoji(mood: SessionMood | undefined | null) {
        return moodEmojiFn(mood);
      },

      moodLabel(mood: SessionMood | undefined | null) {
        return moodLabelFn(mood);
      },

      /** Most frequent muscle across the session's exercises ('' when none). */
      primaryMuscle(session: Session): string {
        const counts = new Map<string, number>();
        for (const ex of session.exercises) {
          if (!ex.muscle) continue;
          counts.set(ex.muscle, (counts.get(ex.muscle) ?? 0) + 1);
        }
        let best = '';
        let bestCount = 0;
        for (const [muscle, count] of counts) {
          if (count > bestCount) {
            best = muscle;
            bestCount = count;
          }
        }
        return best;
      },

      /** Translated stored muscle group for display (FR stays as-is). */
      muscleLabel(name: string): string {
        const tr = (window as { trMuscle?: (m: string) => string }).trMuscle;
        return tr ? tr(name) : name;
      },

      // ── Actions ──
      navigateTo(id: string) {
        window.location.href = localizedPath('/sessions/detail?id=' + encodeURIComponent(id));
      },

      deleteSession(id: string) {
        // eslint-disable-next-line no-alert
        if (window.confirm(this.labels.deleteConfirm)) {
          deleteSession(id);
          this.sessions = this.sessions.filter((s) => s.id !== id);
        }
      },

      // ── Quick actions ──
      setStatus(id: string, status: SessionStatus) {
        updateSession(id, { status });
        this.refresh();
      },

      duplicateSession(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        const copy: Omit<Session, 'id'> = {
          name: src.name + ' ' + LABELS.sessions.copySuffix,
          date: new Date().toISOString(),
          status: 'planned',
          exercises: src.exercises.map((ex) => ({
            ...ex,
            sets: ex.sets.map((set) => ({ ...set, completed: false })),
          })),
        };
        if (src.supersets) copy.supersets = src.supersets.map((g) => ({ ...g }));
        saveSession(copy);
        this.refresh();
      },

      openMove(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        this.moveSessionId = id;
        this.moveDate = (src.date || '').slice(0, 10);
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).openDialog?.('sess-move-dialog');
      },

      confirmMove() {
        if (!this.moveSessionId || !this.moveDate) return;
        const date = new Date(this.moveDate + 'T12:00:00').toISOString();
        updateSession(this.moveSessionId, { date, status: 'planned' });
        this.moveSessionId = '';
        this.moveDate = '';
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).closeDialog?.('sess-move-dialog');
        this.refresh();
      },
    }));
  });
</script>

<style>
  /* ── Layout ── */
  .sess-list {
    padding-bottom: 9.6rem;
  }

  .sess-list__search {
    margin-bottom: 2rem;
  }

  .sess-list__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.6rem;
  }

  .sess-list__count {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  /* ── Grid ── */
  .sess__grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  /* ── Card ── */
  .sess__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.8rem 2rem;
    padding: 2.2rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    cursor: pointer;
    transition: background-color var(--transition-base);
  }

  .sess__card:hover {
    background: var(--alpha-bg-subtle);
  }

  .sess__card:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .sess__card-header {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }

  .sess__card-title-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1;
  }

  .sess__card-icon {
    display: none;
  }

  .sess__card-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1;
  }

  .sess__card-dot {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    flex-shrink: 0;
    background: var(--color-muted);
  }

  .sess__dot--completed { background: var(--color-success); }
  .sess__dot--in-progress { background: var(--color-info); }
  .sess__dot--planned { background: var(--color-muted); }

  .sess__card-name {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    letter-spacing: -0.04em;
    word-break: break-word;
    margin: 0;
  }

  .sess__card-mood {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    cursor: help;
  }

  .sess__card-mood-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    color: var(--color-text);
  }

  .sess__card-badges {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .sess__card-date {
    grid-column: 1;
    grid-row: 2;
    font-size: 1.2rem;
    color: var(--color-muted);
    text-transform: capitalize;
    line-height: 1.3;
  }

  .sess__card-stats {
    grid-column: 1;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 2rem;
    padding-top: 0.4rem;
  }

  .sess__card-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sess__card-stat-icon {
    color: var(--color-muted);
    flex-shrink: 0;
    display: inline-flex;
  }

  .sess__card-stat-icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .sess__card-stat-value {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .sess__card-stat-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .sess__volume-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.8rem;
    padding: 0 1.1rem;
    background: var(--color-stat-volume-bg);
    border: 1px solid color-mix(in srgb, var(--color-stat-volume) 30%, transparent);
    border-radius: 999px;
    color: var(--color-stat-volume);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .sess__volume-icon {
    flex-shrink: 0;
    display: inline-flex;
  }

  .sess__volume-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .sess__card-muscle {
    display: inline-flex;
    align-items: center;
  }

  .sess__card-footer {
    grid-column: 2;
    grid-row: 1 / 4;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  @media (max-width: 640px) {
    .sess__card {
      padding: 1.8rem 0;
    }
    .sess__card-name {
      font-size: 1.8rem;
    }
    .sess__card-stat-value {
      font-size: 1.4rem;
    }
  }

  /* ════════════════════════════════════════════════════
     MENU
     ════════════════════════════════════════════════════ */
  .sess__menu {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.6rem);
    z-index: 6;
    min-width: 20rem;
    padding: 0.6rem;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
  }

  .sess__menu-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    min-height: 4.4rem;
    padding: 0 1.2rem;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    appearance: none;
    transition: background-color 140ms ease;
  }

  .sess__menu-item:hover {
    background: var(--alpha-bg-soft);
  }

  /* ════════════════════════════════════════════════════
     BACKDROP
     ════════════════════════════════════════════════════ */
  .sess-list__backdrop {
    position: fixed;
    inset: 0;
    z-index: 3;
    background: transparent;
  }

  /* ════════════════════════════════════════════════════
     MOVE DIALOG
     ════════════════════════════════════════════════════ */
  .sess-list__move-label {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .sess-list__move-label-text {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .sess-list__move-input {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.4rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.2rem;
    outline: none;
    transition: all 140ms ease;
  }

  .sess-list__move-input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  /* ════════════════════════════════════════════════════
     CARD — hover arrow pseudo-element + :has() guard
     ════════════════════════════════════════════════════ */
  .sess__card::after {
    content: '→';
    position: absolute;
    top: 1.8rem;
    right: 1.6rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-base), transform var(--transition-base);
