---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import Badge from '../../components/ui/Badge/Badge.astro';
import Button from '../../components/ui/Button/Button.astro';
import SearchInput from '../../components/ui/SearchInput.astro';
import IconButton from '../../components/ui/IconButton.astro';
import { icons } from '../../lib/icons';
import { t, localizedPath } from '../../i18n';

const L = t();
---

<AppLayout title={L.sessions.title}>
  <PageHeader
    title={L.sessions.title}
    description={L.sessions.description}
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/sessions/create")}
  />

  <div
    class="pb-24"
    x-data="sessionsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: search ── */}
    <div class="mb-5">
      <SearchInput
        class="relative w-full max-w-44rem"
        placeholder={L.sessions.search}
        x-model="search"
        label={L.sessions.search}
      />
    </div>

    {/* ── Meta row: count ── */}
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class="text-[1.1rem] text-muted uppercase tracking-[0.14em] font-semibold" x-text="countLabel"></span>
    </div>

    {/* ── Grid (when there are sessions) ── */}
    <template x-if="filtered.length > 0">
      <div class="sess__grid grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <template x-for="session in filtered" :key="session.id">
          <article
            class="sess__card relative flex flex-col gap-3 p-5 bg-[var(--surface-panel)] border border-border rounded-lg cursor-pointer transition-all duration-200 sm:max-[480px]:p-4"
            :class="'sess__card--' + session.status"
            @click="navigateTo(session.id)"
            @keydown.enter="navigateTo(session.id)"
            @keydown.space.prevent="navigateTo(session.id)"
            tabindex="0"
            role="link"
            :aria-label="labels.seenAriaPrefix + session.name + ' · ' + statusLabel(session.status)"
          >
            <header class="flex items-start justify-between gap-2.5 min-w-0">
              <div class="flex items-center gap-2 min-w-0 flex-1">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[var(--alpha-bg-subtle)] text-muted flex-shrink-0" aria-hidden="true">
                  <Fragment set:html={icons.dumbbellBox()} />
                </span>
                <div class="flex items-center gap-2 min-w-0 flex-1">
                  <span
                    class="w-2.5 h-2.5 rounded-full flex-shrink-0"
                    aria-hidden="true"
                    :class="session.status === 'completed' ? 'bg-success' : session.status === 'in-progress' ? 'bg-info' : 'bg-muted'"
                  ></span>
                  <h3 class="text-display text-xl font-bold leading-tight text-text break-words pr-4 sm:max-[480px]:text-[1.6rem]" x-text="session.name"></h3>
                  <span
                    class="inline-flex items-center justify-center flex-shrink-0 w-6.5 h-6.5 rounded-full bg-surface-2 border border-border cursor-help"
                    x-show="session.mood"
                    :title="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                    :aria-label="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                  >
                    <span class="inline-flex items-center justify-center leading-none text-text" x-html="moodEmoji(session.mood)" aria-hidden="true"></span>
                  </span>
                </div>
              </div>
              <div class="inline-flex flex-col items-end gap-1 flex-shrink-0">
                <div x-show="session.status === 'completed'">
                  <Badge variant="success" size="sm"><span x-text="statusLabel(session.status)"></span></Badge>
                </div>
                <div x-show="session.status === 'in-progress'">
                  <Badge variant="info" size="sm"><span x-text="statusLabel(session.status)"></span></Badge>
                </div>
                <div x-show="session.status !== 'completed' && session.status !== 'in-progress'">
                  <Badge variant="default" size="sm"><span x-text="statusLabel(session.status)"></span></Badge>
                </div>
              </div>
            </header>

            <div
              class="text-sm text-muted capitalize leading-snug"
              x-text="formatDate(session.date)"
            ></div>

            <div class="flex flex-wrap gap-[1.4rem_2rem] py-1 px-0 pb-1.5">
              <div class="inline-flex items-center gap-1.5">
                <span class="text-muted flex-shrink-0 [&_svg]:w-4 [&_svg]:h-4" set:html={icons.dumbbell()} />
                <span class="text-display text-base font-bold text-text tabular-nums leading-none sm:max-[480px]:text-[1.4rem]" x-text="session.exercises.length"></span>
                <span class="text-[1.1rem] text-muted uppercase tracking-[0.08em] font-semibold" x-text="session.exercises.length > 1 ? labels.exoPlural : labels.exoSingular"></span>
              </div>
              <div class="sess__volume-badge inline-flex items-center gap-1.25 h-7 px-2.75 bg-[var(--color-stat-volume-bg)] border border-[color-mix(in_srgb,var(--color-stat-volume)_30%,transparent)] rounded-pill text-[var(--color-stat-volume)] text-display text-sm font-bold tracking-[0.02em] tabular-nums leading-none">
                <span class="flex-shrink-0 [&_svg]:w-3.5 [&_svg]:h-3.5" set:html={icons.volumeBox()} />
                <span x-text="formatVolume(totalVolume(session))"></span>
              </div>
              <div class="inline-flex items-center" x-show="primaryMuscle(session)">
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(primaryMuscle(session))"
                >
                  <span x-text="muscleLabel(primaryMuscle(session))"></span>
                </Badge>
              </div>
            </div>

            <footer class="relative flex items-center justify-end mt-auto pt-1">
              <IconButton
                variant="ghost"
                icon={icons.dots()}
                label={L.sessions.moreActions}
                @click.stop="menuId = menuId === session.id ? '' : session.id"
                @keydown.enter.stop
                @keydown.space.stop
                :aria-expanded="(menuId === session.id).toString()"
                title={L.sessions.moreActions}
              />
              <IconButton
                variant="danger"
                icon={icons.trash()}
                label={L.sessions.delete}
                title={L.sessions.delete}
                @click.stop="deleteSession(session.id)"
                @keydown.enter.stop
                @keydown.space.stop
              />

              <template x-if="menuId === session.id">
                {/* Enter/Space inside the popover must NOT bubble to the
                    card article's navigate() keydown handlers. */}
                <div class="sess__menu absolute right-0 bottom-[calc(100%+0.6rem)] z-20 min-w-50 p-1.5 bg-surface-3 border border-border rounded-md shadow-[0_12px_32px_rgb(0,0,0/0.35)]" @click.stop @keydown.enter.stop @keydown.space.stop>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="flex items-center justify-start w-full min-h-11 px-3 bg-transparent border-none rounded-sm text-text font-body text-sm font-semibold text-left cursor-pointer appearance-none transition-colors duration-140 hover:bg-[var(--alpha-bg-soft)]"
                    x-show="session.status !== 'in-progress'"
                    @click="menuId = ''; setStatus(session.id, 'in-progress')"
                  >
                    <span x-text="labels.resume"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="flex items-center justify-start w-full min-h-11 px-3 bg-transparent border-none rounded-sm text-text font-body text-sm font-semibold text-left cursor-pointer appearance-none transition-colors duration-140 hover:bg-[var(--alpha-bg-soft)]"
                    x-show="session.status !== 'completed'"
                    @click="menuId = ''; setStatus(session.id, 'completed')"
                  >
                    <span x-text="labels.markComplete"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="flex items-center justify-start w-full min-h-11 px-3 bg-transparent border-none rounded-sm text-text font-body text-sm font-semibold text-left cursor-pointer appearance-none transition-colors duration-140 hover:bg-[var(--alpha-bg-soft)]"
                    @click="menuId = ''; duplicateSession(session.id)"
                  >
                    <span x-text="labels.duplicate"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="flex items-center justify-start w-full min-h-11 px-3 bg-transparent border-none rounded-sm text-text font-body text-sm font-semibold text-left cursor-pointer appearance-none transition-colors duration-140 hover:bg-[var(--alpha-bg-soft)]"
                    @click="menuId = ''; openMove(session.id)"
                  >
                    <span x-text="labels.moveDate"></span>
                  </Button>
                </div>
              </template>
            </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state: no sessions at all ── */}
    <template x-if="!hasSessions">
      <Card>
        <EmptyState
          iconName="dumbbell"
          title={L.sessions.emptyTitle}
          description={L.sessions.emptyDesc}
          actionLabel={L.sessions.createAction}
          actionHref={localizedPath("/sessions/create")}
        />
      </Card>
    </template>

    {/* ── Empty state: no results matching search ── */}
    <template x-if="hasSessions && filtered.length === 0">
      <Card>
        <div class="flex flex-col items-center gap-3 py-4 px-2">
          <h3 class="text-display text-[1.5rem] font-bold text-text" x-text="labels.noResult">{L.sessions.noResult}</h3>
          <p class="text-muted text-[1.3rem] text-center [&_span]:text-text [&_span]:font-semibold" x-text="labels.noMatchPrefix + ' « ' + search + ' ».'">
            {L.sessions.noMatchPrefix} « <span x-text="search"></span> ».
          </p>
          <button
            type="button"
            class="inline-flex items-center min-h-11 px-4 bg-transparent border border-border rounded-md text-muted font-body text-sm font-semibold cursor-pointer transition-all duration-140 hover:bg-surface-2 hover:text-text hover:border-[var(--alpha-border)] active:scale-[0.97] motion-reduce:transition-none motion-reduce:transform-none"
            @click="search = ''"
            x-text="labels.resetSearch"
          >
            {L.sessions.resetSearch}
          </button>
        </div>
      </Card>
    </template>

    {/* ── Backdrop for the quick-actions menu ── */}
    <div
      class="fixed inset-0 z-15 bg-transparent"
      x-show="menuId !== ''"
      x-cloak
      @click="menuId = ''"
    ></div>

    {/* ── Move session dialog ── */}
    <Dialog id="sess-move-dialog" title={L.sessions.moveTitle}>
      <label class="flex flex-col gap-2">
        <span class="text-[1.3rem] font-semibold text-muted">{L.sessions.moveDateLabel}</span>
        <input
          type="date"
          class="w-full h-12 px-3.5 bg-surface-2 border border-border rounded-md text-text font-body text-sm outline-none transition-all duration-140 focus:border-accent focus:shadow-[var(--focus-ring)]"
          x-model="moveDate"
          :max="todayIso"
        />
      </label>
      <div slot="footer">
        <button
          type="button"
          data-dialog-close
          class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-sm)] font-semibold transition-all duration-[160ms] select-none whitespace-nowrap active:scale-[0.97] bg-transparent text-muted border border-border hover:text-white hover:border-white/20 h-12 px-5 text-[1.3rem] min-w-[8rem]"
        >
          {L.common.cancel}
        </button>
        <button
          type="button"
          class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-sm)] font-semibold transition-all duration-[160ms] select-none whitespace-nowrap active:scale-[0.97] bg-accent text-accent-foreground border border-accent/45 hover:bg-accent-hover hover:brightness-110 h-12 px-5 text-[1.3rem] min-w-[8rem]"
          :disabled="!moveDate"
          @click="confirmMove()"
        >
          {L.sessions.move}
        </button>
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getSessionById,
    saveSession,
    updateSession,
    deleteSession,
    type Session,
    type SessionMood,
    type SessionStatus,
  } from '../../lib/storage';
  import { t, localizedPath } from '../../i18n';
  import { formatDateTime as formatDate, formatVolume } from '../../lib/format';
  import { statusLabel as statusLabelFn, type StatusLabels } from '../../lib/session-utils';
  import { moodSvg } from '../../lib/mood';

  const LABELS = t();
  const statusLabels: StatusLabels = { completed: LABELS.sessions.completed, inProgress: LABELS.sessions.inProgress, planned: LABELS.sessions.planned };
  function statusLabel(status: SessionStatus): string { return statusLabelFn(status, statusLabels); }

  function moodEmojiFn(mood: SessionMood | undefined | null): string {
    return moodSvg(mood);
  }

  function moodLabelFn(mood: SessionMood | undefined | null): string {
    if (!mood) return '';
    if (mood === 'great') return LABELS.sessions.moodGreat;
    if (mood === 'good') return LABELS.sessions.moodGood;
    if (mood === 'ok') return LABELS.sessions.moodOk;
    if (mood === 'tired') return LABELS.sessions.moodTired;
    return LABELS.sessions.moodBad;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionsApp', () => ({
      // ── State ──
      sessions: [] as Session[],
      search: '',
      menuId: '',
      moveSessionId: '',
      moveDate: '',
      labels: {
        exoPlural: LABELS.sessions.exoPlural,
        exoSingular: LABELS.sessions.exoSingular,
        moodLabel: LABELS.sessions.moodLabel,
        noResult: LABELS.sessions.noResult,
        noMatchPrefix: LABELS.sessions.noMatchPrefix,
        resetSearch: LABELS.sessions.resetSearch,
        noSession: LABELS.sessions.noSession,
        noMatch: LABELS.sessions.noMatch,
        seanceSingular: LABELS.sessions.seanceSingular,
        seancePlural: LABELS.sessions.seancePlural,
        pluralS: LABELS.sessions.pluralS,
        deleteConfirm: LABELS.sessions.deleteConfirm,
        seenAriaPrefix: LABELS.sessions.seenAriaPrefix,
        moreActions: LABELS.sessions.moreActions,
        resume: LABELS.sessions.resume,
        markComplete: LABELS.sessions.markComplete,
        duplicate: LABELS.sessions.duplicate,
        moveDate: LABELS.sessions.moveDate,
      },

      get todayIso(): string {
        return new Date().toISOString().slice(0, 10);
      },

      // ── Init ──
      init() {
        this.refresh();
      },

      refresh() {
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
      },

      // ── Derived ──
      get filtered(): Session[] {
        const q = this.search.trim().toLowerCase();
        if (!q) return this.sessions;
        return this.sessions.filter((s) =>
          s.name.toLowerCase().includes(q),
        );
      },

      get countLabel(): string {
        const n = this.filtered.length;
        if (n === 0) return this.sessions.length === 0 ? this.labels.noSession : this.labels.noMatch;
        return `${n} ${this.labels.seanceSingular}${n > 1 ? this.labels.pluralS : ''}`;
      },

      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      // ── Computations ──
      totalVolume(session: Session): number {
        return session.exercises.reduce(
          (sum, ex) =>
            sum + ex.sets.reduce(
              (s, set) => s + (set.completed ? set.weight * set.reps : 0),
              0,
            ),
          0,
        );
      },

      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDate(iso);
      },

      formatVolume(volume: number): string {
        return formatVolume(volume);
      },

      moodEmoji(mood: SessionMood | undefined | null) {
        return moodEmojiFn(mood);
      },

      moodLabel(mood: SessionMood | undefined | null) {
        return moodLabelFn(mood);
      },

      /** Most frequent muscle across the session's exercises ('' when none). */
      primaryMuscle(session: Session): string {
        const counts = new Map<string, number>();
        for (const ex of session.exercises) {
          if (!ex.muscle) continue;
          counts.set(ex.muscle, (counts.get(ex.muscle) ?? 0) + 1);
        }
        let best = '';
        let bestCount = 0;
        for (const [muscle, count] of counts) {
          if (count > bestCount) {
            best = muscle;
            bestCount = count;
          }
        }
        return best;
      },

      /** Translated stored muscle group for display (FR stays as-is). */
      muscleLabel(name: string): string {
        const tr = (window as { trMuscle?: (m: string) => string }).trMuscle;
        return tr ? tr(name) : name;
      },

      // ── Actions ──
      navigateTo(id: string) {
        window.location.href = localizedPath('/sessions/detail?id=' + encodeURIComponent(id));
      },

      deleteSession(id: string) {
        // eslint-disable-next-line no-alert
        if (window.confirm(this.labels.deleteConfirm)) {
          deleteSession(id);
          this.sessions = this.sessions.filter((s) => s.id !== id);
        }
      },

      // ── Quick actions ──
      setStatus(id: string, status: SessionStatus) {
        updateSession(id, { status });
        this.refresh();
      },

      duplicateSession(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        const copy: Omit<Session, 'id'> = {
          name: src.name + ' ' + LABELS.sessions.copySuffix,
          date: new Date().toISOString(),
          status: 'planned',
          exercises: src.exercises.map((ex) => ({
            ...ex,
            sets: ex.sets.map((set) => ({ ...set, completed: false })),
          })),
        };
        if (src.supersets) copy.supersets = src.supersets.map((g) => ({ ...g }));
        saveSession(copy);
        this.refresh();
      },

      openMove(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        this.moveSessionId = id;
        this.moveDate = (src.date || '').slice(0, 10);
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).openDialog?.('sess-move-dialog');
      },

      confirmMove() {
        if (!this.moveSessionId || !this.moveDate) return;
        const date = new Date(this.moveDate + 'T12:00:00').toISOString();
        updateSession(this.moveSessionId, { date, status: 'planned' });
        this.moveSessionId = '';
        this.moveDate = '';
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).closeDialog?.('sess-move-dialog');
        this.refresh();
      },
    }));
  });
</script>

<style>
  /* ════════════════════════════════════════════════════
     SEARCH — :global() overrides for child component
     ════════════════════════════════════════════════════ */
  .sess__search :global(.sess__search-input) {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.6rem 0 4.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    line-height: 1.2;
    -webkit-appearance: none;
    appearance: none;
  }

  .sess__search :global(.sess__search-input)::placeholder {
    color: var(--alpha-text-faint);
  }

  .sess__search :global(.sess__search-input)::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  /* ════════════════════════════════════════════════════
     CARD — hover arrow pseudo-element + :has() guard
     ════════════════════════════════════════════════════ */
  .sess__card::after {
    content: '→';
    position: absolute;
    top: 1.8rem;
    right: 1.6rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-base), transform var(--transition-base);
    pointer-events: none;
  }

  .sess__card:hover:not(:has(.sess__menu)) {
    background-color: var(--surface-panel-elevated);
    border-color: var(--alpha-border);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }

  .sess__card:hover::after {
    opacity: 0.7;
    transform: translateX(0);
  }

  .sess__card:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .sess__card:focus-visible::after {
    opacity: 0.7;
    transform: translateX(0);
  }

  /* ════════════════════════════════════════════════════
     RESPONSIVE — small screens
     ════════════════════════════════════════════════════ */
  @media (max-width: 480px) {
    .sess__search :global(.sess__search-input) {
      height: 4.4rem;
      font-size: 1.3rem;
    }
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .sess__card,
    .sess__card::after {
      transition: none;
    }
    .sess__card:hover {
      transform: none;
    }
  }

  /* ════════════════════════════════════════════════════
     WORKOUT LOG COMPOSITION — list-style layout override
     ════════════════════════════════════════════════════ */
  .sess__grid { display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--color-border); }
  .sess__card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.8rem 2rem; padding: 2.2rem 0; background: transparent; border: 0; border-bottom: 1px solid var(--color-border); border-radius: 0; box-shadow: none; }
  .sess__card::after { content: '↗'; top: 2.1rem; right: 0; opacity: 0.45; transform: none; color: var(--color-accent); }
  .sess__card:hover:not(:has(.sess__menu)) { background: var(--alpha-bg-subtle); border-color: var(--color-border); box-shadow: none; transform: none; }
  .sess__card:hover::after, .sess__card:focus-visible::after { opacity: 1; transform: none; }
  .sess__card-head { grid-column: 1 / -1; }
  .sess__card-date { grid-column: 1; grid-row: 2; }
  .sess__card-meta { grid-column: 1; grid-row: 3; padding-top: 0.4rem; }
  .sess__card-icon { display: none; }
  .sess__card-name { font-size: 2.2rem; letter-spacing: -0.04em; }
  .sess__volume-badge { border-radius: var(--radius-sm); }
  @media (max-width: 640px) {
    .sess__card { grid-template-columns: minmax(0, 1fr) auto; padding: 1.8rem 0; }
    .sess__card-name { font-size: 1.8rem; }
  }
</style>
