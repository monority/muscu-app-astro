---

import { t } from '../i18n';
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import CardHeader from '../components/ui/CardHeader.astro';
import CardTitle from '../components/ui/CardTitle.astro';
import CardContent from '../components/ui/CardContent.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import BarbellResult from '../components/calculator/BarbellResult.astro';
import DumbbellResult from '../components/calculator/DumbbellResult.astro';
import { icons } from '../lib/icons';
const L = t();
---

<AppLayout title={L.calculateur.title}>
  <PageHeader
    title={L.calculateur.title}
    description={L.calculateur.description}
  />

  <div
    class="calc"
    x-data="plateCalculator()"
    x-cloak
  >
    <div class="calc__tabs" role="tablist" aria-label={L.calculateur.modeAria}>
      <button
        type="button"
        class="calc__tab"
        :class="mode === 'bar' ? 'calc__tab--active' : ''"
        :aria-selected="mode === 'bar'"
        role="tab"
        @click="mode = 'bar'"
      >
        <Fragment set:html={icons.barbell(18, 18)} />
        {L.calculateur.modeBarre}
      </button>
      <button
        type="button"
        class="calc__tab"
        :class="mode === 'dumbbell' ? 'calc__tab--active' : ''"
        :aria-selected="mode === 'dumbbell'"
        role="tab"
        @click="mode = 'dumbbell'"
      >
        <Fragment set:html={icons.dumbbellSimple(18, 18)} />
        {L.calculateur.modeHaltere}
      </button>
    </div>

    <Card>
      <CardHeader>
        <CardTitle>{L.calculateur.targetLabel}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="calc__inputs">
          <Input
            label={L.calculateur.totalWeight}
            id="calc-target"
            type="number"
            required
            step="0.5"
            min="0"
            inputmode="decimal"
            x-model.number="target"
            placeholder={L.calculateur.targetPlaceholder}
          />
          <div x-show="mode === 'bar'">
            <Select
              label={L.calculateur.barWeight}
              id="calc-bar"
              options={[
                { value: '20', label: L.calculateur.barOlympic },
                { value: '15', label: L.calculateur.barWomen },
                { value: '10', label: L.calculateur.barTechnique },
                { value: '7', label: L.calculateur.barShort },
              ]}
              x-model.number="barWeight"
            />
          </div>
          <div x-show="mode === 'dumbbell'">
            <Input
              label={L.calculateur.dumbbellBar}
              id="calc-dumbbar"
              type="number"
              step="0.5"
              min="0"
              inputmode="decimal"
              x-model.number="dumbbellBarWeight"
              placeholder={L.calculateur.dumbbellBarPlaceholder}
            />
          </div>
          <div class="calc__shortcuts">
            <span class="calc__shortcuts-label">{L.calculateur.quickShortcuts}</span>
            <button type="button" class="calc__shortcut" @click="target = 60" aria-label="60 kg">60</button>
            <button type="button" class="calc__shortcut" @click="target = 80" aria-label="80 kg">80</button>
            <button type="button" class="calc__shortcut" @click="target = 100" aria-label="100 kg">100</button>
            <button type="button" class="calc__shortcut" @click="target = 120" aria-label="120 kg">120</button>
            <button type="button" class="calc__shortcut" @click="target = 140" aria-label="140 kg">140</button>
          </div>
        </div>
      </CardContent>
    </Card>

    {/* ═══ Result card ═══ */}
    <Card>
      <CardHeader>
        <CardTitle x-text="resultTitle">{L.calculateur.perSideTitle}</CardTitle>
      </CardHeader>
      <CardContent>
        <template x-if="errorMessage">
          <div class="calc__error" x-text="errorMessage" role="alert" aria-live="assertive"></div>
        </template>
        <template x-if="!errorMessage && mode === 'bar'">
          <BarbellResult
            modeBarre={L.calculateur.modeBarre}
            perSide={L.calculateur.perSide}
            totalPlates={L.calculateur.totalPlates}
            remainder={L.calculateur.remainder}
            breakdownPerSide={L.calculateur.breakdownPerSide}
            kg={L.calculateur.kg}
            noPlates={L.calculateur.noPlates}
          />
        </template>

        {/* ═══ Dumbbell mode ═══ */}
        <template x-if="!errorMessage && mode === 'dumbbell'">
          <DumbbellResult
            perDumbbell={L.calculateur.perDumbbell}
            totalX2={L.calculateur.totalX2}
            remainder={L.calculateur.remainder}
            breakdownTitle={L.calculateur.breakdownTitle}
            kg={L.calculateur.kg}
            noDumbbells={L.calculateur.noDumbbells}
          />
        </template>
      </CardContent>
    </Card>
  </div>
</AppLayout>

<script>
  import { t } from '../i18n';
  import {
    computePlatesPerSide,
    computeDumbbells,
    groupPlates,
    groupDumbbellPlates,
    formatKg,
    formatTemplate,
    plateHeight,
    plateClass,
    dumbbellHeight,
    dumbbellWidth,
  } from '../lib/calculator';
  import type { PlateCount } from '../lib/calculator';

  const LABELS = t();

  /** Map error keys from computePlatesPerSide/computeDumbbells to localised strings. */
  function resolveError(key: string | null, vars?: Record<string, string | number>): string | null {
    if (!key) return null;
    if (key === 'targetBelowBar' && vars) {
      return formatTemplate(LABELS.calculateur.targetBelowBar, vars);
    }
    if (key === 'targetBelowDumbbellBar' && vars) {
      return formatTemplate(LABELS.calculateur.targetBelowDumbbellBar, vars);
    }
    if (key === 'invalidBarWeight') return LABELS.calculateur.invalidBarWeight;
    if (key === 'invalidTarget') return LABELS.calculateur.invalidTarget;
    return null;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('plateCalculator', () => ({
      // ── State ──
      mode: 'bar' as 'bar' | 'dumbbell',
      target: 80,
      barWeight: 20,
      dumbbellBarWeight: 2,

      // ── Mode-aware error ──
      get errorMessage(): string | null {
        if (!Number.isFinite(this.target) || this.target < 0) {
          return LABELS.calculateur.invalidTarget;
        }
        if (this.target === 0) return null;
        if (this.mode === 'dumbbell') {
          const r = computeDumbbells(this.target, this.dumbbellBarWeight);
          return resolveError(r.error, { target: this.target, bar: this.dumbbellBarWeight });
        }
        if (this.target < this.barWeight) {
          return resolveError('targetBelowBar', { target: this.target, bar: this.barWeight });
        }
        return null;
      },

      // ── Computed (bar mode) ──
      get perSide(): number {
        if (!Number.isFinite(this.target)) return 0;
        return Math.max(0, (this.target - this.barWeight) / 2);
      },

      get computedResult(): { plates: number[]; remainder: number } {
        return computePlatesPerSide(this.target, this.barWeight);
      },

      get platesPerSide(): number[] {
        if (this.errorMessage) return [];
        return this.computedResult.plates;
      },

      get remainder(): number {
        if (this.errorMessage) return 0;
        return this.computedResult.remainder;
      },

      get plateBreakdown(): PlateCount[] {
        return groupPlates(this.platesPerSide);
      },

      // ── Computed (dumbbell mode) ──
      get computedDumbbells() {
        return computeDumbbells(this.target, this.dumbbellBarWeight);
      },

      get dumbbellWeight(): number {
        if (this.errorMessage) return 0;
        return this.computedDumbbells.dumbbellWeight;
      },

      get dumbbellPlateWeight(): number {
        if (this.errorMessage) return 0;
        return this.computedDumbbells.plateWeight;
      },

      get dumbbellsToShow(): number[] {
        if (this.errorMessage) return [];
        const w = this.computedDumbbells.dumbbellWeight;
        if (w === 0) return [];
        return [w, w];
      },

      get dumbbellRemainder(): number {
        if (this.errorMessage) return 0;
        return this.computedDumbbells.remainder;
      },

      get dumbbellBreakdown(): PlateCount[] {
        return groupDumbbellPlates(this.computedDumbbells.plates);
      },

      get dumbbellSummary(): string {
        if (this.errorMessage) return '—';
        const w = this.computedDumbbells.dumbbellWeight;
        if (w === 0) return '—';
        return `${LABELS.calculateur.formulaBar} ${formatKg(this.dumbbellBarWeight)} + ${LABELS.calculateur.formulaPlates} ${formatKg(this.computedDumbbells.plateWeight)} = ${formatKg(w)}`;
      },

      // ── Display helpers ──
      get resultTitle(): string {
        return this.mode === 'bar'
          ? LABELS.calculateur.perSideTitle
          : LABELS.calculateur.dumbbellsToUse;
      },

      get barbellAria(): string {
        return `${LABELS.calculateur.barbellAriaPrefix} ${this.platesPerSide.length} ${LABELS.calculateur.platesPerSide}`;
      },

      get dumbbellsAria(): string {
        return `${this.dumbbellsToShow.length} ${LABELS.calculateur.dumbbellsToTake}`;
      },

      formatKg,
      plateHeight,
      plateClass,
      dumbbellHeight,
      dumbbellWidth,
    }));
  });
</script>

<style is:global>
  /* ── Layout ── */
  .calc {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 9.6rem;
  }

  /* ── Tabs ── */
  .calc__tabs {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    align-self: flex-start;
  }

  .calc__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 1.6rem;
    background: transparent;
    color: var(--color-muted);
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 4.4rem;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .calc__tab:hover {
    color: var(--color-text);
  }

  .calc__tab--active {
    background: var(--color-surface-3);
    color: var(--color-accent);
  }

  /* ── Input grid ── */
  .calc__inputs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }

  @media (min-width: 640px) {
    .calc__inputs {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Shortcuts ── */
  .calc__shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    grid-column: 1 / -1;
  }

  .calc__shortcuts-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.10em;
    font-weight: 700;
  }

  .calc__shortcut {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 5.4rem;
    height: 4.4rem;
    padding: 0 1.2rem;
    background: var(--color-surface-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 140ms ease;
  }

  .calc__shortcut:hover {
    background: var(--color-surface-3);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .calc__shortcut:active {
    transform: scale(0.97);
  }

  /* ── Error ── */
  .calc__error {
    padding: 1.6rem 1.8rem;
    background: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 35%, transparent);
    border-radius: var(--radius-md);
    color: var(--color-destructive);
    font-size: 1.4rem;
    font-weight: 600;
  }

  /* ── Result grid ── */
  .calc__result-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .calc__result-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (min-width: 640px) {
    .calc__result-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .calc__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem 1.4rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .calc__stat-label {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--color-muted);
  }

  .calc__stat-value {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .calc__stat-value--accent {
    color: var(--color-accent);
  }

  .calc__stat-value--warning {
    color: var(--color-warning);
  }

  /* ── Barbell diagram ── */
  .calc__diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 2rem 1rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow-x: auto;
  }

  .calc__diagram-side {
    display: flex;
    align-items: center;
  }

  .calc__plate {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    min-width: 2.2rem;
    margin: 0 0.1rem;
    border-radius: 0.5rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .calc__plate-label {
    display: block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .calc__bar-shaft {
    width: 14rem;
    height: 1rem;
    border-radius: 0.3rem;
    position: relative;
    flex-shrink: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 45%, transparent), color-mix(in srgb, var(--color-accent) 22%, transparent));
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 65%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .calc__bar-mark {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 0.4rem;
    height: 1.2rem;
    background: color-mix(in srgb, var(--color-accent) 70%, transparent);
  }

  .calc__bar-mark:nth-child(1) { left: 1rem; }
  .calc__bar-mark:nth-child(2) { left: 50%; transform: translate(-50%, -50%); }
  .calc__bar-mark:nth-child(3) { right: 1rem; }

  .calc__collar {
    width: 0.6rem;
    height: 4rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 55%, transparent), color-mix(in srgb, var(--color-accent) 25%, transparent));
    border-radius: 0.2rem;
    flex-shrink: 0;
  }

  /* ── Breakdown list ── */
  .calc__breakdown {
    margin-top: 2.4rem;
  }

  .calc__breakdown-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .calc__breakdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .calc__breakdown-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.2rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .calc__breakdown-plate {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    min-width: 5.6rem;
    justify-content: center;
    border: 1px solid var(--color-border);
  }

  .calc__breakdown-plate--dumbbell {
    background: var(--color-surface-3);
    border-color: var(--alpha-border);
  }

  .calc__breakdown-unit {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .calc__breakdown-x {
    color: var(--color-muted);
    font-size: 1.3rem;
    font-weight: 700;
  }

  .calc__breakdown-count {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    min-width: 2.4rem;
  }

  .calc__breakdown-total {
    margin-left: auto;
    color: var(--color-muted);
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
  }

  /* ── Empty state ── */
  .calc__empty {
    text-align: center;
    color: var(--color-muted);
    font-size: 1.3rem;
    padding: 1rem;
  }

  /* ── Dumbbell mode ── */
  .calc__dumbbell-summary {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    padding: 1.4rem 1.6rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: 1.6rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .calc__dumbbells {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: 3.2rem;
    padding: 2.4rem 1.2rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    min-height: 26rem;
  }

  .calc__dumbbell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .calc__dumbbell-weight {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .calc__dumbbell-body {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .calc__dumb-head {
    border-radius: 0.6rem;
    border: 1px solid var(--alpha-border);
    flex-shrink: 0;
    background: linear-gradient(180deg, var(--color-surface-3), var(--color-surface-2));
    box-shadow: inset 0 0 0 1px var(--alpha-border-faint), var(--shadow-2);
  }

  .calc__dumb-handle {
    width: 4.6rem;
    height: 0.8rem;
    border-radius: 0.2rem;
    flex-shrink: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 45%, transparent), color-mix(in srgb, var(--color-accent) 22%, transparent));
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 65%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  /* ── Plate colours (Olympic convention) ── */
  .calc__plate--25 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-destructive) 65%, transparent), color-mix(in srgb, var(--color-destructive) 40%, transparent)); }
  .calc__plate--20 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-info) 65%, transparent), color-mix(in srgb, var(--color-info) 40%, transparent)); }
  .calc__plate--15 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-warning) 65%, transparent), color-mix(in srgb, var(--color-warning) 40%, transparent)); }
  .calc__plate--10 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-success) 65%, transparent), color-mix(in srgb, var(--color-success) 40%, transparent)); }
  .calc__plate--5 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-text) 75%, var(--color-muted)), var(--color-muted)); color: var(--color-bg); }
  .calc__plate--2_5 { background: linear-gradient(180deg, var(--color-surface-3), var(--color-surface-2)); }
  .calc__plate--2 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-muted) 55%, transparent), color-mix(in srgb, var(--color-muted) 30%, transparent)); }
  .calc__plate--1_5 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-muted) 40%, transparent), color-mix(in srgb, var(--color-muted) 20%, transparent)); }
  .calc__plate--1_25 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-muted) 30%, transparent), color-mix(in srgb, var(--color-muted) 15%, transparent)); }
  .calc__plate--1 { background: linear-gradient(180deg, color-mix(in srgb, var(--color-muted) 25%, transparent), color-mix(in srgb, var(--color-muted) 12%, transparent)); }
</style>
