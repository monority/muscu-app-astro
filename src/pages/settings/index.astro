---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import Button from '../../components/ui/Button.astro';
import Dialog from '../../components/ui/Dialog.astro';
import SettingsSection from '../../components/ui/SettingsSection.astro';
import SettingsBottomBar from '../../components/layout/SettingsBottomBar.astro';
import ReminderSettings from '../../components/params/ReminderSettings.astro';
import Toast from '../../components/ui/Toast.astro';
import { t } from '../../i18n';
import { icons } from '../../lib/icons';

const L = t();
/**
 * Static rest-time presets (seconds). Used by the Timer settings select
 * and matches the presets surfaced on /timer.
 */
const REST_PRESETS = [30, 45, 60, 90, 120, 180, 240, 300] as const;
const restOptions = REST_PRESETS.map((s) => {
  const mins = Math.floor(s / 60);
  const secs = s % 60;
  const label =
    secs === 0 ? `${mins} min` : `${mins} min ${secs.toString().padStart(2, '0')} s`;
  return { value: String(s), label };
});

// App version mirrored from package.json
const APP_VERSION = '0.0.1';

// Section metadata for the fixed bottom navigation bar. Labels come from
// the same i18n keys used by the section headings so both stay in sync.
const SETTINGS_SECTIONS = [
  { id: 'set-profile', label: L.settings.profile },
  { id: 'set-goals', label: L.settings.goals },
  { id: 'set-units', label: L.settings.units },
  { id: 'set-timer', label: L.settings.timerSettings },
  { id: 'set-reminder', label: L.settings.reminders },
  { id: 'set-data', label: L.settings.data },
  { id: 'set-sync', label: L.settings.sync.title },
  { id: 'set-about', label: L.settings.about },
];
---

<AppLayout title={L.settings.title}>
  <PageHeader
    title={L.settings.title}
    description={L.settings.description}
  />

  <Toast />

  <div
    class="pb-[calc(var(--bottom-nav-height,5.6rem)+2rem)] flex flex-col gap-[2rem] max-sm:gap-[1.4rem]"
    x-data="settingsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ═════════════════════════════════════════════════════
        1. PROFIL
        ═════════════════════════════════════════════════════ */}
    <SettingsSection icon="user" title={L.settings.profile} description={L.settings.profileDesc} id="set-profile">
      {/* Display mode */}
      <div class="flex flex-col gap-0 mt-[1.2rem]" x-show="!editingProfile" x-cloak x-transition.opacity.duration.200ms>
        <div class="flex items-center justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:items-start max-sm:gap-2">
          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.pseudo}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.pseudoDesc}</span>
          </div>
          <div class="shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums max-w-[24rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal" x-text="display.pseudo || labels.notSet"></div>
        </div>
        <div class="flex items-center justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:items-start max-sm:gap-2">
          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.email}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.emailDesc}</span>
          </div>
          <div class="shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums max-w-[24rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal" x-text="display.email || labels.notSet"></div>
        </div>
        <div class="flex justify-end items-center gap-2 mt-[1.6rem] pt-[1.4rem] border-t border-[var(--alpha-bg-soft)]">
          <Button type="button" variant="secondary" @click="startEditProfile()">
            {L.common.edit}
          </Button>
        </div>
      </div>

      {/* Edit mode */}
      <form
        class="flex flex-col gap-[1.4rem] mt-[1.2rem]"
        x-show="editingProfile"
        @submit.prevent="saveProfile()"
        x-cloak
        x-transition.opacity.duration.200ms
      >
        <div class="flex flex-col">
          <Input
            label={L.settings.pseudo}
            id="set-pseudo"
            type="text"
            placeholder={L.settings.pseudoPlaceholder}
            x-model="form.pseudo"
            maxlength={40}
            autocomplete="nickname"
          />
        </div>
        <div class="flex flex-col">
          <Input
            label={L.settings.email}
            id="set-email"
            type="email"
            placeholder={L.settings.emailPlaceholder}
            x-model="form.email"
            autocomplete="email"
          />
        </div>
        <div class="flex justify-end items-center gap-2 mt-[1.6rem] pt-[1.4rem] border-t border-[var(--alpha-bg-soft)]">
          <Button type="button" variant="ghost" @click="cancelEditProfile()">
            {L.common.cancel}
          </Button>
          <Button type="submit" variant="primary">
            {L.common.save}
          </Button>
        </div>
      </form>
    </SettingsSection>

    {/* ═════════════════════════════════════════════════════
        2. OBJECTIFS
        ═════════════════════════════════════════════════════ */}
    <SettingsSection icon="target" title={L.settings.goals} description={L.settings.goalsDesc} id="set-goals">
      <div class="flex flex-col gap-0 mt-[1.2rem]">
        <div class="flex items-start justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:gap-2">
          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.weeklyGoalCount}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.weeklyGoalTrackedDesc}</span>
          </div>
          <div class="shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums w-auto max-w-[18rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal max-sm:w-full">
            <div class="set__goal-input-wrap inline-flex items-stretch h-[4.4rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-sm)] overflow-hidden transition-[border-color,box-shadow] duration-[140ms] max-sm:self-start">
              <button
                type="button"
                class="set__goal-step appearance-none bg-transparent border-0 text-[var(--color-muted)] w-[4.4rem] shrink-0 cursor-pointer inline-flex items-center justify-center transition-[background-color,color] duration-[140ms]"
                aria-label={L.settings.weeklyGoalDecrease}
                @click="setWeeklyGoal(display.weeklyGoal - 1)"
              >
                <Fragment set:html={icons.minus(24, 24)} />
              </button>
              <input
                id="set-weekly-goal"
                type="number"
                min="1"
                max="7"
                step="1"
                inputmode="numeric"
                class="no-spinner appearance-textfield w-[5.2rem] shrink-0 border-0 border-l border-r border-[var(--color-border)] bg-transparent text-[var(--color-text)] font-[var(--font-display)] text-[1.6rem] font-bold text-center tabular-nums outline-none p-0 leading-none"
                :value="display.weeklyGoal"
                @change="setWeeklyGoal(parseInt($event.target.value, 10))"
                aria-label={L.settings.weeklyGoalCount}
              />
              <button
                type="button"
                class="set__goal-step appearance-none bg-transparent border-0 text-[var(--color-muted)] w-[4.4rem] shrink-0 cursor-pointer inline-flex items-center justify-center transition-[background-color,color] duration-[140ms]"
                aria-label={L.settings.weeklyGoalIncrease}
                @click="setWeeklyGoal(display.weeklyGoal + 1)"
              >
                <Fragment set:html={icons.plus(24, 24)} />
              </button>
            </div>
          </div>
        </div>

        <div class="flex items-start justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:gap-2">
          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.weeklyProgress}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.weeklyProgressDesc}</span>
          </div>
          <div class="shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums w-auto max-w-[18rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal max-sm:w-full">
            <span class="inline-flex items-baseline gap-[0.3rem] font-[var(--font-body)] tabular-nums">
              <span class="font-[var(--font-display)] text-[1.8rem] font-bold text-[var(--color-accent)] leading-none" x-text="weeklyDone"></span>
              <span class="text-[var(--color-muted)] text-[1.4rem] font-medium mx-[0.1rem]" aria-hidden="true">/</span>
              <span class="font-[var(--font-display)] text-[1.4rem] font-bold text-[var(--color-text)] leading-none" x-text="display.weeklyGoal"></span>
              <span class="text-[1.1rem] text-[var(--color-muted)] font-medium ml-[0.3rem]" x-text="labels.seanceSingular">{L.settings.seanceSingular}</span>
              <span
                class="text-[1.1rem] text-[var(--color-muted)] font-medium ml-[0.3rem]"
                x-text="display.weeklyGoal > 1 ? 's' : ''"
              ></span>
            </span>
          </div>
        </div>
      </div>
    </SettingsSection>

    {/* ═════════════════════════════════════════════════════
        3. UNITÉS
        ═════════════════════════════════════════════════════ */}
    <SettingsSection icon="ruler" title={L.settings.units} description={L.settings.unitsDesc} id="set-units">
      <div class="flex flex-col gap-0 mt-[1.2rem]">
        <div class="flex items-center justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:items-start max-sm:gap-2">
          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.weightUnit}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.weightUnitDesc}</span>
          </div>
          <div class="inline-flex p-[0.3rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-full max-sm:self-start" role="group" aria-label={L.settings.weightUnit}>
            <button
              type="button"
              class="set__seg-btn appearance-none bg-transparent border border-transparent text-[var(--color-muted)] font-[var(--font-body)] text-[1.2rem] font-bold tracking-[0.02em] px-4 h-[4.4rem] min-w-[6.4rem] rounded-full cursor-pointer [transition:background-color_140ms_ease,_color_140ms_ease,_box-shadow_140ms_ease,_transform_140ms_ease]"
              :class="{ 'is-active': display.unit === 'kg' }"
              :aria-pressed="display.unit === 'kg'"
              @click="setUnit('kg')"
            >
              kg
            </button>
            <button
              type="button"
              class="set__seg-btn appearance-none bg-transparent border border-transparent text-[var(--color-muted)] font-[var(--font-body)] text-[1.2rem] font-bold tracking-[0.02em] px-4 h-[4.4rem] min-w-[6.4rem] rounded-full cursor-pointer [transition:background-color_140ms_ease,_color_140ms_ease,_box-shadow_140ms_ease,_transform_140ms_ease]"
              :class="{ 'is-active': display.unit === 'lbs' }"
              :aria-pressed="display.unit === 'lbs'"
              @click="setUnit('lbs')"
            >
              lbs
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:items-start max-sm:gap-2">
          <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.repsFormat}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.repsDesc}</span>
          </div>
          <div class="inline-flex p-[0.3rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-full max-sm:self-start" role="group" aria-label={L.settings.repsFormat}>
            <button
              type="button"
              class="set__seg-btn appearance-none bg-transparent border border-transparent text-[var(--color-muted)] font-[var(--font-body)] text-[1.2rem] font-bold tracking-[0.02em] px-4 h-[4.4rem] min-w-[6.4rem] rounded-full cursor-pointer [transition:background-color_140ms_ease,_color_140ms_ease,_box-shadow_140ms_ease,_transform_140ms_ease]"
              :class="{ 'is-active': display.repsFormat === 'simple' }"
              :aria-pressed="display.repsFormat === 'simple'"
              @click="setRepsFormat('simple')"
            >
              {L.settings.simple}
            </button>
            <button
              type="button"
              class="set__seg-btn appearance-none bg-transparent border border-transparent text-[var(--color-muted)] font-[var(--font-body)] text-[1.2rem] font-bold tracking-[0.02em] px-4 h-[4.4rem] min-w-[6.4rem] rounded-full cursor-pointer [transition:background-color_140ms_ease,_color_140ms_ease,_box-shadow_140ms_ease,_transform_140ms_ease]"
              :class="{ 'is-active': display.repsFormat === 'range' }"
              :aria-pressed="display.repsFormat === 'range'"
              @click="setRepsFormat('range')"
            >
              {L.settings.range}
            </button>
          </div>
        </div>
      </div>
    </SettingsSection>

    {/* ═════════════════════════════════════════════════════
        4. TIMER
        ═════════════════════════════════════════════════════ */}
    <SettingsSection icon="clockStopwatch" title={L.settings.timerSettings} description={L.settings.timerDesc} id="set-timer">
      <form class="flex flex-col gap-[1.4rem] mt-[1.2rem]" @submit.prevent="saveTimer()">
        <div class="flex flex-col gap-0 mt-[1.2rem]">
          <div class="flex items-start justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:gap-2">
            <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
              <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.defaultRestTime}</span>
              <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.defaultRestTimeDesc}</span>
            </div>
            <div class="shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums w-auto max-w-[18rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal max-sm:w-full">
              <Select
                id="set-rest-time"
                name="restTime"
                options={restOptions}
                x-model="form.defaultRestTime"
              />
            </div>
          </div>

          <div class="flex items-start justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:gap-2">
            <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
              <span class="font-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.settings.soundAlerts}</span>
              <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.soundAlertsDesc}</span>
            </div>
            <div class="shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums w-auto max-w-[18rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal max-sm:w-full">
              <label class="inline-flex items-center cursor-pointer min-h-[4.4rem]">
                <input
                  type="checkbox"
                  class="sr-only set__toggle-input"
                  role="switch"
                  :checked="form.soundAlerts"
                  :aria-checked="form.soundAlerts ? 'true' : 'false'"
                  @change="form.soundAlerts = $event.target.checked"
                />
                <span class="set__toggle-track relative w-[4.4rem] h-[2.4rem] rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border)] transition-[background-color,border-color] duration-[200ms] shrink-0 inline-block">
                  <span class="set__toggle-thumb absolute top-[2px] left-[3px] w-[1.8rem] h-[1.8rem] rounded-full bg-white transition-transform duration-[200ms] shadow-[var(--shadow-1)] inline-block"></span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <p
          class="text-[1.1rem] text-[var(--color-warning)] m-0 leading-[1.3]"
          x-show="form.defaultRestTime !== String(display.defaultRestTime) || form.soundAlerts !== display.soundAlerts"
          x-cloak
          x-text="labels.unsavedChanges"
        >
          {L.settings.unsavedChanges}
        </p>

        <div class="flex justify-end items-center gap-2 mt-[1.6rem] pt-[1.4rem] border-t border-[var(--alpha-bg-soft)]">
          <Button
            type="button"
            variant="ghost"
            @click="resetTimerForm()"
            x-show="form.defaultRestTime !== String(display.defaultRestTime) || form.soundAlerts !== display.soundAlerts"
            x-cloak
          >
            {L.common.cancel}
          </Button>
          <Button
            type="submit"
            variant="primary"
            x-bind:disabled="form.defaultRestTime === String(display.defaultRestTime) && form.soundAlerts === display.soundAlerts"
          >
            {L.common.save}
          </Button>
        </div>
      </form>
    </SettingsSection>

    {/* ═════════════════════════════════════════════════════
        5. RAPPEL D'ENTRAÎNEMENT
        ═════════════════════════════════════════════════════ */}
    <ReminderSettings />

    {/* ═════════════════════════════════════════════════════
        6. DONNÉES
        ═════════════════════════════════════════════════════ */}
    <SettingsSection icon="database" title={L.settings.data} description={L.settings.dataDesc} id="set-data">
      <div class="grid grid-cols-1 gap-[1.2rem] mt-[1.2rem] sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col gap-[1.2rem] p-[1.8rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-md)] transition-[border-color,box-shadow] duration-[200ms] relative hover:border-[var(--alpha-border)] hover:shadow-[var(--shadow-2)] max-[480px]:p-[1.4rem]">
          <div class="flex items-start gap-[1.2rem] max-sm:gap-4">
            <div class="set__data-tile-icon inline-flex items-center justify-center w-[3.6rem] h-[3.6rem] max-sm:w-[3.2rem] max-sm:h-[3.2rem] shrink-0 rounded-[var(--radius-md)] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] text-[var(--color-accent)] border border-[color-mix(in_srgb,var(--color-accent)_28%,transparent)]" aria-hidden="true">
              <Fragment set:html={icons.download(24, 24)} />
            </div>
            <div class="min-w-0 flex flex-col gap-[var(--spacing-1)]">
              <h4 class="font-[var(--font-display)] text-[1.4rem] font-bold text-[var(--color-text)] m-0">{L.settings.exportJSON}</h4>
              <p class="text-[1.15rem] text-[var(--color-muted)] m-0 leading-[1.4]">
                {L.settings.exportJSONDesc}
              </p>
            </div>
          </div>
          <button
            type="button"
            class="set__data-btn appearance-none inline-flex items-center justify-center h-[4.4rem] px-4 bg-transparent border border-[var(--color-border)] rounded-[var(--radius-sm)] text-[var(--color-text)] font-[var(--font-body)] text-[1.2rem] font-bold tracking-[0.02em] cursor-pointer transition-[background-color,border-color,color,transform] duration-[140ms] disabled:opacity-50 disabled:cursor-not-allowed"
            @click="exportData()"
            :disabled="exporting"
          >
            <span x-show="!exporting" x-cloak x-text="labels.download">{L.settings.download}</span>
            <span x-show="exporting" x-cloak x-text="labels.preparing">{L.settings.preparing}</span>
          </button>
        </div>

        <div class="flex flex-col gap-[1.2rem] p-[1.8rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-md)] transition-[border-color,box-shadow] duration-[200ms] relative hover:border-[var(--alpha-border)] hover:shadow-[var(--shadow-2)] max-[480px]:p-[1.4rem]">
          <div class="flex items-start gap-[1.2rem] max-sm:gap-4">
            <div class="set__data-tile-icon inline-flex items-center justify-center w-[3.6rem] h-[3.6rem] max-sm:w-[3.2rem] max-sm:h-[3.2rem] shrink-0 rounded-[var(--radius-md)] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] text-[var(--color-accent)] border border-[color-mix(in_srgb,var(--color-accent)_28%,transparent)]" aria-hidden="true">
              <Fragment set:html={icons.table(24, 24)} />
            </div>
            <div class="min-w-0 flex flex-col gap-[var(--spacing-1)]">
              <h4 class="font-[var(--font-display)] text-[1.4rem] font-bold text-[var(--color-text)] m-0">{L.settings.exportCSV}</h4>
              <p class="text-[1.15rem] text-[var(--color-muted)] m-0 leading-[1.4]">
                {L.settings.exportCSVDesc}
              </p>
            </div>
          </div>
          <button
            type="button"
            class="set__data-btn appearance-none inline-flex items-center justify-center h-[4.4rem] px-4 bg-transparent border border-[var(--color-border)] rounded-[var(--radius-sm)] text-[var(--color-text)] font-[var(--font-body)] text-[1.2rem] font-bold tracking-[0.02em] cursor-pointer transition-[background-color,border-color,color,transform] duration-[140ms] disabled:opacity-50 disabled:cursor-not-allowed"
            @click="exportCSV()"
            :disabled="exportingCsv"
          >
            <span x-show="!exportingCsv" x-cloak x-text="labels.download">{L.settings.download}</span>
            <span x-show="exportingCsv" x-cloak x-text="labels.preparing">{L.settings.preparing}</span>
          </button>
        </div>

        <div class="flex flex-col gap-[1.2rem] p-[1.8rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-md)] transition-[border-color,box-shadow] duration-[200ms] relative hover:border-[var(--alpha-border)] hover:shadow-[var(--shadow-2)] max-[480px]:p-[1.4rem]">
          <div class="flex items-start gap-[1.2rem] max-sm:gap-4">
            <div class="set__data-tile-icon inline-flex items-center justify-center w-[3.6rem] h-[3.6rem] max-sm:w-[3.2rem] max-sm:h-[3.2rem] shrink-0 rounded-[var(--radius-md)] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] text-[var(--color-accent)] border border-[color-mix(in_srgb,var(--color-accent)_28%,transparent)]" aria-hidden="true">
              <Fragment set:html={icons.upload(24, 24)} />
            </div>
            <div class="min-w-0 flex flex-col gap-[var(--spacing-1)]">
              <h4 class="font-[var(--font-display)] text-[1.4rem] font-bold text-[var(--color-text)] m-0">{L.settings.import}</h4>
              <p class="text-[1.15rem] text-[var(--color-muted)] m-0 leading-[1.4]">
                {L.settings.importDesc}
              </p>
            </div>
          </div>
          <button
            type="button"
            class="set__data-btn appearance-none inline-flex items-center justify-center h-[4.4rem] px-4 bg-transparent border border-[var(--color-border)] rounded-[var(--radius-sm)] text-[var(--color-text)] font-[var(--font-body)] text-[1.2rem] font-bold tracking-[0.02em] cursor-pointer transition-[background-color,border-color,color,transform] duration-[140ms] disabled:opacity-50 disabled:cursor-not-allowed"
            @click="triggerImport()"
            :disabled="importing"
          >
            <span x-show="!importing" x-cloak>{L.settings.chooseFile}</span>
            <span x-show="importing" x-cloak x-text="labels.importing">{L.settings.importing}</span>
          </button>
          <input
            type="file"
            accept="application/json,.json"
            class="sr-only set__file-input"
            @change="handleImportFile($event)"
            aria-hidden="true"
            tabindex="-1"
          />
        </div>
      </div>

          {/* Danger zone */}
          <div class="mt-[2.4rem] p-5 bg-[color-mix(in_srgb,var(--color-destructive)_4%,transparent)] border border-[color-mix(in_srgb,var(--color-destructive)_28%,transparent)] rounded-[var(--radius-md)] max-[480px]:p-[1.6rem]">
            <div class="flex items-center gap-2 mb-[0.6rem]">
              <span class="set__danger-badge inline-flex items-center h-[2.2rem] px-2 bg-[color-mix(in_srgb,var(--color-destructive)_14%,transparent)] border border-[color-mix(in_srgb,var(--color-destructive)_40%,transparent)] rounded-[var(--radius-sm)] text-destructive text-[1.1rem] font-bold tracking-[0.10em]">DANGER</span>
              <h4 class="font-display text-[1.5rem] font-bold text-text m-0">{L.settings.resetAll}</h4>
            </div>
            <p class="text-[1.2rem] text-muted leading-[1.5] mb-[1.4rem]">
              {L.settings.resetDesc}
            </p>
            <button
              type="button"
              class="set__danger-btn appearance-none inline-flex items-center h-[4.4rem] px-[1.8rem] bg-transparent text-destructive border border-[color-mix(in_srgb,var(--color-destructive)_50%,transparent)] rounded-[var(--radius-sm)] font-body text-[1.2rem] font-bold tracking-[0.02em] cursor-pointer transition-[background-color,box-shadow,transform] duration-[140ms] active:scale-[0.97]"
              @click="askReset()"
            >
              {L.settings.resetAction}
            </button>
          </div>
    </SettingsSection>

    {/* ═════════════════════════════════════════════════════
        7. SYNCHRONISATION WEBDAV
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-sync">
      <Card>
        <CardHeader>
          <div class="flex items-center gap-4 min-w-0">
            <span class="set__heading-icon inline-flex items-center justify-center w-[3.6rem] h-[3.6rem] max-sm:w-[3.2rem] max-sm:h-[3.2rem] shrink-0 rounded-[var(--radius-md)] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] text-accent border border-[color-mix(in_srgb,var(--color-accent)_28%,transparent)]" aria-hidden="true">
              <Fragment set:html={icons.cloud(24, 24)} />
            </span>
            <CardTitle>{L.settings.sync.title}</CardTitle>
          </div>
          <p class="text-[1.2rem] text-muted m-0 leading-[1.4]">{L.settings.sync.desc}</p>
          <p class="m-0 text-[1.15rem] leading-[1.45] text-muted">{L.settings.sync.corsNote}</p>
        </CardHeader>

        <CardContent>
          <form class="flex flex-col gap-[1.4rem] mt-[1.2rem]" @submit.prevent="saveSync()">
            <div class="flex flex-col gap-0 mt-[1.2rem]">
              <div class="flex items-start justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:gap-2">
                <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
                  <label class="font-display text-[1.4rem] font-semibold text-text leading-[1.2]" for="set-sync-url" x-text="labels.syncUrl">{L.settings.sync.url}</label>
                  <span class="text-[1.1rem] text-muted leading-[1.3]" x-text="labels.syncConflict">{L.settings.sync.conflict}</span>
                </div>
                <div class="shrink-0 text-right text-[1.3rem] text-muted tabular-nums w-auto max-w-[18rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal max-sm:w-full">
                  <input
                    type="text"
                    id="set-sync-url"
                    class="set__sync-input w-full h-[4.2rem] px-3 bg-surface-2 border border-border rounded-[var(--radius-sm)] text-text font-body text-[1.25rem] outline-none transition-[border-color,box-shadow] duration-[140ms] placeholder:text-muted"
                    x-model="syncForm.url"
                    :placeholder="labels.syncUrlPlaceholder"
                    autocomplete="url"
                    spellcheck="false"
                    aria-label={L.settings.sync.url}
                  />
                </div>
              </div>

              <div class="flex items-start justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:gap-2">
                <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
                  <label class="font-display text-[1.4rem] font-semibold text-text leading-[1.2]" for="set-sync-username">{L.settings.sync.username}</label>
                </div>
                <div class="shrink-0 text-right text-[1.3rem] text-muted tabular-nums w-auto max-w-[18rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal max-sm:w-full">
                  <input
                    type="text"
                    id="set-sync-username"
                    class="set__sync-input w-full h-[4.2rem] px-3 bg-surface-2 border border-border rounded-[var(--radius-sm)] text-text font-body text-[1.25rem] outline-none transition-[border-color,box-shadow] duration-[140ms] placeholder:text-muted"
                    x-model="syncForm.username"
                    :placeholder="labels.syncUsernamePlaceholder"
                    autocomplete="username"
                    spellcheck="false"
                    aria-label={L.settings.sync.username}
                  />
                </div>
              </div>

              <div class="flex items-start justify-between gap-8 py-4 border-b border-[var(--alpha-bg-soft)] last:border-b-0 last:pb-0 first:pt-0 max-sm:flex-col max-sm:gap-2">
                <div class="flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
                  <label class="font-display text-[1.4rem] font-semibold text-text leading-[1.2]" for="set-sync-password">{L.settings.sync.password}</label>
                  <span class="text-[1.1rem] text-muted leading-[1.3]">{L.settings.sync.passwordNote}</span>
                </div>
                <div class="shrink-0 text-right text-[1.3rem] text-muted tabular-nums w-auto max-w-[18rem] overflow-hidden text-ellipsis whitespace-nowrap max-sm:text-left max-sm:max-w-full max-sm:whitespace-normal max-sm:w-full">
                  <input
                    type="password"
                    id="set-sync-password"
                    class="set__sync-input w-full h-[4.2rem] px-3 bg-surface-2 border border-border rounded-[var(--radius-sm)] text-text font-body text-[1.25rem] outline-none transition-[border-color,box-shadow] duration-[140ms] placeholder:text-muted"
                    x-model="syncForm.password"
                    :placeholder="labels.syncPasswordPlaceholder"
                    autocomplete="off"
                    aria-label={L.settings.sync.password}
                  />
                </div>
              </div>
            </div>

            <div class="flex justify-end items-center gap-2 mt-[1.6rem] pt-[1.4rem] border-t border-[var(--alpha-bg-soft)]">
              <button
                type="button"
                class="set__data-btn appearance-none inline-flex items-center justify-center h-[4.4rem] px-4 bg-transparent border border-border rounded-[var(--radius-sm)] text-text font-body text-[1.2rem] font-bold tracking-[0.02em] cursor-pointer transition-[background-color,border-color,color,transform] duration-[140ms] disabled:opacity-50 disabled:cursor-not-allowed"
                @click="cancelSync()"
              >
                {L.common.cancel}
              </button>
              <button
                type="submit"
                class="set__data-btn set__sync-btn--primary appearance-none inline-flex items-center justify-center h-[4.4rem] px-4 bg-accent border border-accent text-accent-foreground rounded-[var(--radius-sm)] font-body text-[1.2rem] font-bold tracking-[0.02em] cursor-pointer transition-[background-color,border-color,color,transform] duration-[140ms] disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {L.common.save}
              </button>
            </div>
          </form>

          {/* Last sync status + Google Drive note */}
          <div class="flex flex-col gap-[0.2rem] mt-[1.2rem]" x-show="syncConfigured" x-cloak>
            <span class="text-[1.1rem] font-bold tracking-[0.08em] uppercase text-muted">{L.settings.sync.lastSync}</span>
            <span class="text-[1.25rem] text-text" x-text="syncLastLabel"></span>
          </div>
          <p class="m-0 text-[1.15rem] leading-[1.45] text-muted">{L.settings.sync.googleDrive}</p>

          {/* Manual-only actions */}
          <div class="flex flex-wrap gap-2 mt-[1.4rem]">
            <Button
              variant="secondary"
              type="button"
              class="flex-auto min-w-[12rem]"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'test'"
              @click="testSync()"
            >
              <span x-show="syncBusy !== 'test'" x-cloak x-text="labels.syncTest">{L.settings.sync.test}</span>
              <span x-show="syncBusy === 'test'" x-cloak x-text="labels.syncTesting">{L.settings.sync.testing}</span>
            </Button>
            <Button
              variant="primary"
              type="button"
              class="flex-auto min-w-[12rem]"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'push'"
              @click="pushSync()"
            >
              <span x-show="syncBusy !== 'push'" x-cloak x-text="labels.syncPush">{L.settings.sync.push}</span>
              <span x-show="syncBusy === 'push'" x-cloak x-text="labels.syncPushing">{L.settings.sync.pushing}</span>
            </Button>
            <Button
              variant="secondary"
              type="button"
              class="flex-auto min-w-[12rem]"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'pull'"
              @click="askRestore()"
            >
              <span x-show="syncBusy !== 'pull'" x-cloak x-text="labels.syncPull">{L.settings.sync.pull}</span>
              <span x-show="syncBusy === 'pull'" x-cloak x-text="labels.syncPulling">{L.settings.sync.pulling}</span>
            </Button>
          </div>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        8. À PROPOS
        ═════════════════════════════════════════════════════ */}
    <SettingsSection icon="infoCircle" title={L.settings.about} description={L.settings.aboutDesc} id="set-about">
      <dl class="grid grid-cols-1 gap-0 mt-[1.2rem] sm:grid-cols-2 sm:gap-x-6">
        <div class="set__about-row flex items-center justify-between py-2.5 border-b border-[var(--alpha-bg-soft)] gap-4">
          <dt class="text-[1.2rem] text-[var(--color-muted)] font-medium m-0">{L.settings.version}</dt>
          <dd class="font-[var(--font-body)] text-[1.3rem] text-[var(--color-text)] font-semibold m-0 text-right">
            <span class="set__about-pill inline-flex items-center h-6 px-4 bg-[color-mix(in_srgb,var(--color-accent)_14%,transparent)] border border-[color-mix(in_srgb,var(--color-accent)_30%,transparent)] rounded-full text-[var(--color-accent)] text-[1.1rem] font-bold tracking-[0.04em] tabular-nums">v{APP_VERSION}</span>
          </dd>
        </div>
        <div class="set__about-row flex items-center justify-between py-2.5 border-b border-[var(--alpha-bg-soft)] gap-4">
          <dt class="text-[1.2rem] text-[var(--color-muted)] font-medium m-0">{L.settings.storage}</dt>
          <dd class="font-[var(--font-body)] text-[1.3rem] text-[var(--color-text)] font-semibold m-0 text-right">{L.settings.storageValue}</dd>
        </div>
        <div class="set__about-row flex items-center justify-between py-2.5 border-b border-[var(--alpha-bg-soft)] gap-4">
          <dt class="text-[1.2rem] text-[var(--color-muted)] font-medium m-0">{L.settings.mode}</dt>
          <dd class="font-[var(--font-body)] text-[1.3rem] text-[var(--color-text)] font-semibold m-0 text-right">{L.settings.modeValue}</dd>
        </div>
        <div class="set__about-row flex items-center justify-between py-2.5 border-b border-[var(--alpha-bg-soft)] gap-4">
          <dt class="text-[1.2rem] text-[var(--color-muted)] font-medium m-0">{L.settings.fonts}</dt>
          <dd class="font-[var(--font-body)] text-[1.3rem] text-[var(--color-text)] font-semibold m-0 text-right">Inter</dd>
        </div>
        <div class="set__about-row flex items-center justify-between py-2.5 border-b border-[var(--alpha-bg-soft)] gap-4">
          <dt class="text-[1.2rem] text-[var(--color-muted)] font-medium m-0">{L.settings.icons}</dt>
          <dd class="font-[var(--font-body)] text-[1.3rem] text-[var(--color-text)] font-semibold m-0 text-right">Lucide</dd>
        </div>
        <div class="set__about-row flex items-center justify-between py-2.5 border-b border-[var(--alpha-bg-soft)] gap-4">
          <dt class="text-[1.2rem] text-[var(--color-muted)] font-medium m-0">{L.settings.framework}</dt>
          <dd class="font-[var(--font-body)] text-[1.3rem] text-[var(--color-text)] font-semibold m-0 text-right">Astro 7</dd>
        </div>
      </dl>

      <p class="mt-4 pt-4 border-t border-[var(--alpha-bg-soft)] text-[1.2rem] text-[var(--color-muted)] leading-[1.6] italic">
        {L.settings.credits}
      </p>
    </SettingsSection>

    {/* ═════════════════════════════════════════════════════
        RESET CONFIRMATION DIALOG
        ═════════════════════════════════════════════════════ */}
    <Dialog id="set-reset-dialog" title={`${L.settings.resetAll} ?`}>
      <p class="text-text text-[1.3rem] leading-normal mb-[0.8rem]">
        {L.settings.resetConfirmIntro}
        <strong class="text-destructive font-bold"> {L.settings.resetConfirmIntroStrong}</strong> —
        {L.settings.resetConfirmIntroList}
      </p>
      <p class="text-muted text-[1.2rem] leading-normal mb-[0.8rem]">
        {L.settings.resetConfirmAction} <strong class="text-destructive font-bold">SUPPRIMER</strong> {L.settings.resetConfirmActionOutro}
        {L.settings.resetIrreversible}
      </p>
      <div class="mt-[1.2rem]">
        <input
          type="text"
          class="set__confirm-input w-full h-[4.4rem] px-[1.4rem] bg-bg border border-border rounded-[var(--radius-sm)] text-text font-body text-[1.4rem] font-semibold tracking-[0.08em] text-center outline-none transition-[border-color,box-shadow] duration-[140ms]"
          placeholder="SUPPRIMER"
          x-model="resetConfirmText"
          autocomplete="off"
          aria-label={L.settings.resetConfirm}
        />
      </div>

      <div slot="footer">
        <Button
          variant="secondary"
          data-dialog-close
          type="button"
        >
          {L.common.cancel}
        </Button>
        <Button
          variant="destructive"
          type="button"
          x-bind:disabled="resetConfirmText !== 'SUPPRIMER'"
          @click="confirmReset()"
        >
          {L.settings.resetPermanent}
        </Button>
      </div>
    </Dialog>

    {/* ═════════════════════════════════════════════════════
        WEBDAV RESTORE CONFIRMATION DIALOG
        ═════════════════════════════════════════════════════ */}
    <Dialog id="set-restore-dialog" title={L.settings.sync.restoreTitle}>
      <p class="text-text text-[1.3rem] leading-normal mb-[0.8rem]">{L.settings.sync.restoreBody}</p>
      <p class="text-muted text-[1.2rem] leading-normal mb-[0.8rem]">
        {L.settings.sync.restoreIrreversible}
      </p>

      <div slot="footer">
        <Button
          variant="secondary"
          data-dialog-close
          type="button"
        >
          {L.common.cancel}
        </Button>
        <Button
          variant="destructive"
          type="button"
          x-bind:disabled="syncBusy !== null"
          @click="confirmRestore()"
        >
          <span x-show="syncBusy !== 'pull'" x-cloak>{L.settings.sync.restoreConfirm}</span>
          <span x-show="syncBusy === 'pull'" x-cloak>{L.settings.sync.pulling}</span>
        </Button>
      </div>
    </Dialog>

    <SettingsBottomBar
      sections={SETTINGS_SECTIONS}
      activeSection="set-profile"
      saveLabel={L.common.save}
    />
  </div>
</AppLayout>

<script>
  import {
    getSettings,
    updateSettings,
    exportAllData,
    exportSessionsAsCSV,
    importAllData,
    resetAllData,
    getSessionsThisWeek,
    type Settings,
  } from '../../lib/storage';
  import {
    syncPush,
    syncPull,
    syncTest,
    SyncError,
    type SyncErrorCode,
  } from '../../lib/sync';
  import { t, getLocale } from '../../i18n';

  const LABELS = t();


  function cloneForm(s: Settings) {
    return {
      pseudo: s.pseudo,
      email: s.email,
      defaultRestTime: String(s.defaultRestTime),
      soundAlerts: s.soundAlerts,
    };
  }

  function downloadBlob(filename: string, content: string, mime: string): void {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    // Defer revoke so the download has time to start in Safari/Firefox.
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function formatSavedAt(): string {
    const now = new Date();
    const hh = now.getHours().toString().padStart(2, '0');
    const mm = now.getMinutes().toString().padStart(2, '0');
    const ss = now.getSeconds().toString().padStart(2, '0');
    return `${LABELS.settings.savedAtPrefix}${hh}:${mm}:${ss}`;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('settingsApp', () => ({
      // ── State ──
      display: getSettings(),
      form: cloneForm(getSettings()),
      editingProfile: false,
      exporting: false,
      exportingCsv: false,
      importing: false,
      resetConfirmText: '',
      weeklyDone: 0,
      syncForm: { url: '', username: '', password: '' },
      syncConfigured: false,
      syncBusy: null as 'test' | 'push' | 'pull' | null,
      syncLastLabel: '',
      labels: {
        notSet: LABELS.settings.notSet,
        download: LABELS.settings.download,
        preparing: LABELS.settings.preparing,
        importing: LABELS.settings.importing,
        seanceSingular: LABELS.settings.seanceSingular,
        unsavedChanges: LABELS.settings.unsavedChanges,
        storageError: LABELS.settings.storageError,
        exportFailed: LABELS.settings.exportFailed,
        exportCsvFailed: LABELS.settings.exportCsvFailed,
        backupDownloaded: LABELS.settings.backupDownloaded,
        exportCsvDownloaded: LABELS.settings.exportCsvDownloaded,
        backupRestored: LABELS.settings.backupRestored,
        invalidFile: LABELS.settings.invalidFile,
        readError: LABELS.settings.readError,
        allDataReset: LABELS.settings.allDataReset,
        savedAtPrefix: LABELS.settings.savedAtPrefix,
        syncUrl: LABELS.settings.sync.url,
        syncUrlPlaceholder: LABELS.settings.sync.urlPlaceholder,
        syncConflict: LABELS.settings.sync.conflict,
        syncUsernamePlaceholder: LABELS.settings.sync.usernamePlaceholder,
        syncPasswordPlaceholder: LABELS.settings.sync.passwordPlaceholder,
        syncTest: LABELS.settings.sync.test,
        syncTesting: LABELS.settings.sync.testing,
        syncPush: LABELS.settings.sync.push,
        syncPushing: LABELS.settings.sync.pushing,
        syncPull: LABELS.settings.sync.pull,
        syncPulling: LABELS.settings.sync.pulling,
        syncTestOk: LABELS.settings.sync.testOk,
        syncTestOkNoBackup: LABELS.settings.sync.testOkNoBackup,
        syncPushed: LABELS.settings.sync.pushed,
        syncRestored: LABELS.settings.sync.restored,
        syncNotConfigured: LABELS.settings.sync.notConfigured,
        syncUnavailable: LABELS.settings.sync.unavailable,
        syncFallback: LABELS.settings.sync.fallback,
        syncLastSync: LABELS.settings.sync.lastSync,
        syncNever: LABELS.settings.sync.never,
        syncError: LABELS.settings.sync.error,
      },

      // ── Init ──
      init() {
        // Re-sync in case another tab/page wrote new defaults.
        this.display = getSettings();
        this.form = cloneForm(this.display);
        this.weeklyDone = getSessionsThisWeek().length;
        this.syncForm = {
          url: this.display.webdav?.url || '',
          username: this.display.webdav?.username || '',
          password: this.display.webdav?.password || '',
        };
        this.syncConfigured = Boolean(this.display.webdav?.url);
        this.syncLastLabel = this.lastSyncLabel(this.display.webdav?.lastSyncAt);

        // Autosave on any section save action dispatched by the fixed
        // bottom bar (SettingsBottomBar.astro).
        document.addEventListener("settings-save", (e: Event) => {
          const section = (e as CustomEvent).detail?.section;
          this.saveSection(section);
        });
      },

      saveSection(section: string) {
        // Sections that write settings live directly in `display` and
        // persist automatically; only Profile and Timer keep unsaved edits
        // in `this.form`, so those are the ones backed by an explicit save.
        switch (section) {
          case 'set-profile':
            if (this.editingProfile) this.saveProfile();
            else window.showToast(formatSavedAt(), 'success');
            break;
          case 'set-timer':
            this.saveTimer();
            break;
          case 'set-sync':
            this.saveSync();
            break;
          default:
            // Units, goals, data and about auto-save (or expose their own
            // actions); nothing left to flush here.
            window.showToast(formatSavedAt(), 'success');
        }
      },

      // ── Profile ──
      startEditProfile() {
        this.form = cloneForm(this.display);
        this.editingProfile = true;
      },

      cancelEditProfile() {
        this.form = cloneForm(this.display);
        this.editingProfile = false;
      },

      saveProfile() {
        const pseudo = this.form.pseudo.trim();
        const email = this.form.email.trim();
        this.display = updateSettings({ pseudo, email });
        this.form = cloneForm(this.display);
        this.editingProfile = false;
        window.showToast(formatSavedAt(), 'success');
      },

      // ── Units (auto-save) ──
      setUnit(unit: 'kg' | 'lbs') {
        if (this.display.unit === unit) return;
        this.display = updateSettings({ unit });
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      setRepsFormat(format: 'simple' | 'range') {
        if (this.display.repsFormat === format) return;
        this.display = updateSettings({ repsFormat: format });
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      // ── Timer ──
      saveTimer() {
        const rest = parseInt(this.form.defaultRestTime, 10);
        if (!Number.isFinite(rest) || rest < 5 || rest > 3600) return;
        this.display = updateSettings({
          defaultRestTime: rest,
          soundAlerts: this.form.soundAlerts,
        });
        this.form = cloneForm(this.display);
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      resetTimerForm() {
        this.form = cloneForm(this.display);
      },

      // ── Weekly goal (auto-save on change) ──
      setWeeklyGoal(value: number) {
        // Clamp into [1, 7] and reject NaN. The input's min/max attributes
        // already constrain the UI, but be defensive.
        if (!Number.isFinite(value)) return;
        const next = Math.min(7, Math.max(1, Math.round(value)));
        if (this.display.weeklyGoal === next) return;
        this.display = updateSettings({ weeklyGoal: next });
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      // ── Data ──
      exportData() {
        this.exporting = true;
        try {
          const snapshot = exportAllData();
          if (!snapshot) {
            window.showToast(this.labels.storageError, 'error');
            return;
          }
          const date = new Date().toISOString().slice(0, 10);
          downloadBlob(
            `muscu-backup-${date}.json`,
            JSON.stringify(snapshot, null, 2),
            'application/json',
          );
          window.showToast(this.labels.backupDownloaded, 'success');
        } catch (err) {
          window.showToast(
            err instanceof Error ? err.message : this.labels.exportFailed,
            'error',
          );
        } finally {
          this.exporting = false;
        }
      },

      exportCSV() {
        this.exportingCsv = true;
        try {
          const csv = exportSessionsAsCSV();
          const date = new Date().toISOString().slice(0, 10);
          downloadBlob(
            `muscu-sessions-${date}.csv`,
            csv,
            'text/csv;charset=utf-8',
          );
          window.showToast(this.labels.exportCsvDownloaded, 'success');
        } catch (err) {
          window.showToast(
            err instanceof Error
              ? err.message
              : this.labels.exportCsvFailed,
            'error',
          );
        } finally {
          this.exportingCsv = false;
        }
      },

      triggerImport() {
        // The hidden <input type="file"> is the sibling of the trigger button.
        const root = (this as unknown as AlpineMagicThis).$root;
        const input = root.querySelector<HTMLInputElement>(
          '.set__file-input',
        );
        if (input) {
          input.value = ''; // allow re-selecting the same file
          input.click();
        }
      },

      handleImportFile(event: Event) {
        const input = event.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file) return;
        this.importing = true;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const text = String(reader.result ?? '');
            const parsed = JSON.parse(text);
            importAllData(parsed);
            this.display = getSettings();
            this.form = cloneForm(this.display);
            window.showToast(this.labels.backupRestored, 'success');
          } catch (err) {
            window.showToast(
              err instanceof Error
                ? err.message
                : this.labels.invalidFile,
              'error',
            );
          } finally {
            this.importing = false;
            input.value = '';
          }
        };
        reader.onerror = () => {
          window.showToast(this.labels.readError, 'error');
          this.importing = false;
          input.value = '';
        };
        reader.readAsText(file);
      },

      askReset() {
        this.resetConfirmText = '';
        this.openDialogById('set-reset-dialog');
      },

      confirmReset() {
        if (this.resetConfirmText !== 'SUPPRIMER') return;
        resetAllData();
        this.display = getSettings();
        this.form = cloneForm(this.display);
        this.editingProfile = false;
        this.resetConfirmText = '';
        this.closeDialogById('set-reset-dialog');
        window.showToast(this.labels.allDataReset, 'success');
      },

      // ── WebDAV sync ──
      saveSync() {
        // Saving an empty field clears the stored connection; saving a
        // complete URL stores it and marks the connection as configured.
        this.persistSyncConfig();
        window.showToast(formatSavedAt(), 'success');
      },

      /** Persists the current sync form into Settings and refreshes the
       *  configured flag + last-sync label. Keeps the timestamp when the
       *  connection is kept, clears it when the URL is emptied. */
      persistSyncConfig() {
        const url = this.syncForm.url.trim();
        this.display = updateSettings({
          webdav: {
            url,
            username: this.syncForm.username.trim(),
            password: this.syncForm.password,
            lastSyncAt: url ? this.display.webdav?.lastSyncAt : undefined,
          },
        });
        this.syncConfigured = Boolean(url);
        this.syncLastLabel = this.lastSyncLabel(
          this.syncConfigured ? this.display.webdav?.lastSyncAt : undefined,
        );
      },

      /** Persists the sync form and stamps a fresh success timestamp. */
      persistSyncConfigWithNow() {
        this.display = updateSettings({
          webdav: {
            url: this.syncForm.url.trim(),
            username: this.syncForm.username.trim(),
            password: this.syncForm.password,
            lastSyncAt: new Date().toISOString(),
          },
        });
        this.syncConfigured = true;
        this.syncLastLabel = this.lastSyncLabel(
          this.display.webdav?.lastSyncAt,
        );
      },

      cancelSync() {
        // Discard unsaved edits and restore the persisted connection.
        const webdav = this.display.webdav;
        this.syncForm = {
          url: webdav?.url || '',
          username: webdav?.username || '',
          password: webdav?.password || '',
        };
      },

      lastSyncLabel(lastSyncAt?: string): string {
        if (!lastSyncAt) return this.labels.syncNever;
        const d = new Date(lastSyncAt);
        if (Number.isNaN(d.getTime())) return this.labels.syncNever;
        return `${this.labels.syncLastSync} — ${d.toLocaleString()}`;
      },

      syncErrorLabel(err: unknown): string {
        if (err instanceof SyncError) {
          const code = err.code as SyncErrorCode;
          const label = this.labels.syncError[code] ?? this.labels.syncFallback;
          if (code === 'sync-http' && typeof err.status === 'number') {
            return `${label} (HTTP ${err.status})`;
          }
          return label;
        }
        // Plain errors (e.g. importAllData validation) carry their message.
        return err instanceof Error && err.message
          ? err.message
          : this.labels.syncFallback;
      },

      async testSync() {
        if (!this.syncForm.url.trim()) {
          window.showToast(this.labels.syncNotConfigured, 'error');
          return;
        }
        this.syncBusy = 'test';
        try {
          const result = await syncTest(
            this.syncForm.url,
            this.syncForm.username,
            this.syncForm.password,
          );
          window.showToast(
            result.hasBackup ? this.labels.syncTestOk : this.labels.syncTestOkNoBackup,
            'success',
          );
        } catch (err) {
          window.showToast(this.syncErrorLabel(err), 'error');
        } finally {
          this.syncBusy = null;
        }
      },

      async pushSync() {
        if (!this.syncForm.url.trim()) {
          window.showToast(this.labels.syncNotConfigured, 'error');
          return;
        }
        this.syncBusy = 'push';
        try {
          const snapshot = exportAllData();
          if (!snapshot) {
            window.showToast(this.labels.storageError, 'error');
            return;
          }
          await syncPush(
            this.syncForm.url,
            this.syncForm.username,
            this.syncForm.password,
            snapshot,
          );
          // Last-write-wins: record the successful push so the status line
          // reflects the most recent sync.
          this.persistSyncConfigWithNow();
          window.showToast(this.labels.syncPushed, 'success');
        } catch (err) {
          window.showToast(this.syncErrorLabel(err), 'error');
        } finally {
          this.syncBusy = null;
        }
      },

      askRestore() {
        if (!this.syncForm.url.trim()) {
          window.showToast(this.labels.syncNotConfigured, 'error');
          return;
        }
        this.openDialogById('set-restore-dialog');
      },

      async confirmRestore() {
        this.syncBusy = 'pull';
        try {
          const snapshot = await syncPull(
            this.syncForm.url,
            this.syncForm.username,
            this.syncForm.password,
          );
          // Destructive: replaces all local data with the remote backup.
          importAllData(snapshot);
          this.display = getSettings();
          this.form = cloneForm(this.display);
          this.persistSyncConfigWithNow();
          this.closeDialogById('set-restore-dialog');
          window.showToast(this.labels.syncRestored, 'success');
        } catch (err) {
          window.showToast(this.syncErrorLabel(err), 'error');
        } finally {
          this.syncBusy = null;
        }
      },

      // ── Dialog helpers ──
      openDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
      closeDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
    }));
  });
</script>

<style>
  /* ═════════════════════════════════════════════════════
     Custom CSS that can't be Tailwind utility classes
     ═════════════════════════════════════════════════════ */

  /* Anchors targeted by the bottom bar: keep the heading clear of the
     sticky topbar when scrolled into view. */
  .set__section {
    scroll-margin-top: calc(var(--topbar-height, 5.6rem) + 1rem);
  }

  /* SVG sizing inside icon containers (can't add classes to
     dynamically generated SVGs via Fragment set:html). */
  .set__heading-icon svg,
  .set__data-tile-icon svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  /* Toggle switch — custom checked/focus sibling selectors */
  .set__toggle-input:checked + .set__toggle-track {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .set__toggle-input:checked + .set__toggle-track .set__toggle-thumb {
    transform: translateX(20px);
  }
  .set__toggle-input:focus-visible + .set__toggle-track {
    box-shadow: var(--focus-ring);
  }

  /* Segmented button — active/hover/focus states (Alpine :class toggle) */
  .set__seg-btn.is-active {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    box-shadow: var(--shadow-1),
                0 0 0 1px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .set__seg-btn:hover:not(.is-active) {
    color: var(--color-text);
    background-color: var(--alpha-bg-subtle);
  }
  .set__seg-btn:active {
    transform: scale(0.96);
  }
  .set__seg-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Goal input wrap — focus-within ring */
  .set__goal-input-wrap:focus-within {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  /* Goal step hover/active */
  .set__goal-step:hover {
    background-color: var(--alpha-bg-subtle);
    color: var(--color-text);
  }
  .set__goal-step:active {
    background-color: var(--alpha-bg-hover);
  }

  /* Goal input — webkit number spinner hiding */
  .set__goal-input::-webkit-outer-spin-button,
  .set__goal-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Data button — hover:not(:disabled) */
  .set__data-btn:hover:not(:disabled) {
    background-color: var(--alpha-bg-soft);
    border-color: var(--alpha-border);
  }

  /* Sync primary button — hover:not(:disabled) */
  .set__sync-btn--primary:hover:not(:disabled) {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  /* Danger button — hover with color-mix */
  .set__danger-btn:hover {
    background-color: color-mix(in srgb, var(--color-destructive) 12%, transparent);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-destructive) 25%, transparent);
  }

  /* Confirm input — placeholder + focus ring with color-mix */
  .set__confirm-input::placeholder {
    color: var(--alpha-text-faint);
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .set__confirm-input:focus {
    border-color: var(--color-destructive);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-destructive) 25%, transparent);
  }

  /* Sync input — focus ring */
  .set__sync-input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  /* About row — complex nth-child selectors for border cleanup */
  .set__about-row:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  /* ═════════════════════════════════════════════════════
     Responsive — SVG sizing
     ═════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    .set__heading-icon svg,
    .set__data-tile-icon svg {
      width: 1.6rem;
      height: 1.6rem;
    }
  }

  /* About row — responsive border overrides (complex selectors) */
  @media (min-width: 640px) {
    .set__about-row:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--alpha-bg-soft);
    }
    .set__about-row:nth-last-child(2) {
      border-bottom: none;
    }
  }

  /* ═════════════════════════════════════════════════════
     Reduced motion
     ═════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .set__seg-btn,
    .set__data-btn,
    .set__danger-btn,
    .set__goal-step,
    .set__toggle-track,
    .set__toggle-thumb {
      transition: none;
    }
  }
</style>
