---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import Button from '../../components/ui/Button.astro';
import Dialog from '../../components/ui/Dialog.astro';

/**
 * Static rest-time presets (seconds). Used by the Timer settings select
 * and matches the presets surfaced on /timer.
 */
const REST_PRESETS = [30, 45, 60, 90, 120, 180, 240, 300] as const;
const restOptions = REST_PRESETS.map((s) => {
  const mins = Math.floor(s / 60);
  const secs = s % 60;
  const label =
    secs === 0 ? `${mins} min` : `${mins} min ${secs.toString().padStart(2, '0')} s`;
  return { value: String(s), label };
});

// App version mirrored from package.json
const APP_VERSION = '0.0.1';
---

<AppLayout title="Réglages">
  <PageHeader
    title="Réglages"
    description="Personnalisez votre application et gérez vos préférences."
  />

  <div
    class="set"
    x-data="settingsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ═════════════════════════════════════════════════════
        1. PROFIL
        ═════════════════════════════════════════════════════ */}
    <section class="set__section">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </span>
            <CardTitle>Profil</CardTitle>
          </div>
          <p class="set__heading-sub">Votre identité dans l'application.</p>
        </CardHeader>

        <CardContent>
          {/* Display mode */}
          <div class="set__rows" x-show="!editingProfile" x-cloak x-transition.opacity.duration.200ms>
            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">Pseudo</span>
                <span class="set__row-hint">Affiché dans vos séances.</span>
              </div>
              <div class="set__row-value" x-text="display.pseudo || 'Non défini'"></div>
            </div>
            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">Email</span>
                <span class="set__row-hint">Pour les futures notifications.</span>
              </div>
              <div class="set__row-value" x-text="display.email || 'Non défini'"></div>
            </div>
            <div class="set__actions">
              <Button type="button" variant="secondary" @click="startEditProfile()">
                Modifier
              </Button>
            </div>
          </div>

          {/* Edit mode */}
          <form
            class="set__form"
            x-show="editingProfile"
            @submit.prevent="saveProfile()"
            x-cloak
            x-transition.opacity.duration.200ms
          >
            <div class="set__form-field">
              <Input
                label="Pseudo"
                id="set-pseudo"
                type="text"
                placeholder="Ex. Alex"
                x-model="form.pseudo"
                maxlength={40}
                autocomplete="nickname"
              />
            </div>
            <div class="set__form-field">
              <Input
                label="Email"
                id="set-email"
                type="email"
                placeholder="exemple@email.com"
                x-model="form.email"
                autocomplete="email"
              />
            </div>
            <div class="set__actions">
              <Button type="button" variant="ghost" @click="cancelEditProfile()">
                Annuler
              </Button>
              <Button type="submit" variant="primary">
                Enregistrer
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        2. OBJECTIFS
        ═════════════════════════════════════════════════════ */}
    <section class="set__section">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2"></circle>
              </svg>
            </span>
            <CardTitle>Objectifs</CardTitle>
          </div>
          <p class="set__heading-sub">Définissez votre cadence d'entraînement hebdomadaire.</p>
        </CardHeader>

        <CardContent>
          <div class="set__rows">
            <div class="set__row set__row--form">
              <div class="set__row-label">
                <span class="set__row-title">Séances par semaine</span>
                <span class="set__row-hint">Objectif suivi sur le tableau de bord.</span>
              </div>
              <div class="set__row-value set__row-value--control">
                <div class="set__goal-input-wrap">
                  <button
                    type="button"
                    class="set__goal-step"
                    aria-label="Diminuer l'objectif"
                    @click="setWeeklyGoal(display.weeklyGoal - 1)"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                  <input
                    id="set-weekly-goal"
                    type="number"
                    min="1"
                    max="7"
                    step="1"
                    inputmode="numeric"
                    class="set__goal-input"
                    :value="display.weeklyGoal"
                    @change="setWeeklyGoal(parseInt($event.target.value, 10))"
                    aria-label="Séances par semaine"
                  />
                  <button
                    type="button"
                    class="set__goal-step"
                    aria-label="Augmenter l'objectif"
                    @click="setWeeklyGoal(display.weeklyGoal + 1)"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <div class="set__row set__row--form">
              <div class="set__row-label">
                <span class="set__row-title">Progression de la semaine</span>
                <span class="set__row-hint">Séances terminées depuis dimanche.</span>
              </div>
              <div class="set__row-value set__row-value--control">
                <span class="set__goal-progress">
                  <span class="set__goal-progress-num" x-text="weeklyDone"></span>
                  <span class="set__goal-progress-sep" aria-hidden="true">/</span>
                  <span class="set__goal-progress-target" x-text="display.weeklyGoal"></span>
                  <span class="set__goal-progress-label">séance</span>
                  <span
                    class="set__goal-progress-label"
                    x-text="display.weeklyGoal > 1 ? 's' : ''"
                  ></span>
                </span>
              </div>
            </div>
          </div>

          <p class="set__autosave" x-show="autoSavedAt" x-transition.opacity x-cloak>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span x-text="autoSavedAt"></span>
          </p>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        3. UNITÉS
        ═════════════════════════════════════════════════════ */}
    <section class="set__section">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6.5 6.5h11"></path>
                <path d="M6.5 17.5h11"></path>
                <path d="M3 12h18"></path>
              </svg>
            </span>
            <CardTitle>Unités</CardTitle>
          </div>
          <p class="set__heading-sub">Préférences d'affichage des charges et répétitions.</p>
        </CardHeader>

        <CardContent>
          <div class="set__rows">
            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">Unité de poids</span>
                <span class="set__row-hint">Affichée dans toutes les séances.</span>
              </div>
              <div class="set__seg" role="group" aria-label="Unité de poids">
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.unit === 'kg' }"
                  :aria-pressed="display.unit === 'kg'"
                  @click="setUnit('kg')"
                >
                  kg
                </button>
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.unit === 'lbs' }"
                  :aria-pressed="display.unit === 'lbs'"
                  @click="setUnit('lbs')"
                >
                  lbs
                </button>
              </div>
            </div>

            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">Format des répétitions</span>
                <span class="set__row-hint">Comment les répétitions sont saisies.</span>
              </div>
              <div class="set__seg" role="group" aria-label="Format des répétitions">
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.repsFormat === 'simple' }"
                  :aria-pressed="display.repsFormat === 'simple'"
                  @click="setRepsFormat('simple')"
                >
                  Simple
                </button>
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.repsFormat === 'range' }"
                  :aria-pressed="display.repsFormat === 'range'"
                  @click="setRepsFormat('range')"
                >
                  Plage
                </button>
              </div>
            </div>
          </div>
          <p class="set__autosave" x-show="autoSavedAt" x-transition.opacity x-cloak>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span x-text="autoSavedAt"></span>
          </p>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        4. TIMER
        ═════════════════════════════════════════════════════ */}
    <section class="set__section">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="13" r="8"></circle>
                <path d="M12 9v4l2 2"></path>
                <path d="M5 3 2 6"></path>
                <path d="m22 6-3-3"></path>
              </svg>
            </span>
            <CardTitle>Timer</CardTitle>
          </div>
          <p class="set__heading-sub">Comportement par défaut du chronomètre de repos.</p>
        </CardHeader>

        <CardContent>
          <form class="set__form" @submit.prevent="saveTimer()">
            <div class="set__rows">
              <div class="set__row set__row--form">
                <div class="set__row-label">
                  <span class="set__row-title">Temps de repos par défaut</span>
                  <span class="set__row-hint">Présélection au lancement du timer.</span>
                </div>
                <div class="set__row-value set__row-value--control">
                  <Select
                    id="set-rest-time"
                    name="restTime"
                    options={restOptions}
                    x-model="form.defaultRestTime"
                  />
                </div>
              </div>

              <div class="set__row set__row--form">
                <div class="set__row-label">
                  <span class="set__row-title">Alertes sonores</span>
                  <span class="set__row-hint">Bip à la fin du décompte.</span>
                </div>
                <div class="set__row-value set__row-value--control">
                  <label class="set__toggle-wrap">
                    <input
                      type="checkbox"
                      class="sr-only set__toggle-input"
                      role="switch"
                      :checked="form.soundAlerts"
                      :aria-checked="form.soundAlerts ? 'true' : 'false'"
                      @change="form.soundAlerts = $event.target.checked"
                    />
                    <span class="set__toggle-track">
                      <span class="set__toggle-thumb"></span>
                    </span>
                  </label>
                </div>
              </div>
            </div>

            <p
              class="set__hint"
              x-show="form.defaultRestTime !== String(display.defaultRestTime) || form.soundAlerts !== display.soundAlerts"
              x-cloak
            >
              Modifications non enregistrées.
            </p>

            <div class="set__actions">
              <Button
                type="button"
                variant="ghost"
                @click="resetTimerForm()"
                x-show="form.defaultRestTime !== String(display.defaultRestTime) || form.soundAlerts !== display.soundAlerts"
                x-cloak
              >
                Annuler
              </Button>
              <Button
                type="submit"
                variant="primary"
                x-bind:disabled="form.defaultRestTime === String(display.defaultRestTime) && form.soundAlerts === display.soundAlerts"
              >
                Enregistrer
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        5. DONNÉES
        ═════════════════════════════════════════════════════ */}
    <section class="set__section">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
                <path d="M3 12a9 3 0 0 0 18 0"></path>
              </svg>
            </span>
            <CardTitle>Données</CardTitle>
          </div>
          <p class="set__heading-sub">Sauvegarde, restauration et réinitialisation.</p>
        </CardHeader>

        <CardContent>
          <div class="set__data-grid">
            <div class="set__data-tile">
              <div class="set__data-tile-body">
                <div class="set__data-tile-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                </div>
                <div class="set__data-tile-text">
                  <h4 class="set__data-tile-title">Exporter</h4>
                  <p class="set__data-tile-desc">
                    Télécharger une sauvegarde JSON de vos exercices, séances et réglages.
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="set__data-btn"
                @click="exportData()"
                :disabled="exporting"
              >
                <span x-show="!exporting" x-cloak>Télécharger</span>
                <span x-show="exporting" x-cloak>Préparation…</span>
              </button>
            </div>

            <div class="set__data-tile">
              <div class="set__data-tile-body">
                <div class="set__data-tile-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="3" y1="15" x2="21" y2="15"></line>
                  </svg>
                </div>
                <div class="set__data-tile-text">
                  <h4 class="set__data-tile-title">Exporter en CSV</h4>
                  <p class="set__data-tile-desc">
                    Télécharger vos séances au format CSV, compatibles avec un tableur.
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="set__data-btn"
                @click="exportCSV()"
                :disabled="exportingCsv"
              >
                <span x-show="!exportingCsv" x-cloak>Télécharger</span>
                <span x-show="exportingCsv" x-cloak>Préparation…</span>
              </button>
            </div>

            <div class="set__data-tile">
              <div class="set__data-tile-body">
                <div class="set__data-tile-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                  </svg>
                </div>
                <div class="set__data-tile-text">
                  <h4 class="set__data-tile-title">Importer</h4>
                  <p class="set__data-tile-desc">
                    Restaurer une sauvegarde JSON existante. Les données actuelles seront remplacées.
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="set__data-btn"
                @click="triggerImport()"
                :disabled="importing"
              >
                <span x-show="!importing" x-cloak>Choisir un fichier</span>
                <span x-show="importing" x-cloak>Import…</span>
              </button>
              <input
                type="file"
                accept="application/json,.json"
                class="set__file-input"
                @change="handleImportFile($event)"
                aria-hidden="true"
                tabindex="-1"
              />
            </div>
          </div>

          <p
            class="set__toast set__toast--success"
            x-show="dataMessage"
            x-transition.opacity
            x-cloak
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span x-text="dataMessage"></span>
          </p>

          {/* Danger zone */}
          <div class="set__danger">
            <div class="set__danger-head">
              <span class="set__danger-badge">DANGER</span>
              <h4 class="set__danger-title">Réinitialiser toutes les données</h4>
            </div>
            <p class="set__danger-desc">
              Supprime définitivement vos exercices, séances, progression et réglages.
              Cette action est irréversible — pensez à exporter une sauvegarde avant.
            </p>
            <button
              type="button"
              class="set__danger-btn"
              @click="askReset()"
            >
              Réinitialiser…
            </button>
          </div>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        6. À PROPOS
        ═════════════════════════════════════════════════════ */}
    <section class="set__section">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </span>
            <CardTitle>À propos</CardTitle>
          </div>
          <p class="set__heading-sub">Informations sur l'application.</p>
        </CardHeader>

        <CardContent>
          <dl class="set__about">
            <div class="set__about-row">
              <dt class="set__about-key">Version</dt>
              <dd class="set__about-val">
                <span class="set__about-pill">v{APP_VERSION}</span>
              </dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">Stockage</dt>
              <dd class="set__about-val">Local (navigateur)</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">Mode</dt>
              <dd class="set__about-val">100% hors-ligne</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">Polices</dt>
              <dd class="set__about-val">Barlow · Barlow Condensed</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">Icônes</dt>
              <dd class="set__about-val">Lucide</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">Framework</dt>
              <dd class="set__about-val">Astro 7</dd>
            </div>
          </dl>

          <p class="set__credits">
            Conçu et développé pour les pratiquants de musculation qui veulent
            suivre leurs performances sans dépendre du cloud. Toutes vos données
            restent sur votre appareil.
          </p>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        RESET CONFIRMATION DIALOG
        ═════════════════════════════════════════════════════ */}
    <Dialog id="set-reset-dialog" title="Réinitialiser toutes les données ?">
      <p class="set__confirm-text">
        Vous êtes sur le point de supprimer
        <strong> l'intégralité de vos données</strong> —
        exercices, séances, progression et réglages.
      </p>
      <p class="set__confirm-text set__confirm-text--muted">
        Tapez <strong>SUPPRIMER</strong> ci-dessous pour confirmer.
        Cette action est irréversible.
      </p>
      <div class="set__confirm-field">
        <input
          type="text"
          class="set__confirm-input"
          placeholder="SUPPRIMER"
          x-model="resetConfirmText"
          autocomplete="off"
          aria-label="Tapez SUPPRIMER pour confirmer"
        />
      </div>

      <div slot="footer">
        <Button
          variant="secondary"
          data-dialog-close
          type="button"
        >
          Annuler
        </Button>
        <Button
          variant="destructive"
          type="button"
          x-bind:disabled="resetConfirmText !== 'SUPPRIMER'"
          @click="confirmReset()"
        >
          Réinitialiser définitivement
        </Button>
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import {
    getSettings,
    updateSettings,
    exportAllData,
    exportSessionsAsCSV,
    importAllData,
    resetAllData,
    getSessionsThisWeek,
    type Settings,
  } from '../../lib/storage';

  interface SettingsAppState {
    // Source of truth (persisted)
    display: Settings;
    // Working copy for forms
    form: {
      pseudo: string;
      email: string;
      defaultRestTime: string;
      soundAlerts: boolean;
    };
    // UI state
    editingProfile: boolean;
    autoSavedAt: string;
    exporting: boolean;
    exportingCsv: boolean;
    importing: boolean;
    dataMessage: string;
    resetConfirmText: string;
    weeklyDone: number;

    // Lifecycle
    init(): void;

    // Profile
    startEditProfile(): void;
    cancelEditProfile(): void;
    saveProfile(): void;

    // Units
    setUnit(unit: 'kg' | 'lbs'): void;
    setRepsFormat(format: 'simple' | 'range'): void;

    // Timer
    saveTimer(): void;
    resetTimerForm(): void;

    // Weekly goal (auto-save)
    setWeeklyGoal(value: number): void;

    // Data
    exportData(): void;
    exportCSV(): void;
    triggerImport(): void;
    handleImportFile(event: Event): void;
    askReset(): void;
    confirmReset(): void;

    // Dialog helpers
    openDialogById(id: string): void;
    closeDialogById(id: string): void;
  }

  function cloneForm(s: Settings) {
    return {
      pseudo: s.pseudo,
      email: s.email,
      defaultRestTime: String(s.defaultRestTime),
      soundAlerts: s.soundAlerts,
    };
  }

  function downloadBlob(filename: string, content: string, mime: string): void {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    // Defer revoke so the download has time to start in Safari/Firefox.
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('settingsApp', () => ({
      // ── State ──
      display: getSettings(),
      form: cloneForm(getSettings()),
      editingProfile: false,
      autoSavedAt: '',
      exporting: false,
      exportingCsv: false,
      importing: false,
      dataMessage: '',
      resetConfirmText: '',
      weeklyDone: 0,

      // ── Init ──
      init() {
        // Re-sync in case another tab/page wrote new defaults.
        this.display = getSettings();
        this.form = cloneForm(this.display);
        this.weeklyDone = getSessionsThisWeek().length;

        // Auto-clear success toast after 4s.
        this.$watch('dataMessage', (msg: string) => {
          if (!msg) return;
          setTimeout(() => {
            if (this.dataMessage === msg) this.dataMessage = '';
          }, 4000);
        });
      },

      // ── Profile ──
      startEditProfile() {
        this.form = cloneForm(this.display);
        this.editingProfile = true;
      },

      cancelEditProfile() {
        this.form = cloneForm(this.display);
        this.editingProfile = false;
      },

      saveProfile() {
        const pseudo = this.form.pseudo.trim();
        const email = this.form.email.trim();
        this.display = updateSettings({ pseudo, email });
        this.form = cloneForm(this.display);
        this.editingProfile = false;
        this.flashSaved();
      },

      // ── Units (auto-save) ──
      setUnit(unit: 'kg' | 'lbs') {
        if (this.display.unit === unit) return;
        this.display = updateSettings({ unit });
        this.flashSaved();
      },

      setRepsFormat(format: 'simple' | 'range') {
        if (this.display.repsFormat === format) return;
        this.display = updateSettings({ repsFormat: format });
        this.flashSaved();
      },

      // ── Timer ──
      saveTimer() {
        const rest = parseInt(this.form.defaultRestTime, 10);
        if (!Number.isFinite(rest) || rest < 5 || rest > 3600) return;
        this.display = updateSettings({
          defaultRestTime: rest,
          soundAlerts: this.form.soundAlerts,
        });
        this.form = cloneForm(this.display);
        this.flashSaved();
      },

      resetTimerForm() {
        this.form = cloneForm(this.display);
      },

      // ── Weekly goal (auto-save on change) ──
      setWeeklyGoal(value: number) {
        // Clamp into [1, 7] and reject NaN. The input's min/max attributes
        // already constrain the UI, but be defensive.
        if (!Number.isFinite(value)) return;
        const next = Math.min(7, Math.max(1, Math.round(value)));
        if (this.display.weeklyGoal === next) return;
        this.display = updateSettings({ weeklyGoal: next });
        this.flashSaved();
      },

      // ── Data ──
      exportData() {
        this.exporting = true;
        try {
          const snapshot = exportAllData();
          if (!snapshot) {
            this.dataMessage = 'Stockage local indisponible.';
            return;
          }
          const date = new Date().toISOString().slice(0, 10);
          downloadBlob(
            `muscu-backup-${date}.json`,
            JSON.stringify(snapshot, null, 2),
            'application/json',
          );
          this.dataMessage = 'Sauvegarde téléchargée.';
        } catch (err) {
          this.dataMessage =
            err instanceof Error ? err.message : 'Échec de l\u2019export.';
        } finally {
          this.exporting = false;
        }
      },

      exportCSV() {
        this.exportingCsv = true;
        try {
          const csv = exportSessionsAsCSV();
          const date = new Date().toISOString().slice(0, 10);
          downloadBlob(
            `muscu-sessions-${date}.csv`,
            csv,
            'text/csv;charset=utf-8',
          );
          this.dataMessage = 'Export CSV téléchargé.';
        } catch (err) {
          this.dataMessage =
            err instanceof Error
              ? err.message
              : 'Échec de l\u2019export CSV.';
        } finally {
          this.exportingCsv = false;
        }
      },

      triggerImport() {
        // The hidden <input type="file"> is the sibling of the trigger button.
        const root = (this.$root as HTMLElement) ?? document;
        const input = root.querySelector<HTMLInputElement>(
          '.set__file-input',
        );
        if (input) {
          input.value = ''; // allow re-selecting the same file
          input.click();
        }
      },

      handleImportFile(event: Event) {
        const input = event.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file) return;
        this.importing = true;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const text = String(reader.result ?? '');
            const parsed = JSON.parse(text);
            importAllData(parsed);
            this.display = getSettings();
            this.form = cloneForm(this.display);
            this.dataMessage = 'Sauvegarde restaurée avec succès.';
            this.flashSaved();
          } catch (err) {
            this.dataMessage =
              err instanceof Error
                ? err.message
                : 'Fichier de sauvegarde invalide.';
          } finally {
            this.importing = false;
            input.value = '';
          }
        };
        reader.onerror = () => {
          this.dataMessage = 'Impossible de lire le fichier.';
          this.importing = false;
          input.value = '';
        };
        reader.readAsText(file);
      },

      askReset() {
        this.resetConfirmText = '';
        this.openDialogById('set-reset-dialog');
      },

      confirmReset() {
        if (this.resetConfirmText !== 'SUPPRIMER') return;
        resetAllData();
        this.display = getSettings();
        this.form = cloneForm(this.display);
        this.editingProfile = false;
        this.resetConfirmText = '';
        this.closeDialogById('set-reset-dialog');
        this.dataMessage = 'Toutes les données ont été réinitialisées.';
        this.flashSaved();
      },

      // ── Internals ──
      flashSaved() {
        const now = new Date();
        const hh = now.getHours().toString().padStart(2, '0');
        const mm = now.getMinutes().toString().padStart(2, '0');
        const ss = now.getSeconds().toString().padStart(2, '0');
        this.autoSavedAt = `Enregistré à ${hh}:${mm}:${ss}`;
        // Clear after 3s so it doesn't linger.
        setTimeout(() => {
          if (this.autoSavedAt.startsWith('Enregistré à ')) {
            this.autoSavedAt = '';
          }
        }, 3000);
      },

      // ── Dialog helpers ──
      openDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
      closeDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
    }));
  });
</script>

