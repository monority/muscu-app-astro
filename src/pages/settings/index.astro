---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import Button from '../../components/ui/Button.astro';
import Dialog from '../../components/ui/Dialog.astro';
import SettingsBottomBar from '../../components/layout/SettingsBottomBar.astro';
import ReminderSettings from '../../components/params/ReminderSettings.astro';
import Toast from '../../components/ui/Toast.astro';
import { t, setLocale, defaultLocale } from '../../i18n';



setLocale(Astro.currentLocale ?? defaultLocale);

const L = t();
/**
 * Static rest-time presets (seconds). Used by the Timer settings select
 * and matches the presets surfaced on /timer.
 */
const REST_PRESETS = [30, 45, 60, 90, 120, 180, 240, 300] as const;
const restOptions = REST_PRESETS.map((s) => {
  const mins = Math.floor(s / 60);
  const secs = s % 60;
  const label =
    secs === 0 ? `${mins} min` : `${mins} min ${secs.toString().padStart(2, '0')} s`;
  return { value: String(s), label };
});

// App version mirrored from package.json
const APP_VERSION = '0.0.1';

// Section metadata for the fixed bottom navigation bar. Labels come from
// the same i18n keys used by the section headings so both stay in sync.
const SETTINGS_SECTIONS = [
  { id: 'set-profile', label: L.settings.profile },
  { id: 'set-goals', label: L.settings.goals },
  { id: 'set-units', label: L.settings.units },
  { id: 'set-timer', label: L.settings.timerSettings },
  { id: 'set-reminder', label: L.settings.reminders },
  { id: 'set-data', label: L.settings.data },
  { id: 'set-sync', label: L.settings.sync.title },
  { id: 'set-about', label: L.settings.about },
];
---

<AppLayout title={L.settings.title}>
  <PageHeader
    title={L.settings.title}
    description={L.settings.description}
  />

  <Toast />

  <div
    class="set"
    x-data="settingsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ═════════════════════════════════════════════════════
        1. PROFIL
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-profile">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </span>
            <CardTitle>{L.settings.profile}</CardTitle>
          </div>
          <p class="set__heading-sub">{L.settings.profileDesc}</p>
        </CardHeader>

        <CardContent>
          {/* Display mode */}
          <div class="set__rows" x-show="!editingProfile" x-cloak x-transition.opacity.duration.200ms>
            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">{L.settings.pseudo}</span>
                <span class="set__row-hint">{L.settings.pseudoDesc}</span>
              </div>
              <div class="set__row-value" x-text="display.pseudo || labels.notSet"></div>
            </div>
            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">{L.settings.email}</span>
                <span class="set__row-hint">{L.settings.emailDesc}</span>
              </div>
              <div class="set__row-value" x-text="display.email || labels.notSet"></div>
            </div>
            <div class="set__actions">
              <Button type="button" variant="secondary" @click="startEditProfile()">
                {L.common.edit}
              </Button>
            </div>
          </div>

          {/* Edit mode */}
          <form
            class="set__form"
            x-show="editingProfile"
            @submit.prevent="saveProfile()"
            x-cloak
            x-transition.opacity.duration.200ms
          >
            <div class="set__form-field">
              <Input
                label={L.settings.pseudo}
                id="set-pseudo"
                type="text"
                placeholder={L.settings.pseudoPlaceholder}
                x-model="form.pseudo"
                maxlength={40}
                autocomplete="nickname"
              />
            </div>
            <div class="set__form-field">
              <Input
                label={L.settings.email}
                id="set-email"
                type="email"
                placeholder={L.settings.emailPlaceholder}
                x-model="form.email"
                autocomplete="email"
              />
            </div>
            <div class="set__actions">
              <Button type="button" variant="ghost" @click="cancelEditProfile()">
                {L.common.cancel}
              </Button>
              <Button type="submit" variant="primary">
                {L.common.save}
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        2. OBJECTIFS
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-goals">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2"></circle>
              </svg>
            </span>
            <CardTitle>{L.settings.goals}</CardTitle>
          </div>
          <p class="set__heading-sub">{L.settings.goalsDesc}</p>
        </CardHeader>

        <CardContent>
          <div class="set__rows">
            <div class="set__row set__row--form">
              <div class="set__row-label">
                <span class="set__row-title">{L.settings.weeklyGoalCount}</span>
                <span class="set__row-hint">{L.settings.weeklyGoalTrackedDesc}</span>
              </div>
              <div class="set__row-value set__row-value--control">
                <div class="set__goal-input-wrap">
                  <button
                    type="button"
                    class="set__goal-step"
                    aria-label={L.settings.weeklyGoalDecrease}
                    @click="setWeeklyGoal(display.weeklyGoal - 1)"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                  <input
                    id="set-weekly-goal"
                    type="number"
                    min="1"
                    max="7"
                    step="1"
                    inputmode="numeric"
                    class="set__goal-input no-spinner"
                    :value="display.weeklyGoal"
                    @change="setWeeklyGoal(parseInt($event.target.value, 10))"
                    aria-label={L.settings.weeklyGoalCount}
                  />
                  <button
                    type="button"
                    class="set__goal-step"
                    aria-label={L.settings.weeklyGoalIncrease}
                    @click="setWeeklyGoal(display.weeklyGoal + 1)"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <div class="set__row set__row--form">
              <div class="set__row-label">
                <span class="set__row-title">{L.settings.weeklyProgress}</span>
                <span class="set__row-hint">{L.settings.weeklyProgressDesc}</span>
              </div>
              <div class="set__row-value set__row-value--control">
                <span class="set__goal-progress">
                  <span class="set__goal-progress-num" x-text="weeklyDone"></span>
                  <span class="set__goal-progress-sep" aria-hidden="true">/</span>
                  <span class="set__goal-progress-target" x-text="display.weeklyGoal"></span>
                  <span class="set__goal-progress-label" x-text="labels.seanceSingular">{L.settings.seanceSingular}</span>
                  <span
                    class="set__goal-progress-label"
                    x-text="display.weeklyGoal > 1 ? 's' : ''"
                  ></span>
                </span>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        3. UNITÉS
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-units">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6.5 6.5h11"></path>
                <path d="M6.5 17.5h11"></path>
                <path d="M3 12h18"></path>
              </svg>
            </span>
            <CardTitle>{L.settings.units}</CardTitle>
          </div>
          <p class="set__heading-sub">{L.settings.unitsDesc}</p>
        </CardHeader>

        <CardContent>
          <div class="set__rows">
            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">{L.settings.weightUnit}</span>
                <span class="set__row-hint">{L.settings.weightUnitDesc}</span>
              </div>
              <div class="set__seg" role="group" aria-label={L.settings.weightUnit}>
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.unit === 'kg' }"
                  :aria-pressed="display.unit === 'kg'"
                  @click="setUnit('kg')"
                >
                  kg
                </button>
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.unit === 'lbs' }"
                  :aria-pressed="display.unit === 'lbs'"
                  @click="setUnit('lbs')"
                >
                  lbs
                </button>
              </div>
            </div>

            <div class="set__row">
              <div class="set__row-label">
                <span class="set__row-title">{L.settings.repsFormat}</span>
                <span class="set__row-hint">{L.settings.repsDesc}</span>
              </div>
              <div class="set__seg" role="group" aria-label={L.settings.repsFormat}>
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.repsFormat === 'simple' }"
                  :aria-pressed="display.repsFormat === 'simple'"
                  @click="setRepsFormat('simple')"
                >
                  {L.settings.simple}
                </button>
                <button
                  type="button"
                  class="set__seg-btn"
                  :class="{ 'is-active': display.repsFormat === 'range' }"
                  :aria-pressed="display.repsFormat === 'range'"
                  @click="setRepsFormat('range')"
                >
                  {L.settings.range}
                </button>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        4. TIMER
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-timer">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="13" r="8"></circle>
                <path d="M12 9v4l2 2"></path>
                <path d="M5 3 2 6"></path>
                <path d="m22 6-3-3"></path>
              </svg>
            </span>
            <CardTitle>{L.settings.timerSettings}</CardTitle>
          </div>
          <p class="set__heading-sub">{L.settings.timerDesc}</p>
        </CardHeader>

        <CardContent>
          <form class="set__form" @submit.prevent="saveTimer()">
            <div class="set__rows">
              <div class="set__row set__row--form">
                <div class="set__row-label">
                  <span class="set__row-title">{L.settings.defaultRestTime}</span>
                  <span class="set__row-hint">{L.settings.defaultRestTimeDesc}</span>
                </div>
                <div class="set__row-value set__row-value--control">
                  <Select
                    id="set-rest-time"
                    name="restTime"
                    options={restOptions}
                    x-model="form.defaultRestTime"
                  />
                </div>
              </div>

              <div class="set__row set__row--form">
                <div class="set__row-label">
                  <span class="set__row-title">{L.settings.soundAlerts}</span>
                  <span class="set__row-hint">{L.settings.soundAlertsDesc}</span>
                </div>
                <div class="set__row-value set__row-value--control">
                  <label class="set__toggle-wrap">
                    <input
                      type="checkbox"
                      class="sr-only set__toggle-input"
                      role="switch"
                      :checked="form.soundAlerts"
                      :aria-checked="form.soundAlerts ? 'true' : 'false'"
                      @change="form.soundAlerts = $event.target.checked"
                    />
                    <span class="set__toggle-track">
                      <span class="set__toggle-thumb"></span>
                    </span>
                  </label>
                </div>
              </div>
            </div>

            <p
              class="set__hint"
              x-show="form.defaultRestTime !== String(display.defaultRestTime) || form.soundAlerts !== display.soundAlerts"
              x-cloak
              x-text="labels.unsavedChanges"
            >
              {L.settings.unsavedChanges}
            </p>

            <div class="set__actions">
              <Button
                type="button"
                variant="ghost"
                @click="resetTimerForm()"
                x-show="form.defaultRestTime !== String(display.defaultRestTime) || form.soundAlerts !== display.soundAlerts"
                x-cloak
              >
                {L.common.cancel}
              </Button>
              <Button
                type="submit"
                variant="primary"
                x-bind:disabled="form.defaultRestTime === String(display.defaultRestTime) && form.soundAlerts === display.soundAlerts"
              >
                {L.common.save}
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        5. RAPPEL D'ENTRAÎNEMENT
        ═════════════════════════════════════════════════════ */}
    <ReminderSettings />

    {/* ═════════════════════════════════════════════════════
        6. DONNÉES
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-data">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
                <path d="M3 12a9 3 0 0 0 18 0"></path>
              </svg>
            </span>
            <CardTitle>{L.settings.data}</CardTitle>
          </div>
          <p class="set__heading-sub">{L.settings.dataDesc}</p>
        </CardHeader>

        <CardContent>
          <div class="set__data-grid">
            <div class="set__data-tile">
              <div class="set__data-tile-body">
                <div class="set__data-tile-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                </div>
                <div class="set__data-tile-text">
                  <h4 class="set__data-tile-title">{L.settings.exportJSON}</h4>
                  <p class="set__data-tile-desc">
                    {L.settings.exportJSONDesc}
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="set__data-btn"
                @click="exportData()"
                :disabled="exporting"
              >
                <span x-show="!exporting" x-cloak x-text="labels.download">{L.settings.download}</span>
                <span x-show="exporting" x-cloak x-text="labels.preparing">{L.settings.preparing}</span>
              </button>
            </div>

            <div class="set__data-tile">
              <div class="set__data-tile-body">
                <div class="set__data-tile-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="3" y1="15" x2="21" y2="15"></line>
                  </svg>
                </div>
                <div class="set__data-tile-text">
                  <h4 class="set__data-tile-title">{L.settings.exportCSV}</h4>
                  <p class="set__data-tile-desc">
                    {L.settings.exportCSVDesc}
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="set__data-btn"
                @click="exportCSV()"
                :disabled="exportingCsv"
              >
                <span x-show="!exportingCsv" x-cloak x-text="labels.download">{L.settings.download}</span>
                <span x-show="exportingCsv" x-cloak x-text="labels.preparing">{L.settings.preparing}</span>
              </button>
            </div>

            <div class="set__data-tile">
              <div class="set__data-tile-body">
                <div class="set__data-tile-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                  </svg>
                </div>
                <div class="set__data-tile-text">
                  <h4 class="set__data-tile-title">{L.settings.import}</h4>
                  <p class="set__data-tile-desc">
                    {L.settings.importDesc}
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="set__data-btn"
                @click="triggerImport()"
                :disabled="importing"
              >
                <span x-show="!importing" x-cloak>{L.settings.chooseFile}</span>
                <span x-show="importing" x-cloak x-text="labels.importing">{L.settings.importing}</span>
              </button>
              <input
                type="file"
                accept="application/json,.json"
                class="set__file-input"
                @change="handleImportFile($event)"
                aria-hidden="true"
                tabindex="-1"
              />
            </div>
          </div>

          {/* Danger zone */}
          <div class="set__danger">
            <div class="set__danger-head">
              <span class="set__danger-badge">DANGER</span>
              <h4 class="set__danger-title">{L.settings.resetAll}</h4>
            </div>
            <p class="set__danger-desc">
              {L.settings.resetDesc}
            </p>
            <button
              type="button"
              class="set__danger-btn"
              @click="askReset()"
            >
              {L.settings.resetAction}
            </button>
          </div>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        7. SYNCHRONISATION WEBDAV
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-sync">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25"></path>
                <polyline points="8 16 12 20 16 16"></polyline>
              </svg>
            </span>
            <CardTitle>{L.settings.sync.title}</CardTitle>
          </div>
          <p class="set__heading-sub">{L.settings.sync.desc}</p>
          <p class="set__sync-note">{L.settings.sync.corsNote}</p>
        </CardHeader>

        <CardContent>
          <form class="set__form" @submit.prevent="saveSync()">
            <div class="set__rows">
              <div class="set__row set__row--form">
                <div class="set__row-label">
                  <label class="set__row-title" for="set-sync-url" x-text="labels.syncUrl">{L.settings.sync.url}</label>
                  <span class="set__row-hint" x-text="labels.syncConflict">{L.settings.sync.conflict}</span>
                </div>
                <div class="set__row-value set__row-value--control">
                  <input
                    type="text"
                    id="set-sync-url"
                    class="set__sync-input"
                    x-model="syncForm.url"
                    :placeholder="labels.syncUrlPlaceholder"
                    autocomplete="url"
                    spellcheck="false"
                    aria-label={L.settings.sync.url}
                  />
                </div>
              </div>

              <div class="set__row set__row--form">
                <div class="set__row-label">
                  <label class="set__row-title" for="set-sync-username">{L.settings.sync.username}</label>
                </div>
                <div class="set__row-value set__row-value--control">
                  <input
                    type="text"
                    id="set-sync-username"
                    class="set__sync-input"
                    x-model="syncForm.username"
                    :placeholder="labels.syncUsernamePlaceholder"
                    autocomplete="username"
                    spellcheck="false"
                    aria-label={L.settings.sync.username}
                  />
                </div>
              </div>

              <div class="set__row set__row--form">
                <div class="set__row-label">
                  <label class="set__row-title" for="set-sync-password">{L.settings.sync.password}</label>
                  <span class="set__row-hint">{L.settings.sync.passwordNote}</span>
                </div>
                <div class="set__row-value set__row-value--control">
                  <input
                    type="password"
                    id="set-sync-password"
                    class="set__sync-input"
                    x-model="syncForm.password"
                    :placeholder="labels.syncPasswordPlaceholder"
                    autocomplete="off"
                    aria-label={L.settings.sync.password}
                  />
                </div>
              </div>
            </div>

            <div class="set__actions">
              <button
                type="button"
                class="set__data-btn"
                @click="cancelSync()"
              >
                {L.common.cancel}
              </button>
              <button
                type="submit"
                class="set__data-btn set__sync-btn--primary"
              >
                {L.common.save}
              </button>
            </div>
          </form>

          {/* Last sync status + Google Drive note */}
          <div class="set__sync-status" x-show="syncConfigured" x-cloak>
            <span class="set__sync-status-key">{L.settings.sync.lastSync}</span>
            <span class="set__sync-status-value" x-text="syncLastLabel"></span>
          </div>
          <p class="set__sync-note">{L.settings.sync.googleDrive}</p>

          {/* Manual-only actions */}
          <div class="set__sync-actions">
            <Button
              variant="secondary"
              type="button"
              class="set__sync-btn"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'test'"
              @click="testSync()"
            >
              <span x-show="syncBusy !== 'test'" x-cloak x-text="labels.syncTest">{L.settings.sync.test}</span>
              <span x-show="syncBusy === 'test'" x-cloak x-text="labels.syncTesting">{L.settings.sync.testing}</span>
            </Button>
            <Button
              variant="primary"
              type="button"
              class="set__sync-btn"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'push'"
              @click="pushSync()"
            >
              <span x-show="syncBusy !== 'push'" x-cloak x-text="labels.syncPush">{L.settings.sync.push}</span>
              <span x-show="syncBusy === 'push'" x-cloak x-text="labels.syncPushing">{L.settings.sync.pushing}</span>
            </Button>
            <Button
              variant="secondary"
              type="button"
              class="set__sync-btn"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'pull'"
              @click="askRestore()"
            >
              <span x-show="syncBusy !== 'pull'" x-cloak x-text="labels.syncPull">{L.settings.sync.pull}</span>
              <span x-show="syncBusy === 'pull'" x-cloak x-text="labels.syncPulling">{L.settings.sync.pulling}</span>
            </Button>
          </div>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        8. À PROPOS
        ═════════════════════════════════════════════════════ */}
    <section class="set__section" id="set-about">
      <Card>
        <CardHeader>
          <div class="set__heading">
            <span class="set__heading-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </span>
            <CardTitle>{L.settings.about}</CardTitle>
          </div>
          <p class="set__heading-sub">{L.settings.aboutDesc}</p>
        </CardHeader>

        <CardContent>
          <dl class="set__about">
            <div class="set__about-row">
              <dt class="set__about-key">{L.settings.version}</dt>
              <dd class="set__about-val">
                <span class="set__about-pill">v{APP_VERSION}</span>
              </dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">{L.settings.storage}</dt>
              <dd class="set__about-val">{L.settings.storageValue}</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">{L.settings.mode}</dt>
              <dd class="set__about-val">{L.settings.modeValue}</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">{L.settings.fonts}</dt>
              <dd class="set__about-val">Inter</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">{L.settings.icons}</dt>
              <dd class="set__about-val">Lucide</dd>
            </div>
            <div class="set__about-row">
              <dt class="set__about-key">{L.settings.framework}</dt>
              <dd class="set__about-val">Astro 7</dd>
            </div>
          </dl>

          <p class="set__credits">
            {L.settings.credits}
          </p>
        </CardContent>
      </Card>
    </section>

    {/* ═════════════════════════════════════════════════════
        RESET CONFIRMATION DIALOG
        ═════════════════════════════════════════════════════ */}
    <Dialog id="set-reset-dialog" title={`${L.settings.resetAll} ?`}>
      <p class="set__confirm-text">
        {L.settings.resetConfirmIntro}
        <strong> {L.settings.resetConfirmIntroStrong}</strong> —
        {L.settings.resetConfirmIntroList}
      </p>
      <p class="set__confirm-text set__confirm-text--muted">
        {L.settings.resetConfirmAction} <strong>SUPPRIMER</strong> {L.settings.resetConfirmActionOutro}
        {L.settings.resetIrreversible}
      </p>
      <div class="set__confirm-field">
        <input
          type="text"
          class="set__confirm-input"
          placeholder="SUPPRIMER"
          x-model="resetConfirmText"
          autocomplete="off"
          aria-label={L.settings.resetConfirm}
        />
      </div>

      <div slot="footer">
        <Button
          variant="secondary"
          data-dialog-close
          type="button"
        >
          {L.common.cancel}
        </Button>
        <Button
          variant="destructive"
          type="button"
          x-bind:disabled="resetConfirmText !== 'SUPPRIMER'"
          @click="confirmReset()"
        >
          {L.settings.resetPermanent}
        </Button>
      </div>
    </Dialog>

    {/* ═════════════════════════════════════════════════════
        WEBDAV RESTORE CONFIRMATION DIALOG
        ═════════════════════════════════════════════════════ */}
    <Dialog id="set-restore-dialog" title={L.settings.sync.restoreTitle}>
      <p class="set__confirm-text">{L.settings.sync.restoreBody}</p>
      <p class="set__confirm-text set__confirm-text--muted">
        {L.settings.sync.restoreIrreversible}
      </p>

      <div slot="footer">
        <Button
          variant="secondary"
          data-dialog-close
          type="button"
        >
          {L.common.cancel}
        </Button>
        <Button
          variant="destructive"
          type="button"
          x-bind:disabled="syncBusy !== null"
          @click="confirmRestore()"
        >
          <span x-show="syncBusy !== 'pull'" x-cloak>{L.settings.sync.restoreConfirm}</span>
          <span x-show="syncBusy === 'pull'" x-cloak>{L.settings.sync.pulling}</span>
        </Button>
      </div>
    </Dialog>

    <SettingsBottomBar
      sections={SETTINGS_SECTIONS}
      activeSection="set-profile"
      saveLabel={L.common.save}
    />
  </div>
</AppLayout>

<script>
  import {
    getSettings,
    updateSettings,
    exportAllData,
    exportSessionsAsCSV,
    importAllData,
    resetAllData,
    getSessionsThisWeek,
    type Settings,
  } from '../../lib/storage';
  import {
    syncPush,
    syncPull,
    syncTest,
    SyncError,
    type SyncErrorCode,
  } from '../../lib/sync';
  import { t, defaultLocale } from '../../i18n';

  const LABELS = t();

  interface SettingsAppState {
    // Source of truth (persisted)
    display: Settings;
    // Working copy for forms
    form: {
      pseudo: string;
      email: string;
      defaultRestTime: string;
      soundAlerts: boolean;
    };
    // UI state
    editingProfile: boolean;
    exporting: boolean;
    exportingCsv: boolean;
    importing: boolean;
    resetConfirmText: string;
    weeklyDone: number;
    // WebDAV sync
    syncForm: { url: string; username: string; password: string };
    syncConfigured: boolean;
    syncBusy: 'test' | 'push' | 'pull' | null;
    syncLastLabel: string;

    // Lifecycle
    init(): void;

    // Section save dispatch (fired by SettingsBottomBar)
    saveSection(section: string): void;

    // Profile
    startEditProfile(): void;
    cancelEditProfile(): void;
    saveProfile(): void;

    // Units
    setUnit(unit: 'kg' | 'lbs'): void;
    setRepsFormat(format: 'simple' | 'range'): void;

    // Timer
    saveTimer(): void;
    resetTimerForm(): void;

    // Weekly goal (auto-save)
    setWeeklyGoal(value: number): void;

    // Data
    exportData(): void;
    exportCSV(): void;
    triggerImport(): void;
    handleImportFile(event: Event): void;
    askReset(): void;
    confirmReset(): void;

    // WebDAV sync
    saveSync(): void;
    cancelSync(): void;
    persistSyncConfig(): void;
    persistSyncConfigWithNow(): void;
    lastSyncLabel(lastSyncAt?: string): string;
    testSync(): Promise<void>;
    pushSync(): Promise<void>;
    askRestore(): void;
    confirmRestore(): Promise<void>;
    syncErrorLabel(err: unknown): string;

    // Dialog helpers
    openDialogById(id: string): void;
    closeDialogById(id: string): void;
  }

  function cloneForm(s: Settings) {
    return {
      pseudo: s.pseudo,
      email: s.email,
      defaultRestTime: String(s.defaultRestTime),
      soundAlerts: s.soundAlerts,
    };
  }

  function downloadBlob(filename: string, content: string, mime: string): void {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    // Defer revoke so the download has time to start in Safari/Firefox.
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function formatSavedAt(): string {
    const now = new Date();
    const hh = now.getHours().toString().padStart(2, '0');
    const mm = now.getMinutes().toString().padStart(2, '0');
    const ss = now.getSeconds().toString().padStart(2, '0');
    return `${LABELS.settings.savedAtPrefix}${hh}:${mm}:${ss}`;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('settingsApp', () => ({
      // ── State ──
      display: getSettings(),
      form: cloneForm(getSettings()),
      editingProfile: false,
      exporting: false,
      exportingCsv: false,
      importing: false,
      resetConfirmText: '',
      weeklyDone: 0,
      syncForm: { url: '', username: '', password: '' },
      syncConfigured: false,
      syncBusy: null,
      syncLastLabel: '',
      labels: {
        notSet: LABELS.settings.notSet,
        download: LABELS.settings.download,
        preparing: LABELS.settings.preparing,
        importing: LABELS.settings.importing,
        seanceSingular: LABELS.settings.seanceSingular,
        unsavedChanges: LABELS.settings.unsavedChanges,
        storageError: LABELS.settings.storageError,
        exportFailed: LABELS.settings.exportFailed,
        exportCsvFailed: LABELS.settings.exportCsvFailed,
        backupDownloaded: LABELS.settings.backupDownloaded,
        exportCsvDownloaded: LABELS.settings.exportCsvDownloaded,
        backupRestored: LABELS.settings.backupRestored,
        invalidFile: LABELS.settings.invalidFile,
        readError: LABELS.settings.readError,
        allDataReset: LABELS.settings.allDataReset,
        savedAtPrefix: LABELS.settings.savedAtPrefix,
        syncUrl: LABELS.settings.sync.url,
        syncUrlPlaceholder: LABELS.settings.sync.urlPlaceholder,
        syncConflict: LABELS.settings.sync.conflict,
        syncUsernamePlaceholder: LABELS.settings.sync.usernamePlaceholder,
        syncPasswordPlaceholder: LABELS.settings.sync.passwordPlaceholder,
        syncTest: LABELS.settings.sync.test,
        syncTesting: LABELS.settings.sync.testing,
        syncPush: LABELS.settings.sync.push,
        syncPushing: LABELS.settings.sync.pushing,
        syncPull: LABELS.settings.sync.pull,
        syncPulling: LABELS.settings.sync.pulling,
        syncTestOk: LABELS.settings.sync.testOk,
        syncTestOkNoBackup: LABELS.settings.sync.testOkNoBackup,
        syncPushed: LABELS.settings.sync.pushed,
        syncRestored: LABELS.settings.sync.restored,
        syncNotConfigured: LABELS.settings.sync.notConfigured,
        syncUnavailable: LABELS.settings.sync.unavailable,
        syncFallback: LABELS.settings.sync.fallback,
        syncLastSync: LABELS.settings.sync.lastSync,
        syncNever: LABELS.settings.sync.never,
        syncError: LABELS.settings.sync.error,
      },

      // ── Init ──
      init() {
        // Re-sync in case another tab/page wrote new defaults.
        this.display = getSettings();
        this.form = cloneForm(this.display);
        this.weeklyDone = getSessionsThisWeek().length;
        this.syncForm = {
          url: this.display.webdav?.url || '',
          username: this.display.webdav?.username || '',
          password: this.display.webdav?.password || '',
        };
        this.syncConfigured = Boolean(this.display.webdav?.url);
        this.syncLastLabel = this.lastSyncLabel(this.display.webdav?.lastSyncAt);

        // Autosave on any section save action dispatched by the fixed
        // bottom bar (SettingsBottomBar.astro).
        document.addEventListener("settings-save", (e: Event) => {
          const section = (e as CustomEvent).detail?.section;
          this.saveSection(section);
        });
      },

      saveSection(section: string) {
        // Sections that write settings live directly in `display` and
        // persist automatically; only Profile and Timer keep unsaved edits
        // in `this.form`, so those are the ones backed by an explicit save.
        switch (section) {
          case 'set-profile':
            if (this.editingProfile) this.saveProfile();
            else window.showToast(formatSavedAt(), 'success');
            break;
          case 'set-timer':
            this.saveTimer();
            break;
          case 'set-sync':
            this.saveSync();
            break;
          default:
            // Units, goals, data and about auto-save (or expose their own
            // actions); nothing left to flush here.
            window.showToast(formatSavedAt(), 'success');
        }
      },

      // ── Profile ──
      startEditProfile() {
        this.form = cloneForm(this.display);
        this.editingProfile = true;
      },

      cancelEditProfile() {
        this.form = cloneForm(this.display);
        this.editingProfile = false;
      },

      saveProfile() {
        const pseudo = this.form.pseudo.trim();
        const email = this.form.email.trim();
        this.display = updateSettings({ pseudo, email });
        this.form = cloneForm(this.display);
        this.editingProfile = false;
        window.showToast(formatSavedAt(), 'success');
      },

      // ── Units (auto-save) ──
      setUnit(unit: 'kg' | 'lbs') {
        if (this.display.unit === unit) return;
        this.display = updateSettings({ unit });
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      setRepsFormat(format: 'simple' | 'range') {
        if (this.display.repsFormat === format) return;
        this.display = updateSettings({ repsFormat: format });
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      // ── Timer ──
      saveTimer() {
        const rest = parseInt(this.form.defaultRestTime, 10);
        if (!Number.isFinite(rest) || rest < 5 || rest > 3600) return;
        this.display = updateSettings({
          defaultRestTime: rest,
          soundAlerts: this.form.soundAlerts,
        });
        this.form = cloneForm(this.display);
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      resetTimerForm() {
        this.form = cloneForm(this.display);
      },

      // ── Weekly goal (auto-save on change) ──
      setWeeklyGoal(value: number) {
        // Clamp into [1, 7] and reject NaN. The input's min/max attributes
        // already constrain the UI, but be defensive.
        if (!Number.isFinite(value)) return;
        const next = Math.min(7, Math.max(1, Math.round(value)));
        if (this.display.weeklyGoal === next) return;
        this.display = updateSettings({ weeklyGoal: next });
        window.showToast(this.labels.savedAtPrefix + new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }), 'success');
      },

      // ── Data ──
      exportData() {
        this.exporting = true;
        try {
          const snapshot = exportAllData();
          if (!snapshot) {
            window.showToast(this.labels.storageError, 'error');
            return;
          }
          const date = new Date().toISOString().slice(0, 10);
          downloadBlob(
            `muscu-backup-${date}.json`,
            JSON.stringify(snapshot, null, 2),
            'application/json',
          );
          window.showToast(this.labels.backupDownloaded, 'success');
        } catch (err) {
          window.showToast(
            err instanceof Error ? err.message : this.labels.exportFailed,
            'error',
          );
        } finally {
          this.exporting = false;
        }
      },

      exportCSV() {
        this.exportingCsv = true;
        try {
          const csv = exportSessionsAsCSV();
          const date = new Date().toISOString().slice(0, 10);
          downloadBlob(
            `muscu-sessions-${date}.csv`,
            csv,
            'text/csv;charset=utf-8',
          );
          window.showToast(this.labels.exportCsvDownloaded, 'success');
        } catch (err) {
          window.showToast(
            err instanceof Error
              ? err.message
              : this.labels.exportCsvFailed,
            'error',
          );
        } finally {
          this.exportingCsv = false;
        }
      },

      triggerImport() {
        // The hidden <input type="file"> is the sibling of the trigger button.
        const root = (this.$root as HTMLElement) ?? document;
        const input = root.querySelector<HTMLInputElement>(
          '.set__file-input',
        );
        if (input) {
          input.value = ''; // allow re-selecting the same file
          input.click();
        }
      },

      handleImportFile(event: Event) {
        const input = event.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file) return;
        this.importing = true;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const text = String(reader.result ?? '');
            const parsed = JSON.parse(text);
            importAllData(parsed);
            this.display = getSettings();
            this.form = cloneForm(this.display);
            window.showToast(this.labels.backupRestored, 'success');
          } catch (err) {
            window.showToast(
              err instanceof Error
                ? err.message
                : this.labels.invalidFile,
              'error',
            );
          } finally {
            this.importing = false;
            input.value = '';
          }
        };
        reader.onerror = () => {
          window.showToast(this.labels.readError, 'error');
          this.importing = false;
          input.value = '';
        };
        reader.readAsText(file);
      },

      askReset() {
        this.resetConfirmText = '';
        this.openDialogById('set-reset-dialog');
      },

      confirmReset() {
        if (this.resetConfirmText !== 'SUPPRIMER') return;
        resetAllData();
        this.display = getSettings();
        this.form = cloneForm(this.display);
        this.editingProfile = false;
        this.resetConfirmText = '';
        this.closeDialogById('set-reset-dialog');
        window.showToast(this.labels.allDataReset, 'success');
      },

      // ── WebDAV sync ──
      saveSync() {
        // Saving an empty field clears the stored connection; saving a
        // complete URL stores it and marks the connection as configured.
        this.persistSyncConfig();
        window.showToast(formatSavedAt(), 'success');
      },

      /** Persists the current sync form into Settings and refreshes the
       *  configured flag + last-sync label. Keeps the timestamp when the
       *  connection is kept, clears it when the URL is emptied. */
      persistSyncConfig() {
        const url = this.syncForm.url.trim();
        this.display = updateSettings({
          webdav: {
            url,
            username: this.syncForm.username.trim(),
            password: this.syncForm.password,
            lastSyncAt: url ? this.display.webdav?.lastSyncAt : undefined,
          },
        });
        this.syncConfigured = Boolean(url);
        this.syncLastLabel = this.lastSyncLabel(
          this.syncConfigured ? this.display.webdav?.lastSyncAt : undefined,
        );
      },

      /** Persists the sync form and stamps a fresh success timestamp. */
      persistSyncConfigWithNow() {
        this.display = updateSettings({
          webdav: {
            url: this.syncForm.url.trim(),
            username: this.syncForm.username.trim(),
            password: this.syncForm.password,
            lastSyncAt: new Date().toISOString(),
          },
        });
        this.syncConfigured = true;
        this.syncLastLabel = this.lastSyncLabel(
          this.display.webdav?.lastSyncAt,
        );
      },

      cancelSync() {
        // Discard unsaved edits and restore the persisted connection.
        const webdav = this.display.webdav;
        this.syncForm = {
          url: webdav?.url || '',
          username: webdav?.username || '',
          password: webdav?.password || '',
        };
      },

      lastSyncLabel(lastSyncAt?: string): string {
        if (!lastSyncAt) return this.labels.syncNever;
        const d = new Date(lastSyncAt);
        if (Number.isNaN(d.getTime())) return this.labels.syncNever;
        return `${this.labels.syncLastSync} — ${d.toLocaleString()}`;
      },

      syncErrorLabel(err: unknown): string {
        if (err instanceof SyncError) {
          const code = err.code as SyncErrorCode;
          const label = this.labels.syncError[code] ?? this.labels.syncFallback;
          if (code === 'sync-http' && typeof err.status === 'number') {
            return `${label} (HTTP ${err.status})`;
          }
          return label;
        }
        // Plain errors (e.g. importAllData validation) carry their message.
        return err instanceof Error && err.message
          ? err.message
          : this.labels.syncFallback;
      },

      async testSync() {
        if (!this.syncForm.url.trim()) {
          window.showToast(this.labels.syncNotConfigured, 'error');
          return;
        }
        this.syncBusy = 'test';
        try {
          const result = await syncTest(
            this.syncForm.url,
            this.syncForm.username,
            this.syncForm.password,
          );
          window.showToast(
            result.hasBackup ? this.labels.syncTestOk : this.labels.syncTestOkNoBackup,
            'success',
          );
        } catch (err) {
          window.showToast(this.syncErrorLabel(err), 'error');
        } finally {
          this.syncBusy = null;
        }
      },

      async pushSync() {
        if (!this.syncForm.url.trim()) {
          window.showToast(this.labels.syncNotConfigured, 'error');
          return;
        }
        this.syncBusy = 'push';
        try {
          const snapshot = exportAllData();
          if (!snapshot) {
            window.showToast(this.labels.storageError, 'error');
            return;
          }
          await syncPush(
            this.syncForm.url,
            this.syncForm.username,
            this.syncForm.password,
            snapshot,
          );
          // Last-write-wins: record the successful push so the status line
          // reflects the most recent sync.
          this.persistSyncConfigWithNow();
          window.showToast(this.labels.syncPushed, 'success');
        } catch (err) {
          window.showToast(this.syncErrorLabel(err), 'error');
        } finally {
          this.syncBusy = null;
        }
      },

      askRestore() {
        if (!this.syncForm.url.trim()) {
          window.showToast(this.labels.syncNotConfigured, 'error');
          return;
        }
        this.openDialogById('set-restore-dialog');
      },

      async confirmRestore() {
        this.syncBusy = 'pull';
        try {
          const snapshot = await syncPull(
            this.syncForm.url,
            this.syncForm.username,
            this.syncForm.password,
          );
          // Destructive: replaces all local data with the remote backup.
          importAllData(snapshot);
          this.display = getSettings();
          this.form = cloneForm(this.display);
          this.persistSyncConfigWithNow();
          this.closeDialogById('set-restore-dialog');
          window.showToast(this.labels.syncRestored, 'success');
        } catch (err) {
          window.showToast(this.syncErrorLabel(err), 'error');
        } finally {
          this.syncBusy = null;
        }
      },

      // ── Dialog helpers ──
      openDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
      closeDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
    }));
  });
</script>

