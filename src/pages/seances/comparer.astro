---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
---

<AppLayout title="Comparer les séances">
  <div
    class="comp"
    x-data="comparisonApp()"
    x-init="init()"
    x-cloak
  >
    <PageHeader
      title="Comparer les séances"
      description="Sélectionnez deux séances pour comparer leur volume, leurs exercices et leurs séries."
    />

    {/* ── Back link ── */}
    <a href="/seances" class="comp__back">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Retour aux séances</span>
    </a>

    {/* ════════════════════════════════════════════════════
        SESSION PICKERS
        ════════════════════════════════════════════════════ */}
    <Card>
      <CardHeader>
        <CardTitle>Sélection</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="comp__pickers">
          <div class="comp__picker">
            <label for="comp-s1" class="comp__picker-label">Séance 1 (référence)</label>
            <div class="comp__picker-field">
              <svg
                class="comp__picker-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6.5 6.5h11v11h-11z"></path>
                <path d="M2 9v6"></path>
                <path d="M22 9v6"></path>
                <path d="M6.5 6.5L2 9"></path>
                <path d="M17.5 6.5L22 9"></path>
                <path d="M6.5 17.5L2 15"></path>
                <path d="M17.5 17.5L22 15"></path>
              </svg>
              <select
                id="comp-s1"
                class="comp__select"
                x-model="session1Id"
                @change="onSession1Change($event.target.value)"
                :aria-label="'Choisir la première séance'"
              >
                <option value="">Choisir une séance…</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session2Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>

          <div class="comp__vs" aria-hidden="true">
            <span class="comp__vs-text">VS</span>
          </div>

          <div class="comp__picker">
            <label for="comp-s2" class="comp__picker-label">Séance 2 (comparée)</label>
            <div class="comp__picker-field">
              <svg
                class="comp__picker-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6.5 6.5h11v11h-11z"></path>
                <path d="M2 9v6"></path>
                <path d="M22 9v6"></path>
                <path d="M6.5 6.5L2 9"></path>
                <path d="M17.5 6.5L22 9"></path>
                <path d="M6.5 17.5L2 15"></path>
                <path d="M17.5 17.5L22 15"></path>
              </svg>
              <select
                id="comp-s2"
                class="comp__select"
                x-model="session2Id"
                @change="onSession2Change($event.target.value)"
                :aria-label="'Choisir la deuxième séance'"
              >
                <option value="">Choisir une séance…</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session1Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>

    {/* ════════════════════════════════════════════════════
        HINT — show "select both" message
        ════════════════════════════════════════════════════ */}
    <template x-if="allSessions.length < 2">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <p>
            Vous avez besoin d'au moins deux séances pour les comparer.
            <a href="/seances/creer" class="comp__hint-link">Créer une séance →</a>
          </p>
        </div>
      </Card>
    </template>

    <template x-if="allSessions.length >= 2 && (!session1 || !session2)">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
              <polyline points="16 7 22 7 22 13"></polyline>
            </svg>
          </div>
          <p>Sélectionnez les deux séances à comparer ci-dessus.</p>
        </div>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        COMPARISON COLUMNS
        ════════════════════════════════════════════════════ */}
    <template x-if="session1 && session2">
      <div class="comp__content">
        {/* ── Summary deltas at the top ── */}
        <div class="comp__summary">
          <h2 class="comp__section-title">Résumé comparatif</h2>
          <div class="comp__summary-grid">
            {/* Volume delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <svg
                  class="comp__summary-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6.5 6.5h11"></path>
                  <path d="M6.5 17.5h11"></path>
                  <path d="M3 9v6"></path>
                  <path d="M21 9v6"></path>
                  <path d="M6.5 6.5 3 9v6l3.5 2.5h11L21 15V9l-3.5-2.5Z"></path>
                </svg>
                <span class="comp__summary-label">Volume total</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 1</div>
                  <div class="comp__summary-value" x-text="formatVolume(totalVolume(session1))"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + volumeDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="volumeDelta.direction === 'up'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="19" x2="12" y2="5"></line>
                        <polyline points="5 12 12 5 19 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="volumeDelta.direction === 'down'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <polyline points="19 12 12 19 5 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="volumeDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="volumeDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 2</div>
                  <div class="comp__summary-value" x-text="formatVolume(totalVolume(session2))"></div>
                </div>
              </div>
            </article>

            {/* Exercises delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <svg
                  class="comp__summary-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span class="comp__summary-label">Exercices</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 1</div>
                  <div class="comp__summary-value" x-text="session1.exercises.length"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + exercisesDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="exercisesDelta.direction === 'up'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="19" x2="12" y2="5"></line>
                        <polyline points="5 12 12 5 19 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="exercisesDelta.direction === 'down'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <polyline points="19 12 12 19 5 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="exercisesDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="exercisesDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 2</div>
                  <div class="comp__summary-value" x-text="session2.exercises.length"></div>
                </div>
              </div>
            </article>

            {/* Sets delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <svg
                  class="comp__summary-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span class="comp__summary-label">Séries</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 1</div>
                  <div class="comp__summary-value" x-text="totalSets(session1)"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + setsDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="setsDelta.direction === 'up'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="19" x2="12" y2="5"></line>
                        <polyline points="5 12 12 5 19 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="setsDelta.direction === 'down'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <polyline points="19 12 12 19 5 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="setsDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="setsDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 2</div>
                  <div class="comp__summary-value" x-text="totalSets(session2)"></div>
                </div>
              </div>
            </article>

            {/* Best 1RM delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <svg
                  class="comp__summary-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14.4 14.4 9.6 9.6"></path>
                  <path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"></path>
                  <path d="m21.5 21.5-1.4-1.4"></path>
                  <path d="M3.9 3.9 2.5 2.5"></path>
                  <path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"></path>
                </svg>
                <span class="comp__summary-label">Meilleur 1RM</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 1</div>
                  <div class="comp__summary-value" x-text="formatVolume(bestSet(session1))"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + bestSetDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="bestSetDelta.direction === 'up'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="19" x2="12" y2="5"></line>
                        <polyline points="5 12 12 5 19 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="bestSetDelta.direction === 'down'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <polyline points="19 12 12 19 5 12"></polyline>
                      </svg>
                    </template>
                    <template x-if="bestSetDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="bestSetDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">Séance 2</div>
                  <div class="comp__summary-value" x-text="formatVolume(bestSet(session2))"></div>
                </div>
              </div>
            </article>
          </div>
        </div>

        {/* ── Per-session columns ── */}
        <div class="comp__columns">
          {/* Session 1 column */}
          <section class="comp__col" aria-label="Détails de la séance 1">
            <header class="comp__col-head">
              <span class="comp__col-tag">Séance 1</span>
              <h3 class="comp__col-name" x-text="session1.name"></h3>
              <div class="comp__col-meta">
                <span
                  class="comp__status"
                  :class="'comp__status--' + session1.status"
                  x-text="statusLabel(session1.status)"
                ></span>
                <span class="comp__col-date" x-text="formatDate(session1.date)"></span>
              </div>
              <div class="comp__col-stats">
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">Durée</span>
                  <span class="comp__col-stat-value" x-text="formatDuration(session1.duration)"></span>
                </div>
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">Volume</span>
                  <span class="comp__col-stat-value" x-text="formatVolume(totalVolume(session1))"></span>
                </div>
              </div>
            </header>

            <div class="comp__exercises">
              <template x-if="unionExercises.length === 0">
                <p class="comp__no-exercises">Aucun exercice enregistré.</p>
              </template>

              <template x-for="item in unionExercises" :key="item.exerciseId">
                <article
                  class="comp__exo"
                  :class="{ 'comp__exo--missing': !item.session1Ex }"
                >
                  <header class="comp__exo-head">
                    <div class="comp__exo-id">
                      <h4 class="comp__exo-name" x-text="item.name"></h4>
                      <span class="comp__exo-muscle" x-text="item.muscle"></span>
                    </div>
                    <div class="comp__exo-volume" x-show="item.session1Ex">
                      <span class="comp__exo-volume-label">Volume</span>
                      <span
                        class="comp__exo-volume-value"
                        x-text="formatVolume(exerciseVolume(item.session1Ex))"
                      ></span>
                    </div>
                    <div class="comp__exo-missing" x-show="!item.session1Ex">
                      <span>Non réalisée</span>
                    </div>
                  </header>

                  <div class="comp__exo-table" x-show="item.session1Ex">
                    <div class="comp__exo-thead">
                      <div class="comp__exo-th comp__exo-th--num">#</div>
                      <div class="comp__exo-th comp__exo-th--type">Type</div>
                      <div class="comp__exo-th comp__exo-th--num">Poids</div>
                      <div class="comp__exo-th comp__exo-th--num">Reps</div>
                      <div class="comp__exo-th comp__exo-th--num comp__exo-th--end">Volume</div>
                    </div>
                    <template x-for="set in item.session1Ex.sets" :key="set.setNumber">
                      <div
                        class="comp__exo-row"
                        :class="{ 'is-completed': set.completed }"
                      >
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.setNumber"></div>
                        <div class="comp__exo-cell comp__exo-cell--type">
                          <span
                            class="comp__type-pill"
                            :class="'comp__type-pill--' + set.type"
                            x-text="typeLabel(set.type)"
                          ></span>
                        </div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="formatWeight(set.weight)"></div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.reps"></div>
                        <div class="comp__exo-cell comp__exo-cell--num comp__exo-cell--end" x-text="formatVolume(set.weight * set.reps)"></div>
                      </div>
                    </template>
                  </div>
                </article>
              </template>
            </div>
          </section>

          {/* Session 2 column */}
          <section class="comp__col" aria-label="Détails de la séance 2">
            <header class="comp__col-head">
              <span class="comp__col-tag comp__col-tag--alt">Séance 2</span>
              <h3 class="comp__col-name" x-text="session2.name"></h3>
              <div class="comp__col-meta">
                <span
                  class="comp__status"
                  :class="'comp__status--' + session2.status"
                  x-text="statusLabel(session2.status)"
                ></span>
                <span class="comp__col-date" x-text="formatDate(session2.date)"></span>
              </div>
              <div class="comp__col-stats">
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">Durée</span>
                  <span class="comp__col-stat-value" x-text="formatDuration(session2.duration)"></span>
                </div>
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">Volume</span>
                  <span class="comp__col-stat-value" x-text="formatVolume(totalVolume(session2))"></span>
                </div>
              </div>
            </header>

            <div class="comp__exercises">
              <template x-if="unionExercises.length === 0">
                <p class="comp__no-exercises">Aucun exercice enregistré.</p>
              </template>

              <template x-for="item in unionExercises" :key="item.exerciseId + '-s2'">
                <article
                  class="comp__exo"
                  :class="{ 'comp__exo--missing': !item.session2Ex }"
                >
                  <header class="comp__exo-head">
                    <div class="comp__exo-id">
                      <h4 class="comp__exo-name" x-text="item.name"></h4>
                      <span class="comp__exo-muscle" x-text="item.muscle"></span>
                    </div>
                    <div class="comp__exo-volume" x-show="item.session2Ex">
                      <span class="comp__exo-volume-label">Volume</span>
                      <span
                        class="comp__exo-volume-value"
                        x-text="formatVolume(exerciseVolume(item.session2Ex))"
                      ></span>
                    </div>
                    <div class="comp__exo-missing" x-show="!item.session2Ex">
                      <span>Non réalisée</span>
                    </div>
                  </header>

                  <div class="comp__exo-table" x-show="item.session2Ex">
                    <div class="comp__exo-thead">
                      <div class="comp__exo-th comp__exo-th--num">#</div>
                      <div class="comp__exo-th comp__exo-th--type">Type</div>
                      <div class="comp__exo-th comp__exo-th--num">Poids</div>
                      <div class="comp__exo-th comp__exo-th--num">Reps</div>
                      <div class="comp__exo-th comp__exo-th--num comp__exo-th--end">Volume</div>
                    </div>
                    <template x-for="set in item.session2Ex.sets" :key="set.setNumber">
                      <div
                        class="comp__exo-row"
                        :class="{ 'is-completed': set.completed }"
                      >
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.setNumber"></div>
                        <div class="comp__exo-cell comp__exo-cell--type">
                          <span
                            class="comp__type-pill"
                            :class="'comp__type-pill--' + set.type"
                            x-text="typeLabel(set.type)"
                          ></span>
                        </div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="formatWeight(set.weight)"></div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.reps"></div>
                        <div class="comp__exo-cell comp__exo-cell--num comp__exo-cell--end" x-text="formatVolume(set.weight * set.reps)"></div>
                      </div>
                    </template>
                  </div>
                </article>
              </template>
            </div>
          </section>
        </div>
      </div>
