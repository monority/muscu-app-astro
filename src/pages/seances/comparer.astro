---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Badge from '../../components/ui/Badge.astro';
import { icons } from '../../lib/icons';
import BackLink from '../../components/ui/BackLink.astro';
const L = t();
---

<AppLayout title={L.comparer.title}>
  <div
    class="comp"
    x-data="comparisonApp()"
    x-init="init()"
    x-cloak
  >
    <PageHeader
      title={L.comparer.title}
      description={L.comparer.description}
    />

    <BackLink href={localizedPath("/seances")} label={L.comparer.back} />

    {/* ═══════════════════════════════════════════════════
        SESSION PICKERS
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <Card>
      <CardHeader>
        <CardTitle>{L.comparer.selection}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="comp__pickers">
          <div class="comp__picker">
            <label for="comp-s1" class="comp__picker-label">{L.comparer.session1Ref}</label>
            <div class="comp__picker-field">
              <Fragment set:html={icons.dumbbellBox(18, 18)} />
              <select
                class="comp__select"
                x-model="session1Id"
                @change="onSession1Change($event.target.value)"
                :aria-label="'{L.comparer.pickFirst}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session2Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>

          <div class="comp__vs" aria-hidden="true">
            <span class="comp__vs-text">{L.comparer.vs}</span>
          </div>

          <div class="comp__picker">
            <label for="comp-s2" class="comp__picker-label">{L.comparer.session2}</label>
            <div class="comp__picker-field">
              <Fragment set:html={icons.dumbbellBox(18, 18)} />
              <select
                id="comp-s2"
                class="comp__select"
                x-model="session2Id"
                @change="onSession2Change($event.target.value)"
                :aria-label="'{L.comparer.pickSecond}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session1Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        HINT â€” show "select both" message
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="allSessions.length < 2">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <Fragment set:html={icons.infoCircle(18, 18)} />
          </div>
          <p>
            {L.comparer.needTwo}
            <a href={localizedPath("/seances/creer")} class="comp__hint-link">{L.comparer.createSession}</a>
          </p>
        </div>
      </Card>
    </template>

    <template x-if="allSessions.length >= 2 && (!session1 || !session2)">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <Fragment set:html={icons.trendingUpLine(18, 18)} />
          </div>
          <p>{L.comparer.selectBoth}</p>
        </div>
      </Card>
    </template>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        COMPARISON COLUMNS
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="session1 && session2">
      <div class="comp__content">
        {/* â”€â”€ Summary deltas at the top â”€â”€ */}
        <div class="comp__summary">
          <h2 class="comp__section-title">{L.comparer.summaryTitle}</h2>
          <div class="comp__summary-grid">
            {/* Volume delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <Fragment set:html={icons.volumeBox(20, 20)} />
                <span class="comp__summary-label">{L.comparer.volume}</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session1Ref}</div>
                  <div class="comp__summary-value" x-text="formatVolume(totalVolume(session1))"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + volumeDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="volumeDelta.direction === 'up'">
                      <span style="transform:rotate(180deg);display:inline-flex"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="volumeDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="volumeDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="volumeDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session2}</div>
                  <div class="comp__summary-value" x-text="formatVolume(totalVolume(session2))"></div>
                </div>
              </div>
            </article>

            {/* Exercises delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <Fragment set:html={icons.list(20, 20)} />
                <span class="comp__summary-label">{L.comparer.exercises}</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session1Ref}</div>
                  <div class="comp__summary-value" x-text="session1.exercises.length"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + exercisesDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="exercisesDelta.direction === 'up'">
                      <span style="transform:rotate(180deg);display:inline-flex"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="exercisesDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="exercisesDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="exercisesDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session2}</div>
                  <div class="comp__summary-value" x-text="session2.exercises.length"></div>
                </div>
              </div>
            </article>

            {/* Sets delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <Fragment set:html={icons.list(20, 20)} />
                <span class="comp__summary-label">{L.comparer.sets}</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session1Ref}</div>
                  <div class="comp__summary-value" x-text="totalSets(session1)"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + setsDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="setsDelta.direction === 'up'">
                      <span style="transform:rotate(180deg);display:inline-flex"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="setsDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="setsDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="setsDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session2}</div>
                  <div class="comp__summary-value" x-text="totalSets(session2)"></div>
                </div>
              </div>
            </article>

            {/* Best 1RM delta */}
            <article class="comp__summary-card">
              <div class="comp__summary-head">
                <Fragment set:html={icons.dumbbell(20, 20)} />
                <span class="comp__summary-label">{L.comparer.best1RM}</span>
              </div>
              <div class="comp__summary-body">
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session1Ref}</div>
                  <div class="comp__summary-value" x-text="formatVolume(bestSet(session1))"></div>
                </div>
                <div
                  class="comp__summary-delta"
                  :class="'comp__summary-delta--' + bestSetDelta.direction"
                >
                  <span class="comp__summary-delta-icon" aria-hidden="true">
                    <template x-if="bestSetDelta.direction === 'up'">
                      <span style="transform:rotate(180deg);display:inline-flex"><Fragment set:html={icons.arrowDown(18, 18)} /></span>
                    </template>
                    <template x-if="bestSetDelta.direction === 'down'">
                      <Fragment set:html={icons.arrowDown(18, 18)} />
                    </template>
                    <template x-if="bestSetDelta.direction === 'equal'">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </template>
                  </span>
                  <span class="comp__summary-delta-text" x-text="bestSetDelta.label"></span>
                </div>
                <div class="comp__summary-side">
                  <div class="comp__summary-sublabel">{L.comparer.session2}</div>
                  <div class="comp__summary-value" x-text="formatVolume(bestSet(session2))"></div>
                </div>
              </div>
            </article>
          </div>
        </div>

        {/* â”€â”€ Per-session columns â”€â”€ */}
        <div class="comp__columns">
          {/* Session 1 column */}
          <section class="comp__col" aria-label={L.comparer.detailsAria1}>
            <header class="comp__col-head">
              <span class="comp__col-tag">{L.comparer.session1Ref}</span>
              <h3 class="comp__col-name" x-text="session1.name"></h3>
              <div class="comp__col-meta">
                <span
                  class="comp__status"
                  :class="'comp__status--' + session1.status"
                  x-text="statusLabel(session1.status)"
                ></span>
                <span class="comp__col-date" x-text="formatDate(session1.date)"></span>
              </div>
              <div class="comp__col-stats">
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">{L.comparer.duration}</span>
                  <span class="comp__col-stat-value" x-text="formatDuration(session1.duration)"></span>
                </div>
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">{L.sessions.volume}</span>
                  <span class="comp__col-stat-value" x-text="formatVolume(totalVolume(session1))"></span>
                </div>
              </div>
            </header>

            <div class="comp__exercises">
              <template x-if="unionExercises.length === 0">
                <p class="comp__no-exercises">{L.comparer.noExercises}</p>
              </template>

              <template x-for="item in unionExercises" :key="item.exerciseId">
                <article
                  class="comp__exo"
                  :class="{ 'comp__exo--missing': !item.session1Ex }"
                >
                  <header class="comp__exo-head">
                    <div class="comp__exo-id">
                      <h4 class="comp__exo-name" x-text="trExercise(item.name)"></h4>
                      <Badge
                        variant="category"
                        size="sm"
                        :class="'badge--cat-' + muscleHue(item.muscle)"
                        class="self-start"
                        x-text="trMuscle(item.muscle)"
                      ></Badge>
                    </div>
                    <div class="comp__exo-volume" x-show="item.session1Ex">
                      <span class="comp__exo-volume-label">{L.sessions.volume}</span>
                      <span
                        class="comp__exo-volume-value"
                        x-text="formatVolume(exerciseVolume(item.session1Ex))"
                      ></span>
                    </div>
                    <div class="comp__exo-missing" x-show="!item.session1Ex">
                      <span>{L.comparer.notPerformed}</span>
                    </div>
                  </header>

                  <div class="comp__exo-table" x-show="item.session1Ex">
                    <div class="comp__exo-thead">
                      <div class="comp__exo-th comp__exo-th--num">#</div>
                      <div class="comp__exo-th comp__exo-th--type">{L.builder.type}</div>
                      <div class="comp__exo-th comp__exo-th--num">{L.common.weight}</div>
                      <div class="comp__exo-th comp__exo-th--num">{L.common.reps}</div>
                      <div class="comp__exo-th comp__exo-th--num comp__exo-th--end">{L.sessions.volume}</div>
                    </div>
                    <template x-for="set in (item.session1Ex ? item.session1Ex.sets : [])" :key="set.setNumber">
                      <div
                        class="comp__exo-row"
                        :class="{ 'is-completed': set.completed }"
                      >
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.setNumber"></div>
                        <div class="comp__exo-cell comp__exo-cell--type">
                          <span
                            class="type-pill"
                            :class="'type-pill--' + set.type"
                            x-text="typeLabel(set.type)"
                          ></span>
                        </div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="formatWeight(set.weight)"></div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.reps"></div>
                        <div class="comp__exo-cell comp__exo-cell--num comp__exo-cell--end" x-text="formatVolume(set.weight * set.reps)"></div>
                      </div>
                    </template>
                  </div>
                </article>
              </template>
            </div>
          </section>

          {/* Session 2 column */}
          <section class="comp__col" aria-label={L.comparer.detailsAria2}>
            <header class="comp__col-head">
              <span class="comp__col-tag comp__col-tag--alt">{L.comparer.session2}</span>
              <h3 class="comp__col-name" x-text="session2.name"></h3>
              <div class="comp__col-meta">
                <span
                  class="comp__status"
                  :class="'comp__status--' + session2.status"
                  x-text="statusLabel(session2.status)"
                ></span>
                <span class="comp__col-date" x-text="formatDate(session2.date)"></span>
              </div>
              <div class="comp__col-stats">
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">{L.comparer.duration}</span>
                  <span class="comp__col-stat-value" x-text="formatDuration(session2.duration)"></span>
                </div>
                <div class="comp__col-stat">
                  <span class="comp__col-stat-label">{L.sessions.volume}</span>
                  <span class="comp__col-stat-value" x-text="formatVolume(totalVolume(session2))"></span>
                </div>
              </div>
            </header>

            <div class="comp__exercises">
              <template x-if="unionExercises.length === 0">
                <p class="comp__no-exercises">{L.comparer.noExercises}</p>
              </template>

              <template x-for="item in unionExercises" :key="item.exerciseId + '-s2'">
                <article
                  class="comp__exo"
                  :class="{ 'comp__exo--missing': !item.session2Ex }"
                >
                  <header class="comp__exo-head">
                    <div class="comp__exo-id">
                      <h4 class="comp__exo-name" x-text="trExercise(item.name)"></h4>
                      <Badge
                        variant="category"
                        size="sm"
                        :class="'badge--cat-' + muscleHue(item.muscle)"
                        class="self-start"
                        x-text="trMuscle(item.muscle)"
                      ></Badge>
                    </div>
                    <div class="comp__exo-volume" x-show="item.session2Ex">
                      <span class="comp__exo-volume-label">{L.sessions.volume}</span>
                      <span
                        class="comp__exo-volume-value"
                        x-text="formatVolume(exerciseVolume(item.session2Ex))"
                      ></span>
                    </div>
                    <div class="comp__exo-missing" x-show="!item.session2Ex">
                      <span>{L.comparer.notPerformed}</span>
                    </div>
                  </header>

                  <div class="comp__exo-table" x-show="item.session2Ex">
                    <div class="comp__exo-thead">
                      <div class="comp__exo-th comp__exo-th--num">#</div>
                      <div class="comp__exo-th comp__exo-th--type">{L.builder.type}</div>
                      <div class="comp__exo-th comp__exo-th--num">{L.common.weight}</div>
                      <div class="comp__exo-th comp__exo-th--num">{L.common.reps}</div>
                      <div class="comp__exo-th comp__exo-th--num comp__exo-th--end">{L.sessions.volume}</div>
                    </div>
                    <template x-for="set in (item.session2Ex ? item.session2Ex.sets : [])" :key="set.setNumber">
                      <div
                        class="comp__exo-row"
                        :class="{ 'is-completed': set.completed }"
                      >
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.setNumber"></div>
                        <div class="comp__exo-cell comp__exo-cell--type">
                          <span
                            class="type-pill"
                            :class="'type-pill--' + set.type"
                            x-text="typeLabel(set.type)"
                          ></span>
                        </div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="formatWeight(set.weight)"></div>
                        <div class="comp__exo-cell comp__exo-cell--num" x-text="set.reps"></div>
                        <div class="comp__exo-cell comp__exo-cell--num comp__exo-cell--end" x-text="formatVolume(set.weight * set.reps)"></div>
                      </div>
                    </template>
                  </div>
                </article>
              </template>
            </div>
          </section>
        </div>
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type Session,
    type SessionExercise,
    type SessionStatus,
    type SetType,
    } from '../../lib/storage';
  import { t, getLocale } from '../../i18n';

  const LABELS = t();

  // â”€â”€ Pure helpers (module scope) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function statusLabelFn(s: SessionStatus): string {
    if (s === 'completed') return LABELS.comparer.completed;
    if (s === 'in-progress') return LABELS.comparer.inProgress;
    return LABELS.comparer.planned;
  }

  function typeLabelFn(t: SetType): string {
    switch (t) {
      case 'warmup': return LABELS.rapide.typeWarmup;
      case 'work':   return LABELS.rapide.typeWork;
      case 'top':    return LABELS.rapide.typeTop;
      case 'drop':   return LABELS.rapide.typeDrop;
      case 'failure': return LABELS.rapide.typeFailure;
    }
  }

  function formatDateFn(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const date = d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
    const time = d.toLocaleTimeString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      hour: '2-digit',
      minute: '2-digit',
    });
    return date + ' Â· ' + time;
  }

  function formatDurationFn(seconds?: number): string {
    if (!seconds || seconds <= 0) return 'â€”';
    const total = Math.floor(seconds);
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    if (h > 0) return `${h}h ${m.toString().padStart(2, '0')}m`;
    if (m > 0) return `${m}m ${s.toString().padStart(2, '0')}s`;
    return `${s}s`;
  }

  function formatVolumeFn(v: number): string {
    if (!Number.isFinite(v) || v <= 0) return '0 kg';
    return Math.round(v).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US') + ' kg';
  }

  function formatWeightFn(w: number): string {
    if (!Number.isFinite(w) || w <= 0) return '0 kg';
    return Math.round(w).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US') + ' kg';
  }

  function exerciseVolumeFn(ex: SessionExercise | undefined): number {
    if (!ex) return 0;
    return ex.sets.reduce(
      (s, set) => s + (set.completed ? set.weight * set.reps : 0),
      0,
    );
  }

  function totalSetsFn(session: Session | null): number {
    if (!session) return 0;
    return session.exercises.reduce((sum, ex) => sum + ex.sets.length, 0);
  }

  function bestSetFn(session: Session | null): number {
    if (!session) return 0;
    let best = 0;
    for (const ex of session.exercises) {
      for (const set of ex.sets) {
        if (!set.completed) continue;
        const e = calculate1RM(set.weight, set.reps);
        if (e > best) best = e;
      }
    }
    return best;
  }

  // â”€â”€ Delta computation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Direction is from session2's perspective: "up" if session2 > session1.
  type Direction = 'up' | 'down' | 'equal';
  function deltaFn(
    a: number,
    b: number,
    upLabel: string,
    downLabel: string,
    equalLabel: string,
    formatter: (n: number) => string,
  ): { direction: Direction; label: string; diff: number } {
    if (a === b) {
      return { direction: 'equal', label: equalLabel, diff: 0 };
    }
    if (b > a) {
      return {
        direction: 'up',
        label: upLabel + ' (+' + formatter(b - a) + ')',
        diff: b - a,
      };
    }
    return {
      direction: 'down',
      label: downLabel + ' (âˆ’' + formatter(a - b) + ')',
      diff: a - b,
    };
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('comparisonApp', () => ({
      // â”€â”€ State â”€â”€
      allSessions: [] as Session[],
      session1Id: '' as string,
      session2Id: '' as string,
      session1: null as Session | null,
      session2: null as Session | null,

      // â”€â”€ Init â”€â”€
      init() {
        this.allSessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
        const params = new URLSearchParams(window.location.search);
        const id1 = params.get('id1');
        const id2 = params.get('id2');
        if (id1) {
          const found = this.allSessions.find((s) => s.id === id1);
          if (found) {
            this.session1Id = found.id;
            this.session1 = found;
          }
        }
        if (id2) {
          const found = this.allSessions.find((s) => s.id === id2);
          if (found) {
            this.session2Id = found.id;
            this.session2 = found;
          }
        }
      },

      // â”€â”€ Computed â”€â”€
      get unionExercises(): Array<{
        exerciseId: string;
        name: string;
        muscle: string;
        session1Ex: SessionExercise | undefined;
        session2Ex: SessionExercise | undefined;
      }> {
        if (!this.session1 && !this.session2) return [];
        const map = new Map<
          string,
          {
            exerciseId: string;
            name: string;
            muscle: string;
            session1Ex: SessionExercise | undefined;
            session2Ex: SessionExercise | undefined;
          }
        >();
        if (this.session1) {
          for (const ex of this.session1.exercises) {
            map.set(ex.exerciseId, {
              exerciseId: ex.exerciseId,
              name: ex.name,
              muscle: ex.muscle,
              session1Ex: ex,
              session2Ex: undefined,
            });
          }
        }
        if (this.session2) {
          for (const ex of this.session2.exercises) {
            const existing = map.get(ex.exerciseId);
            if (existing) {
              existing.session2Ex = ex;
            } else {
              map.set(ex.exerciseId, {
                exerciseId: ex.exerciseId,
                name: ex.name,
                muscle: ex.muscle,
                session1Ex: undefined,
                session2Ex: ex,
              });
            }
          }
        }
        return Array.from(map.values());
      },

      get volumeDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€”', diff: 0 };
        }
        return deltaFn(
          this.totalVolume(this.session1),
          this.totalVolume(this.session2),
          LABELS.comparer.volumeMore,
          LABELS.comparer.volumeLess,
          LABELS.comparer.volumeEqual,
          formatVolumeFn,
        );
      },

      get exercisesDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€”', diff: 0 };
        }
        return deltaFn(
          this.session1.exercises.length,
          this.session2.exercises.length,
          LABELS.comparer.exercisesMore,
          LABELS.comparer.exercisesLess,
          LABELS.comparer.exercisesEqual,
          (n) => Math.round(n).toString(),
        );
      },

      get setsDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€”', diff: 0 };
        }
        return deltaFn(
          this.totalSets(this.session1),
          this.totalSets(this.session2),
          LABELS.comparer.setsMore,
          LABELS.comparer.setsLess,
          LABELS.comparer.setsEqual,
          (n) => Math.round(n).toString(),
        );
      },

      get bestSetDelta() {
        if (!this.session1 || !this.session2) {
          return { direction: 'equal' as Direction, label: 'â€”', diff: 0 };
        }
        return deltaFn(
          this.bestSet(this.session1),
          this.bestSet(this.session2),
          LABELS.comparer.best1RM,
          LABELS.comparer.best1RMLower,
          LABELS.comparer.best1RMSame,
          formatVolumeFn,
        );
      },

      // â”€â”€ Helpers â”€â”€
      formatOption(s: Session) {
        const date = formatDateFn(s.date);
        return s.name + ' â€” ' + date;
      },

      statusLabel(s: SessionStatus) {
        return statusLabelFn(s);
      },

      typeLabel(t: SetType) {
        return typeLabelFn(t);
      },

      formatDate(iso: string) {
        return formatDateFn(iso);
      },

      formatDuration(seconds?: number) {
        return formatDurationFn(seconds);
      },

      formatVolume(v: number) {
        return formatVolumeFn(v);
      },

      formatWeight(w: number) {
        return formatWeightFn(w);
      },

      totalVolume(session: Session | null): number {
        if (!session) return 0;
        return session.exercises.reduce(
          (sum, ex) => sum + exerciseVolumeFn(ex),
          0,
        );
      },

      exerciseVolume(ex: SessionExercise | undefined): number {
        return exerciseVolumeFn(ex);
      },

      totalSets(session: Session | null): number {
        return totalSetsFn(session);
      },

      bestSet(session: Session | null): number {
        return bestSetFn(session);
      },

      // â”€â”€ Actions â”€â”€
      onSession1Change(id: string) {
        this.session1 = id ? this.allSessions.find((s) => s.id === id) || null : null;
        this.syncUrl();
      },

      onSession2Change(id: string) {
        this.session2 = id ? this.allSessions.find((s) => s.id === id) || null : null;
        this.syncUrl();
      },

      syncUrl() {
        if (typeof window === 'undefined') return;
        const params = new URLSearchParams();
        if (this.session1Id) params.set('id1', this.session1Id);
        if (this.session2Id) params.set('id2', this.session2Id);
        const qs = params.toString();
        const newUrl = qs
          ? window.location.pathname + '?' + qs
          : window.location.pathname;
        window.history.replaceState({}, '', newUrl);
      },
    }));
  });
</script>


