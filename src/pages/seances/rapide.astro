---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.rapide.title}>
  {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
      QUICK SESSION MODE â€” full-screen, distraction-free gym UI.
      The `.qs` root uses position: fixed to overlay the
      sidebar + topbar so the user gets an unbroken dark canvas
      with nothing competing for their attention while lifting.
      â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
  <div
    class="qs"
    x-data="quickSessionApp()"
    x-init="init()"
    x-cloak
  >
    {/* â”€â”€ Top bar (always visible in working + resting) â”€â”€ */}
    <template x-if="state === 'working' || state === 'resting'">
      <header class="qs__topbar">
        <button
          type="button"
          class="qs__icon-btn"
          @click="stopSession()"
          aria-label={L.rapide.quitAria}
        >
          <Fragment set:html={icons.arrowLeft(24, 24)} />
        </button>

        <div class="qs__progress">
          <span class="qs__progress-text" aria-live="polite" aria-atomic="true">
            {L.rapide.setProgress} <strong x-text="currentSetIndex + 1"></strong>/<span x-text="currentExercise?.sets?.length || 0"></span>
            <span class="qs__progress-sep">Â·</span>
            {L.rapide.exerciseProgress} <strong x-text="currentExerciseIndex + 1"></strong>/<span x-text="totalExercises"></span>
          </span>
          <div class="qs__progress-bar" aria-hidden="true">
            <div
              class="qs__progress-fill"
              :style="`width: ${progressPercent}%`"
            ></div>
          </div>
        </div>

        <button
          type="button"
          class="qs__icon-btn"
          @click="confirmStop()"
          aria-label={L.rapide.finish}
          title={L.rapide.finish}
        >
          <Fragment set:html={icons.check(24, 24)} />
        </button>
      </header>
    </template>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        STATE 1 â€” Selecting a session
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="state === 'selecting'">
      <section class="qs__selecting">
        <div class="qs__selecting-inner">
          <div class="qs__selecting-icon" aria-hidden="true">
            <Fragment set:html={icons.zap(64, 64)} />
          </div>
          <h1 class="qs__selecting-title">{L.rapide.title}</h1>
          <p class="qs__selecting-text">
            {L.rapide.introText}
          </p>

          <div class="qs__field">
            <label class="qs__field-label" for="qs-session">{L.rapide.session}</label>
            <select
              id="qs-session"
              class="qs__select"
              x-model="selectedSessionId"
            >
              <option value="">{L.rapide.selectSession}</option>
              <template x-for="s in availableSessions" :key="s.id">
                <option
                  :value="s.id"
                  x-text="`${s.label} (${s.totalSets} ${setsShortLabel} Â· ${formatWeight(s.totalVolume)})`"
                ></option>
              </template>
            </select>
          </div>

          <div class="qs__selecting-actions">
            <Button variant="ghost" href={localizedPath("/seances")}>{L.common.back}</Button>
            <Button
              variant="primary"
              :disabled="!selectedSessionId"
              @click="startSession()"
            >
              {L.rapide.start}
            </Button>
          </div>

          <template x-if="availableSessions.length === 0">
            <p class="qs__empty">
              {L.rapide.emptyDesc}
              <a href={localizedPath("/seances/creer")}>{L.rapide.restart}</a>.
            </p>
          </template>
        </div>
      </section>
    </template>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        STATE 2 â€” Working (one set at a time)
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="state === 'working' && currentSet">
      <section
        class="qs__working"
        @touchstart="onTouchStart($event)"
        @touchend="onTouchEnd($event)"
      >
        <div class="qs__working-inner">
          <div class="qs__exercise-name" x-text="trExercise(currentExercise?.name)" aria-live="polite" aria-atomic="true"></div>
          <div class="qs__exercise-muscle" x-text="trMuscle(currentExercise?.muscle)"></div>

          <div class="qs__set-number" aria-live="polite" aria-atomic="true">
            {L.rapide.setProgress} <span x-text="currentSet.setNumber"></span>
            <span
              class="qs__set-type"
              :class="'qs__set-type--' + currentSet.type"
              x-text="typeLabel(currentSet.type)"
            ></span>
          </div>

          <div class="qs__load">
            <div class="qs__weight">
              <span class="qs__num" x-text="formatWeight(currentSet.weight)"></span>
              <span class="qs__unit" x-text="weightUnit()"></span>
            </div>
            <div class="qs__times" aria-hidden="true">Ã—</div>
            <div class="qs__reps">
              <span class="qs__num" x-text="currentSet.reps"></span>
              <span class="qs__unit">{L.rapide.repsUnit}</span>
            </div>
          </div>

          <button
            type="button"
            class="qs__done"
            @click="completeSet()"
            aria-label={L.rapide.completeSetAria}
          >
            <Fragment set:html={icons.check(36, 36)} />
            <span>{L.rapide.done}</span>
          </button>

          <Button
            variant="ghost"
            class="qs__undo-working"
            :disabled="!canUndo"
            @click="undoLastSet()"
          >
            <Fragment set:html={icons.undo(18, 18)} />
            <span>{L.rapide.undoLast}</span>
          </Button>

          <div class="qs__nav">
            <button
              type="button"
              class="qs__nav-btn"
              :disabled="!canGoPrev()"
              @click="prevSet()"
              aria-label={L.rapide.prevSetAria}
            >
              <Fragment set:html={icons.chevronLeft(20, 20)} />
              <span>{L.rapide.prev}</span>
            </button>
            <button
              type="button"
              class="qs__nav-btn"
              :disabled="!canGoNext()"
              @click="nextSet()"
              aria-label={L.rapide.nextSetAria}
            >
              <span>{L.rapide.next}</span>
              <Fragment set:html={icons.chevronRight(20, 20)} />
            </button>
          </div>
        </div>
      </section>
    </template>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        STATE 3 â€” Resting (big countdown)
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="state === 'resting'">
      <section class="qs__resting">
        <div class="qs__resting-inner">
          <div class="qs__resting-confirmation" role="status" aria-live="polite">
            {L.rapide.setRecorded}
          </div>
          <div class="qs__resting-label">{L.rapide.resting}</div>
          <div
            class="qs__resting-timer"
            role="timer"
            aria-live="polite"
            :class="{ 'qs__resting-timer--low': restRemaining <= 10 && restRemaining > 0 }"
            x-text="formatRestTime()"
          ></div>
          <div class="qs__resting-next" x-text="restNextLabel()" aria-live="polite" aria-atomic="true"></div>

          <div class="qs__resting-actions">
            <Button
              variant="ghost"
              @click="addRestTime(-15)"
              aria-label={L.rapide.restMinusAria}
            >
              −15s
            </Button>
            <Button
              variant="ghost"
              active={true}
              @click="skipRest()"
              aria-label={L.rapide.skipRest}
            >
              {L.common.skip}
            </Button>
            <Button
              variant="ghost"
              @click="addRestTime(15)"
              aria-label={L.rapide.restPlusAria}
            >
              +15s
            </Button>
            <Button
              variant="ghost"
              class="qs__undo"
              :disabled="!canUndo"
              @click="undoLastSet()"
            >
              {L.rapide.undoLast}
            </Button>
          </div>
        </div>
      </section>
    </template>

    {/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        STATE 4 â€” Completed (summary)
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */}
    <template x-if="state === 'completed'">
      <section class="qs__done-screen">
        <div class="qs__done-inner">
          <div
            class="qs__done-icon"
            :class="{ 'qs__done-icon--partial': recordedSets < totalSets }"
            aria-hidden="true"
          >
            <Fragment set:html={icons.checkCircle(80, 80)} />
          </div>
          <h1 class="qs__done-title" x-text="completionTitle"></h1>
          <p class="qs__done-name" x-text="session?.name"></p>
          <p class="qs__done-message" x-text="completionMessage" role="status"></p>

          <div class="qs__done-stats">
            <div class="qs__done-stat">
              <div class="qs__done-stat-value" x-text="`${recordedSets} / ${totalSets}`"></div>
              <div class="qs__done-stat-label">{L.rapide.setsDone}</div>
            </div>
            <div class="qs__done-stat">
              <div class="qs__done-stat-value" x-text="`${completedExercises} / ${totalExercises}`"></div>
              <div class="qs__done-stat-label">{L.rapide.exercises}</div>
            </div>
            <div class="qs__done-stat">
              <div class="qs__done-stat-value" x-text="formatDuration(sessionDuration)"></div>
              <div class="qs__done-stat-label">{L.rapide.duration}</div>
            </div>
            <div class="qs__done-stat">
              <div class="qs__done-stat-value" x-text="formatWeight(sessionTotalVolume)"></div>
              <div class="qs__done-stat-label">{L.rapide.volume}</div>
            </div>
          </div>

          <div class="qs__done-actions">
            <Button
              variant="primary"
              :href="detailHref(session?.id)"
            >
              {L.rapide.viewSession}
            </Button>
            <Button
              variant="ghost"
              :disabled="!canUndo"
              @click="undoLastSet()"
            >
              {L.rapide.undoLast}
            </Button>
            <Button
              variant="ghost"
              @click="reset()"
            >
              {L.rapide.chooseAnother}
            </Button>
          </div>
        </div>
      </section>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    updateSession,
    type Session,
    type SessionSet,
    type SetType,
    } from '../../lib/storage';
  import { t, localizedPath } from '../../i18n';
  import { undoLastCompletedSet } from '../../lib/session-utils';

  const LABELS = t();

  // â”€â”€ Pure helpers (module scope) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function typeLabelFn(t: SetType): string {
    switch (t) {
      case 'warmup': return LABELS.rapide.typeWarmup;
      case 'work':   return LABELS.rapide.typeWork;
      case 'top':    return LABELS.rapide.typeTop;
      case 'drop':   return LABELS.rapide.typeDrop;
      case 'failure': return LABELS.rapide.typeFailure;
      default:       return '';
    }
  }

  function formatWeightFn(w: number): string {
    if (!Number.isFinite(w) || w <= 0) return '0';
    // Show as integer when possible, otherwise with 1 decimal.
    const rounded = Math.round(w * 10) / 10;
    return Number.isInteger(rounded)
      ? String(rounded)
      : rounded.toFixed(1).replace(/\.0$/, '');
  }

  function todayISO(): string {
    return new Date().toISOString().split('T')[0];
  }

  function formatDurationFn(seconds?: number): string {
    if (!seconds || seconds <= 0 || !Number.isFinite(seconds)) return '0' + LABELS.rapide.minShort;
    const total = Math.floor(seconds);
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    if (h > 0) return `${h}${LABELS.rapide.hShort} ${m.toString().padStart(2, '0')}${LABELS.rapide.minShort}`;
    if (m > 0) return `${m}${LABELS.rapide.minShort} ${s.toString().padStart(2, '0')}${LABELS.rapide.sShort}`;
    return `${s}${LABELS.rapide.sShort}`;
  }

  // Standard rest period between work sets (seconds). Mirrors the
  // default setting of 90s in storage.ts.
  const DEFAULT_REST = 90;

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('quickSessionApp', () => ({
      // â”€â”€ State machine â”€â”€
      // 'selecting' | 'working' | 'resting' | 'completed'
      state: 'selecting' as 'selecting' | 'working' | 'resting' | 'completed',

      // â”€â”€ Data â”€â”€
      availableSessions: [] as Array<{
        id: string;
        label: string;
        totalSets: number;
        totalVolume: number;
      }>,
      selectedSessionId: '',
      session: null as Session | null,

      // â”€â”€ Workout progress â”€â”€
      currentExerciseIndex: 0,
      currentSetIndex: 0,
      completedSets: 0,
      startTime: 0,
      endTime: 0,

      // â”€â”€ Rest timer â”€â”€
      restRemaining: 0,
      restInterval: null as number | null,
      restPaused: false,

      // â”€â”€ Wake Lock â”€â”€
      wakeLock: null as any,

      // â”€â”€ Touch swipe â”€â”€
      _touchStartX: 0,
      _touchStartY: 0,

      // â”€â”€ Keyboard â”€â”€
      _keyHandler: null as ((e: KeyboardEvent) => void) | null,

      // â”€â”€ Init â”€â”€
      init() {
        this.loadSessions();
        const requestedSessionId = new URLSearchParams(window.location.search).get('session');
        if (requestedSessionId && this.availableSessions.some((s) => s.id === requestedSessionId)) {
          this.selectedSessionId = requestedSessionId;
        }
        this._installKeyboard();
        // Try to acquire the screen wake lock so the phone doesn't
        // dim during a set. Best-effort: silently no-op on browsers
        // that don't support it (or require HTTPS).
        this._requestWakeLock();
        // Re-acquire the wake lock if the tab becomes visible again
        // (browsers release it on visibility change).
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible' && this.state === 'working') {
            this._requestWakeLock();
          }
        });
      },

      destroy() {
        if (this.restInterval) {
          window.clearInterval(this.restInterval);
          this.restInterval = null;
        }
        if (this._keyHandler) {
          window.removeEventListener('keydown', this._keyHandler);
          this._keyHandler = null;
        }
        this._releaseWakeLock();
      },

      // â”€â”€ Sessions list â”€â”€
      loadSessions() {
        const all = getSessions();
        this.availableSessions = all
          // Hide sessions that have no sets at all â€” nothing to do.
          .filter((s) => s.exercises.some((e) => e.sets.length > 0))
          .map((s) => {
            const totalSets = s.exercises.reduce(
              (sum, ex) => sum + ex.sets.length,
              0,
            );
            const totalVolume = s.exercises.reduce(
              (sum, ex) =>
                sum +
                ex.sets.reduce(
                  (v, set) => v + set.weight * set.reps,
                  0,
                ),
              0,
            );
            return {
              id: s.id,
              label: s.name,
              totalSets,
              totalVolume,
            };
          })
          // Newest first â€” the user is more likely to want the
          // latest planned session than an old one.
          .sort((a, b) => (a.label < b.label ? 1 : -1));
      },

      // â”€â”€ Start the workout â”€â”€
      startSession() {
        if (!this.selectedSessionId) return;
        const found = getSessions().find(
          (s) => s.id === this.selectedSessionId,
        );
        if (!found) return;
        this.session = found;
        this.currentExerciseIndex = 0;
        this.currentSetIndex = 0;
        this.completedSets = 0;
        this.startTime = Date.now();
        this.endTime = 0;
        // A planned date is the scheduling date. Once the workout starts,
        // persist today's actual training date so progression, Records and
        // calendar all point to the session that was really performed.
        const actualDate = todayISO();
        this.session.date = actualDate;
        this.session.status = 'in-progress';
        updateSession(this.session.id, {
          date: actualDate,
          status: 'in-progress',
        });
        this.state = 'working';
      },

      // â”€â”€ Computed â”€â”€
      get currentExercise() {
        return this.session?.exercises[this.currentExerciseIndex] ?? null;
      },

      get currentSet(): SessionSet | null {
        const ex = this.currentExercise;
        if (!ex) return null;
        return ex.sets[this.currentSetIndex] ?? null;
      },

      get totalExercises(): number {
        return this.session?.exercises.length ?? 0;
      },

      get totalSets(): number {
        if (!this.session) return 0;
        return this.session.exercises.reduce(
          (sum, ex) => sum + ex.sets.length,
          0,
        );
      },

      get recordedSets(): number {
        if (!this.session) return 0;
        return this.session.exercises.reduce(
          (sum, ex) => sum + ex.sets.filter((set) => set.completed).length,
          0,
        );
      },

      get progressPercent(): number {
        const total = this.totalSets;
        if (total === 0) return 0;
        // Count completed sets across every exercise, not just
        // the current one â€” the bar represents the whole session.
        let done = 0;
        if (this.session) {
          for (let i = 0; i < this.session.exercises.length; i++) {
            const ex = this.session.exercises[i];
            if (i < this.currentExerciseIndex) {
              done += ex.sets.length;
            } else if (i === this.currentExerciseIndex) {
              done += this.currentSetIndex;
            } else {
              break;
            }
          }
        }
        return Math.min(100, Math.round((done / total) * 100));
      },

      get sessionTotalVolume(): number {
        if (!this.session) return 0;
        return this.session.exercises.reduce(
          (sum, ex) =>
            sum +
            ex.sets.reduce(
              (v, set) => (set.completed ? v + set.weight * set.reps : v),
              0,
            ),
          0,
        );
      },

      get sessionDuration(): number {
        if (!this.startTime) return 0;
        const end = this.endTime || Date.now();
        return Math.floor((end - this.startTime) / 1000);
      },

      get completedExercises(): number {
        if (!this.session) return 0;
        return this.session.exercises.filter(
          (ex) => ex.sets.length > 0 && ex.sets.every((set) => set.completed),
        ).length;
      },

      get completionTitle(): string {
        return this.recordedSets >= this.totalSets
          ? LABELS.rapide.allDone
          : LABELS.rapide.endedEarly;
      },

      get completionMessage(): string {
        if (this.recordedSets >= this.totalSets) {
          return LABELS.rapide.completionFull;
        }
        return `${LABELS.rapide.completionPartial} · ${this.recordedSets}/${this.totalSets} ${LABELS.rapide.setsShort}`;
      },

      // â”€â”€ Navigation â”€â”€
      canGoPrev(): boolean {
        // True when there is at least one set before the current
        // cursor in the global flat ordering.
        if (!this.session) return false;
        return this.currentExerciseIndex > 0 || this.currentSetIndex > 0;
      },

      canGoNext(): boolean {
        if (!this.session) return false;
        const ex = this.currentExercise;
        if (!ex) return false;
        return (
          this.currentSetIndex < ex.sets.length - 1 ||
          this.currentExerciseIndex < this.session.exercises.length - 1
        );
      },

      prevSet() {
        if (!this.canGoPrev()) return;
        if (this.currentSetIndex > 0) {
          this.currentSetIndex -= 1;
          return;
        }
        // Jump to the last set of the previous exercise.
        if (this.currentExerciseIndex > 0) {
          this.currentExerciseIndex -= 1;
          const ex = this.currentExercise;
          this.currentSetIndex = ex ? ex.sets.length - 1 : 0;
        }
      },

      nextSet() {
        if (!this.canGoNext()) return;
        const ex = this.currentExercise;
        if (!ex) return;
        if (this.currentSetIndex < ex.sets.length - 1) {
          this.currentSetIndex += 1;
          return;
        }
        // Move to the first set of the next exercise.
        if (this.currentExerciseIndex < this.session!.exercises.length - 1) {
          this.currentExerciseIndex += 1;
          this.currentSetIndex = 0;
        }
      },

      // â”€â”€ Set completion â”€â”€
      completeSet() {
        if (!this.session || !this.currentSet) return;
        const ex = this.currentExercise;
        if (!ex) return;
        const set = ex.sets[this.currentSetIndex];
        if (!set) return;
        set.completed = true;
        this.completedSets += 1;
        // Persist the updated set + session.
        updateSession(this.session.id, { exercises: this.session.exercises });

        // Determine what comes next: rest, or end.
        const isLastExercise =
          this.currentExerciseIndex === this.session.exercises.length - 1;
        const isLastSet =
          this.currentSetIndex === ex.sets.length - 1;
        if (isLastExercise && isLastSet) {
          this._finishSession();
        } else {
          // Move to the next set before starting the timer.
          this.nextSet();
          this._startRest();
        }
      },

      // â”€â”€ Undo â”€â”€
      get canUndo(): boolean {
        return this.completedSets > 0;
      },

      undoLastSet() {
        if (!this.session || !this.canUndo) return;
        const res = undoLastCompletedSet(this.session);
        if (!res) return;
        this.session.exercises = res.session.exercises;
        this.completedSets = Math.max(0, this.completedSets - 1);
        if (this.restInterval) {
          window.clearInterval(this.restInterval);
          this.restInterval = null;
        }
        this.restRemaining = 0;
        this.state = 'working';
        // Park the user on the set that was just un-completed.
        this.currentExerciseIndex = res.exerciseIndex;
        this.currentSetIndex = res.setIndex;
        // Re-open the session when the undo lands on a finished one.
        if (this.session.status === 'completed') {
          this.session.status = 'in-progress';
          updateSession(this.session.id, {
            status: 'in-progress',
            exercises: this.session.exercises,
          });
        } else {
          updateSession(this.session.id, { exercises: this.session.exercises });
        }
        this._requestWakeLock();
      },

      // â”€â”€ Rest timer â”€â”€
      _startRest() {
        this.restRemaining = DEFAULT_REST;
        this.restPaused = false;
        this.state = 'resting';
        if (this.restInterval) {
          window.clearInterval(this.restInterval);
        }
        this.restInterval = window.setInterval(() => {
          if (this.restPaused) return;
          if (this.restRemaining <= 0) {
            this._endRest();
            return;
          }
          this.restRemaining -= 1;
          if (this.restRemaining <= 0) {
            this._endRest();
          }
        }, 1000);
      },

      _endRest() {
        if (this.restInterval) {
          window.clearInterval(this.restInterval);
          this.restInterval = null;
        }
        this.restRemaining = 0;
        this.state = 'working';
      },

      skipRest() {
        this._endRest();
      },

      addRestTime(delta: number) {
        this.restRemaining = Math.max(0, this.restRemaining + delta);
      },

      // â”€â”€ Stop / finish â”€â”€
      stopSession() {
        // Soft exit: keep the session in 'in-progress' state so the
        // user can come back later. Releases the wake lock + timer.
        if (this.restInterval) {
          window.clearInterval(this.restInterval);
          this.restInterval = null;
        }
        this._releaseWakeLock();
        window.location.href = localizedPath('/seances');
      },

      confirmStop() {
        // Mark the session as completed even if the user quits
        // mid-workout. This is the fast path through the app.
        this._finishSession();
      },

      _finishSession() {
        if (!this.session) return;
        this.endTime = Date.now();
        this.session.status = 'completed';
        this.session.duration = this.sessionDuration;
        updateSession(this.session.id, {
          status: 'completed',
          duration: this.sessionDuration,
          exercises: this.session.exercises,
        });
        if (this.restInterval) {
          window.clearInterval(this.restInterval);
          this.restInterval = null;
        }
        this._releaseWakeLock();
        this.state = 'completed';
      },

      reset() {
        // Back to the selector state, ready for a new session.
        if (this.restInterval) {
          window.clearInterval(this.restInterval);
          this.restInterval = null;
        }
        this._releaseWakeLock();
        this.session = null;
        this.selectedSessionId = '';
        this.currentExerciseIndex = 0;
        this.currentSetIndex = 0;
        this.completedSets = 0;
        this.startTime = 0;
        this.endTime = 0;
        this.restRemaining = 0;
        this.loadSessions();
        this.state = 'selecting';
      },

      // â”€â”€ Touch gestures (swipe left = next, swipe right = prev) â”€â”€
      onTouchStart(e: TouchEvent) {
        const t = e.touches[0];
        if (!t) return;
        this._touchStartX = t.clientX;
        this._touchStartY = t.clientY;
      },

      onTouchEnd(e: TouchEvent) {
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - this._touchStartX;
        const dy = t.clientY - this._touchStartY;
        // Only treat as a swipe if horizontal motion is dominant
        // and exceeds the threshold (50px).
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
        if (dx < 0) {
          this.nextSet();
        } else {
          this.prevSet();
        }
      },

      // â”€â”€ Keyboard shortcuts â”€â”€
      _installKeyboard() {
        this._keyHandler = (e: KeyboardEvent) => {
          // Don't hijack typing in form fields.
          const target = e.target as HTMLElement | null;
          if (
            target &&
            (target.tagName === 'INPUT' ||
              target.tagName === 'TEXTAREA' ||
              target.tagName === 'SELECT')
          ) {
            return;
          }
          if (this.state === 'working') {
            if (e.key === ' ' || e.key === 'Enter') {
              e.preventDefault();
              this.completeSet();
            } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
              e.preventDefault();
              this.nextSet();
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
              e.preventDefault();
              this.prevSet();
            }
          } else if (this.state === 'resting') {
            if (e.key === ' ' || e.key === 'Enter') {
              e.preventDefault();
              this.skipRest();
            }
          } else if (this.state === 'selecting' || this.state === 'completed') {
            if (e.key === 'Escape') {
              if (this.state === 'completed') this.reset();
              else window.location.href = localizedPath('/seances');
            }
          }
        };
        window.addEventListener('keydown', this._keyHandler);
      },

      // â”€â”€ Wake Lock API (best effort) â”€â”€
      async _requestWakeLock(): Promise<void> {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const nav = navigator as any;
        if (!nav.wakeLock || typeof nav.wakeLock.request !== 'function') {
          return;
        }
        try {
          this.wakeLock = await nav.wakeLock.request('screen');
        } catch {
          // Permission denied, no user activation, or insecure
          // context. We just keep going without it.
        }
      },

      _releaseWakeLock() {
        try {
          if (this.wakeLock && typeof this.wakeLock.release === 'function') {
            this.wakeLock.release();
          }
        } catch {
          // ignore
        }
        this.wakeLock = null;
      },

      // â”€â”€ Formatters (re-export the pure helpers) â”€â”€
      setsShortLabel: LABELS.rapide.setsShort,
      typeLabel(t: SetType): string {
        return typeLabelFn(t);
      },
      formatWeight(w: number): string {
        return formatWeightFn(w);
      },
      formatDuration(s?: number): string {
        return formatDurationFn(s);
      },
      detailHref(id?: string): string {
        return localizedPath('/seances/detail?id=' + encodeURIComponent(id || ''));
      },
      weightUnit(): string {
        // Quick mode is short-lived; default to kg. Settings
        // lookup would be overkill for the gym context where
        // you want the screen to show the number, not the unit.
        return 'kg';
      },
      formatRestTime(): string {
        const s = this.restRemaining;
        const m = Math.floor(s / 60);
        const r = s % 60;
        return `${m}:${r.toString().padStart(2, '0')}`;
      },
      restNextLabel(): string {
        if (!this.currentExercise) return '';
        const set = this.currentSet;
        if (!set) return '';
        const weight = this.formatWeight(set.weight);
        const unit = this.weightUnit();
        return `${LABELS.rapide.nextUp} ${weight} ${unit} Ã— ${set.reps}`;
      },
    }));
  });
</script>


