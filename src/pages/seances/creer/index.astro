---
import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Badge from '../../../components/ui/Badge.astro';
import Dialog from '../../../components/ui/Dialog.astro';
import { TRAINING_TEMPLATES } from '../../../lib/templates';
import { t, setLocale, defaultLocale, localizedPath, trTemplateName, trTemplateDesc } from '../../../i18n';


setLocale(Astro.currentLocale ?? defaultLocale);

const L = t();
/**
 * Set types (mirrors SessionSet['type'] in src/lib/storage.ts).
 * Labels are localised to French for the in-row selector.
 */
const setTypes = [
  { value: 'warmup', label: L.builder.types.warmup },
  { value: 'work', label: L.builder.types.work },
  { value: 'top', label: L.builder.types.top },
  { value: 'drop', label: L.builder.types.drop },
  { value: 'failure', label: L.builder.types.failure },
] as const;
---

<AppLayout title={L.builder.title}>
  <div
    class="ses"
    x-data="sessionBuilder()"
    x-init="init()"
    x-cloak
  >
    <PageHeader
      title={L.builder.title}
      description={L.builder.description}
    />

    {/* ════════════════════════════════════════════════════
        ACTION BAR — Annuler / Enregistrer
        ════════════════════════════════════════════════════ */}
    <div class="ses__actions">
      <button
        type="button"
        class="ses__btn ses__btn--secondary"
        @click="discard()"
      >
        {L.common.cancel}
      </button>
      <button
        type="button"
        class="ses__btn ses__btn--primary"
        :disabled="!canSave"
        :class="{ 'is-disabled': !canSave }"
        @click="save()"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="ses__btn-icon"
          aria-hidden="true"
        >
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        <span x-text="labels.saveSession">{L.builder.saveSession}</span>
      </button>
    </div>

    {/* ════════════════════════════════════════════════════
        SESSION INFO CARD — name + date
        ════════════════════════════════════════════════════ */}
    <Card>
      <CardHeader>
        <CardTitle>Informations</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="ses__info-grid">
          <div class="ses__field">
            <label for="ses-name" class="ses__label">
              {L.builder.name}
              <span class="ses__req" aria-hidden="true">*</span>
            </label>
            <input
              id="ses-name"
              type="text"
              class="ses__input"
              placeholder="Ex. Push day, Jambes, Full body…"
              x-model="sessionName"
              required
              autocomplete="off"
              maxlength="80"
            />
          </div>

          <div class="ses__field">
            <label for="ses-date" class="ses__label">{L.builder.date}</label>
            <input
              id="ses-date"
              type="date"
              class="ses__input"
              x-model="sessionDate"
            />
          </div>
        </div>
      </CardContent>
    </Card>

    {/* ════════════════════════════════════════════════════
        EMPTY STATE — no exercises added yet
        ════════════════════════════════════════════════════ */}
    <template x-if="exercises.length === 0">
      <Card>
        <div class="ses__empty">
          <div class="ses__empty-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6.5 6.5h11v11h-11z"></path>
              <path d="M2 9v6"></path>
              <path d="M22 9v6"></path>
              <path d="M6.5 6.5L2 9"></path>
              <path d="M17.5 6.5L22 9"></path>
              <path d="M6.5 17.5L2 15"></path>
              <path d="M17.5 17.5L22 15"></path>
            </svg>
          </div>
          <h3 class="ses__empty-title" x-text="labels.noExoAdded">{L.builder.noExoAdded}</h3>
          <p class="ses__empty-desc" x-text="labels.noExoDesc">{L.builder.noExoDesc}</p>
          <button
            type="button"
            class="ses__add-btn ses__add-btn--primary"
            @click="openPicker()"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ses__add-icon"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>{L.builder.addExercise}</span>
          </button>
        </div>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        EXERCISE BLOCKS — one Card per added exercise
        Collapsible: header toggles a body that holds the sets table.
        ════════════════════════════════════════════════════ */}
    <template x-for="(ex, exIdx) in exercises" :key="ex.exerciseId + '-' + exIdx">
      <Card>
        <div
          class="ses__ex-superset-bar"
          x-show="ex.supersetId != null"
          x-cloak
          :class="'ses__ex-superset-bar--g' + ex.supersetId"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="ses__ex-superset-icon"
          >
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span x-text="labels.supersetLabel + ' ' + ex.supersetId">Superset <span x-text="ex.supersetId"></span></span>
          <button
            type="button"
            class="ses__ex-superset-remove"
            @click="removeFromSuperset(exIdx)"
            aria-label="Retirer du superset"
            title="Retirer du superset"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        {/* ── Clickable header (always visible) ── */}
        <div class="ses__ex-header">
          <button
            type="button"
            class="ses__ex-toggle"
            @click="toggleExpand(exIdx)"
            :aria-expanded="isExpanded(exIdx).toString()"
            :aria-controls="'ses-ex-body-' + exIdx"
          >
            <div class="ses__ex-toggle-main">
              <div class="ses__ex-head">
                <h3 class="ses__ex-name" x-text="trExercise(ex.name)"></h3>
                <Badge variant="accent" x-text="trMuscle(ex.muscle)"></Badge>
              </div>
              <p
                class="ses__ex-summary"
                x-show="!isExpanded(exIdx)"
                x-cloak
                x-text="exerciseSummary(ex)"
              ></p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ses__ex-chevron"
              :class="{ 'is-open': isExpanded(exIdx) }"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <select
            class="ses__ex-superset-select"
            x-model.number="ex.supersetId"
            @change="onSupersetChange(exIdx)"
            :aria-label="labels.supersetFor + ' ' + ex.name"
            title={L.builder.moveToSuperset}
          >
            <option :value="null">—</option>
            <template x-for="gId in availableSupersetIds()" :key="gId">
              <option :value="gId" x-text="labels.supersetLabel + ' ' + gId"></option>
            </template>
            <option :value="nextSupersetId()" x-text="labels.newSuperset">+ Nouveau superset</option>
          </select>
          <button
            type="button"
            class="ses__icon-btn ses__icon-btn--danger"
            @click="removeExercise(exIdx)"
            aria-label={L.builder.removeExerciseAria}
            title="Retirer l'exercice"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ses__icon"
              aria-hidden="true"
            >
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
              <path d="M10 11v6"></path>
              <path d="M14 11v6"></path>
            </svg>
          </button>
        </div>

        {/* ── Collapsible body (sets table + actions) ── */}
        <div
          :id="'ses-ex-body-' + exIdx"
          class="ses__ex-body"
          x-show="isExpanded(exIdx)"
          x-cloak
        >
          <CardContent>
            {/* ── Sets table ── */}
            <div class="ses__table" role="table" :aria-label="labels.setsFor + ' ' + ex.name">
              <div class="ses__table-head" role="row">
                <div class="ses__cell ses__cell--num" role="columnheader">#</div>
                <div class="ses__cell ses__cell--type" role="columnheader">Type</div>
                <div class="ses__cell ses__cell--num" role="columnheader">Poids (kg)</div>
                <div class="ses__cell ses__cell--num" role="columnheader">Reps</div>
                <div class="ses__cell ses__cell--rpe" role="columnheader">RPE</div>
                <div class="ses__cell ses__cell--action" role="columnheader" aria-label="Actions"></div>
              </div>
              <template x-for="(set, setIdx) in ex.sets" :key="setIdx">
                <div class="ses__table-row" role="row">
                  <div class="ses__cell ses__cell--num" role="cell" x-text="set.setNumber"></div>
                  <div class="ses__cell ses__cell--type" role="cell">
                    <select
                      class="ses__select ses__select--inline"
                      x-model="set.type"
                      :aria-label="labels.setTypeLabel + ' ' + (setIdx + 1)"
                    >
                      {setTypes.map((t) => (
                        <option value={t.value}>{t.label}</option>
                      ))}
                    </select>
                  </div>
                  <div class="ses__cell ses__cell--num" role="cell">
                    <input
                      type="number"
                      class="ses__input ses__input--inline no-spinner"
                      min="0"
                      step="0.5"
                      x-model.number="set.weight"
                      inputmode="decimal"
                      :aria-label="labels.weightForSet + ' ' + (setIdx + 1)"
                    />
                  </div>
                  <div class="ses__cell ses__cell--num" role="cell">
                    <input
                      type="number"
                      class="ses__input ses__input--inline no-spinner"
                      min="0"
                      step="1"
                      x-model.number="set.reps"
                      inputmode="numeric"
                      :aria-label="labels.repsForSet + ' ' + (setIdx + 1)"
                    />
                  </div>
                  {/* ── Per-set RPE / uRPE (added 2026-08-09) ──
                      Compact segmented RPE/uRPE toggle + 0.5-step select.
                      Shown once the set is marked complete; the value
                      persists on the set even if the set is later unmarked. */}
                  <div
                    class="ses__cell ses__cell--rpe"
                    role="cell"
                    x-show="set.completed"
                    x-cloak
                  >
                    <div class="ses__rpe-set">
                      <div
                        class="ses__rpe-toggle"
                        role="group"
                        :aria-label="labels.rpeTypeLabel + ' ' + (setIdx + 1)"
                      >
                        <button
                          type="button"
                          class="ses__rpe-toggle-btn"
                          :class="{ 'is-active': set.rpeType !== 'urpe' }"
                          @click="set.rpeType = 'rpe'"
                          :aria-pressed="set.rpeType !== 'urpe'"
                        >RPE</button>
                        <button
                          type="button"
                          class="ses__rpe-toggle-btn"
                          :class="{ 'is-active': set.rpeType === 'urpe' }"
                          @click="set.rpeType = 'urpe'"
                          :aria-pressed="set.rpeType === 'urpe'"
                        >uRPE</button>
                      </div>
                      <select
                        class="ses__select ses__select--inline ses__rpe-select"
                        x-model="set.rpe"
                        :aria-label="labels.rpeForSet + ' ' + (setIdx + 1)"
                      >
                        <option :value="null">—</option>
                        <template x-for="v in rpeValues" :key="v">
                          <option :value="v" x-text="v"></option>
                        </template>
                      </select>
                    </div>
                  </div>
                  <div class="ses__cell ses__cell--action" role="cell">
                    <button
                      type="button"
                      class="ses__set-complete"
                      :class="{ 'is-complete': set.completed }"
                      @click="toggleSetComplete(exIdx, setIdx)"
                      :aria-label="(set.completed ? labels.markUndone + ' ' + (setIdx + 1) : labels.markDone + ' ' + (setIdx + 1) + ' ' + labels.andStartRest)"
                      :aria-pressed="set.completed"
                      :title="set.completed ? labels.unmarkTitle : labels.markTitle"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="ses__icon-btn ses__icon-btn--danger ses__icon-btn--sm"
                      @click="removeSet(exIdx, setIdx)"
                      :aria-label="labels.deleteSet + ' ' + (setIdx + 1)"
                      title={L.builder.deleteSet}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="ses__icon"
                        aria-hidden="true"
                      >
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </button>
                  </div>
                </div>
              </template>
            </div>

            <div class="ses__ex-actions">
              <button
                type="button"
                class="ses__btn ses__btn--secondary ses__btn--sm"
                @click="addSet(exIdx)"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ses__btn-icon"
                  aria-hidden="true"
                >
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>{L.builder.addSet}</span>
              </button>
              <button
                type="button"
                class="ses__btn ses__btn--sm ses__btn--warmup"
                @click="generateWarmup(exIdx)"
                :disabled="!hasWorkingWeight(ex)"
                :class="{ 'is-disabled': !hasWorkingWeight(ex) }"
                :title="hasWorkingWeight(ex) ? labels.warmupTitle : labels.warmupHint"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ses__btn-icon"
                  aria-hidden="true"
                >
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                </svg>
                <span x-text="labels.warmupBtn">{L.builder.warmupBtn}</span>
              </button>
            </div>
          </CardContent>
        </div>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        ADD EXERCISE — bottom button (shown when ≥1 exercise)
        ════════════════════════════════════════════════════ */}
    <template x-if="exercises.length > 0">
      <div class="ses__add-row">
        <button
          type="button"
          class="ses__add-btn"
          @click="openPicker()"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ses__add-icon"
            aria-hidden="true"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>{L.builder.addExercise}</span>
        </button>
      </div>
    </template>

    {/* ════════════════════════════════════════════════════
        SESSION NOTES — RPE / fatigue / mood / free text
        ════════════════════════════════════════════════════ */}
    <template x-if="exercises.length > 0">
      <Card>
        <CardHeader>
          <CardTitle>{L.builder.notesTitle}</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="ses__notes">
            {/* ── RPE slider ── */}
            <div class="ses__notes-field">
              <div class="ses__notes-label-row">
                <label for="ses-rpe" class="ses__label">{L.builder.rpe}</label>
                <span
                  class="ses__rpe-value"
                  :class="'ses__rpe-value--' + rpeTone"
                  x-text="sessionRpe"
                ></span>
              </div>
              <div class="ses__rpe">
                <input
                  id="ses-rpe"
                  type="range"
                  min="1"
                  max="10"
                  step="1"
                  class="ses__rpe-input"
                  :class="'ses__rpe-input--' + rpeTone"
                  x-model.number="sessionRpe"
                  aria-label={L.builder.rpeAria}
                />
                <div class="ses__rpe-readout">
                  <span x-text="rpeLabel"></span>
                </div>
              </div>
            </div>

            {/* ── Fatigue (1–5) ── */}
            <div class="ses__notes-field">
              <label class="ses__label">Fatigue</label>
              <div class="ses__fatigue" role="radiogroup" aria-label="Niveau de fatigue">
                <template x-for="i in 5" :key="'fat-' + i">
                  <button
                    type="button"
                    class="ses__fatigue-btn"
                    :class="{ 'is-active': sessionFatigue >= i }"
                    :aria-pressed="sessionFatigue >= i"
                    :aria-label="labels.fatigueOn + ' ' + i + ' ' + labels.fatigueOutOf5"
                    @click="setFatigue(i)"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      height="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                    </svg>
                  </button>
                </template>
              </div>
            </div>

            {/* ── Mood ── */}
            <div class="ses__notes-field">
              <label class="ses__label">Humeur</label>
              <div class="ses__mood" role="radiogroup" aria-label={L.builder.moodAria}>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'great' }"
                  :aria-pressed="sessionMood === 'great'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodGreat"
                  @click="setMood('great')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'good' }"
                  :aria-pressed="sessionMood === 'good'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodGood"
                  @click="setMood('good')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'ok' }"
                  :aria-pressed="sessionMood === 'ok'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodOk"
                  @click="setMood('ok')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="8" y1="15" x2="16" y2="15"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'tired' }"
                  :aria-pressed="sessionMood === 'tired'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodTired"
                  @click="setMood('tired')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'bad' }"
                  :aria-pressed="sessionMood === 'bad'"
                  :aria-label="labels.moodLabel + ' : ' + labels.moodBad"
                  @click="setMood('bad')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
                </button>
              </div>
            </div>

            {/* ── Free-text notes ── */}
            <div class="ses__notes-field">
              <label for="ses-notes" class="ses__label">Notes</label>
              <textarea
                id="ses-notes"
                class="ses__notes-textarea"
                x-model="sessionNotes"
                placeholder={L.builder.notesPlaceholder}
                rows="3"
                maxlength="500"
              ></textarea>
            </div>
          </div>
        </CardContent>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        VALIDATION HINT — context-aware error message
        ════════════════════════════════════════════════════ */}
    <div
      class="ses__hint"
      x-show="!canSave && (sessionName.trim() || exercises.length > 0)"
      x-cloak
    >
      <template x-if="!sessionName.trim()">
        <span x-text="labels.needName">{L.builder.needName}</span>
      </template>
      <template x-if="sessionName.trim() && exercises.length === 0">
        <span x-text="labels.needExo">{L.builder.needExo}</span>
      </template>
    </div>

    {/* ════════════════════════════════════════════════════
        EXERCISE PICKER DIALOG
        ════════════════════════════════════════════════════ */}
    <Dialog id="ses-picker-dialog" title="Choisir un exercice">
      <div class="ses__picker">
        <div class="ses__search">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ses__search-icon"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            class="ses__search-input"
            placeholder="Rechercher un exercice…"
            x-model="exerciseSearch"
            aria-label="Rechercher un exercice"
            x-ref="pickerSearch"
            @keydown.escape="closeDialogById('ses-picker-dialog')"
            autocomplete="off"
          />
        </div>

        {/* ── Templates (added 2026-08-04) ── */}
        <div class="ses__templates" x-show="exerciseSearch.trim() === ''">
          <div class="ses__templates-head">
            <span class="ses__templates-eyebrow">Templates</span>
            <span class="ses__templates-hint">{L.builder.templateHint}</span>
          </div>
          <div class="ses__templates-grid">
            {TRAINING_TEMPLATES.map((tpl) => (
              <button
                type="button"
                class="ses__template"
                @click={`loadTemplate('${tpl.id}')`}
              >
                <span class="ses__template-name">{trTemplateName(tpl.name)}</span>
                <span class="ses__template-desc">{trTemplateDesc(tpl.id)}</span>
                <span class="ses__template-count">{tpl.exercises.length} {L.builder.exercisesWord}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="ses__picker-list" role="list">
          {/* ── Library empty ── */}
          <template x-if="availableExercises.length === 0">
            <div class="ses__picker-empty">
              <p x-text="labels.emptyLibrary">{L.builder.emptyLibrary}</p>
              <a href={localizedPath("/exercices")} class="ses__picker-link" x-text="labels.createExoLink">
                {L.builder.createExoLink}
              </a>
            </div>
          </template>

          {/* ── All exercises already added ── */}
          <template x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() === ''">
            <div class="ses__picker-empty">
              <p x-text="labels.allAdded">{L.builder.allAdded}</p>
            </div>
          </template>

          {/* ── No match for search ── */}
          <template x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() !== ''">
            <div class="ses__picker-empty">
              <p x-text="labels.noSearchMatch">{L.builder.noSearchMatch}</p>
            </div>
          </template>

          {/* ── Picker items ── */}
          <template x-for="ex in filteredExercises" :key="ex.id">
            <div
              class="ses__picker-item"
              role="listitem"
            >
              <button
                type="button"
                class="ses__picker-item-main"
                @click="addExercise(ex)"
                :aria-label="labels.addExoAria + ' ' + ex.name + ' ' + labels.toSession"
              >
                <span class="ses__picker-name" x-text="trExercise(ex.name)"></span>
                <span class="ses__picker-muscle" x-text="trMuscle(ex.muscle)"></span>
              </button>
              <button
                type="button"
                class="ses__picker-tip-toggle"
                @click="toggleTip(ex.id)"
                :aria-expanded="isTipOpen(ex.id).toString()"
                :aria-label="labels.showTipAria + ' ' + ex.name"
                title="Conseils"
                x-show="hasTip(ex.name)"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </button>
              <p
                class="ses__picker-tip"
                x-show="isTipOpen(ex.id) && hasTip(ex.name)"
                x-cloak
              >
                <span x-text="getTip(ex.name)"></span>
                <a
                  class="ses__tip-video"
                  :href="getVideoUrl(ex.name)"
                  target="_blank"
                  rel="noopener noreferrer"
                  :aria-label="labels.videoAria + ' ' + ex.name + ' ' + labels.onYoutube"
                  title="Voir la technique sur YouTube"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polygon points="6 4 20 12 6 20 6 4"></polygon>
                  </svg>
                  <span x-text="labels.seeTechnique">Voir la technique</span>
                </a>
              </p>
            </div>
          </template>
        </div>
      </div>

      <div slot="footer">
        <button
          type="button"
          class="ses__btn ses__btn--secondary"
          data-dialog-close
        >
          Fermer
        </button>
      </div>
    </Dialog>

    {/* ════════════════════════════════════════════════════
        REST TIMER WIDGET (added 2026-08-04)
        Sticky bar that appears when the user marks a set as
        complete. The duration is sourced per-exercise from
        `getRestTime(name)` so each lift gets a tailored rest
        (compound lifts rest longer, isolation work rests
        shorter). The label shows "Repos — <name> (M:SS)" and
        the countdown ticks down every second; a Skip button
        dismisses the widget before the timer elapses.
        ════════════════════════════════════════════════════ */}
    <div
      class="ses__rest-timer"
      x-show="restTimer.active"
      x-cloak
      x-transition.opacity.duration.180ms
      role="status"
      aria-live="polite"
    >
      <div class="ses__rest-timer-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="ses__rest-timer-body">
        <div class="ses__rest-timer-label" x-text="restTimerLabel()"></div>
        <div
          class="ses__rest-timer-readout"
          :class="{ 'is-done': restTimerDone }"
          x-text="restTimerDisplay()"
        ></div>
      </div>
      <button
        type="button"
        class="ses__rest-timer-skip"
        @click="dismissRestTimer()"
        :aria-label="restTimerDone ? labels.closeRest : labels.skipRest"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span x-text="restTimerDone ? labels.close : labels.skip"></span>
      </button>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getExercises,
    saveExercise,
    saveSession,
    RPE_OPTIONS,
    type Exercise,
    type SessionExercise,
    type SessionSet,
    type SessionMood,
    type SetType,
  } from '../../../lib/storage';
  import { TRAINING_TEMPLATES, getTemplateById, type TemplateExercise } from '../../../lib/templates';
  import { getExerciseTip } from '../../../lib/exercise-tips';
  import { getRestTime, formatRestTime } from '../../../lib/rest-times';
  import { playBeep } from '../../../lib/sound';
  import { t, defaultLocale, localizedPath } from '../../../i18n';

  const LABELS = t();

  // Default set type for newly created sets (mirrors spec).
  const DEFAULT_SET_TYPE: SetType = 'work';

  // Fallback category when a template exercise carries no category.
  // Kept in sync with the "Autre" option on the exercices page.
  const TEMPLATE_FALLBACK_CATEGORY = 'Autre';

  // RPE colour tone buckets — drive both the big number and the slider thumb.
  function rpeToneFn(rpe: number): 'easy' | 'moderate' | 'hard' | 'max' {
    if (rpe <= 3) return 'easy';
    if (rpe <= 6) return 'moderate';
    if (rpe <= 8) return 'hard';
    return 'max';
  }

  function rpeLabelFn(rpe: number): string {
    const tone = rpeToneFn(rpe);
    if (tone === 'easy') return LABELS.builder.rpeEasy;
    if (tone === 'moderate') return LABELS.builder.rpeModerate;
    if (tone === 'hard') return LABELS.builder.rpeHard;
    return LABELS.builder.rpeMax;
  }

  /**
   * In-builder shape: each exercise has an optional `supersetId`
   * (1-based, contiguous) used to visually group exercises. On save,
   * we collapse these into the `supersets: Superset[]` shape stored
   * on `Session`.
   */
  type BuilderExercise = SessionExercise & { supersetId: number | null };

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionBuilder', () => ({
      // ── State ──
      sessionName: '',
      sessionDate: new Date().toISOString().split('T')[0],
      exercises: [] as BuilderExercise[],
      availableExercises: [] as Exercise[],
      exerciseSearch: '',
      // Per-set RPE values (10 → 4 by 0.5) used by each set's select.
      rpeValues: RPE_OPTIONS,

      // ── Notes state (added 2026-08-04) ──
      sessionRpe: 5,
      sessionFatigue: 0, // 0 = not set, 1-5 = level
      sessionMood: '' as SessionMood | '',
      sessionNotes: '',

      // ── Collapse state (added 2026-08-04) ──
      expandedExercises: [] as number[],

      // ── Picker tips (added 2026-08-04) ──
      // Set of exercise ids whose tip is currently expanded.
      openTips: [] as string[],

      // ── Rest timer (added 2026-08-04) ──
      // Sticky widget that appears when a set is marked complete.
      // Duration is sourced from `getRestTime(ex.name)` so each
      // exercise gets a tailored default (compound lifts rest
      // longer, isolation work rests shorter). User can Skip the
      // timer to dismiss it before it elapses.
      restTimer: {
        active: false,
        exerciseName: '' as string,
        duration: 0, // total seconds for the current run
        remaining: 0, // seconds left
        intervalId: null as number | null,
        endTime: 0,
      },

      // ── i18n labels (dynamic strings used in the template) ──
      labels: {
        saveSession: LABELS.builder.saveSession,
        noExoAdded: LABELS.builder.noExoAdded,
        noExoDesc: LABELS.builder.noExoDesc,
        needName: LABELS.builder.needName,
        needExo: LABELS.builder.needExo,
        emptyLibrary: LABELS.builder.emptyLibrary,
        createExoLink: LABELS.builder.createExoLink,
        allAdded: LABELS.builder.allAdded,
        noSearchMatch: LABELS.builder.noSearchMatch,
        addExoAria: LABELS.builder.addExoAria,
        toSession: LABELS.builder.toSession,
        showTipAria: LABELS.builder.showTipAria,
        seeTechnique: LABELS.builder.seeTechnique,
        videoAria: LABELS.builder.videoAria,
        onYoutube: LABELS.builder.onYoutube,
        closeRest: LABELS.builder.closeRest,
        skipRest: LABELS.builder.skipRest,
        close: LABELS.builder.close,
        skip: LABELS.builder.skip,
        supersetLabel: LABELS.builder.supersetLabel,
        supersetFor: LABELS.builder.supersetFor,
        newSuperset: LABELS.builder.newSuperset,
        setsFor: LABELS.builder.setsFor,
        setTypeLabel: LABELS.builder.setTypeLabel,
        weightForSet: LABELS.builder.weightForSet,
        repsForSet: LABELS.builder.repsForSet,
        rpeForSet: LABELS.builder.rpeForSet,
        rpeTypeLabel: LABELS.builder.rpeTypeLabel,
        deleteSet: LABELS.builder.deleteSet,
        noSets: LABELS.builder.noSets,
        setsPlural: LABELS.builder.setsPlural,
        setsSingular: LABELS.builder.setsSingular,
        markUndone: LABELS.builder.markUndone,
        markDone: LABELS.builder.markDone,
        andStartRest: LABELS.builder.andStartRest,
        unmarkTitle: LABELS.builder.unmarkTitle,
        markTitle: LABELS.builder.markTitle,
        warmupTitle: LABELS.builder.warmupTitle,
        warmupHint: LABELS.builder.warmupHint,
        warmupBtn: LABELS.builder.warmupBtn,
        fatigueOn: LABELS.builder.fatigueOn,
        fatigueOutOf5: LABELS.builder.fatigueOutOf5,
        moodLabel: LABELS.builder.moodLabel,
        moodGreat: LABELS.builder.moodGreat,
        moodGood: LABELS.builder.moodGood,
        moodOk: LABELS.builder.moodOk,
        moodTired: LABELS.builder.moodTired,
        moodBad: LABELS.builder.moodBad,
        discardConfirm: LABELS.builder.discardConfirm,
        top: LABELS.builder.top,
        units: LABELS.builder.units,
        rest: LABELS.builder.rest,
        discardTitle: LABELS.builder.discardTitle,
      },

      // ── Init ──
      init() {
        this.availableExercises = getExercises();
      },

      // ── Derived ──
      get filteredExercises(): Exercise[] {
        const q = this.exerciseSearch.trim().toLowerCase();
        const addedIds = new Set(this.exercises.map((se) => se.exerciseId));
        return this.availableExercises
          .filter((e) => {
            if (addedIds.has(e.id)) return false;
            if (q && !e.name.toLowerCase().includes(q)) return false;
            return true;
          })
          // Favorites first, then alphabetical.
          .sort((a, b) => {
            if (Boolean(a.favorite) !== Boolean(b.favorite)) {
              return a.favorite ? -1 : 1;
            }
            return a.name.localeCompare(b.name, 'fr');
          });
      },

      get canSave(): boolean {
        return Boolean(this.sessionName.trim()) && this.exercises.length > 0;
      },

      get rpeTone(): 'easy' | 'moderate' | 'hard' | 'max' {
        return rpeToneFn(this.sessionRpe);
      },

      get rpeLabel(): string {
        return rpeLabelFn(this.sessionRpe);
      },

      // ── Collapse / expand (added 2026-08-04) ──
      isExpanded(exerciseIndex: number): boolean {
        return this.expandedExercises.includes(exerciseIndex);
      },

      toggleExpand(exerciseIndex: number) {
        if (this.isExpanded(exerciseIndex)) {
          this.expandedExercises = this.expandedExercises.filter(
            (i) => i !== exerciseIndex,
          );
        } else {
          this.expandedExercises = [...this.expandedExercises, exerciseIndex];
        }
      },

      expandAll() {
        this.expandedExercises = this.exercises.map((_, i) => i);
      },

      collapseAll() {
        this.expandedExercises = [];
      },

      get allExpanded(): boolean {
        return (
          this.exercises.length > 0 &&
          this.expandedExercises.length === this.exercises.length
        );
      },

      /**
       * One-line summary shown when an exercise is collapsed:
       * "X séries · Y kg · top set Z kg × N reps".
       * Returns '' if the exercise has no sets.
       */
      exerciseSummary(exercise: SessionExercise): string {
        if (exercise.sets.length === 0) return this.labels.noSets;
        const totalReps = exercise.sets.reduce(
          (sum, s) => sum + (s.reps || 0),
          0,
        );
        const totalVolume = exercise.sets.reduce(
          (sum, s) => sum + (s.weight || 0) * (s.reps || 0),
          0,
        );
        // Find the heaviest set as the "top set" hint.
        const top = exercise.sets.reduce(
          (best, s) => (s.weight > (best?.weight || 0) ? s : best),
          exercise.sets[0],
        );
        const setLabel = exercise.sets.length > 1 ? this.labels.setsPlural : this.labels.setsSingular;
        const volume = Math.round(totalVolume);
        const topLine = top && top.weight > 0
          ? ` · ${this.labels.top} ${top.weight} kg × ${top.reps}`
          : '';
        return `${exercise.sets.length} ${setLabel} · ${totalReps} reps · ${volume} kg${topLine}`;
      },

      // ── Actions ──
      openPicker() {
        this.exerciseSearch = '';
        this.openDialogById('ses-picker-dialog');
        // Focus the search input once the dialog has opened.
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const ref = (this as any).$refs?.pickerSearch as HTMLInputElement | undefined;
        if (ref) {
          requestAnimationFrame(() => ref.focus());
        }
      },

      addExercise(exercise: Exercise) {
        const firstSet: SessionSet = {
          exerciseId: exercise.id,
          setNumber: 1,
          weight: 0,
          reps: 0,
          type: DEFAULT_SET_TYPE,
          rpeType: 'rpe',
          completed: false,
        };
        const newEx: BuilderExercise = {
          exerciseId: exercise.id,
          name: exercise.name,
          muscle: exercise.muscle,
          sets: [firstSet],
          supersetId: null,
        };
        this.exercises.push(newEx);
        // Auto-expand the new exercise so the user can adjust sets right away.
        this.expandedExercises = [...this.expandedExercises, this.exercises.length - 1];
        this.exerciseSearch = '';
        this.closeDialogById('ses-picker-dialog');
      },

      // ── Templates (added 2026-08-04) ──
      /**
       * Inserts every exercise from the template at the bottom of the
       * current session. Any referenced exercise missing from the user's
       * library is auto-created (from the template data) first, so a
       * template always loads — even when defaults were renamed/deleted.
       */
      loadTemplate(templateId: string) {
        const tpl = getTemplateById(templateId);
        if (!tpl) return;
        const added: number[] = [];
        for (const te of tpl.exercises) {
          let ex = this.findExerciseByName(te.name);
          if (!ex) {
            // Auto-create the missing exercise in the library, then use it.
            ex = saveExercise({
              name: te.name,
              muscle: te.muscle,
              category: TEMPLATE_FALLBACK_CATEGORY,
            });
            // Keep the picker in sync so the new exercise is available later.
            this.availableExercises = [...this.availableExercises, ex];
          }
          const newEx = this.buildBuilderExercise(ex, te);
          this.exercises.push(newEx);
          added.push(this.exercises.length - 1);
        }
        // Auto-expand the newly added exercises so the user can see them.
        if (added.length > 0) {
          this.expandedExercises = [...this.expandedExercises, ...added];
        }
        this.exerciseSearch = '';
        this.closeDialogById('ses-picker-dialog');
      },

      buildBuilderExercise(ex: Exercise, te: TemplateExercise): BuilderExercise {
        const sets: SessionSet[] = [];
        for (let i = 0; i < Math.max(1, te.defaultSets); i++) {
          sets.push({
            exerciseId: ex.id,
            setNumber: i + 1,
            weight: 0,
            reps: te.defaultReps,
            type: DEFAULT_SET_TYPE,
            rpeType: 'rpe',
            completed: false,
          });
        }
        return {
          exerciseId: ex.id,
          name: ex.name,
          muscle: ex.muscle,
          sets,
          supersetId: null,
        };
      },

      findExerciseByName(name: string): Exercise | undefined {
        return this.availableExercises.find((e) => e.name === name);
      },

      // ── Tips (added 2026-08-04) ──
      hasTip(name: string): boolean {
        return getExerciseTip(name) != null;
      },
      getTip(name: string): string {
        return getExerciseTip(name)?.description ?? '';
      },
      getVideoUrl(name: string): string {
        return getExerciseTip(name)?.videoUrl ?? '';
      },
      isTipOpen(exId: string): boolean {
        return this.openTips.includes(exId);
      },
      toggleTip(exId: string) {
        if (this.isTipOpen(exId)) {
          this.openTips = this.openTips.filter((id) => id !== exId);
        } else {
          this.openTips = [...this.openTips, exId];
        }
      },

      // ── Supersets (added 2026-08-04) ──
      /**
       * List of currently used superset ids (1-based, sorted). Used
       * to populate the per-exercise superset dropdown.
       */
      availableSupersetIds(): number[] {
        const ids = new Set<number>();
        for (const ex of this.exercises) {
          if (ex.supersetId != null) ids.add(ex.supersetId);
        }
        return Array.from(ids).sort((a, b) => a - b);
      },

      /**
       * Returns the next free superset id (= max + 1, or 1 if none).
       * Used to seed the "+ Nouveau superset" option.
       */
      nextSupersetId(): number {
        const used = this.availableSupersetIds();
        if (used.length === 0) return 1;
        return Math.max(...used) + 1;
      },

      /**
       * Triggered when the user changes the superset select. We do
       * not need to do much because x-model.number already wrote
       * the new id onto the exercise, but we normalise the value
       * (NaN → null) for the "no superset" case.
       */
      onSupersetChange(exIdx: number) {
        const ex = this.exercises[exIdx];
        if (!ex) return;
        if (!Number.isFinite(ex.supersetId as number) || (ex.supersetId as number) <= 0) {
          ex.supersetId = null;
        }
      },

      /**
       * Pulls an exercise out of its current superset (if any). No
       * effect on the other exercises in the group — they keep
       * referencing the same supersetId; orphaned ids are pruned
       * at save time.
       */
      removeFromSuperset(exIdx: number) {
        const ex = this.exercises[exIdx];
        if (!ex) return;
        ex.supersetId = null;
      },

      addSet(exerciseIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;
        const last = ex.sets[ex.sets.length - 1];
        const next: SessionSet = {
          exerciseId: ex.exerciseId,
          setNumber: ex.sets.length + 1,
          weight: last ? last.weight : 0,
          reps: last ? last.reps : 0,
          type: DEFAULT_SET_TYPE,
          rpeType: 'rpe',
          completed: false,
        };
        ex.sets.push(next);
      },

      removeSet(exerciseIndex: number, setIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;
        ex.sets.splice(setIndex, 1);
        // Re-number remaining sets so the displayed # stays 1..N.
        ex.sets.forEach((s, i) => {
          s.setNumber = i + 1;
        });
      },

      hasWorkingWeight(exercise: SessionExercise): boolean {
        return exercise.sets.some((s) => s.type === 'work' && s.weight > 0);
      },

      generateWarmup(exerciseIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;

        // Find the max working weight from existing sets.
        const workingSets = ex.sets.filter((s) => s.type === 'work' && s.weight > 0);
        if (workingSets.length === 0) return;

        const maxWeight = Math.max(...workingSets.map((s) => s.weight));

        // Generate warmup sets: 40%, 60%, 80% of working weight.
        const warmupPercents = [0.4, 0.6, 0.8] as const;
        const warmupReps = [12, 8, 5] as const;
        const warmups: SessionSet[] = warmupPercents.map((p, i) => ({
          exerciseId: ex.exerciseId,
          setNumber: i + 1,
          type: 'warmup',
          weight: Math.round(maxWeight * p),
          reps: warmupReps[i],
          rpeType: 'rpe',
          completed: false,
        }));

        // Prepend warmups and re-number all sets so the displayed # stays 1..N.
        ex.sets = [
          ...warmups,
          ...ex.sets.map((s, i) => ({ ...s, setNumber: i + warmups.length + 1 })),
        ];
      },

      removeExercise(exerciseIndex: number) {
        this.exercises.splice(exerciseIndex, 1);
      },

      // ── Set completion (added 2026-08-04) ──
      /**
       * Toggle a set's `completed` flag. When the set becomes complete
       * we start the rest timer using the per-exercise default from
       * `getRestTime(name)` (longer for compound lifts, shorter for
       * isolation). Unchecking stops the timer only if it was started
       * for that same set — otherwise the timer keeps running.
       */
      toggleSetComplete(exerciseIndex: number, setIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;
        const set = ex.sets[setIndex];
        if (!set) return;
        set.completed = !set.completed;
        if (set.completed) {
          this.startRestTimer(ex.name);
        }
      },

      // ── Rest timer (added 2026-08-04) ──
      /**
       * Starts (or restarts) the rest timer for the given exercise.
       * Duration is computed from `getRestTime(name)` so the user
       * doesn't have to configure anything. Cancels any previous
       * timer first so the widget always reflects the latest action.
       */
      startRestTimer(exerciseName: string) {
        this.cancelRestTimerTick();
        const duration = getRestTime(exerciseName);
        this.restTimer = {
          active: true,
          exerciseName,
          duration,
          remaining: duration,
          intervalId: null,
          endTime: Date.now() + duration * 1000,
        };
        this.restTimer.intervalId = window.setInterval(
          () => this.tickRestTimer(),
          1000,
        );
        // First tick happens immediately so the display updates from
        // the very first second instead of waiting up to a full second.
        this.tickRestTimer();
      },

      /**
       * Internal — decrements the remaining seconds and stops the
       * interval when the timer hits zero. Beep on completion if
       * the user enabled sound alerts in their settings (we re-read
       * the flag at tick time so a settings change is picked up).
       */
      tickRestTimer() {
        const remainingMs = Math.max(0, this.restTimer.endTime - Date.now());
        const remainingSec = Math.ceil(remainingMs / 1000);
        this.restTimer.remaining = remainingSec;
        if (remainingMs <= 0) {
          this.cancelRestTimerTick();
          this.restTimer.remaining = 0;
          if (this.isSoundEnabled()) this.beep();
        }
      },

      cancelRestTimerTick() {
        if (this.restTimer.intervalId != null) {
          window.clearInterval(this.restTimer.intervalId);
        }
      },

      dismissRestTimer() {
        this.cancelRestTimerTick();
        this.restTimer = {
          active: false,
          exerciseName: '',
          duration: 0,
          remaining: 0,
          intervalId: null,
          endTime: 0,
        };
      },

      /**
       * "Repos — <name> (<mm:ss>)" label for the timer widget.
       * Returns the empty string when the timer is not active so
       * the binding is always safe to render.
       */
      restTimerLabel(): string {
        if (!this.restTimer.active) return '';
        return `${this.labels.rest} — ${this.restTimer.exerciseName} (${formatRestTime(this.restTimer.duration)})`;
      },

      restTimerDisplay(): string {
        if (!this.restTimer.active) return '0:00';
        return formatRestTime(this.restTimer.remaining);
      },

      get restTimerDone(): boolean {
        return this.restTimer.active && this.restTimer.remaining <= 0;
      },

      /**
       * Mirrors the sound-alert flag from settings (default true
       * when the user hasn't saved settings yet). Read on every
       * tick so the change is picked up without a full reload.
       */
      isSoundEnabled(): boolean {
        try {
          const raw = localStorage.getItem('muscu-settings');
          if (!raw) return true;
          const parsed = JSON.parse(raw);
          return parsed.soundAlerts !== false;
        } catch {
          return true;
        }
      },

      /**
       * Rest is over. Silent fallback if the WebAudio API
       * is unavailable.
       */
      beep(): void {
        playBeep();
      },

      // ── Notes actions ──
      setFatigue(level: number) {
        // Toggle: clicking the currently active level unsets fatigue.
        if (this.sessionFatigue === level) {
          this.sessionFatigue = 0;
        } else {
          this.sessionFatigue = Math.max(1, Math.min(5, level));
        }
      },

      setMood(mood: SessionMood) {
        // Toggle: clicking the active mood unsets it.
        this.sessionMood = this.sessionMood === mood ? '' : mood;
      },

      discard() {
        if (this.exercises.length > 0 || this.sessionName.trim()) {
          const ok = window.confirm(this.labels.discardConfirm);
          if (!ok) return;
        }
        window.location.href = localizedPath('/seances');
      },

      save() {
        if (!this.canSave) return;
        // Strip the builder-only `supersetId` from each exercise and
        // build the persisted `supersets` array (only groups with 2+
        // members are saved; orphan groups are dropped).
        const cleanExercises: SessionExercise[] = this.exercises.map(
          ({ supersetId: _supersetId, ...ex }) => ex,
        );
        const groupMap = new Map<number, string[]>();
        for (const ex of this.exercises) {
          if (ex.supersetId == null) continue;
          const list = groupMap.get(ex.supersetId) ?? [];
          list.push(ex.exerciseId);
          groupMap.set(ex.supersetId, list);
        }
        const supersets: { exercises: string[] }[] = [];
        for (const [, ids] of groupMap) {
          if (ids.length >= 2) supersets.push({ exercises: ids });
        }

        // Build the payload; only attach a field when meaningful so older
        // sessions stored before this feature stay clean.
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const payload: any = {
          name: this.sessionName.trim(),
          date: this.sessionDate,
          exercises: cleanExercises,
          status: 'planned' as const,
        };
        if (this.sessionRpe) payload.rpe = this.sessionRpe;
        if (this.sessionFatigue > 0) payload.fatigue = this.sessionFatigue;
        if (this.sessionMood !== '') payload.mood = this.sessionMood;
        if (this.sessionNotes.trim() !== '') payload.notes = this.sessionNotes.trim();
        if (supersets.length > 0) payload.supersets = supersets;
        saveSession(payload);
        window.location.href = localizedPath('/seances');
      },

      // ── Dialog helpers (wrap the global Dialog API) ──
      openDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
      closeDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
    }));
  });
</script>

