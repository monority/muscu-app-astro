---
import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Badge from '../../../components/ui/Badge.astro';
import Dialog from '../../../components/ui/Dialog.astro';

/**
 * Set types (mirrors SessionSet['type'] in src/lib/storage.ts).
 * Labels are localised to French for the in-row selector.
 */
const setTypes = [
  { value: 'warmup', label: 'Échauffement' },
  { value: 'work', label: 'Travail' },
  { value: 'top', label: 'Top set' },
  { value: 'drop', label: 'Drop set' },
  { value: 'failure', label: 'Échec' },
] as const;
---

<AppLayout title="Nouvelle séance">
  <div
    class="ses"
    x-data="sessionBuilder()"
    x-init="init()"
    x-cloak
  >
    <PageHeader
      title="Nouvelle séance"
      description="Construisez votre séance, ajoutez vos exercices et enregistrez vos séries."
    />

    {/* ════════════════════════════════════════════════════
        ACTION BAR — Annuler / Enregistrer
        ════════════════════════════════════════════════════ */}
    <div class="ses__actions">
      <button
        type="button"
        class="ses__btn ses__btn--secondary"
        @click="discard()"
      >
        Annuler
      </button>
      <button
        type="button"
        class="ses__btn ses__btn--primary"
        :disabled="!canSave"
        :class="{ 'is-disabled': !canSave }"
        @click="save()"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="ses__btn-icon"
          aria-hidden="true"
        >
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        <span>Enregistrer la séance</span>
      </button>
    </div>

    {/* ════════════════════════════════════════════════════
        SESSION INFO CARD — name + date
        ════════════════════════════════════════════════════ */}
    <Card>
      <CardHeader>
        <CardTitle>Informations</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="ses__info-grid">
          <div class="ses__field">
            <label for="ses-name" class="ses__label">
              Nom de la séance
              <span class="ses__req" aria-hidden="true">*</span>
            </label>
            <input
              id="ses-name"
              type="text"
              class="ses__input"
              placeholder="Ex. Push day, Jambes, Full body…"
              x-model="sessionName"
              required
              autocomplete="off"
              maxlength="80"
            />
          </div>

          <div class="ses__field">
            <label for="ses-date" class="ses__label">Date</label>
            <input
              id="ses-date"
              type="date"
              class="ses__input"
              x-model="sessionDate"
            />
          </div>
        </div>
      </CardContent>
    </Card>

    {/* ════════════════════════════════════════════════════
        EMPTY STATE — no exercises added yet
        ════════════════════════════════════════════════════ */}
    <template x-if="exercises.length === 0">
      <Card>
        <div class="ses__empty">
          <div class="ses__empty-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6.5 6.5h11v11h-11z"></path>
              <path d="M2 9v6"></path>
              <path d="M22 9v6"></path>
              <path d="M6.5 6.5L2 9"></path>
              <path d="M17.5 6.5L22 9"></path>
              <path d="M6.5 17.5L2 15"></path>
              <path d="M17.5 17.5L22 15"></path>
            </svg>
          </div>
          <h3 class="ses__empty-title">Aucun exercice ajouté</h3>
          <p class="ses__empty-desc">
            Commencez par sélectionner des exercices depuis votre bibliothèque
            pour construire votre séance.
          </p>
          <button
            type="button"
            class="ses__add-btn ses__add-btn--primary"
            @click="openPicker()"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ses__add-icon"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Ajouter un exercice</span>
          </button>
        </div>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        EXERCISE BLOCKS — one Card per added exercise
        Collapsible: header toggles a body that holds the sets table.
        ════════════════════════════════════════════════════ */}
    <template x-for="(ex, exIdx) in exercises" :key="ex.exerciseId + '-' + exIdx">
      <Card>
        {/* ── Clickable header (always visible) ── */}
        <div class="ses__ex-header">
          <button
            type="button"
            class="ses__ex-toggle"
            @click="toggleExpand(exIdx)"
            :aria-expanded="isExpanded(exIdx).toString()"
            :aria-controls="'ses-ex-body-' + exIdx"
          >
            <div class="ses__ex-toggle-main">
              <div class="ses__ex-head">
                <h3 class="ses__ex-name" x-text="ex.name"></h3>
                <Badge variant="accent" x-text="ex.muscle"></Badge>
              </div>
              <p
                class="ses__ex-summary"
                x-show="!isExpanded(exIdx)"
                x-cloak
                x-text="exerciseSummary(ex)"
              ></p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ses__ex-chevron"
              :class="{ 'is-open': isExpanded(exIdx) }"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="ses__icon-btn ses__icon-btn--danger"
            @click="removeExercise(exIdx)"
            aria-label="Retirer l'exercice de la séance"
            title="Retirer l'exercice"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ses__icon"
              aria-hidden="true"
            >
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
              <path d="M10 11v6"></path>
              <path d="M14 11v6"></path>
            </svg>
          </button>
        </div>

        {/* ── Collapsible body (sets table + actions) ── */}
        <div
          :id="'ses-ex-body-' + exIdx"
          class="ses__ex-body"
          x-show="isExpanded(exIdx)"
          x-cloak
        >
          <CardContent>
            {/* ── Sets table ── */}
            <div class="ses__table" role="table" :aria-label="'Séries pour ' + ex.name">
              <div class="ses__table-head" role="row">
                <div class="ses__cell ses__cell--num" role="columnheader">#</div>
                <div class="ses__cell ses__cell--type" role="columnheader">Type</div>
                <div class="ses__cell ses__cell--num" role="columnheader">Poids (kg)</div>
                <div class="ses__cell ses__cell--num" role="columnheader">Reps</div>
                <div class="ses__cell ses__cell--action" role="columnheader" aria-label="Actions"></div>
              </div>
              <template x-for="(set, setIdx) in ex.sets" :key="setIdx">
                <div class="ses__table-row" role="row">
                  <div class="ses__cell ses__cell--num" role="cell" x-text="set.setNumber"></div>
                  <div class="ses__cell ses__cell--type" role="cell">
                    <select
                      class="ses__select ses__select--inline"
                      x-model="set.type"
                      :aria-label="'Type de la série ' + (setIdx + 1)"
                    >
                      {setTypes.map((t) => (
                        <option value={t.value}>{t.label}</option>
                      ))}
                    </select>
                  </div>
                  <div class="ses__cell ses__cell--num" role="cell">
                    <input
                      type="number"
                      class="ses__input ses__input--inline"
                      min="0"
                      step="0.5"
                      x-model.number="set.weight"
                      inputmode="decimal"
                      :aria-label="'Poids de la série ' + (setIdx + 1)"
                    />
                  </div>
                  <div class="ses__cell ses__cell--num" role="cell">
                    <input
                      type="number"
                      class="ses__input ses__input--inline"
                      min="0"
                      step="1"
                      x-model.number="set.reps"
                      inputmode="numeric"
                      :aria-label="'Reps de la série ' + (setIdx + 1)"
                    />
                  </div>
                  <div class="ses__cell ses__cell--action" role="cell">
                    <button
                      type="button"
                      class="ses__icon-btn ses__icon-btn--danger ses__icon-btn--sm"
                      @click="removeSet(exIdx, setIdx)"
                      :aria-label="'Supprimer la série ' + (setIdx + 1)"
                      title="Supprimer la série"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="ses__icon"
                        aria-hidden="true"
                      >
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </button>
                  </div>
                </div>
              </template>
            </div>

            <div class="ses__ex-actions">
              <button
                type="button"
                class="ses__btn ses__btn--secondary ses__btn--sm"
                @click="addSet(exIdx)"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ses__btn-icon"
                  aria-hidden="true"
                >
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Ajouter une série</span>
              </button>
              <button
                type="button"
                class="ses__btn ses__btn--sm ses__btn--warmup"
                @click="generateWarmup(exIdx)"
                :disabled="!hasWorkingWeight(ex)"
                :class="{ 'is-disabled': !hasWorkingWeight(ex) }"
                :title="hasWorkingWeight(ex) ? 'Générer 3 séries d\u2019échauffement basées sur la charge de travail max' : 'Renseignez d\u2019abord le poids d\u2019une série de travail'"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ses__btn-icon"
                  aria-hidden="true"
                >
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                </svg>
                <span>Générer échauffement</span>
              </button>
            </div>
          </CardContent>
        </div>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        ADD EXERCISE — bottom button (shown when ≥1 exercise)
        ════════════════════════════════════════════════════ */}
    <template x-if="exercises.length > 0">
      <div class="ses__add-row">
        <button
          type="button"
          class="ses__add-btn"
          @click="openPicker()"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ses__add-icon"
            aria-hidden="true"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Ajouter un exercice</span>
        </button>
      </div>
    </template>

    {/* ════════════════════════════════════════════════════
        SESSION NOTES — RPE / fatigue / mood / free text
        ════════════════════════════════════════════════════ */}
    <template x-if="exercises.length > 0">
      <Card>
        <CardHeader>
          <CardTitle>Notes de séance</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="ses__notes">
            {/* ── RPE slider ── */}
            <div class="ses__notes-field">
              <div class="ses__notes-label-row">
                <label for="ses-rpe" class="ses__label">Effort perçu (RPE)</label>
                <span
                  class="ses__rpe-value"
                  :class="'ses__rpe-value--' + rpeTone"
                  x-text="sessionRpe"
                ></span>
              </div>
              <div class="ses__rpe">
                <input
                  id="ses-rpe"
                  type="range"
                  min="1"
                  max="10"
                  step="1"
                  class="ses__rpe-input"
                  :class="'ses__rpe-input--' + rpeTone"
                  x-model.number="sessionRpe"
                  aria-label="Effort perçu (RPE) de 1 à 10"
                />
                <div class="ses__rpe-readout">
                  <span x-text="rpeLabel"></span>
                </div>
              </div>
            </div>

            {/* ── Fatigue (1–5) ── */}
            <div class="ses__notes-field">
              <label class="ses__label">Fatigue</label>
              <div class="ses__fatigue" role="radiogroup" aria-label="Niveau de fatigue">
                <template x-for="i in 5" :key="'fat-' + i">
                  <button
                    type="button"
                    class="ses__fatigue-btn"
                    :class="{ 'is-active': sessionFatigue >= i }"
                    :aria-pressed="sessionFatigue >= i"
                    :aria-label="'Fatigue ' + i + ' sur 5'"
                    @click="setFatigue(i)"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      height="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                    </svg>
                  </button>
                </template>
              </div>
            </div>

            {/* ── Mood ── */}
            <div class="ses__notes-field">
              <label class="ses__label">Humeur</label>
              <div class="ses__mood" role="radiogroup" aria-label="Humeur de la séance">
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'great' }"
                  :aria-pressed="sessionMood === 'great'"
                  aria-label="Humeur : très bonne"
                  @click="setMood('great')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'good' }"
                  :aria-pressed="sessionMood === 'good'"
                  aria-label="Humeur : bonne"
                  @click="setMood('good')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'ok' }"
                  :aria-pressed="sessionMood === 'ok'"
                  aria-label="Humeur : moyenne"
                  @click="setMood('ok')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="8" y1="15" x2="16" y2="15"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'tired' }"
                  :aria-pressed="sessionMood === 'tired'"
                  aria-label="Humeur : fatiguée"
                  @click="setMood('tired')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </button>
                <button
                  type="button"
                  class="ses__mood-btn"
                  :class="{ 'is-active': sessionMood === 'bad' }"
                  :aria-pressed="sessionMood === 'bad'"
                  aria-label="Humeur : mauvaise"
                  @click="setMood('bad')"
                >
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
                </button>
              </div>
            </div>

            {/* ── Free-text notes ── */}
            <div class="ses__notes-field">
              <label for="ses-notes" class="ses__label">Notes</label>
              <textarea
                id="ses-notes"
                class="ses__notes-textarea"
                x-model="sessionNotes"
                placeholder="Comment s'est passée la séance…"
                rows="3"
                maxlength="500"
              ></textarea>
            </div>
          </div>
        </CardContent>
      </Card>
    </template>

    {/* ════════════════════════════════════════════════════
        VALIDATION HINT — context-aware error message
        ════════════════════════════════════════════════════ */}
    <div
      class="ses__hint"
      x-show="!canSave && (sessionName.trim() || exercises.length > 0)"
      x-cloak
    >
      <template x-if="!sessionName.trim()">
        <span>Ajoutez un nom à la séance pour pouvoir l'enregistrer.</span>
      </template>
      <template x-if="sessionName.trim() && exercises.length === 0">
        <span>Ajoutez au moins un exercice pour enregistrer la séance.</span>
      </template>
    </div>

    {/* ════════════════════════════════════════════════════
        EXERCISE PICKER DIALOG
        ════════════════════════════════════════════════════ */}
    <Dialog id="ses-picker-dialog" title="Choisir un exercice">
      <div class="ses__picker">
        <div class="ses__search">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ses__search-icon"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            class="ses__search-input"
            placeholder="Rechercher un exercice…"
            x-model="exerciseSearch"
            aria-label="Rechercher un exercice"
            x-ref="pickerSearch"
            @keydown.escape="closeDialogById('ses-picker-dialog')"
            autocomplete="off"
          />
        </div>

        <div class="ses__picker-list" role="list">
          {/* ── Library empty ── */}
          <template x-if="availableExercises.length === 0">
            <div class="ses__picker-empty">
              <p>Votre bibliothèque d'exercices est vide.</p>
              <a href="/exercices" class="ses__picker-link">
                Créer des exercices →
              </a>
            </div>
          </template>

          {/* ── All exercises already added ── */}
          <template x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() === ''">
            <div class="ses__picker-empty">
              <p>Tous vos exercices sont déjà dans cette séance.</p>
            </div>
          </template>

          {/* ── No match for search ── */}
          <template x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() !== ''">
            <div class="ses__picker-empty">
              <p>Aucun exercice ne correspond à votre recherche.</p>
            </div>
          </template>

          {/* ── Picker items ── */}
          <template x-for="ex in filteredExercises" :key="ex.id">
            <button
              type="button"
              class="ses__picker-item"
              @click="addExercise(ex)"
              role="listitem"
            >
              <span class="ses__picker-name" x-text="ex.name"></span>
              <span class="ses__picker-muscle" x-text="ex.muscle"></span>
            </button>
          </template>
        </div>
      </div>

      <div slot="footer">
        <button
          type="button"
          class="ses__btn ses__btn--secondary"
          data-dialog-close
        >
          Fermer
        </button>
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import {
    getExercises,
    saveSession,
    type Exercise,
    type SessionExercise,
    type SessionSet,
    type SessionMood,
    type SetType,
  } from '../../../lib/storage';

  // Default set type for newly created sets (mirrors spec).
  const DEFAULT_SET_TYPE: SetType = 'work';

  // RPE colour tone buckets — drive both the big number and the slider thumb.
  function rpeToneFn(rpe: number): 'easy' | 'moderate' | 'hard' | 'max' {
    if (rpe <= 3) return 'easy';
    if (rpe <= 6) return 'moderate';
    if (rpe <= 8) return 'hard';
    return 'max';
  }

  function rpeLabelFn(rpe: number): string {
    const tone = rpeToneFn(rpe);
    if (tone === 'easy') return 'Très facile';
    if (tone === 'moderate') return 'Modéré';
    if (tone === 'hard') return 'Dur';
    return 'Maximum';
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionBuilder', () => ({
      // ── State ──
      sessionName: '',
      sessionDate: new Date().toISOString().split('T')[0],
      exercises: [] as SessionExercise[],
      availableExercises: [] as Exercise[],
      exerciseSearch: '',

      // ── Notes state (added 2026-08-04) ──
      sessionRpe: 5,
      sessionFatigue: 0, // 0 = not set, 1-5 = level
      sessionMood: '' as SessionMood | '',
      sessionNotes: '',

      // ── Collapse state (added 2026-08-04) ──
      // New exercises are added collapsed by default to keep the page
      // scannable; users click the card header to expand and edit sets.
      // The list holds the *expanded* indices, not the collapsed ones,
      // so an empty list = everything collapsed (safe default).
      expandedExercises: [] as number[],

      // ── Init ──
      init() {
        this.availableExercises = getExercises();
      },

      // ── Derived ──
      get filteredExercises(): Exercise[] {
        const q = this.exerciseSearch.trim().toLowerCase();
        const addedIds = new Set(this.exercises.map((se) => se.exerciseId));
        return this.availableExercises.filter((e) => {
          if (addedIds.has(e.id)) return false;
          if (q && !e.name.toLowerCase().includes(q)) return false;
          return true;
        });
      },

      get canSave(): boolean {
        return Boolean(this.sessionName.trim()) && this.exercises.length > 0;
      },

      get rpeTone(): 'easy' | 'moderate' | 'hard' | 'max' {
        return rpeToneFn(this.sessionRpe);
      },

      get rpeLabel(): string {
        return rpeLabelFn(this.sessionRpe);
      },

      // ── Collapse / expand (added 2026-08-04) ──
      isExpanded(exerciseIndex: number): boolean {
        return this.expandedExercises.includes(exerciseIndex);
      },

      toggleExpand(exerciseIndex: number) {
        if (this.isExpanded(exerciseIndex)) {
          this.expandedExercises = this.expandedExercises.filter(
            (i) => i !== exerciseIndex,
          );
        } else {
          this.expandedExercises = [...this.expandedExercises, exerciseIndex];
        }
      },

      expandAll() {
        this.expandedExercises = this.exercises.map((_, i) => i);
      },

      collapseAll() {
        this.expandedExercises = [];
      },

      get allExpanded(): boolean {
        return (
          this.exercises.length > 0 &&
          this.expandedExercises.length === this.exercises.length
        );
      },

      /**
       * One-line summary shown when an exercise is collapsed:
       * "X séries · Y kg · top set Z kg × N reps".
       * Returns '' if the exercise has no sets.
       */
      exerciseSummary(exercise: SessionExercise): string {
        if (exercise.sets.length === 0) return 'Aucune série';
        const totalReps = exercise.sets.reduce(
          (sum, s) => sum + (s.reps || 0),
          0,
        );
        const totalVolume = exercise.sets.reduce(
          (sum, s) => sum + (s.weight || 0) * (s.reps || 0),
          0,
        );
        // Find the heaviest set as the "top set" hint.
        const top = exercise.sets.reduce(
          (best, s) => (s.weight > (best?.weight || 0) ? s : best),
          exercise.sets[0],
        );
        const setLabel = exercise.sets.length > 1 ? 'séries' : 'série';
        const volume = Math.round(totalVolume);
        const topLine = top && top.weight > 0
          ? ` · top ${top.weight} kg × ${top.reps}`
          : '';
        return `${exercise.sets.length} ${setLabel} · ${totalReps} reps · ${volume} kg${topLine}`;
      },

      // ── Actions ──
      openPicker() {
        this.exerciseSearch = '';
        this.openDialogById('ses-picker-dialog');
        // Focus the search input once the dialog has opened.
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const ref = (this as any).$refs?.pickerSearch as HTMLInputElement | undefined;
        if (ref) {
          requestAnimationFrame(() => ref.focus());
        }
      },

      addExercise(exercise: Exercise) {
        const firstSet: SessionSet = {
          exerciseId: exercise.id,
          setNumber: 1,
          weight: 0,
          reps: 0,
          type: DEFAULT_SET_TYPE,
          completed: false,
        };
        const newEx: SessionExercise = {
          exerciseId: exercise.id,
          name: exercise.name,
          muscle: exercise.muscle,
          sets: [firstSet],
        };
        this.exercises.push(newEx);
        this.exerciseSearch = '';
        this.closeDialogById('ses-picker-dialog');
      },

      addSet(exerciseIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;
        const last = ex.sets[ex.sets.length - 1];
        const next: SessionSet = {
          exerciseId: ex.exerciseId,
          setNumber: ex.sets.length + 1,
          weight: last ? last.weight : 0,
          reps: last ? last.reps : 0,
          type: DEFAULT_SET_TYPE,
          completed: false,
        };
        ex.sets.push(next);
      },

      removeSet(exerciseIndex: number, setIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;
        ex.sets.splice(setIndex, 1);
        // Re-number remaining sets so the displayed # stays 1..N.
        ex.sets.forEach((s, i) => {
          s.setNumber = i + 1;
        });
      },

      hasWorkingWeight(exercise: SessionExercise): boolean {
        return exercise.sets.some((s) => s.type === 'work' && s.weight > 0);
      },

      generateWarmup(exerciseIndex: number) {
        const ex = this.exercises[exerciseIndex];
        if (!ex) return;

        // Find the max working weight from existing sets.
        const workingSets = ex.sets.filter((s) => s.type === 'work' && s.weight > 0);
        if (workingSets.length === 0) return;

        const maxWeight = Math.max(...workingSets.map((s) => s.weight));

        // Generate warmup sets: 40%, 60%, 80% of working weight.
        const warmupPercents = [0.4, 0.6, 0.8] as const;
        const warmupReps = [12, 8, 5] as const;
        const warmups: SessionSet[] = warmupPercents.map((p, i) => ({
          exerciseId: ex.exerciseId,
          setNumber: i + 1,
          type: 'warmup',
          weight: Math.round(maxWeight * p),
          reps: warmupReps[i],
          completed: false,
        }));

        // Prepend warmups and re-number all sets so the displayed # stays 1..N.
        ex.sets = [
          ...warmups,
          ...ex.sets.map((s, i) => ({ ...s, setNumber: i + warmups.length + 1 })),
        ];
      },

      removeExercise(exerciseIndex: number) {
        this.exercises.splice(exerciseIndex, 1);
      },

      // ── Notes actions ──
      setFatigue(level: number) {
        // Toggle: clicking the currently active level unsets fatigue.
        if (this.sessionFatigue === level) {
          this.sessionFatigue = 0;
        } else {
          this.sessionFatigue = Math.max(1, Math.min(5, level));
        }
      },

      setMood(mood: SessionMood) {
        // Toggle: clicking the active mood unsets it.
        this.sessionMood = this.sessionMood === mood ? '' : mood;
      },

      discard() {
        if (this.exercises.length > 0 || this.sessionName.trim()) {
          const ok = window.confirm(
            'Annuler la séance en cours ? Les modifications non enregistrées seront perdues.',
          );
          if (!ok) return;
        }
        window.location.href = '/seances';
      },

      save() {
        if (!this.canSave) return;
        // Build the payload; only attach a field when meaningful so older
        // sessions stored before this feature stay clean.
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const payload: any = {
          name: this.sessionName.trim(),
          date: this.sessionDate,
          exercises: this.exercises,
          status: 'planned' as const,
        };
        if (this.sessionRpe) payload.rpe = this.sessionRpe;
        if (this.sessionFatigue > 0) payload.fatigue = this.sessionFatigue;
        if (this.sessionMood !== '') payload.mood = this.sessionMood;
        if (this.sessionNotes.trim() !== '') payload.notes = this.sessionNotes.trim();
        saveSession(payload);
        window.location.href = '/seances';
      },

      // ── Dialog helpers (wrap the global Dialog API) ──
      openDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
      closeDialogById(id: string) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as ((i: string) => void) | undefined;
        if (fn) fn(id);
      },
    }));
  });
</script>

