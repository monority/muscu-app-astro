  }

  .ses__icon-btn--sm .ses__icon {
    width: 1.6rem;
    height: 1.6rem;
  }

  /* ── Set completion toggle (added 2026-08-04) ──
     Inline check button on the right side of each set row. Outlined
     when incomplete, filled accent when complete. Clicking it also
     starts the per-exercise rest timer. */
  .ses__set-complete {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    background-color: transparent;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform var(--transition-fast);
  }

  .ses__set-complete:hover {
    background-color: hsl(142 70% 45% / 0.10);
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .ses__set-complete:active {
    transform: scale(0.92);
  }

  .ses__set-complete.is-complete {
    background-color: var(--color-success);
    border-color: var(--color-success);
    color: hsl(0 0% 5%);
  }

  .ses__set-complete.is-complete:hover {
    background-color: hsl(142 70% 50%);
    border-color: hsl(142 70% 50%);
  }

  .ses__set-complete svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     ADD EXERCISE — empty state + bottom row
     ════════════════════════════════════════════════════ */
  .ses__add-row {
    display: flex;
    justify-content: center;
    padding: 0.4rem 0;
  }

  .ses__add-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    height: 4.4rem;
    padding: 0 2rem;
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px dashed var(--alpha-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform var(--transition-fast);
  }

  .ses__add-btn:hover {
    background-color: var(--color-surface-2);
    border-color: var(--color-accent);
    border-style: solid;
    color: var(--color-accent);
  }

  .ses__add-btn:active {
    transform: scale(0.98);
  }

  .ses__add-btn--primary {
    border-style: solid;
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    box-shadow: 0 2px 8px hsl(32 95% 50% / 0.25);
  }

  .ses__add-btn--primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-foreground);
    box-shadow: 0 4px 14px hsl(32 95% 50% / 0.40);
  }

  .ses__add-icon {
    width: 1.6rem;
    height: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     EMPTY STATE
     ════════════════════════════════════════════════════ */
  .ses__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3.6rem 1.6rem 3rem;
    text-align: center;
  }

  .ses__empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 50%;
    background-color: hsl(32 95% 50% / 0.10);
    color: var(--color-accent);
  }

  .ses__empty-icon svg {
    width: 2.8rem;
    height: 2.8rem;
  }

  .ses__empty-title {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.4rem;
  }

  .ses__empty-desc {
    color: var(--color-muted);
    font-size: 1.3rem;
    max-width: 38rem;
    margin: 0.6rem 0 0;
    line-height: 1.5;
  }

  /* ════════════════════════════════════════════════════
     VALIDATION HINT
     ════════════════════════════════════════════════════ */
  .ses__hint {
    background-color: hsl(0 80% 55% / 0.08);
    border: 1px solid hsl(0 80% 55% / 0.25);
    border-radius: var(--radius-md);
    color: hsl(0 80% 75%);
    font-size: 1.2rem;
    font-weight: 500;
    padding: 1rem 1.4rem;
    text-align: center;
  }

  /* ════════════════════════════════════════════════════
     EXERCISE PICKER (inside Dialog)
     ════════════════════════════════════════════════════ */
  .ses__picker {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-top: 0.4rem;
  }

  .ses__search {
    position: relative;
  }

  .ses__search-icon {
    position: absolute;
    top: 50%;
    left: 1.4rem;
    transform: translateY(-50%);
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-muted);
    pointer-events: none;
  }

  .ses__search-input {
    width: 100%;
    height: 4.4rem;
    padding: 0 1.4rem 0 4.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .ses__search-input::placeholder {
    color: var(--alpha-text-faint);
  }

  .ses__search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .ses__search-input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .ses__picker-list {
    display: flex;
    flex-direction: column;
    max-height: 36rem;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-2);
  }

  .ses__picker-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.6rem 1rem;
    width: 100%;
    padding: 1.0rem 1.6rem;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-align: left;
    font-family: var(--font-body);
    transition: background-color var(--transition-fast);
  }

  .ses__picker-item:last-child {
    border-bottom: none;
  }

  .ses__picker-item:hover {
    background-color: hsl(32 95% 50% / 0.08);
  }

  .ses__picker-item-main {
    grid-column: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    background: transparent;
    border: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
    font: inherit;
    padding: 0.2rem 0;
  }

  .ses__picker-tip-toggle {
    grid-column: 2;
    grid-row: 1 / 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast);
  }

  .ses__picker-tip-toggle:hover {
    background-color: var(--color-surface-3);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .ses__picker-tip-toggle svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .ses__picker-tip {
    grid-column: 1;
    grid-row: 2;
    margin: 0;

    min-width: 0;
    padding: 0.9rem 1.0rem;
    background-color: var(--color-surface-2);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    border-bottom: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  /* ── YouTube technique link (added 2026-08-04) ── */
  .ses__tip-video {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
    padding: 0.5rem 0.9rem;
    background-color: hsl(0 80% 55% / 0.10);
    border: 1px solid hsl(0 80% 55% / 0.32);
    border-radius: var(--radius-pill);
    color: hsl(0 80% 60%);
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform var(--transition-fast);
  }

  .ses__tip-video:hover {
    background-color: hsl(0 80% 55% / 0.18);
    border-color: hsl(0 80% 55% / 0.50);
    color: hsl(0 80% 65%);
  }

  .ses__tip-video:active {
    transform: scale(0.97);
  }

  .ses__tip-video svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: currentColor;
    stroke: currentColor;
    flex-shrink: 0;
  }

  .ses__tip-video svg polygon {
    fill: currentColor;
    stroke: none;
  }

  .ses__picker-name {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.2;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ses__picker-muscle {
    flex-shrink: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 0.3rem 0.9rem;
    background-color: hsl(32 95% 50% / 0.10);
    border: 1px solid hsl(32 95% 50% / 0.25);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .ses__picker-empty {
    padding: 2.6rem 1.6rem;
    text-align: center;
    color: var(--color-muted);
  }

  .ses__picker-empty p {
    font-size: 1.3rem;
    margin: 0;
    line-height: 1.5;
  }

  .ses__picker-link {
    display: inline-block;
    margin-top: 0.8rem;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 1.3rem;
  }

  /* ════════════════════════════════════════════════════
     TEMPLATES (added 2026-08-04)
     ════════════════════════════════════════════════════ */
  .ses__templates {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.8rem;
  }

  .ses__templates-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ses__templates-eyebrow {
    font-size: 1.0rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    font-weight: 700;
  }

  .ses__templates-hint {
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .ses__templates-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  @media (min-width: 640px) {
    .ses__templates-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ses__template {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    width: 100%;
    padding: 1.0rem 1.2rem;
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-align: left;
    cursor: pointer;
    font-family: var(--font-body);
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                transform var(--transition-fast);
  }

  .ses__template:hover {
    background-color: var(--color-surface-2);
    border-color: var(--color-accent);
  }

  .ses__template:active {
    transform: scale(0.98);
  }

  .ses__template:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .ses__template-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .ses__template-desc {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.3;
  }

  .ses__template-count {
    font-size: 1.0rem;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--color-accent);
    font-weight: 700;
  }

  /* ════════════════════════════════════════════════════
     SUPERSET UI (added 2026-08-04)
     ════════════════════════════════════════════════════ */
  .ses__ex-superset-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.2rem;
    margin-bottom: 0.6rem;
    background-color: var(--alpha-bg-soft);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ses__ex-superset-bar--g1 { border-left-color: #D97706; }
  .ses__ex-superset-bar--g2 { border-left-color: #38BDF8; }
  .ses__ex-superset-bar--g3 { border-left-color: #A855F7; }
  .ses__ex-superset-bar--g4 { border-left-color: #22C55E; }
  .ses__ex-superset-bar--g5 { border-left-color: #F472B6; }

  .ses__ex-superset-icon {
    width: 1.4rem;
    height: 1.4rem;
    color: currentColor;
    flex-shrink: 0;
  }

  .ses__ex-superset-remove {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast);
  }

  .ses__ex-superset-remove:hover {
    background-color: hsl(0 80% 55% / 0.10);
    border-color: hsl(0 80% 55% / 0.35);
    color: var(--color-destructive);
  }

  .ses__ex-superset-remove svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .ses__ex-superset-select {
    height: 4.0rem;
    padding: 0 2.2rem 0 1.0rem;
    background-color: var(--color-surface-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--color-muted) 50%),
      linear-gradient(135deg, var(--color-muted) 50%, transparent 50%);
    background-position:
      calc(100% - 1.3rem) 50%,
      calc(100% - 0.8rem) 50%;
    background-size: 0.5rem 0.5rem, 0.5rem 0.5rem;
    background-repeat: no-repeat;
    transition: border-color var(--transition-fast);
  }

  .ses__ex-superset-select:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  /* ════════════════════════════════════════════════════
     SESSION NOTES — RPE / fatigue / mood / textarea
     Compact spacing (2026-08-04): the four blocks (RPE, fatigue,
     mood, free-text) used to eat ~50% of the page height. Tightened
     gaps + smaller RPE value chip + shorter textarea so the whole
     notes card fits comfortably without dominating the screen.
     ════════════════════════════════════════════════════ */
  .ses__notes {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .ses__notes-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ses__notes-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* ── RPE slider ── */
  .ses__rpe {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    width: 100%;
  }

  .ses__rpe-input {
    flex: 1 1 auto;
    -webkit-appearance: none;
    appearance: none;
    height: 0.8rem;
    background-color: var(--color-surface-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    outline: none;
    cursor: pointer;
    transition: box-shadow var(--transition-fast),
                border-color var(--transition-fast);
  }

  .ses__rpe-input:focus-visible {
    box-shadow: var(--focus-ring);
    border-color: var(--color-accent);
  }

  /* WebKit thumb */
  .ses__rpe-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background-color: var(--color-success);
    border: 3px solid var(--color-surface);
    box-shadow: 0 2px 8px hsl(0 0% 0% / 0.45);
    cursor: grab;
    transition: background-color var(--transition-fast),
                transform var(--transition-fast),
                box-shadow var(--transition-fast);
  }

  .ses__rpe-input:active::-webkit-slider-thumb {
    cursor: grabbing;
    transform: scale(1.08);
  }

  /* Firefox thumb */
  .ses__rpe-input::-moz-range-thumb {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background-color: var(--color-success);
    border: 3px solid var(--color-surface);
    box-shadow: 0 2px 8px hsl(0 0% 0% / 0.45);
    cursor: grab;
    transition: background-color var(--transition-fast),
                transform var(--transition-fast);
  }

  .ses__rpe-input--easy::-webkit-slider-thumb { background-color: var(--color-success); }
  .ses__rpe-input--easy::-moz-range-thumb     { background-color: var(--color-success); }
  .ses__rpe-input--moderate::-webkit-slider-thumb { background-color: var(--color-warning); }
  .ses__rpe-input--moderate::-moz-range-thumb     { background-color: var(--color-warning); }
  .ses__rpe-input--hard::-webkit-slider-thumb { background-color: var(--color-accent); }
  .ses__rpe-input--hard::-moz-range-thumb     { background-color: var(--color-accent); }
  .ses__rpe-input--max::-webkit-slider-thumb { background-color: var(--color-destructive); }
  .ses__rpe-input--max::-moz-range-thumb     { background-color: var(--color-destructive); }

  /* ── RPE value chip + label readout ── */
  .ses__rpe-value {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.8rem;
    height: 3.8rem;
    padding: 0 0.8rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 2.0rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    background-color: hsl(142 70% 45% / 0.12);
    color: var(--color-success);
    border: 1px solid hsl(142 70% 45% / 0.30);
    transition: background-color var(--transition-fast),
                color var(--transition-fast),
                border-color var(--transition-fast);
  }

  .ses__rpe-value--easy {
    background-color: hsl(142 70% 45% / 0.12);
    color: var(--color-success);
    border-color: hsl(142 70% 45% / 0.30);
  }
  .ses__rpe-value--moderate {
    background-color: hsl(48 95% 55% / 0.14);
    color: var(--color-warning);
    border-color: hsl(48 95% 55% / 0.32);
  }
  .ses__rpe-value--hard {
    background-color: hsl(32 95% 50% / 0.14);
    color: var(--color-accent);
    border-color: hsl(32 95% 50% / 0.34);
  }
  .ses__rpe-value--max {
    background-color: hsl(0 80% 55% / 0.14);
    color: var(--color-destructive);
    border-color: hsl(0 80% 55% / 0.34);
  }

  .ses__rpe-readout {
    flex-shrink: 0;
    min-width: 7.6rem;
    text-align: right;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--color-muted);
  }

  /* ── Fatigue (5 flame icons) ── */
  .ses__fatigue {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .ses__fatigue-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    color: var(--color-text);
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    filter: grayscale(1) opacity(0.40);
    transition: filter var(--transition-fast),
                background-color var(--transition-fast),
                border-color var(--transition-fast),
                transform var(--transition-fast);
  }

  .ses__fatigue-btn svg {
    display: block;
  }

  .ses__fatigue-btn:hover {
    filter: grayscale(0.4) opacity(0.85);
    background-color: var(--color-surface-3);
    border-color: var(--alpha-border);
  }

  .ses__fatigue-btn:active {
    transform: scale(0.94);
  }

  .ses__fatigue-btn.is-active {
    filter: none;
    background-color: hsl(32 95% 50% / 0.12);
