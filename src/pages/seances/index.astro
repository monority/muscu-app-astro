---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import { t, setLocale, defaultLocale, localizedPath } from '../../i18n';



setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.sessions.title}>
  <PageHeader
    title={L.sessions.title}
    description={L.sessions.description}
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/seances/creer")}
  />

  <div
    class="sess"
    x-data="sessionsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: search ── */}
    <div class="sess__toolbar">
      <div class="sess__search">
        <svg
          class="sess__search-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          class="sess__search-input"
          placeholder={L.sessions.search}
          x-model="search"
          aria-label={L.sessions.search}
        />
      </div>
    </div>

    {/* ── Meta row: count ── */}
    <div class="sess__meta">
      <span class="sess__count" x-text="countLabel"></span>
    </div>

    {/* ── Grid (when there are sessions) ── */}
    <template x-if="filtered.length > 0">
      <div class="sess__grid">
        <template x-for="session in filtered" :key="session.id">
          <article
            class="sess__card"
            :class="'sess__card--' + session.status"
            @click="navigateTo(session.id)"
            @keydown.enter="navigateTo(session.id)"
            @keydown.space.prevent="navigateTo(session.id)"
            tabindex="0"
            role="link"
            :aria-label="labels.seenAriaPrefix + session.name"
          >
            <header class="sess__card-head">
              <div class="sess__card-title">
                <svg
                  class="sess__card-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6.5 6.5h11v11h-11z"></path>
                  <path d="M2 9v6"></path>
                  <path d="M22 9v6"></path>
                  <path d="M6.5 6.5L2 9"></path>
                  <path d="M17.5 6.5L22 9"></path>
                  <path d="M6.5 17.5L2 15"></path>
                  <path d="M17.5 17.5L22 15"></path>
                </svg>
                <h3 class="sess__card-name" x-text="session.name"></h3>
                <span
                  class="sess__mood-indicator"
                  x-show="session.mood"
                  :title="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                  :aria-label="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                >
                  <span class="sess__mood-emoji" x-html="moodEmoji(session.mood)" aria-hidden="true"></span>
                </span>
              </div>
              <span
                class="sess__badge"
                :class="'sess__badge--' + session.status"
                x-text="statusLabel(session.status)"
              ></span>
            </header>

            <div
              class="sess__card-date"
              x-text="formatDate(session.date)"
            ></div>

            <div class="sess__card-meta">
              <div class="sess__meta-item">
                <svg
                  class="sess__meta-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14.4 14.4 9.6 9.6"></path>
                  <path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"></path>
                  <path d="m21.5 21.5-1.4-1.4"></path>
                  <path d="M3.9 3.9 2.5 2.5"></path>
                  <path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"></path>
                </svg>
                <span class="sess__meta-value" x-text="session.exercises.length"></span>
                <span class="sess__meta-label" x-text="session.exercises.length > 1 ? labels.exoPlural : labels.exoSingular"></span>
              </div>
              <div class="sess__volume-badge">
                <svg
                  class="sess__volume-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6.5 6.5h11"></path>
                  <path d="M6.5 17.5h11"></path>
                  <path d="M3 9v6"></path>
                  <path d="M21 9v6"></path>
                  <path d="M6.5 6.5 3 9v6l3.5 2.5h11L21 15V9l-3.5-2.5Z"></path>
                </svg>
                <span x-text="formatVolume(totalVolume(session))"></span>
              </div>
            </div>

            <footer class="sess__card-foot">
              <button
                type="button"
                class="sess__icon-btn"
                @click.stop="menuId = menuId === session.id ? '' : session.id"
                :aria-expanded="(menuId === session.id).toString()"
                :aria-label="labels.moreActions"
                :title="labels.moreActions"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="sess__icon"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="5" r="1"></circle>
                  <circle cx="12" cy="12" r="1"></circle>
                  <circle cx="12" cy="19" r="1"></circle>
                </svg>
              </button>
              <button
                type="button"
                class="sess__icon-btn sess__icon-btn--danger"
                @click.stop="deleteSession(session.id)"
                @keydown.enter.stop
                @keydown.space.stop
                aria-label={L.sessions.delete}
                title={L.sessions.delete}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="sess__icon"
                  aria-hidden="true"
                >
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                  <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>

              <template x-if="menuId === session.id">
                <div class="sess__menu" @click.stop>
                  <button
                    type="button"
                    class="sess__menu-item"
                    x-show="session.status !== 'in-progress'"
                    @click="menuId = ''; setStatus(session.id, 'in-progress')"
                    x-text="labels.resume"
                  ></button>
                  <button
                    type="button"
                    class="sess__menu-item"
                    x-show="session.status !== 'completed'"
                    @click="menuId = ''; setStatus(session.id, 'completed')"
                    x-text="labels.markComplete"
                  ></button>
                  <button
                    type="button"
                    class="sess__menu-item"
                    @click="menuId = ''; duplicateSession(session.id)"
                    x-text="labels.duplicate"
                  ></button>
                  <button
                    type="button"
                    class="sess__menu-item"
                    @click="menuId = ''; openMove(session.id)"
                    x-text="labels.moveDate"
                  ></button>
                </div>
              </template>
            </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state: no sessions at all ── */}
    <template x-if="!hasSessions">
      <Card>
        <EmptyState
          title={L.sessions.emptyTitle}
          description={L.sessions.emptyDesc}
          actionLabel={L.sessions.createAction}
          actionHref={localizedPath("/seances/creer")}
        />
      </Card>
    </template>

    {/* ── Empty state: no results matching search ── */}
    <template x-if="hasSessions && filtered.length === 0">
      <Card>
        <div class="sess__empty-cta">
          <h3 class="sess__empty-title" x-text="labels.noResult">{L.sessions.noResult}</h3>
          <p class="sess__empty-text" x-text="labels.noMatchPrefix + ' « ' + search + ' ».'">
            {L.sessions.noMatchPrefix} « <span x-text="search"></span> ».
          </p>
          <button
            type="button"
            class="sess__reset-btn"
            @click="search = ''"
            x-text="labels.resetSearch"
          >
            {L.sessions.resetSearch}
          </button>
        </div>
      </Card>
    </template>

    {/* ── Backdrop for the quick-actions menu ── */}
    <div
      class="sess__menu-backdrop"
      x-show="menuId !== ''"
      x-cloak
      @click="menuId = ''"
    ></div>

    {/* ── Move session dialog ── */}
    <Dialog id="sess-move-dialog" title={L.sessions.moveTitle}>
      <label class="sess__move-field">
        <span class="sess__move-label">{L.sessions.moveDateLabel}</span>
        <input
          type="date"
          class="sess__move-input"
          x-model="moveDate"
          :max="todayIso"
        />
      </label>
      <div slot="footer">
        <button
          type="button"
          data-dialog-close
          class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-sm)] font-semibold transition-all duration-[160ms] select-none whitespace-nowrap active:scale-[0.97] bg-transparent text-muted border border-border hover:text-white hover:border-white/20 h-12 px-5 text-[1.3rem] min-w-[8rem]"
        >
          {L.common.cancel}
        </button>
        <button
          type="button"
          class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-sm)] font-semibold transition-all duration-[160ms] select-none whitespace-nowrap active:scale-[0.97] bg-accent text-accent-foreground border border-accent/45 hover:bg-accent-hover hover:brightness-110 h-12 px-5 text-[1.3rem] min-w-[8rem]"
          :disabled="!moveDate"
          @click="confirmMove()"
        >
          {L.sessions.move}
        </button>
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getSessionById,
    saveSession,
    updateSession,
    deleteSession,
    type Session,
    type SessionMood,
    type SessionStatus,
  } from '../../lib/storage';
  import { t, defaultLocale, getLocale, localizedPath } from '../../i18n';

  const LABELS = t();
  const DATE_LOCALE = getLocale() === 'en' ? 'en-GB' : 'fr-FR';

  // ── Pure helpers (module scope) ────────────────────────────
  function statusLabel(status: SessionStatus): string {
    if (status === 'completed') return LABELS.sessions.completed;
    if (status === 'in-progress') return LABELS.sessions.inProgress;
    return LABELS.sessions.planned;
  }

  function formatDate(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const date = d.toLocaleDateString(DATE_LOCALE, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    const time = d.toLocaleTimeString(DATE_LOCALE, {
      hour: '2-digit',
      minute: '2-digit',
    });
    return date + ' · ' + time;
  }

  function formatVolume(volume: number): string {
    if (!Number.isFinite(volume) || volume <= 0) return '0 kg';
    return Math.round(volume).toLocaleString(DATE_LOCALE) + ' kg';
  }

  // Mood helpers return inline Lucide SVG markup so they can be
  // rendered via x-html. The colour is inherited from
  // .sess__mood-indicator via currentColor.
  const MOOD_SVG_ATTRS = 'viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
  const MOOD_SMILE  = `<svg ${MOOD_SVG_ATTRS}><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`;
  const MOOD_HEART  = `<svg ${MOOD_SVG_ATTRS}><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
  const MOOD_MEH    = `<svg ${MOOD_SVG_ATTRS}><circle cx="12" cy="12" r="10"/><line x1="8" y1="15" x2="16" y2="15"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`;
  const MOOD_FROWN  = `<svg ${MOOD_SVG_ATTRS}><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`;
  const MOOD_BED    = `<svg ${MOOD_SVG_ATTRS}><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>`;

  function moodEmojiFn(mood: SessionMood | undefined | null): string {
    if (!mood) return '';
    if (mood === 'great') return MOOD_SMILE;
    if (mood === 'good') return MOOD_HEART;
    if (mood === 'ok') return MOOD_MEH;
    if (mood === 'tired') return MOOD_FROWN;
    return MOOD_BED;
  }

  function moodLabelFn(mood: SessionMood | undefined | null): string {
    if (!mood) return '';
    if (mood === 'great') return LABELS.sessions.moodGreat;
    if (mood === 'good') return LABELS.sessions.moodGood;
    if (mood === 'ok') return LABELS.sessions.moodOk;
    if (mood === 'tired') return LABELS.sessions.moodTired;
    return LABELS.sessions.moodBad;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionsApp', () => ({
      // ── State ──
      sessions: [] as Session[],
      search: '',
      menuId: '',
      moveSessionId: '',
      moveDate: '',
      labels: {
        exoPlural: LABELS.sessions.exoPlural,
        exoSingular: LABELS.sessions.exoSingular,
        moodLabel: LABELS.sessions.moodLabel,
        noResult: LABELS.sessions.noResult,
        noMatchPrefix: LABELS.sessions.noMatchPrefix,
        resetSearch: LABELS.sessions.resetSearch,
        noSession: LABELS.sessions.noSession,
        noMatch: LABELS.sessions.noMatch,
        seanceSingular: LABELS.sessions.seanceSingular,
        seancePlural: LABELS.sessions.seancePlural,
        pluralS: LABELS.sessions.pluralS,
        deleteConfirm: LABELS.sessions.deleteConfirm,
        seenAriaPrefix: LABELS.sessions.seenAriaPrefix,
        moreActions: LABELS.sessions.moreActions,
        resume: LABELS.sessions.resume,
        markComplete: LABELS.sessions.markComplete,
        duplicate: LABELS.sessions.duplicate,
        moveDate: LABELS.sessions.moveDate,
      },

      get todayIso(): string {
        return new Date().toISOString().slice(0, 10);
      },

      // ── Init ──
      init() {
        this.refresh();
      },

      refresh() {
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
      },

      // ── Derived ──
      get filtered(): Session[] {
        const q = this.search.trim().toLowerCase();
        if (!q) return this.sessions;
        return this.sessions.filter((s) =>
          s.name.toLowerCase().includes(q),
        );
      },

      get countLabel(): string {
        const n = this.filtered.length;
        if (n === 0) return this.sessions.length === 0 ? this.labels.noSession : this.labels.noMatch;
        return `${n} ${this.labels.seanceSingular}${n > 1 ? this.labels.pluralS : ''}`;
      },

      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      // ── Computations ──
      totalVolume(session: Session): number {
        return session.exercises.reduce(
          (sum, ex) =>
            sum + ex.sets.reduce(
              (s, set) => s + (set.completed ? set.weight * set.reps : 0),
              0,
            ),
          0,
        );
      },

      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDate(iso);
      },

      formatVolume(volume: number): string {
        return formatVolume(volume);
      },

      moodEmoji(mood: SessionMood | undefined | null) {
        return moodEmojiFn(mood);
      },

      moodLabel(mood: SessionMood | undefined | null) {
        return moodLabelFn(mood);
      },

      // ── Actions ──
      navigateTo(id: string) {
        window.location.href = localizedPath('/seances/detail?id=' + encodeURIComponent(id));
      },

      deleteSession(id: string) {
        // eslint-disable-next-line no-alert
        if (window.confirm(this.labels.deleteConfirm)) {
          deleteSession(id);
          this.sessions = this.sessions.filter((s) => s.id !== id);
        }
      },

      // ── Quick actions ──
      setStatus(id: string, status: SessionStatus) {
        updateSession(id, { status });
        this.refresh();
      },

      duplicateSession(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        const copy: Omit<Session, 'id'> = {
          name: src.name + ' ' + LABELS.sessions.copySuffix,
          date: new Date().toISOString(),
          status: 'planned',
          exercises: src.exercises.map((ex) => ({
            ...ex,
            sets: ex.sets.map((set) => ({ ...set, completed: false })),
          })),
        };
        if (src.supersets) copy.supersets = src.supersets.map((g) => ({ ...g }));
        saveSession(copy);
        this.refresh();
      },

      openMove(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        this.moveSessionId = id;
        this.moveDate = (src.date || '').slice(0, 10);
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).openDialog?.('sess-move-dialog');
      },

      confirmMove() {
        if (!this.moveSessionId || !this.moveDate) return;
        const date = new Date(this.moveDate + 'T12:00:00').toISOString();
        updateSession(this.moveSessionId, { date, status: 'planned' });
        this.moveSessionId = '';
        this.moveDate = '';
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).closeDialog?.('sess-move-dialog');
        this.refresh();
      },
    }));
  });
</script>

{/* Alpine.js CDN — MUST be AFTER the app script (type="module" runs before defer) */}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<style>
  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .sess {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  /* ════════════════════════════════════════════════════
     TOOLBAR — search
     ════════════════════════════════════════════════════ */
  .sess__toolbar {
    margin-bottom: 2rem;
  }

  .sess__search {
    position: relative;
    width: 100%;
    max-width: 44rem;
  }

  .sess__search-icon {
    position: absolute;
    top: 50%;
    left: 1.4rem;
    transform: translateY(-50%);
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-muted);
    pointer-events: none;
  }

  .sess__search-input {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.6rem 0 4.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    line-height: 1.2;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    -webkit-appearance: none;
    appearance: none;
  }

  .sess__search-input::placeholder {
    color: var(--alpha-text-faint);
  }

  .sess__search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .sess__search-input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  /* ════════════════════════════════════════════════════
     META — count label
     ════════════════════════════════════════════════════ */
  .sess__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.6rem;
  }

  .sess__count {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  /* ════════════════════════════════════════════════════
     GRID — 1 / 2 / 3 columns
     ════════════════════════════════════════════════════ */
  .sess__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  @media (min-width: 640px) {
    .sess__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sess__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ════════════════════════════════════════════════════
     CARD
     ════════════════════════════════════════════════════ */
  .sess__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-border);
