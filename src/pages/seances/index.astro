---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import SearchInput from '../../components/ui/SearchInput.astro';
import IconButton from '../../components/ui/IconButton.astro';
import { icons } from '../../lib/icons';
import { t, localizedPath } from '../../i18n';

const L = t();
---

<AppLayout title={L.sessions.title}>
  <PageHeader
    title={L.sessions.title}
    description={L.sessions.description}
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/seances/creer")}
  />

  <div
    class="sess"
    x-data="sessionsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: search ── */}
    <div class="sess__toolbar">
      <SearchInput
        class="sess__search"
        placeholder={L.sessions.search}
        x-model="search"
        label={L.sessions.search}
      />
    </div>

    {/* ── Meta row: count ── */}
    <div class="sess__meta">
      <span class="sess__count" x-text="countLabel"></span>
    </div>

    {/* ── Grid (when there are sessions) ── */}
    <template x-if="filtered.length > 0">
      <div class="sess__grid">
        <template x-for="session in filtered" :key="session.id">
          <article
            class="sess__card"
            :class="'sess__card--' + session.status"
            @click="navigateTo(session.id)"
            @keydown.enter="navigateTo(session.id)"
            @keydown.space.prevent="navigateTo(session.id)"
            tabindex="0"
            role="link"
            :aria-label="labels.seenAriaPrefix + session.name + ' · ' + statusLabel(session.status)"
          >
            <header class="sess__card-head">
              <div class="sess__card-title">
                <span class="sess__card-icon" aria-hidden="true">
                  <Fragment set:html={icons.dumbbellBox()} />
                </span>
                <div class="sess__card-name-row">
                  <span class="sess__card-dot" aria-hidden="true"></span>
                  <h3 class="sess__card-name" x-text="session.name"></h3>
                  <span
                    class="sess__mood-indicator"
                    x-show="session.mood"
                    :title="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                    :aria-label="labels.moodLabel + ' : ' + moodLabel(session.mood)"
                  >
                    <span class="sess__mood-emoji" x-html="moodEmoji(session.mood)" aria-hidden="true"></span>
                  </span>
                </div>
              </div>
              <div class="sess__badge">
                <div x-show="session.status === 'completed'">
                  <Badge variant="success" size="sm"><span x-text="statusLabel(session.status)"></span></Badge>
                </div>
                <div x-show="session.status === 'in-progress'">
                  <Badge variant="info" size="sm"><span x-text="statusLabel(session.status)"></span></Badge>
                </div>
                <div x-show="session.status !== 'completed' && session.status !== 'in-progress'">
                  <Badge variant="default" size="sm"><span x-text="statusLabel(session.status)"></span></Badge>
                </div>
              </div>
            </header>

            <div
              class="sess__card-date"
              x-text="formatDate(session.date)"
            ></div>

            <div class="sess__card-meta">
              <div class="sess__meta-item">
                <span class="sess__meta-icon" set:html={icons.dumbbell()} />
                <span class="sess__meta-value" x-text="session.exercises.length"></span>
                <span class="sess__meta-label" x-text="session.exercises.length > 1 ? labels.exoPlural : labels.exoSingular"></span>
              </div>
              <div class="sess__volume-badge">
                <span class="sess__volume-icon" set:html={icons.volumeBox()} />
                <span x-text="formatVolume(totalVolume(session))"></span>
              </div>
              <div class="sess__muscle" x-show="primaryMuscle(session)">
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(primaryMuscle(session))"
                >
                  <span x-text="muscleLabel(primaryMuscle(session))"></span>
                </Badge>
              </div>
            </div>

            <footer class="sess__card-foot">
              <IconButton
                variant="ghost"
                icon={icons.dots()}
                label={L.sessions.moreActions}
                @click.stop="menuId = menuId === session.id ? '' : session.id"
                @keydown.enter.stop
                @keydown.space.stop
                :aria-expanded="(menuId === session.id).toString()"
                title={L.sessions.moreActions}
              />
              <IconButton
                variant="danger"
                icon={icons.trash()}
                label={L.sessions.delete}
                title={L.sessions.delete}
                @click.stop="deleteSession(session.id)"
                @keydown.enter.stop
                @keydown.space.stop
              />

              <template x-if="menuId === session.id">
                {/* Enter/Space inside the popover must NOT bubble to the
                    card article's navigate() keydown handlers. */}
                <div class="sess__menu" @click.stop @keydown.enter.stop @keydown.space.stop>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    x-show="session.status !== 'in-progress'"
                    @click="menuId = ''; setStatus(session.id, 'in-progress')"
                  >
                    <span x-text="labels.resume"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    x-show="session.status !== 'completed'"
                    @click="menuId = ''; setStatus(session.id, 'completed')"
                  >
                    <span x-text="labels.markComplete"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    @click="menuId = ''; duplicateSession(session.id)"
                  >
                    <span x-text="labels.duplicate"></span>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    class="sess__menu-item"
                    @click="menuId = ''; openMove(session.id)"
                  >
                    <span x-text="labels.moveDate"></span>
                  </Button>
                </div>
              </template>
            </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state: no sessions at all ── */}
    <template x-if="!hasSessions">
      <Card>
        <EmptyState
          iconName="dumbbell"
          title={L.sessions.emptyTitle}
          description={L.sessions.emptyDesc}
          actionLabel={L.sessions.createAction}
          actionHref={localizedPath("/seances/creer")}
        />
      </Card>
    </template>

    {/* ── Empty state: no results matching search ── */}
    <template x-if="hasSessions && filtered.length === 0">
      <Card>
        <div class="sess__empty-cta">
          <h3 class="sess__empty-title" x-text="labels.noResult">{L.sessions.noResult}</h3>
          <p class="sess__empty-text" x-text="labels.noMatchPrefix + ' « ' + search + ' ».'">
            {L.sessions.noMatchPrefix} « <span x-text="search"></span> ».
          </p>
          <button
            type="button"
            class="sess__reset-btn"
            @click="search = ''"
            x-text="labels.resetSearch"
          >
            {L.sessions.resetSearch}
          </button>
        </div>
      </Card>
    </template>

    {/* ── Backdrop for the quick-actions menu ── */}
    <div
      class="sess__menu-backdrop"
      x-show="menuId !== ''"
      x-cloak
      @click="menuId = ''"
    ></div>

    {/* ── Move session dialog ── */}
    <Dialog id="sess-move-dialog" title={L.sessions.moveTitle}>
      <label class="sess__move-field">
        <span class="sess__move-label">{L.sessions.moveDateLabel}</span>
        <input
          type="date"
          class="sess__move-input"
          x-model="moveDate"
          :max="todayIso"
        />
      </label>
      <div slot="footer">
        <button
          type="button"
          data-dialog-close
          class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-sm)] font-semibold transition-all duration-[160ms] select-none whitespace-nowrap active:scale-[0.97] bg-transparent text-muted border border-border hover:text-white hover:border-white/20 h-12 px-5 text-[1.3rem] min-w-[8rem]"
        >
          {L.common.cancel}
        </button>
        <button
          type="button"
          class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-sm)] font-semibold transition-all duration-[160ms] select-none whitespace-nowrap active:scale-[0.97] bg-accent text-accent-foreground border border-accent/45 hover:bg-accent-hover hover:brightness-110 h-12 px-5 text-[1.3rem] min-w-[8rem]"
          :disabled="!moveDate"
          @click="confirmMove()"
        >
          {L.sessions.move}
        </button>
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getSessionById,
    saveSession,
    updateSession,
    deleteSession,
    type Session,
    type SessionMood,
    type SessionStatus,
  } from '../../lib/storage';
  import { t, localizedPath } from '../../i18n';
  import { formatDateTime as formatDate, formatVolume } from '../../lib/format';
  import { statusLabel as statusLabelFn, type StatusLabels } from '../../lib/session-utils';
  import { moodSvg } from '../../lib/mood';

  const LABELS = t();
  const statusLabels: StatusLabels = { completed: LABELS.sessions.completed, inProgress: LABELS.sessions.inProgress, planned: LABELS.sessions.planned };
  function statusLabel(status: SessionStatus): string { return statusLabelFn(status, statusLabels); }

  function moodEmojiFn(mood: SessionMood | undefined | null): string {
    return moodSvg(mood);
  }

  function moodLabelFn(mood: SessionMood | undefined | null): string {
    if (!mood) return '';
    if (mood === 'great') return LABELS.sessions.moodGreat;
    if (mood === 'good') return LABELS.sessions.moodGood;
    if (mood === 'ok') return LABELS.sessions.moodOk;
    if (mood === 'tired') return LABELS.sessions.moodTired;
    return LABELS.sessions.moodBad;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionsApp', () => ({
      // ── State ──
      sessions: [] as Session[],
      search: '',
      menuId: '',
      moveSessionId: '',
      moveDate: '',
      labels: {
        exoPlural: LABELS.sessions.exoPlural,
        exoSingular: LABELS.sessions.exoSingular,
        moodLabel: LABELS.sessions.moodLabel,
        noResult: LABELS.sessions.noResult,
        noMatchPrefix: LABELS.sessions.noMatchPrefix,
        resetSearch: LABELS.sessions.resetSearch,
        noSession: LABELS.sessions.noSession,
        noMatch: LABELS.sessions.noMatch,
        seanceSingular: LABELS.sessions.seanceSingular,
        seancePlural: LABELS.sessions.seancePlural,
        pluralS: LABELS.sessions.pluralS,
        deleteConfirm: LABELS.sessions.deleteConfirm,
        seenAriaPrefix: LABELS.sessions.seenAriaPrefix,
        moreActions: LABELS.sessions.moreActions,
        resume: LABELS.sessions.resume,
        markComplete: LABELS.sessions.markComplete,
        duplicate: LABELS.sessions.duplicate,
        moveDate: LABELS.sessions.moveDate,
      },

      get todayIso(): string {
        return new Date().toISOString().slice(0, 10);
      },

      // ── Init ──
      init() {
        this.refresh();
      },

      refresh() {
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
      },

      // ── Derived ──
      get filtered(): Session[] {
        const q = this.search.trim().toLowerCase();
        if (!q) return this.sessions;
        return this.sessions.filter((s) =>
          s.name.toLowerCase().includes(q),
        );
      },

      get countLabel(): string {
        const n = this.filtered.length;
        if (n === 0) return this.sessions.length === 0 ? this.labels.noSession : this.labels.noMatch;
        return `${n} ${this.labels.seanceSingular}${n > 1 ? this.labels.pluralS : ''}`;
      },

      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      // ── Computations ──
      totalVolume(session: Session): number {
        return session.exercises.reduce(
          (sum, ex) =>
            sum + ex.sets.reduce(
              (s, set) => s + (set.completed ? set.weight * set.reps : 0),
              0,
            ),
          0,
        );
      },

      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDate(iso);
      },

      formatVolume(volume: number): string {
        return formatVolume(volume);
      },

      moodEmoji(mood: SessionMood | undefined | null) {
        return moodEmojiFn(mood);
      },

      moodLabel(mood: SessionMood | undefined | null) {
        return moodLabelFn(mood);
      },

      /** Most frequent muscle across the session's exercises ('' when none). */
      primaryMuscle(session: Session): string {
        const counts = new Map<string, number>();
        for (const ex of session.exercises) {
          if (!ex.muscle) continue;
          counts.set(ex.muscle, (counts.get(ex.muscle) ?? 0) + 1);
        }
        let best = '';
        let bestCount = 0;
        for (const [muscle, count] of counts) {
          if (count > bestCount) {
            best = muscle;
            bestCount = count;
          }
        }
        return best;
      },

      /** Translated stored muscle group for display (FR stays as-is). */
      muscleLabel(name: string): string {
        const tr = (window as { trMuscle?: (m: string) => string }).trMuscle;
        return tr ? tr(name) : name;
      },

      // ── Actions ──
      navigateTo(id: string) {
        window.location.href = localizedPath('/seances/detail?id=' + encodeURIComponent(id));
      },

      deleteSession(id: string) {
        // eslint-disable-next-line no-alert
        if (window.confirm(this.labels.deleteConfirm)) {
          deleteSession(id);
          this.sessions = this.sessions.filter((s) => s.id !== id);
        }
      },

      // ── Quick actions ──
      setStatus(id: string, status: SessionStatus) {
        updateSession(id, { status });
        this.refresh();
      },

      duplicateSession(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        const copy: Omit<Session, 'id'> = {
          name: src.name + ' ' + LABELS.sessions.copySuffix,
          date: new Date().toISOString(),
          status: 'planned',
          exercises: src.exercises.map((ex) => ({
            ...ex,
            sets: ex.sets.map((set) => ({ ...set, completed: false })),
          })),
        };
        if (src.supersets) copy.supersets = src.supersets.map((g) => ({ ...g }));
        saveSession(copy);
        this.refresh();
      },

      openMove(id: string) {
        const src = getSessionById(id);
        if (!src) return;
        this.moveSessionId = id;
        this.moveDate = (src.date || '').slice(0, 10);
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).openDialog?.('sess-move-dialog');
      },

      confirmMove() {
        if (!this.moveSessionId || !this.moveDate) return;
        const date = new Date(this.moveDate + 'T12:00:00').toISOString();
        updateSession(this.moveSessionId, { date, status: 'planned' });
        this.moveSessionId = '';
        this.moveDate = '';
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).closeDialog?.('sess-move-dialog');
        this.refresh();
      },
    }));
  });
</script>

<style>
  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .sess {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  /* ════════════════════════════════════════════════════
     TOOLBAR — search
     ════════════════════════════════════════════════════ */
  .sess__toolbar {
    margin-bottom: 2rem;
  }

  .sess__search {
    position: relative;
    width: 100%;
    max-width: 44rem;
  }

  .sess__search-icon {
    position: absolute;
    top: 50%;
    left: 1.4rem;
    transform: translateY(-50%);
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-muted);
    pointer-events: none;
  }

  /* Search field renders via the Input primitive (child component), so
     the scoped override must target it with :global(). */
  .sess__search :global(.sess__search-input) {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.6rem 0 4.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    line-height: 1.2;
    -webkit-appearance: none;
    appearance: none;
  }

  .sess__search :global(.sess__search-input)::placeholder {
    color: var(--alpha-text-faint);
  }

  .sess__search :global(.sess__search-input)::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  /* ════════════════════════════════════════════════════
     META — count label
     ════════════════════════════════════════════════════ */
  .sess__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.6rem;
  }

  .sess__count {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  /* ════════════════════════════════════════════════════
     GRID — 1 / 2 / 3 columns
     ════════════════════════════════════════════════════ */
  .sess__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  @media (min-width: 640px) {
    .sess__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sess__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ════════════════════════════════════════════════════
     CARD
     ════════════════════════════════════════════════════ */
  .sess__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2rem;
    background-color: var(--surface-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: border-color var(--transition-base),
                box-shadow var(--transition-base),
                transform var(--transition-base);
  }

  /* Hover arrow indicator */
  .sess__card::after {
    content: '→';
    position: absolute;
    top: 1.8rem;
    right: 1.6rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-base), transform var(--transition-base);
    pointer-events: none;
  }

  .sess__card:hover:not(:has(.sess__menu)) {
    background-color: var(--surface-panel-elevated);
    border-color: var(--alpha-border);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }

  .sess__card:hover::after {
    opacity: 0.7;
    transform: translateX(0);
  }

  .sess__card:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .sess__card:focus-visible::after {
    opacity: 0.7;
    transform: translateX(0);
  }

  /* Status signal: inline dot next to the name (no border stripe) */
  .sess__card--completed .sess__card-dot {
    background-color: var(--color-success);
  }
  .sess__card--in-progress .sess__card-dot {
    background-color: var(--color-info);
  }
  .sess__card--planned .sess__card-dot {
    background-color: var(--color-muted);
  }

  /* ── Card head ── */
  .sess__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }

  .sess__card-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  /* Icon disc — matches the dashboard KPI discs (2.8rem tinted circle) */
  .sess__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background-color: var(--alpha-bg-subtle);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .sess__card-icon svg {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }

  .sess__card-name-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1;
  }

  .sess__card-dot {
    width: 1.0rem;
    height: 1.0rem;
    border-radius: 50%;
    background-color: var(--color-muted);
    flex-shrink: 0;
  }

  .sess__card-name {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    word-break: break-word;
    /* leave room for the hover arrow on the right */
    padding-right: 1.6rem;
  }

  /* ── Mood indicator (next to the session name) ── */
  .sess__mood-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    cursor: help;
  }

  .sess__mood-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    color: var(--color-text);
  }

  .sess__mood-emoji svg {
    display: block;
  }

  .sess__card-date {
    font-size: 1.2rem;
    color: var(--color-muted);
    text-transform: capitalize;
    line-height: 1.3;
  }

  /* ── Card meta (icon + value + label rows) ── */
  .sess__card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 2rem;
    padding: 0.4rem 0 0.6rem;
  }

  .sess__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sess__meta-icon {
    color: var(--color-muted);
    flex-shrink: 0;
  }
  .sess__meta-icon svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .sess__meta-value {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

