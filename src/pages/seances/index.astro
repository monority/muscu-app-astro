---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card.astro';
---

<AppLayout title="Séances">
  <PageHeader
    title="Séances"
    description="Gérez et consultez vos séances d'entraînement."
    actionLabel="Nouvelle séance"
    actionHref="/seances/creer"
  />

  <Card>
    <EmptyState
      title="Aucune séance pour le moment"
      description="Commencez par créer votre première séance pour suivre vos performances."
      actionLabel="Créer une séance"
      actionHref="/seances/creer"
    />
  </Card>
</AppLayout>
