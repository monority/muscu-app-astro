---
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import { t, setLocale, defaultLocale, localizedPath } from '../../i18n';



setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.detail.title}>
  <div
    class="detail"
    x-data="sessionDetailApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Back link ── */}
    <a href={localizedPath("/seances")} class="detail__back">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span x-text="labels.backToSessions">{L.detail.backToSessions}</span>
    </a>

    {/* ── Not found state ── */}
    <template x-if="notFound">
      <Card>
        <div class="detail__error">
          <div class="detail__error-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h2 class="detail__error-title" x-text="labels.notFound">{L.detail.notFound}</h2>
          <p class="detail__error-text" x-text="labels.notFoundDesc">
            {L.detail.notFoundDesc}
          </p>
          <a href={localizedPath("/seances")} class="detail__error-link" x-text="labels.viewAllSessions">
            {L.detail.viewAllSessions}
          </a>
        </div>
      </Card>
    </template>

    {/* ── Loaded session ── */}
    <template x-if="!notFound && session">
      <div class="detail__content">
        {/* Header */}
        <header class="detail__header">
          <div class="detail__header-row">
            <h1 class="detail__title" x-text="session.name"></h1>
            <span
              class="detail__badge"
              :class="'detail__badge--' + session.status"
              x-text="statusLabel(session.status)"
            ></span>
          </div>
          <div
            class="detail__date"
            x-text="formatDateTime(session.date)"
          ></div>
        </header>

        <div class="detail__status-picker">
          <label class="detail__status-label" x-text="labels.statusLabel">{L.detail.statusLabel}</label>
          <div class="detail__status-options" role="radiogroup" aria-label={L.detail.statusAria}>
            <button
              type="button"
              class="detail__status-btn"
              :class="{ 'is-active': session.status === 'planned' }"
              :aria-pressed="session.status === 'planned'"
              @click="updateStatus('planned')"
            >
              <span class="detail__status-dot detail__status-dot--planned" aria-hidden="true"></span>
              <span x-text="labels.planned">{L.detail.planned}</span>
            </button>
            <button
              type="button"
              class="detail__status-btn"
              :class="{ 'is-active': session.status === 'in-progress' }"
              :aria-pressed="session.status === 'in-progress'"
              @click="updateStatus('in-progress')"
            >
              <span class="detail__status-dot detail__status-dot--in-progress" aria-hidden="true"></span>
              <span x-text="labels.inProgress">{L.detail.inProgress}</span>
            </button>
            <button
              type="button"
              class="detail__status-btn"
              :class="{ 'is-active': session.status === 'completed' }"
              :aria-pressed="session.status === 'completed'"
              @click="updateStatus('completed')"
            >
              <span class="detail__status-dot detail__status-dot--completed" aria-hidden="true"></span>
              <span x-text="labels.completed">{L.detail.completed}</span>
            </button>
          </div>
        </div>

        {/* Stats grid */}
        <div class="detail__stats">
          <div class="detail__stat">
            <div class="detail__stat-label">
              <svg
                class="detail__stat-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span x-text="labels.duration">{L.detail.duration}</span>
            </div>
            <div
              class="detail__stat-value"
              x-text="formatDuration(session.duration)"
            ></div>
          </div>
          <div class="detail__stat">
            <div class="detail__stat-label">
              <svg
                class="detail__stat-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6.5 6.5h11"></path>
                <path d="M6.5 17.5h11"></path>
                <path d="M3 9v6"></path>
                <path d="M21 9v6"></path>
                <path d="M6.5 6.5 3 9v6l3.5 2.5h11L21 15V9l-3.5-2.5Z"></path>
              </svg>
              <span x-text="labels.totalVolume">{L.detail.totalVolume}</span>
            </div>
            <div
              class="detail__stat-value"
              x-text="formatVolume(sessionTotalVolume)"
            ></div>
          </div>
          <div class="detail__stat">
            <div class="detail__stat-label">
              <svg
                class="detail__stat-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <span x-text="labels.exercises">{L.detail.exercises}</span>
            </div>
            <div
              class="detail__stat-value"
              x-text="session.exercises.length"
            ></div>
          </div>
        </div>

        {/* Actions */}
        <div class="detail__actions">
          {/* ── Partager (génère une image téléchargeable) ── */}
          <button
            type="button"
            class="detail__btn detail__btn--accent"
            @click="generateShareCard()"
            aria-label={L.detail.shareAria}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="detail__btn-icon"
              aria-hidden="true"
            >
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span x-text="labels.share">{L.detail.share}</span>
          </button>

          {/* ── Comparer (lien vers la page de comparaison) ── */}
          <a
            class="detail__btn detail__btn--secondary"
            :href="`/seances/comparer?id1=${session?.id || ''}`"
            :aria-disabled="!session?.id"
            aria-label={L.detail.compareAria}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="detail__btn-icon"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="12" y1="3" x2="12" y2="21"></line>
            </svg>
            <span x-text="labels.compare">{L.detail.compare}</span>
          </a>

          <button
            type="button"
            class="detail__btn detail__btn--secondary"
            disabled
            title={L.detail.comingSoon}
            aria-label={L.detail.editAria}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="detail__btn-icon"
              aria-hidden="true"
            >
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span x-text="labels.edit">{L.detail.edit}</span>
          </button>
          <button
            type="button"
            class="detail__btn detail__btn--destructive"
            @click="openDeleteDialog"
            aria-label={L.detail.deleteAria}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="detail__btn-icon"
              aria-hidden="true"
            >
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
              <path d="M10 11v6"></path>
              <path d="M14 11v6"></path>
              <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
            </svg>
            <span x-text="labels.delete">{L.detail.delete}</span>
          </button>
        </div>

        {/* RPE-based progression suggestions (added 2026-08-04) */}
        <template x-if="session.status === 'completed' && rpeSuggestion">
          <section class="detail__suggestion">
            <h2 class="detail__section-title" x-text="labels.suggestionTitle">{L.detail.suggestionTitle}</h2>
            <Card>
              <div
                class="suggestion"
                :class="'suggestion--' + rpeSuggestion.tone"
              >
                <div class="suggestion__icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 2v4"></path>
                    <path d="M12 18v4"></path>
                    <path d="M4.93 4.93l2.83 2.83"></path>
                    <path d="M16.24 16.24l2.83 2.83"></path>
                    <path d="M2 12h4"></path>
                    <path d="M18 12h4"></path>
                    <path d="M4.93 19.07l2.83-2.83"></path>
                    <path d="M16.24 7.76l2.83-2.83"></path>
                  </svg>
                </div>
                <div class="suggestion__body">
                  <div class="suggestion__headline" x-text="rpeSuggestion.headline"></div>
                  <p class="suggestion__detail" x-text="rpeSuggestion.detail"></p>
                  <div class="suggestion__meta">
                    <span>
                      <span x-text="labels.rpeAvg">{L.detail.rpeAvg}</span>
                      <strong x-text="formatRpe(rpeStats.avg)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.rpeMax">{L.detail.rpeMax}</span>
                      <strong x-text="formatRpe(rpeStats.max)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.setsAnalyzed">{L.detail.setsAnalyzed}</span>
                      <strong x-text="rpeStats.count"></strong>
                    </span>
                  </div>
                </div>
              </div>
            </Card>
          </section>
        </template>

        {/* Session notes (RPE / fatigue / mood / free text) */}
        <template x-if="hasNotes">
          <section class="detail__notes">
            <h2 class="detail__section-title" x-text="labels.notesTitle">{L.detail.notesTitle}</h2>
            <Card>
              <div class="notes">
                {/* RPE badge */}
                <div class="notes__item" x-show="session.rpe != null">
                  <div class="notes__label" x-text="labels.rpe">{L.detail.rpe}</div>
                  <div class="notes__value">
                    <span
                      class="notes__rpe"
                      :class="'notes__rpe--' + rpeTone(session.rpe)"
                    >
                      <span class="notes__rpe-num" x-text="session.rpe"></span>
                      <span class="notes__rpe-sep">/ 10</span>
                    </span>
                    <span
                      class="notes__rpe-label"
                      x-text="rpeLabel(session.rpe)"
                    ></span>
                  </div>
                </div>

                {/* Fatigue */}
                <div class="notes__item" x-show="session.fatigue && session.fatigue > 0">
                  <div class="notes__label">{L.detail.fatigue}</div>
                  <div class="notes__value">
                    <div class="notes__fatigue" aria-label={L.detail.fatigueAria}>
                      <template x-for="i in 5" :key="'d-fat-' + i">
                        <span
                          class="notes__fatigue-icon"
                          :class="{ 'is-active': session.fatigue >= i }"
                          aria-hidden="true"
                        >
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                        </span>
                      </template>
                    </div>
                    <span class="notes__fatigue-label" x-text="fatigueLabel(session.fatigue)"></span>
                  </div>
                </div>

                {/* Mood */}
                <div class="notes__item" x-show="session.mood">
                  <div class="notes__label">{L.sessions.moodLabel}</div>
                  <div class="notes__value">
                    <span
                      class="notes__mood"
                      :class="'notes__mood--' + session.mood"
                    >
                      <span class="notes__mood-emoji" x-html="moodEmoji(session.mood)"></span>
                      <span class="notes__mood-label" x-text="moodLabel(session.mood)"></span>
                    </span>
                  </div>
                </div>

                {/* Free-text notes */}
                <div class="notes__item notes__item--text" x-show="session.notes && session.notes.trim() !== ''">
                  <div class="notes__label">{L.detail.notes}</div>
                  <p class="notes__text" x-text="session.notes"></p>
                </div>
              </div>
            </Card>
          </section>
        </template>

        {/* Exercises */}
        <section class="detail__exercises">
          <h2 class="detail__section-title">{L.detail.exercises}</h2>

          <template x-if="session.exercises.length === 0">
            <Card>
              <p class="detail__no-exercises">
                {L.detail.noExercises}
              </p>
            </Card>
          </template>

          <template x-for="(ex, exIdx) in session.exercises" :key="exIdx">
            <Card>
              <article class="exo-row">
                <header class="exo-row__head">
                  <h3 class="exo-row__name" x-text="trExercise(ex.name)"></h3>
                  <div class="exo-row__head-actions">
                    <button
                      type="button"
                      class="exo-row__rest"
                      @click="startRestTimer(ex.name)"
                      :aria-label="'{L.detail.startRestFor}' + ex.name"
                      :title="'{L.detail.recommendedRest}' + formatRestTime(getRestTime(ex.name))"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span x-text="labels.startRest">{L.detail.startRest}</span>
                      <span class="exo-row__rest-time" x-text="formatRestTime(getRestTime(ex.name))"></span>
                    </button>
                    <span class="exo-row__muscle" x-text="trMuscle(ex.muscle)"></span>
                  </div>
                </header>

                <div class="exo-row__stats">
                  <div class="exo-row__stat">
                    <span class="exo-row__stat-label">{L.sessions.volume}</span>
                    <span
                      class="exo-row__stat-value"
                      x-text="formatVolume(exerciseVolume(ex))"
                    ></span>
                  </div>
                  <div class="exo-row__stat">
                    <span class="exo-row__stat-label">{L.detail.best1RM}</span>
                    <span
                      class="exo-row__stat-value"
                      x-text="formatVolume(best1RM(ex))"
                    ></span>
                  </div>
                  <div class="exo-row__stat">
                    <span class="exo-row__stat-label">{L.detail.sets}</span>
                    <span
                      class="exo-row__stat-value"
                      x-text="ex.sets.length"
                    ></span>
                  </div>
                </div>

                <div
                  class="exo-row__table-wrap"
                  x-show="ex.sets.length > 0"
                >
                  <table class="exo-row__table">
                    <thead>
                      <tr>
                        <th scope="col">#</th>
                        <th scope="col">{L.detail.colType}</th>
                        <th scope="col">{L.detail.colWeight}</th>
                        <th scope="col">{L.detail.colReps}</th>
                        <th scope="col">RPE</th>
                        <th scope="col" class="exo-row__th-end">{L.detail.statusLabel}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="set in ex.sets" :key="set.setNumber">
                        <tr
                          class="exo-row__tr"
                          :class="{ 'is-completed': set.completed }"
                        >
                          <td class="exo-row__num" x-text="set.setNumber"></td>
                          <td>
                            <span
                              class="exo-row__type"
                              :class="'exo-row__type--' + set.type"
                              x-text="typeLabel(set.type)"
                            ></span>
                          </td>
                          <td class="exo-row__num" x-text="formatWeight(set.weight)"></td>
                          <td class="exo-row__num" x-text="set.reps"></td>
                          <td x-text="set.rpe != null ? formatRpe(set.rpe) : '—'"></td>
                          <td class="exo-row__td-end">
                            <svg
                              x-show="set.completed"
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              class="exo-row__check"
                              aria-label={L.detail.setCompleted}
                            >
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span
                              x-show="!set.completed"
                              class="exo-row__dash"
                              aria-label={L.detail.setNotCompleted}
                            >—</span>
                          </td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
                <p
                  class="exo-row__no-sets"
                  x-show="ex.sets.length === 0"
                >
                  {L.detail.noSets}
                </p>
              </article>
            </Card>
          </template>
        </section>
      </div>
    </template>

    {/* ════════════════════════════════════════════════════
        REST TIMER WIDGET (added 2026-08-04)
        Same widget as the session builder — pops up at the
        bottom of the page when the user triggers a rest from
        an exercise header. Duration is sourced from
        `getRestTime(name)` so it matches the per-exercise
        recommendation used elsewhere.
        ════════════════════════════════════════════════════ */}
    <div
      class="detail__rest-timer"
      x-show="restTimer.active"
      x-cloak
      x-transition.opacity.duration.180ms
      role="status"
      aria-live="polite"
    >
      <div class="detail__rest-timer-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="detail__rest-timer-body">
        <div class="detail__rest-timer-label" x-text="restTimerLabel()"></div>
        <div
          class="detail__rest-timer-readout"
          :class="{ 'is-done': restTimerDone }"
          x-text="restTimerDisplay()"
        ></div>
      </div>
      <button
        type="button"
        class="detail__rest-timer-skip"
        @click="dismissRestTimer()"
        :aria-label="restTimerDone ? labels.closeRestTimer : labels.skipRest"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span x-text="restTimerDone ? labels.close : labels.skip"></span>
      </button>
    </div>

    <Dialog
      id="delete-session-dialog"
      title={L.detail.confirmDelete}
    >
      <p class="detail__confirm-text">
        {L.detail.confirmDeleteIntro}
        <strong x-text="session ? session.name : '{L.detail.thisSession}'"></strong>.
        {L.detail.irreversible}
      </p>

      <div slot="footer">
        <button
          type="button"
          class="detail__btn detail__btn--secondary"
          data-dialog-close
        >
          {L.common.cancel}
        </button>
        <button
          type="button"
          class="detail__btn detail__btn--destructive"
          @click="confirmDelete"
        >
          {L.detail.deletePermanently}
        </button>
      </div>
    </Dialog>

    {/* ════════════════════════════════════════════════════
        HIDDEN SHARE CARD
        DOM reference for the shareable image. The actual PNG
        is generated by generateShareCard() via the canvas API,
        but this hidden element keeps the markup in one place
        and lets the structure be inspected/edited.
        ════════════════════════════════════════════════════ */}
    <div
      id="share-card"
      class="share-card"
      x-show="false"
      aria-hidden="true"
    >
      <div class="share-card__inner">
        <header class="share-card__header">
          <span class="share-card__logo">muscu.app</span>
          <span
            class="share-card__date"
            x-text="formatShareDate(session?.date)"
          ></span>
        </header>
        <h2 class="share-card__title" x-text="session?.name"></h2>
        <div class="share-card__stats">
          <div class="share-card__stat">
            <span
              class="share-card__stat-value"
              x-text="session?.exercises?.length || 0"
            ></span>
            <span class="share-card__stat-label">{L.detail.exercises}</span>
          </div>
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="totalSets"></span>
            <span class="share-card__stat-label">{L.detail.sets}</span>
          </div>
          <div class="share-card__stat">
            <span
              class="share-card__stat-value"
              x-text="formatVolume(sessionTotalVolume)"
            ></span>
            <span class="share-card__stat-label">{L.sessions.volume}</span>
          </div>
        </div>
        <div class="share-card__exercises">
          <template x-for="ex in session?.exercises || []" :key="ex.exerciseId">
            <div class="share-card__exercise">
              <span x-text="trExercise(ex.name)"></span>
              <span
                x-text="`${ex.sets.length} ${ex.sets.length > 1 ? labels.setPlural : labels.setSingular}`"
              ></span>
            </div>
          </template>
        </div>
        <div class="share-card__footer">
          {L.detail.shareFooter}
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSessionById,
    updateSession,
    deleteSession,
    calculate1RM,
    type Session,
    type SessionExercise,
    type SessionMood,
    type SessionStatus,
    type SetType,
  } from '../../lib/storage';
  import { getRestTime, formatRestTime } from '../../lib/rest-times';
  import { playBeep } from '../../lib/sound';
  import { t, localizedPath } from '../../i18n';

  const LABELS = t();

  // ── Pure helpers (module scope) ────────────────────────────
  function statusLabelFn(s: SessionStatus): string {
    if (s === 'completed') return LABELS.detail.completed;
    if (s === 'in-progress') return LABELS.detail.inProgress;
    return LABELS.detail.planned;
  }

  function typeLabelFn(t: SetType): string {
    switch (t) {
      case 'warmup': return LABELS.detail.typeWarmup;
      case 'work':   return LABELS.detail.typeWork;
      case 'top':    return LABELS.detail.typeTop;
      case 'drop':   return LABELS.detail.typeDrop;
      case 'failure': return LABELS.detail.typeFailure;
    }
  }

  function formatDateTimeFn(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const date = d.toLocaleDateString('fr-FR', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    const time = d.toLocaleTimeString('fr-FR', {
      hour: '2-digit',
      minute: '2-digit',
    });
    // Capitalize first letter
    const cap = date.charAt(0).toUpperCase() + date.slice(1);
    return cap + ' ' + LABELS.detail.at + ' ' + time;
  }

  function formatDurationFn(seconds?: number): string {
    if (!seconds || seconds <= 0) return '—';
    const total = Math.floor(seconds);
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    if (h > 0) {
      return `${h}h ${m.toString().padStart(2, '0')}m`;
    }
    if (m > 0) {
      return `${m}m ${s.toString().padStart(2, '0')}s`;
    }
    return `${s}s`;
  }

  function formatVolumeFn(v: number): string {
    if (!Number.isFinite(v) || v <= 0) return '0 kg';
    return Math.round(v).toLocaleString('fr-FR') + ' kg';
  }

  function formatWeightFn(w: number): string {
    if (!Number.isFinite(w) || w <= 0) return '0 kg';
    return Math.round(w).toLocaleString('fr-FR') + ' kg';
  }

  function formatRpeFn(rpe: number): string {
    if (!Number.isFinite(rpe)) return '—';
    return rpe.toString();
  }

  // ── Notes helpers (added 2026-08-04) ───────────────────────
  function rpeToneFn(rpe: number | undefined | null): 'easy' | 'moderate' | 'hard' | 'max' | 'none' {
    if (rpe == null || !Number.isFinite(rpe)) return 'none';
    if (rpe <= 3) return 'easy';
    if (rpe <= 6) return 'moderate';
    if (rpe <= 8) return 'hard';
    return 'max';
  }

  function rpeLabelFn(rpe: number | undefined | null): string {
    const tone = rpeToneFn(rpe);
    if (tone === 'easy') return LABELS.detail.rpeEasy;
    if (tone === 'moderate') return LABELS.detail.rpeModerate;
    if (tone === 'hard') return LABELS.detail.rpeHard;
    if (tone === 'max') return LABELS.detail.rpeMaxTone;
    return '—';
  }

  function fatigueLabelFn(level: number | undefined | null): string {
    if (!level || level <= 0) return '—';
    if (level === 1) return LABELS.detail.fatigueVeryFresh;
    if (level === 2) return LABELS.detail.fatigueFresh;
    if (level === 3) return LABELS.detail.fatigueNormal;
    if (level === 4) return LABELS.detail.fatigueTired;
    return LABELS.detail.fatigueExhausted;
  }

  // Mood helpers return inline Lucide SVG markup so they can be
  // rendered via x-html. Stroke + color are inherited from
  // the .notes__mood--* modifier on the parent pill.
  const MOOD_SVG_ATTRS = 'viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
  const MOOD_SMILE  = `<svg ${MOOD_SVG_ATTRS}><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`;
  const MOOD_HEART  = `<svg ${MOOD_SVG_ATTRS}><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
  const MOOD_MEH    = `<svg ${MOOD_SVG_ATTRS}><circle cx="12" cy="12" r="10"/><line x1="8" y1="15" x2="16" y2="15"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`;
  const MOOD_FROWN  = `<svg ${MOOD_SVG_ATTRS}><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`;
  const MOOD_BED    = `<svg ${MOOD_SVG_ATTRS}><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>`;

  function moodEmojiFn(mood: SessionMood | undefined | null): string {
    if (!mood) return '';
    if (mood === 'great') return MOOD_SMILE;
    if (mood === 'good') return MOOD_HEART;
    if (mood === 'ok') return MOOD_MEH;
    if (mood === 'tired') return MOOD_FROWN;
    return MOOD_BED;
  }

  function moodLabelFn(mood: SessionMood | undefined | null): string {
    if (!mood) return '';
    if (mood === 'great') return LABELS.sessions.moodGreat;
    if (mood === 'good') return LABELS.sessions.moodGood;
    if (mood === 'ok') return LABELS.sessions.moodOk;
    if (mood === 'tired') return LABELS.sessions.moodTired;
    return LABELS.sessions.moodBad;
  }

  function hasNotesFn(s: Session | null): boolean {
    if (!s) return false;
    return (
      (s.rpe != null && Number.isFinite(s.rpe)) ||
      (s.fatigue != null && s.fatigue > 0) ||
      (s.mood != null && s.mood !== '') ||
      (s.notes != null && s.notes.trim() !== '')
    );
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('sessionDetailApp', () => ({
      // ── State ──
      labels: LABELS.detail,
      session: null as Session | null,
      sessionId: '',
      notFound: false,

      // ── Rest timer (added 2026-08-04) ──
      // User can re-trigger the per-exercise rest time from the
      // detail view (e.g. for a live workout replay). The duration
      // is sourced from `getRestTime(name)` so it matches the
      // value the session builder uses.
      restTimer: {
        active: false,
        exerciseName: '' as string,
        duration: 0,
        remaining: 0,
        intervalId: null as number | null,
        endTime: 0,
      },

      // ── Init ──
      init() {
        const params = new URLSearchParams(window.location.search);
        this.sessionId = params.get('id') || '';
        if (!this.sessionId) {
          this.notFound = true;
          return;
        }
        const found = getSessionById(this.sessionId);
        if (!found) {
          this.notFound = true;
          return;
        }
        this.session = found;
      },

      // ── Computed ──
      get sessionTotalVolume(): number {
        if (!this.session) return 0;
        return this.session.exercises.reduce(
          (sum, ex) => sum + this.exerciseVolume(ex),
          0,
        );
      },

      get totalSets(): number {
        if (!this.session) return 0;
        return this.session.exercises.reduce(
          (sum, ex) => sum + ex.sets.length,
          0,
        );
      },

      get hasNotes(): boolean {
        return hasNotesFn(this.session);
      },

      /**
       * Aggregates RPE values across the whole session (completed sets
       * only). Returns count=0 when no RPE is recorded → the suggestion
       * UI stays hidden.
       */
      get rpeStats(): { count: number; avg: number; max: number } {
        if (!this.session) return { count: 0, avg: 0, max: 0 };
        let count = 0;
        let sum = 0;
        let max = 0;
        let allTen = true;
        for (const ex of this.session.exercises) {
          for (const set of ex.sets) {
            if (!set.completed) continue;
            if (set.rpe == null || !Number.isFinite(set.rpe)) continue;
            count += 1;
            sum += set.rpe;
            if (set.rpe > max) max = set.rpe;
            if (set.rpe < 10) allTen = false;
          }
        }
        if (count === 0) return { count: 0, avg: 0, max: 0 };
        return { count, avg: sum / count, max, allTen };
      },

      /**
       * Returns the headline + detail + tone for the suggestion card,
       * or null when no actionable advice can be given.
       */
      get rpeSuggestion(): { headline: string; detail: string; tone: 'up' | 'maintain' | 'down' } | null {
        const stats = this.rpeStats;
        if (stats.count === 0) return null;
        // Highest priority: every set hit a perfect 10 → back off.
        if ((stats as { allTen?: boolean }).allTen) {
          return {
            headline: LABELS.detail.suggestionAllTenHeadline,
            detail: LABELS.detail.suggestionAllTenDetail,
            tone: 'down',
          };
        }
        if (stats.avg < 6) {
          return {
            headline: LABELS.detail.suggestionIncreaseHeadline,
            detail: LABELS.detail.suggestionIncreaseDetail,
            tone: 'up',
          };
        }
        if (stats.avg > 8) {
          return {
            headline: LABELS.detail.suggestionMaintainHeadline,
            detail: LABELS.detail.suggestionMaintainDetail,
            tone: 'maintain',
          };
        }
        // Middle ground — no actionable advice.
        return {
          headline: LABELS.detail.suggestionContinueHeadline,
          detail: LABELS.detail.suggestionContinueDetail,
          tone: 'maintain',
        };
      },

      // ── Helpers ──
      exerciseVolume(ex: SessionExercise): number {
        return ex.sets.reduce(
          (s, set) => s + (set.completed ? set.weight * set.reps : 0),
          0,
        );
      },

      best1RM(ex: SessionExercise): number {
        let best = 0;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          const e = calculate1RM(set.weight, set.reps);
          if (e > best) best = e;
        }
        return best;
      },

      statusLabel(s: SessionStatus): string {
        return statusLabelFn(s);
      },

      typeLabel(t: SetType): string {
        return typeLabelFn(t);
      },

      formatDateTime(iso: string): string {
        return formatDateTimeFn(iso);
      },

      formatDuration(seconds?: number): string {
        return formatDurationFn(seconds);
      },

      formatVolume(v: number): string {
        return formatVolumeFn(v);
      },

      formatWeight(w: number): string {
        return formatWeightFn(w);
      },

      formatRpe(rpe: number): string {
        return formatRpeFn(rpe);
      },

      /**
       * Long-form French date for the share card (no time, capitalised).
       * Falls back to the raw string if the input isn't a valid date.
       */
      formatShareDate(iso?: string): string {
        if (!iso) return '';
        const d = new Date(iso);
        if (isNaN(d.getTime())) return iso;
        const formatted = d.toLocaleDateString('fr-FR', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
        return formatted.charAt(0).toUpperCase() + formatted.slice(1);
      },

      rpeTone(rpe: number | undefined | null) {
        return rpeToneFn(rpe);
      },

      rpeLabel(rpe: number | undefined | null) {
        return rpeLabelFn(rpe);
      },

      fatigueLabel(level: number | undefined | null) {
        return fatigueLabelFn(level);
      },

      moodEmoji(mood: SessionMood | undefined | null) {
        return moodEmojiFn(mood);
      },

      moodLabel(mood: SessionMood | undefined | null) {
        return moodLabelFn(mood);
      },

      /**
       * Rest-time helpers — re-exposed on the component so the
       * template can bind `:title="'… ' + formatRestTime(getRestTime(ex.name))'"`
       * without re-importing the library in the markup.
       */
      getRestTime(name: string): number {
        return getRestTime(name);
      },
      formatRestTime(seconds: number): string {
        return formatRestTime(seconds);
      },

      // ── Actions ──
      updateStatus(status: SessionStatus) {
        if (!this.session) return;
        this.session.status = status;
        updateSession(this.session.id, { status });
      },

      // ── Rest timer (added 2026-08-04) ──
      /**
       * Starts the per-exercise rest timer. Mirrors the same logic
       * as the session builder: the duration comes from
       * `getRestTime(name)` and the widget label reads
       * "Repos — <name> (M:SS)".
       */
      startRestTimer(exerciseName: string) {
        this.cancelRestTimerTick();
        const duration = getRestTime(exerciseName);
        this.restTimer = {
          active: true,
          exerciseName,
          duration,
          remaining: duration,
          intervalId: null,
          endTime: Date.now() + duration * 1000,
        };
        this.restTimer.intervalId = window.setInterval(
          () => this.tickRestTimer(),
          1000,
        );
        this.tickRestTimer();
      },

      tickRestTimer() {
        const remainingMs = Math.max(0, this.restTimer.endTime - Date.now());
        const remainingSec = Math.ceil(remainingMs / 1000);
        this.restTimer.remaining = remainingSec;
        if (remainingMs <= 0) {
          this.cancelRestTimerTick();
          this.restTimer.remaining = 0;
          if (this.isSoundEnabled()) this.beep();
        }
      },

      cancelRestTimerTick() {
        if (this.restTimer.intervalId != null) {
          window.clearInterval(this.restTimer.intervalId);
        }
      },

      dismissRestTimer() {
        this.cancelRestTimerTick();
        this.restTimer = {
          active: false,
          exerciseName: '',
          duration: 0,
          remaining: 0,
          intervalId: null,
          endTime: 0,
        };
      },

      restTimerLabel(): string {
        if (!this.restTimer.active) return '';
        return `${LABELS.detail.restLabel}${this.restTimer.exerciseName} (${formatRestTime(this.restTimer.duration)})`;
      },

      restTimerDisplay(): string {
        if (!this.restTimer.active) return '0:00';
        return formatRestTime(this.restTimer.remaining);
      },

      get restTimerDone(): boolean {
        return this.restTimer.active && this.restTimer.remaining <= 0;
      },

      isSoundEnabled(): boolean {
        try {
          const raw = localStorage.getItem('muscu-settings');
          if (!raw) return true;
          const parsed = JSON.parse(raw);
          return parsed.soundAlerts !== false;
        } catch {
          return true;
        }
      },

      beep(): void {
        playBeep();
      },

      openDeleteDialog() {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).openDialog as
          | ((id: string) => void)
          | undefined;
        if (fn) fn('delete-session-dialog');
      },

      confirmDelete() {
        if (!this.session) return;
        const id = this.session.id;
        deleteSession(id);
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).closeDialog as
          | ((i: string) => void)
          | undefined;
        if (fn) fn('delete-session-dialog');
        window.location.href = localizedPath('/seances');
      },

      // ── Share image generation ──────────────────────
      // Builds a 1080×1080 PNG summary of the current session
      // and triggers a browser download. Pure canvas API — no
      // external dependencies. Font fallback chain uses Barlow
      // (loaded via globals.css) and falls back to system sans.
      async generateShareCard(): Promise<void> {
        if (!this.session) return;

        const session = this.session;
        const W = 1080;
        const H = 1080;
        const PAD = 80;

        const canvas = document.createElement('canvas');
        canvas.width = W;
        canvas.height = H;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        // ── Palette (matches the dark theme) ──
        const bg = '#050505';
        const surface = '#0F0F0F';
        const text = '#F6F6F6';
        const muted = '#9CA3AF';
        const accent = '#D97706';
        const border = 'rgba(255, 255, 255, 0.08)';
        const accentSoft = 'rgba(217, 119, 6, 0.15)';
        const fontCond = '"Barlow Condensed", "Barlow", sans-serif';
        const fontBody = '"Barlow", sans-serif';

        // ── Background ──
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, W, H);

        // ── Header: logo (left) + date (right) ──
        ctx.textBaseline = 'alphabetic';

        ctx.fillStyle = accent;
        ctx.font = `bold 42px ${fontCond}`;
        ctx.textAlign = 'left';
        ctx.fillText('muscu.app', PAD, 100);

        ctx.fillStyle = muted;
        ctx.font = `28px ${fontBody}`;
        ctx.textAlign = 'right';
        ctx.fillText(this.formatShareDate(session.date), W - PAD, 100);

        // Accent underline
        ctx.fillStyle = accent;
        ctx.fillRect(PAD, 130, 80, 4);

        // ── Title (truncated if too long) ──
        ctx.fillStyle = text;
        ctx.font = `bold 64px ${fontCond}`;
        ctx.textAlign = 'left';
        const title = this.truncateForCanvas(
          ctx,
          session.name,
          W - 2 * PAD,
        );
        ctx.fillText(title, PAD, 220);

        // ── Status badge ──
        const statusText = this.statusLabel(session.status).toUpperCase();
        ctx.font = `600 22px ${fontCond}`;
        const statusW = ctx.measureText(statusText).width;
        const badgeW = statusW + 32;
        const badgeH = 40;
        const badgeX = PAD;
        const badgeY = 248;

        ctx.fillStyle = accentSoft;
        this.drawRoundRect(ctx, badgeX, badgeY, badgeW, badgeH, 20);
        ctx.fill();

        ctx.fillStyle = accent;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(statusText, badgeX + badgeW / 2, badgeY + badgeH / 2);

        // Reset alignment for the rest of the layout
        ctx.textAlign = 'left';
        ctx.textBaseline = 'alphabetic';

        // ── Stat cards (3 across) ──
        const statsY = 360;
        const statsH = 150;
        const cardGap = 20;
        const cardW = (W - 2 * PAD - 2 * cardGap) / 3;

        const stats: ReadonlyArray<{ value: string; label: string }> = [
          { value: String(session.exercises.length), label: LABELS.detail.exercises.toUpperCase() },
          { value: String(this.totalSets), label: LABELS.detail.shareSetsLabel },
          { value: formatVolumeFn(this.sessionTotalVolume), label: LABELS.sessions.volume.toUpperCase() },
        ];

        stats.forEach((stat, i) => {
          const x = PAD + i * (cardW + cardGap);

          // Card background
          ctx.fillStyle = surface;
          this.drawRoundRect(ctx, x, statsY, cardW, statsH, 14);
          ctx.fill();

          // Card border
          ctx.strokeStyle = border;
          ctx.lineWidth = 1;
          this.drawRoundRect(ctx, x, statsY, cardW, statsH, 14);
          ctx.stroke();

          // Value (truncate to fit)
          ctx.fillStyle = accent;
          ctx.font = `bold 56px ${fontCond}`;
          ctx.textAlign = 'center';
          const value = this.truncateForCanvas(
            ctx,
            stat.value,
            cardW - 32,
          );
          ctx.fillText(value, x + cardW / 2, statsY + 78);

          // Label
          ctx.fillStyle = muted;
          ctx.font = `600 18px ${fontCond}`;
          ctx.fillText(stat.label, x + cardW / 2, statsY + 118);
        });

        ctx.textAlign = 'left';

        // ── Exercise list ──
        const sectionY = 580;

        ctx.fillStyle = muted;
        ctx.font = `700 22px ${fontCond}`;
        ctx.fillText(LABELS.detail.exercises.toUpperCase(), PAD, sectionY);

        // Divider line
        ctx.fillStyle = border;
        ctx.fillRect(PAD, sectionY + 16, W - 2 * PAD, 1);

        const listY = sectionY + 64;
        const rowH = 50;
        const maxVisible = 7;
        const visible = session.exercises.slice(0, maxVisible);
        const remaining = session.exercises.length - visible.length;

        ctx.font = `30px ${fontBody}`;

        visible.forEach((ex, i) => {
          const y = listY + i * rowH;

          // Name
          ctx.fillStyle = text;
          const name = this.truncateForCanvas(
            ctx,
            ex.name,
            W - 2 * PAD - 220,
          );
          ctx.fillText(name, PAD, y);

          // Sets count
          const n = ex.sets.length;
          ctx.fillStyle = muted;
          ctx.textAlign = 'right';
          ctx.fillText(
            `${n} ${n > 1 ? LABELS.detail.setPlural : LABELS.detail.setSingular}`,
            W - PAD,
            y,
          );
          ctx.textAlign = 'left';
        });

        if (remaining > 0) {
          const y = listY + visible.length * rowH;
          ctx.fillStyle = muted;
          ctx.font = `italic 28px ${fontBody}`;
          ctx.fillText(
            `+ ${remaining} ${remaining > 1 ? LABELS.detail.morePlural : LABELS.detail.moreSingular}`,
            PAD,
            y,
          );
        }

        // ── Footer ──
        ctx.fillStyle = muted;
        ctx.font = `24px ${fontBody}`;
        ctx.textAlign = 'center';
        ctx.fillText(LABELS.detail.shareFooter, W / 2, 1030);
        ctx.textAlign = 'left';

        // ── Download ──
        const datePart = (session.date || '').split('T')[0] || 'seance';
        const filename = `muscu-${datePart}.png`;

        canvas.toBlob((blob) => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = filename;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          // Release the blob URL once the download has had time to start
          window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        }, 'image/png');
      },

      /**
       * Truncates `text` with an ellipsis until it fits within
       * `maxWidth` according to the canvas's current font.
       */
      truncateForCanvas(
        ctx: CanvasRenderingContext2D,
        text: string,
        maxWidth: number,
      ): string {
        if (ctx.measureText(text).width <= maxWidth) return text;
        let truncated = text;
        while (
          truncated.length > 0 &&
          ctx.measureText(truncated + '\u2026').width > maxWidth
        ) {
          truncated = truncated.slice(0, -1);
        }
        return truncated + '\u2026';
      },

      /**
       * Helper that traces a rounded rectangle path on the canvas.
       * Caller is responsible for fill() / stroke() after the call.
       */
      drawRoundRect(
        ctx: CanvasRenderingContext2D,
        x: number,
        y: number,
        w: number,
        h: number,
        r: number,
      ): void {
        const radius = Math.min(r, w / 2, h / 2);
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.lineTo(x + w - radius, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
        ctx.lineTo(x + w, y + h - radius);
        ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
        ctx.lineTo(x + radius, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
        ctx.lineTo(x, y + radius);
        ctx.quadraticCurveTo(x, y, x + radius, y);
        ctx.closePath();
      },
    }));
  });
