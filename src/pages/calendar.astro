---

import { t } from '../i18n';
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Card from '../components/ui/Card/Card.astro';
import CardHeader from '../components/ui/CardHeader.astro';
import CardTitle from '../components/ui/CardTitle.astro';
import CardContent from '../components/ui/CardContent.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { icons } from '../lib/icons';
const L = t();
---

<AppLayout title={L.calendrier.title}>
  <PageHeader
    title={L.calendrier.title}
    description={L.calendrier.description}
  />

  <div class="cal pb-24 flex flex-col gap-8" x-data="calendarApp()" x-init="init()" x-cloak>
    {/* ═══ Month controls ═══ */}
    <div class="cal__controls flex items-center justify-between gap-2 flex-wrap border-b border-border pb-4">
      <button
        type="button"
        class="cal__nav-btn inline-flex items-center justify-center min-h-[4.4rem] min-w-[4.4rem] p-0 bg-surface-2 border border-border rounded-sm text-text font-body text-[1.3rem] font-semibold cursor-pointer appearance-none transition-colors"
        @click="prevMonth()"
        aria-label={L.calendrier.prevMonth}
      >
        <Fragment set:html={icons.chevronLeft()} />
      </button>

      <h2 class="cal__month-name font-display font-bold text-text m-0 flex-1 text-center capitalize min-w-[12rem] leading-tight text-[clamp(1.5rem,2.4vw,2rem)]" x-text="monthName()"></h2>

      <button
        type="button"
        class="cal__nav-btn inline-flex items-center justify-center min-h-[4.4rem] min-w-[4.4rem] p-0 bg-surface-2 border border-border rounded-sm text-text font-body text-[1.3rem] font-semibold cursor-pointer appearance-none transition-colors"
        @click="nextMonth()"
        aria-label={L.calendrier.nextMonth}
      >
        <Fragment set:html={icons.chevronRight()} />
      </button>

      <button type="button" class="cal__today-btn inline-flex items-center justify-center min-h-[4.4rem] px-6 bg-surface-2 border border-border rounded-sm text-text font-body text-[1.3rem] font-semibold cursor-pointer appearance-none transition-colors" @click="goToday()">
        {L.calendrier.today}
      </button>
    </div>

    {/* ═══ Calendar grid ═══ */}
    <Card>
      <CardContent>
        {/* Weekday header */}
        <div class="grid grid-cols-7 gap-[1px] mb-3" aria-hidden="true">
          <template x-for="day in weekdays" :key="day">
            <div class="cal__weekday font-display text-[1.1rem] text-muted uppercase tracking-[0.10em] font-bold text-center py-[0.4rem]" x-text="day"></div>
          </template>
        </div>

        {/* Day grid — real <button>s with aria-selected (single-select
            picker). No role="grid"/"gridcell" here: adding ARIA grid
            roles to native buttons would mask their button semantics. */}
        <div class="cal__grid">
          <template x-for="day in calendarDays" :key="day.date">
            <button
              type="button"
              class="cal__day min-h-26 py-3 px-[0.7rem] bg-surface border-0 text-left cursor-pointer font-body text-text flex flex-col gap-1 appearance-none transition-colors"
              :class="{ 'cal__day--other': !day.isCurrentMonth, 'cal__day--today': day.isToday, 'cal__day--selected': selectedDate === day.date }"
              :disabled="!day.isCurrentMonth"
              :aria-label="dayAriaLabel(day)"
              :aria-current="day.isToday ? 'date' : false"
              :aria-pressed="selectedDate === day.date"
              @click="selectDate(day)"
            >
              <span class="cal__day-num text-[1.3rem] font-semibold tabular-nums leading-none" x-text="day.dayNum"></span>
              <template x-if="day.sessions.length > 0">
                <div class="flex gap-[3px] flex-wrap mt-auto items-center">
                  <template x-for="s in day.sessions.slice(0, 3)" :key="s.id">
                    <span
                      class="w-[6px] h-[6px] rounded-full inline-block"
                      :class="'cal__dot--' + s.status"
                      role="img"
                      :aria-label="statusLabel(s.status)"
                    ></span>
                  </template>
                  <span
                    class="text-xs text-muted font-bold ml-[2px] leading-none"
                    x-show="day.sessions.length > 3"
                    x-text="'+' + (day.sessions.length - 3)"
                  ></span>
                </div>
              </template>
            </button>
          </template>
        </div>

        {/* Legend */}
        <div class="flex gap-8 flex-wrap mt-6 pt-6 border-t border-border" aria-hidden="true">
          <span class="inline-flex items-center gap-2 text-[1.2rem] text-muted font-medium">
            <span class="w-[6px] h-[6px] rounded-full inline-block bg-success"></span>
            {L.sessions.completed}
          </span>
          <span class="inline-flex items-center gap-2 text-[1.2rem] text-muted font-medium">
            <span class="w-[6px] h-[6px] rounded-full inline-block bg-info"></span>
            {L.sessions.inProgress}
          </span>
          <span class="inline-flex items-center gap-2 text-[1.2rem] text-muted font-medium">
            <span class="w-[6px] h-[6px] rounded-full inline-block bg-muted"></span>
            {L.sessions.planned}
          </span>
        </div>
      </CardContent>
    </Card>

    {/* ═══ Selected day sessions ═══ */}
    <template x-if="selectedDate">
      <Card>
        <CardHeader>
          <CardTitle>
            {L.calendrier.sessionsOn}
            <span x-text="formatDate(selectedDate)"></span>
          </CardTitle>
        </CardHeader>
        <CardContent>
          <template x-if="selectedSessions.length === 0">
            <EmptyState
              iconName="calendar"
              title={L.calendrier.noSessions}
              description={L.calendrier.noSessionsHint}
            />
          </template>
          <template x-if="selectedSessions.length > 0">
            <div class="flex flex-col gap-2">
              <template x-for="s in selectedSessions" :key="s.id">
                <a
                  :href="localizedPath('/sessions/detail?id=' + encodeURIComponent(s.id))"
                  class="cal__session-item flex items-center justify-between gap-4 py-6 px-6 bg-surface-2 border border-border rounded-md no-underline text-text min-h-[4.4rem] transition-colors"
                >
                  <div class="flex flex-col gap-[0.2rem] min-w-0">
                    <span class="font-display text-[1.4rem] font-semibold leading-tight overflow-hidden text-ellipsis whitespace-nowrap" x-text="s.name"></span>
                    <span class="text-[1.2rem] text-muted leading-tight">
                      <span x-text="s.exercises.length"></span>
                      {L.sessions.exoSingular}<span x-show="s.exercises.length > 1">{L.sessions.pluralS}</span>
                    </span>
                  </div>
                  <span
                    class="cal__session-status text-[1.1rem] font-bold uppercase tracking-[0.08em] py-2 px-4 rounded-sm shrink-0"
                    :class="'cal__session-status--' + s.status"
                    x-text="statusLabel(s.status)"
                  ></span>
                </a>
              </template>
            </div>
          </template>
        </CardContent>
      </Card>
    </template>

    {/* ═══ Monthly stats ═══ */}
    <Card>
      <CardHeader>
        <CardTitle>{L.calendrier.monthlyStats}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="cal__stats grid grid-cols-2 gap-0 border-t border-b border-border">
          <div class="cal__stat flex flex-col gap-1 min-w-0 py-6 px-6 bg-transparent border-0 border-b border-border rounded-none">
            <span class="text-xs text-muted uppercase tracking-[0.10em] font-bold leading-tight">{L.calendrier.sessionsThisMonth}</span>
            <span class="font-display text-[2.2rem] font-bold text-text tabular-nums leading-[1.1] inline-flex items-baseline gap-1" x-text="monthSessionCount"></span>
          </div>
          <div class="cal__stat flex flex-col gap-1 min-w-0 py-6 px-6 bg-transparent border-0 border-b border-border rounded-none">
            <span class="text-xs text-muted uppercase tracking-[0.10em] font-bold leading-tight">{L.dashboard.totalVolume}</span>
            <span class="font-display text-[2.2rem] font-bold text-text tabular-nums leading-[1.1] inline-flex items-baseline gap-1">
              <span x-text="formatNumber(monthVolume)"></span>
              <span class="font-body text-[1.2rem] text-muted font-semibold">{L.common.kg}</span>
            </span>
          </div>
          <div class="cal__stat flex flex-col gap-1 min-w-0 py-6 px-6 bg-transparent border-0 border-b border-border rounded-none">
            <span class="text-xs text-muted uppercase tracking-[0.10em] font-bold leading-tight">{L.calendrier.currentStreak}</span>
            <span class="font-display text-[2.2rem] font-bold text-text tabular-nums leading-[1.1] inline-flex items-baseline gap-1">
              <span x-text="currentStreak"></span>
              <span class="font-body text-[1.2rem] text-muted font-semibold">{L.calendrier.daysShort}</span>
            </span>
          </div>
          <div class="cal__stat flex flex-col gap-1 min-w-0 py-6 px-6 bg-transparent border-0 border-b border-border rounded-none">
            <span class="text-xs text-muted uppercase tracking-[0.10em] font-bold leading-tight">{L.calendrier.longestStreak}</span>
            <span class="font-display text-[2.2rem] font-bold text-text tabular-nums leading-[1.1] inline-flex items-baseline gap-1">
              <span x-text="longestStreak"></span>
              <span class="font-body text-[1.2rem] text-muted font-semibold">{L.calendrier.daysShort}</span>
            </span>
          </div>
        </div>
      </CardContent>
    </Card>
  </div>
</AppLayout>

<script>
  import { getSessions, type Session } from '../lib/storage';
  import { t, localizedPath } from '../i18n';
  import { formatDateLong, formatNumber as formatNumberFn } from '../lib/format';
  import { statusLabel as statusLabelFn, type StatusLabels } from '../lib/session-utils';

  const LABELS = t();
  const statusLabels: StatusLabels = { completed: LABELS.sessions.completed, inProgress: LABELS.sessions.inProgress, planned: LABELS.sessions.planned };
  function statusLabel(status: string): string { return statusLabelFn(status as 'completed' | 'in-progress' | 'planned', statusLabels); }

  /** Format a Date as local YYYY-MM-DD (no UTC shift). */
  function formatISO(d: Date): string {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    interface CalendarDay {
      date: string;
      dayNum: number;
      isCurrentMonth: boolean;
      isToday: boolean;
      sessions: Session[];
    }

    Alpine.data('calendarApp', () => ({
      // ── State ──
      currentYear: new Date().getFullYear(),
      currentMonth: new Date().getMonth(),
      selectedDate: '',
      selectedSessions: [] as Session[],
      allSessions: [] as Session[],
      weekdays: LABELS.calendrier.weekdays,
      localizedPath,

      // ── Init ──
      init() {
        this.allSessions = getSessions();
        this.loadMonth();
      },

      // ── Calendar generation ──
      get calendarDays(): CalendarDay[] {
        const first = new Date(this.currentYear, this.currentMonth, 1);
        const last = new Date(this.currentYear, this.currentMonth + 1, 0);
        const startDay = first.getDay(); // 0=Sun
        const daysInMonth = last.getDate();
        const today = new Date();
        const todayStr = formatISO(today);

        const days: CalendarDay[] = [];

        // Previous month padding
        const prevLast = new Date(this.currentYear, this.currentMonth, 0);
        const prevYear = prevLast.getFullYear();
        const prevMonthIdx = prevLast.getMonth();
        for (let i = startDay - 1; i >= 0; i--) {
          const d = prevLast.getDate() - i;
          const dateStr = `${prevYear}-${String(prevMonthIdx + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          days.push({
            date: dateStr,
            dayNum: d,
            isCurrentMonth: false,
            isToday: dateStr === todayStr,
            sessions: this.allSessions.filter((s) => s.date === dateStr),
          });
        }

        // Current month
        for (let d = 1; d <= daysInMonth; d++) {
          const dateStr = `${this.currentYear}-${String(this.currentMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          days.push({
            date: dateStr,
            dayNum: d,
            isCurrentMonth: true,
            isToday: dateStr === todayStr,
            sessions: this.allSessions.filter((s) => s.date === dateStr),
          });
        }

        // Next month padding — always pad to 6 rows (42 cells) so the
        // grid height stays constant regardless of the month layout.
        const remaining = 42 - days.length;
        const nextFirst = new Date(this.currentYear, this.currentMonth + 1, 1);
        const nextYear = nextFirst.getFullYear();
        const nextMonthIdx = nextFirst.getMonth();
        for (let d = 1; d <= remaining; d++) {
          const dateStr = `${nextYear}-${String(nextMonthIdx + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          days.push({
            date: dateStr,
            dayNum: d,
            isCurrentMonth: false,
            isToday: dateStr === todayStr,
            sessions: [],
          });
        }

        return days;
      },

      loadMonth() {
        this.selectedDate = '';
        this.selectedSessions = [];
      },

      prevMonth() {
        if (this.currentMonth === 0) {
          this.currentMonth = 11;
          this.currentYear--;
        } else {
          this.currentMonth--;
        }
        this.loadMonth();
      },

      nextMonth() {
        if (this.currentMonth === 11) {
          this.currentMonth = 0;
          this.currentYear++;
        } else {
          this.currentMonth++;
        }
        this.loadMonth();
      },

      goToday() {
        const now = new Date();
        this.currentYear = now.getFullYear();
        this.currentMonth = now.getMonth();
        this.loadMonth();
      },

      selectDate(day: CalendarDay) {
        if (!day.isCurrentMonth) return;
        this.selectedDate = day.date;
        this.selectedSessions = day.sessions;
      },

      dayAriaLabel(day: CalendarDay): string {
        const date = this.formatDate(day.date);
        if (day.sessions.length === 0) return date;

        const statusCounts = new Map<string, number>();
        for (const session of day.sessions) {
          statusCounts.set(session.status, (statusCounts.get(session.status) ?? 0) + 1);
        }
        const statusSummary = Array.from(statusCounts.entries())
          .map(([status, count]) => `${count} ${this.statusLabel(status).toLowerCase()}`)
          .join(', ');
        const sessionLabel =
          day.sessions.length === 1
            ? LABELS.sessions.seanceSingular
            : LABELS.sessions.seancePlural;
        return `${date} — ${day.sessions.length} ${sessionLabel}: ${statusSummary}`;
      },

      monthName(): string {
        return `${LABELS.calendrier.monthNames[this.currentMonth]} ${this.currentYear}`;
      },

      // ── Monthly stats ──
      get monthSessionCount(): number {
        return this.allSessions.filter((s) => {
          const d = new Date(s.date);
          return (
            d.getFullYear() === this.currentYear &&
            d.getMonth() === this.currentMonth
          );
        }).length;
      },

      get monthVolume(): number {
        let total = 0;
        for (const s of this.allSessions) {
          const d = new Date(s.date);
          if (
            d.getFullYear() !== this.currentYear ||
            d.getMonth() !== this.currentMonth
          ) {
            continue;
          }
          for (const ex of s.exercises) {
            for (const set of ex.sets) {
              if (set.completed) total += set.weight * set.reps;
            }
          }
        }
        return total;
      },

      /**
       * Counts consecutive days, walking back from today (or yesterday
       * when today has no session), until a day with no session is found.
       * Returns 0 when the user has no sessions at all.
       */
      get currentStreak(): number {
        if (this.allSessions.length === 0) return 0;
        const sessionDates = new Set(
          this.allSessions.map((s) => s.date.substring(0, 10)),
        );
        let streak = 0;
        const cursor = new Date();
        // If today has no session, allow the streak to start at yesterday
        // (otherwise the user would see 0 right after a rest day).
        if (!sessionDates.has(formatISO(cursor))) {
          cursor.setDate(cursor.getDate() - 1);
        }
        while (sessionDates.has(formatISO(cursor))) {
          streak++;
          cursor.setDate(cursor.getDate() - 1);
        }
        return streak;
      },

      /**
       * Walks every distinct session date (sorted) and tracks the longest
       * run of consecutive calendar days. Single-session streaks count as
       * 1. Returns 0 when the user has no sessions.
       */
      get longestStreak(): number {
        if (this.allSessions.length === 0) return 0;
        const dates = Array.from(
          new Set(this.allSessions.map((s) => s.date.substring(0, 10))),
        ).sort();
        let longest = 0;
        let run = 0;
        let prev: Date | null = null;
        for (const dStr of dates) {
          const d = new Date(dStr);
          if (prev) {
            const diff = Math.round(
              (d.getTime() - prev.getTime()) / 86400000,
            );
            run = diff === 1 ? run + 1 : 1;
          } else {
            run = 1;
          }
          if (run > longest) longest = run;
          prev = d;
        }
        return longest;
      },

      // ── Display helpers ──
      statusLabel(status: string): string {
        return statusLabel(status as 'completed' | 'in-progress' | 'planned');
      },

      formatDate(iso: string): string {
        return formatDateLong(iso);
      },

      formatNumber(n: number): string {
        return formatNumberFn(n);
      },
    }));
  });
</script>

<style>
  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cal__nav-btn:hover,
  .cal__today-btn:hover {
    background-color: var(--alpha-bg-soft);
    border-color: var(--alpha-border);
  }

  .cal__nav-btn:focus-visible,
  .cal__today-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .cal__nav-btn:active,
  .cal__today-btn:active {
    transform: scale(0.97);
  }

  .cal__nav-btn svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .cal__day:hover:not(:disabled) {
    background-color: var(--color-surface-2);
  }

  .cal__day:disabled {
    cursor: default;
  }

  .cal__day--other {
    opacity: 0.3;
  }

  .cal__day--today {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .cal__day--today .cal__day-num {
    color: var(--color-accent-foreground);
    font-weight: 700;
  }

  .cal__day--today .text-xs {
    color: var(--color-accent-foreground);
  }

  .cal__day--selected {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    position: relative;
    z-index: 1;
  }

  .cal__day--today.cal__day--selected {
    outline-color: var(--color-text);
  }

  .cal__day:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .cal__dot--completed {
    background: var(--color-success);
  }

  .cal__dot--in-progress {
    background: var(--color-info);
  }

  .cal__dot--planned {
    background: var(--color-muted);
  }

  .cal__session-item:hover {
    border-color: var(--color-accent);
    background-color: var(--alpha-bg-subtle);
  }

  .cal__session-item:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .cal__session-status--completed {
    background-color: color-mix(in srgb, var(--color-success) 15%, transparent);
    color: var(--color-success);
  }

  .cal__session-status--in-progress {
    background-color: color-mix(in srgb, var(--color-info) 15%, transparent);
    color: var(--color-info);
  }

  .cal__session-status--planned {
    background-color: var(--alpha-bg-hover);
    color: var(--color-muted);
  }

  @media (min-width: 640px) {
    .cal__stats {
      grid-template-columns: repeat(4, 1fr);
    }

    .cal__stat + .cal__stat {
      border-left: 1px solid var(--color-border);
    }

    .cal__stat {
      border-bottom: 0;
    }
  }

  @media (max-width: 480px) {
    .cal__controls {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }

    .cal__today-btn {
      grid-column: 1 / -1;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .cal__day {
      min-height: 5rem;
      padding: 0.4rem 0.5rem;
    }

    .cal__day-num {
      font-size: 1.2rem;
    }

    .cal__weekday {
      font-size: 0.95rem;
    }

    .cal__controls {
      gap: 0.6rem;
    }

    .cal__month-name {
      font-size: 1.4rem;
      min-width: 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cal__day,
    .cal__nav-btn,
    .cal__today-btn,
    .cal__session-item {
      transition: none;
    }

    .cal__nav-btn:active,
    .cal__today-btn:active {
      transform: none;
    }
  }

  :global(.cal > .surface) {
    background: transparent;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
  }

  :global(.cal > .surface:last-child) {
    border-bottom: 1px solid var(--color-border);
  }

  :global(.cal > .surface > .p-4),
  :global(.cal > .surface > .p-6) {
    padding-left: 0;
    padding-right: 0;
  }
</style>
