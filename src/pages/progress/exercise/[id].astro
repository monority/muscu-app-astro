---
export const prerender = false;

import AppLayout from "../../../layouts/AppLayout.astro";
import { createServerSupabase } from "../../../lib/supabase-server";
import Skeleton from "../../../components/ui/Skeleton.astro";
import ErrorState from "../../../components/ui/ErrorState.astro";

const supabase = createServerSupabase(Astro);
const { user } = Astro.locals;

const id = parseInt(Astro.params.id!, 10);

let exercise: { id: number; name: string; category: string | null; notes: string | null } | null = null;
let errorMsg: string | null = null;

if (!isNaN(id) && user) {
  const { data, error } = await supabase
    .from("exercises")
    .select("id, name, category, notes")
    .eq("id", id)
    .eq("user_id", user.id)
    .single();
  if (error) {
    errorMsg = "Exercice introuvable";
  } else {
    exercise = data;
  }
} else {
  errorMsg = "ID invalide";
}
---

<AppLayout title={exercise ? `${exercise.name} — Progression` : "Progression"} activeNav="progress">
  <div class="ep-page" data-exercise-id={exercise?.id ?? 0}>
    <a href="/progress" class="ep-back">&larr; Retour à la progression</a>

    {errorMsg ? (
      <ErrorState message={errorMsg} href="/progress" />
    ) : (
      <>
        <h1 class="ep-title">{exercise!.name}</h1>
        {exercise!.category && <span class="ep-category">{exercise!.category}</span>}
        {exercise!.notes && <p class="ep-notes">{exercise!.notes}</p>}

        <div class="ep-skeleton" data-ep-skeleton>
          <div class="ep-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:var(--gap-card)">
            <Skeleton height="6rem" borderRadius="var(--radius-lg)" />
            <Skeleton height="6rem" borderRadius="var(--radius-lg)" />
            <Skeleton height="6rem" borderRadius="var(--radius-lg)" />
            <Skeleton height="6rem" borderRadius="var(--radius-lg)" />
          </div>
          <Skeleton height="20rem" borderRadius="var(--radius-lg)" />
        </div>

        <div class="ep-cards" data-ep-cards hidden>
          <div class="ep-card">
            <span class="ep-card-label">Séries</span>
            <span class="ep-card-stat" data-ep-sets>—</span>
          </div>
          <div class="ep-card">
            <span class="ep-card-label">Volume</span>
            <span class="ep-card-stat" data-ep-volume>—</span>
          </div>
          <div class="ep-card">
            <span class="ep-card-label">Meilleur 1RM</span>
            <span class="ep-card-stat" data-ep-best-1rm>—</span>
          </div>
          <div class="ep-card">
            <span class="ep-card-label">Séances</span>
            <span class="ep-card-stat" data-ep-sessions>—</span>
          </div>
        </div>

        <div class="ep-filters" data-ep-filters hidden>
          <button class="ep-filter" type="button" data-days="7">7j</button>
          <button class="ep-filter" type="button" data-days="30">30j</button>
          <button class="ep-filter" type="button" data-days="90">90j</button>
          <button class="ep-filter ep-filter-active" type="button" data-days="365" data-active>1 an</button>
          <button class="ep-filter" type="button" data-days="0">Tout</button>
        </div>

        <div class="ep-section" data-ep-chart-section hidden>
          <div class="ep-chart-wrap" data-ep-chart></div>
        </div>

        <div data-ep-error hidden></div>
        <div class="ep-empty hidden" data-ep-empty>
          <p>Aucune donnée pour cette période.</p>
        </div>
      </>
    )}
  </div>
</AppLayout>

<script>
  import "../../../scripts/exercise-progress";
</script>

<style>
  .ep-page {
    display: grid;
    gap: var(--gap-section);
  }

  .ep-back {
    font-size: 1.3rem;
    color: var(--muted);
    text-decoration: none;
    width: fit-content;
  }

  .ep-back:hover {
    color: var(--text);
  }

  .ep-title {
    margin: 0;
    font-size: var(--text-page-title);
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--text);
  }

  .ep-category {
    font-size: 1.2rem;
    padding: 0.2rem 0.8rem;
    border-radius: var(--radius-pill);
    background: hsl(0 84% 60% / 0.08);
    color: var(--accent);
    width: fit-content;
  }

  .ep-notes {
    margin: 0;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: hsl(0 0% 100% / 0.03);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--muted);
  }

  .ep-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--gap-card);
  }

  .ep-card {
    display: grid;
    gap: 0.2rem;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-align: center;
  }

  .ep-card-label {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(0 0% 100% / 0.4);
  }

  .ep-card-stat {
    font-size: var(--text-stat, clamp(2rem, 5vw, 2.4rem));
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .ep-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ep-filter {
    min-height: 3.2rem;
    padding: 0.4rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .ep-filter:hover {
    border-color: hsl(0 0% 100% / 0.2);
    color: var(--text);
  }

  .ep-filter[data-active] {
    border-color: var(--accent);
    color: var(--text);
    background: hsl(0 84% 60% / 0.08);
  }

  .ep-section {
    display: grid;
    gap: var(--gap-card);
  }

  .ep-chart-wrap {
    padding: var(--space-page-padding);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ep-empty {
    padding: 2rem;
    text-align: center;
    color: var(--muted);
    font-size: 1.3rem;
  }

  .hidden {
    display: none !important;
  }
</style>
