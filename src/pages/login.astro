---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { t } from '../i18n';

const L = t();
---

<AppLayout title={L.login.title} groups={[]}>
  <div
    class="login"
    x-data="loginApp()"
    x-init="init()"
    x-cloak
  >
    <div class="login__card" role="form" aria-labelledby="login-title">
      {/* ── Nav: theme · logo · language ── */}
      <div class="login__nav">
        <div class="login__nav-side">
          <button
            type="button"
            class="login__theme-btn"
            @click="toggleTheme()"
            :aria-label="isDark() ? switchToLight : switchToDark"
            :title="isDark() ? switchToLight : switchToDark"
          >
            <span class="login__theme-icon--sun" aria-hidden="true">
              <Icon name="sun" size={18} />
            </span>
            <span class="login__theme-icon--moon" aria-hidden="true">
              <Icon name="moon" size={18} />
            </span>
          </button>
        </div>

        <div class="login__brand" aria-hidden="true">
          <Icon name="dumbbell" size={32} />
        </div>

        <div class="login__nav-side login__nav-side--end">
          <button
            type="button"
            class="login__lang-btn"
            @click="toggleLocale()"
            :aria-label="switchLocaleAria"
            :title="switchLocaleAria"
          >
            <span class="login__lang-icon" aria-hidden="true">
              <Icon name="globe" size={18} />
            </span>
            <span x-text="langTarget">EN</span>
          </button>
        </div>
      </div>

      <h1 id="login-title" class="login__title">{L.login.title}</h1>
      <p class="login__subtitle">{L.login.subtitle}</p>

      {/* ── Form ── */}
      <form class="login__form" @submit.prevent="submit" novalidate>
        <div class="login__field">
          <label for="login-email" class="login__label">{L.login.email}</label>
          <input
            type="email"
            id="login-email"
            class="login__input"
            placeholder="vous@exemple.com"
            x-model="email"
            @input="error = ''"
            required
            autocomplete="email"
            spellcheck="false"
          />
        </div>

        <div class="login__field">
          <label for="login-password" class="login__label">{L.login.password}</label>
          <div class="login__pw-wrap">
            <input
              :type="showPassword ? 'text' : 'password'"
              id="login-password"
              class="login__input login__input--pw"
              placeholder="••••••••"
              x-model="password"
              @input="error = ''"
              required
              autocomplete="current-password"
            />
            <button
              type="button"
              class="login__pw-toggle"
              @click="showPassword = !showPassword"
              :aria-label="showPassword ? labels.hidePassword : labels.showPassword"
              :aria-pressed="showPassword ? 'true' : 'false'"
            >
              <span x-show="!showPassword"><Icon name="eye" size={18} /></span>
              <span x-show="showPassword" x-cloak><Icon name="eyeOff" size={18} /></span>
            </button>
          </div>
        </div>

        <p
          class="login__error"
          x-show="error"
          x-text="error"
          x-cloak
          role="alert"
        ></p>

        <button
          type="submit"
          class="login__submit"
          :disabled="loading"
        >
          <span class="login__submit-label" x-text="labels.submit">{L.login.submit}</span>
          <span class="login__submit-loading" x-show="loading" x-cloak>
            <span class="login__spinner"><Icon name="spinner" size={18} /></span>
            <span x-text="labels.loading">{L.login.loading}</span>
          </span>
        </button>
      </form>

      {/* ── Divider ── */}
      <div class="login__divider" aria-hidden="true">
        <span class="login__divider-text">ou</span>
      </div>

      {/* ── Dev mode ── */}
      <section class="login__dev" aria-labelledby="login-dev-title">
        <div class="login__dev-header">
          <span class="login__dev-badge" aria-hidden="true">DEV</span>
          <h2 id="login-dev-title" class="login__dev-title">
            {L.login.devMode}
          </h2>
        </div>
        <p class="login__dev-warning" role="note">
          <span aria-hidden="true" class="login__dev-warning-icon">
            <Icon name="alertTriangle" size={16} />
          </span>
          {L.login.devWarning}
        </p>
        <button
          type="button"
          class="login__dev-btn"
          @click="devLogin()"
        >
          <Icon name="zap" size={18} class="login__dev-btn-icon" />
          <span>{L.login.devLogin}</span>
        </button>
      </section>

      {/* ── Signup link ── */}
      <p class="login__signup-text">
        {L.login.createAccount}
        <button
          type="button"
          class="login__signup-link"
          @click="showSignupMessage = !showSignupMessage"
        >
          {L.login.createAccountLink}
        </button>
      </p>

      <p
        class="login__signup-msg"
        x-show="showSignupMessage"
        x-cloak
        x-transition.opacity.duration.200ms
        x-text="labels.signupMessage"
      >
        {L.login.signupMessage}
      </p>
    </div>

    <p class="login__footer">muscu.app · TRAINING LOG</p>
  </div>
</AppLayout>

<script>
  import { setAuth, isAuthenticated } from '../lib/auth';
  import { t, localizedPath, getLocale } from '../i18n';

  const LABELS = t();

  function nameFromEmail(email: string): string {
    const local = email.split('@')[0] ?? '';
    const formatted = local
      .split(/[._\-+]+/)
      .filter(Boolean)
      .map((s) => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase())
      .join(' ');
    return formatted || LABELS.login.defaultPseudo;
  }

  function isValidEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('loginApp', () => ({
      email: '',
      password: '',
      error: '',
      showPassword: false,
      showSignupMessage: false,
      loading: false,
      theme: 'dark' as 'dark' | 'light',
      locale: getLocale(),
      switchToLight: LABELS.layout.switchToLight,
      switchToDark: LABELS.layout.switchToDark,
      switchLocaleAria: LABELS.layout.switchLocale,
      labels: {
        submit: LABELS.login.submit,
        loading: LABELS.login.loading,
        showPassword: LABELS.login.showPassword,
        hidePassword: LABELS.login.hidePassword,
        signupMessage: LABELS.login.signupMessage,
      },

      init() {
        const current =
          document.documentElement.getAttribute('data-theme') || 'dark';
        this.theme = current === 'light' ? 'light' : 'dark';
        if (isAuthenticated()) {
          window.location.href = localizedPath('/');
        }
      },

      toggleTheme() {
        this.theme = this.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', this.theme);
        try {
          window.localStorage.setItem('muscu-theme', this.theme);
        } catch {
          // private mode / quota
        }
      },

      isDark(): boolean {
        return this.theme === 'dark';
      },

      get langTarget(): string {
        return this.locale === 'en' ? 'FR' : 'EN';
      },

      toggleLocale() {
        const target = this.locale === 'en' ? 'fr' : 'en';
        const search = window.location.search;
        const hash = window.location.hash;
        const path = target === 'fr' ? '/login' : '/en/login';
        window.location.href = path + search + hash;
      },

      submit() {
        this.error = '';
        const email = this.email.trim();
        const password = this.password;

        if (!email) { this.error = LABELS.login.errors.emailRequired; return; }
        if (!isValidEmail(email)) { this.error = LABELS.login.errors.emailInvalid; return; }
        if (!password) { this.error = LABELS.login.errors.passwordRequired; return; }

        this.loading = true;
        const name = nameFromEmail(email);
        setAuth(email, name);
        window.setTimeout(() => { window.location.href = localizedPath('/'); }, 240);
      },

      devLogin() {
        this.error = '';
        this.loading = true;
        setAuth('dev@muscu.app', 'Dev User');
        window.location.href = localizedPath('/');
      },
    }));
  });
</script>

<style>
  .login {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2.4rem 1.6rem 3.2rem;
    gap: 2.4rem;
    background: var(--color-bg);
  }

  .login__card {
    width: 100%;
    max-width: 40rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 4.0rem 3.2rem;
    box-shadow: var(--shadow-1), 0 1px 0 var(--alpha-bg-subtle) inset;
  }

  /* ── Nav ── */
  .login__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.4rem;
  }

  .login__nav-side {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .login__nav-side--end {
    justify-content: flex-end;
  }

  .login__theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    color: var(--color-muted);
    cursor: pointer;
    appearance: none;
    transition: all 140ms ease;
  }
  .login__theme-btn:hover {
    border-color: var(--alpha-border);
    color: var(--color-text);
  }
  .login__theme-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .login__theme-icon--sun,
  .login__theme-icon--moon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
  }

  .login__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.4rem;
    height: 6.4rem;
    margin: 0;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    box-shadow: var(--shadow-2);
  }

  .login__lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 4.4rem;
    padding: 0 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    cursor: pointer;
    appearance: none;
    transition: all 140ms ease;
  }
  .login__lang-btn:hover {
    background: var(--color-surface-3);
    border-color: var(--alpha-border);
  }
  .login__lang-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .login__lang-btn:active {
    transform: scale(0.97);
  }

  .login__lang-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── Title ── */
  .login__title {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    text-align: center;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: 0.01em;
    margin: 0 0 0.8rem;
  }

  .login__subtitle {
    text-align: center;
    color: var(--color-muted);
    font-size: 1.3rem;
    line-height: 1.4;
    margin: 0 0 3.2rem;
  }

  /* ── Form ── */
  .login__form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .login__field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .login__label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .login__input {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.4rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    line-height: 1.2;
    outline: none;
    appearance: none;
    transition: all 140ms ease;
  }
  .login__input::placeholder {
    color: var(--alpha-text-faint);
  }
  .login__input:hover {
    border-color: var(--alpha-border);
  }
  .login__input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .login__input--pw {
    padding-right: 5.2rem;
  }

  .login__pw-wrap {
    position: relative;
  }

  .login__pw-toggle {
    position: absolute;
    top: 50%;
    right: 0.4rem;
    transform: translateY(-50%);
    width: 4.4rem;
    height: 4.4rem;
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 140ms ease;
  }
  .login__pw-toggle:hover {
    color: var(--color-text);
    background: var(--alpha-bg-soft);
  }
  .login__pw-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ── Error ── */
  .login__error {
    font-size: 1.2rem;
    color: color-mix(in srgb, var(--color-destructive) 75%, var(--color-text));
    background: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 30%, transparent);
    border-radius: var(--radius-sm);
    padding: 1.0rem 1.2rem;
    margin: 0;
    line-height: 1.4;
  }

  /* ── Submit ── */
  .login__submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    min-width: 0;
    height: 5.2rem;
    padding: 0 1.6rem;
    margin-top: 0.4rem;
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    appearance: none;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--color-accent) 30%, transparent);
    transition: all 140ms ease;
  }
  .login__submit:hover:not(:disabled) {
    filter: brightness(1.08);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-accent) 42%, transparent);
  }
  .login__submit:active:not(:disabled) {
    transform: scale(0.985);
  }
  .login__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .login__submit:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring), 0 6px 18px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .login__submit-label {
    display: inline-block;
    line-height: 1;
  }

  .login__submit-loading {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  .login__spinner {
    animation: login-spin 0.7s linear infinite;
  }

  @keyframes login-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Divider ── */
  .login__divider {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 2.4rem 0 1.6rem;
  }
  .login__divider::before,
  .login__divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }
  .login__divider-text {
    font-family: var(--font-display);
    color: var(--color-muted);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 600;
  }

  /* ── Dev section ── */
  .login__dev {
    display: flex;
    flex-direction: column;
    gap: 1.0rem;
    padding: 1.6rem 1.6rem 1.4rem;
    margin-top: 0.4rem;
    background-color: color-mix(in srgb, var(--color-accent) 4%, transparent);
    border: 1px dashed color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: var(--radius-sm);
  }

  .login__dev-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .login__dev-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.2rem;
    padding: 0 0.7rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .login__dev-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.10em;
    line-height: 1;
    margin: 0;
  }

  .login__dev-warning {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 1.2rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .login__dev-warning-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-warning);
    flex-shrink: 0;
  }

  .login__dev-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    height: 4.6rem;
    padding: 0 1.6rem;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    appearance: none;
    transition: all 140ms ease;
  }
  .login__dev-btn:hover {
    background: var(--alpha-bg-soft);
    border-color: var(--alpha-border);
    color: var(--color-text);
  }
  .login__dev-btn:active {
    transform: scale(0.985);
  }
  .login__dev-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .login__dev-btn-icon {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  /* ── Signup ── */
  .login__signup-text {
    text-align: center;
    color: var(--color-muted);
    font-size: 1.3rem;
    line-height: 1.4;
    margin: 0;
  }

  .login__signup-link {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    background: none;
    border: none;
    padding: 0 0.4rem;
    margin-left: 0.4rem;
    color: var(--color-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    transition: all 140ms ease;
  }
  .login__signup-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }
  .login__signup-link:focus-visible {
    outline: none;
    text-decoration: underline;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  .login__signup-msg {
    margin: 1.2rem 0;
    padding: 1.2rem 1.4rem;
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.5;
    background-color: color-mix(in srgb, var(--color-info) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-info) 25%, transparent);
    border-radius: var(--radius-sm);
    color: color-mix(in srgb, var(--color-info) 78%, var(--color-text));
  }

  .login__footer {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 600;
    margin: 0;
    opacity: 0.7;
  }

  /* ── Theme icon visibility ── */
  :global([data-theme="light"]) .login__theme-icon--sun { display: none; }
  :global([data-theme="light"]) .login__theme-icon--moon { display: inline-flex; }

  /* ── Light theme overrides ── */
  :global([data-theme="light"]) .login__error {
    color: color-mix(in srgb, var(--color-destructive) 45%, var(--color-text));
    background-color: color-mix(in srgb, var(--color-destructive) 8%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 25%, transparent);
  }
  :global([data-theme="light"]) .login__signup-msg {
    color: color-mix(in srgb, var(--color-info) 45%, var(--color-text));
    background-color: color-mix(in srgb, var(--color-info) 6%, transparent);
    border-color: color-mix(in srgb, var(--color-info) 20%, transparent);
  }
</style>
