      <form class="auth-form" method="post">
        <label class="auth-label" for="email">Email</label>
        <input class="auth-input" type="email" name="email" id="email" required autocomplete="email" />

        <div class="auth-actions">
          <button class="auth-btn" type="submit" name="action" value="magic-link">
            Envoyer un lien magique
