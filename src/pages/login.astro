---
import AppLayout from '../layouts/AppLayout.astro';
import { t, setLocale, defaultLocale } from '../i18n';



setLocale(Astro.currentLocale ?? defaultLocale);

const L = t();
/**
 * Login page — fake auth (any email/password works).
 *
 * - No sidebar/header (passed empty `groups` to AppLayout, which
 *   falls back to a bare <main> wrapper).
 * - Alpine.js handles the form state, validation, and redirect.
 * - The `muscu-auth` localStorage entry is the single source of
 *   truth for the rest of the app (see src/lib/auth.ts).
 */
---

<AppLayout title={L.login.title} groups={[]}>
  <div
    class="login"
    x-data="loginApp()"
    x-init="init()"
    x-cloak
  >
    <div class="login__card" role="form" aria-labelledby="login-title">
      {/* ── Nav: theme · logo · language ── */}
      <div class="login__nav">
        <div class="login__nav-side">
          <button
            type="button"
            class="login__theme"
            @click="toggleTheme()"
            :aria-label="isDark() ? switchToLight : switchToDark"
            :title="isDark() ? switchToLight : switchToDark"
          >
            <span class="login__theme-icon login__theme-icon--sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
            </span>
            <span class="login__theme-icon login__theme-icon--moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </span>
          </button>
        </div>

        {/* ── Brand icon (dumbbell) ── */}
        <div class="login__logo" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="32"
            height="32"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14.4 14.4 9.6 9.6"></path>
            <path
              d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"
            ></path>
            <path d="m21.5 21.5-1.4-1.4"></path>
            <path d="M3.9 3.9 2.5 2.5"></path>
            <path
              d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"
            ></path>
          </svg>
        </div>

        <div class="login__nav-side">
          <button
            type="button"
            class="login__lang"
            @click="toggleLocale()"
            :aria-label="switchLocaleAria"
            :title="switchLocaleAria"
          >
            <span class="login__lang-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </span>
            <span class="login__lang-label" x-text="langTarget">EN</span>
          </button>
        </div>
      </div>

      <h1 id="login-title" class="login__title">{L.login.title}</h1>
      <p class="login__subtitle">
        {L.login.subtitle}
      </p>

      {/* ── Form ── */}
      <form class="login__form" @submit.prevent="submit" novalidate>
        <div class="login__field">
          <label for="login-email" class="login__label">{L.login.email}</label>
          <input
            type="email"
            id="login-email"
            class="login__input"
            placeholder="vous@exemple.com"
            x-model="email"
            @input="error = ''"
            required
            autocomplete="email"
            spellcheck="false"
          />
        </div>

        <div class="login__field">
          <label for="login-password" class="login__label">{L.login.password}</label>
          <div class="login__password">
            <input
              :type="showPassword ? 'text' : 'password'"
              id="login-password"
              class="login__input"
              placeholder="••••••••"
              x-model="password"
              @input="error = ''"
              required
              autocomplete="current-password"
            />
            <button
              type="button"
              class="login__toggle"
              @click="showPassword = !showPassword"
              :aria-label="showPassword ? labels.hidePassword : labels.showPassword"
              :aria-pressed="showPassword ? 'true' : 'false'"
            >
              {/* Eye icon */}
              <svg
                x-show="!showPassword"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              {/* Eye-off icon */}
              <svg
                x-show="showPassword"
                x-cloak
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                <path
                  d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"
                ></path>
                <path
                  d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
                ></path>
                <line x1="2" y1="2" x2="22" y2="22"></line>
              </svg>
            </button>
          </div>
        </div>

        <p
          class="login__error"
          x-show="error"
          x-text="error"
          x-cloak
          role="alert"
        ></p>

        <button
          type="submit"
          class="login__submit"
          :disabled="loading"
        >
          {/* Always-present label (visible whether Alpine is loaded
              or not, before/after submit). */}
          <span class="login__submit-label" x-text="labels.submit">{L.login.submit}</span>
          {/* Loading overlay — only shown while the form is in flight. */}
          <span class="login__submit-loading" x-show="loading" x-cloak>
            <svg
              class="login__spinner"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25" />
              <path d="M22 12a10 10 0 0 1-10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
            <span x-text="labels.loading">{L.login.loading}</span>
          </span>
        </button>
      </form>

      {/* ── Divider ── */}
      <div class="login__divider" aria-hidden="true">
        <span>ou</span>
      </div>

      {/* ── Dev mode (temporary, one-click login) ── */}
      <section class="login__dev" aria-labelledby="login-dev-title">
        <div class="login__dev-head">
          <span class="login__dev-badge" aria-hidden="true">DEV</span>
          <h2 id="login-dev-title" class="login__dev-title">
            {L.login.devMode}
          </h2>
        </div>
        <p class="login__dev-warning" role="note">
          <span aria-hidden="true" class="login__dev-warning-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          </span>
          {L.login.devWarning}
        </p>
        <button
          type="button"
          class="login__dev-btn"
          @click="devLogin()"
        >
          <svg
            class="login__dev-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>{L.login.devLogin}</span>
        </button>
      </section>

      {/* ── Signup link ── */}
      <p class="login__signup">
        {L.login.createAccount}
        <button
          type="button"
          class="login__signup-link"
          @click="showSignupMessage = !showSignupMessage"
        >
          {L.login.createAccountLink}
        </button>
      </p>

      <p
        class="login__signup-msg"
        x-show="showSignupMessage"
        x-cloak
        x-transition.opacity.duration.200ms
        x-text="labels.signupMessage"
      >
        {L.login.signupMessage}
      </p>
    </div>

    <p class="login__brand">muscu.app · TRAINING LOG</p>
  </div>
</AppLayout>

<script>
  import { setAuth, isAuthenticated } from '../lib/auth';
  import { t, defaultLocale, localizedPath, getLocale } from '../i18n';

  const LABELS = t();

  function nameFromEmail(email: string): string {
    const local = email.split('@')[0] ?? '';
    const formatted = local
      .split(/[._\-+]+/)
      .filter(Boolean)
      .map((s) => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase())
      .join(' ');
    return formatted || LABELS.login.defaultPseudo;
  }

  function isValidEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('loginApp', () => ({
      email: '',
      password: '',
      error: '',
      showPassword: false,
      showSignupMessage: false,
      loading: false,
      theme: 'dark' as 'dark' | 'light',
      locale: getLocale(),
      switchToLight: LABELS.layout.switchToLight,
      switchToDark: LABELS.layout.switchToDark,
      switchLocaleAria: LABELS.layout.switchLocale,
      labels: {
        submit: LABELS.login.submit,
        loading: LABELS.login.loading,
        showPassword: LABELS.login.showPassword,
        hidePassword: LABELS.login.hidePassword,
        signupMessage: LABELS.login.signupMessage,
      },

      init() {
        const current =
          document.documentElement.getAttribute('data-theme') || 'dark';
        this.theme = current === 'light' ? 'light' : 'dark';
        if (isAuthenticated()) {
          window.location.href = localizedPath('/');
        }
      },

      toggleTheme() {
        this.theme = this.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', this.theme);
        try {
          window.localStorage.setItem('muscu-theme', this.theme);
        } catch {
          // private mode / quota — silently ignore, the in-memory
          // theme still applies for the current session
        }
      },

      isDark(): boolean {
        return this.theme === 'dark';
      },

      get langTarget(): string {
        return this.locale === 'en' ? 'FR' : 'EN';
      },

      toggleLocale() {
        const target = this.locale === 'en' ? 'fr' : 'en';
        const search = window.location.search;
        const hash = window.location.hash;
        const path = target === 'fr' ? '/login' : '/en/login';
        window.location.href = path + search + hash;
      },

      submit() {
        this.error = '';
        const email = this.email.trim();
        const password = this.password;

        if (!email) { this.error = LABELS.login.errors.emailRequired; return; }
        if (!isValidEmail(email)) { this.error = LABELS.login.errors.emailInvalid; return; }
        if (!password) { this.error = LABELS.login.errors.passwordRequired; return; }

        this.loading = true;
        const name = nameFromEmail(email);
        setAuth(email, name);
        window.setTimeout(() => { window.location.href = localizedPath('/'); }, 240);
      },

      devLogin() {
        this.error = '';
        this.loading = true;
        setAuth('dev@muscu.app', 'Dev User');
        window.location.href = localizedPath('/');
      },
    }));
  });
</script>

{/* Alpine.js via CDN — MUST be after the module script above
    (type="module" executes before defer in the HTML spec) */}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<style>
  /* Hide Alpine elements until initialized (prevents flash) */
  [x-cloak] {
    display: none !important;
  }

  /* ════════════════════════════════════════════════════
     PAGE — full-viewport centered stage
     ════════════════════════════════════════════════════ */
  .login {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2.4rem 1.6rem 3.2rem;
    gap: 2.4rem;
    background-color: var(--color-bg);
  }

  /* ── Nav: theme · logo · language ───────────────────────
     A header row inside the card where the dumbbell logo
     sits centered and the two control buttons flank it,
     giving the card a navigation-bar feel. */
  .login__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.4rem;
  }

  /* Equal flexible side columns keep the logo perfectly
     centered regardless of button widths. */
  .login__nav-side {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .login__nav-side:first-child {
    justify-content: flex-start;
  }

  .login__nav-side:last-child {
    justify-content: flex-end;
  }

  /* ── Theme button (icon) ── */
  .login__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-2);
    color: var(--color-muted);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .login__theme:hover {
    background-color: var(--color-surface-3);
    border-color: var(--alpha-border);
    color: var(--color-text);
  }

  .login__theme:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .login__theme:active {
    transform: scale(0.94);
  }

  .login__theme-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
  }

  .login__theme-icon svg {
    display: block;
  }

  /* Sun visible in dark mode (suggests "switch to light"),
     moon visible in light mode (suggests "switch to dark"). */
  .login__theme-icon--sun {
    display: inline-flex;
  }
  .login__theme-icon--moon {
    display: none;
  }
  :global([data-theme="light"]) .login__theme-icon--sun {
    display: none;
  }
  :global([data-theme="light"]) .login__theme-icon--moon {
    display: inline-flex;
  }

  /* ── Language button (icon + label) ── */
  .login__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 4.4rem;
    padding: 0 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-2);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .login__lang:hover {
    background-color: var(--color-surface-3);
    border-color: var(--alpha-border);
  }

  .login__lang:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .login__lang:active {
    transform: scale(0.97);
  }

  .login__lang-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .login__lang-icon svg {
    display: block;
  }

  .login__lang-label {
    line-height: 1;
  }

  /* ════════════════════════════════════════════════════
     CARD — 400px wide per spec, premium dark surface
     ════════════════════════════════════════════════════ */
  .login__card {
    width: 100%;
    max-width: 40rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 4.0rem 3.2rem;
    box-shadow: var(--shadow-1),
      0 1px 0 var(--alpha-bg-subtle) inset;
  }

  /* ── Logo ── */
  .login__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.4rem;
    height: 6.4rem;
    margin: 0;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    box-shadow: var(--shadow-2);
  }

  /* ── Title block ── */
  .login__title {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    text-align: center;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: 0.01em;
    margin: 0 0 0.8rem;
  }

  .login__subtitle {
    text-align: center;
    color: var(--color-muted);
    font-size: 1.3rem;
    line-height: 1.4;
    margin: 0 0 3.2rem;
  }

  /* ════════════════════════════════════════════════════
     FORM
     ════════════════════════════════════════════════════ */
  .login__form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .login__field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .login__label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .login__input {
    width: 100%;
    height: 4.8rem;
    padding: 0 1.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    line-height: 1.2;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      background-color var(--transition-fast);
  }

  .login__input::placeholder {
    color: var(--alpha-text-faint);
  }

  .login__input:hover {
    border-color: var(--alpha-border);
  }

  .login__input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  /* ── Password input + show/hide toggle ── */
  .login__password {
    position: relative;
  }

  .login__password .login__input {
    padding-right: 5.2rem;
  }

  .login__toggle {
    position: absolute;
    top: 50%;
    right: 0.4rem;
    transform: translateY(-50%);
    width: 4.4rem;
    height: 4.4rem;
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .login__toggle:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-soft);
  }

  .login__toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ── Error banner ── */
  .login__error {
    color: color-mix(in srgb, var(--color-destructive) 75%, var(--color-text));
    font-size: 1.2rem;
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 30%, transparent);
    border-radius: var(--radius-sm);
    padding: 1.0rem 1.2rem;
    margin: 0;
    line-height: 1.4;
  }

  /* ── Submit button (primary, full-width) ── */
  .login__submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    min-width: 0;
    height: 5.2rem;
    padding: 0 1.6rem;
    margin-top: 0.4rem;
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--color-accent) 30%, transparent);
    transition: filter var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .login__submit-label {
    display: inline-block;
    line-height: 1;
  }

  /* Loading overlay sits on top of the static label so the button
     keeps its size and shape while in flight. */
  .login__submit-loading {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  .login__submit:hover:not(:disabled) {
    filter: brightness(1.08);
