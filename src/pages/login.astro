---
import AppLayout from '../layouts/AppLayout.astro';
import { t } from '../i18n';

const L = t();
/**
 * Login page — fake auth (any email/password works).
 *
 * - No sidebar/header (passed empty `groups` to AppLayout, which
 *   falls back to a bare <main> wrapper).
 * - Alpine.js handles the form state, validation, and redirect.
 * - The `muscu-auth` localStorage entry is the single source of
 *   truth for the rest of the app (see src/lib/auth.ts).
 */
---

<AppLayout title={L.login.title} groups={[]}>
  <div
    class="min-h-screen flex flex-col items-center justify-center p-[2.4rem] px-[1.6rem] pb-[3.2rem] gap-[2.4rem] bg-bg"
    x-data="loginApp()"
    x-init="init()"
    x-cloak
  >
    <div class="w-full max-w-[40rem] bg-surface border border-border rounded-lg p-[4.0rem] px-[3.2rem] shadow-[var(--shadow-1),0_1px_0_var(--alpha-bg-subtle)_inset]" role="form" aria-labelledby="login-title">
      {/* ── Nav: theme · logo · language ── */}
      <div class="flex items-center justify-between mb-[2.4rem]">
        <div class="flex-1 min-w-0 flex items-center justify-start">
          <button
            type="button"
            class="inline-flex items-center justify-center w-[4.4rem] h-[4.4rem] border border-border rounded-md bg-surface-2 text-muted cursor-pointer appearance-none transition-all duration-[140ms]"
            @click="toggleTheme()"
            :aria-label="isDark() ? switchToLight : switchToDark"
            :title="isDark() ? switchToLight : switchToDark"
          >
            <span class="inline-flex items-center justify-center w-[1.8rem] h-[1.8rem] login__theme-icon--sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
            </span>
            <span class="inline-flex items-center justify-center w-[1.8rem] h-[1.8rem] login__theme-icon--moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </span>
          </button>
        </div>

        {/* ── Brand icon (dumbbell) ── */}
        <div class="flex items-center justify-center w-[6.4rem] h-[6.4rem] m-0 shrink-0 rounded-lg bg-surface-2 border border-border text-accent shadow-[var(--shadow-2)]" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="32"
            height="32"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14.4 14.4 9.6 9.6"></path>
            <path
              d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"
            ></path>
            <path d="m21.5 21.5-1.4-1.4"></path>
            <path d="M3.9 3.9 2.5 2.5"></path>
            <path
              d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"
            ></path>
          </svg>
        </div>

        <div class="flex-1 min-w-0 flex items-center justify-end">
          <button
            type="button"
            class="inline-flex items-center justify-center gap-[0.6rem] h-[4.4rem] px-[1.2rem] border border-border rounded-md bg-surface-2 text-text font-display text-[1.1rem] font-bold tracking-[0.1em] leading-none cursor-pointer appearance-none transition-all duration-[140ms]"
            @click="toggleLocale()"
            :aria-label="switchLocaleAria"
            :title="switchLocaleAria"
          >
            <span class="inline-flex items-center justify-center w-[1.8rem] h-[1.8rem] text-accent shrink-0" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </span>
            <span class="leading-none" x-text="langTarget">EN</span>
          </button>
        </div>
      </div>

      <h1 id="login-title" class="font-display text-[2.8rem] font-bold text-center text-text leading-[1.1] tracking-[0.01em] m-0 mb-[0.8rem]">{L.login.title}</h1>
      <p class="text-center text-muted text-[1.3rem] leading-[1.4] m-0 mb-[3.2rem]">
        {L.login.subtitle}
      </p>

      {/* ── Form ── */}
      <form class="flex flex-col gap-[1.6rem]" @submit.prevent="submit" novalidate>
        <div class="flex flex-col gap-[0.6rem]">
          <label for="login-email" class="font-display text-[1.1rem] font-semibold text-muted uppercase tracking-[0.12em] leading-none">{L.login.email}</label>
          <input
            type="email"
            id="login-email"
            class="login__input w-full h-[4.8rem] px-[1.4rem] bg-surface-2 border border-border rounded-sm text-text font-body text-[1.4rem] leading-[1.2] outline-none appearance-none transition-all duration-[140ms]"
            placeholder="vous@exemple.com"
            x-model="email"
            @input="error = ''"
            required
            autocomplete="email"
            spellcheck="false"
          />
        </div>

        <div class="flex flex-col gap-[0.6rem]">
          <label for="login-password" class="font-display text-[1.1rem] font-semibold text-muted uppercase tracking-[0.12em] leading-none">{L.login.password}</label>
          <div class="relative">
            <input
              :type="showPassword ? 'text' : 'password'"
              id="login-password"
              class="login__input w-full h-[4.8rem] px-[1.4rem] pr-[5.2rem] bg-surface-2 border border-border rounded-sm text-text font-body text-[1.4rem] leading-[1.2] outline-none appearance-none transition-all duration-[140ms]"
              placeholder="••••••••"
              x-model="password"
              @input="error = ''"
              required
              autocomplete="current-password"
            />
            <button
              type="button"
              class="absolute top-1/2 right-[0.4rem] -translate-y-1/2 w-[4.4rem] h-[4.4rem] bg-transparent border-none text-muted cursor-pointer rounded-sm inline-flex items-center justify-center transition-all duration-[140ms]"
              @click="showPassword = !showPassword"
              :aria-label="showPassword ? labels.hidePassword : labels.showPassword"
              :aria-pressed="showPassword ? 'true' : 'false'"
            >
              {/* Eye icon */}
              <svg
                x-show="!showPassword"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              {/* Eye-off icon */}
              <svg
                x-show="showPassword"
                x-cloak
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                <path
                  d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"
                ></path>
                <path
                  d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
                ></path>
                <line x1="2" y1="2" x2="22" y2="22"></line>
              </svg>
            </button>
          </div>
        </div>

        <p
          class="text-[1.2rem] bg-[color-mix(in_srgb,var(--color-destructive)_10%,transparent)] border border-[color-mix(in_srgb,var(--color-destructive)_30%,transparent)] border-[color-mix(in_srgb,var(--color-destructive)_30%,transparent)] rounded-sm p-[1.0rem] px-[1.2rem] m-0 leading-[1.4] login__error"
          x-show="error"
          x-text="error"
          x-cloak
          role="alert"
        ></p>

        <button
          type="submit"
          class="relative inline-flex items-center justify-center gap-[0.8rem] w-full min-w-0 h-[5.2rem] px-[1.6rem] mt-[0.4rem] bg-accent text-accent-foreground border border-[color-mix(in_srgb,var(--color-accent)_45%,transparent)] rounded-sm font-body text-[1.4rem] font-bold tracking-[0.02em] cursor-pointer appearance-none shadow-[0_6px_18px_color-mix(in_srgb,var(--color-accent)_30%,transparent)] transition-all duration-[140ms]"
          :disabled="loading"
        >
          {/* Always-present label (visible whether Alpine is loaded
              or not, before/after submit). */}
          <span class="inline-block leading-none" x-text="labels.submit">{L.login.submit}</span>
          {/* Loading overlay — only shown while the form is in flight. */}
          <span class="absolute inset-0 inline-flex items-center justify-center gap-[0.8rem]" x-show="loading" x-cloak>
            <svg
              class="login__spinner"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25" />
              <path d="M22 12a10 10 0 0 1-10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
            <span x-text="labels.loading">{L.login.loading}</span>
          </span>
        </button>
      </form>

      {/* ── Divider ── */}
      <div class="login__divider flex items-center gap-[1.2rem] my-[2.4rem] mx-0 mb-[1.6rem]" aria-hidden="true">
        <span class="font-display text-muted text-[1.1rem] uppercase tracking-[0.18em] font-semibold">ou</span>
      </div>

      {/* ── Dev mode (temporary, one-click login) ── */}
      <section class="flex flex-col gap-[1.0rem] p-[1.6rem] pt-[1.6rem] pb-[1.4rem] mt-[0.4rem] login__dev" aria-labelledby="login-dev-title">
        <div class="flex items-center gap-[0.8rem]">
          <span class="inline-flex items-center justify-center h-[2.2rem] px-[0.7rem] rounded-full font-display text-[1.1rem] font-bold tracking-[0.12em] leading-none login__dev-badge" aria-hidden="true">DEV</span>
          <h2 id="login-dev-title" class="font-display text-[1.2rem] font-bold text-accent uppercase tracking-[0.10em] leading-none m-0">
            {L.login.devMode}
          </h2>
        </div>
        <p class="flex items-center gap-[0.6rem] m-0 text-[1.2rem] text-muted leading-[1.4]" role="note">
          <span aria-hidden="true" class="inline-flex items-center justify-center text-warning shrink-0">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          </span>
          {L.login.devWarning}
        </p>
        <button
          type="button"
          class="inline-flex items-center justify-center gap-[0.8rem] w-full h-[4.6rem] px-[1.6rem] bg-transparent text-text border border-border rounded-sm font-body text-[1.3rem] font-semibold tracking-[0.01em] cursor-pointer appearance-none transition-all duration-[140ms]"
          @click="devLogin()"
        >
          <svg
            class="shrink-0 text-accent"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>{L.login.devLogin}</span>
        </button>
      </section>

      {/* ── Signup link ── */}
      <p class="text-center text-muted text-[1.3rem] leading-[1.4] m-0">
        {L.login.createAccount}
        <button
          type="button"
          class="login__signup-link inline-flex items-center min-h-[4.4rem] bg-none border-none px-[0.4rem] ml-[0.4rem] text-accent font-inherit text-inherit font-semibold cursor-pointer appearance-none transition-all duration-[140ms]"
          @click="showSignupMessage = !showSignupMessage"
        >
          {L.login.createAccountLink}
        </button>
      </p>

      <p
        class="m-[1.2rem] mx-0 p-[1.2rem] px-[1.4rem] login__signup-msg text-center text-[1.2rem] leading-[1.5]"
        x-show="showSignupMessage"
        x-cloak
        x-transition.opacity.duration.200ms
        x-text="labels.signupMessage"
      >
        {L.login.signupMessage}
      </p>
    </div>

    <p class="font-display text-[1.1rem] text-muted uppercase tracking-[0.18em] font-semibold m-0 opacity-70">muscu.app · TRAINING LOG</p>
  </div>
</AppLayout>

<script>
  import { setAuth, isAuthenticated } from '../lib/auth';
  import { t, localizedPath, getLocale } from '../i18n';

  const LABELS = t();

  function nameFromEmail(email: string): string {
    const local = email.split('@')[0] ?? '';
    const formatted = local
      .split(/[._\-+]+/)
      .filter(Boolean)
      .map((s) => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase())
      .join(' ');
    return formatted || LABELS.login.defaultPseudo;
  }

  function isValidEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('loginApp', () => ({
      email: '',
      password: '',
      error: '',
      showPassword: false,
      showSignupMessage: false,
      loading: false,
      theme: 'dark' as 'dark' | 'light',
      locale: getLocale(),
      switchToLight: LABELS.layout.switchToLight,
      switchToDark: LABELS.layout.switchToDark,
      switchLocaleAria: LABELS.layout.switchLocale,
      labels: {
        submit: LABELS.login.submit,
        loading: LABELS.login.loading,
        showPassword: LABELS.login.showPassword,
        hidePassword: LABELS.login.hidePassword,
        signupMessage: LABELS.login.signupMessage,
      },

      init() {
        const current =
          document.documentElement.getAttribute('data-theme') || 'dark';
        this.theme = current === 'light' ? 'light' : 'dark';
        if (isAuthenticated()) {
          window.location.href = localizedPath('/');
        }
      },

      toggleTheme() {
        this.theme = this.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', this.theme);
        try {
          window.localStorage.setItem('muscu-theme', this.theme);
        } catch {
          // private mode / quota — silently ignore, the in-memory
          // theme still applies for the current session
        }
      },

      isDark(): boolean {
        return this.theme === 'dark';
      },

      get langTarget(): string {
        return this.locale === 'en' ? 'FR' : 'EN';
      },

      toggleLocale() {
        const target = this.locale === 'en' ? 'fr' : 'en';
        const search = window.location.search;
        const hash = window.location.hash;
        const path = target === 'fr' ? '/login' : '/en/login';
        window.location.href = path + search + hash;
      },

      submit() {
        this.error = '';
        const email = this.email.trim();
        const password = this.password;

        if (!email) { this.error = LABELS.login.errors.emailRequired; return; }
        if (!isValidEmail(email)) { this.error = LABELS.login.errors.emailInvalid; return; }
        if (!password) { this.error = LABELS.login.errors.passwordRequired; return; }

        this.loading = true;
        const name = nameFromEmail(email);
        setAuth(email, name);
        window.setTimeout(() => { window.location.href = localizedPath('/'); }, 240);
      },

      devLogin() {
        this.error = '';
        this.loading = true;
        setAuth('dev@muscu.app', 'Dev User');
        window.location.href = localizedPath('/');
      },
    }));
  });
</script>

<style>
  /* ═══ Theme icon visibility (must be :global to pierce Astro scope) ═══ */
  :global([data-theme="light"]) .login__theme-icon--sun {
    display: none;
  }
  :global([data-theme="light"]) .login__theme-icon--moon {
    display: inline-flex;
  }

  /* ═══ Input placeholder ═══ */
  .login__input::placeholder {
    color: var(--alpha-text-faint);
  }

  /* ═══ Interactive states (hover / focus / active / disabled) ═══ */
  .login__input:hover {
    border-color: var(--alpha-border);
  }

  .login__input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  /* Theme button */
  div:has(> button) > button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Language button */
  .login__lang:hover {
    background-color: var(--color-surface-3);
    border-color: var(--alpha-border);
  }

  .login__lang:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .login__lang:active {
    transform: scale(0.97);
  }

  /* Toggle (show/hide password) */
  div.relative > button:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-soft);
  }

  div.relative > button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Error banner — color-mix cannot be expressed as Tailwind utilities */
  .login__error {
    color: color-mix(in srgb, var(--color-destructive) 75%, var(--color-text));
  }

  /* Submit button */
  button[type="submit"]:hover:not(:disabled) {
    filter: brightness(1.08);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-accent) 42%, transparent);
  }

  button[type="submit"]:active:not(:disabled) {
    transform: scale(0.985);
  }

  button[type="submit"]:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  button[type="submit"]:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring),
      0 6px 18px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  /* Spinner animation */
  .login__spinner {
    animation: login-spin 0.7s linear infinite;
  }

  @keyframes login-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ═══ Divider ::before/::after lines ═══ */
  .login__divider::before,
  .login__divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  /* ═══ Dev section — color-mix for background/border tint ═══ */
  .login__dev {
    background-color: color-mix(in srgb, var(--color-accent) 4%, transparent);
    border: 1px dashed color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .login__dev-badge {
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  /* Dev button interactive states */
  section:last-of-type > button:hover {
    background-color: var(--alpha-bg-soft);
    border-color: var(--alpha-border);
    color: var(--color-text);
  }

  section:last-of-type > button:active {
    transform: scale(0.985);
  }

  section:last-of-type > button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Signup link interactive states */
  .login__signup-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .login__signup-link:focus-visible {
    outline: none;
    text-decoration: underline;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  /* Signup message — color-mix for info tint */
  .login__signup-msg {
    background-color: color-mix(in srgb, var(--color-info) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-info) 25%, transparent);
    border-radius: var(--radius-sm);
    color: color-mix(in srgb, var(--color-info) 78%, var(--color-text));
  }

  /* ═══ Responsive (max-width: 480px) ═══ */
  @media (max-width: 480px) {
    :global(.login__card-wrap) {
      padding: 3.2rem 2.0rem;
    }
  }

  /* ═══ Light theme overrides — color-mix + :global ═══ */
  :global([data-theme="light"]) .login__error {
    color: color-mix(in srgb, var(--color-destructive) 45%, var(--color-text));
    background-color: color-mix(in srgb, var(--color-destructive) 8%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 25%, transparent);
  }

  :global([data-theme="light"]) .login__signup-msg {
    color: color-mix(in srgb, var(--color-info) 45%, var(--color-text));
    background-color: color-mix(in srgb, var(--color-info) 6%, transparent);
    border-color: color-mix(in srgb, var(--color-info) 20%, transparent);
  }

  /* ═══ Reduced motion ═══ */
  @media (prefers-reduced-motion: reduce) {
    .login__spinner {
      animation: none;
    }
  }
</style>
