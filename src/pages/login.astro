---
export const prerender = false;

import { createServerSupabase } from "../lib/supabase-server";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email")?.toString();
  const action = formData.get("action")?.toString();

  if (email && action === "magic-link") {
    const supabase = createServerSupabase(Astro);
    const redirectUrl = new URL("/auth/callback", Astro.url.origin).toString();
    await supabase.auth.signInWithOtp({ email, options: { emailRedirectTo: redirectUrl } });
  }

  if (email && action === "password-login") {
    const password = formData.get("password")?.toString();
    if (password) {
      const supabase = createServerSupabase(Astro);
      await supabase.auth.signInWithPassword({ email, password });
    }
  }

  if (action === "dev-login") {
    Astro.cookies.set(
      "dev_user",
      JSON.stringify({
        id: crypto.randomUUID(),
        email: "dev@localhost",
        app_metadata: {},
        user_metadata: {},
        aud: "authenticated",
        created_at: new Date().toISOString(),
      }),
      { path: "/", maxAge: 86400 },
    );
    return Astro.redirect("/");
  }
}

const user = Astro.locals.user;
if (user) return Astro.redirect("/");
---

<!doctype html>
<html lang="fr">
