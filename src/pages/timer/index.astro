---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { t } from '../../i18n';

const L = t();
---

<AppLayout title={L.timer.title}>
  <PageHeader
    title={L.timer.title}
    description="Minuteur de repos entre les séries ou chronomètre."
  />

  <div
    class="timer"
    x-data="timerApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Mode toggle (Countdown / Stopwatch) ── */}
    <div class="timer__mode" role="tablist" aria-label="Mode du timer">
      <button
        type="button"
        role="tab"
        class="timer__mode-btn"
        :class="{ 'is-active': mode === 'countdown' }"
        :aria-selected="mode === 'countdown'"
        @click="setMode('countdown')"
      >
        <svg
          class="timer__mode-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{L.timer.countdown}</span>
      </button>
      <button
        type="button"
        role="tab"
        class="timer__mode-btn"
        :class="{ 'is-active': mode === 'stopwatch' }"
        :aria-selected="mode === 'stopwatch'"
        @click="setMode('stopwatch')"
      >
        <svg
          class="timer__mode-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="10" y1="2" x2="14" y2="2"></line>
          <line x1="12" y1="14" x2="12" y2="10"></line>
          <circle cx="12" cy="14" r="8"></circle>
        </svg>
        <span>{L.timer.stopwatch}</span>
      </button>
    </div>

    {/* ════════════════════════════════════════════════════
        COUNTDOWN MODE
        ════════════════════════════════════════════════════ */}
    <div class="timer__panel" x-show="mode === 'countdown'" x-transition.opacity.duration.200ms>
      {/* ── Preset buttons ── */}
      <div class="timer__presets" role="group" aria-label="Durées prédéfinies">
        <template x-for="preset in presets" :key="preset">
          <button
            type="button"
            class="timer__preset"
            :class="{ 'is-active': totalTime === preset && !running && remaining === totalTime }"
            @click="setPreset(preset)"
          >
            <span x-text="formatShort(preset)"></span>
          </button>
        </template>
      </div>

      {/* ── Timer display with SVG progress ring ── */}
      <div class="timer__stage">
        <svg
          class="timer__ring"
          viewBox="0 0 320 320"
          aria-hidden="true"
        >
          {/* Background track */}
          <circle
            class="timer__ring-track"
            cx="160"
            cy="160"
            r="140"
            fill="none"
          />
          {/* Progress arc */}
          <circle
            class="timer__ring-progress"
            :class="{ 'is-warning': remaining <= 10 && remaining > 0, 'is-done': remaining === 0 }"
            cx="160"
            cy="160"
            r="140"
            fill="none"
            :stroke-dasharray="circumference"
            :stroke-dashoffset="dashOffset"
            stroke-linecap="round"
          />
        </svg>

        <div class="timer__readout">
          <div
            class="timer__time"
            :class="{ 'is-running': running && remaining > 10, 'is-warning': remaining <= 10 && remaining > 0, 'is-done': remaining === 0 }"
            x-text="formatTime(display)"
            aria-live="polite"
            aria-atomic="true"
          >
            00:00
          </div>
          <div class="timer__status" x-text="statusLabel"></div>
        </div>
      </div>

      {/* ── Custom time input ── */}
      <div class="timer__custom">
        <label for="custom-seconds" class="timer__custom-label" x-text="labels.custom">
          Durée personnalisée
        </label>
        <div class="timer__custom-row">
          <button
            type="button"
            class="timer__step"
            @click="adjustCustom(-15); setCustom()"
            aria-label="Réduire de 15 secondes"
          >
            −15
          </button>
          <input
            id="custom-seconds"
            type="number"
            min="5"
            max="600"
            step="5"
            class="timer__custom-input"
            x-model.number="customTime"
            @keydown.enter="setCustom()"
            @blur="setCustom()"
            aria-label="Durée personnalisée en secondes"
          />
          <button
            type="button"
            class="timer__step"
            @click="adjustCustom(15); setCustom()"
            aria-label="Augmenter de 15 secondes"
          >
            +15
          </button>
        </div>
      </div>

      {/* ── Controls ── */}
      <div class="timer__controls">
        <button
          type="button"
          class="timer__btn timer__btn--primary"
          @click="start()"
          x-show="!running"
          x-transition.opacity.duration.150ms
          x-text="remaining === 0 ? labels.restart : labels.start"
        >
          Démarrer
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--secondary"
          @click="pause()"
          x-show="running"
          x-transition.opacity.duration.150ms
          x-text="labels.pause"
        >
          Pause
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--ghost"
          @click="reset()"
          x-text="labels.reset"
        >
          Reset
        </button>
      </div>

    {/* ── Sound toggle ── */}
    <div class="timer__sound">
      <label class="timer__sound-label">
        <input
          type="checkbox"
          x-model="soundEnabled"
          class="timer__sound-input"
        />
        <svg
          class="timer__sound-icon"
          :class="{ 'is-on': soundEnabled }"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <span x-text="labels.soundAlert">Alerte sonore</span>
      </label>
    </div>
    </div>

    {/* ════════════════════════════════════════════════════
        STOPWATCH MODE
        ════════════════════════════════════════════════════ */}
    <div class="timer__panel" x-show="mode === 'stopwatch'" x-transition.opacity.duration.200ms>
      {/* ── Stopwatch display (no ring) ── */}
      <div class="timer__stage timer__stage--sw">
        <div class="timer__readout">
          <div
            class="timer__time timer__time--sw"
            :class="{ 'is-running': sw.running }"
            x-text="formatStopwatch(sw.elapsed)"
            aria-live="polite"
            aria-atomic="true"
          >
            00:00.00
          </div>
          <div class="timer__status" x-text="swStatusLabel"></div>
        </div>
      </div>

      {/* ── Controls: Start/Pause / Tour / Reset ── */}
      <div class="timer__controls">
        <button
          type="button"
          class="timer__btn timer__btn--primary"
          @click="swStart()"
          x-show="!sw.running"
          x-transition.opacity.duration.150ms
          x-text="sw.elapsed === 0 ? labels.start : labels.resume"
        >
          Démarrer
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--secondary"
          @click="swPause()"
          x-show="sw.running"
          x-transition.opacity.duration.150ms
          x-text="labels.pause"
        >
          Pause
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--accent-ghost"
          @click="swRecordLap()"
          :disabled="!sw.running"
          x-text="labels.lap"
        >
          Tour
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--ghost"
          @click="swReset()"
          x-text="labels.reset"
        >
          Reset
        </button>
      </div>

      {/* ── Lap list ── */}
      <div class="timer__laps" x-show="sw.laps.length > 0" x-transition.opacity.duration.200ms>
        <div class="timer__laps-header">
          <span class="timer__laps-col-label" x-text="labels.lap">Tour</span>
          <span class="timer__laps-col-label" x-text="labels.lapTime">Temps du tour</span>
          <span class="timer__laps-col-label timer__laps-col-label--end" x-text="labels.total">Total</span>
        </div>
        <div class="timer__laps-body">
          <template x-for="(lap, revIdx) in swLapsReversed" :key="lap.totalTime + '-' + revIdx">
            <div class="timer__laps-row" :class="{ 'is-latest': revIdx === 0 }">
              <span class="timer__laps-num" x-text="sw.laps.length - revIdx"></span>
              <span class="timer__laps-time" x-text="formatStopwatch(lap.lapTime)"></span>
              <span class="timer__laps-total" x-text="formatStopwatch(lap.totalTime)"></span>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    window.Alpine.data('timerApp', () => ({
      // ── Mode ──
      mode: 'countdown',  // 'countdown' | 'stopwatch'

      // ── Countdown state ──
      presets: [60, 90, 120, 180],
      totalTime: 90,
      remaining: 90,
      display: 90,
      running: false,
      customTime: 90,
      soundEnabled: true,
      circumference: 2 * Math.PI * 140,
      intervalId: null,
      endTime: 0,
      lastTick: 0,

      // ── Translations ──
      labels: {
        custom: 'Durée personnalisée',
        start: 'Démarrer',
        restart: 'Redémarrer',
        resume: 'Reprendre',
        pause: 'Pause',
        reset: 'Reset',
        lap: 'Tour',
        lapTime: 'Temps du tour',
        total: 'Total',
        soundAlert: 'Alerte sonore',
        running: 'En cours',
        paused: 'En pause',
        ready: 'Prêt',
        done: 'Terminé',
      },

      init() {
        this.display = this.totalTime;
        // Pause everything when tab is hidden (avoid background drift)
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            if (this.running) this.pause();
            if (this.sw.running) this.swPause();
          }
        });
      },

      // ════════════════════════════════════════════════
      // MODE
      // ════════════════════════════════════════════════
      setMode(m) {
        if (m === this.mode) return;
        // Pause whichever is currently running before switching
        this.pause();
        this.swPause();
        this.mode = m;
      },

      // ════════════════════════════════════════════════
      // COUNTDOWN
      // ════════════════════════════════════════════════
      get progress() {
        if (this.totalTime <= 0) return 0;
        return Math.max(0, Math.min(1, this.remaining / this.totalTime));
      },

      get dashOffset() {
        return this.circumference * (1 - this.progress);
      },

      get statusLabel() {
        if (this.running) return this.labels.running;
        if (this.remaining === 0) return this.labels.done;
        if (this.remaining < this.totalTime) return this.labels.paused;
        return this.labels.ready;
      },

      setPreset(seconds) {
        this.pause();
        this.totalTime = seconds;
        this.remaining = seconds;
        this.display = seconds;
        this.customTime = seconds;
      },

      setCustom() {
        const v = Math.max(5, Math.min(600, Number(this.customTime) || 0));
        if (v === 0) return;
        this.pause();
        this.totalTime = v;
        this.remaining = v;
        this.display = v;
        this.customTime = v;
      },

      adjustCustom(delta) {
        this.customTime = Math.max(5, Math.min(600, (this.customTime || 0) + delta));
      },

      start() {
        if (this.remaining <= 0) {
          this.remaining = this.totalTime;
        }
        if (this.running) return;
        this.running = true;
        this.endTime = Date.now() + this.remaining * 1000;
        this.lastTick = Date.now();
        this.intervalId = setInterval(() => this.tick(), 100);
        this.tick();
      },

      pause() {
        if (!this.running) return;
        this.running = false;
        if (this.intervalId) {
          clearInterval(this.intervalId);
          this.intervalId = null;
        }
      },

      reset() {
        this.pause();
        this.remaining = this.totalTime;
        this.display = this.totalTime;
      },

      tick() {
        const now = Date.now();
        const remainingMs = Math.max(0, this.endTime - now);
        const remainingSec = Math.ceil(remainingMs / 1000);
        this.remaining = remainingSec;
        this.display = remainingSec;
        this.lastTick = now;

        if (remainingMs <= 0) {
          this.pause();
          this.display = 0;
          this.remaining = 0;
          if (this.soundEnabled) this.beep();
        }
      },

      // ════════════════════════════════════════════════
      // STOPWATCH
      // ════════════════════════════════════════════════
      get swStatusLabel() {
        if (this.sw.running) return this.labels.running;
        if (this.sw.elapsed > 0) return this.labels.paused;
        return this.labels.ready;
      },

      // Display laps in reverse order (latest on top) without mutating source
      get swLapsReversed() {
        return this.sw.laps.slice().reverse();
      },

      swStart() {
        if (this.sw.running) return;
        this.sw.running = true;
        // Resume: anchor the start to (now - already-elapsed)
        this.sw.startTimestamp = Date.now() - this.sw.elapsed;
        this.sw.intervalId = setInterval(() => this.swTick(), 10);
      },

      swPause() {
        if (!this.sw.running) return;
        this.sw.running = false;
        if (this.sw.intervalId) {
          clearInterval(this.sw.intervalId);
          this.sw.intervalId = null;
        }
        // Commit the latest elapsed so resume picks up where we left off
        this.sw.elapsed = Date.now() - this.sw.startTimestamp;
      },

      swReset() {
        this.swPause();
        this.sw.elapsed = 0;
        this.sw.laps = [];
      },

      swRecordLap() {
        // Only record while running
        if (!this.sw.running) return;
        const total = Date.now() - this.sw.startTimestamp;
        const prevTotal = this.sw.laps.length > 0
          ? this.sw.laps[this.sw.laps.length - 1].totalTime
          : 0;
        this.sw.laps.push({
          lapTime: total - prevTotal,
          totalTime: total,
        });
      },

      swTick() {
        this.sw.elapsed = Date.now() - this.sw.startTimestamp;
      },

      // ════════════════════════════════════════════════
      // FORMATTING
      // ════════════════════════════════════════════════
      formatTime(seconds) {
        const s = Math.max(0, Math.floor(seconds));
        const mm = Math.floor(s / 60).toString().padStart(2, '0');
        const ss = (s % 60).toString().padStart(2, '0');
        return mm + ':' + ss;
      },

      formatShort(seconds) {
        const mm = Math.floor(seconds / 60);
        const ss = seconds % 60;
        if (mm === 0) return ss + 's';
        if (ss === 0) return mm + ':00';
        return mm + ':' + ss.toString().padStart(2, '0');
      },

      // Stopwatch formatter: ms → "MM:SS.cc" (< 1h) or "HH:MM:SS" (≥ 1h)
      formatStopwatch(ms) {
        const totalMs = Math.max(0, Math.floor(ms));
        const hours = Math.floor(totalMs / 3600000);
        const minutes = Math.floor((totalMs % 3600000) / 60000);
        const seconds = Math.floor((totalMs % 60000) / 1000);
        const centis = Math.floor((totalMs % 1000) / 10);
        const pad = (n, w) => n.toString().padStart(w, '0');

        if (hours > 0) {
          return pad(hours, 2) + ':' + pad(minutes, 2) + ':' + pad(seconds, 2);
        }
        return pad(minutes, 2) + ':' + pad(seconds, 2) + '.' + pad(centis, 2);
      },

      beep() {
        try {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (!AudioCtx) return;
          const ctx = new AudioCtx();
          const playTone = (freq, startOffset, duration) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.type = 'sine';
            osc.frequency.value = freq;
            const t0 = ctx.currentTime + startOffset;
            gain.gain.setValueAtTime(0.0001, t0);
            gain.gain.exponentialRampToValueAtTime(0.35, t0 + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.0001, t0 + duration);
            osc.start(t0);
            osc.stop(t0 + duration + 0.02);
          };
          // Three short beeps at increasing pitch
          playTone(660, 0.00, 0.18);
          playTone(780, 0.22, 0.18);
          playTone(990, 0.44, 0.35);
          // Close context after last beep finishes
          setTimeout(() => ctx.close(), 1100);
        } catch (e) {
          // Audio not available — silent fallback
        }
      },

      destroy() {
        if (this.intervalId) clearInterval(this.intervalId);
        if (this.sw.intervalId) clearInterval(this.sw.intervalId);
      },
    }));
  });
</script>

{/* Alpine.js CDN — MUST be AFTER the app script (type="module" runs before defer) */}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<style>
  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .timer {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.6rem;
    padding: 3.2rem 0 6rem;
  }

  /* ════════════════════════════════════════════════════
     MODE TOGGLE — segmented pill, recessed feel
     ════════════════════════════════════════════════════ */
  .timer__mode {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    box-shadow:
      inset 0 2px 4px hsl(0 0% 0% / 0.5),
      inset 0 -1px 0 hsl(0 0% 100% / 0.04);
  }

  .timer__mode-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-width: 14rem;
    height: 4.4rem;
    padding: 0 2.4rem;
    background-color: transparent;
    border: none;
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 300ms cubic-bezier(0.4, 0, 0.2, 1),
                background-color 300ms cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1),
                transform 160ms ease;
  }

  .timer__mode-icon {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    color: currentColor;
  }

  .timer__mode-btn:hover:not(.is-active) {
    color: var(--color-text);
  }

  .timer__mode-btn:active {
    transform: scale(0.97);
  }

  .timer__mode-btn.is-active {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    box-shadow:
      0 2px 10px hsl(32 95% 50% / 0.40),
      inset 0 1px 0 hsl(0 0% 100% / 0.22);
  }

  /* ════════════════════════════════════════════════════
     PANEL WRAPPER
     ════════════════════════════════════════════════════ */
  .timer__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.6rem;
    width: 100%;
  }

  /* ════════════════════════════════════════════════════
     PRESETS — 4-column grid, pill buttons
     ════════════════════════════════════════════════════ */
  .timer__presets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    width: 100%;
    max-width: 40rem;
  }

  .timer__preset {
    height: 4.8rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 300ms ease,
                background-color 300ms ease,
                border-color 300ms ease,
                box-shadow 300ms ease,
                transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timer__preset:hover {
    color: var(--color-text);
    background-color: var(--color-surface-3);
    border-color: hsl(0 0% 100% / 0.20);
    transform: translateY(-2px);
  }

  .timer__preset:active {
    transform: translateY(0) scale(0.97);
  }

  .timer__preset.is-active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: hsl(32 95% 50% / 0.10);
    box-shadow: 0 0 24px hsl(32 95% 50% / 0.30);
  }

  /* ════════════════════════════════════════════════════
     STAGE — SVG ring + readout (centered hero)
     ════════════════════════════════════════════════════ */
  .timer__stage {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Stopwatch: no ring, wider for centiseconds */
  .timer__stage--sw {
    width: auto;
    height: auto;
    padding: 2.4rem 0 0.8rem;
  }

  .timer__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .timer__ring-track {
    stroke: var(--color-surface-3);
    stroke-width: 6;
  }

  .timer__ring-progress {
    stroke: var(--color-accent);
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dashoffset 100ms linear,
                stroke 300ms ease,
                filter 300ms ease;
    filter: drop-shadow(0 0 6px hsl(32 95% 50% / 0.45));
  }

  .timer__ring-progress.is-warning {
    stroke: var(--color-warning);
    filter: drop-shadow(0 0 6px hsl(48 95% 55% / 0.45));
  }

  .timer__ring-progress.is-done {
    stroke: var(--color-success);
    filter: drop-shadow(0 0 6px hsl(142 70% 45% / 0.45));
  }

  /* ════════════════════════════════════════════════════
     READOUT — time + status
     ════════════════════════════════════════════════════ */
  .timer__readout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    user-select: none;
  }

  .timer__time {
    font-family: var(--font-display);
