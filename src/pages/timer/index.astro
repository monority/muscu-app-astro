---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { t, setLocale, defaultLocale } from '../../i18n';


setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.timer.title}>
  <PageHeader
    title={L.timer.title}
    description={L.timer.description}
  />

  <div
    class="timer"
    x-data="timerApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Pop-out window ── */}
    <button
      type="button"
      class="timer__popout"
      :class="{ 'is-open': popupOpen }"
      @click="openPopup()"
      :aria-label="labels.popoutAria"
      :title="labels.popout"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 3 21 3 21 9"></polyline>
        <polyline points="9 21 3 21 3 15"></polyline>
        <line x1="21" y1="3" x2="14" y2="10"></line>
        <line x1="3" y1="21" x2="10" y2="14"></line>
      </svg>
      <span class="timer__popout-label" x-text="popupOpen ? labels.popoutOpen : labels.popout"></span>
    </button>

    {/* ── Mode toggle (Countdown / Stopwatch) ── */}
    <div class="timer__mode" role="tablist" aria-label={L.timer.modeAria}>
      <button
        type="button"
        role="tab"
        class="timer__mode-btn"
        :class="{ 'is-active': mode === 'countdown' }"
        :aria-selected="mode === 'countdown'"
        @click="setMode('countdown')"
      >
        <svg
          class="timer__mode-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{L.timer.countdown}</span>
      </button>
      <button
        type="button"
        role="tab"
        class="timer__mode-btn"
        :class="{ 'is-active': mode === 'stopwatch' }"
        :aria-selected="mode === 'stopwatch'"
        @click="setMode('stopwatch')"
      >
        <svg
          class="timer__mode-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="10" y1="2" x2="14" y2="2"></line>
          <line x1="12" y1="14" x2="12" y2="10"></line>
          <circle cx="12" cy="14" r="8"></circle>
        </svg>
        <span>{L.timer.stopwatch}</span>
      </button>
    </div>

    {/* ── Keyboard shortcut hints ── */}
    <div class="timer__shortcuts" aria-hidden="true">
      <span class="timer__shortcut">
        <kbd class="timer__kbd">Espace</kbd>
        <span x-text="labels.shortcutsToggle"></span>
      </span>
      <span class="timer__shortcut">
        <kbd class="timer__kbd">R</kbd>
        <span x-text="labels.shortcutsReset"></span>
      </span>
    </div>

    {/* ════════════════════════════════════════════════════
        COUNTDOWN MODE
        ════════════════════════════════════════════════════ */}
    <div class="timer__panel" x-show="mode === 'countdown'" x-transition.opacity.duration.200ms>
      {/* ── Preset buttons ── */}
      <div class="timer__presets" role="group" aria-label={L.timer.presetsAria}>
        <template x-for="preset in presets" :key="preset">
          <button
            type="button"
            class="timer__preset"
            :class="{ 'is-active': totalTime === preset && !running && remaining === totalTime }"
            @click="setPreset(preset)"
          >
            <span x-text="formatShort(preset)"></span>
          </button>
        </template>
      </div>

      {/* ── Timer display with SVG progress ring ── */}
      <div class="timer__stage">
        <svg
          class="timer__ring"
          viewBox="0 0 320 320"
          aria-hidden="true"
        >
          {/* Background track */}
          <circle
            class="timer__ring-track"
            cx="160"
            cy="160"
            r="140"
            fill="none"
          />
          {/* Progress arc */}
          <circle
            class="timer__ring-progress"
            :class="{ 'is-warning': remaining <= 10 && remaining > 0, 'is-done': remaining === 0 }"
            cx="160"
            cy="160"
            r="140"
            fill="none"
            :stroke-dasharray="circumference"
            :stroke-dashoffset="dashOffset"
            stroke-linecap="round"
          />
        </svg>

        <div class="timer__readout">
          <div
            class="timer__time"
            :class="{ 'is-running': running && remaining > 10, 'is-warning': remaining <= 10 && remaining > 0, 'is-done': remaining === 0 }"
            x-text="formatTime(display)"
            aria-live="polite"
            aria-atomic="true"
          >
            00:00
          </div>
          <div class="timer__status" x-text="statusLabel"></div>
        </div>
      </div>

      {/* ── Custom time input ── */}
      <div class="timer__custom">
        <label for="custom-seconds" class="timer__custom-label" x-text="labels.custom">
          {L.timer.custom}
        </label>
        <div class="timer__custom-row">
          <button
            type="button"
            class="timer__step"
            @click="adjustCustom(-15); setCustom()"
            aria-label={L.timer.reduce15}
          >
            −15
          </button>
          <input
            id="custom-seconds"
            type="number"
            min="5"
            max="600"
            step="5"
            class="timer__custom-input no-spinner"
            x-model.number="customTime"
            @keydown.enter="setCustom()"
            @blur="setCustom()"
            aria-label={L.timer.customSeconds}
          />
          <button
            type="button"
            class="timer__step"
            @click="adjustCustom(15); setCustom()"
            aria-label={L.timer.increase15}
          >
            +15
          </button>
        </div>
      </div>

      {/* ── Controls ── */}
      <div class="timer__controls">
        <button
          type="button"
          class="timer__btn timer__btn--primary"
          @click="toggle()"
          x-text="toggleLabel"
        >
          {L.timer.start}
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--ghost"
          @click="reset()"
          x-text="labels.reset"
        >
          Reset
        </button>
      </div>

    {/* ── Sound toggle ── */}
    <div class="timer__sound">
      <label class="timer__sound-label">
        <input
          type="checkbox"
          x-model="soundEnabled"
          class="timer__sound-input"
        />
        <svg
          class="timer__sound-icon"
          :class="{ 'is-on': soundEnabled }"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <span x-text="labels.soundAlert">Alerte sonore</span>
      </label>
    </div>
    </div>

    {/* ════════════════════════════════════════════════════
        STOPWATCH MODE
        ════════════════════════════════════════════════════ */}
    <div class="timer__panel" x-show="mode === 'stopwatch'" x-transition.opacity.duration.200ms>
      {/* ── Stopwatch display (no ring) ── */}
      <div class="timer__stage timer__stage--sw">
        <div class="timer__readout">
          <div
            class="timer__time timer__time--sw"
            :class="{ 'is-running': sw.running }"
            x-text="formatStopwatch(sw.elapsed)"
            aria-live="polite"
            aria-atomic="true"
          >
            00:00.00
          </div>
          <div class="timer__status" x-text="swStatusLabel"></div>
        </div>
      </div>

      {/* ── Controls: Start/Pause / Tour / Reset ── */}
      <div class="timer__controls">
        <button
          type="button"
          class="timer__btn timer__btn--primary"
          @click="toggle()"
          x-text="toggleLabel"
        >
          {L.timer.start}
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--accent-ghost"
          @click="swRecordLap()"
          :disabled="!sw.running"
          x-text="labels.lap"
        >
          Tour
        </button>
        <button
          type="button"
          class="timer__btn timer__btn--ghost"
          @click="swReset()"
          x-text="labels.reset"
        >
          Reset
        </button>
      </div>

      {/* ── Lap list ── */}
      <div class="timer__laps" x-show="sw.laps.length > 0" x-transition.opacity.duration.200ms>
        <div class="timer__laps-header">
          <span class="timer__laps-col-label" x-text="labels.lap">Tour</span>
          <span class="timer__laps-col-label" x-text="labels.lapTime">Temps du tour</span>
          <span class="timer__laps-col-label timer__laps-col-label--end" x-text="labels.total">Total</span>
        </div>
        <div class="timer__laps-body">
          <template x-for="(lap, revIdx) in swLapsReversed" :key="lap.totalTime + '-' + revIdx">
            <div class="timer__laps-row" :class="{ 'is-latest': revIdx === 0 }">
              <span class="timer__laps-num" x-text="sw.laps.length - revIdx"></span>
              <span class="timer__laps-time" x-text="formatStopwatch(lap.lapTime)"></span>
              <span class="timer__laps-total" x-text="formatStopwatch(lap.totalTime)"></span>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { t, defaultLocale, localizedPath } from '../../i18n';
  import {
    mountTimerWidget,
    widgetLabelsFrom,
    TIMER_CHANNEL,
    type TimerSnapshot,
  } from '../../lib/timer-widget';
  import { playBeep } from '../../lib/sound';

  const LABELS = t();

  // Pop-out bridge kept OUTSIDE the reactive Alpine store: Alpine proxies
  // its state, which breaks exotic objects like BroadcastChannel. Only the
  // `popupOpen` flag lives in the component (it drives the button class).
  const timerBridge: {
    channel: BroadcastChannel | null;
    pipWindow: Window | null;
    popWatcher: number;
    remoteConnected: boolean;
    connWatchdog: number;
    instanceId: string;
  } = {
    channel: null,
    pipWindow: null,
    popWatcher: 0,
    remoteConnected: false,
    connWatchdog: 0,
    instanceId: 'm' + Math.random().toString(36).slice(2, 10),
  };

  document.addEventListener('alpine:init', () => {
    window.Alpine.data('timerApp', () => ({
      // ── Mode ──
      mode: 'countdown',  // 'countdown' | 'stopwatch'

      // ── Pop-out window ──
      popupOpen: false,

      // ── Stopwatch state ──
      sw: {
        running: false,
        elapsed: 0,
        laps: [] as { lapTime: number; totalTime: number }[],
        startTimestamp: 0,
        intervalId: null as number | null,
      },

      // ── Countdown state ──
      presets: [60, 90, 120, 180],
      totalTime: 90,
      remaining: 90,
      display: 90,
      running: false,
      customTime: 90,
      soundEnabled: true,
      circumference: 2 * Math.PI * 140,
      intervalId: null,
      endTime: 0,
      lastTick: 0,

      // ── Translations ──
      labels: {
        title: LABELS.timer.title,
        countdown: LABELS.timer.countdown,
        stopwatch: LABELS.timer.stopwatch,
        custom: LABELS.timer.custom,
        start: LABELS.timer.start,
        restart: LABELS.timer.restart,
        resume: LABELS.timer.resume,
        pause: LABELS.timer.pause,
        reset: LABELS.timer.reset,
        lap: LABELS.timer.lap,
        lapTime: LABELS.timer.lapTime,
        total: LABELS.timer.total,
        soundAlert: LABELS.timer.soundAlert,
        running: LABELS.timer.running,
        paused: LABELS.timer.paused,
        ready: LABELS.timer.ready,
        done: LABELS.timer.done,
        popout: LABELS.timer.popout,
        popoutAria: LABELS.timer.popoutAria,
        popoutOpen: LABELS.timer.popoutOpen,
        shortcutsToggle: LABELS.timer.shortcutsToggle,
        shortcutsReset: LABELS.timer.shortcutsReset,
      },

      // ── Keyboard ──
      _keyHandler: null as ((e: KeyboardEvent) => void) | null,

      // ── Pop-out bridge plumbing ──
      init() {
        this.display = this.totalTime;
        this._installKeyboard();
        // init() can run twice (Alpine auto-calls it AND x-init does). Guard
        // so a second run doesn't leave two live BroadcastChannels — every
        // message would then be handled twice (duplicate laps/commands).
        if (!timerBridge.channel) {
          timerBridge.channel = new BroadcastChannel(TIMER_CHANNEL);
          timerBridge.channel.onmessage = (ev: MessageEvent) => this.handleRemote(ev.data);
        }
        // Pause everything when tab is hidden (avoid background drift) —
        // UNLESS a pop-out window is open: then the timer keeps running so
        // the popup can carry it across screens/tabs.
        document.addEventListener('visibilitychange', () => {
          if (document.hidden && !this.popupOpen) {
            if (this.running) this.pause();
            if (this.sw.running) this.swPause();
          }
        });
      },

      // ════════════════════════════════════════════════
      // POP-OUT WINDOW (Picture-in-Picture + fallback)
      // ════════════════════════════════════════════════
      snapshot(): TimerSnapshot {
        return {
          mode: this.mode,
          totalTime: this.totalTime,
          remaining: this.remaining,
          running: this.running,
          endAt: this.running ? this.endTime : 0,
          swRunning: this.sw.running,
          swStartAt: this.sw.running ? this.sw.startTimestamp : 0,
          swElapsed: this.sw.elapsed,
          laps: this.sw.laps.map((l) => ({ ...l })),
          soundEnabled: this.soundEnabled,
          now: Date.now(),
        };
      },

      // Push state to the popup (only when one is open).
      broadcast() {
        if (!this.popupOpen && !timerBridge.remoteConnected) return;
        this.pushState();
      },

      // Push state unconditionally (used to answer a handshake).
      pushState() {
        timerBridge.channel?.postMessage({
          type: 'state',
          owner: timerBridge.instanceId,
          state: this.snapshot(),
        });
      },

      handleRemote(msg: any) {
        if (!msg || typeof msg !== 'object') return;
        if (msg.type === 'hello') {
          if (msg.target && msg.target !== '*' && msg.target !== timerBridge.instanceId) return;
          // Any widget saying hello is a live remote view — broadcast events to
          // it even when it was opened standalone (popupOpen stays false).
          // The popup repeats hello every 2.5s; if it stops (window closed) the
          // watchdog flips the flag back so we don't push into the void.
          timerBridge.remoteConnected = true;
          if (timerBridge.connWatchdog) clearTimeout(timerBridge.connWatchdog);
          timerBridge.connWatchdog = window.setTimeout(() => {
            timerBridge.remoteConnected = false;
            timerBridge.connWatchdog = 0;
          }, 6500);
          this.pushState();
          return;
        }
        if (msg.type !== 'cmd') return;
        if (msg.target && msg.target !== timerBridge.instanceId) return;
        switch (msg.cmd) {
          case 'start':
            if (this.mode === 'stopwatch') this.swStart();
            else this.start();
            break;
          case 'pause':
            if (this.mode === 'stopwatch') this.swPause();
            else this.pause();
            break;
          case 'reset':
            if (this.mode === 'stopwatch') this.swReset();
            else this.reset();
            break;
          case 'lap':
            this.swRecordLap();
            break;
          case 'setMode':
            this.setMode(msg.value === 1 ? 'stopwatch' : 'countdown');
            break;
          case 'setTime':
            this.setPreset(Math.max(5, Math.min(600, Number(msg.value) || 90)));
            break;
        }
        // Echo the resulting state straight back so the remote view updates
        // immediately (it also works when the popup was opened standalone —
        // no popupOpen needed on this end).
        this.pushState();
      },

      async openPopup() {
        if (this.popupOpen) {
          timerBridge.pipWindow?.focus();
          return;
        }
        if (!('documentPictureInPicture' in window)) {
          // No PiP support (Firefox/Safari…) — plain popup, opened synchronously
          // while the user activation is still intact (await would consume it).
          this.openFallback();
          return;
        }
        try {
          const pip = await (window as any).documentPictureInPicture.requestWindow({
            width: 400,
            height: 580,
          });
          this.attachPip(pip);
        } catch (e) {
          // PiP denied/unsupported at runtime — best-effort popup fallback.
          this.openFallback();
        }
      },

      openFallback() {
        const w = window.open(
          localizedPath('/timer/pop'),
          'muscu_timer_pop',
          'popup,width=400,height=580',
        );
        if (!w) return;
        this.popupOpen = true;
        if (timerBridge.popWatcher) clearInterval(timerBridge.popWatcher);
        timerBridge.popWatcher = window.setInterval(() => {
          if (w.closed) {
            window.clearInterval(timerBridge.popWatcher);
            timerBridge.popWatcher = 0;
            this.popupOpen = false;
          }
        }, 500);
        // Let the popup mount its widget before pushing state.
        setTimeout(() => this.broadcast(), 350);
      },

      attachPip(pip: Window) {
        timerBridge.pipWindow = pip;
        this.popupOpen = true;
        const doc = pip.document;
        doc.title = this.labels.title;
        doc.documentElement.setAttribute(
          'data-theme',
          document.documentElement.getAttribute('data-theme') || 'dark',
        );
        // PiP body pre-mount paint — resolve the real --color-bg token so the
        // window opens theme-correct (pop.astro does the same for <meta
        // theme-color>). #0d0d0d is a legit fallback: the fresh PiP document has
        // no stylesheet parsed yet, so the token may not resolve.
        const bodyBg =
          getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim() ||
          '#0d0d0d';
        doc.body.style.cssText =
          'margin:0;background:' + bodyBg + ';overflow:hidden';
        const root = doc.createElement('div');
        root.id = 'tw-mount';
        doc.body.appendChild(root);
        const widget = mountTimerWidget(root, widgetLabelsFrom(t()));
        widget.setSnapshot(this.snapshot(), timerBridge.instanceId);
        pip.addEventListener('pagehide', () => {
          timerBridge.pipWindow = null;
          this.popupOpen = false;
          widget.destroy();
        });
      },

      // ════════════════════════════════════════════════
      // MODE
      // ════════════════════════════════════════════════
      setMode(m) {
        if (m === this.mode) return;
        // Pause whichever is currently running before switching
        this.pause();
        this.swPause();
        this.mode = m;
        this.broadcast();
      },

      // Single start/pause/resume toggle (avoids the two-button swap that
      // reflowed the layout and made the reset button jump while fading).
      toggle() {
        if (this.mode === 'stopwatch') {
          if (this.sw.running) this.swPause();
          else this.swStart();
        } else {
          if (this.running) this.pause();
          else this.start();
        }
      },

      get toggleLabel() {
        if (this.mode === 'stopwatch') {
          if (this.sw.running) return this.labels.pause;
          return this.sw.elapsed > 0 ? this.labels.resume : this.labels.start;
        }
        if (this.running) return this.labels.pause;
        if (this.remaining === 0) return this.labels.restart;
        if (this.remaining < this.totalTime) return this.labels.resume;
        return this.labels.start;
      },

      // ════════════════════════════════════════════════
      // COUNTDOWN
      // ════════════════════════════════════════════════
      get progress() {
        if (this.totalTime <= 0) return 0;
        return Math.max(0, Math.min(1, this.remaining / this.totalTime));
      },

      get dashOffset() {
        return this.circumference * (1 - this.progress);
      },

      get statusLabel() {
        if (this.running) return this.labels.running;
        if (this.remaining === 0) return this.labels.done;
        if (this.remaining < this.totalTime) return this.labels.paused;
        return this.labels.ready;
      },

      setPreset(seconds) {
        this.pause();
        this.totalTime = seconds;
        this.remaining = seconds;
        this.display = seconds;
        this.customTime = seconds;
        this.broadcast();
      },

      setCustom() {
        const v = Math.max(5, Math.min(600, Number(this.customTime) || 0));
        if (v === 0) return;
        this.pause();
        this.totalTime = v;
        this.remaining = v;
        this.display = v;
        this.customTime = v;
        this.broadcast();
      },

      adjustCustom(delta) {
        this.customTime = Math.max(5, Math.min(600, (this.customTime || 0) + delta));
      },

      start() {
        if (this.remaining <= 0) {
          this.remaining = this.totalTime;
        }
        if (this.running) return;
        this.running = true;
        this.endTime = Date.now() + this.remaining * 1000;
        this.lastTick = Date.now();
        this.intervalId = setInterval(() => this.tick(), 100);
        this.tick();
        this.broadcast();
      },

      pause() {
        if (!this.running) return;
        this.running = false;
        if (this.endTime) {
          this.remaining = Math.max(0, Math.ceil((this.endTime - Date.now()) / 1000));
          this.display = this.remaining;
        }
        if (this.intervalId) {
          clearInterval(this.intervalId);
          this.intervalId = null;
        }
        this.broadcast();
      },

      reset() {
        this.pause();
        this.remaining = this.totalTime;
        this.display = this.totalTime;
        this.broadcast();
      },

      tick() {
        const now = Date.now();
        const remainingMs = Math.max(0, this.endTime - now);
        const remainingSec = Math.ceil(remainingMs / 1000);
        this.remaining = remainingSec;
        this.display = remainingSec;
        this.lastTick = now;

        if (remainingMs <= 0) {
          this.pause();
          this.display = 0;
          this.remaining = 0;
          // When a pop-out window is open, the popup plays the beep (the main
          // page may be hidden); otherwise beep here.
          if (this.soundEnabled && !this.popupOpen) this.beep();
        }
      },

      // ════════════════════════════════════════════════
      // STOPWATCH
      // ════════════════════════════════════════════════
      get swStatusLabel() {
        if (this.sw.running) return this.labels.running;
        if (this.sw.elapsed > 0) return this.labels.paused;
        return this.labels.ready;
      },

      // Display laps in reverse order (latest on top) without mutating source
      get swLapsReversed() {
        return this.sw.laps.slice().reverse();
      },

      swStart() {
        if (this.sw.running) return;
        this.sw.running = true;
        // Resume: anchor the start to (now - already-elapsed)
        this.sw.startTimestamp = Date.now() - this.sw.elapsed;
        this.sw.intervalId = setInterval(() => this.swTick(), 10);
        this.broadcast();
      },

      swPause() {
        if (!this.sw.running) return;
        this.sw.running = false;
        if (this.sw.intervalId) {
          clearInterval(this.sw.intervalId);
          this.sw.intervalId = null;
        }
        // Commit the latest elapsed so resume picks up where we left off
        this.sw.elapsed = Date.now() - this.sw.startTimestamp;
        this.broadcast();
      },

      swReset() {
        this.swPause();
        this.sw.elapsed = 0;
        this.sw.laps = [];
        this.broadcast();
      },

      swRecordLap() {
        // Only record while running
        if (!this.sw.running) return;
        const total = Date.now() - this.sw.startTimestamp;
        const prevTotal = this.sw.laps.length > 0
          ? this.sw.laps[this.sw.laps.length - 1].totalTime
          : 0;
        this.sw.laps.push({
          lapTime: total - prevTotal,
          totalTime: total,
        });
        this.broadcast();
      },

      swTick() {
        this.sw.elapsed = Date.now() - this.sw.startTimestamp;
      },

      // ════════════════════════════════════════════════
      // FORMATTING
      // ════════════════════════════════════════════════
      formatTime(seconds) {
        const s = Math.max(0, Math.floor(seconds));
        const mm = Math.floor(s / 60).toString().padStart(2, '0');
        const ss = (s % 60).toString().padStart(2, '0');
        return mm + ':' + ss;
      },

      formatShort(seconds) {
        const mm = Math.floor(seconds / 60);
        const ss = seconds % 60;
        if (mm === 0) return ss + 's';
        if (ss === 0) return mm + ':00';
        return mm + ':' + ss.toString().padStart(2, '0');
      },

      // Stopwatch formatter: ms → "MM:SS.cc" (< 1h) or "HH:MM:SS" (≥ 1h)
      formatStopwatch(ms) {
        const totalMs = Math.max(0, Math.floor(ms));
        const hours = Math.floor(totalMs / 3600000);
        const minutes = Math.floor((totalMs % 3600000) / 60000);
        const seconds = Math.floor((totalMs % 60000) / 1000);
        const centis = Math.floor((totalMs % 1000) / 10);
        const pad = (n, w) => n.toString().padStart(w, '0');

        if (hours > 0) {
          return pad(hours, 2) + ':' + pad(minutes, 2) + ':' + pad(seconds, 2);
        }
        return pad(minutes, 2) + ':' + pad(seconds, 2) + '.' + pad(centis, 2);
      },

      beep() {
        playBeep();
      },

      // ── Keyboard shortcuts ──
      _installKeyboard() {
        if (this._keyHandler) return;
        this._keyHandler = (e: KeyboardEvent) => {
          // Don't hijack typing in form fields (e.g. the custom time input).
          const target = e.target as HTMLElement | null;
          if (
            target &&
            (target.tagName === 'INPUT' ||
              target.tagName === 'TEXTAREA' ||
              target.tagName === 'SELECT' ||
              target.isContentEditable)
          ) {
            return;
          }
          // Leave browser/app shortcuts alone.
          if (e.ctrlKey || e.metaKey || e.altKey) return;
          if (e.key === ' ') {
            e.preventDefault();
            this.toggle();
          } else if (e.key.toLowerCase() === 'r') {
            if (this.mode === 'stopwatch') this.swReset();
            else this.reset();
          }
        };
        window.addEventListener('keydown', this._keyHandler);
      },

      destroy() {
        if (this._keyHandler) {
          window.removeEventListener('keydown', this._keyHandler);
          this._keyHandler = null;
        }
        if (this.intervalId) clearInterval(this.intervalId);
        if (this.sw.intervalId) clearInterval(this.sw.intervalId);
      },
    }));
  });
</script>

