---
import { defaultLocale } from '../../i18n';
import '../../styles/globals.css';
const lang = Astro.currentLocale ?? defaultLocale;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d0d" />
    <title>Timer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fonts come from the globals.css @import (Inter) — no separate link needed. */}
    <script is:inline>
      /* Match the app's theme (dark default) so the popup never flashes white. */
      (function () {
        try {
          var theme = localStorage.getItem('muscu-theme') || 'dark';
          if (theme !== 'light' && theme !== 'dark') theme = 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          // Sync the browser chrome color with the real --color-bg token
          // (globals.css is imported above, so the token is in scope; data-theme
          // is set first so light/dark resolves). The dark fallback value stays
          // for a no-token edge. Runs pre-paint, before the native meta content
          // can show.
          var bg =
            getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim() ||
            '#0d0d0d';
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = bg;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div id="tw-mount" class="w-full min-h-screen"></div>

    <script>
      import { mountTimerWidget, widgetLabelsFrom } from '../../lib/timer-widget';
      import { t, setLocale } from '../../i18n';

      setLocale(document.documentElement.getAttribute('lang') || 'fr');
      const LABELS = widgetLabelsFrom(t());

      const root = document.getElementById('tw-mount');
      if (root) {
        const widget = mountTimerWidget(root, LABELS);
        // Ask the main timer page (if open) to send its state. Retry until it
        // answers — the popup may have been opened before the main window.
        const hello = () => widget.sendHello();
        hello();
        window.setInterval(hello, 2500);
      }
    </script>
  </body>
</html>
