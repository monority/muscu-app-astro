---
export const prerender = false;

import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Accueil" activeNav="home">
  <section class="dash">
    <h1 class="dash-title">Tableau de bord</h1>

    <div class="dash-cards">
      <div class="dash-card" data-active-session>
        <div class="dash-card-header">
          <span class="dash-card-dot" aria-hidden="true"></span>
          <span class="dash-card-label">Séance en cours</span>
        </div>
        <p class="dash-card-stat">
          <span data-active-exercise>—</span>
        </p>
        <p class="dash-card-meta">
          <span data-active-sets>0</span> série(s) ·
          <span data-active-volume>0</span> kg
        </p>
        <a href="/session" class="dash-card-cta" data-start-session>
          Continuer la séance
        </a>
      </div>

      <div class="dash-card dash-card-empty hidden" data-no-session>
        <p class="dash-card-stat">Aucune séance active</p>
        <p class="dash-card-meta">Prêt à commencer ?</p>
        <a href="/session" class="dash-card-cta" data-start-session>
          Nouvelle séance
        </a>
      </div>

      <div class="dash-card dash-card-secondary">
        <span class="dash-card-label">Dernières séances</span>
        <ul class="dash-recent" data-recent-list>
          <li class="dash-recent-empty">Aucune séance terminée</li>
        </ul>
      </div>
    </div>
  </section>
</AppLayout>

<script>
  import "../scripts/dashboard";
</script>

<style>
  .dash {
    display: grid;
    gap: 2rem;
  }

  .dash-title {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--text);
  }

  .dash-cards {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr));
  }

  .dash-card {
    display: grid;
    gap: 0.8rem;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .dash-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dash-card-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .dash-card-label {
    color: hsl(0 0% 100% / 0.4);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .dash-card-stat {
    margin: 0;
    font-size: 2.4rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--text);
  }

  .dash-card-meta {
    margin: 0;
    color: var(--muted);
    font-size: 1.3rem;
  }

  .dash-card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.8rem;
    padding: 0.6rem 1.6rem;
    border: 1px solid hsl(0 84% 62% / 0.45);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-foreground);
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 700;
    margin-top: 0.4rem;
  }

  .dash-card-cta:hover {
    background: hsl(0 84% 58%);
  }

  .dash-card-secondary {
    background: transparent;
  }

  .dash-recent {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dash-recent li {
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 1.3rem;
    color: var(--muted);
  }

  .dash-recent-empty {
    color: var(--muted);
    font-size: 1.3rem;
  }

  .hidden {
    display: none !important;
  }
</style>
