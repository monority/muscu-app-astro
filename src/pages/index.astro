---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import { t, localizedPath } from '../i18n';
import { icons } from '../lib/icons';

const L = t();
---

<AppLayout title={L.dashboard.title}>
  <PageHeader
    title={L.dashboard.title}
    description={L.dashboard.description}
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/seances/creer")}
  />

  <div class="max-w-[96rem] mx-auto pb-[6rem]" x-data="dashboardApp()" x-init="init()" x-cloak>
    {/* ── Quick actions — always visible in BOTH states ── */}
    <div class="flex flex-wrap gap-[1.2rem] mb-[2.4rem]">
      <Button variant="primary" size="md" href={localizedPath("/seances/creer")}>
        <Fragment set:html={icons.plus(16, 16)} />
        <span>{L.dashboard.newSession}</span>
      </Button>
      <Button variant="secondary" size="md" href={localizedPath("/timer")}>
        <Fragment set:html={icons.clockStopwatch(16, 16)} />
        <span>{L.dashboard.stopwatch}</span>
      </Button>
    </div>

    {/* ── Main dashboard (once training has started) ── */}
    <div x-show="hasSessions">
      <div class="overview-grid grid gap-0 mb-[3.2rem] border-t border-border">
      {/* ── Hero: today's volume ── */}
      <section class="hero-section relative flex flex-col gap-[0.8rem] mb-0 pt-[1.6rem] pb-[2.4rem] bg-transparent border-b border-border" aria-label={L.dashboard.todayVolume}>
        <div class="inline-flex items-center justify-center w-[2.8rem] h-[2.8rem] rounded-full bg-stat-volume-bg text-stat-volume shrink-0" aria-hidden="true">
          <Fragment set:html={icons.trendingUp(16, 16)} />
        </div>
        <span class="text-[1.1rem] text-muted uppercase tracking-[0.08em] font-bold">{L.dashboard.todayVolume}</span>
        <div class="flex items-baseline gap-[0.8rem]">
          <span class="hero-number font-display font-bold leading-none text-text tabular-nums" x-text="formatVolume(todayVolume)"></span>
          <span class="text-[1.6rem] font-semibold text-muted uppercase tracking-[0.04em]" x-text="todayVolume > 0 ? labels.kg : ''"></span>
        </div>
        <div class="flex flex-wrap items-baseline gap-[0.6rem] text-[1.3rem] font-medium text-muted" x-show="todaySessions > 0">
          <span
            x-text="todaySessions === 1 ? labels.sessionCount.replace('{count}', todaySessions) : todaySessions + ' ' + labels.sessionsUnit"
          ></span>
          <span class="text-alpha-text-faint" aria-hidden="true">·</span>
          <span
            x-text="todayExercises === 1 ? labels.exerciseCount.replace('{count}', todayExercises) : todayExercises + ' ' + labels.exercisesUnit"
          ></span>
        </div>
      </section>

      {/* ── Weekly goal card ── */}
      <section class="goal-section relative flex items-center gap-[2.2rem] mb-0 p-[2.4rem] rounded-lg overflow-hidden" aria-label={L.dashboard.goalCardAria}>
        <div class="relative shrink-0 w-[7.2rem] h-[7.2rem]" aria-hidden="true">
          <svg viewBox="0 0 44 44" class="goal-ring-svg w-full h-full">
            <circle
              cx="22"
              cy="22"
              r="18"
              class="goal-ring-track"
            ></circle>
            <circle
              cx="22"
              cy="22"
              r="18"
              class="goal-ring-fill"
              :class="{ 'goal-ring-fill--complete': weeklyDone >= settings.weeklyGoal }"
              :stroke-dasharray="`${weeklyProgress * 113.1} 113.1`"
            ></circle>
          </svg>
          <span
            class="absolute inset-0 flex items-center justify-center font-display text-[1.6rem] font-bold text-text tabular-nums leading-none"
            x-text="`${Math.round(weeklyProgress * 100)}%`"
          ></span>
        </div>

        <div class="flex flex-col gap-[0.6rem] min-w-0 flex-1">
          <span
            class="text-[1.1rem] text-muted uppercase tracking-[0.08em] font-bold"
            x-text="labels.weeklyGoalEyebrow"
          >{L.dashboard.weeklyGoalEyebrow}</span>
          <h2 class="goal-title flex items-baseline flex-wrap gap-[0.4rem] font-display font-bold text-text m-0 leading-[1.1] tabular-nums">
            <span class="text-accent" x-text="weeklyDone"></span>
            <span class="text-muted mx-[0.2rem]" aria-hidden="true">/</span>
            <span class="text-text" x-text="settings.weeklyGoal">3</span>
            <span
              class="goal-unit font-body text-[1.4rem] font-medium text-muted ml-[0.8rem] normal-case tracking-normal"
              x-text="weeklyDone === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
            >{L.dashboard.sessionsUnit}</span>
          </h2>

          <div
            class="goal-bar h-[1rem] max-w-[42rem] bg-surface-3 border border-border rounded-[999px] overflow-hidden"
            role="progressbar"
            aria-label={L.dashboard.goalCardAria}
            aria-valuemin="0"
            :aria-valuenow="weeklyDone"
            :aria-valuemax="settings.weeklyGoal"
          >
            <div
              class="goal-bar-fill h-full bg-accent rounded-[999px]"
              :class="{ 'goal-bar-fill--complete': weeklyDone >= settings.weeklyGoal }"
              :style="`width: ${Math.min(100, weeklyProgress * 100)}%`"
            ></div>
          </div>

          <p
            class="goal-hint mt-[0.8rem] text-[1.2rem] text-success font-semibold"
            x-show="weeklyDone >= settings.weeklyGoal"
            x-transition.opacity
            x-cloak
            x-text="labels.weeklyGoalDone"
          ></p>
          <p
            class="goal-hint goal-hint--muted mt-[0.8rem] text-[1.2rem] text-muted font-medium"
            x-show="weeklyDone < settings.weeklyGoal && settings.weeklyGoal > 0"
            x-text="remainingHintText()"
          ></p>
        </div>
      </section>

      {/* ── Next session: actionable data, not a decorative card ── */}
      <section class="next-section py-[2rem] border-b border-border" x-show="nextSession" aria-label={L.dashboard.nextSession}>
        <div class="next-kicker mb-[0.8rem] text-accent text-[1rem] font-extrabold tracking-[0.16em] uppercase" x-text="labels.nextSession">{L.dashboard.nextSession}</div>
        <div class="next-main flex items-center justify-between gap-[2rem]">
          <div class="next-copy">
            <h2 class="next-name m-0 letter-spacing-[-0.04em]" x-text="nextSession?.name"></h2>
            <p class="next-hint mt-[0.6rem] mb-0 text-muted text-[1.3rem]" x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.plannedWorkoutHint"></p>
          </div>
          <a class="next-action inline-flex items-center gap-[1rem] min-h-[4.4rem] px-[1.4rem] border border-accent text-accent text-[1.2rem] font-extrabold no-underline uppercase tracking-[0.08em] whitespace-nowrap" :href="localizedPath('/seances/rapide?session=' + nextSession?.id)">
            <span x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.startWorkout"></span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      </div>

      {/* ── KPI band ── */}
      <section class="kpi-grid grid grid-cols-1 gap-0 mb-[3.2rem] border-t border-b border-border" aria-label={L.dashboard.kpisAria}>
        {/* Volume */}
        <div class="kpi-card min-w-0 py-[1.6rem] px-[1.2rem] bg-transparent border-0 border-b border-border rounded-none shadow-none transition-colors duration-[200ms]">
          <div class="flex flex-col gap-1">
            <div class="kpi-head flex items-center gap-[0.8rem]">
              <span class="kpi-icon inline-flex items-center justify-center w-[2.8rem] h-[2.8rem] rounded-full shrink-0 bg-stat-volume-bg text-stat-volume" aria-hidden="true">
                <Fragment set:html={icons.dumbbell(16, 16)} />
              </span>
              <span class="kpi-label text-[1.0rem] text-muted uppercase tracking-[0.05em] font-semibold">{L.dashboard.totalVolume}</span>
            </div>
            <div class="flex items-baseline">
              <span class="kpi-value font-display font-bold text-[clamp(2rem,5vw,2.4rem)] leading-none text-text tabular-nums" x-text="formatVolume(kpis.totalVolume)"></span>
              <span class="kpi-unit text-[1.1rem] text-muted ml-[0.6rem] font-semibold uppercase tracking-[0.04em]">{L.common.kg}</span>
            </div>
          </div>
        </div>

        {/* Séances */}
        <div class="kpi-card min-w-0 py-[1.6rem] px-[1.2rem] bg-transparent border-0 border-b border-border rounded-none shadow-none transition-colors duration-[200ms]">
          <div class="flex flex-col gap-1">
            <div class="kpi-head flex items-center gap-[0.8rem]">
              <span class="kpi-icon inline-flex items-center justify-center w-[2.8rem] h-[2.8rem] rounded-full shrink-0 bg-stat-sessions-bg text-stat-sessions" aria-hidden="true">
                <Fragment set:html={icons.calendar(16, 16)} />
              </span>
              <span class="kpi-label text-[1.0rem] text-muted uppercase tracking-[0.05em] font-semibold">{L.dashboard.totalSessions}</span>
            </div>
            <div class="flex items-baseline">
              <span class="kpi-value font-display font-bold text-[clamp(2rem,5vw,2.4rem)] leading-none text-text tabular-nums" x-text="kpis.totalSessions"></span>
              <span
                class="kpi-unit text-[1.1rem] text-muted ml-[0.6rem] font-semibold uppercase tracking-[0.04em]"
                x-text="kpis.totalSessions === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
              >{L.dashboard.sessionsUnit}</span>
            </div>
          </div>
        </div>

        {/* Meilleurs PRs */}
        <div class="kpi-card min-w-0 py-[1.6rem] px-[1.2rem] bg-transparent border-0 border-b border-border rounded-none shadow-none transition-colors duration-[200ms]">
          <div class="flex flex-col gap-1">
            <div class="kpi-head flex items-center gap-[0.8rem]">
              <span class="kpi-icon inline-flex items-center justify-center w-[2.8rem] h-[2.8rem] rounded-full shrink-0 bg-stat-pr-bg text-stat-pr" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              </span>
              <span class="kpi-label text-[1.0rem] text-muted uppercase tracking-[0.05em] font-semibold">{L.dashboard.bestPRs}</span>
            </div>
            <div class="flex items-baseline">
              <span class="kpi-value font-display font-bold text-[clamp(2rem,5vw,2.4rem)] leading-none text-text tabular-nums" x-text="kpis.bestPRs"></span>
              <span
                class="kpi-unit text-[1.1rem] text-muted ml-[0.6rem] font-semibold uppercase tracking-[0.04em]"
                x-text="kpis.bestPRs === 1 ? labels.exoSingular.trim() : labels.exercisesUnit"
              >{L.dashboard.exercisesUnit}</span>
            </div>
            <div
              class="kpi-sub text-[1.1rem] text-muted font-medium mt-[0.2rem]"
              x-show="kpis.top1RM > 0"
              x-text="labels.top1RM + ' ' + formatVolume(kpis.top1RM) + ' ' + labels.kg"
            ></div>
          </div>
        </div>

        {/* Série en cours */}
        <div class="kpi-card min-w-0 py-[1.6rem] px-[1.2rem] bg-transparent border-0 border-b border-border rounded-none shadow-none transition-colors duration-[200ms]">
          <div class="flex flex-col gap-1">
            <div class="kpi-head flex items-center gap-[0.8rem]">
              <span class="kpi-icon inline-flex items-center justify-center w-[2.8rem] h-[2.8rem] rounded-full shrink-0 bg-stat-streak-bg text-stat-streak" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
              </span>
              <span class="kpi-label text-[1.0rem] text-muted uppercase tracking-[0.05em] font-semibold">{L.dashboard.streak}</span>
            </div>
            <div class="flex items-baseline">
              <span class="kpi-value font-display font-bold text-[clamp(2rem,5vw,2.4rem)] leading-none text-text tabular-nums" x-text="kpis.streak"></span>
              <span
                class="kpi-unit text-[1.1rem] text-muted ml-[0.6rem] font-semibold uppercase tracking-[0.04em]"
                x-text="kpis.streak === 1 ? labels.daysSingular : labels.daysUnit"
              >{L.dashboard.daysUnit}</span>
            </div>
            <div
              class="kpi-sub text-[1.1rem] text-muted font-medium mt-[0.2rem]"
              x-show="kpis.streak === 0 && kpis.totalSessions > 0"
              x-text="labels.noRecent"
            ></div>
          </div>
        </div>
      </section>

      {/* ── Weekly volume trend ── */}
      <section class="mb-[3.2rem]" aria-label={L.dashboard.weeklyVolumeTrend}>
        <div class="py-[1.8rem] border-t border-b border-border">
          <header class="trend-head flex items-center justify-between gap-[1.2rem] mb-[1.2rem]">
            <h2 class="text-[1.2rem]">{L.dashboard.weeklyVolumeTrend}</h2>
          </header>
          <div class="min-h-[7.2rem]">
            <div class="trend-chart flex gap-[0.8rem] items-stretch" x-show="weeklyVolumeTotal > 0">
              <template x-for="(v, i) in weeklyVolumeByDay" :key="i">
                <div
                  class="trend-col flex-1 min-w-0 flex flex-col gap-[0.8rem]"
                  :class="{ 'trend-col--today': i === todayIdx }"
                  role="img"
                  :aria-label="`${dayLabels[i]}: ${formatVolume(v)} ${labels.kg}`"
                >
                  <div class="trend-bar-wrap flex items-end h-[6rem]">
                    <div
                      class="trend-bar w-full rounded-sm"
                      :class="i === todayIdx ? 'trend-bar--today' : (v > 0 && i < todayIdx ? 'trend-bar--past' : 'trend-bar--empty')"
                      :style="`height: ${v > 0 ? Math.round((v / maxVol) * 100) : 0}%`"
                    ></div>
                  </div>
                  <span
                    class="trend-day text-[1.0rem] text-muted uppercase tracking-[0.05em] font-semibold text-center"
                    x-text="dayLabels[i]"
                    :aria-current="i === todayIdx ? 'date' : undefined"
                  ></span>
                </div>
              </template>
            </div>
            <div class="trend-empty flex flex-col justify-center min-h-[7.2rem] gap-[0.4rem] text-muted" x-show="weeklyVolumeTotal <= 0" x-cloak role="status">
              <strong class="text-text text-[1.3rem] font-display" x-text="labels.noWeeklyVolume">{L.dashboard.noWeeklyVolume}</strong>
              <span class="text-[1.2rem]" x-text="labels.noWeeklyVolumeHint">{L.dashboard.noWeeklyVolumeHint}</span>
            </div>
          </div>
        </div>
      </section>

      {/* ── Recent sessions ── */}
      <section class="recent" aria-label={L.dashboard.recentAria}>
        <header class="section-head flex items-center justify-between gap-[1.2rem] mb-[1.6rem]">
          <h2 class="section-head-title font-display text-[1.4rem] font-bold text-muted uppercase tracking-[0.05em] m-0" x-text="labels.recentSessions">{L.dashboard.recentSessions}</h2>
          <a
            href={localizedPath("/seances")}
            class="see-all font-body text-[1.2rem] font-semibold text-accent no-underline rounded-sm transition-colors duration-[200ms]"
            x-text="labels.viewAll"
          >{L.dashboard.viewAll} →</a>
        </header>

        <div class="sessions flex flex-col">
          <template x-for="s in recentSessions" :key="s.id">
            <a
              :href="localizedPath('/seances/detail?id=' + s.id)"
              class="session-item flex flex-col gap-[0.8rem] py-[1.6rem] bg-transparent border-0 border-b border-border rounded-none no-underline text-inherit transition-colors duration-[200ms]"
              :class="'session-item--' + s.status"
            >
              <div class="session-head flex items-start justify-between gap-[1.2rem] min-w-0">
                <div class="session-title flex items-center gap-[0.8rem] min-w-0 flex-1">
                  <span class="session-dot w-[1.0rem] h-[1.0rem] rounded-full bg-muted shrink-0" aria-hidden="true"></span>
                  <h3 class="session-name font-display text-[1.8rem] font-bold leading-[1.2] text-text m-0 break-words" x-text="s.name"></h3>
                </div>
                <div class="session-badge inline-flex flex-col items-end gap-[0.4rem] shrink-0">
                  <div x-show="s.status === 'completed'">
                    <Badge variant="success" size="sm"><span x-text="statusLabel(s.status)"></span></Badge>
                  </div>
                  <div x-show="s.status === 'in-progress'">
                    <Badge variant="info" size="sm"><span x-text="statusLabel(s.status)"></span></Badge>
                  </div>
                  <div x-show="s.status !== 'completed' && s.status !== 'in-progress'">
                    <Badge variant="default" size="sm"><span x-text="statusLabel(s.status)"></span></Badge>
                  </div>
                </div>
              </div>

              <div class="session-meta flex items-center flex-wrap gap-[0.6rem] text-[1.2rem] text-muted">
                <span class="session-date font-medium" x-text="formatDate(s.date)"></span>
                <span class="text-alpha-text-faint" aria-hidden="true">·</span>
                <span>
                  <span x-text="sessionExercisesCount(s)"></span>
                  <span x-text="sessionExercisesCount(s) > 1 ? labels.exoPlural : labels.exoSingular"></span>
                </span>
                <span class="text-alpha-text-faint" aria-hidden="true">·</span>
                <span class="session-volume text-text font-semibold tabular-nums" x-text="formatVolume(sessionVolume(s)) + ' ' + labels.kg"></span>
                <div class="session-muscle inline-flex items-center" x-show="sessionPrimaryMuscle(s)">
                  <Badge variant="default" size="sm"><span x-text="muscleLabel(sessionPrimaryMuscle(s))"></span></Badge>
                </div>
              </div>
            </a>
          </template>
        </div>
      </section>
    </div>

    {/* ── Empty (first run: no sessions yet) — decorative, no zeros ── */}
    <div class="empty-state max-w-[48rem] mx-auto flex flex-col items-center text-center gap-[2.4rem] py-[4rem] pb-[6rem]" x-show="!hasSessions">
      <div class="empty-ring relative w-[12rem] h-[12rem] shrink-0" aria-hidden="true">
        <svg viewBox="0 0 100 100" class="empty-ring-svg w-full h-full">
          <circle cx="50" cy="50" r="46" class="empty-ring-track"></circle>
          <circle cx="50" cy="50" r="46" class="empty-ring-fill"></circle>
        </svg>
        <div class="empty-disc absolute inset-0 m-auto w-[5rem] h-[5rem] rounded-full bg-surface-2 flex items-center justify-center text-muted">
          <Fragment set:html={icons.dumbbell(32, 32)} />
        </div>
      </div>

      <h1 class="empty-title font-display text-[clamp(2rem,4vw,2.8rem)] font-bold leading-[1.15] text-text m-0 text-balance">{L.dashboard.emptyTitle}</h1>
      <p class="empty-desc text-[1.4rem] leading-[1.5] text-muted max-w-[36rem] m-0">{L.dashboard.emptyDesc}</p>

      <div class="empty-actions flex flex-wrap items-center justify-center gap-[1.2rem]">
        <Button variant="primary" size="md" href={localizedPath("/seances/creer")}>
          <Fragment set:html={icons.plus(16, 16)} />
          <span>{L.dashboard.createFirst}</span>
        </Button>
        <Button variant="secondary" size="md" href={localizedPath("/timer")}>
          <Fragment set:html={icons.clockStopwatch(16, 16)} />
          <span>{L.dashboard.stopwatch}</span>
        </Button>
        <a href={localizedPath("/exercices")} class="empty-link text-[1.2rem] font-semibold text-muted no-underline rounded-sm px-[0.8rem] py-[0.4rem] inline-flex items-center min-h-[4.4rem] transition-colors duration-[200ms]">
          {L.dashboard.browseExercises}
        </a>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getExercises,
    getSessionsThisWeek,
    getSettings,
    calculate1RM,
    type Session,
    type SessionStatus,
  } from '../lib/storage';
  import { t, getLocale, localizedPath } from '../i18n';
  import { statusLabel as statusLabelFn, type StatusLabels } from '../lib/session-utils';
  import { formatDateShort, formatNumPositive } from '../lib/format';

  const LABELS = t();
  const statusLabels: StatusLabels = {
    completed: LABELS.sessions.completed,
    inProgress: LABELS.sessions.inProgress,
    planned: LABELS.sessions.planned,
  };

  function statusLabel(status: SessionStatus): string {
    return statusLabelFn(status, statusLabels);
  }

  /** ISO date key YYYY-MM-DD (local-tz) — used for day-level comparisons. */
  function dateKey(d: Date): string {
    const y = d.getFullYear();
    const m = (d.getMonth() + 1).toString().padStart(2, '0');
    const day = d.getDate().toString().padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('dashboardApp', () => ({
      // ── State ──
      sessions: [] as Session[],
      settings: getSettings(),
      weeklyDone: 0,
      labels: {
        top1RM: LABELS.dashboard.top1RM,
        weeklyGoalEyebrow: LABELS.dashboard.weeklyGoalEyebrow,
        weeklyGoalDone: LABELS.dashboard.weeklyGoalDone,
        weeklyMoreSingular: LABELS.dashboard.weeklyMoreSingular,
        sessionsUnit: LABELS.dashboard.sessionsUnit,
        exercisesUnit: LABELS.dashboard.exercisesUnit,
        daysUnit: LABELS.dashboard.daysUnit,
        remainingHint: LABELS.dashboard.remainingHint,
        exoPlural: LABELS.dashboard.exoPlural,
        exoSingular: LABELS.dashboard.exoSingular,
        daysSingular: LABELS.dashboard.daysSingular,
        noRecent: LABELS.dashboard.noRecent,
        viewAll: LABELS.dashboard.viewAllArrow,
        recentSessions: LABELS.dashboard.recentSessions,
        kg: LABELS.common.kg,
        todayVolume: LABELS.dashboard.todayVolume,
        weeklyVolumeTrend: LABELS.dashboard.weeklyVolumeTrend,
        noWeeklyVolume: LABELS.dashboard.noWeeklyVolume,
        noWeeklyVolumeHint: LABELS.dashboard.noWeeklyVolumeHint,
        nextSession: LABELS.dashboard.nextSession,
        continueWorkout: LABELS.dashboard.continueWorkout,
        startWorkout: LABELS.dashboard.startWorkout,
        plannedWorkoutHint: LABELS.dashboard.plannedWorkoutHint,
        sessionCount: LABELS.dashboard.sessionCount,
        exerciseCount: LABELS.dashboard.exerciseCount,
      },

      // Expose localizedPath to Alpine expressions (uses window.__LOCALE__).
      localizedPath,

      // ── Init ──
      init() {
        // Touch the storage so the exercise seed is created on first load.
        getExercises();
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
        this.settings = getSettings();
        this.weeklyDone = getSessionsThisWeek().length;
      },

      // ── Derived ──
      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      get hasCompletedSessions(): boolean {
        return this.sessions.some((s) => s.status === 'completed');
      },

      get recentSessions(): Session[] {
        return this.sessions.slice(0, 5);
      },

      /** The first unfinished session is the only honest "next" action. */
      get nextSession(): Session | null {
        return this.sessions.find((s) => s.status === 'in-progress' || s.status === 'planned') ?? null;
      },

      /** Progress as a 0-1 ratio. Returns 0 when the target is invalid. */
      get weeklyProgress(): number {
        const target = this.settings.weeklyGoal;
        if (!Number.isFinite(target) || target <= 0) return 0;
        return Math.min(1, Math.max(0, this.weeklyDone / target));
      },

      // ── Today ──
      /** Sum of weight × reps over completed sets of today's sessions. */
      get todayVolume(): number {
        const key = dateKey(new Date());
        return this.sessions
          .filter((s) => dateKey(new Date(s.date)) === key)
          .reduce((sum, s) => sum + this.sessionVolume(s), 0);
      },

      get todaySessions(): number {
        const key = dateKey(new Date());
        return this.sessions.filter(
          (s) => dateKey(new Date(s.date)) === key,
        ).length;
      },

      /** Count of distinct exercises across today's sessions. */
      get todayExercises(): number {
        const key = dateKey(new Date());
        const seen = new Set<string>();
        for (const s of this.sessions) {
          if (dateKey(new Date(s.date)) !== key) continue;
          for (const ex of s.exercises) seen.add(ex.exerciseId);
        }
        return seen.size;
      },

      // ── Weekly trend ──
      /** Per-day volume sums (index = getDay(), 0 = Sunday), this week. */
      get weeklyVolumeByDay(): number[] {
        const arr = new Array(7).fill(0);
        const now = new Date();
        const startOfWeek = new Date(now);
        startOfWeek.setDate(now.getDate() - now.getDay()); // Sunday
        startOfWeek.setHours(0, 0, 0, 0);
        for (const s of this.sessions) {
          const d = new Date(s.date);
          if (d < startOfWeek) continue;
          arr[d.getDay()] += this.sessionVolume(s);
        }
        return arr;
      },

      /** Today's weekday index (getDay(): 0 = Sunday … 6 = Saturday). */
      get todayIdx(): number {
        return new Date().getDay();
      },

      get weeklyVolumeTotal(): number {
        return this.weeklyVolumeByDay.reduce((sum, volume) => sum + volume, 0);
      },

      /** Scale for the trend bars — never 0 so empty weeks render 0%. */
      get maxVol(): number {
        return Math.max(...this.weeklyVolumeByDay, 1);
      },

      /** Locale-aware day labels, Sun → Sat. */
      get dayLabels(): string[] {
        return getLocale() === 'fr'
          ? ['D', 'L', 'M', 'M', 'J', 'V', 'S']
          : ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
      },

      // ── KPIs (recomputed on demand; Alpine caches via getters) ──
      get kpis() {
        return {
          totalSessions: this.sessions.length,
          totalVolume: this.totalVolume(),
          bestPRs: this.bestPRs(),
          top1RM: this.top1RM(),
          streak: this.streak(),
        };
      },

      // ── Goal hint ──
      remainingHintText(): string {
        const remaining = Math.max(
          0,
          this.settings.weeklyGoal - this.weeklyDone,
        );
        const unit =
          remaining === 1
            ? this.labels.weeklyMoreSingular
            : this.labels.sessionsUnit;
        return this.labels.remainingHint
          .replace('{count}', String(remaining))
          .replace('{unit}', unit);
      },

      totalVolume(): number {
        return this.sessions.reduce((sum, s) => {
          return sum + s.exercises.reduce((eSum, ex) => {
            return eSum + ex.sets.reduce((sSum, set) => {
              return sSum + (set.completed ? set.weight * set.reps : 0);
            }, 0);
          }, 0);
        }, 0);
      },

      /**
       * "Best PRs" = number of unique exercises for which the user has
       * completed at least one set. Each one is a personal record of
       * having been performed; the top 1RM across all is reported
       * separately via `top1RM()`.
       */
      bestPRs(): number {
        const trained = new Set<string>();
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            if (ex.sets.some((set) => set.completed)) {
              trained.add(ex.exerciseId);
            }
          }
        }
        return trained.size;
      },

      /**
       * Highest estimated 1RM across all completed sets.
       * Also seeds the progress log for any new PRs encountered.
       */
      top1RM(): number {
        let best = 0;
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            for (const set of ex.sets) {
              if (!set.completed) continue;
              const oneRM = calculate1RM(set.weight, set.reps);
              if (oneRM > best) best = oneRM;
            }
          }
        }
        return best;
      },

      /**
       * Consecutive-day streak ending today (or yesterday if today has
       * no session yet). Returns 0 if the user has no completed
       * sessions or if the most recent training day is older than
       * yesterday.
       */
      streak(): number {
        const completedDays = new Set(
          this.sessions
            .filter((s) => s.status === 'completed')
            .map((s) => dateKey(new Date(s.date))),
        );
        if (completedDays.size === 0) return 0;

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const cursor = new Date(today);

        if (!completedDays.has(dateKey(cursor))) {
          // Today has no session — try yesterday as the streak anchor
          cursor.setDate(cursor.getDate() - 1);
          if (!completedDays.has(dateKey(cursor))) return 0;
        }

        let count = 0;
        while (completedDays.has(dateKey(cursor))) {
          count++;
          cursor.setDate(cursor.getDate() - 1);
        }
        return count;
      },

      // ── Per-session computations ──
      sessionVolume(s: Session): number {
        return s.exercises.reduce((sum, ex) => {
          return sum + ex.sets.reduce((sSum, set) => {
            return sSum + (set.completed ? set.weight * set.reps : 0);
          }, 0);
        }, 0);
      },

      sessionExercisesCount(s: Session): number {
        return s.exercises.length;
      },

      /** Most frequent muscle across the session's exercises ('' when none). */
      sessionPrimaryMuscle(s: Session): string {
        const counts = new Map<string, number>();
        for (const ex of s.exercises) {
          if (!ex.muscle) continue;
          counts.set(ex.muscle, (counts.get(ex.muscle) ?? 0) + 1);
        }
        let best = '';
        let bestCount = 0;
        for (const [muscle, count] of counts) {
          if (count > bestCount) {
            best = muscle;
            bestCount = count;
          }
        }
        return best;
      },

      /** Translated stored muscle group for display (FR stays as-is). */
      muscleLabel(name: string): string {
        const tr = (window as { trMuscle?: (m: string) => string }).trMuscle;
        return tr ? tr(name) : name;
      },

      // ── Formatters / helpers exposed to the template ──
      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDateShort(iso);
      },

      formatVolume(volume: number): string {
        return formatNumPositive(volume);
      },
    }));
  });
</script>

