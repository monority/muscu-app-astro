---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { t } from '../i18n';

const L = t();
---

<AppLayout title={L.dashboard.title}>
  <PageHeader
    title={L.dashboard.title}
    description="Vue d'ensemble de votre progression."
  />

  <div class="dash" x-data="dashboardApp()" x-init="init()" x-cloak>
    {/* ── Quick actions ── */}
    <div class="dash__actions">
      <a href="/seances/creer" class="dash__action dash__action--primary">
        <svg
          class="dash__action-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>{L.dashboard.newSession}</span>
      </a>
      <a href="/timer" class="dash__action dash__action--secondary">
        <svg
          class="dash__action-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="13" r="8"></circle>
          <path d="M12 9v4l2 2"></path>
          <path d="M5 3 2 6"></path>
          <path d="m22 6-3-3"></path>
          <path d="M6.38 18.7 4 21"></path>
          <path d="M17.64 18.67 20 21"></path>
        </svg>
        <span>{L.dashboard.stopwatch}</span>
      </a>
    </div>

    {/* ── Weekly goal ── */}
    <section class="dash__goal-card" aria-label="Objectif hebdomadaire">
      <div class="dash__goal-head">
        <div class="dash__goal-head-text">
          <span class="dash__goal-eyebrow" x-text="labels.weeklyGoalEyebrow">Objectif hebdomadaire</span>
          <h2 class="dash__goal-title">
            <span
              class="dash__goal-done"
              x-text="weeklyDone"
            >0</span><span class="dash__goal-sep" aria-hidden="true">/</span><span
              class="dash__goal-target"
              x-text="settings.weeklyGoal"
            >3</span>
            <span
              class="dash__goal-unit"
              x-text="settings.weeklyGoal > 1 ? labels.weeklyThisWeek : labels.weeklyThisWeekOne"
            >séances cette semaine</span>
          </h2>
        </div>
        <div class="dash__goal-ring" aria-hidden="true">
          <svg viewBox="0 0 44 44" class="dash__goal-ring-svg">
            <circle
              cx="22"
              cy="22"
              r="18"
              class="dash__goal-ring-track"
            ></circle>
            <circle
              cx="22"
              cy="22"
              r="18"
              class="dash__goal-ring-fill"
              :stroke-dasharray="`${weeklyProgress * 113.1} 113.1`"
            ></circle>
          </svg>
          <span
            class="dash__goal-ring-pct"
            x-text="`${Math.round(weeklyProgress * 100)}%`"
          >0%</span>
        </div>
      </div>
      <div class="dash__goal-bar">
        <div
          class="dash__goal-bar-fill"
          :class="{ 'dash__goal-bar-fill--complete': weeklyDone >= settings.weeklyGoal }"
          :style="`width: ${Math.min(100, weeklyProgress * 100)}%`"
        ></div>
      </div>
      <p
        class="dash__goal-hint"
        x-show="weeklyDone >= settings.weeklyGoal"
        x-transition.opacity
        x-cloak
        x-text="labels.weeklyGoalDone"
      ></p>
      <p
        class="dash__goal-hint dash__goal-hint--muted"
        x-show="weeklyDone < settings.weeklyGoal && settings.weeklyGoal > 0"
      >
        Encore
        <strong x-text="settings.weeklyGoal - weeklyDone"></strong>
        <span x-text="(settings.weeklyGoal - weeklyDone) > 1 ? labels.weeklyMorePlural : labels.weeklyMoreSingular"></span>
        <span x-text="labels.forGoal"></span>
      </p>
    </section>

    {/* ── KPI grid ── */}
    <section class="dash__kpis" aria-label="Indicateurs clés">
      {/* Volume total */}
      <Card class="dash__kpi">
        <div class="flex flex-col gap-1">
          <div class="dash__kpi-head">
            <span class="dash__kpi-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            </span>
            <span class="dash__kpi-label">{L.dashboard.totalVolume}</span>
          </div>
          <div class="flex items-baseline">
            <span class="dash__kpi-value" x-text="formatVolume(kpis.totalVolume)">0</span>
            <span class="dash__kpi-unit">kg</span>
          </div>
        </div>
      </Card>

      {/* Séances */}
      <Card class="dash__kpi">
        <div class="flex flex-col gap-1">
          <div class="dash__kpi-head">
            <span class="dash__kpi-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/></svg>
            </span>
            <span class="dash__kpi-label">{L.dashboard.totalSessions}</span>
          </div>
          <div class="flex items-baseline">
            <span class="dash__kpi-value" x-text="kpis.totalSessions">0</span>
            <span
              class="dash__kpi-unit"
              x-text="kpis.totalSessions > 1 ? 'séances' : 'séance'"
            >séances</span>
          </div>
        </div>
      </Card>

      {/* PRs */}
      <Card class="dash__kpi">
        <div class="flex flex-col gap-1">
          <div class="dash__kpi-head">
            <span class="dash__kpi-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            </span>
            <span class="dash__kpi-label">PRs</span>
          </div>
          <div class="flex items-baseline">
            <span class="dash__kpi-value" x-text="kpis.bestPRs">0</span>
            <span
              class="dash__kpi-unit"
              x-text="kpis.bestPRs > 1 ? 'exercices' : 'exercice'"
            >exercices</span>
          </div>
          <div
            class="dash__kpi-sub"
            x-show="kpis.top1RM > 0"
            x-text="labels.top1RM + ' ' + formatVolume(kpis.top1RM) + ' kg'"
          ></div>
        </div>
      </Card>

      {/* Streak */}
      <Card class="dash__kpi">
        <div class="flex flex-col gap-1">
          <div class="dash__kpi-head">
            <span class="dash__kpi-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            </span>
            <span class="dash__kpi-label">Série actuelle</span>
          </div>
          <div class="flex items-baseline">
            <span class="dash__kpi-value" x-text="kpis.streak">0</span>
            <span
              class="dash__kpi-unit"
              x-text="kpis.streak > 1 ? 'jours' : 'jour'"
            >jours</span>
          </div>
          <div
            class="dash__kpi-sub"
            x-show="kpis.streak === 0 && kpis.totalSessions > 0"
            x-text="labels.noRecent"
          ></div>
        </div>
      </Card>
    </section>

    {/* ── Recent sessions ── */}
    <section class="dash__recent" aria-label="Séances récentes">
      <header class="dash__section-head">
        <h2 x-text="labels.recentSessions">{L.dashboard.recentSessions}</h2>
        <a
          href="/seances"
          class="dash__see-all"
          x-show="hasSessions"
          x-text="labels.viewAll"
        >{L.dashboard.viewAll} →</a>
      </header>

      {/* List of recent sessions (when there are any) */}
      <div class="dash__sessions" x-show="hasSessions">
        <template x-for="s in recentSessions" :key="s.id">
          <a
            :href="'/seances/detail?id=' + s.id"
            class="dash__session"
            :class="'dash__session--' + s.status"
          >
            <div class="dash__session-head">
              <h3 class="dash__session-name" x-text="s.name"></h3>
              <span
                class="dash__badge"
                :class="'dash__badge--' + s.status"
                x-text="statusLabel(s.status)"
              ></span>
            </div>

            <div class="dash__session-meta">
              <span class="dash__session-date" x-text="formatDate(s.date)"></span>
              <span class="dash__session-sep" aria-hidden="true">·</span>
              <span>
                <span x-text="sessionExercisesCount(s)"></span>
                <span x-text="sessionExercisesCount(s) > 1 ? labels.exoPlural : labels.exoSingular"></span>
              </span>
              <span class="dash__session-sep" aria-hidden="true">·</span>
              <span class="dash__session-volume" x-text="formatVolume(sessionVolume(s)) + ' kg'">0 kg</span>
            </div>
          </a>
        </template>
      </div>

      {/* Empty state (when no sessions yet) */}
      <div x-show="!hasSessions">
        <Card>
          <EmptyState
            title={L.dashboard.noSessions}
            description="Commencez par créer votre première séance pour suivre vos performances et mesurer votre progression."
            actionLabel={L.dashboard.createFirst}
            actionHref="/seances/creer"
          />
        </Card>
      </div>
    </section>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getExercises,
    getProgressRecords,
    getSessionsThisWeek,
    getSettings,
    calculate1RM,
    type Session,
    type SessionStatus,
  } from '../lib/storage';
  import { t } from '../i18n';

  const LABELS = t();

  // ── Pure helpers (module scope) ────────────────────────────
  function statusLabel(status: SessionStatus): string {
    if (status === 'completed') return LABELS.sessions.completed;
    if (status === 'in-progress') return LABELS.sessions.inProgress;
    return LABELS.sessions.planned;
  }

  function formatDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function formatVolume(volume: number): string {
    if (!Number.isFinite(volume) || volume <= 0) return '0';
    return Math.round(volume).toLocaleString('fr-FR');
  }

  /** ISO date key YYYY-MM-DD (local-tz) — used for day-level comparisons. */
  function dateKey(d: Date): string {
    const y = d.getFullYear();
    const m = (d.getMonth() + 1).toString().padStart(2, '0');
    const day = d.getDate().toString().padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('dashboardApp', () => ({
      // ── State ──
      sessions: [] as Session[],
      settings: getSettings(),
      weeklyDone: 0,
      labels: {
        top1RM: 'Top 1RM :',
        weeklyThisWeek: 'séances cette semaine',
        weeklyThisWeekOne: 'séance cette semaine',
        weeklyMorePlural: 'séances',
        weeklyMoreSingular: 'séance',
        forGoal: 'pour atteindre votre objectif.',
        noRecent: 'Aucune séance récente',
        viewAll: 'Voir tout →',
        recentSessions: 'Séances récentes',
        weeklyGoalEyebrow: 'Objectif hebdomadaire',
        weeklyGoalDone: 'Bravo — objectif atteint pour cette semaine !',
        indicLabel: 'Indicateurs clés',
        exoPlural: ' exercices',
        exoSingular: ' exercice',
      },

      // ── Init ──
      init() {
        // Touch the storage so the exercise seed is created on first load
        // (also lets us count library size for the "X dans la bibliothèque" hint).
        getExercises();
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
        this.settings = getSettings();
        this.weeklyDone = getSessionsThisWeek().length;
      },

      // ── Derived ──
      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      get recentSessions(): Session[] {
        return this.sessions.slice(0, 5);
      },

      /** Progress as a 0-1 ratio. Returns 0 when the target is invalid. */
      get weeklyProgress(): number {
        const target = this.settings.weeklyGoal;
        if (!Number.isFinite(target) || target <= 0) return 0;
        return Math.min(1, Math.max(0, this.weeklyDone / target));
      },

      // ── KPIs (recomputed on demand; Alpine caches via getters) ──
      get kpis() {
        return {
          totalSessions: this.sessions.length,
          totalVolume: this.totalVolume(),
          bestPRs: this.bestPRs(),
          top1RM: this.top1RM(),
          streak: this.streak(),
        };
      },

      totalVolume(): number {
        return this.sessions.reduce((sum, s) => {
          return sum + s.exercises.reduce((eSum, ex) => {
            return eSum + ex.sets.reduce((sSum, set) => {
              return sSum + (set.completed ? set.weight * set.reps : 0);
            }, 0);
          }, 0);
        }, 0);
      },

      /**
       * "Best PRs" = number of unique exercises for which the user has
       * completed at least one set. Each one is a personal record of
       * having been performed; the top 1RM across all is reported
       * separately via `top1RM()`.
       */
      bestPRs(): number {
        const trained = new Set<string>();
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            if (ex.sets.some((set) => set.completed)) {
              trained.add(ex.exerciseId);
            }
          }
        }
        return trained.size;
      },

      /**
       * Highest estimated 1RM across all completed sets.
       * Also seeds the progress log for any new PRs encountered.
       */
      top1RM(): number {
        let best = 0;
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            for (const set of ex.sets) {
              if (!set.completed) continue;
              const oneRM = calculate1RM(set.weight, set.reps);
              if (oneRM > best) best = oneRM;
            }
          }
        }
        return best;
      },

      /**
       * Consecutive-day streak ending today (or yesterday if today has
       * no session yet). Returns 0 if the user has no completed
       * sessions or if the most recent training day is older than
       * yesterday.
       */
      streak(): number {
        const completedDays = new Set(
          this.sessions
            .filter((s) => s.status === 'completed')
            .map((s) => dateKey(new Date(s.date))),
        );
        if (completedDays.size === 0) return 0;

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const cursor = new Date(today);

        if (!completedDays.has(dateKey(cursor))) {
          // Today has no session — try yesterday as the streak anchor
          cursor.setDate(cursor.getDate() - 1);
          if (!completedDays.has(dateKey(cursor))) return 0;
        }

        let count = 0;
        while (completedDays.has(dateKey(cursor))) {
          count++;
          cursor.setDate(cursor.getDate() - 1);
        }
        return count;
      },

      // ── Per-session computations ──
      sessionVolume(s: Session): number {
        return s.exercises.reduce((sum, ex) => {
          return sum + ex.sets.reduce((sSum, set) => {
            return sSum + (set.completed ? set.weight * set.reps : 0);
          }, 0);
        }, 0);
      },

      sessionExercisesCount(s: Session): number {
        return s.exercises.length;
      },

      // ── Formatters exposed to the template ──
      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDate(iso);
      },

      formatVolume(volume: number): string {
        return formatVolume(volume);
      },

      // ── Storage-backed helpers (kept on the component for future
      //    expansion, e.g. quick-launch from the dashboard). ──
      _getProgressCount(): number {
        return getExercises().reduce(
          (sum, ex) => sum + getProgressRecords(ex.id).length,
          0,
        );
      },
    }));
  });
</script>

{/* Alpine.js CDN — MUST be AFTER the app script (type="module" runs before defer) */}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<style>
  /* Hide Alpine elements until initialized (prevents flash) */
  [x-cloak] {
    display: none !important;
  }

  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .dash {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  /* ════════════════════════════════════════════════════
     QUICK ACTIONS
     ════════════════════════════════════════════════════ */
  .dash__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-bottom: 2.4rem;
  }

  .dash__action {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    height: 4.8rem;
    padding: 0 2rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 200ms ease,
                color 200ms ease,
                border-color 200ms ease,
                box-shadow 200ms ease,
                transform 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dash__action--primary {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    box-shadow:
      0 4px 18px hsl(32 95% 50% / 0.32),
      inset 0 1px 0 hsl(0 0% 100% / 0.22);
  }

  .dash__action--primary:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-accent-foreground);
    box-shadow:
      0 6px 22px hsl(32 95% 50% / 0.45),
      inset 0 1px 0 hsl(0 0% 100% / 0.22);
    transform: translateY(-1px);
  }

  .dash__action--primary:active {
    transform: translateY(0) scale(0.97);
  }

  .dash__action--secondary {
    background-color: var(--color-surface-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .dash__action--secondary:hover {
    background-color: var(--color-surface-3);
    color: var(--color-text);
    border-color: hsl(0 0% 100% / 0.20);
  }

  .dash__action--secondary:active {
    transform: scale(0.97);
  }

  .dash__action-icon {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  /* ════════════════════════════════════════════════════
     KPI GRID — 1 / 2 / 4 columns
     ════════════════════════════════════════════════════ */
  .dash__kpis {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    margin-bottom: 3.2rem;
  }

  @media (min-width: 640px) {
    .dash__kpis {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .dash__kpis {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dash__kpi-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dash__kpi-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.0rem;
    height: 2.0rem;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .dash__kpi-icon svg {
    display: block;
  }

  .dash__kpi-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .dash__kpi-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 2.4rem);
    line-height: 1;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .dash__kpi-unit {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-left: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dash__kpi-sub {
    font-size: 1.1rem;
    color: var(--color-muted);
    font-weight: 500;
    margin-top: 0.2rem;
  }

  /* ════════════════════════════════════════════════════
     WEEKLY GOAL CARD
     ════════════════════════════════════════════════════ */
  .dash__goal-card {
    position: relative;
    margin-bottom: 3.2rem;
    padding: 2.4rem 2.6rem;
    background-color: var(--color-surface);
    background-image: radial-gradient(
      ellipse at top right,
      hsl(32 95% 50% / 0.10),
      transparent 60%
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .dash__goal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.6rem;
  }

  .dash__goal-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
