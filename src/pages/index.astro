---
import AppLayout from '../layouts/AppLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import CardHeader from '../components/ui/CardHeader.astro';
import CardTitle from '../components/ui/CardTitle.astro';
import CardContent from '../components/ui/CardContent.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Badge from '../components/ui/Badge.astro';
import { t, setLocale, defaultLocale, localizedPath } from '../i18n';

setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.dashboard.title}>
  <PageHeader
    title={L.dashboard.title}
    description={L.dashboard.description}
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/seances/creer")}
  />

  <div class="dash" x-data="dashboardApp()" x-init="init()" x-cloak>
    {/* ── Onboarding (first run: no sessions yet) ── */}
    <div class="dash__onboarding" x-show="!hasSessions">
      <Card padding="lg">
        <EmptyState
          icon="dumbbell"
          title={L.dashboard.welcomeTitle}
          description={L.dashboard.welcomeDesc}
          actionLabel={L.dashboard.createFirst}
          actionHref={localizedPath("/seances/creer")}
        />
        <div class="dash__onboarding-alt">
          <a href={localizedPath("/exercices")} class="dash__onboarding-link">
            {L.dashboard.browseExercises}
          </a>
        </div>
      </Card>
    </div>

    {/* ── Main dashboard (once training has started) ── */}
    <div x-show="hasSessions">
      {/* ── Hero strip ── */}
      <section class="dash__hero" aria-label={L.dashboard.goalCardAria}>
        <div class="dash__hero-main">
          <div class="dash__goal-ring" aria-hidden="true">
            <svg viewBox="0 0 44 44" class="dash__goal-ring-svg">
              <circle
                cx="22"
                cy="22"
                r="18"
                class="dash__goal-ring-track"
              ></circle>
              <circle
                cx="22"
                cy="22"
                r="18"
                class="dash__goal-ring-fill"
                :stroke-dasharray="`${weeklyProgress * 113.1} 113.1`"
              ></circle>
            </svg>
            <span
              class="dash__goal-ring-pct"
              x-text="`${Math.round(weeklyProgress * 100)}%`"
            >0%</span>
          </div>

          <div class="dash__hero-text">
            <span
              class="dash__goal-eyebrow"
              x-text="labels.weeklyGoalEyebrow"
            >{L.dashboard.weeklyGoalEyebrow}</span>
            <h2 class="dash__goal-title">
              <span class="dash__goal-done" x-text="weeklyDone">0</span>
              <span class="dash__goal-sep" aria-hidden="true">/</span>
              <span class="dash__goal-target" x-text="settings.weeklyGoal">3</span>
              <span
                class="dash__goal-unit"
                x-text="weeklyDone === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
              >{L.dashboard.sessionsUnit}</span>
            </h2>

            <div
              class="dash__goal-bar"
              role="progressbar"
              aria-label={L.dashboard.goalCardAria}
              aria-valuemin="0"
              :aria-valuenow="weeklyDone"
              :aria-valuemax="settings.weeklyGoal"
            >
              <div
                class="dash__goal-bar-fill"
                :class="{ 'dash__goal-bar-fill--complete': weeklyDone >= settings.weeklyGoal }"
                :style="`width: ${Math.min(100, weeklyProgress * 100)}%`"
              ></div>
            </div>

            <p
              class="dash__goal-hint"
              x-show="weeklyDone >= settings.weeklyGoal"
              x-transition.opacity
              x-cloak
              x-text="labels.weeklyGoalDone"
            ></p>
            <p
              class="dash__goal-hint dash__goal-hint--muted"
              x-show="weeklyDone < settings.weeklyGoal && settings.weeklyGoal > 0"
              x-text="remainingHintText()"
            ></p>
          </div>
        </div>

        <div class="dash__hero-cta">
          <a href={localizedPath("/seances/creer")} class="dash__cta dash__cta--primary">
            <svg
              class="dash__cta-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>{L.dashboard.newSession}</span>
          </a>
          <a href={localizedPath("/timer")} class="dash__cta dash__cta--secondary">
            <svg
              class="dash__cta-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="13" r="8"></circle>
              <path d="M12 9v4l2 2"></path>
              <path d="M5 3 2 6"></path>
              <path d="m22 6-3-3"></path>
              <path d="M6.38 18.7 4 21"></path>
              <path d="M17.64 18.67 20 21"></path>
            </svg>
            <span>{L.dashboard.stopwatch}</span>
          </a>
        </div>
      </section>

      {/* ── KPI band ── */}
      <section class="dash__kpis" aria-label={L.dashboard.kpisAria}>
        {/* Volume */}
        <Card class="dash__kpi" padding="md">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
              </span>
              <span class="dash__kpi-label">{L.dashboard.totalVolume}</span>
            </div>
            <div class="flex items-baseline">
              <span class="dash__kpi-value" x-text="formatVolume(kpis.totalVolume)">0</span>
              <span class="dash__kpi-unit">{L.common.kg}</span>
            </div>
          </div>
        </Card>

        {/* Séances */}
        <Card class="dash__kpi" padding="md">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/></svg>
              </span>
              <span class="dash__kpi-label">{L.dashboard.totalSessions}</span>
            </div>
            <div class="flex items-baseline">
              <span class="dash__kpi-value" x-text="kpis.totalSessions">0</span>
              <span
                class="dash__kpi-unit"
                x-text="kpis.totalSessions === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
              >{L.dashboard.sessionsUnit}</span>
            </div>
          </div>
        </Card>

        {/* PRs */}
        <Card class="dash__kpi" padding="md">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              </span>
              <span class="dash__kpi-label">{L.dashboard.bestPRs}</span>
            </div>
            <div class="flex items-baseline">
              <span class="dash__kpi-value" x-text="kpis.bestPRs">0</span>
              <span
                class="dash__kpi-unit"
                x-text="kpis.bestPRs === 1 ? labels.exoSingular.trim() : labels.exercisesUnit"
              >{L.dashboard.exercisesUnit}</span>
            </div>
            <div
              class="dash__kpi-sub"
              x-show="kpis.top1RM > 0"
              x-text="labels.top1RM + ' ' + formatVolume(kpis.top1RM) + ' ' + labels.kg"
            ></div>
          </div>
        </Card>

        {/* Streak */}
        <Card class="dash__kpi" padding="md">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
              </span>
              <span class="dash__kpi-label">{L.dashboard.streak}</span>
            </div>
            <div class="flex items-baseline">
              <span class="dash__kpi-value" x-text="kpis.streak">0</span>
              <span
                class="dash__kpi-unit"
                x-text="kpis.streak === 1 ? labels.daysSingular : labels.daysUnit"
              >{L.dashboard.daysPlural}</span>
            </div>
            <div
              class="dash__kpi-sub"
              x-show="kpis.streak === 0 && kpis.totalSessions > 0"
              x-text="labels.noRecent"
            ></div>
          </div>
        </Card>
      </section>

      {/* ── Insights row (7-day volume + muscle split) ── */}
      <section class="dash__insights" x-show="hasCompletedSessions">
        <Card>
          <CardHeader>
            <div class="dash__chart-head">
              <CardTitle>{L.dashboard.volumeLast7d}</CardTitle>
              <span class="dash__chart-meta">{L.common.kg}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="dash__chart-wrap" x-html="renderSparkline()"></div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <div class="dash__chart-head">
              <CardTitle>{L.dashboard.muscleSplit}</CardTitle>
              <span class="dash__chart-meta">{L.dashboard.thisWeek}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="dash__chart-wrap" x-html="renderDonut()"></div>
          </CardContent>
        </Card>
      </section>

      {/* ── Recent sessions ── */}
      <section class="dash__recent" aria-label={L.dashboard.recentAria}>
        <header class="dash__section-head">
          <h2 x-text="labels.recentSessions">{L.dashboard.recentSessions}</h2>
          <a
            href={localizedPath("/seances")}
            class="dash__see-all"
            x-show="hasSessions"
            x-text="labels.viewAll"
          >{L.dashboard.viewAll} →</a>
        </header>

        <div class="dash__sessions" x-show="hasSessions">
          <template x-for="s in recentSessions" :key="s.id">
            <a
              :href="localizedPath('/seances/detail?id=' + s.id)"
              class="dash__session"
              :class="'dash__session--' + s.status"
            >
              <div class="dash__session-head">
                <h3 class="dash__session-name" x-text="s.name"></h3>
                <div class="dash__session-badge">
                  <div x-show="s.status === 'completed'">
                    <Badge variant="success" size="sm"><span x-text="statusLabel(s.status)"></span></Badge>
                  </div>
                  <div x-show="s.status === 'in-progress'">
                    <Badge variant="info" size="sm"><span x-text="statusLabel(s.status)"></span></Badge>
                  </div>
                  <div x-show="s.status !== 'completed' && s.status !== 'in-progress'">
                    <Badge variant="default" size="sm"><span x-text="statusLabel(s.status)"></span></Badge>
                  </div>
                </div>
              </div>

              <div class="dash__session-meta">
                <span class="dash__session-date" x-text="formatDate(s.date)"></span>
                <span class="dash__session-sep" aria-hidden="true">·</span>
                <span>
                  <span x-text="sessionExercisesCount(s)"></span>
                  <span x-text="sessionExercisesCount(s) > 1 ? labels.exoPlural : labels.exoSingular"></span>
                </span>
                <span class="dash__session-sep" aria-hidden="true">·</span>
                <span class="dash__session-volume" x-text="formatVolume(sessionVolume(s)) + ' ' + labels.kg">0 kg</span>
              </div>
            </a>
          </template>
        </div>

        {/* Empty fallback inside a Card (unreachable while onboarding shows). */}
        <div x-show="!hasSessions">
          <Card>
            <EmptyState
              title={L.dashboard.noSessions}
              description={L.dashboard.emptyDesc}
              actionLabel={L.dashboard.createFirst}
              actionHref={localizedPath("/seances/creer")}
            />
          </Card>
        </div>
      </section>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getExercises,
    getSessionsThisWeek,
    getSettings,
    calculate1RM,
    type Session,
    type SessionStatus,
  } from '../lib/storage';
  import { t, getLocale, localizedPath, trMuscle } from '../i18n';
  import {
    volumeByMuscle,
    type MuscleVolumeSlice,
  } from '../lib/volume-stats';

  const LABELS = t();

  // ── Pure helpers (module scope) ────────────────────────────
  function statusLabel(status: SessionStatus): string {
    if (status === 'completed') return LABELS.sessions.completed;
    if (status === 'in-progress') return LABELS.sessions.inProgress;
    return LABELS.sessions.planned;
  }

  const DATE_LOCALE = getLocale() === 'fr' ? 'fr-FR' : 'en-US';

  function formatDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(DATE_LOCALE, {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function formatVolume(volume: number): string {
    if (!Number.isFinite(volume) || volume <= 0) return '0';
    return Math.round(volume).toLocaleString(DATE_LOCALE);
  }

  /** ISO date key YYYY-MM-DD (local-tz) — used for day-level comparisons. */
  function dateKey(d: Date): string {
    const y = d.getFullYear();
    const m = (d.getMonth() + 1).toString().padStart(2, '0');
    const day = d.getDate().toString().padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  /** Escape a string for safe embedding inside generated SVG/HTML. */
  function svgEscape(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  /** Palette for the muscle donut (same high-hue-distance set as stats.astro). */
  const MUSCLE_PALETTE: ReadonlyArray<string> = [
    '#3B82F6', // blue
    '#F97316', // orange
    '#10B981', // emerald
    '#EC4899', // pink
    '#EAB308', // yellow
    '#6366F1', // indigo
    '#D97706', // amber
    '#14B8A6', // teal
    '#EF4444', // red
    '#84CC16', // lime
    '#A855F7', // purple
    '#06B6D4', // cyan
  ];

  // Fallback bucket id used by volumeByMuscle for unknown muscle groups.
  const OTHER_MUSCLE = 'Autre';

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('dashboardApp', () => ({
      // ── State ──
      sessions: [] as Session[],
      settings: getSettings(),
      weeklyDone: 0,
      spark: [] as Array<{ key: string; label: string; volume: number }>,
      muscleWeek: [] as MuscleVolumeSlice[],
      donutSlices: [] as MuscleVolumeSlice[],
      labels: {
        top1RM: LABELS.dashboard.top1RM,
        weeklyGoalEyebrow: LABELS.dashboard.weeklyGoalEyebrow,
        weeklyGoalDone: LABELS.dashboard.weeklyGoalDone,
        weeklyMoreSingular: LABELS.dashboard.weeklyMoreSingular,
        sessionsUnit: LABELS.dashboard.sessionsUnit,
        exercisesUnit: LABELS.dashboard.exercisesUnit,
        daysUnit: LABELS.dashboard.daysUnit,
        remainingHint: LABELS.dashboard.remainingHint,
        exoPlural: LABELS.dashboard.exoPlural,
        exoSingular: LABELS.dashboard.exoSingular,
        daysSingular: LABELS.dashboard.daysSingular,
        noRecent: LABELS.dashboard.noRecent,
        viewAll: LABELS.dashboard.viewAllArrow,
        recentSessions: LABELS.dashboard.recentSessions,
        kg: LABELS.common.kg,
      },

      // Expose localizedPath to Alpine expressions (uses window.__LOCALE__).
      localizedPath,

      // ── Init ──
      init() {
        // Touch the storage so the exercise seed is created on first load.
        getExercises();
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
        this.settings = getSettings();
        this.weeklyDone = getSessionsThisWeek().length;
        this.spark = this.buildSpark();
        this.muscleWeek = volumeByMuscle(this.sessions, { period: 'week' });
        this.donutSlices = this.buildDonutSlices(this.muscleWeek);
      },

      // ── Derived ──
      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      get hasCompletedSessions(): boolean {
        return this.sessions.some((s) => s.status === 'completed');
      },

      get recentSessions(): Session[] {
        return this.sessions.slice(0, 5);
      },

      /** Progress as a 0-1 ratio. Returns 0 when the target is invalid. */
      get weeklyProgress(): number {
        const target = this.settings.weeklyGoal;
        if (!Number.isFinite(target) || target <= 0) return 0;
        return Math.min(1, Math.max(0, this.weeklyDone / target));
      },

      // ── KPIs (recomputed on demand; Alpine caches via getters) ──
      get kpis() {
        return {
          totalSessions: this.sessions.length,
          totalVolume: this.totalVolume(),
          bestPRs: this.bestPRs(),
          top1RM: this.top1RM(),
          streak: this.streak(),
        };
      },

      // ── Hero hint ──
      remainingHintText(): string {
        const remaining = Math.max(
          0,
          this.settings.weeklyGoal - this.weeklyDone,
        );
        const unit =
          remaining === 1
            ? this.labels.weeklyMoreSingular
            : this.labels.sessionsUnit;
        return this.labels.remainingHint
          .replace('{count}', String(remaining))
          .replace('{unit}', unit);
      },

      totalVolume(): number {
        return this.sessions.reduce((sum, s) => {
          return sum + s.exercises.reduce((eSum, ex) => {
            return eSum + ex.sets.reduce((sSum, set) => {
              return sSum + (set.completed ? set.weight * set.reps : 0);
            }, 0);
          }, 0);
        }, 0);
      },

      /**
       * "Best PRs" = number of unique exercises for which the user has
       * completed at least one set. Each one is a personal record of
       * having been performed; the top 1RM across all is reported
       * separately via `top1RM()`.
       */
      bestPRs(): number {
        const trained = new Set<string>();
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            if (ex.sets.some((set) => set.completed)) {
              trained.add(ex.exerciseId);
            }
          }
        }
        return trained.size;
      },

      /**
       * Highest estimated 1RM across all completed sets.
       * Also seeds the progress log for any new PRs encountered.
       */
      top1RM(): number {
        let best = 0;
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            for (const set of ex.sets) {
              if (!set.completed) continue;
              const oneRM = calculate1RM(set.weight, set.reps);
              if (oneRM > best) best = oneRM;
            }
          }
        }
        return best;
      },

      /**
       * Consecutive-day streak ending today (or yesterday if today has
       * no session yet). Returns 0 if the user has no completed
       * sessions or if the most recent training day is older than
       * yesterday.
       */
      streak(): number {
        const completedDays = new Set(
          this.sessions
            .filter((s) => s.status === 'completed')
            .map((s) => dateKey(new Date(s.date))),
        );
        if (completedDays.size === 0) return 0;

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const cursor = new Date(today);

        if (!completedDays.has(dateKey(cursor))) {
          // Today has no session — try yesterday as the streak anchor
          cursor.setDate(cursor.getDate() - 1);
          if (!completedDays.has(dateKey(cursor))) return 0;
        }

        let count = 0;
        while (completedDays.has(dateKey(cursor))) {
          count++;
          cursor.setDate(cursor.getDate() - 1);
        }
        return count;
      },

      // ── Per-session computations ──
      sessionVolume(s: Session): number {
        return s.exercises.reduce((sum, ex) => {
          return sum + ex.sets.reduce((sSum, set) => {
            return sSum + (set.completed ? set.weight * set.reps : 0);
          }, 0);
        }, 0);
      },

      sessionExercisesCount(s: Session): number {
        return s.exercises.length;
      },

      // ── Formatters / helpers exposed to the template ──
      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDate(iso);
      },

      formatVolume(volume: number): string {
        return formatVolume(volume);
      },

      // ════════════════════════════════════════════════════════
      // 7-day volume sparkline (pattern adapted from stats.astro
      // renderVolumeChart — bars only, no axis labels).
      // ════════════════════════════════════════════════════════
      buildSpark(): Array<{ key: string; label: string; volume: number }> {
        const days: Array<{ key: string; label: string; volume: number }> = [];
        for (let i = 6; i >= 0; i--) {
          const d = new Date();
          d.setDate(d.getDate() - i);
          d.setHours(0, 0, 0, 0);
          days.push({
            key: dateKey(d),
            label: d.toLocaleDateString(DATE_LOCALE, {
              day: 'numeric',
              month: 'short',
            }),
            volume: 0,
          });
        }

        const byKey = new Map(days.map((d) => [d.key, d] as const));
        for (const s of this.sessions) {
          if (s.status !== 'completed') continue;
          if (!s.date) continue;
          const bucket = byKey.get(dateKey(new Date(s.date)));
          if (!bucket) continue;
          for (const ex of s.exercises) {
            for (const set of ex.sets) {
              if (!set.completed) continue;
              bucket.volume += set.weight * set.reps;
            }
          }
        }
        return days;
      },

      renderSparkline(): string {
        const days = this.spark;
        if (days.length === 0) {
          return `<p class="dash__empty">${svgEscape(LABELS.common.noData)}</p>`;
        }

        const total = days.reduce((s, d) => s + d.volume, 0);
        const peak = Math.max(1, ...days.map((d) => d.volume)) * 1.1;

        const W = 480;
        const H = 160;
        const PAD = 8;
        const slotW = (W - PAD * 2) / days.length;
        const barW = Math.max(10, slotW * 0.52);
        const barGap = (slotW - barW) / 2;

        const accentCurrent = '#D97706';
        const accentMuted = 'rgba(217, 119, 6, 0.50)';

        let bars = '';
        days.forEach((d, i) => {
          const h = (d.volume / peak) * (H - PAD * 2);
          const x = PAD + i * slotW + barGap;
          const y = H - PAD - h;
          const isCurrent = i === days.length - 1;
          const fill = isCurrent ? accentCurrent : accentMuted;
          bars += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${Math.max(0, h).toFixed(1)}" rx="2" fill="${fill}" tabindex="0"><title>${svgEscape(d.label)} · ${formatVolume(d.volume)} ${LABELS.common.kg}</title></rect>`;
        });

        const ariaLabel = `${LABELS.dashboard.volumeLast7d} · ${formatVolume(total)} ${LABELS.common.kg}`;

        return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="dash__sparkline" role="img" aria-label="${svgEscape(ariaLabel)}">${bars}</svg>`;
      },

      // ════════════════════════════════════════════════════════
      // Muscle donut (pattern copied from stats.astro
      // renderMuscleChart — stroke-dasharray arcs, MUSCLE_PALETTE).
      // Legend keeps the top 5 muscles and buckets the rest.
      // ════════════════════════════════════════════════════════
      buildDonutSlices(week: MuscleVolumeSlice[]): MuscleVolumeSlice[] {
        if (week.length === 0) return [];
        const top = week.slice(0, 5);
        if (week.length <= 5) return top;

        const rest = week.slice(5);
        const restVolume = rest.reduce((s, sl) => s + sl.volume, 0);
        const total = week.reduce((s, sl) => s + sl.volume, 0);
        return [
          ...top,
          {
            id: OTHER_MUSCLE,
            muscle: OTHER_MUSCLE,
            volume: restVolume,
            pct: total > 0 ? (restVolume / total) * 100 : 0,
          },
        ];
      },

      renderDonut(): string {
        const slices = this.donutSlices;
        if (slices.length === 0) {
          return `<p class="dash__empty">${svgEscape(LABELS.common.noData)}</p>`;
        }

        const otherLabel = LABELS.common.otherSingular;
        const nameOf = (slice: MuscleVolumeSlice): string =>
          slice.muscle === OTHER_MUSCLE ? otherLabel : trMuscle(slice.muscle);

        const W = 300;
        const H = 300;
        const cx = W / 2;
        const cy = H / 2;
        const r = 100;
        const thickness = 14;
        const C = 2 * Math.PI * r;

        // Ring arcs, biggest share first (stabilises the palette order).
        let arcs = '';
        let cursor = 0; // cumulative share already drawn (0..1)
        for (let i = 0; i < slices.length; i++) {
          const sl = slices[i];
          const frac = sl.pct / 100;
          const segLen = C * frac;
          const gapLen = Math.max(0, C - segLen);
          const offset = -(C * cursor);
          cursor += frac;

          const color = MUSCLE_PALETTE[i % MUSCLE_PALETTE.length];
          const tip = `${svgEscape(nameOf(sl))} · ${formatVolume(sl.volume)} ${LABELS.common.kg} · ${Math.round(sl.pct)}%`;
          arcs += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="${thickness}" stroke-dasharray="${segLen.toFixed(2)} ${gapLen.toFixed(2)}" stroke-dashoffset="${offset.toFixed(2)}" tabindex="0"><title>${tip}</title></circle>`;
        }

        const total = slices.reduce((s, sl) => s + sl.volume, 0);

        const legend = slices
          .map((sl, i) => {
            const color = MUSCLE_PALETTE[i % MUSCLE_PALETTE.length];
            const name = svgEscape(nameOf(sl));
            const tip = `${name} · ${formatVolume(sl.volume)} ${LABELS.common.kg} · ${Math.round(sl.pct)}%`;
            return `
              <li class="dash__legend-row" title="${tip}">
                <span class="dash__legend-swatch" style="background: ${color}" aria-hidden="true"></span>
                <span class="dash__legend-name">${name}</span>
                <span class="dash__legend-pct">${Math.round(sl.pct)}%</span>
                <span class="dash__legend-value">${formatVolume(sl.volume)} ${LABELS.common.kg}</span>
              </li>`;
          })
          .join('');

        const ariaLabel = `${LABELS.dashboard.muscleSplit} · ${LABELS.dashboard.thisWeek}`;

        return `
<div class="dash__donut">
  <svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="dash__donut-svg" role="img" aria-label="${svgEscape(ariaLabel)}">
    <g transform="rotate(-90 ${cx} ${cy})">
      ${arcs}
    </g>
    <text x="${cx}" y="${cy - 4}" font-size="13" fill="var(--color-muted)" text-anchor="middle" font-family="var(--font-body, sans-serif)" letter-spacing="0.1em">${svgEscape(LABELS.dashboard.thisWeek.toUpperCase())}</text>
    <text x="${cx}" y="${cy + 20}" font-size="22" fill="var(--color-accent)" text-anchor="middle" font-family="var(--font-display, sans-serif)" font-weight="700">${formatVolume(total)} ${LABELS.common.kg}</text>
  </svg>
  <ul class="dash__donut-legend" aria-label="${svgEscape(LABELS.dashboard.muscleSplit)}">
    ${legend}
  </ul>
</div>`.trim();
      },
    }));
  });
</script>

