---
import Topbar from "../components/landing/Topbar.astro";
import LandingStatus from "../components/landing/LandingStatus.astro";
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import Title from "../components/ui/Title.astro";
import "../styles/index.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />
    <meta
      name="description"
      content="Muscu App aide à suivre une séance: séries, charges, repos et historique local."
    />
    <title>Muscu App</title>
  </head>
  <body>
    <main class="page-shell">
      <Container size="md">
        <div class="page-frame">
          <Topbar />

          <section class="hero-card" aria-labelledby="home-title">
            <p class="hero-kicker">Suivi de séance local</p>

            <Title as="h1" align="center" class="hero-title" id="home-title">
              Note tes séries sans sortir du rythme.
            </Title>

            <p class="hero-copy">
              Garde l'exercice actif, les charges, les répétitions et le repos sous
              les yeux. L'historique reste local, prêt pour la prochaine série.
            </p>

            <div class="actions">
              <Button href="#session">Ouvrir la séance</Button>
              <Button href="#actions" variant="secondary">Voir l'historique</Button>
            </div>

            <div class="hero-meta" aria-label="Repères rapides">
              <span>Développé couché</span>
              <span>Repos 01:30</span>
              <span>Dernière série 8 x 72,5</span>
            </div>
          </section>

          <LandingStatus city="Paris" />

          <div class="home-anchor" id="session" aria-hidden="true"></div>
          <div class="home-anchor" id="actions" aria-hidden="true"></div>
        </div>
      </Container>
    </main>
  </body>
</html>

<style>
  .page-shell {
    position: relative;
    z-index: 1;
    padding: 1.2rem 0 3.2rem;
  }

  .page-frame {
    display: grid;
    min-height: calc(100svh - 4.4rem);
    gap: 1.2rem;
    grid-template-rows: auto auto auto;
    align-content: center;
  }

  .hero-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.35rem;
    width: min(100%, 64rem);
    margin-inline: auto;
    padding: clamp(2.2rem, 3vw, 3.6rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }

  .hero-card::after {
    content: "";
    position: absolute;
    inset: 0.9rem;
    border: 1px solid hsl(0 0% 100% / 0.03);
    border-radius: 1.2rem;
    pointer-events: none;
  }

  .hero-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 15ch;
  }

  .hero-copy {
    max-width: 52ch;
    color: var(--muted);
    font-size: 1.5rem;
    line-height: 1.55;
    text-align: center;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    width: min(100%, 43rem);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    padding-top: 0.3rem;
  }

  .hero-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.55rem 1rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
    border-radius: var(--radius-pill);
    background: hsl(0 0% 100% / 0.02);
    color: hsl(0 0% 100% / 0.68);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-anchor {
    position: relative;
    height: 1px;
    margin-top: -1px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .page-shell {
      padding-top: 0.9rem;
    }

    .page-frame {
      min-height: calc(100svh - 3.6rem);
      gap: 1rem;
    }

    .hero-card {
      gap: 1.2rem;
      padding: 1.8rem 1.4rem;
    }

    .hero-copy {
      max-width: 32ch;
      font-size: 1.4rem;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-card {
      animation: rise 0.35s ease-out both;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
