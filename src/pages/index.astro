---
import Topbar from "../components/landing/Topbar.astro";
import LandingStatus from "../components/landing/LandingStatus.astro";
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import Title from "../components/ui/Title.astro";
import "../styles/index.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />
    <meta
      name="description"
      content="Muscu App aide à suivre une séance: séries, charges, repos et historique local."
    />
    <title>Muscu App</title>
  </head>
  <body>
    <main class="page-shell">
      <Container size="md">
        <div class="page-frame">
          <Topbar />

          <section class="hero-card" aria-labelledby="home-title">
            <div class="hero-indicator">
              <span class="hero-indicator-dot" aria-hidden="true"></span>
              <span class="hero-indicator-label">Prêt à l'entraînement</span>
            </div>

            <p class="hero-kicker">Carnet d'entraînement</p>

            <Title as="h1" align="center" class="hero-title" id="home-title">
              Chaque série, chaque charge, chaque répétition.
            </Title>

            <p class="hero-copy">
              Un carnet sobre et précis, sans compte ni cloud. Ta progression en
              local, à portée de clic.
            </p>

            <div class="actions">
              <Button href="#session">Ouvrir la séance</Button>
              <Button href="#actions" variant="secondary"
                >Voir l'historique</Button
              >
            </div>

            <div class="hero-meta" aria-label="Repères rapides">
              <span data-meta="exercise">—</span>
              <span data-meta="rest">Repos —</span>
              <span data-meta="last-set">Aucune série</span>
            </div>
          </section>

          <LandingStatus city="Paris" />

          <div class="home-anchor" id="session" aria-hidden="true"></div>
          <div class="home-anchor" id="actions" aria-hidden="true"></div>
        </div>
      </Container>
    </main>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const exercise = localStorage.getItem("muscu-last-exercise");
        const rest = localStorage.getItem("muscu-last-rest");
        const lastSet = localStorage.getItem("muscu-last-set");
        if (exercise) {
          const el = document.querySelector("[data-meta='exercise']");
          if (el) el.textContent = exercise;
        }
        if (rest) {
          const el = document.querySelector("[data-meta='rest']");
          if (el) el.textContent = "Repos " + rest;
        }
        if (lastSet) {
          const el = document.querySelector("[data-meta='last-set']");
          if (el) el.textContent = "Dernière série " + lastSet;
        }

        const card = document.querySelector(".hero-card");
        if (card) {
          card.addEventListener("mousemove", (e) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty(
              "--mx",
              ((e.clientX - rect.left) / rect.width) * 100 + "%",
            );
            card.style.setProperty(
              "--my",
              ((e.clientY - rect.top) / rect.height) * 100 + "%",
            );
          });
          card.addEventListener("mouseleave", () => {
            card.style.setProperty("--mx", "50%");
            card.style.setProperty("--my", "0%");
          });
        }
      });
    </script>
  </body>
</html>

<style>
  .page-shell {
    position: relative;
    z-index: 1;
    padding: 1.2rem 0 3.2rem;
  }

  .page-frame {
    display: grid;
    min-height: calc(100svh - 4.4rem);
    gap: 2rem;
    grid-template-rows: auto auto auto;
    align-content: center;
  }

  .hero-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2rem;
    width: min(100%, 64rem);
    margin-inline: auto;
    padding: clamp(2.8rem, 4vw, 5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow:
      0 2px 8px hsl(0 0% 0% / 0.4),
      0 8px 32px hsl(0 84% 60% / 0.06);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  .hero-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 65% 35% at 50% 0%,
        hsl(0 84% 60% / 0.06),
        transparent 70%
      ),
      radial-gradient(
        circle 220px at var(--mx, 50%) var(--my, 0%),
        hsl(0 0% 100% / 0.025),
        transparent
      );
  }

  @media (hover: hover) {
    .hero-card:hover {
      transform: translateY(-3px);
      box-shadow:
        0 4px 12px hsl(0 0% 0% / 0.44),
        0 12px 48px hsl(0 84% 60% / 0.09);
    }
  }

  @supports (backdrop-filter: blur(1px)) {
    .hero-card {
      background: hsl(0 0% 0% / 0.25);
      backdrop-filter: blur(14px);
    }
  }
  @supports (-webkit-backdrop-filter: blur(1px)) {
    .hero-card {
      -webkit-backdrop-filter: blur(14px);
    }
  }

  .hero-card::after {
    content: "";
    position: absolute;
    inset: 0.8rem;
    border: 1px solid hsl(0 0% 100% / 0.04);
    border-radius: calc(var(--radius-xl) - 0.8rem);
    pointer-events: none;
  }

  .hero-indicator {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .hero-indicator-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    animation: breathe 2s ease-in-out infinite;
  }

  .hero-indicator-label {
    color: hsl(0 0% 100% / 0.4);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @keyframes breathe {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.35);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  :global(.hero-title) :global(.ui-title-heading) {
    font-size: clamp(3.4rem, 5vw, 6.2rem);
    letter-spacing: -0.04em;
    max-width: 18ch;
  }

  .hero-copy {
    max-width: 58ch;
    color: var(--muted);
    font-size: 1.6rem;
    line-height: 1.55;
    text-align: center;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.4rem;
    width: min(100%, 43rem);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    padding-top: 0.8rem;
  }

  .hero-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.55rem 1rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
    border-radius: var(--radius-pill);
    background: hsl(0 0% 100% / 0.02);
    color: hsl(0 0% 100% / 0.68);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-anchor {
    position: relative;
    height: 1px;
    margin-top: -1px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .page-shell {
      padding-top: 0.9rem;
    }

    .page-frame {
      min-height: calc(100svh - 3.6rem);
      gap: 1rem;
    }

    .hero-card {
      gap: 1.6rem;
      padding: 1.8rem 1.6rem;
    }

    :global(.hero-title) :global(.ui-title-heading) {
      font-size: clamp(2.4rem, 7vw, 3.4rem);
      max-width: 20ch;
    }

    .hero-copy {
      max-width: 38ch;
      font-size: 1.4rem;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .hero-meta span {
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-card > * {
      animation: rise 0.45s ease-out both;
    }

    .hero-card > :nth-child(1) {
      animation-delay: 0ms;
    }
    .hero-card > :nth-child(2) {
      animation-delay: 80ms;
    }
    .hero-card > :nth-child(3) {
      animation-delay: 160ms;
    }
    .hero-card > :nth-child(4) {
      animation-delay: 240ms;
    }
    .hero-card > :nth-child(5) {
      animation-delay: 320ms;
    }
    .hero-card > :nth-child(6) {
      animation-delay: 400ms;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
