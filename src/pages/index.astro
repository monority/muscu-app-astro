---import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Badge from "../components/ui/Badge.astro";
import Icon from "../components/ui/Icon.astro";
import { t, setLocale, defaultLocale, localizedPath } from "../i18n";

setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.dashboard.title}>
  <PageHeader 
title={L.dashboard.title}
   description={L.dashboard.description} 
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/sessions/create")}
 />

  <div class="dash" x-data="dashboardApp()" x-init="init()" x-cloak>
    {/* ── Quick actions — always visible in BOTH states ── */}
    <div class="dash__actions">
      <a
        href={localizedPath("/sessions/create")}
        class="btn btn--primary btn--md"
      >
        <Icon name="plus" size={16} />
        <span>{L.dashboard.newSession}</span>
      </a>
      <a
        href={localizedPath("/timer")}
        class="btn btn--secondary btn--md"
      >
        <Icon name="clockStopwatch" size={16} />
        <span>{L.dashboard.stopwatch}</span>
      </a>
    </div>

    {/* ── Main dashboard (once training has started) ── */}
    <div x-show="hasSessions">
      <div class="dash__overview dash__signal">
        {/* ── Hero: today's volume ── */}
        <section class="dash__hero" aria-label={L.dashboard.todayVolume}>
          <div class="dash__hero-icon" aria-hidden="true">
            <Icon name="trendingUp" size={16} />
          </div>
          <span class="dash__hero-label">{L.dashboard.todayVolume}</span>
          <div class="dash__hero-value">
            <span class="dash__hero-number" x-text="formatVolume(todayVolume)"
            ></span>
            <span
              class="dash__hero-unit"
              x-text="todayVolume > 0 ? labels.kg : ''"></span>
          </div>
          <div class="dash__hero-context" x-show="todaySessions > 0">
            <span
              x-text="todaySessions === 1 ? labels.sessionCount.replace('{count}', todaySessions) : todaySessions + ' ' + labels.sessionsUnit"
            ></span>
            <span class="dash__hero-context-sep" aria-hidden="true">·</span>
            <span
              x-text="todayExercises === 1 ? labels.exerciseCount.replace('{count}', todayExercises) : todayExercises + ' ' + labels.exercisesUnit"
            ></span>
          </div>
        </section>

        {/* ── Weekly goal card ── */}
        <section class="dash__goal" aria-label={L.dashboard.goalCardAria}>
          <div class="dash__goal-ring" aria-hidden="true">
            <svg viewBox="0 0 44 44" class="dash__goal-ring-svg">
              <circle cx="22" cy="22" r="18" class="dash__goal-ring-track"
              ></circle>
              <circle
                cx="22"
                cy="22"
                r="18"
                class="dash__goal-ring-fill"
                :class="{ 'dash__goal-ring-fill--complete': weeklyDone >= settings.weeklyGoal }"
                :stroke-dasharray="`${weeklyProgress * 113.1} 113.1`"></circle>
            </svg>
            <span
              class="dash__goal-ring-pct"
              x-text="`${Math.round(weeklyProgress * 100)}%`"></span>
          </div>

          <div class="dash__goal-text">
            <span class="dash__goal-eyebrow" x-text="labels.weeklyGoalEyebrow"
              >{L.dashboard.weeklyGoalEyebrow}</span
            >
            <h2 class="dash__goal-title">
              <span class="dash__goal-done" x-text="weeklyDone"></span>
              <span class="dash__goal-sep" aria-hidden="true">/</span>
              <span class="dash__goal-target" x-text="settings.weeklyGoal"
                >3</span
              >
              <span
                class="dash__goal-unit"
                x-text="weeklyDone === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
                >{L.dashboard.sessionsUnit}</span
              >
            </h2>

            <div
              class="dash__goal-bar"
              role="progressbar"
              aria-label={L.dashboard.goalCardAria}
              aria-valuemin="0"
              :aria-valuenow="weeklyDone"
              :aria-valuemax="settings.weeklyGoal"
            >
              <div
                class="dash__goal-bar-fill"
                :class="{ 'dash__goal-bar-fill--complete': weeklyDone >= settings.weeklyGoal }"
                :style="`width: ${Math.min(100, weeklyProgress * 100)}%`"
              >
              </div>
            </div>

            <p
              class="dash__goal-hint"
              x-show="weeklyDone >= settings.weeklyGoal"
              x-transition.opacity
              x-cloak
              x-text="labels.weeklyGoalDone"
            >
            </p>
            <p
              class="dash__goal-hint dash__goal-hint--muted"
              x-show="weeklyDone < settings.weeklyGoal && settings.weeklyGoal > 0"
              x-text="remainingHintText()"
            >
            </p>
          </div>
        </section>

        {/* ── Next session: actionable data, not a decorative card ── */}
        <section
          class="dash__next"
          x-show="nextSession"
          aria-label={L.dashboard.nextSession}
        >
          <div class="dash__next-kicker" x-text="labels.nextSession">
            {L.dashboard.nextSession}
          </div>
          <div class="dash__next-main">
            <div class="dash__next-copy">
              <h2 class="dash__next-name" x-text="nextSession?.name"></h2>
              <p
                class="dash__next-hint"
                x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.plannedWorkoutHint"
              >
              </p>
            </div>
            <a
              class="dash__next-action"
              :href="localizedPath('/sessions/quick?session=' + nextSession?.id)"
            >
              <span
                x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.startWorkout"
              ></span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </div>

      {/* ── KPI band ── */}
      <section class="dash__kpis" aria-label={L.dashboard.kpisAria}>
        {/* Volume */}
        <div class="dash__kpi dash__kpi--volume">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <Icon name="dumbbell" size={16} />
              </span>
              <span class="dash__kpi-label">{L.dashboard.totalVolume}</span>
            </div>
            <div class="flex items-baseline">
              <span
                class="dash__kpi-value"
                x-text="formatVolume(kpis.totalVolume)"></span>
              <span class="dash__kpi-unit">{L.common.kg}</span>
            </div>
          </div>
        </div>

        {/* Séances */}
        <div class="dash__kpi dash__kpi--sessions">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <Icon name="calendar" size={16} />
              </span>
              <span class="dash__kpi-label">{L.dashboard.totalSessions}</span>
            </div>
            <div class="flex items-baseline">
              <span class="dash__kpi-value" x-text="kpis.totalSessions"></span>
              <span
                class="dash__kpi-unit"
                x-text="kpis.totalSessions === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
                >{L.dashboard.sessionsUnit}</span
              >
            </div>
          </div>
        </div>

        {/* Meilleurs PRs */}
        <div class="dash__kpi dash__kpi--pr">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <Icon name="award" size={16} />
              </span>
              <span class="dash__kpi-label">{L.dashboard.bestPRs}</span>
            </div>
            <div class="flex items-baseline">
              <span class="dash__kpi-value" x-text="kpis.bestPRs"></span>
              <span
                class="dash__kpi-unit"
                x-text="kpis.bestPRs === 1 ? labels.exoSingular.trim() : labels.exercisesUnit"
                >{L.dashboard.exercisesUnit}</span
              >
            </div>
            <div
              class="dash__kpi-sub"
              x-show="kpis.top1RM > 0"
              x-text="labels.top1RM + ' ' + formatVolume(kpis.top1RM) + ' ' + labels.kg"
            >
            </div>
          </div>
        </div>

        {/* Série en cours */}
        <div class="dash__kpi dash__kpi--streak">
          <div class="flex flex-col gap-1">
            <div class="dash__kpi-head">
              <span class="dash__kpi-icon" aria-hidden="true">
                <Icon name="flame" size={16} />
              </span>
              <span class="dash__kpi-label">{L.dashboard.streak}</span>
            </div>
            <div class="flex items-baseline">
              <span class="dash__kpi-value" x-text="kpis.streak"></span>
              <span
                class="dash__kpi-unit"
                x-text="kpis.streak === 1 ? labels.daysSingular : labels.daysUnit"
                >{L.dashboard.daysUnit}</span
              >
            </div>
            <div
              class="dash__kpi-sub"
              x-show="kpis.streak === 0 && kpis.totalSessions > 0"
              x-text="labels.noRecent"
            >
            </div>
          </div>
        </div>
      </section>

      {/* ── Weekly volume trend ── */}
      <section class="dash__trend" aria-label={L.dashboard.weeklyVolumeTrend}>
        <div class="dash__trend-panel">
          <header class="dash__section-head dash__trend-head">
            <h2>{L.dashboard.weeklyVolumeTrend}</h2>
          </header>
          <div class="dash__trend-content">
            <div class="dash__trend-chart" x-show="weeklyVolumeTotal > 0">
              <template x-for="(v, i) in weeklyVolumeByDay" :key="i">
                <div
                  class="dash__trend-col"
                  :class="{ 'dash__trend-col--today': i === todayIdx }"
                  role="img"
                  :aria-label="`${dayLabels[i]}: ${formatVolume(v)} ${labels.kg}`"
                >
                  <div class="dash__trend-bar-wrap">
                    <div
                      class="dash__trend-bar"
                      :class="i === todayIdx ? 'dash__trend-bar--today' : (v > 0 && i < todayIdx ? 'dash__trend-bar--past' : 'dash__trend-bar--empty')"
                      :style="`height: ${v > 0 ? Math.round((v / maxVol) * 100) : 0}%`"
                    >
                    </div>
                  </div>
                  <span
                    class="dash__trend-day"
                    x-text="dayLabels[i]"
                    :aria-current="i === todayIdx ? 'date' : undefined"></span>
                </div>
              </template>
            </div>
            <div
              class="dash__trend-empty"
              x-show="weeklyVolumeTotal <= 0"
              x-cloak
              role="status"
            >
              <strong x-text="labels.noWeeklyVolume"
                >{L.dashboard.noWeeklyVolume}</strong
              >
              <span x-text="labels.noWeeklyVolumeHint"
                >{L.dashboard.noWeeklyVolumeHint}</span
              >
            </div>
          </div>
        </div>
      </section>

      {/* ── Recent sessions ── */}
      <section class="dash__recent" aria-label={L.dashboard.recentAria}>
        <header class="dash__section-head">
          <h2 x-text="labels.recentSessions">{L.dashboard.recentSessions}</h2>
          <a
            href={localizedPath("/sessions")}
            class="dash__see-all"
            x-text="labels.viewAll">{L.dashboard.viewAll} →</a
          >
        </header>

        <div class="dash__sessions">
          <template x-for="s in recentSessions" :key="s.id">
            <a
              :href="localizedPath('/sessions/detail?id=' + s.id)"
              class="dash__session"
              :class="'dash__session--' + s.status"
            >
              <div class="dash__session-head">
                <div class="dash__session-title">
                  <span class="dash__session-dot" aria-hidden="true"></span>
                  <h3 class="dash__session-name" x-text="s.name"></h3>
                </div>
                <div class="dash__session-badge">
                  <div x-show="s.status === 'completed'">
                    <Badge variant="success" size="sm"
                      ><span x-text="statusLabel(s.status)"></span></Badge
                    >
                  </div>
                  <div x-show="s.status === 'in-progress'">
                    <Badge variant="info" size="sm"
                      ><span x-text="statusLabel(s.status)"></span></Badge
                    >
                  </div>
                  <div
                    x-show="s.status !== 'completed' && s.status !== 'in-progress'"
                  >
                    <Badge variant="default" size="sm"
                      ><span x-text="statusLabel(s.status)"></span></Badge
                    >
                  </div>
                </div>
              </div>

              <div class="dash__session-meta">
                <span class="dash__session-date" x-text="formatDate(s.date)"
                ></span>
                <span class="dash__session-sep" aria-hidden="true">·</span>
                <span>
                  <span x-text="sessionExercisesCount(s)"></span>
                  <span
                    x-text="sessionExercisesCount(s) > 1 ? labels.exoPlural : labels.exoSingular"
                  ></span>
                </span>
                <span class="dash__session-sep" aria-hidden="true">·</span>
                <span
                  class="dash__session-volume"
                  x-text="formatVolume(sessionVolume(s)) + ' ' + labels.kg"
                ></span>
                <div
                  class="dash__session-muscle"
                  x-show="sessionPrimaryMuscle(s)"
                >
                  <Badge variant="default" size="sm"
                    ><span x-text="muscleLabel(sessionPrimaryMuscle(s))"
                    ></span></Badge
                  >
                </div>
              </div>
            </a>
          </template>
        </div>
      </section>
    </div>

    {/* ── Empty (first run: no sessions yet) — decorative, no zeros ── */}
    <div class="dash__empty" x-show="!hasSessions">
      <div class="dash__empty-ring" aria-hidden="true">
        <svg viewBox="0 0 100 100" class="dash__empty-ring-svg">
          <circle cx="50" cy="50" r="46" class="dash__empty-ring-track"
          ></circle>
          <circle cx="50" cy="50" r="46" class="dash__empty-ring-fill"></circle>
        </svg>
        <div class="dash__empty-disc">
          <Icon name="dumbbell" size={48} class="dash__empty-dumbbell" />
        </div>
      </div>

      <h1 class="dash__empty-title">{L.dashboard.emptyTitle}</h1>
      <p class="dash__empty-desc">{L.dashboard.emptyDesc}</p>

      <div class="dash__empty-actions">
        <a
          href={localizedPath("/sessions/create")}
          class="btn btn--primary btn--md"
        >
          <Icon name="plus" size={16} />
          <span>{L.dashboard.createFirst}</span>
        </a>
        <a
          href={localizedPath("/timer")}
          class="btn btn--secondary btn--md"
        >
          <Icon name="clockStopwatch" size={16} />
          <span>{L.dashboard.stopwatch}</span>
        </a>
        <a href={localizedPath("/exercises")} class="dash__empty-link">
          {L.dashboard.browseExercises}
        </a>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getExercises,
    getSessionsThisWeek,
    getSettings,
    calculate1RM,
    type Session,
    type SessionStatus,
  } from "../lib/storage";
  import { t, getLocale, localizedPath } from "../i18n";

  const LABELS = t();

  // ── Pure helpers (module scope) ────────────────────────────
  function statusLabel(status: SessionStatus): string {
    if (status === "completed") return LABELS.sessions.completed;
    if (status === "in-progress") return LABELS.sessions.inProgress;
    return LABELS.sessions.planned;
  }

  const DATE_LOCALE = getLocale() === "fr" ? "fr-FR" : "en-US";

  function formatDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(DATE_LOCALE, {
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  }

  function formatVolume(volume: number): string {
    if (!Number.isFinite(volume) || volume <= 0) return "0";
    return Math.round(volume).toLocaleString(DATE_LOCALE);
  }

  /** ISO date key YYYY-MM-DD (local-tz) — used for day-level comparisons. */
  function dateKey(d: Date): string {
    const y = d.getFullYear();
    const m = (d.getMonth() + 1).toString().padStart(2, "0");
    const day = d.getDate().toString().padStart(2, "0");
    return `${y}-${m}-${day}`;
  }

  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data("dashboardApp", () => ({
      // ── State ──
      sessions: [] as Session[],
      settings: getSettings(),
      weeklyDone: 0,
      labels: {
        top1RM: LABELS.dashboard.top1RM,
        weeklyGoalEyebrow: LABELS.dashboard.weeklyGoalEyebrow,
        weeklyGoalDone: LABELS.dashboard.weeklyGoalDone,
        weeklyMoreSingular: LABELS.dashboard.weeklyMoreSingular,
        sessionsUnit: LABELS.dashboard.sessionsUnit,
        exercisesUnit: LABELS.dashboard.exercisesUnit,
        daysUnit: LABELS.dashboard.daysUnit,
        remainingHint: LABELS.dashboard.remainingHint,
        exoPlural: LABELS.dashboard.exoPlural,
        exoSingular: LABELS.dashboard.exoSingular,
        daysSingular: LABELS.dashboard.daysSingular,
        noRecent: LABELS.dashboard.noRecent,
        viewAll: LABELS.dashboard.viewAllArrow,
        recentSessions: LABELS.dashboard.recentSessions,
        kg: LABELS.common.kg,
        todayVolume: LABELS.dashboard.todayVolume,
        weeklyVolumeTrend: LABELS.dashboard.weeklyVolumeTrend,
        noWeeklyVolume: LABELS.dashboard.noWeeklyVolume,
        noWeeklyVolumeHint: LABELS.dashboard.noWeeklyVolumeHint,
        nextSession: LABELS.dashboard.nextSession,
        continueWorkout: LABELS.dashboard.continueWorkout,
        startWorkout: LABELS.dashboard.startWorkout,
        plannedWorkoutHint: LABELS.dashboard.plannedWorkoutHint,
        sessionCount: LABELS.dashboard.sessionCount,
        exerciseCount: LABELS.dashboard.exerciseCount,
      },

      // Expose localizedPath to Alpine expressions (uses window.__LOCALE__).
      localizedPath,

      // ── Init ──
      init() {
        // Touch the storage so the exercise seed is created on first load.
        getExercises();
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
        this.settings = getSettings();
        this.weeklyDone = getSessionsThisWeek().length;
      },

      // ── Derived ──
      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      get hasCompletedSessions(): boolean {
        return this.sessions.some((s) => s.status === "completed");
      },

      get recentSessions(): Session[] {
        return this.sessions.slice(0, 5);
      },

      /** The first unfinished session is the only honest "next" action. */
      get nextSession(): Session | null {
        return (
          this.sessions.find(
            (s) => s.status === "in-progress" || s.status === "planned",
          ) ?? null
        );
      },

      /** Progress as a 0-1 ratio. Returns 0 when the target is invalid. */
      get weeklyProgress(): number {
        const target = this.settings.weeklyGoal;
        if (!Number.isFinite(target) || target <= 0) return 0;
        return Math.min(1, Math.max(0, this.weeklyDone / target));
      },

      // ── Today ──
      /** Sum of weight × reps over completed sets of today's sessions. */
      get todayVolume(): number {
        const key = dateKey(new Date());
        return this.sessions
          .filter((s) => dateKey(new Date(s.date)) === key)
          .reduce((sum, s) => sum + this.sessionVolume(s), 0);
      },

      get todaySessions(): number {
        const key = dateKey(new Date());
        return this.sessions.filter((s) => dateKey(new Date(s.date)) === key)
          .length;
      },

      /** Count of distinct exercises across today's sessions. */
      get todayExercises(): number {
        const key = dateKey(new Date());
        const seen = new Set<string>();
        for (const s of this.sessions) {
          if (dateKey(new Date(s.date)) !== key) continue;
          for (const ex of s.exercises) seen.add(ex.exerciseId);
        }
        return seen.size;
      },

      // ── Weekly trend ──
      /** Per-day volume sums (index = getDay(), 0 = Sunday), this week. */
      get weeklyVolumeByDay(): number[] {
        const arr = new Array(7).fill(0);
        const now = new Date();
        const startOfWeek = new Date(now);
        startOfWeek.setDate(now.getDate() - now.getDay()); // Sunday
        startOfWeek.setHours(0, 0, 0, 0);
        for (const s of this.sessions) {
          const d = new Date(s.date);
          if (d < startOfWeek) continue;
          arr[d.getDay()] += this.sessionVolume(s);
        }
        return arr;
      },

      /** Today's weekday index (getDay(): 0 = Sunday … 6 = Saturday). */
      get todayIdx(): number {
        return new Date().getDay();
      },

      get weeklyVolumeTotal(): number {
        return this.weeklyVolumeByDay.reduce((sum, volume) => sum + volume, 0);
      },

      /** Scale for the trend bars — never 0 so empty weeks render 0%. */
      get maxVol(): number {
        return Math.max(...this.weeklyVolumeByDay, 1);
      },

      /** Locale-aware day labels, Sun → Sat. */
      get dayLabels(): string[] {
        return getLocale() === "fr"
          ? ["D", "L", "M", "M", "J", "V", "S"]
          : ["S", "M", "T", "W", "T", "F", "S"];
      },

      // ── KPIs (recomputed on demand; Alpine caches via getters) ──
      get kpis() {
        return {
          totalSessions: this.sessions.length,
          totalVolume: this.totalVolume(),
          bestPRs: this.bestPRs(),
          top1RM: this.top1RM(),
          streak: this.streak(),
        };
      },

      // ── Goal hint ──
      remainingHintText(): string {
        const remaining = Math.max(
          0,
          this.settings.weeklyGoal - this.weeklyDone,
        );
        const unit =
          remaining === 1
            ? this.labels.weeklyMoreSingular
            : this.labels.sessionsUnit;
        return this.labels.remainingHint
          .replace("{count}", String(remaining))
          .replace("{unit}", unit);
      },

      totalVolume(): number {
        return this.sessions.reduce((sum, s) => {
          return (
            sum +
            s.exercises.reduce((eSum, ex) => {
              return (
                eSum +
                ex.sets.reduce((sSum, set) => {
                  return sSum + (set.completed ? set.weight * set.reps : 0);
                }, 0)
              );
            }, 0)
          );
        }, 0);
      },

      /**
       * "Best PRs" = number of unique exercises for which the user has
       * completed at least one set. Each one is a personal record of
       * having been performed; the top 1RM across all is reported
       * separately via `top1RM()`.
       */
      bestPRs(): number {
        const trained = new Set<string>();
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            if (ex.sets.some((set) => set.completed)) {
              trained.add(ex.exerciseId);
            }
          }
        }
        return trained.size;
      },

      /**
       * Highest estimated 1RM across all completed sets.
       * Also seeds the progress log for any new PRs encountered.
       */
      top1RM(): number {
        let best = 0;
        for (const s of this.sessions) {
          for (const ex of s.exercises) {
            for (const set of ex.sets) {
              if (!set.completed) continue;
              const oneRM = calculate1RM(set.weight, set.reps);
              if (oneRM > best) best = oneRM;
            }
          }
        }
        return best;
      },

      /**
       * Consecutive-day streak ending today (or yesterday if today has
       * no session yet). Returns 0 if the user has no completed
       * sessions or if the most recent training day is older than
       * yesterday.
       */
      streak(): number {
        const completedDays = new Set(
          this.sessions
            .filter((s) => s.status === "completed")
            .map((s) => dateKey(new Date(s.date))),
        );
        if (completedDays.size === 0) return 0;

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const cursor = new Date(today);

        if (!completedDays.has(dateKey(cursor))) {
          // Today has no session — try yesterday as the streak anchor
          cursor.setDate(cursor.getDate() - 1);
          if (!completedDays.has(dateKey(cursor))) return 0;
        }

        let count = 0;
        while (completedDays.has(dateKey(cursor))) {
          count++;
          cursor.setDate(cursor.getDate() - 1);
        }
        return count;
      },

      // ── Per-session computations ──
      sessionVolume(s: Session): number {
        return s.exercises.reduce((sum, ex) => {
          return (
            sum +
            ex.sets.reduce((sSum, set) => {
              return sSum + (set.completed ? set.weight * set.reps : 0);
            }, 0)
          );
        }, 0);
      },

      sessionExercisesCount(s: Session): number {
        return s.exercises.length;
      },

      /** Most frequent muscle across the session's exercises ('' when none). */
      sessionPrimaryMuscle(s: Session): string {
        const counts = new Map<string, number>();
        for (const ex of s.exercises) {
          if (!ex.muscle) continue;
          counts.set(ex.muscle, (counts.get(ex.muscle) ?? 0) + 1);
        }
        let best = "";
        let bestCount = 0;
        for (const [muscle, count] of counts) {
          if (count > bestCount) {
            best = muscle;
            bestCount = count;
          }
        }
        return best;
      },

      /** Translated stored muscle group for display (FR stays as-is). */
      muscleLabel(name: string): string {
        const tr = (window as { trMuscle?: (m: string) => string }).trMuscle;
        return tr ? tr(name) : name;
      },

      // ── Formatters / helpers exposed to the template ──
      statusLabel(status: SessionStatus): string {
        return statusLabel(status);
      },

      formatDate(iso: string): string {
        return formatDate(iso);
      },

      formatVolume(volume: number): string {
        return formatVolume(volume);
      },
    }));
  });
</script>



