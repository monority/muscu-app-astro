---
import AppLayout from '../layouts/AppLayout.astro';
import Card from '../components/ui/Card.astro';
import CardHeader from '../components/ui/CardHeader.astro';
import CardTitle from '../components/ui/CardTitle.astro';
import CardContent from '../components/ui/CardContent.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import PageHeader from '../components/layout/PageHeader.astro';
---

<AppLayout title="Dashboard">
  <PageHeader
    title="Dashboard"
    description="Vue d'ensemble de votre entraînement."
    actionLabel="Nouvelle séance"
    actionHref="/seances/creer"
  />

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1.6rem; margin-bottom: 3.2rem;">
    <Card variant="elevated">
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
          <span style="font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">Volume total</span>
          <span style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; font-variant-numeric: tabular-nums;">12 940 kg</span>
        </div>
      </CardContent>
    </Card>

    <Card variant="elevated">
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
          <span style="font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">Séances</span>
          <span style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; font-variant-numeric: tabular-nums;">4</span>
        </div>
      </CardContent>
    </Card>

    <Card variant="elevated">
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
          <span style="font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">PRs</span>
          <span style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; font-variant-numeric: tabular-nums;">2</span>
        </div>
      </CardContent>
    </Card>

    <Card variant="elevated">
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
          <span style="font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">Streak</span>
          <span style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; font-variant-numeric: tabular-nums;">12 jours</span>
        </div>
      </CardContent>
    </Card>
  </div>

  <h2 style="font-size: 1.6rem; color: var(--color-muted); margin-bottom: 1.6rem;">Séances récentes</h2>

  <div style="display: flex; flex-direction: column; gap: 0.8rem;">
    <Card hover clickable>
      <CardHeader>
        <CardTitle>Push Day</CardTitle>
        <Badge variant="success" size="sm">Terminée</Badge>
      </CardHeader>
      <CardContent>
        <p style="color: var(--color-muted); font-size: 1.2rem;">12 mars 2026 · 4 exercices · 3 200 kg</p>
      </CardContent>
    </Card>

    <Card hover clickable>
      <CardHeader>
        <CardTitle>Pull Day</CardTitle>
        <Badge variant="success" size="sm">Terminée</Badge>
      </CardHeader>
      <CardContent>
        <p style="color: var(--color-muted); font-size: 1.2rem;">10 mars 2026 · 5 exercices · 4 100 kg</p>
      </CardContent>
    </Card>

    <Card hover clickable>
      <CardHeader>
        <CardTitle>Legs Day</CardTitle>
        <Badge variant="accent" size="sm">En cours</Badge>
      </CardHeader>
      <CardContent>
        <p style="color: var(--color-muted); font-size: 1.2rem;">8 mars 2026 · 4 exercices · 5 640 kg</p>
      </CardContent>
    </Card>
  </div>
</AppLayout>
