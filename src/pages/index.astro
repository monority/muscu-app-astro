---
import Button from "../components/ui/Button.astro";
import CityLabel from "../components/ui/CityLabel.astro";
import Container from "../components/ui/Container.astro";
import LiveClock from "../components/ui/LiveClock.astro";
import Title from "../components/ui/Title.astro";
import "../styles/index.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />
    <meta
      name="description"
      content="Muscu App, une base clean et simple pour suivre une séance de musculation."
    />
    <title>Muscu App</title>
  </head>
  <body>
    <main class="page-shell">
      <Container size="md">
        <div class="page-frame">
          <header class="topbar" aria-label="Muscu App">
            <div class="topbar-pill">
              <span class="topbar-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M4 12h4M16 12h4M8 8v8M16 8v8"></path>
                </svg>
              </span>

              <span class="topbar-brand">Muscu App</span>

              <span class="topbar-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                  <path d="M12 7v5l3 2"></path>
                  <circle cx="12" cy="12" r="8"></circle>
                </svg>
              </span>
            </div>
          </header>

          <section class="hero-card" aria-labelledby="home-title">
            <p class="hero-kicker">Suivi de séance local</p>

            <Title as="h1" align="center" class="hero-title" id="home-title">
              Note tes séries sans sortir du rythme.
            </Title>

            <p class="hero-copy">
              Exercice en cours, charges, répétitions, repos et historique restent
              au même endroit, lisibles pendant l'entraînement.
            </p>

            <div class="actions">
              <Button href="#session">Ouvrir la séance</Button>
              <Button href="#actions" variant="secondary">Voir l'historique</Button>
            </div>

            <div class="hero-meta" aria-label="Repères rapides">
              <span>Exercice suivant</span>
              <span>Repos 01:30</span>
              <span>Historique local</span>
            </div>
          </section>

          <footer class="landing-status" aria-label="Contexte actuel">
            <CityLabel city="Paris" />
            <LiveClock />
          </footer>

          <div class="home-anchor" id="session" aria-hidden="true"></div>
          <div class="home-anchor" id="actions" aria-hidden="true"></div>
        </div>
      </Container>
    </main>
  </body>
</html>

<style>
  .page-shell {
    position: relative;
    z-index: 1;
    padding: 1.2rem 0 3.2rem;
  }

  .page-frame {
    display: grid;
    min-height: calc(100svh - 4.4rem);
    gap: 1.4rem;
    grid-template-rows: auto auto auto;
    align-content: center;
  }

  .topbar {
    display: flex;
    justify-content: center;
  }

  .topbar-pill {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.1rem;
    padding: 0.55rem 1.1rem 0.55rem 0.7rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
    border-radius: 999px;
    background:
      linear-gradient(180deg, hsl(0 0% 100% / 0.04), hsl(0 0% 100% / 0.01)),
      hsl(0 0% 100% / 0.015);
    box-shadow: 0 12px 28px hsl(0 0% 0% / 0.2);
    backdrop-filter: blur(10px);
  }

  .topbar-brand {
    color: var(--text);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .topbar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 999px;
    border: 1px solid hsl(0 0% 100% / 0.08);
    background: hsl(0 0% 100% / 0.02);
    color: var(--muted);
  }

  .topbar-icon svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    width: min(100%, 64rem);
    margin-inline: auto;
    padding: clamp(2.2rem, 2.8vw, 3.2rem);
    border: 1px solid var(--border);
    border-radius: 1.8rem;
    background:
      linear-gradient(180deg, hsl(0 0% 100% / 0.02), transparent 45%),
      linear-gradient(180deg, var(--surface-2), var(--surface));
  }

  .hero-card::after {
    content: "";
    position: absolute;
    inset: 1rem;
    border-radius: 1.2rem;
    border: 1px solid hsl(0 0% 100% / 0.03);
    pointer-events: none;
  }

  .hero-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 14ch;
  }

  .hero-copy {
    margin: 0;
    max-width: 48ch;
    color: var(--muted);
    font-size: 1.5rem;
    line-height: 1.55;
    text-wrap: pretty;
    text-align: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    width: min(100%, 43rem);
  }

  .landing-status {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.6rem;
    width: min(100%, 64rem);
    margin-inline: auto;
    padding: 0.2rem 0.2rem 0;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    padding-top: 0.3rem;
  }

  .hero-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
    border-radius: 999px;
    background: hsl(0 0% 100% / 0.02);
    color: var(--muted);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-anchor {
    position: relative;
    height: 1px;
    margin-top: -1px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .page-shell {
      padding-top: 0.9rem;
    }

    .page-frame {
      min-height: calc(100svh - 3.6rem);
      gap: 1.2rem;
    }

    .hero-card {
      gap: 1.3rem;
      padding: 1.8rem;
    }

    .hero-copy {
      max-width: 30ch;
      font-size: 1.4rem;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .landing-status {
      width: 100%;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .topbar,
    .hero-card {
      animation: rise 0.45s ease-out both;
    }

    .hero-card {
      animation-delay: 0.05s;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
