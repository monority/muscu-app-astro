---
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import KpiItem from "../components/ui/KpiItem.astro";
import HeroSection from "../components/dashboard/HeroSection.astro";
import WeeklyGoal from "../components/dashboard/WeeklyGoal.astro";
import NextSession from "../components/dashboard/NextSession.astro";
import VolumeTrend from "../components/dashboard/VolumeTrend.astro";
import RecentSessions from "../components/dashboard/RecentSessions.astro";
import { t, localizedPath } from "../i18n";

const L = t();
---

<AppLayout title={L.dashboard.title}>
  <PageHeader 
    title={L.dashboard.title}
    description={L.dashboard.description} 
    actionLabel={L.dashboard.newSession}
    actionHref={localizedPath("/sessions/create")}
  />

  <div class="dash" x-data="dashboardApp()" x-init="init()" x-cloak>
    {/* ── Main dashboard (once training has started) ── */}
    <div x-show="hasSessions">
      <div class="dash__overview dash__signal">
        <HeroSection />
        <WeeklyGoal />
        <NextSession />
      </div>

      {/* ── KPI band ── */}
      <section class="dash__kpis" aria-label={L.dashboard.kpisAria}>
        <KpiItem
          icon="dumbbell"
          label={L.dashboard.totalVolume}
          valueExpr="formatVolume(kpis.totalVolume)"
          unit={L.common.kg}
          class="dash__kpi dash__kpi--volume"
        />
        <KpiItem
          icon="calendar"
          label={L.dashboard.totalSessions}
          valueExpr="kpis.totalSessions"
          unitExpr="kpis.totalSessions === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
          class="dash__kpi dash__kpi--sessions"
        />
        <KpiItem
          icon="award"
          label={L.dashboard.bestPRs}
          valueExpr="kpis.bestPRs"
          unitExpr="kpis.bestPRs === 1 ? labels.exoSingular.trim() : labels.exercisesUnit"
          subExpr="kpis.top1RM > 0 ? labels.top1RM + ' ' + formatVolume(kpis.top1RM) + ' ' + labels.kg : ''"
          class="dash__kpi dash__kpi--pr"
        />
        <KpiItem
          icon="flame"
          label={L.dashboard.streak}
          valueExpr="kpis.streak"
          unitExpr="kpis.streak === 1 ? labels.daysSingular : labels.daysUnit"
          subExpr="kpis.streak === 0 && kpis.totalSessions > 0 ? labels.noRecent : ''"
          class="dash__kpi dash__kpi--streak"
        />
      </section>

      {/* ── Weekly volume trend ── */}
      <VolumeTrend />

      {/* ── Recent sessions ── */}
      <RecentSessions />
    </div>

    {/* ── Empty (first run: no sessions yet) — decorative, no zeros ── */}
    <div class="dash__empty" x-show="!hasSessions">
      <div class="dash__empty-ring" aria-hidden="true">
        <svg viewBox="0 0 100 100" class="dash__empty-ring-svg">
          <circle cx="50" cy="50" r="46" class="dash__empty-ring-track"
          ></circle>
          <circle cx="50" cy="50" r="46" class="dash__empty-ring-fill"></circle>
        </svg>
        <div class="dash__empty-disc">
          <Icon name="dumbbell" size={48} class="dash__empty-dumbbell" />
        </div>
      </div>

      <h2 class="dash__empty-title">{L.dashboard.emptyTitle}</h2>
      <p class="dash__empty-desc">{L.dashboard.emptyDesc}</p>

      <div class="dash__empty-actions">
        <Button variant="primary" size="md" href={localizedPath("/sessions/create")}>
          <Icon name="plus" size={16} />
          <span>{L.dashboard.createFirst}</span>
        </Button>
        <Button variant="secondary" size="md" href={localizedPath("/timer")}>
          <Icon name="clockStopwatch" size={16} />
          <span>{L.dashboard.stopwatch}</span>
        </Button>
        <a href={localizedPath("/exercises")} class="dash__empty-link">
          {L.dashboard.browseExercises}
        </a>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getExercises,
    getSessionsThisWeek,
    getSettings,
    type Session,
  } from "../lib/storage";
  import { t, getLocale, localizedPath } from "../i18n";
  import {
    computeSessionVolume,
    computeTodayVolume,
    computeTodaySessions,
    computeTodayExercises,
    computeTotalVolume,
    computeBestPRs,
    computeTop1RM,
    computeStreak,
    computeWeeklyVolumeByDay,
    computeSessionPrimaryMuscle,
  } from "../lib/dashboard-stats";
  import { formatDateShort } from "../lib/format";

  const LABELS = t();

  const DATE_LOCALE = getLocale() === "fr" ? "fr-FR" : "en-US";

  function formatVolumeNum(volume: number): string {
    if (!Number.isFinite(volume) || volume <= 0) return "0";
    return Math.round(volume).toLocaleString(DATE_LOCALE);
  }

  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data("dashboardApp", () => ({
      // ── State ──
      sessions: [] as Session[],
      settings: getSettings(),
      weeklyDone: 0,
      labels: {
        top1RM: LABELS.dashboard.top1RM,
        weeklyGoalEyebrow: LABELS.dashboard.weeklyGoalEyebrow,
        weeklyGoalDone: LABELS.dashboard.weeklyGoalDone,
        weeklyMoreSingular: LABELS.dashboard.weeklyMoreSingular,
        sessionsUnit: LABELS.dashboard.sessionsUnit,
        exercisesUnit: LABELS.dashboard.exercisesUnit,
        daysUnit: LABELS.dashboard.daysUnit,
        remainingHint: LABELS.dashboard.remainingHint,
        exoPlural: LABELS.dashboard.exoPlural,
        exoSingular: LABELS.dashboard.exoSingular,
        daysSingular: LABELS.dashboard.daysSingular,
        noRecent: LABELS.dashboard.noRecent,
        viewAll: LABELS.dashboard.viewAllArrow,
        recentSessions: LABELS.dashboard.recentSessions,
        kg: LABELS.common.kg,
        todayVolume: LABELS.dashboard.todayVolume,
        weeklyVolumeTrend: LABELS.dashboard.weeklyVolumeTrend,
        noWeeklyVolume: LABELS.dashboard.noWeeklyVolume,
        noWeeklyVolumeHint: LABELS.dashboard.noWeeklyVolumeHint,
        nextSession: LABELS.dashboard.nextSession,
        continueWorkout: LABELS.dashboard.continueWorkout,
        startWorkout: LABELS.dashboard.startWorkout,
        plannedWorkoutHint: LABELS.dashboard.plannedWorkoutHint,
        sessionCount: LABELS.dashboard.sessionCount,
        exerciseCount: LABELS.dashboard.exerciseCount,
      },

      // Expose localizedPath to Alpine expressions (uses window.__LOCALE__).
      localizedPath,

      // ── Init ──
      init() {
        // Seed exercises on first load (side effect).
        getExercises();
        this.sessions = getSessions().sort(
          (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        );
        this.settings = getSettings();
        this.weeklyDone = getSessionsThisWeek().length;
      },

      // ── Derived ──
      get hasSessions(): boolean {
        return this.sessions.length > 0;
      },

      get recentSessions(): Session[] {
        return this.sessions.slice(0, 5);
      },

      get nextSession(): Session | null {
        return (
          this.sessions.find(
            (s) => s.status === "in-progress" || s.status === "planned",
          ) ?? null
        );
      },

      get weeklyProgress(): number {
        const target = this.settings.weeklyGoal;
        if (!Number.isFinite(target) || target <= 0) return 0;
        return Math.min(1, Math.max(0, this.weeklyDone / target));
      },

      // ── Today ──
      get todayVolume(): number {
        return computeTodayVolume(this.sessions);
      },

      get todaySessions(): number {
        return computeTodaySessions(this.sessions);
      },

      get todayExercises(): number {
        return computeTodayExercises(this.sessions);
      },

      // ── Weekly trend ──
      get weeklyVolumeByDay(): number[] {
        return computeWeeklyVolumeByDay(this.sessions);
      },

      get todayIdx(): number {
        return new Date().getDay();
      },

      get weeklyVolumeTotal(): number {
        return this.weeklyVolumeByDay.reduce((sum, volume) => sum + volume, 0);
      },

      get maxVol(): number {
        return Math.max(...this.weeklyVolumeByDay, 1);
      },

      get dayLabels(): string[] {
        return getLocale() === "fr"
          ? ["D", "L", "M", "M", "J", "V", "S"]
          : ["S", "M", "T", "W", "T", "F", "S"];
      },

      // ── KPIs ──
      get kpis() {
        return {
          totalSessions: this.sessions.length,
          totalVolume: computeTotalVolume(this.sessions),
          bestPRs: computeBestPRs(this.sessions),
          top1RM: computeTop1RM(this.sessions),
          streak: computeStreak(this.sessions),
        };
      },

      // ── Goal hint ──
      remainingHintText(): string {
        const remaining = Math.max(
          0,
          this.settings.weeklyGoal - this.weeklyDone,
        );
        const unit =
          remaining === 1
            ? this.labels.weeklyMoreSingular
            : this.labels.sessionsUnit;
        return this.labels.remainingHint
          .replace("{count}", String(remaining))
          .replace("{unit}", unit);
      },

      // ── Per-session ──
      sessionVolume(s: Session): number {
        return computeSessionVolume(s);
      },

      sessionPrimaryMuscle(s: Session): string {
        return computeSessionPrimaryMuscle(s);
      },

      muscleLabel(name: string): string {
        const tr = (window as { trMuscle?: (m: string) => string }).trMuscle;
        return tr ? tr(name) : name;
      },

      // ── Formatters ──
      formatDate(iso: string): string {
        return formatDateShort(iso);
      },

      formatVolume(volume: number): string {
        return formatVolumeNum(volume);
      },
    }));
  });
</script>



<style>
  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .dash {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 8rem;
  }

  /* ════════════════════════════════════════════════════
     OVERVIEW — open metric + one useful grouping
     ════════════════════════════════════════════════════ */
  .dash__overview {
    display: grid;
    gap: 0;
    margin-bottom: 4rem;
  }

  .dash__signal {
    border-top: 1px solid var(--color-border);
  }

  /* ════════════════════════════════════════════════════
     KPI BAND — open data, not four floating cards
     ════════════════════════════════════════════════════ */
  .dash__kpis {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-bottom: 4rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 480px) {
    .dash__kpis {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .dash__kpis {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dash__kpi {
    min-width: 0;
    padding: 2rem 1.6rem;
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: none;
    transition: background-color var(--transition-base);
  }

  .dash__kpi:hover {
    background-color: var(--alpha-bg-subtle);
  }

  @media (min-width: 480px) and (max-width: 1023px) {
    .dash__kpi:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  .dash__kpi:nth-child(even) {
    border-left: 1px solid var(--color-border);
  }

  /* ════════════════════════════════════════════════════
     EMPTY STATE — welcome (no zeros anywhere)
     ════════════════════════════════════════════════════ */
  .dash__empty {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.4rem;
    padding: 4rem 0 6rem;
  }

  .dash__empty-ring {
    position: relative;
    width: 12rem;
    height: 12rem;
    flex-shrink: 0;
  }

  .dash__empty-ring-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    overflow: visible;
  }

  .dash__empty-ring-track {
    fill: none;
    stroke: var(--color-surface-3);
    stroke-width: 6;
  }

  .dash__empty-ring-fill {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 6;
    stroke-linecap: round;
    opacity: 0.25;
    stroke-dasharray: 82 244;
  }

  .dash__empty-disc {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background-color: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
  }

  .dash__empty-dumbbell {
    width: 3.2rem;
    height: 3.2rem;
  }

  .dash__empty-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  .dash__empty-desc {
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 36rem;
    margin: 0;
  }

  .dash__empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  .dash__empty-link {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.8rem;
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    transition: color var(--transition-base);
  }

  .dash__empty-link:hover {
    color: var(--color-text);
  }

  .dash__empty-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (min-width: 760px) {
    .dash__overview {
      grid-template-columns: minmax(0, 1.25fr) minmax(28rem, 0.75fr);
      align-items: stretch;
    }
  }

  @media (min-width: 1024px) {
    .dash__kpi {
      border-bottom: 0;
    }

    .dash__kpi:nth-child(3) {
      border-left: 1px solid var(--color-border);
    }
  }

</style>
