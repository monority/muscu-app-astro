---
export const prerender = false;

import AppLayout from "../layouts/AppLayout.astro";
import SessionHeader from "../components/session/SessionHeader.astro";
import ExercisePicker from "../components/session/ExercisePicker.astro";
import SetForm from "../components/session/SetForm.astro";
import SetHistory from "../components/session/SetHistory.astro";
import EndSessionModal from "../components/session/EndSessionModal.astro";
import Skeleton from "../components/ui/Skeleton.astro";
---

<AppLayout title="SÃ©ance" activeNav="session">
  <div class="session-body" data-session-body>
    <div class="session-loading hidden" data-session-loading>
      <Skeleton width="20rem" height="4.4rem" borderRadius="var(--radius-md)" />
    </div>

    <div data-session-error hidden></div>

    <div class="session-start" data-session-start>
      <button class="session-start-btn" type="button" data-session-create>
        Nouvelle sÃ©ance
      </button>
    </div>

    <div class="session-track" data-session-track hidden>
      <SessionHeader />

      <div class="template-progress" data-template-progress hidden>
        <span data-template-progress-text></span>
        <button class="template-next-btn" type="button" data-template-next hidden>Suivant â†’</button>
      </div>

      <div class="session-card">
        <ExercisePicker />
        <div class="ex-notes-cue hidden" data-ex-notes-cue>
          <span class="ex-notes-cue-label" data-ex-notes-content></span>
        </div>
      </div>

      <div class="session-card" data-rest-timer-container hidden>
        <div class="rest-timer" data-rest-timer>
          <span class="rest-timer-label" data-rest-timer-label>Repos</span>
          <span class="rest-timer-exercise" data-rest-exercise-name></span>
          <div class="rest-timer-display" data-rest-display>00:00</div>
          <div class="rest-timer-bar">
            <div class="rest-timer-bar-inner" data-rest-bar style="width:100%"></div>
          </div>
          <button class="rest-timer-skip" type="button" data-rest-skip>Passer</button>
        </div>
      </div>

      <div class="session-card" data-form-container>
        <SetForm />
      </div>

      <div class="session-card">
        <SetHistory />
      </div>

      <button class="session-end" type="button" data-session-end hidden>
        Terminer la sÃ©ance
      </button>
    </div>
  </div>

  <EndSessionModal />
</AppLayout>

<script>
  import "../scripts/session-page";
</script>


