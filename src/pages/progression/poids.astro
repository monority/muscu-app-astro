---

import { t } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
const L = t();
---

<AppLayout title={L.poids.title}>
  <PageHeader
    title={L.poids.title}
    description={L.poids.description}
  />

  <div
    class="poids"
    x-data="poidsApp()"
    x-init="init()"
    x-cloak
  >
    <Card>
      <CardHeader>
        <CardTitle>{L.poids.newMeasure}</CardTitle>
      </CardHeader>
      <CardContent>
        <form class="poids__form" @submit.prevent="addEntry()">
          <div class="poids__grid">
            <Input
              label={L.poids.date}
              id="poids-date"
              type="date"
              x-model="form.date"
              required
              class="poids__input"
            />
            <Input
              label={L.poids.weightLabel}
              id="poids-weight"
              type="number"
              step="0.1"
              min="20"
              max="300"
              inputmode="decimal"
              x-model.number="form.weight"
              placeholder={L.poids.weightPlaceholder}
              required
              class="poids__input"
            />
            <Input
              label={L.poids.armLabel}
              id="poids-arm"
              type="number"
              step="0.1"
              min="0"
              inputmode="decimal"
              x-model.number="form.arm"
              placeholder="—"
              class="poids__input"
            />
            <Input
              label={L.poids.chestLabel}
              id="poids-chest"
              type="number"
              step="0.1"
              min="0"
              inputmode="decimal"
              x-model.number="form.chest"
              placeholder="—"
              class="poids__input"
            />
            <Input
              label={L.poids.waistLabel}
              id="poids-waist"
              type="number"
              step="0.1"
              min="0"
              inputmode="decimal"
              x-model.number="form.waist"
              placeholder="—"
              class="poids__input"
            />
            <Input
              label={L.poids.hipsLabel}
              id="poids-hips"
              type="number"
              step="0.1"
              min="0"
              inputmode="decimal"
              x-model.number="form.hips"
              placeholder="—"
              class="poids__input"
            />
          </div>

          <p class="poids__error" x-show="formError" x-text="formError" x-cloak x-transition.opacity.duration.180ms role="alert"></p>
          <p class="poids__success" x-show="success" x-text="success" x-cloak x-transition.opacity.duration.180ms role="status" aria-live="polite"></p>

          <div class="poids__actions">
            <Button
              type="button"
              variant="secondary"
              size="md"
              @click="resetForm()"
            >
              {L.common.reset}
            </Button>
            <Button type="submit" variant="primary" size="md">
              {L.poids.save}
            </Button>
          </div>
        </form>
      </CardContent>
    </Card>

    <template x-if="records.length > 0">
      <div class="poids__stats">
        <div class="poids__stat poids__stat--hero">
          <span class="poids__stat-label">{L.poids.latest}</span>
          <div class="poids__stat-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.weight)"></span>
            <span class="poids__stat-unit">{L.common.kg}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="weightDelta < 0 ? 'is-down' : weightDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(weightDelta, 'kg')"
          ></span>
          <span
            class="poids__stat-info"
            x-show="latest && sessionsSinceDate(latest.date) > 0"
            x-text="formatSessionsSince(latest?.date)"
          ></span>
          <span
            class="poids__stat-volume"
            x-show="latest && volumeSinceDate(latest.date) > 0"
            x-text="formatVolume(volumeSinceDate(latest?.date))"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.arm != null">
          <span class="poids__stat-label">{L.poids.armLabel}</span>
          <div class="poids__stat-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.arm)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="armDelta < 0 ? 'is-down' : armDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(armDelta, 'cm')"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.chest != null">
          <span class="poids__stat-label">{L.poids.chestLabel}</span>
          <div class="poids__stat-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.chest)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="chestDelta < 0 ? 'is-down' : chestDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(chestDelta, 'cm')"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.waist != null">
          <span class="poids__stat-label">{L.poids.waistLabel}</span>
          <div class="poids__stat-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.waist)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="waistDelta < 0 ? 'is-down' : waistDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(waistDelta, 'cm')"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.hips != null">
          <span class="poids__stat-label">{L.poids.hipsLabel}</span>
          <div class="poids__stat-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.hips)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="hipsDelta < 0 ? 'is-down' : hipsDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(hipsDelta, 'cm')"
          ></span>
        </div>
      </div>
    </template>

    <Card>
      <CardHeader>
        <div class="poids__chart-header">
          <CardTitle>{L.poids.chartTitle}</CardTitle>
          <span class="poids__record-count" x-show="records.length > 0">
            <span x-text="records.length"></span>
            {L.poids.entrySingular}<span x-show="records.length > 1">s</span>
          </span>
        </div>
      </CardHeader>
      <CardContent>
        <template x-if="records.length === 0">
          <EmptyState
            iconName="scale"
            title={L.poids.empty}
            description={L.poids.addFirst}
          />
        </template>
        <template x-if="records.length > 0">
          <div class="poids__chart-wrap" x-html="renderChart()"></div>
        </template>
      </CardContent>
    </Card>

    <template x-if="records.length > 0">
      <Card>
        <CardHeader>
          <CardTitle>{L.historique.titleShort}</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="poids__table-wrap">
            <table class="poids__table">
              <thead>
                <tr>
                  <th scope="col">{L.poids.date}</th>
                  <th scope="col">{L.poids.sessions}</th>
                  <th scope="col">{L.poids.volume}</th>
                  <th scope="col">{L.poids.weightShort}</th>
                  <th scope="col">{L.poids.armLabel}</th>
                  <th scope="col">{L.poids.chestLabel}</th>
                  <th scope="col">{L.poids.waistLabel}</th>
                  <th scope="col">{L.poids.hipsLabel}</th>
                  <th scope="col" class="poids__table-header-cell--right"></th>
                </tr>
              </thead>
              <tbody>
                <template x-for="(r, i) in [...records].reverse()" :key="i">
                  <tr>
                    <td x-text="formatDate(r.date)"></td>
                    <td class="poids__table-cell" x-text="sessionsSinceDate(r.date)"></td>
                    <td class="poids__table-cell" x-text="formatVolume(volumeSinceDate(r.date))"></td>
                    <td class="poids__table-cell" x-text="formatNumber(r.weight) + ' kg'"></td>
                    <td class="poids__table-cell" x-text="r.arm != null ? formatNumber(r.arm) + ' cm' : '—'"></td>
                    <td class="poids__table-cell" x-text="r.chest != null ? formatNumber(r.chest) + ' cm' : '—'"></td>
                    <td class="poids__table-cell" x-text="r.waist != null ? formatNumber(r.waist) + ' cm' : '—'"></td>
                    <td class="poids__table-cell" x-text="r.hips != null ? formatNumber(r.hips) + ' cm' : '—'"></td>
                    <td class="poids__table-cell--right">
                      <button
                        type="button"
                        class="poids__icon-btn"
                        @click="removeEntry(r.date)"
                        :aria-label="deleteLabel(r.date)"
                        title={L.poids.delete}
                      >
                        <Icon name="trash" size={20} />
                      </button>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getBodyRecords,
    getSessions,
    addBodyRecord,
    deleteBodyRecord,
    type BodyRecord,
    type Session,
  } from '../../lib/storage';

  import { cssVar } from '../../lib/css-var';
  import {
    countCompletedSessionsBetween,
    completedVolumeBetween,
  } from '../../lib/session-utils';

  import { t } from '../../i18n';
  import { formatDateNumeric } from '../../lib/format';
  import { renderWeightChart } from '../../lib/body-chart';

  const LABELS = t();

  interface BodyForm {
    date: string;
    weight: number | null;
    arm: number | null;
    chest: number | null;
    waist: number | null;
    hips: number | null;
  }

  function todayISO(): string {
    return new Date().toISOString().split('T')[0];
  }

  function fmtNum(n: number | null | undefined): string {
    if (n == null || !Number.isFinite(n)) return '—';
    return Math.round(n * 10) / 10 + '';
  }

  function fmtDelta(delta: number | null, unit: string): string {
    if (delta == null || !Number.isFinite(delta) || delta === 0) {
      return '—';
    }
    const sign = delta > 0 ? '+' : '';
    return `${sign}${Math.round(delta * 10) / 10} ${unit} ${LABELS.poids.vsPrev}`;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('poidsApp', () => ({
      records: [] as BodyRecord[],
      sessions: [] as Session[],
      form: {
        date: todayISO(),
        weight: null,
        arm: null,
        chest: null,
        waist: null,
        hips: null,
      } as BodyForm,
      formError: '',
      success: '',

      init() {
        this.refresh();
      },

      refresh() {
        this.records = getBodyRecords();
        this.sessions = getSessions();
      },

      sessionsSinceDate(date: string): number {
        const index = this.records.findIndex((record) => record.date === date);
        const nextDate = index >= 0 ? this.records[index + 1]?.date : undefined;
        return countCompletedSessionsBetween(this.sessions, date, nextDate);
      },

      volumeSinceDate(date: string): number {
        const index = this.records.findIndex((record) => record.date === date);
        const nextDate = index >= 0 ? this.records[index + 1]?.date : undefined;
        return completedVolumeBetween(this.sessions, date, nextDate);
      },

      formatVolume(volume: number): string {
        return `${LABELS.poids.volume} ${Math.round(volume).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US')} kg`;
      },

      formatSessionsSince(date?: string): string {
        const count = date ? this.sessionsSinceDate(date) : 0;
        const label = count === 1 ? LABELS.poids.sessionSince : LABELS.poids.sessionsSince;
        return `${count} ${label}`;
      },

      get latest(): BodyRecord | null {
        return this.records.length > 0 ? this.records[this.records.length - 1] : null;
      },
      get previous(): BodyRecord | null {
        return this.records.length > 1 ? this.records[this.records.length - 2] : null;
      },

      get weightDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        return this.latest.weight - this.previous.weight;
      },
      get armDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.arm == null || this.previous.arm == null) return null;
        return this.latest.arm - this.previous.arm;
      },
      get chestDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.chest == null || this.previous.chest == null) return null;
        return this.latest.chest - this.previous.chest;
      },
      get waistDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.waist == null || this.previous.waist == null) return null;
        return this.latest.waist - this.previous.waist;
      },
      get hipsDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.hips == null || this.previous.hips == null) return null;
        return this.latest.hips - this.previous.hips;
      },

      resetForm() {
        this.form = {
          date: todayISO(),
          weight: null,
          arm: null,
          chest: null,
          waist: null,
          hips: null,
        };
        this.formError = '';
        this.success = '';
      },

      addEntry() {
        this.formError = '';
        this.success = '';

        if (!this.form.date) {
          this.formError = LABELS.poids.dateRequired;
          return;
        }
        if (
          this.form.weight == null ||
          !Number.isFinite(this.form.weight) ||
          this.form.weight <= 0
        ) {
          this.formError = LABELS.poids.weightInvalid;
          return;
        }
        if (this.form.weight < 20 || this.form.weight > 300) {
          this.formError = LABELS.poids.weightInvalid;
          return;
        }

        const record: BodyRecord = {
          date: this.form.date,
          weight: this.form.weight,
        };
        if (this.form.arm != null && Number.isFinite(this.form.arm) && this.form.arm > 0) {
          record.arm = this.form.arm;
        }
        if (this.form.chest != null && Number.isFinite(this.form.chest) && this.form.chest > 0) {
          record.chest = this.form.chest;
        }
        if (this.form.waist != null && Number.isFinite(this.form.waist) && this.form.waist > 0) {
          record.waist = this.form.waist;
        }
        if (this.form.hips != null && Number.isFinite(this.form.hips) && this.form.hips > 0) {
          record.hips = this.form.hips;
        }

        addBodyRecord(record);
        this.refresh();
        this.success = LABELS.poids.saved;
        this.form.weight = null;
        this.form.arm = null;
        this.form.chest = null;
        this.form.waist = null;
        this.form.hips = null;
        setTimeout(() => {
          if (this.success === LABELS.poids.saved) this.success = '';
        }, 3000);
      },

      removeEntry(date: string) {
        if (!window.confirm(LABELS.poids.deleteConfirm)) return;
        deleteBodyRecord(date);
        this.refresh();
      },

      formatNumber(n: number | null | undefined): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return formatDateNumeric(iso);
      },
      deleteLabel(iso: string): string {
        return LABELS.poids.deleteAriaPrefix + formatDateNumeric(iso);
      },
      formatDelta(delta: number | null, unit: string): string {
        return fmtDelta(delta, unit);
      },

      renderChart(): string {
        return renderWeightChart(this.records, {
          cssVar,
          formatDate: formatDateNumeric,
          chartTitle: LABELS.poids.chartTitle,
        });
      },
    }));
  });
</script>

<style is:global>
  .poids {
    padding-bottom: 9.6rem;
    display: flex;
    flex-direction: column;
    gap: 2.0rem;
  }

  .poids__form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .poids__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
    row-gap: 0;
  }

  @media (min-width: 640px) {
    .poids__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .poids__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .poids__input {
    width: 100%;
    height: 4.6rem;
    padding: 0 1.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    -webkit-appearance: none;
    appearance: none;
  }

  .poids__input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .poids__input[type='date'] {
    color-scheme: dark;
  }

  .poids__error {
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 30%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-destructive);
    font-size: 1.2rem;
    font-weight: 500;
    padding: 0.8rem 1.2rem;
    margin: 0;
  }

  .poids__success {
    background-color: color-mix(in srgb, var(--color-success) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-success) 30%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-success);
    font-size: 1.2rem;
    font-weight: 500;
    padding: 0.8rem 1.2rem;
    margin: 0;
  }

  .poids__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .poids__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .poids__stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .poids__stat:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }
  }

  @media (min-width: 960px) {
    .poids__stats {
      grid-template-columns: repeat(5, 1fr);
    }

    .poids__stat + .poids__stat {
      border-left: 1px solid var(--color-border);
    }
  }

  .poids__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    padding: 1.8rem 1.6rem;
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
  }

  .poids__stat--hero {
    grid-column: 1 / -1;
  }

  @media (min-width: 640px) {
    .poids__stat--hero {
      grid-column: auto;
    }

    .poids__stat {
      border-bottom: 0;
    }
  }

  .poids__stat--hero .poids__stat-value {
    font-size: 3rem;
    color: var(--color-accent);
  }

  .poids__stat-label {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    font-weight: 700;
  }

  .poids__stat-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .poids__stat-value {
    font-family: var(--font-display, sans-serif);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .poids__stat-unit {
    font-family: var(--font-body);
    font-size: 1.3rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  .poids__stat-delta {
    font-size: 1.1rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .poids__stat-delta.is-up {
    color: var(--color-accent);
  }

  .poids__stat-delta.is-down {
    color: var(--color-success);
  }

  .poids__stat-info {
    font-size: 1.1rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .poids__stat-volume {
    color: var(--color-accent);
  }

  .poids__chart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  .poids__record-count {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.10em;
    font-weight: 700;
  }

  .poids__chart-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .poids__chart {
    width: 100%;
    height: auto;
    min-height: 24rem;
    display: block;
  }

  .poids__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .poids__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.3rem;
  }

  .poids__table thead th {
    background-color: var(--color-surface-3);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.0rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-align: left;
    padding: 1.0rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .poids__table-header-cell--right {
    text-align: right;
  }

  .poids__table tbody td {
    padding: 0.9rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .poids__table tbody tr:last-child td {
    border-bottom: none;
  }

  .poids__table tbody tr:nth-child(even) {
    background-color: var(--color-surface-2);
  }

  .poids__table-cell {
    font-family: var(--font-display, sans-serif);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--color-text);
  }

  .poids__table-cell--right {
    text-align: right;
    padding: 0.9rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .poids__icon-btn {
    display: inline-flex;
    align-items: center;
