---

import { t } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Button from '../../components/ui/Button.astro';
const L = t();
---

<AppLayout title={L.poids.title}>
  <PageHeader
    title={L.poids.title}
    description={L.poids.description}
  />

  <div
    class="poids"
    x-data="poidsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ═══ Entry form ═══ */}
    <Card>
      <CardHeader>
        <CardTitle>{L.poids.newMeasure}</CardTitle>
      </CardHeader>
      <CardContent>
        <form class="poids__form" @submit.prevent="addEntry()">
          <div class="poids__grid">
            <div class="poids__field">
              <label for="poids-date" class="poids__label">{L.poids.date}</label>
              <input
                id="poids-date"
                type="date"
                class="poids__input"
                x-model="form.date"
                required
              />
            </div>
            <div class="poids__field">
              <label for="poids-weight" class="poids__label">
                {L.poids.weightLabel}
              </label>
              <input
                id="poids-weight"
                type="number"
                class="poids__input"
                step="0.1"
                min="20"
                max="300"
                inputmode="decimal"
                x-model.number="form.weight"
                placeholder={L.poids.weightPlaceholder}
                required
              />
            </div>
            <div class="poids__field">
              <label for="poids-arm" class="poids__label">{L.poids.armLabel}</label>
              <input
                id="poids-arm"
                type="number"
                class="poids__input"
                step="0.1"
                min="0"
                inputmode="decimal"
                x-model.number="form.arm"
                placeholder="—"
              />
            </div>
            <div class="poids__field">
              <label for="poids-chest" class="poids__label">{L.poids.chestLabel}</label>
              <input
                id="poids-chest"
                type="number"
                class="poids__input"
                step="0.1"
                min="0"
                inputmode="decimal"
                x-model.number="form.chest"
                placeholder="—"
              />
            </div>
            <div class="poids__field">
              <label for="poids-waist" class="poids__label">{L.poids.waistLabel}</label>
              <input
                id="poids-waist"
                type="number"
                class="poids__input"
                step="0.1"
                min="0"
                inputmode="decimal"
                x-model.number="form.waist"
                placeholder="—"
              />
            </div>
            <div class="poids__field">
              <label for="poids-hips" class="poids__label">{L.poids.hipsLabel}</label>
              <input
                id="poids-hips"
                type="number"
                class="poids__input"
                step="0.1"
                min="0"
                inputmode="decimal"
                x-model.number="form.hips"
                placeholder="—"
              />
            </div>
          </div>

          <p class="poids__error" x-show="formError" x-text="formError" x-cloak x-transition.opacity.duration.180ms role="alert"></p>
          <p class="poids__success" x-show="success" x-text="success" x-cloak x-transition.opacity.duration.180ms role="status" aria-live="polite"></p>

          <div class="poids__actions">
            <Button
              type="button"
              variant="secondary"
              size="md"
              @click="resetForm()"
            >
              {L.common.reset}
            </Button>
            <Button type="submit" variant="primary" size="md">
              {L.poids.save}
            </Button>
          </div>
        </form>
      </CardContent>
    </Card>

    {/* ═══ Stats grid ═══ */}
    <template x-if="records.length > 0">
      <div class="poids__stats">
        <div class="poids__stat poids__stat--hero">
          <span class="poids__stat-label">{L.poids.latest}</span>
          <div class="poids__stat-value-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.weight)"></span>
            <span class="poids__stat-unit">{L.common.kg}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="weightDelta < 0 ? 'is-down' : weightDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(weightDelta, 'kg')"
          ></span>
          <span
            class="poids__stat-sessions"
            x-show="latest && sessionsSinceDate(latest.date) > 0"
            x-text="formatSessionsSince(latest?.date)"
          ></span>
          <span
            class="poids__stat-volume"
            x-show="latest && volumeSinceDate(latest.date) > 0"
            x-text="formatVolume(volumeSinceDate(latest?.date))"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.arm != null">
          <span class="poids__stat-label">{L.poids.armLabel}</span>
          <div class="poids__stat-value-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.arm)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="armDelta < 0 ? 'is-down' : armDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(armDelta, 'cm')"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.chest != null">
          <span class="poids__stat-label">{L.poids.chestLabel}</span>
          <div class="poids__stat-value-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.chest)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="chestDelta < 0 ? 'is-down' : chestDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(chestDelta, 'cm')"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.waist != null">
          <span class="poids__stat-label">{L.poids.waistLabel}</span>
          <div class="poids__stat-value-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.waist)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="waistDelta < 0 ? 'is-down' : waistDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(waistDelta, 'cm')"
          ></span>
        </div>

        <div class="poids__stat" x-show="latest?.hips != null">
          <span class="poids__stat-label">{L.poids.hipsLabel}</span>
          <div class="poids__stat-value-row">
            <span class="poids__stat-value" x-text="formatNumber(latest?.hips)"></span>
            <span class="poids__stat-unit">{L.poids.unitCm}</span>
          </div>
          <span
            class="poids__stat-delta"
            :class="hipsDelta < 0 ? 'is-down' : hipsDelta > 0 ? 'is-up' : ''"
            x-text="formatDelta(hipsDelta, 'cm')"
          ></span>
        </div>
      </div>
    </template>

    {/* ═══ Weight chart (SVG) ═══ */}
    <Card>
      <CardHeader>
        <div class="poids__chart-head">
          <CardTitle>{L.poids.chartTitle}</CardTitle>
          <span class="poids__chart-meta" x-show="records.length > 0">
            <span x-text="records.length"></span>
            {L.poids.entrySingular}<span x-show="records.length > 1">s</span>
          </span>
        </div>
      </CardHeader>
      <CardContent>
        <template x-if="records.length === 0">
          <EmptyState
            iconName="scale"
            title={L.poids.empty}
            description={L.poids.addFirst}
          />
        </template>
        <template x-if="records.length > 0">
          <div class="poids__chart-wrap" x-html="renderChart()"></div>
        </template>
      </CardContent>
    </Card>

    {/* ═══ History table ═══ */}
    <template x-if="records.length > 0">
      <Card>
        <CardHeader>
          <CardTitle>{L.historique.titleShort}</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="poids__table-wrap">
            <table class="poids__table">
              <thead>
                <tr>
                  <th scope="col">{L.poids.date}</th>
                  <th scope="col">{L.poids.sessions}</th>
                  <th scope="col">{L.poids.volume}</th>
                  <th scope="col">{L.poids.weightShort}</th>
                  <th scope="col">{L.poids.armLabel}</th>
                  <th scope="col">{L.poids.chestLabel}</th>
                  <th scope="col">{L.poids.waistLabel}</th>
                  <th scope="col">{L.poids.hipsLabel}</th>
                  <th scope="col" class="poids__th-end"></th>
                </tr>
              </thead>
              <tbody>
                <template x-for="(r, i) in [...records].reverse()" :key="i">
                  <tr>
                    <td x-text="formatDate(r.date)"></td>
                    <td class="poids__num" x-text="sessionsSinceDate(r.date)"></td>
                    <td class="poids__num" x-text="formatVolume(volumeSinceDate(r.date))"></td>
                    <td class="poids__num" x-text="formatNumber(r.weight) + ' kg'"></td>
                    <td class="poids__num" x-text="r.arm != null ? formatNumber(r.arm) + ' cm' : '—'"></td>
                    <td class="poids__num" x-text="r.chest != null ? formatNumber(r.chest) + ' cm' : '—'"></td>
                    <td class="poids__num" x-text="r.waist != null ? formatNumber(r.waist) + ' cm' : '—'"></td>
                    <td class="poids__num" x-text="r.hips != null ? formatNumber(r.hips) + ' cm' : '—'"></td>
                    <td class="poids__td-end">
                      <button
                        type="button"
                        class="poids__icon-btn"
                        @click="removeEntry(r.date)"
                        :aria-label="deleteLabel(r.date)"
                        title={L.poids.delete}
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                        </svg>
                      </button>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getBodyRecords,
    getSessions,
    addBodyRecord,
    deleteBodyRecord,
    type BodyRecord,
    type Session,
  } from '../../lib/storage';

  import { cssVar } from '../../lib/css-var';
  import {
    countCompletedSessionsBetween,
    completedVolumeBetween,
  } from '../../lib/session-utils';

  import { t, getLocale } from '../../i18n';

  const LABELS = t();

  interface BodyForm {
    date: string;
    weight: number | null;
    arm: number | null;
    chest: number | null;
    waist: number | null;
    hips: number | null;
  }

  function todayISO(): string {
    return new Date().toISOString().split('T')[0];
  }

  function fmtNum(n: number | null | undefined): string {
    if (n == null || !Number.isFinite(n)) return '—';
    return Math.round(n * 10) / 10 + '';
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    });
  }

  function fmtDelta(delta: number | null, unit: string): string {
    if (delta == null || !Number.isFinite(delta) || delta === 0) {
      return '—';
    }
    const sign = delta > 0 ? '+' : '';
    return `${sign}${Math.round(delta * 10) / 10} ${unit} ${LABELS.poids.vsPrev}`;
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('poidsApp', () => ({
      // ── State ──
      records: [] as BodyRecord[],
      sessions: [] as Session[],
      form: {
        date: todayISO(),
        weight: null,
        arm: null,
        chest: null,
        waist: null,
        hips: null,
      } as BodyForm,
      formError: '',
      success: '',

      // ── Init ──
      init() {
        this.refresh();
      },

      // ── Data ──
      refresh() {
        this.records = getBodyRecords();
        this.sessions = getSessions();
      },

      // ── Derived ──
      sessionsSinceDate(date: string): number {
        const index = this.records.findIndex((record) => record.date === date);
        const nextDate = index >= 0 ? this.records[index + 1]?.date : undefined;
        return countCompletedSessionsBetween(this.sessions, date, nextDate);
      },

      volumeSinceDate(date: string): number {
        const index = this.records.findIndex((record) => record.date === date);
        const nextDate = index >= 0 ? this.records[index + 1]?.date : undefined;
        return completedVolumeBetween(this.sessions, date, nextDate);
      },

      formatVolume(volume: number): string {
        return `${LABELS.poids.volume} ${Math.round(volume).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US')} kg`;
      },

      formatSessionsSince(date?: string): string {
        const count = date ? this.sessionsSinceDate(date) : 0;
        const label = count === 1 ? LABELS.poids.sessionSince : LABELS.poids.sessionsSince;
        return `${count} ${label}`;
      },

      get latest(): BodyRecord | null {
        return this.records.length > 0 ? this.records[this.records.length - 1] : null;
      },
      get previous(): BodyRecord | null {
        return this.records.length > 1 ? this.records[this.records.length - 2] : null;
      },

      get weightDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        return this.latest.weight - this.previous.weight;
      },
      get armDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.arm == null || this.previous.arm == null) return null;
        return this.latest.arm - this.previous.arm;
      },
      get chestDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.chest == null || this.previous.chest == null) return null;
        return this.latest.chest - this.previous.chest;
      },
      get waistDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.waist == null || this.previous.waist == null) return null;
        return this.latest.waist - this.previous.waist;
      },
      get hipsDelta(): number | null {
        if (!this.latest || !this.previous) return null;
        if (this.latest.hips == null || this.previous.hips == null) return null;
        return this.latest.hips - this.previous.hips;
      },

      // ── Actions ──
      resetForm() {
        this.form = {
          date: todayISO(),
          weight: null,
          arm: null,
          chest: null,
          waist: null,
          hips: null,
        };
        this.formError = '';
        this.success = '';
      },

      addEntry() {
        this.formError = '';
        this.success = '';

        if (!this.form.date) {
          this.formError = LABELS.poids.dateRequired;
          return;
        }
        if (
          this.form.weight == null ||
          !Number.isFinite(this.form.weight) ||
          this.form.weight <= 0
        ) {
          this.formError = LABELS.poids.weightInvalid;
          return;
        }
        if (this.form.weight < 20 || this.form.weight > 300) {
          this.formError = LABELS.poids.weightInvalid;
          return;
        }

        const record: BodyRecord = {
          date: this.form.date,
          weight: this.form.weight,
        };
        if (this.form.arm != null && Number.isFinite(this.form.arm) && this.form.arm > 0) {
          record.arm = this.form.arm;
        }
        if (this.form.chest != null && Number.isFinite(this.form.chest) && this.form.chest > 0) {
          record.chest = this.form.chest;
        }
        if (this.form.waist != null && Number.isFinite(this.form.waist) && this.form.waist > 0) {
          record.waist = this.form.waist;
        }
        if (this.form.hips != null && Number.isFinite(this.form.hips) && this.form.hips > 0) {
          record.hips = this.form.hips;
        }

        addBodyRecord(record);
        this.refresh();
        this.success = LABELS.poids.saved;
        this.form.weight = null;
        this.form.arm = null;
        this.form.chest = null;
        this.form.waist = null;
        this.form.hips = null;
        setTimeout(() => {
          if (this.success === LABELS.poids.saved) this.success = '';
        }, 3000);
      },

      removeEntry(date: string) {
        if (!window.confirm(LABELS.poids.deleteConfirm)) return;
        deleteBodyRecord(date);
        this.refresh();
      },

      // ── Display helpers ──
      formatNumber(n: number | null | undefined): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return fmtDate(iso);
      },
      deleteLabel(iso: string): string {
        return LABELS.poids.deleteAriaPrefix + fmtDate(iso);
      },
      formatDelta(delta: number | null, unit: string): string {
        return fmtDelta(delta, unit);
      },

      /**
       * Renders an SVG line chart of the weight history. The chart is
       * rebuilt on every call so it always reflects the latest data.
       * Coordinates use a 0..1000 × 0..260 viewBox so it scales cleanly
       * to any container width via preserveAspectRatio.
       */
      renderChart(): string {
        if (this.records.length === 0) return '';
        const W = 1000;
        const H = 260;
        const PAD_L = 50;
        const PAD_R = 30;
        const PAD_T = 30;
        const PAD_B = 50;
        const plotW = W - PAD_L - PAD_R;
        const plotH = H - PAD_T - PAD_B;

        // Chart colors — read from the design tokens so the SVG stays in
        // sync with the current theme (dark/light) without hardcoded hexes.
        const accent = cssVar('--color-accent');
        const bg = cssVar('--color-bg');
        const muted = cssVar('--color-muted');
        const text = cssVar('--color-text');
        const grid = cssVar('--color-border');

        const weights = this.records.map((r) => r.weight);
        let minW = Math.min(...weights);
        let maxW = Math.max(...weights);
        // Add a small padding so the line never touches the chart edges.
        const span = maxW - minW;
        if (span < 1) {
          minW = minW - 0.5;
          maxW = maxW + 0.5;
        } else {
          minW = minW - span * 0.1;
          maxW = maxW + span * 0.1;
        }

        const xAt = (i: number) => {
          if (this.records.length === 1) return PAD_L + plotW / 2;
          return PAD_L + (i / (this.records.length - 1)) * plotW;
        };
        const yAt = (w: number) => {
          if (maxW === minW) return PAD_T + plotH / 2;
          return PAD_T + (1 - (w - minW) / (maxW - minW)) * plotH;
        };

        // Y-axis ticks (4 levels).
        const ticks: number[] = [];
        for (let k = 0; k <= 3; k++) {
          ticks.push(minW + ((maxW - minW) * k) / 3);
        }

        // Build the path.
        const path = this.records
          .map((r, i) => `${i === 0 ? 'M' : 'L'} ${xAt(i).toFixed(1)} ${yAt(r.weight).toFixed(1)}`)
          .join(' ');

        // First/last as accent points.
        const first = this.records[0];
        const last = this.records[this.records.length - 1];

        // X labels: show first, middle, last to avoid clutter.
        const labelIdxs: number[] = [];
        if (this.records.length === 1) {
          labelIdxs.push(0);
        } else {
          labelIdxs.push(0);
          if (this.records.length > 2) {
            labelIdxs.push(Math.floor((this.records.length - 1) / 2));
          }
          labelIdxs.push(this.records.length - 1);
        }

        let svg = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="poids__chart" role="img" aria-label="${LABELS.poids.chartTitle}">`;

        // Background
        svg += `<rect x="0" y="0" width="${W}" height="${H}" fill="transparent"/>`;

        // Grid lines + Y labels
        for (const t of ticks) {
          const y = yAt(t);
          svg += `<line x1="${PAD_L}" y1="${y.toFixed(1)}" x2="${W - PAD_R}" y2="${y.toFixed(1)}" stroke="${grid}" stroke-width="1"/>`;
          svg += `<text x="${PAD_L - 8}" y="${(y + 4).toFixed(1)}" font-size="14" fill="${muted}" text-anchor="end" font-family="var(--font-display, sans-serif)">${Math.round(t * 10) / 10}</text>`;
        }

        // Area under the line
        const areaPath =
          `M ${xAt(0).toFixed(1)} ${(H - PAD_B).toFixed(1)} ` +
          this.records
            .map((r, i) => `L ${xAt(i).toFixed(1)} ${yAt(r.weight).toFixed(1)}`)
            .join(' ') +
          ` L ${xAt(this.records.length - 1).toFixed(1)} ${(H - PAD_B).toFixed(1)} Z`;
        svg += `<defs><linearGradient id="poids-grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${accent}" stop-opacity="0.35"/><stop offset="100%" stop-color="${accent}" stop-opacity="0"/></linearGradient></defs>`;
        svg += `<path d="${areaPath}" fill="url(#poids-grad)"/>`;

        // Line
        svg += `<path d="${path}" fill="none" stroke="${accent}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>`;

        // First / last accent dots
        svg += `<circle cx="${xAt(0).toFixed(1)}" cy="${yAt(first.weight).toFixed(1)}" r="5" fill="${accent}" stroke="${bg}" stroke-width="2"/>`;
        svg += `<circle cx="${xAt(this.records.length - 1).toFixed(1)}" cy="${yAt(last.weight).toFixed(1)}" r="6" fill="${accent}" stroke="${bg}" stroke-width="2"/>`;

        // X labels
        for (const i of labelIdxs) {
          const r = this.records[i];
          svg += `<text x="${xAt(i).toFixed(1)}" y="${(H - PAD_B + 24).toFixed(1)}" font-size="14" fill="${muted}" text-anchor="middle" font-family="var(--font-body, sans-serif)">${fmtDate(r.date)}</text>`;
        }

        // Min / max labels on the right of first/last dots
        svg += `<text x="${(xAt(0) - 12).toFixed(1)}" y="${(yAt(first.weight) + 4).toFixed(1)}" font-size="14" font-weight="700" fill="${text}" text-anchor="end" font-family="var(--font-display, sans-serif)">${Math.round(first.weight * 10) / 10} kg</text>`;
        svg += `<text x="${(xAt(this.records.length - 1) + 12).toFixed(1)}" y="${(yAt(last.weight) + 4).toFixed(1)}" font-size="14" font-weight="700" fill="${text}" text-anchor="start" font-family="var(--font-display, sans-serif)">${Math.round(last.weight * 10) / 10} kg</text>`;

        svg += `</svg>`;
        return svg;
      },
    }));
  });
</script>

<style>
  .poids {
    max-width: 88rem;
    margin: 0 auto;
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

