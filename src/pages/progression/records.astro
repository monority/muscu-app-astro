---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.records.title}>
  <PageHeader
    title={L.records.titlePage}
    description={L.records.description}
  />

  <div
    class="rec"
    x-data="recordsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Stats bar ── */}
    <template x-if="totalPRs > 0 || hasData">
      <div class="rec__stats">
        <div class="rec__stat rec__stat--hero">
          <span class="rec__stat-label">{L.records.best1RMGlobal}</span>
          <div class="rec__stat-value-row">
            <span class="rec__stat-value" x-text="formatNumber(bestOverall1RM)"></span>
            <span class="rec__stat-unit">{L.common.kg}</span>
          </div>
          <span class="rec__stat-foot" x-text="bestOverallExercise ? labels.on + bestOverallExercise : '—'"></span>
        </div>

        <div class="rec__stat">
          <span class="rec__stat-label">{L.records.totalPRs}</span>
          <div class="rec__stat-value-row">
            <span class="rec__stat-value" x-text="totalPRs"></span>
            <span class="rec__stat-unit">PR</span>
          </div>
          <span class="rec__stat-foot" x-text="totalPRs > 1 ? labels.exercisesTracked : labels.exerciseTracked"></span>
        </div>

        <div class="rec__stat">
          <span class="rec__stat-label">{L.records.recentPRs}</span>
          <div class="rec__stat-value-row">
            <span class="rec__stat-value" x-text="recentPRs"></span>
            <span class="rec__stat-unit">PR</span>
          </div>
          <span class="rec__stat-foot">{L.records.since30Days}</span>
        </div>
      </div>
    </template>

    {/* ── Toolbar: search + sort ── */}
    <template x-if="allRecords.length > 0">
      <div class="rec__toolbar">
        <label class="rec__search">
          <Fragment set:html={icons.searchLine(20, 20)} />
          <input
            type="search"
            class="rec__search-input"
            placeholder={L.records.searchPlaceholder}
            x-model="search"
            aria-label={L.records.searchAria}
          />
        </label>

        <div class="rec__sort">
          <span class="rec__sort-label">{L.records.sortLabel}</span>
          <div class="rec__sort-group" role="radiogroup" aria-label={L.records.sortAria}>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'rm' }"
              @click="sortBy = 'rm'"
              role="radio"
              :aria-checked="sortBy === 'rm'"
            >
              {L.records.sortRM}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'name' }"
              @click="sortBy = 'name'"
              role="radio"
              :aria-checked="sortBy === 'name'"
            >
              {L.records.sortName}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'recent' }"
              @click="sortBy = 'recent'"
              role="radio"
              :aria-checked="sortBy === 'recent'"
            >
              {L.records.sortRecent}
            </button>
          </div>
        </div>
      </div>
    </template>

    {/* ── Records list ── */}
    <template x-if="filteredRecords.length > 0">
      <div class="rec__list">
        <template x-for="rec in filteredRecords" :key="rec.exerciseId">
          <a
            class="rec__card"
            :href="historyHref(rec.exerciseId)"
            :aria-label="labels.viewHistoryAriaPrefix + rec.name"
          >
            <div class="rec__card-icon" aria-hidden="true">
              <Fragment set:html={icons.dumbbellBox(24, 24)} />
            </div>

            <div class="rec__card-main">
              <div class="rec__card-head">
                <h3 class="rec__card-name" x-text="trExercise(rec.name)"></h3>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(rec.muscle)"
                  x-text="trMuscle(rec.muscle)"
                ></Badge>
              </div>

              <div class="rec__card-stats">
                <div class="rec__card-stat rec__card-stat--hero">
                  <span class="rec__card-stat-label">{L.records.sortRM}</span>
                  <span class="rec__card-stat-value" x-text="formatNumber(rec.estimated1RM) + ' ' + labels.kg"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestWeight}</span>
                  <span class="rec__card-stat-value" x-text="formatNumber(rec.bestWeight) + ' ' + labels.kg"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestReps}</span>
                  <span class="rec__card-stat-value" x-text="rec.bestReps"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.sessions}</span>
                  <span class="rec__card-stat-value" x-text="rec.sessionCount"></span>
                </div>
              </div>
            </div>

            <div class="rec__card-side">
              <span class="rec__card-date-label">{L.records.lastSession}</span>
              <span class="rec__card-date" x-text="formatDate(rec.lastSessionDate)"></span>
              <span class="rec__card-date rec__card-date--pr">{L.records.prDate} <span x-text="formatDate(rec.date)"></span></span>
              <span class="rec__card-cta" aria-hidden="true">
                <Fragment set:html={icons.chevronRight(16, 16)} />
              </span>
            </div>
          </a>
        </template>
      </div>
    </template>

    {/* ── Empty: no data at all ── */}
    <template x-if="allRecords.length === 0 && !hasData">
      <div class="rec__empty">
        <EmptyState
          iconName="chart"
          title={L.records.noRecords}
          description={L.records.noRecordsDesc}
          actionLabel={L.common.startSession}
          actionHref={localizedPath("/seances/creer")}
        />
      </div>
    </template>

    {/* ── Empty: search returned nothing ── */}
    <template x-if="allRecords.length > 0 && filteredRecords.length === 0">
      <div class="rec__empty">
        <EmptyState
          iconName="chart"
          title={L.records.noResult}
          description={L.records.noResultDesc}
        />
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type SessionExercise,
    type ProgressRecord,
  } from '../../lib/storage';

  import { t, getLocale, localizedPath } from '../../i18n';

  const LABELS = t();

  /**
   * Per-exercise record. Mirrors the progression page's data shape so the
   * computation logic stays consistent and easy to compare.
   */
  interface ExerciseRecord {
    exerciseId: string;
    name: string;
    muscle: string;
    estimated1RM: number;
    bestWeight: number;
    bestReps: number;
    date: string;
    lastSessionDate: string;
    sessionCount: number;
  }

  type SortMode = 'rm' | 'name' | 'recent';

  function fmtNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US');
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('recordsApp', () => ({
      // ── Labels ──
      labels: {
        on: LABELS.records.on,
        exercisesTracked: LABELS.records.exercisesTracked,
        exerciseTracked: LABELS.records.exerciseTracked,
        kg: LABELS.common.kg,
        viewHistoryAriaPrefix: LABELS.records.viewHistoryAriaPrefix,
      },

      // ── State ──
      allRecords: [] as ExerciseRecord[],
      search: '',
      sortBy: 'rm' as SortMode,
      hasData: false,

      // ── Init ──
      init() {
        this.recompute();
      },

      // ── Derived ──
      get totalPRs(): number {
        return this.allRecords.length;
      },

      get bestOverall1RM(): number {
        let max = 0;
        for (const r of this.allRecords) {
          if (r.estimated1RM > max) max = r.estimated1RM;
        }
        return max;
      },

      get bestOverallExercise(): string {
        for (const r of this.allRecords) {
          if (r.estimated1RM === this.bestOverall1RM) return r.name;
        }
        return '';
      },

      get recentPRs(): number {
        // 30-day window — anchored on the current local time, matching
        // the dashboard's "this week" semantics.
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - 30);
        cutoff.setHours(0, 0, 0, 0);
        let count = 0;
        for (const r of this.allRecords) {
          if (!r.date) continue;
          const d = new Date(r.date);
          if (!isNaN(d.getTime()) && d >= cutoff) count += 1;
        }
        return count;
      },

      get filteredRecords(): ExerciseRecord[] {
        const term = this.search.trim().toLowerCase();
        const list = term
          ? this.allRecords.filter(
              (r) =>
                r.name.toLowerCase().includes(term) ||
                r.muscle.toLowerCase().includes(term),
            )
          : this.allRecords.slice();

        switch (this.sortBy) {
          case 'name':
            return list.sort((a, b) =>
              a.name.localeCompare(b.name, 'fr', { sensitivity: 'base' }),
            );
          case 'recent':
            return list.sort(
              (a, b) =>
                new Date(b.date || 0).getTime() -
                new Date(a.date || 0).getTime(),
            );
          case 'rm':
          default:
            return list.sort((a, b) => b.estimated1RM - a.estimated1RM);
        }
      },

      // ── Computations ──
      recompute() {
        const sessions = getSessions();
        this.hasData = sessions.some((session) =>
          session.exercises.some((ex) => ex.sets.some((set) => set.completed)),
        );
        if (!this.hasData) {
          this.allRecords = [];
          return;
        }

        const map = new Map<string, ExerciseRecord>();

        for (const session of sessions) {
          for (const ex of session.exercises) {
            this.accumulate(map, ex, session.date);
          }
        }

        this.allRecords = Array.from(map.values()).filter(
          (record) => record.estimated1RM > 0,
        );
        this.hasData = this.allRecords.length > 0;
      },

      accumulate(
        map: Map<string, ExerciseRecord>,
        ex: SessionExercise,
        sessionDate: string,
      ) {
        let rec = map.get(ex.exerciseId);
        if (!rec) {
          rec = {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            estimated1RM: 0,
            bestWeight: 0,
            bestReps: 0,
            date: '',
            lastSessionDate: '',
            sessionCount: 0,
          };
          map.set(ex.exerciseId, rec);
        }
        let trackedInSession = false;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          trackedInSession = true;
          const rm: ProgressRecord = {
            exerciseId: ex.exerciseId,
            date: sessionDate,
            estimated1RM: calculate1RM(set.weight, set.reps),
            bestWeight: set.weight,
            bestReps: set.reps,
          };
          if (rm.estimated1RM > rec.estimated1RM) {
            rec.estimated1RM = rm.estimated1RM;
            rec.bestWeight = rm.bestWeight;
            rec.bestReps = rm.bestReps;
            rec.date = rm.date;
          }
        }
        // A session counts only when this exercise has at least one
        // completed set. Planned or untouched sessions must not inflate
        // the "sessions" figure on a record.
        if (trackedInSession) {
          rec.sessionCount += 1;
          if (!rec.lastSessionDate || sessionDate > rec.lastSessionDate) {
            rec.lastSessionDate = sessionDate;
          }
        }
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return fmtDate(iso);
      },

      historyHref(id: string): string {
        return localizedPath('/exercices/historique?id=' + encodeURIComponent(id));
      },
    }));
  });
</script>

<style>
  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .rec {
    max-width: 88rem;
    margin: 0 auto;
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     STATS BAR
     ════════════════════════════════════════════════════ */
  .rec__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 640px) {
    .rec__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rec__stats {
    grid-template-columns: 1.4fr 0.8fr 0.8fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .rec__stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: 1.6rem 1.8rem;
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
  }

  @media (min-width: 640px) {
    .rec__stat {
      border-bottom: 0;
    }

    .rec__stat + .rec__stat {
      border-left: 1px solid var(--color-border);
    }
  }

  .rec__stat--hero {
    background-color: transparent;
  }

  .rec__stat-label {
    font-size: 1.0rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    font-weight: 700;
  }

  .rec__stat-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .rec__stat-value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .rec__stat--hero .rec__stat-value {
    font-size: 3rem;
    color: var(--color-accent);
  }

  .rec__stat-unit {
    font-family: var(--font-body);
    font-size: 1.3rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  .rec__stat-foot {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: capitalize;
  }

  /* ════════════════════════════════════════════════════
     TOOLBAR — search + sort
     ════════════════════════════════════════════════════ */
  .rec__toolbar {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.4rem 0;
    background-color: transparent;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .rec__toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.6rem;
    }
  }

  .rec__search {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 auto;
    min-width: 0;
    height: 4.4rem;
    padding: 0 1.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .rec__search:focus-within {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .rec__search-icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .rec__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
  }

  .rec__search-input::placeholder {
    color: var(--color-muted);
  }

  /* Strip the native search clear button to keep visual control. */
  .rec__search-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .rec__sort {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .rec__sort-label {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    font-weight: 700;
    color: var(--color-muted);
  }

  .rec__sort-group {
    display: inline-flex;
    padding: 0.3rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    gap: 0.2rem;
  }

  .rec__sort-btn {
    height: 4.4rem;
    padding: 0 1.2rem;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                color var(--transition-fast);
  }

  .rec__sort-btn:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-subtle);
  }

  .rec__sort-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .rec__sort-btn--active {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .rec__sort-btn--active:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-accent-foreground);
  }

  /* ════════════════════════════════════════════════════
     LIST
     ════════════════════════════════════════════════════ */
  .rec__list {
    display: flex;
    flex-direction: column;
  }

  /* ════════════════════════════════════════════════════
     RECORD — open performance row
     ════════════════════════════════════════════════════ */
  .rec__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.4rem;
    padding: 2rem 0;
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-normal),
                color var(--transition-normal);
  }

  .rec__card:hover {
    background-color: var(--alpha-bg-subtle);
    color: inherit;
  }

  .rec__card:focus-visible {
    outline: 0;
    box-shadow: var(--focus-ring);
  }

  .rec__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    background-color: transparent;
    color: var(--color-accent);
    border-right: 1px solid var(--color-border);
    padding-right: 1rem;
    flex-shrink: 0;
  }

  .rec__card-icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .rec__card-main {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 0;
  }

  .rec__card-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rec__card-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    word-break: break-word;
  }

  .rec__card-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1.2rem;
  }

  @media (min-width: 540px) {
    .rec__card-stats {
      grid-template-columns: repeat(4, auto);
    }
  }

  .rec__card-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 5.2rem;
  }

  .rec__card-stat-label {
    font-size: 1.0rem;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--color-muted);
    font-weight: 700;
  }

  .rec__card-stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .rec__card-stat--hero .rec__card-stat-value {
    color: var(--color-accent);
  }

  .rec__card-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .rec__card-date-label {
    color: var(--color-muted);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rec__card-date {
    font-size: 1.2rem;
    color: var(--color-text);
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }

  .rec__card-date--pr {
    color: var(--color-muted);
    font-size: 1rem;
    font-weight: 500;
  }

  .rec__card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--color-muted);
    transition: color var(--transition-fast),
                transform var(--transition-fast);
  }

  .rec__card:hover .rec__card-cta {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .rec__card-cta svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     EMPTY
     ════════════════════════════════════════════════════ */
  .rec__empty {
    padding: 2.4rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* ════════════════════════════════════════════════════
     RESPONSIVE
     ════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    .rec__stats { grid-template-columns: 1fr; }
    .rec__card {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "icon side"
        "main main";
      gap: 1rem;
    }

    .rec__card-icon {
      grid-area: icon;
      width: 3.2rem;
      height: 3.8rem;
    }

    .rec__card-icon svg {
      width: 2rem;
      height: 2rem;
    }

    .rec__card-main {
