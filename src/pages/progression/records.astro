---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.records.title}>
  <PageHeader
    title={L.records.titlePage}
    description={L.records.description}
  />

  <div
    class="rec pb-24 flex flex-col gap-4"
    x-data="recordsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Stats bar ── */}
    <template x-if="totalPRs > 0 || hasData">
      <div class="rec__stats grid grid-cols-1 gap-3">
        <div class="rec__stat rec__stat--hero flex flex-col gap-1.5 min-w-0 px-4 py-[1.6rem] bg-transparent border-0 border-b border-[var(--color-border)] rounded-none">
          <span class="rec__stat-label text-sm uppercase tracking-[0.14em] text-[var(--color-muted)] font-bold">{L.records.best1RMGlobal}</span>
          <div class="rec__stat-value-row flex items-baseline gap-1">
            <span class="rec__stat-value text-display text-[2.6rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatNumber(bestOverall1RM)"></span>
            <span class="rec__stat-unit font-[var(--font-body)] text-[1.3rem] text-[var(--color-muted)] font-semibold">{L.common.kg}</span>
          </div>
          <span class="rec__stat-foot text-[1.1rem] text-[var(--color-muted)] capitalize" x-text="bestOverallExercise ? labels.on + bestOverallExercise : '—'"></span>
        </div>

        <div class="rec__stat flex flex-col gap-1.5 min-w-0 px-4 py-[1.6rem] bg-transparent border-0 border-b border-[var(--color-border)] rounded-none">
          <span class="rec__stat-label text-sm uppercase tracking-[0.14em] text-[var(--color-muted)] font-bold">{L.records.totalPRs}</span>
          <div class="rec__stat-value-row flex items-baseline gap-1">
            <span class="rec__stat-value text-display text-[2.6rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="totalPRs"></span>
            <span class="rec__stat-unit font-[var(--font-body)] text-[1.3rem] text-[var(--color-muted)] font-semibold">PR</span>
          </div>
          <span class="rec__stat-foot text-[1.1rem] text-[var(--color-muted)] capitalize" x-text="totalPRs > 1 ? labels.exercisesTracked : labels.exerciseTracked"></span>
        </div>

        <div class="rec__stat flex flex-col gap-1.5 min-w-0 px-4 py-[1.6rem] bg-transparent border-0 border-b border-[var(--color-border)] rounded-none">
          <span class="rec__stat-label text-sm uppercase tracking-[0.14em] text-[var(--color-muted)] font-bold">{L.records.recentPRs}</span>
          <div class="rec__stat-value-row flex items-baseline gap-1">
            <span class="rec__stat-value text-display text-[2.6rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="recentPRs"></span>
            <span class="rec__stat-unit font-[var(--font-body)] text-[1.3rem] text-[var(--color-muted)] font-semibold">PR</span>
          </div>
          <span class="rec__stat-foot text-[1.1rem] text-[var(--color-muted)] capitalize">{L.records.since30Days}</span>
        </div>
      </div>
    </template>

    {/* ── Toolbar: search + sort ── */}
    <template x-if="allRecords.length > 0">
      <div class="rec__toolbar flex flex-col gap-3 py-3.5 bg-transparent border-b border-[var(--color-border)]">
        <label class="rec__search inline-flex items-center gap-1.5 flex-1 min-w-0 h-11 px-3 bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-md)] transition-[border-color,box-shadow] duration-[var(--transition-fast)]">
          <Fragment set:html={icons.searchLine(20, 20)} />
          <input
            type="search"
            class="rec__search-input flex-1 min-w-full h-full bg-transparent border-0 outline-0 text-[var(--color-text)] font-[var(--font-body)] text-[1.4rem]"
            placeholder={L.records.searchPlaceholder}
            x-model="search"
            aria-label={L.records.searchAria}
          />
        </label>

        <div class="rec__sort inline-flex items-center gap-2.5 shrink-0">
          <span class="rec__sort-label text-[1.1rem] uppercase tracking-[0.10em] font-bold text-[var(--color-muted)]">{L.records.sortLabel}</span>
          <div class="rec__sort-group inline-flex p-[0.3rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-md)] gap-0.5" role="radiogroup" aria-label={L.records.sortAria}>
            <button
              type="button"
              class="rec__sort-btn h-11 px-3 bg-transparent border-0 rounded-[var(--radius-sm)] text-[var(--color-muted)] font-[var(--font-body)] text-[1.2rem] font-bold cursor-pointer transition-[background-color,color] duration-[var(--transition-fast)]"
              :class="{ 'rec__sort-btn--active': sortBy === 'rm' }"
              @click="sortBy = 'rm'"
              role="radio"
              :aria-checked="sortBy === 'rm'"
            >
              {L.records.sortRM}
            </button>
            <button
              type="button"
              class="rec__sort-btn h-11 px-3 bg-transparent border-0 rounded-[var(--radius-sm)] text-[var(--color-muted)] font-[var(--font-body)] text-[1.2rem] font-bold cursor-pointer transition-[background-color,color] duration-[var(--transition-fast)]"
              :class="{ 'rec__sort-btn--active': sortBy === 'name' }"
              @click="sortBy = 'name'"
              role="radio"
              :aria-checked="sortBy === 'name'"
            >
              {L.records.sortName}
            </button>
            <button
              type="button"
              class="rec__sort-btn h-11 px-3 bg-transparent border-0 rounded-[var(--radius-sm)] text-[var(--color-muted)] font-[var(--font-body)] text-[1.2rem] font-bold cursor-pointer transition-[background-color,color] duration-[var(--transition-fast)]"
              :class="{ 'rec__sort-btn--active': sortBy === 'recent' }"
              @click="sortBy = 'recent'"
              role="radio"
              :aria-checked="sortBy === 'recent'"
            >
              {L.records.sortRecent}
            </button>
          </div>
        </div>
      </div>
    </template>

    {/* ── Records list ── */}
    <template x-if="filteredRecords.length > 0">
      <div class="rec__list flex flex-col">
        <template x-for="rec in filteredRecords" :key="rec.exerciseId">
          <a
            class="rec__card grid grid-cols-[auto_1fr_auto] items-center gap-3.5 py-5 bg-transparent border-0 border-b border-[var(--color-border)] rounded-none no-underline text-inherit transition-[background-color,color] duration-[var(--transition-normal)]"
            :href="historyHref(rec.exerciseId)"
            :aria-label="labels.viewHistoryAriaPrefix + rec.name"
          >
            <div class="rec__card-icon inline-flex items-center justify-center w-8 h-8 bg-transparent text-[var(--color-accent)] border-r border-[var(--color-border)] pr-2.5 shrink-0" aria-hidden="true">
              <Fragment set:html={icons.dumbbellBox(24, 24)} />
            </div>

            <div class="rec__card-main flex flex-col gap-2 min-w-0">
              <div class="rec__card-head flex items-center gap-2.5 flex-wrap">
                <h3 class="rec__card-name text-display text-[1.7rem] font-bold leading-[1.2] text-[var(--color-text)] m-0 break-words" x-text="trExercise(rec.name)"></h3>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(rec.muscle)"
                  x-text="trMuscle(rec.muscle)"
                ></Badge>
              </div>

              <div class="rec__card-stats grid grid-cols-2 gap-1.5 gap-x-3">
                <div class="rec__card-stat rec__card-stat--hero flex flex-col gap-0.5 min-w-[5.2rem]">
                  <span class="rec__card-stat-label text-sm uppercase tracking-[0.10em] text-[var(--color-muted)] font-bold">{L.records.sortRM}</span>
                  <span class="rec__card-stat-value text-display text-[1.5rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatNumber(rec.estimated1RM) + ' ' + labels.kg"></span>
                </div>
                <div class="rec__card-stat flex flex-col gap-0.5 min-w-[5.2rem]">
                  <span class="rec__card-stat-label text-sm uppercase tracking-[0.10em] text-[var(--color-muted)] font-bold">{L.records.bestWeight}</span>
                  <span class="rec__card-stat-value text-display text-[1.5rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatNumber(rec.bestWeight) + ' ' + labels.kg"></span>
                </div>
                <div class="rec__card-stat flex flex-col gap-0.5 min-w-[5.2rem]">
                  <span class="rec__card-stat-label text-sm uppercase tracking-[0.10em] text-[var(--color-muted)] font-bold">{L.records.bestReps}</span>
                  <span class="rec__card-stat-value text-display text-[1.5rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="rec.bestReps"></span>
                </div>
                <div class="rec__card-stat flex flex-col gap-0.5 min-w-[5.2rem]">
                  <span class="rec__card-stat-label text-sm uppercase tracking-[0.10em] text-[var(--color-muted)] font-bold">{L.records.sessions}</span>
                  <span class="rec__card-stat-value text-display text-[1.5rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="rec.sessionCount"></span>
                </div>
              </div>
            </div>

            <div class="rec__card-side flex flex-col items-end gap-1.5 shrink-0">
              <span class="rec__card-date-label text-[var(--color-muted)] text-sm font-bold tracking-[0.08em] uppercase">{L.records.lastSession}</span>
              <span class="rec__card-date text-[1.2rem] text-[var(--color-text)] font-bold text-right whitespace-nowrap" x-text="formatDate(rec.lastSessionDate)"></span>
              <span class="rec__card-date rec__card-date--pr text-[var(--color-muted)] text-sm font-medium">{L.records.prDate} <span x-text="formatDate(rec.date)"></span></span>
              <span class="rec__card-cta inline-flex items-center justify-center w-[2.6rem] h-[2.6rem] text-[var(--color-muted)] transition-[color,transform] duration-[var(--transition-fast)]" aria-hidden="true">
                <Fragment set:html={icons.chevronRight(16, 16)} />
              </span>
            </div>
          </a>
        </template>
      </div>
    </template>

    {/* ── Empty: no data at all ── */}
    <template x-if="allRecords.length === 0 && !hasData">
      <div class="rec__empty py-6 border-t border-[var(--color-border)] border-b border-[var(--color-border)]">
        <EmptyState
          iconName="chart"
          title={L.records.noRecords}
          description={L.records.noRecordsDesc}
          actionLabel={L.common.startSession}
          actionHref={localizedPath("/sessions/create")}
        />
      </div>
    </template>

    {/* ── Empty: search returned nothing ── */}
    <template x-if="allRecords.length > 0 && filteredRecords.length === 0">
      <div class="rec__empty py-6 border-t border-[var(--color-border)] border-b border-[var(--color-border)]">
        <EmptyState
          iconName="chart"
          title={L.records.noResult}
          description={L.records.noResultDesc}
        />
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type SessionExercise,
    type ProgressRecord,
  } from '../../lib/storage';

  import { t, getLocale, localizedPath } from '../../i18n';

  const LABELS = t();

  /**
   * Per-exercise record. Mirrors the progression page's data shape so the
   * computation logic stays consistent and easy to compare.
   */
  interface ExerciseRecord {
    exerciseId: string;
    name: string;
    muscle: string;
    estimated1RM: number;
    bestWeight: number;
    bestReps: number;
    date: string;
    lastSessionDate: string;
    sessionCount: number;
  }

  type SortMode = 'rm' | 'name' | 'recent';

  function fmtNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US');
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('recordsApp', () => ({
      // ── Labels ──
      labels: {
        on: LABELS.records.on,
        exercisesTracked: LABELS.records.exercisesTracked,
        exerciseTracked: LABELS.records.exerciseTracked,
        kg: LABELS.common.kg,
        viewHistoryAriaPrefix: LABELS.records.viewHistoryAriaPrefix,
      },

      // ── State ──
      allRecords: [] as ExerciseRecord[],
      search: '',
      sortBy: 'rm' as SortMode,
      hasData: false,

      // ── Init ──
      init() {
        this.recompute();
      },

      // ── Derived ──
      get totalPRs(): number {
        return this.allRecords.length;
      },

      get bestOverall1RM(): number {
        let max = 0;
        for (const r of this.allRecords) {
          if (r.estimated1RM > max) max = r.estimated1RM;
        }
        return max;
      },

      get bestOverallExercise(): string {
        for (const r of this.allRecords) {
          if (r.estimated1RM === this.bestOverall1RM) return r.name;
        }
        return '';
      },

      get recentPRs(): number {
        // 30-day window — anchored on the current local time, matching
        // the dashboard's "this week" semantics.
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - 30);
        cutoff.setHours(0, 0, 0, 0);
        let count = 0;
        for (const r of this.allRecords) {
          if (!r.date) continue;
          const d = new Date(r.date);
          if (!isNaN(d.getTime()) && d >= cutoff) count += 1;
        }
        return count;
      },

      get filteredRecords(): ExerciseRecord[] {
        const term = this.search.trim().toLowerCase();
        const list = term
          ? this.allRecords.filter(
              (r) =>
                r.name.toLowerCase().includes(term) ||
                r.muscle.toLowerCase().includes(term),
            )
          : this.allRecords.slice();

        switch (this.sortBy) {
          case 'name':
            return list.sort((a, b) =>
              a.name.localeCompare(b.name, 'fr', { sensitivity: 'base' }),
            );
          case 'recent':
            return list.sort(
              (a, b) =>
                new Date(b.date || 0).getTime() -
                new Date(a.date || 0).getTime(),
            );
          case 'rm':
          default:
            return list.sort((a, b) => b.estimated1RM - a.estimated1RM);
        }
      },

      // ── Computations ──
      recompute() {
        const sessions = getSessions();
        this.hasData = sessions.some((session) =>
          session.exercises.some((ex) => ex.sets.some((set) => set.completed)),
        );
        if (!this.hasData) {
          this.allRecords = [];
          return;
        }

        const map = new Map<string, ExerciseRecord>();

        for (const session of sessions) {
          for (const ex of session.exercises) {
            this.accumulate(map, ex, session.date);
          }
        }

        this.allRecords = Array.from(map.values()).filter(
          (record) => record.estimated1RM > 0,
        );
        this.hasData = this.allRecords.length > 0;
      },

      accumulate(
        map: Map<string, ExerciseRecord>,
        ex: SessionExercise,
        sessionDate: string,
      ) {
        let rec = map.get(ex.exerciseId);
        if (!rec) {
          rec = {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            estimated1RM: 0,
            bestWeight: 0,
            bestReps: 0,
            date: '',
            lastSessionDate: '',
            sessionCount: 0,
          };
          map.set(ex.exerciseId, rec);
        }
        let trackedInSession = false;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          trackedInSession = true;
          const rm: ProgressRecord = {
            exerciseId: ex.exerciseId,
            date: sessionDate,
            estimated1RM: calculate1RM(set.weight, set.reps),
            bestWeight: set.weight,
            bestReps: set.reps,
          };
          if (rm.estimated1RM > rec.estimated1RM) {
            rec.estimated1RM = rm.estimated1RM;
            rec.bestWeight = rm.bestWeight;
            rec.bestReps = rm.bestReps;
            rec.date = rm.date;
          }
        }
        // A session counts only when this exercise has at least one
        // completed set. Planned or untouched sessions must not inflate
        // the "sessions" figure on a record.
        if (trackedInSession) {
          rec.sessionCount += 1;
          if (!rec.lastSessionDate || sessionDate > rec.lastSessionDate) {
            rec.lastSessionDate = sessionDate;
          }
        }
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return fmtDate(iso);
      },

      historyHref(id: string): string {
        return localizedPath('/exercises/history?id=' + encodeURIComponent(id));
      },
    }));
  });
</script>

<style is:global>
  /* ════════════════════════════════════════════════════
     STATS — responsive grid override
     ════════════════════════════════════════════════════ */
  @media (min-width: 640px) {
    .rec__stats {
      grid-template-columns: 1.4fr 0.8fr 0.8fr;
      gap: 0;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .rec__stat {
      border-bottom: 0;
    }

    .rec__stat + .rec__stat {
      border-left: 1px solid var(--color-border);
    }
  }

  /* ════════════════════════════════════════════════════
     SEARCH — focus-within, placeholder, clear button
     ════════════════════════════════════════════════════ */
  .rec__search:focus-within {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .rec__search-input::placeholder {
    color: var(--color-muted);
  }

  .rec__search-input::-webkit-search-cancel-button {
    appearance: none;
  }

  /* ════════════════════════════════════════════════════
     SORT — hover / focus-visible / active states
     ════════════════════════════════════════════════════ */
  .rec__sort-btn:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-subtle);
  }

  .rec__sort-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .rec__sort-btn--active {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .rec__sort-btn--active:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-accent-foreground);
  }

  /* ════════════════════════════════════════════════════
     CARD — hover / focus-visible / child hover states
     ════════════════════════════════════════════════════ */
  .rec__card:hover {
    background-color: var(--alpha-bg-subtle);
    color: inherit;
  }

  .rec__card:focus-visible {
    outline: 0;
    box-shadow: var(--focus-ring);
  }

  .rec__card:hover .rec__card-cta {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  /* ════════════════════════════════════════════════════
     HERO stat — accent color override
     ════════════════════════════════════════════════════ */
  .rec__stat--hero .rec__stat-value {
    font-size: 3rem;
    color: var(--color-accent);
  }

  .rec__card-stat--hero .rec__card-stat-value {
    color: var(--color-accent);
  }

  /* ════════════════════════════════════════════════════
     RESPONSIVE — grid-template-areas (mobile)
     ════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    .rec__card {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "icon side"
        "main main";
      gap: 1rem;
    }

    .rec__card-icon {
      grid-area: icon;
      width: 3.2rem;
      height: 3.8rem;
    }

    .rec__card-icon svg {
      width: 2rem;
      height: 2rem;
    }

    .rec__card-main {
      grid-area: main;
    }

    .rec__card-side {
      grid-area: side;
      align-items: flex-end;
    }

    .rec__card-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .rec__stat-value {
      font-size: 2.2rem;
    }
    .rec__stat--hero .rec__stat-value {
      font-size: 2.6rem;
    }
    .rec__card-name {
      font-size: 1.5rem;
    }
    .rec__card-stat-value {
      font-size: 1.3rem;
    }
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .rec__card,
    .rec__card-cta,
    .rec__sort-btn {
      transition: none;
      transform: none;
    }
  }
</style>
