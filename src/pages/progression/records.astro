---

import { t, setLocale, defaultLocale, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.records.title}>
  <PageHeader
    title={L.records.titlePage}
    description={L.records.description}
  />

  <div
    class="rec"
    x-data="recordsApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Stats bar ── */}
    <template x-if="totalPRs > 0 || hasData">
      <div class="rec__stats">
        <div class="rec__stat rec__stat--hero">
          <span class="rec__stat-label">{L.records.best1RMGlobal}</span>
          <div class="rec__stat-value-row">
            <span class="rec__stat-value" x-text="formatNumber(bestOverall1RM)"></span>
            <span class="rec__stat-unit">{L.common.kg}</span>
          </div>
          <span class="rec__stat-foot" x-text="bestOverallExercise ? labels.on + bestOverallExercise : '—'"></span>
        </div>

        <div class="rec__stat">
          <span class="rec__stat-label">{L.records.totalPRs}</span>
          <div class="rec__stat-value-row">
            <span class="rec__stat-value" x-text="totalPRs"></span>
            <span class="rec__stat-unit">PR</span>
          </div>
          <span class="rec__stat-foot" x-text="totalPRs > 1 ? labels.exercisesTracked : labels.exerciseTracked"></span>
        </div>

        <div class="rec__stat">
          <span class="rec__stat-label">{L.records.recentPRs}</span>
          <div class="rec__stat-value-row">
            <span class="rec__stat-value" x-text="recentPRs"></span>
            <span class="rec__stat-unit">PR</span>
          </div>
          <span class="rec__stat-foot">depuis 30 jours</span>
        </div>
      </div>
    </template>

    {/* ── Toolbar: search + sort ── */}
    <template x-if="allRecords.length > 0">
      <div class="rec__toolbar">
        <label class="rec__search">
          <svg
            class="rec__search-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            class="rec__search-input"
            placeholder={L.records.searchPlaceholder}
            x-model="search"
            aria-label={L.records.searchAria}
          />
        </label>

        <div class="rec__sort">
          <span class="rec__sort-label">Trier par</span>
          <div class="rec__sort-group" role="radiogroup" aria-label={L.records.sortAria}>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'rm' }"
              @click="sortBy = 'rm'"
              role="radio"
              :aria-checked="sortBy === 'rm'"
            >
              {L.records.sortRM}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'name' }"
              @click="sortBy = 'name'"
              role="radio"
              :aria-checked="sortBy === 'name'"
            >
              {L.records.sortName}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'recent' }"
              @click="sortBy = 'recent'"
              role="radio"
              :aria-checked="sortBy === 'recent'"
            >
              {L.records.sortRecent}
            </button>
          </div>
        </div>
      </div>
    </template>

    {/* ── Records list ── */}
    <template x-if="filteredRecords.length > 0">
      <div class="rec__list">
        <template x-for="rec in filteredRecords" :key="rec.exerciseId">
          <a
            class="rec__card"
            :href="'/exercices/historique?id=' + rec.exerciseId"
            :aria-label="'Voir l\u2019historique de ' + rec.name"
          >
            <div class="rec__card-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6.5 6.5h11v11h-11z"></path>
                <path d="M2 9v6"></path>
                <path d="M22 9v6"></path>
                <path d="M6.5 6.5L2 9"></path>
                <path d="M17.5 6.5L22 9"></path>
                <path d="M6.5 17.5L2 15"></path>
                <path d="M17.5 17.5L22 15"></path>
              </svg>
            </div>

            <div class="rec__card-main">
              <div class="rec__card-head">
                <h3 class="rec__card-name" x-text="trExercise(rec.name)"></h3>
                <span class="rec__muscle-badge" x-text="trMuscle(rec.muscle)"></span>
              </div>

              <div class="rec__card-stats">
                <div class="rec__card-stat rec__card-stat--hero">
                  <span class="rec__card-stat-label">{L.records.sortRM}</span>
                  <span class="rec__card-stat-value" x-text="formatNumber(rec.estimated1RM) + ' ' + labels.kg"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestWeight}</span>
                  <span class="rec__card-stat-value" x-text="formatNumber(rec.bestWeight) + ' ' + labels.kg"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestReps}</span>
                  <span class="rec__card-stat-value" x-text="rec.bestReps"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.sessions}</span>
                  <span class="rec__card-stat-value" x-text="rec.sessionCount"></span>
                </div>
              </div>
            </div>

            <div class="rec__card-side">
              <span class="rec__card-date" x-text="formatDate(rec.date)"></span>
              <span class="rec__card-cta" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </span>
            </div>
          </a>
        </template>
      </div>
    </template>

    {/* ── Empty: no data at all ── */}
    <template x-if="allRecords.length === 0 && !hasData">
      <div class="rec__empty">
        <EmptyState
          title={L.records.noRecords}
          description={L.records.noRecordsDesc}
          actionLabel={L.common.startSession}
          actionHref={localizedPath("/seances/creer")}
        />
      </div>
    </template>

    {/* ── Empty: search returned nothing ── */}
    <template x-if="allRecords.length > 0 && filteredRecords.length === 0">
      <div class="rec__empty">
        <EmptyState
          title={L.records.noResult}
          description={L.records.noResultDesc}
        />
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type SessionExercise,
    type ProgressRecord,
  } from '../../lib/storage';

  import { t } from '../../i18n';

  const LABELS = t();

  /**
   * Per-exercise record. Mirrors the progression page's data shape so the
   * computation logic stays consistent and easy to compare.
   */
  interface ExerciseRecord {
    exerciseId: string;
    name: string;
    muscle: string;
    estimated1RM: number;
    bestWeight: number;
    bestReps: number;
    date: string;
    sessionCount: number;
  }

  type SortMode = 'rm' | 'name' | 'recent';

  function fmtNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString('fr-FR');
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('recordsApp', () => ({
      // ── Labels ──
      labels: {
        on: LABELS.records.on,
        exercisesTracked: LABELS.records.exercisesTracked,
        exerciseTracked: LABELS.records.exerciseTracked,
        kg: LABELS.common.kg,
      },

      // ── State ──
      allRecords: [] as ExerciseRecord[],
      search: '',
      sortBy: 'rm' as SortMode,
      hasData: false,

      // ── Init ──
      init() {
        this.recompute();
      },

      // ── Derived ──
      get totalPRs(): number {
        return this.allRecords.length;
      },

      get bestOverall1RM(): number {
        let max = 0;
        for (const r of this.allRecords) {
          if (r.estimated1RM > max) max = r.estimated1RM;
        }
        return max;
      },

      get bestOverallExercise(): string {
        for (const r of this.allRecords) {
          if (r.estimated1RM === this.bestOverall1RM) return r.name;
        }
        return '';
      },

      get recentPRs(): number {
        // 30-day window — anchored on the current local time, matching
        // the dashboard's "this week" semantics.
        const cutoff = new Date();
        cutoff.setDate(cutoff.getDate() - 30);
        cutoff.setHours(0, 0, 0, 0);
        let count = 0;
        for (const r of this.allRecords) {
          if (!r.date) continue;
          const d = new Date(r.date);
          if (!isNaN(d.getTime()) && d >= cutoff) count += 1;
        }
        return count;
      },

      get filteredRecords(): ExerciseRecord[] {
        const term = this.search.trim().toLowerCase();
        const list = term
          ? this.allRecords.filter(
              (r) =>
                r.name.toLowerCase().includes(term) ||
                r.muscle.toLowerCase().includes(term),
            )
          : this.allRecords.slice();

        switch (this.sortBy) {
          case 'name':
            return list.sort((a, b) =>
              a.name.localeCompare(b.name, 'fr', { sensitivity: 'base' }),
            );
          case 'recent':
            return list.sort(
              (a, b) =>
                new Date(b.date || 0).getTime() -
                new Date(a.date || 0).getTime(),
            );
          case 'rm':
          default:
            return list.sort((a, b) => b.estimated1RM - a.estimated1RM);
        }
      },

      // ── Computations ──
      recompute() {
        const sessions = getSessions();
        this.hasData = sessions.length > 0;
        if (!this.hasData) {
          this.allRecords = [];
          return;
        }

        const map = new Map<string, ExerciseRecord>();

        for (const session of sessions) {
          for (const ex of session.exercises) {
            this.accumulate(map, ex, session.date);
          }
        }

        this.allRecords = Array.from(map.values());
      },

      accumulate(
        map: Map<string, ExerciseRecord>,
        ex: SessionExercise,
        sessionDate: string,
      ) {
        let rec = map.get(ex.exerciseId);
        if (!rec) {
          rec = {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            estimated1RM: 0,
            bestWeight: 0,
            bestReps: 0,
            date: '',
            sessionCount: 0,
          };
          map.set(ex.exerciseId, rec);
        }
        rec.sessionCount += 1;

        for (const set of ex.sets) {
          if (!set.completed) continue;
          const rm: ProgressRecord = {
            exerciseId: ex.exerciseId,
            date: sessionDate,
            estimated1RM: calculate1RM(set.weight, set.reps),
            bestWeight: set.weight,
            bestReps: set.reps,
          };
          if (rm.estimated1RM > rec.estimated1RM) {
            rec.estimated1RM = rm.estimated1RM;
            rec.bestWeight = rm.bestWeight;
            rec.bestReps = rm.bestReps;
            rec.date = rm.date;
          }
        }
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return fmtDate(iso);
      },
    }));
  });
</script>

{/* Alpine.js CDN — MUST be AFTER the app script (type="module" runs before defer) */}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<style>
  [x-cloak] {
    display: none !important;
  }

  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .rec {
    max-width: 88rem;
    margin: 0 auto;
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     STATS BAR
     ════════════════════════════════════════════════════ */
  .rec__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 640px) {
    .rec__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rec__stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem 1.8rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .rec__stat--hero {
    background-color: hsl(32 95% 50% / 0.08);
    border-color: hsl(32 95% 50% / 0.30);
  }

  .rec__stat-label {
    font-size: 1.0rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    font-weight: 700;
  }

  .rec__stat-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .rec__stat-value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .rec__stat--hero .rec__stat-value {
    font-size: 3rem;
    color: var(--color-accent);
  }

  .rec__stat-unit {
    font-family: var(--font-body);
    font-size: 1.3rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  .rec__stat-foot {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: capitalize;
  }

  /* ════════════════════════════════════════════════════
     TOOLBAR — search + sort
     ════════════════════════════════════════════════════ */
  .rec__toolbar {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.4rem 1.6rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 640px) {
    .rec__toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.6rem;
    }
  }

  .rec__search {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 auto;
    min-width: 0;
    height: 4.4rem;
    padding: 0 1.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .rec__search:focus-within {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .rec__search-icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .rec__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
  }

  .rec__search-input::placeholder {
    color: var(--color-muted);
  }

  /* Strip the native search clear button to keep visual control. */
  .rec__search-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .rec__sort {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .rec__sort-label {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    font-weight: 700;
    color: var(--color-muted);
  }

  .rec__sort-group {
    display: inline-flex;
    padding: 0.3rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    gap: 0.2rem;
  }

  .rec__sort-btn {
    height: 3.4rem;
    padding: 0 1.2rem;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                color var(--transition-fast);
  }

  .rec__sort-btn:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-subtle);
  }

  .rec__sort-btn--active {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .rec__sort-btn--active:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-accent-foreground);
  }

  /* ════════════════════════════════════════════════════
     LIST
     ════════════════════════════════════════════════════ */
  .rec__list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  /* ════════════════════════════════════════════════════
     CARD — horizontal row
     ════════════════════════════════════════════════════ */
  .rec__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.4rem;
    padding: 1.4rem 1.6rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-normal),
                border-color var(--transition-normal),
                transform var(--transition-fast);
  }

  .rec__card:hover {
    background-color: var(--color-surface-2);
    border-color: hsl(32 95% 50% / 0.30);
  }

  .rec__card:focus-visible {
    outline: 0;
    box-shadow: var(--focus-ring);
  }

  .rec__card:active {
    transform: scale(0.998);
  }

  .rec__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.2rem;
    height: 4.2rem;
    background-color: hsl(32 95% 50% / 0.12);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .rec__card-icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .rec__card-main {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 0;
  }

  .rec__card-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rec__card-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    word-break: break-word;
  }

  .rec__muscle-badge {
    display: inline-flex;
    align-items: center;
    height: 2.4rem;
    padding: 0 1rem;
    background-color: hsl(32 95% 50% / 0.12);
    border: 1px solid hsl(32 95% 50% / 0.30);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
    font-size: 1.0rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
    flex-shrink: 0;
  }

  .rec__card-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1.2rem;
  }

  @media (min-width: 540px) {
    .rec__card-stats {
      grid-template-columns: repeat(4, auto);
    }
  }

  .rec__card-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 5.2rem;
  }

  .rec__card-stat-label {
    font-size: 1.0rem;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--color-muted);
    font-weight: 700;
  }

  .rec__card-stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .rec__card-stat--hero .rec__card-stat-value {
    color: var(--color-accent);
  }

  .rec__card-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .rec__card-date {
    font-size: 1.2rem;
    color: var(--color-muted);
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }

  .rec__card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--color-muted);
    transition: color var(--transition-fast),
                transform var(--transition-fast);
  }

  .rec__card:hover .rec__card-cta {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .rec__card-cta svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     EMPTY
     ════════════════════════════════════════════════════ */
  .rec__empty {
    padding: 1.6rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  /* ════════════════════════════════════════════════════
     RESPONSIVE
     ════════════════════════════════════════════════════ */
  @media (max-width: 640px) {
    .rec__card {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "icon side"
        "main main";
      gap: 1rem;
    }

    .rec__card-icon {
