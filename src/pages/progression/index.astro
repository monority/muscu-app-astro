---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card/Card.astro';
import Badge from '../../components/ui/Badge/Badge.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.progression.title}>
  <PageHeader
    title={L.progression.title}
    description={L.progression.description}
  />

  <div
    class="pb-24 flex flex-col gap-6"
    x-data="progressionApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: summary + sort ── */}
    <div class="mb-1" x-show="exerciseStats.length > 0">
      <div class="prog__summary flex flex-wrap gap-y-3 gap-x-6 py-4 border-t border-b border-border">
        <div class="inline-flex items-baseline gap-[0.6rem]">
          <Fragment set:html={icons.dumbbellBox()} />
          <span class="prog__summary-value font-display text-[2rem] font-bold text-text tabular-nums leading-none" x-text="exerciseStats.length"></span>
          <span class="text-[1.1rem] text-muted uppercase tracking-[0.08em] font-semibold">{L.progression.exerciseSingular}<span x-show="exerciseStats.length > 1">s</span></span>
        </div>
        <div class="inline-flex items-baseline gap-[0.6rem]">
          <Fragment set:html={icons.trendingUp()} />
          <span class="prog__summary-value font-display text-[2rem] font-bold text-text tabular-nums leading-none" x-text="formatNumber(max1RM)"></span>
          <span class="text-[1.1rem] text-muted uppercase tracking-[0.08em] font-semibold">{L.progression.kg} {L.progression.max1RM}</span>
        </div>
        <div class="inline-flex items-baseline gap-[0.6rem]">
          <Fragment set:html={icons.list()} />
          <span class="prog__summary-value font-display text-[2rem] font-bold text-text tabular-nums leading-none" x-text="totalSessions"></span>
          <span class="text-[1.1rem] text-muted uppercase tracking-[0.08em] font-semibold">{L.records.sessionSingular}<span x-show="totalSessions > 1">s</span></span>
        </div>
      </div>
    </div>

    {/* ── Grid of exercise progression cards ── */}
    <template x-if="exerciseStats.length > 0">
      <div class="prog__grid grid grid-cols-1 gap-8">
        <template x-for="stat in exerciseStats" :key="stat.exerciseId">
          <article class="prog__item items-center gap-6 min-w-0 py-6 border-b border-border transition-colors duration-normal hover:bg-[var(--alpha-bg-subtle)]">
              <header class="flex items-center justify-between gap-4 min-w-0">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                  <Fragment set:html={icons.dumbbellBox()} />
                  <h3 class="font-display text-[1.7rem] font-bold leading-tight text-text break-words" x-text="trExercise(stat.name)"></h3>
                </div>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(stat.muscle)"
                  x-text="trMuscle(stat.muscle)"
                ></Badge>
              </header>

              <div class="prog__item-stats grid grid-cols-2 gap-4">
                <div class="prog__stat--hero flex flex-col gap-[0.3rem] py-[1.1rem] bg-transparent border-0 border-b border-border">
                  <span class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold">{L.progression.best1RM}</span>
                  <div class="flex items-baseline gap-1">
                    <span class="prog__stat-value font-display text-[2.8rem] font-bold text-accent tabular-nums leading-[1.1]" x-text="formatNumber(stat.estimated1RM)"></span>
                    <span class="font-body text-[1.2rem] text-muted font-semibold">{L.progression.kg}</span>
                  </div>
                </div>
                <div class="prog__stat flex flex-col gap-[0.3rem] py-[1.1rem] bg-transparent border-0 border-b border-border">
                  <span class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold">{L.progression.bestWeight}</span>
                  <div class="flex items-baseline gap-1">
                    <span class="prog__stat-value font-display text-[2.2rem] font-bold text-text tabular-nums leading-[1.1]" x-text="formatNumber(stat.bestWeight)"></span>
                    <span class="font-body text-[1.2rem] text-muted font-semibold">{L.progression.kg}</span>
                  </div>
                </div>
                <div class="prog__stat flex flex-col gap-[0.3rem] py-[1.1rem] bg-transparent border-0 border-b border-border">
                  <span class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold">{L.progression.maxReps}</span>
                  <div class="flex items-baseline gap-1">
                    <span class="prog__stat-value font-display text-[2.2rem] font-bold text-text tabular-nums leading-[1.1]" x-text="stat.bestReps"></span>
                    <span class="font-body text-[1.2rem] text-muted font-semibold">{L.progression.repsSuffix}</span>
                  </div>
                </div>
                <div class="prog__stat flex flex-col gap-[0.3rem] py-[1.1rem] bg-transparent border-0 border-b border-border">
                  <span class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold">{L.progression.date}</span>
                  <div class="flex items-baseline gap-1">
                    <span class="prog__stat-value--sm font-display text-[1.4rem] font-bold text-text tabular-nums leading-[1.1]" x-text="formatDate(stat.date)"></span>
                  </div>
                </div>
              </div>

              <footer class="flex flex-col gap-4 min-w-0 pt-1">
              <div class="inline-flex items-center flex-wrap gap-[0.6rem] text-muted text-[1.2rem]">
                <Fragment set:html={icons.calendar()} />
                  <span x-text="stat.sessionCount"></span>
                  <span class="uppercase tracking-[0.06em] text-[1.1rem] font-semibold">{L.records.sessionSingular}<span x-show="stat.sessionCount > 1">s</span></span>
                  <span class="text-border-strong" aria-hidden="true">·</span>
                  <span class="uppercase tracking-[0.06em] text-[1.1rem] font-semibold text-muted">{L.records.lastSession}</span>
                  <span class="text-text tabular-nums" x-text="formatDate(stat.lastSessionDate)"></span>
                </div>
                <div class="flex flex-col gap-[0.6rem]" x-show="stat.history.length > 1">
                  <span class="text-[1.1rem] text-muted uppercase tracking-[0.12em] font-bold">{L.historique.titleShort}</span>
                  <div class="prog__history-bar flex items-end gap-[0.3rem] h-[4.8rem] p-1 bg-surface-2 border border-border rounded-sm" :title="historyTooltip(stat.history)">
                    <template x-for="(record, idx) in stat.history" :key="idx">
                      <span
                        class="prog__history-tick flex-1 min-w-[0.4rem] rounded-[2px] transition-colors duration-base"
                        :style="{ height: historyBarHeight(stat.history, record.estimated1RM) + '%' }"
                        :title="formatNumber(record.estimated1RM) + ' kg · ' + formatDate(record.date)"
                      ></span>
                    </template>
                  </div>
                </div>
              </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state ── */}
    <template x-if="exerciseStats.length === 0">
      <Card>
        <EmptyState
          iconName="chart"
          title={L.progression.noData}
          description={L.progression.empty}
          actionLabel={L.common.startSession}
          actionHref={localizedPath("/sessions/create")}
        />
      </Card>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type SessionExercise,
    type ProgressRecord,
  } from '../../lib/storage';
  import { formatNumPositive, formatDateShort } from '../../lib/format';

  /**
   * Per-exercise progression row.
   * - `best` is the highest-1RM ProgressRecord found in any session.
   * - `history` is the full series of ProgressRecords, oldest → newest.
   * - `sessionCount` is the number of sessions that included this exercise.
   */
  interface ExerciseProgression {
    exerciseId: string;
    name: string;
    muscle: string;
    estimated1RM: number;
    bestWeight: number;
    bestReps: number;
    date: string;
    lastSessionDate: string;
    sessionCount: number;
    history: ProgressRecord[];
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('progressionApp', () => ({
      // ── State ──
      exerciseStats: [] as ExerciseProgression[],

      // ── Init ──
      init() {
        this.recompute();
      },

      // ── Derived ──
      get totalSessions(): number {
        return getSessions().length;
      },

      get max1RM(): number {
        let max = 0;
        for (const stat of this.exerciseStats) {
          if (stat.estimated1RM > max) max = stat.estimated1RM;
        }
        return max;
      },

      // ── Computations ──
      recompute() {
        const sessions = getSessions();
        const map = new Map<string, ExerciseProgression>();

        for (const session of sessions) {
          for (const ex of session.exercises) {
            this.accumulateExercise(map, ex, session.date);
          }
        }

        this.exerciseStats = Array.from(map.values())
          .filter((stat) => stat.history.length > 0)
          .sort((a, b) => b.estimated1RM - a.estimated1RM);
      },

      accumulateExercise(
        map: Map<string, ExerciseProgression>,
        ex: SessionExercise,
        sessionDate: string,
      ) {
        let stat = map.get(ex.exerciseId);
        if (!stat) {
          stat = {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            estimated1RM: 0,
            bestWeight: 0,
            bestReps: 0,
            date: '',
            lastSessionDate: '',
            sessionCount: 0,
            history: [],
          };
          map.set(ex.exerciseId, stat);
        }
        let trackedInSession = false;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          trackedInSession = true;
          const record: ProgressRecord = {
            exerciseId: ex.exerciseId,
            date: sessionDate,
            estimated1RM: calculate1RM(set.weight, set.reps),
            bestWeight: set.weight,
            bestReps: set.reps,
          };
          stat.history.push(record);
          if (record.estimated1RM > stat.estimated1RM) {
            stat.estimated1RM = record.estimated1RM;
            stat.bestWeight = record.bestWeight;
            stat.bestReps = record.bestReps;
            stat.date = record.date;
          }
        }
        if (trackedInSession) {
          stat.sessionCount += 1;
          if (!stat.lastSessionDate || sessionDate > stat.lastSessionDate) {
            stat.lastSessionDate = sessionDate;
          }
        }
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return formatNumPositive(n);
      },

      formatDate(iso: string): string {
        if (!iso) return '—';
        return formatDateShort(iso);
      },

      /**
       * For the mini history bar: percentage height of `value` relative to
       * the max value within the same series (min 8% so single records stay
       * visible).
       */
      historyBarHeight(history: ProgressRecord[], value: number): number {
        if (history.length === 0 || value <= 0) return 0;
        const max = history.reduce((m, r) => (r.estimated1RM > m ? r.estimated1RM : m), 0);
        if (max <= 0) return 8;
        const pct = (value / max) * 100;
        return Math.max(8, Math.min(100, Math.round(pct)));
      },

      historyTooltip(history: ProgressRecord[]): string {
        return history
          .map((r) => `${formatNumPositive(r.estimated1RM)} kg · ${formatDateShort(r.date)}`)
          .join('\n');
      },
    }));
  });
</script>

<style>
  .prog__grid {
    grid-template-columns: 1fr;
  }

  .prog__item {
    display: grid;
    grid-template-columns: minmax(20rem, 0.8fr) minmax(0, 1.45fr) minmax(14rem, 0.55fr);
  }

  .prog__item-stats {
    grid-column: 1 / -1;
  }

  .prog__stat--hero {
    grid-column: 1 / -1;
    padding-top: 0;
    padding-bottom: 1.4rem;
    border-bottom-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
  }

  .prog__history-tick {
    background-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .prog__history-tick:first-child {
    background-color: var(--color-accent);
  }

  .prog__history-bar:hover .prog__history-tick {
    background-color: color-mix(in srgb, var(--color-accent) 75%, transparent);
  }

  .prog__history-bar:hover .prog__history-tick:first-child {
    background-color: color-mix(in srgb, var(--color-accent) 95%, transparent);
  }

  @media (min-width: 640px) {
    .prog__stat:nth-child(4) {
      border-left: 1px solid var(--color-border);
      padding-left: 1.6rem;
    }
  }

  @media (max-width: 900px) {
    .prog__item { grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr); }
    .prog__item footer { grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .prog__item { display: flex; flex-direction: column; align-items: stretch; gap: 1.4rem; }
    .prog__summary { padding: 1.2rem 0; gap: 1rem 1.6rem; }
    .prog__summary-value { font-size: 1.6rem; }
    .prog__item-stats { grid-template-columns: 1fr; }
    .prog__stat:nth-child(4) { border-left: 0; padding-left: 0; }
    .prog__stat-value { font-size: 1.8rem; }
    .prog__stat--hero .prog__stat-value { font-size: 2.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .prog__history-tick,
    .prog__item {
      transition: none;
    }
  }
</style>
