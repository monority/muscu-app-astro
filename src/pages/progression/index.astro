---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.progression.title}>
  <PageHeader
    title={L.progression.title}
    description={L.progression.description}
  />

  <div
    class="prog"
    x-data="progressionApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: summary + sort ── */}
    <div class="prog__toolbar" x-show="exerciseStats.length > 0">
      <div class="prog__summary">
        <div class="prog__summary-item">
          <Fragment set:html={icons.dumbbellBox()} />
          <span class="prog__summary-value" x-text="exerciseStats.length"></span>
          <span class="prog__summary-label">{L.progression.exerciseSingular}<span x-show="exerciseStats.length > 1">s</span></span>
        </div>
        <div class="prog__summary-item">
          <Fragment set:html={icons.trendingUp()} />
          <span class="prog__summary-value" x-text="formatNumber(max1RM)"></span>
          <span class="prog__summary-label">{L.progression.kg} {L.progression.max1RM}</span>
        </div>
        <div class="prog__summary-item">
          <Fragment set:html={icons.list()} />
          <span class="prog__summary-value" x-text="totalSessions"></span>
          <span class="prog__summary-label">{L.records.sessionSingular}<span x-show="totalSessions > 1">s</span></span>
        </div>
      </div>
    </div>

    {/* ── Grid of exercise progression cards ── */}
    <template x-if="exerciseStats.length > 0">
      <div class="prog__grid">
        <template x-for="stat in exerciseStats" :key="stat.exerciseId">
          <article class="prog__item">
              <header class="prog__item-head">
                <div class="prog__item-title">
                  <Fragment set:html={icons.dumbbellBox()} />
                  <h3 class="prog__item-name" x-text="trExercise(stat.name)"></h3>
                </div>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(stat.muscle)"
                  x-text="trMuscle(stat.muscle)"
                ></Badge>
              </header>

              <div class="prog__item-stats">
                <div class="prog__stat prog__stat--hero">
                  <span class="prog__stat-label">{L.progression.best1RM}</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value" x-text="formatNumber(stat.estimated1RM)"></span>
                    <span class="prog__stat-unit">{L.progression.kg}</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">{L.progression.bestWeight}</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value" x-text="formatNumber(stat.bestWeight)"></span>
                    <span class="prog__stat-unit">{L.progression.kg}</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">{L.progression.maxReps}</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value" x-text="stat.bestReps"></span>
                    <span class="prog__stat-unit">{L.progression.repsSuffix}</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">{L.progression.date}</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value prog__stat-value--sm" x-text="formatDate(stat.date)"></span>
                  </div>
                </div>
              </div>

              <footer class="prog__item-foot">
              <div class="prog__meta">
                <Fragment set:html={icons.calendar()} />
                  <span x-text="stat.sessionCount"></span>
                  <span class="prog__meta-label">{L.records.sessionSingular}<span x-show="stat.sessionCount > 1">s</span></span>
                  <span class="prog__meta-separator" aria-hidden="true">·</span>
                  <span class="prog__meta-date-label">{L.records.lastSession}</span>
                  <span class="prog__meta-date" x-text="formatDate(stat.lastSessionDate)"></span>
                </div>
                <div class="prog__history" x-show="stat.history.length > 1">
                  <span class="prog__history-label">{L.historique.titleShort}</span>
                  <div class="prog__history-bar" :title="historyTooltip(stat.history)">
                    <template x-for="(record, idx) in stat.history" :key="idx">
                      <span
                        class="prog__history-tick"
                        :style="{ height: historyBarHeight(stat.history, record.estimated1RM) + '%' }"
                        :title="formatNumber(record.estimated1RM) + ' kg · ' + formatDate(record.date)"
                      ></span>
                    </template>
                  </div>
                </div>
              </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state ── */}
    <template x-if="exerciseStats.length === 0">
      <Card>
        <EmptyState
          iconName="chart"
          title={L.progression.noData}
          description={L.progression.empty}
          actionLabel={L.common.startSession}
          actionHref={localizedPath("/seances/creer")}
        />
      </Card>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type SessionExercise,
    type ProgressRecord,
  } from '../../lib/storage';
  import { formatNumPositive, formatDateShort } from '../../lib/format';

  /**
   * Per-exercise progression row.
   * - `best` is the highest-1RM ProgressRecord found in any session.
   * - `history` is the full series of ProgressRecords, oldest → newest.
   * - `sessionCount` is the number of sessions that included this exercise.
   */
  interface ExerciseProgression {
    exerciseId: string;
    name: string;
    muscle: string;
    estimated1RM: number;
    bestWeight: number;
    bestReps: number;
    date: string;
    lastSessionDate: string;
    sessionCount: number;
    history: ProgressRecord[];
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('progressionApp', () => ({
      // ── State ──
      exerciseStats: [] as ExerciseProgression[],

      // ── Init ──
      init() {
        this.recompute();
      },

      // ── Derived ──
      get totalSessions(): number {
        return getSessions().length;
      },

      get max1RM(): number {
        let max = 0;
        for (const stat of this.exerciseStats) {
          if (stat.estimated1RM > max) max = stat.estimated1RM;
        }
        return max;
      },

      // ── Computations ──
      recompute() {
        const sessions = getSessions();
        const map = new Map<string, ExerciseProgression>();

        for (const session of sessions) {
          for (const ex of session.exercises) {
            this.accumulateExercise(map, ex, session.date);
          }
        }

        this.exerciseStats = Array.from(map.values())
          .filter((stat) => stat.history.length > 0)
          .sort((a, b) => b.estimated1RM - a.estimated1RM);
      },

      accumulateExercise(
        map: Map<string, ExerciseProgression>,
        ex: SessionExercise,
        sessionDate: string,
      ) {
        let stat = map.get(ex.exerciseId);
        if (!stat) {
          stat = {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            estimated1RM: 0,
            bestWeight: 0,
            bestReps: 0,
            date: '',
            lastSessionDate: '',
            sessionCount: 0,
            history: [],
          };
          map.set(ex.exerciseId, stat);
        }
        let trackedInSession = false;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          trackedInSession = true;
          const record: ProgressRecord = {
            exerciseId: ex.exerciseId,
            date: sessionDate,
            estimated1RM: calculate1RM(set.weight, set.reps),
            bestWeight: set.weight,
            bestReps: set.reps,
          };
          stat.history.push(record);
          if (record.estimated1RM > stat.estimated1RM) {
            stat.estimated1RM = record.estimated1RM;
            stat.bestWeight = record.bestWeight;
            stat.bestReps = record.bestReps;
            stat.date = record.date;
          }
        }
        if (trackedInSession) {
          stat.sessionCount += 1;
          if (!stat.lastSessionDate || sessionDate > stat.lastSessionDate) {
            stat.lastSessionDate = sessionDate;
          }
        }
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return formatNumPositive(n);
      },

      formatDate(iso: string): string {
        if (!iso) return '—';
        return formatDateShort(iso);
      },

      /**
       * For the mini history bar: percentage height of `value` relative to
       * the max value within the same series (min 8% so single records stay
       * visible).
       */
      historyBarHeight(history: ProgressRecord[], value: number): number {
        if (history.length === 0 || value <= 0) return 0;
        const max = history.reduce((m, r) => (r.estimated1RM > m ? r.estimated1RM : m), 0);
        if (max <= 0) return 8;
        const pct = (value / max) * 100;
        return Math.max(8, Math.min(100, Math.round(pct)));
      },

      historyTooltip(history: ProgressRecord[]): string {
        return history
          .map((r) => `${formatNumPositive(r.estimated1RM)} kg · ${formatDateShort(r.date)}`)
          .join('\n');
      },
    }));
  });
</script>

<style>
  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .prog {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     TOOLBAR — summary stats
     ════════════════════════════════════════════════════ */
  .prog__toolbar {
    margin-bottom: 0.4rem;
  }

  .prog__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
    padding: 1.6rem 0;
    background-color: transparent;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .prog__summary-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .prog__summary-icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-accent);
    flex-shrink: 0;
    align-self: center;
  }

  .prog__summary-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .prog__summary-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* ════════════════════════════════════════════════════
     GRID — 1 / 2 / 3 columns
     ════════════════════════════════════════════════════ */
  .prog__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 3.2rem;
  }

  @media (min-width: 640px) {
    .prog__grid {
      grid-template-columns: 1fr;
    }

    .prog__stat:nth-child(4) {
      border-left: 1px solid var(--color-border);
      padding-left: 1.6rem;
    }
  }

  /* ════════════════════════════════════════════════════
     ITEM — open exercise record
     ════════════════════════════════════════════════════ */
  .prog__item {
    display: grid;
    grid-template-columns: minmax(20rem, 0.8fr) minmax(0, 1.45fr) minmax(14rem, 0.55fr);
    align-items: center;
    gap: 2.4rem;
    min-width: 0;
    padding: 2.4rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-normal);
  }

  .prog__item:hover {
    background-color: var(--alpha-bg-subtle);
  }

  .prog__item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }

  .prog__item-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .prog__item-icon {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .prog__item-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    word-break: break-word;
  }

  /* ── Stats grid ── */
  .prog__item-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .prog__stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 0;
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .prog__stat--hero {
    grid-column: 1 / -1;
    padding-top: 0;
    padding-bottom: 1.4rem;
    border-bottom-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
  }

  .prog__stat-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .prog__stat-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .prog__stat-value {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .prog__stat--hero .prog__stat-value {
    font-size: 2.8rem;
    color: var(--color-accent);
  }

  .prog__stat-value--sm {
    font-size: 1.4rem;
  }

  .prog__stat-unit {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  /* ── Footer: sessions + history bar ── */
  .prog__item-foot {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding-top: 0.4rem;
  }

  .prog__meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--color-muted);
    font-size: 1.2rem;
  }

  .prog__meta-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  .prog__meta-label,
  .prog__meta-date-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .prog__meta-separator {
    color: var(--color-border-strong);
  }

  .prog__meta-date-label {
    color: var(--color-muted);
  }

  .prog__meta-date {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .prog__history {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .prog__history-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .prog__history-bar {
    display: flex;
    align-items: flex-end;
    gap: 0.3rem;
    height: 4.8rem;
    padding: 0.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .prog__history-tick {
    flex: 1 1 auto;
    min-width: 0.4rem;
    background-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    border-radius: 2px;
    transition: background-color 200ms ease;
  }

  .prog__history-tick:first-child {
    background-color: var(--color-accent);
  }

  .prog__history-bar:hover .prog__history-tick {
    background-color: color-mix(in srgb, var(--color-accent) 75%, transparent);
  }

  .prog__history-bar:hover .prog__history-tick:first-child {
    background-color: color-mix(in srgb, var(--color-accent) 95%, transparent);
  }

  /* ════════════════════════════════════════════════════
     RESPONSIVE — small screens
     ════════════════════════════════════════════════════ */
  @media (max-width: 900px) {
    .prog__item { grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr); }
    .prog__item-foot { grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .prog__item { display: flex; flex-direction: column; align-items: stretch; gap: 1.4rem; }
    .prog__summary {
      padding: 1.2rem 0;
      gap: 1rem 1.6rem;
    }
    .prog__summary-value {
      font-size: 1.6rem;
    }
    .prog__item-stats {
      grid-template-columns: 1fr;
    }

    .prog__stat:nth-child(4) {
      border-left: 0;
      padding-left: 0;
    }

    .prog__stat-value {
      font-size: 1.8rem;
    }
    .prog__stat--hero .prog__stat-value {
      font-size: 2.4rem;
    }
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .prog__history-tick,
    .prog__item {
      transition: none;
    }
  }
</style>
