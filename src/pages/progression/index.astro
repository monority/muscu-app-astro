---

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.progression.title}>
  <PageHeader
    title={L.progression.title}
    description={L.progression.description}
  />

  <div
    class="prog"
    x-data="progressionApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: summary + sort ── */}
    <div class="prog__toolbar" x-show="exerciseStats.length > 0">
      <div class="prog__summary">
        <div class="prog__summary-item">
          <Fragment set:html={icons.dumbbellBox()} />
          <span class="prog__summary-value" x-text="exerciseStats.length"></span>
          <span class="prog__summary-label">{L.progression.exerciseSingular}<span x-show="exerciseStats.length > 1">s</span></span>
        </div>
        <div class="prog__summary-item">
          <Fragment set:html={icons.trendingUp()} />
          <span class="prog__summary-value" x-text="formatNumber(max1RM)"></span>
          <span class="prog__summary-label">{L.progression.kg} {L.progression.max1RM}</span>
        </div>
        <div class="prog__summary-item">
          <Fragment set:html={icons.list()} />
          <span class="prog__summary-value" x-text="totalSessions"></span>
          <span class="prog__summary-label">{L.records.sessionSingular}<span x-show="totalSessions > 1">s</span></span>
        </div>
      </div>
    </div>

    {/* ── Grid of exercise progression cards ── */}
    <template x-if="exerciseStats.length > 0">
      <div class="prog__grid">
        <template x-for="stat in exerciseStats" :key="stat.exerciseId">
          <article class="prog__item">
              <header class="prog__item-header">
                <div class="prog__item-title">
                  <Fragment set:html={icons.dumbbellBox()} />
                  <h3 class="prog__item-name" x-text="trExercise(stat.name)"></h3>
                </div>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(stat.muscle)"
                  x-text="trMuscle(stat.muscle)"
                ></Badge>
              </header>

              <div class="prog__item-stats">
                <div class="prog__stat prog__stat--hero">
                  <span class="prog__stat-label">{L.progression.best1RM}</span>
                  <div class="prog__stat-row">
                    <span class="prog__stat-value prog__stat-value--hero" x-text="formatNumber(stat.estimated1RM)"></span>
                    <span class="prog__stat-unit">{L.progression.kg}</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">{L.progression.bestWeight}</span>
                  <div class="prog__stat-row">
                    <span class="prog__stat-value" x-text="formatNumber(stat.bestWeight)"></span>
                    <span class="prog__stat-unit">{L.progression.kg}</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">{L.progression.maxReps}</span>
                  <div class="prog__stat-row">
                    <span class="prog__stat-value" x-text="stat.bestReps"></span>
                    <span class="prog__stat-unit">{L.progression.repsSuffix}</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">{L.progression.date}</span>
                  <div class="prog__stat-row">
                    <span class="prog__stat-value prog__stat-value--sm" x-text="formatDate(stat.date)"></span>
                  </div>
                </div>
              </div>

              <footer class="prog__item-footer">
              <div class="prog__session-info">
                <Fragment set:html={icons.calendar()} />
                  <span x-text="stat.sessionCount"></span>
                  <span class="prog__session-label">{L.records.sessionSingular}<span x-show="stat.sessionCount > 1">s</span></span>
                  <span class="prog__sep" aria-hidden="true">·</span>
                  <span class="prog__session-label">{L.records.lastSession}</span>
                  <span class="prog__session-date" x-text="formatDate(stat.lastSessionDate)"></span>
                </div>
                <div class="prog__history" x-show="stat.history.length > 1">
                  <span class="prog__stat-label">{L.historique.titleShort}</span>
                  <div class="prog__history-bar" :title="historyTooltip(stat.history)">
                    <template x-for="(record, idx) in stat.history" :key="idx">
                      <span
                        class="prog__history-tick"
                        :style="{ height: historyBarHeight(stat.history, record.estimated1RM) + '%' }"
                        :title="formatNumber(record.estimated1RM) + ' kg · ' + formatDate(record.date)"
                      ></span>
                    </template>
                  </div>
                </div>
              </footer>
          </article>
        </template>
      </div>
    </template>

    {/* ── Empty state ── */}
    <template x-if="exerciseStats.length === 0">
      <Card>
        <EmptyState
          iconName="chart"
          title={L.progression.noData}
          description={L.progression.empty}
          actionLabel={L.common.startSession}
          actionHref={localizedPath("/sessions/create")}
        />
      </Card>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    type ProgressRecord,
  } from '../../lib/storage';
  import { formatNumPositive, formatDateShort } from '../../lib/format';
  import {
    computeExerciseProgression,
    computeMax1RM,
    historyBarHeight as calcHistoryBarHeight,
    type ExerciseProgression,
  } from '../../lib/progression-stats';

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('progressionApp', () => ({
      exerciseStats: [] as ExerciseProgression[],

      init() {
        this.recompute();
      },

      get totalSessions(): number {
        return getSessions().length;
      },

      get max1RM(): number {
        return computeMax1RM(this.exerciseStats);
      },

      recompute() {
        this.exerciseStats = computeExerciseProgression(getSessions());
      },

      formatNumber(n: number): string {
        return formatNumPositive(n);
      },

      formatDate(iso: string): string {
        if (!iso) return '—';
        return formatDateShort(iso);
      },

      historyBarHeight(history: ProgressRecord[], value: number): number {
        return calcHistoryBarHeight(history, value);
      },

      historyTooltip(history: ProgressRecord[]): string {
        return history
          .map((r) => `${formatNumPositive(r.estimated1RM)} kg · ${formatDateShort(r.date)}`)
          .join('\n');
      },
    }));
  });
</script>

<style>
  .prog {
    padding-bottom: 9.6rem;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  /* ── Summary toolbar ── */
  .prog__toolbar { margin-bottom: 0.4rem; }

  .prog__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .prog__summary-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .prog__summary-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .prog__summary-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* ── Grid ── */
  .prog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
  }

  /* ── Item ── */
  .prog__item {
    display: grid;
    grid-template-columns: minmax(20rem, 0.8fr) minmax(0, 1.45fr) minmax(14rem, 0.55fr);
    align-items: start;
    gap: 2.4rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-normal);
  }
  .prog__item:hover {
    background-color: var(--alpha-bg-subtle);
  }

  .prog__item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    min-width: 0;
  }

  .prog__item-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1;
  }

  .prog__item-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    word-break: break-word;
    margin: 0;
  }

  /* ── Stats grid ── */
  .prog__item-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    grid-column: 1 / -1;
  }

  .prog__stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .prog__stat--hero {
    grid-column: 1 / -1;
    padding-top: 0;
    padding-bottom: 1.4rem;
    border-bottom-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
  }

  .prog__stat-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .prog__stat-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .prog__stat-value {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .prog__stat-value--hero {
    font-size: 2.8rem;
    color: var(--color-accent);
  }

  .prog__stat-value--sm {
    font-size: 1.4rem;
  }

  .prog__stat-unit {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  /* ── Footer ── */
  .prog__item-footer {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-width: 0;
    padding-top: 0.4rem;
  }

  .prog__session-info {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--color-muted);
    font-size: 1.2rem;
  }

  .prog__session-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .prog__session-date {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .prog__sep {
    color: var(--color-border-strong);
  }

  /* ── History bar ── */
  .prog__history {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .prog__history-bar {
    display: flex;
    align-items: end;
    gap: 0.3rem;
    height: 4.8rem;
    padding: 0.4rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .prog__history-tick {
    flex: 1;
    min-width: 0.4rem;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    transition: background-color var(--transition-base);
  }
  .prog__history-tick:first-child {
    background-color: var(--color-accent);
  }
  .prog__history-bar:hover .prog__history-tick {
    background-color: color-mix(in srgb, var(--color-accent) 75%, transparent);
  }
  .prog__history-bar:hover .prog__history-tick:first-child {
    background-color: color-mix(in srgb, var(--color-accent) 95%, transparent);
  }

  /* ── Responsive ── */
  @media (min-width: 640px) {
    .prog__stat:nth-child(4) {
      border-left: 1px solid var(--color-border);
      padding-left: 1.6rem;
    }
  }

  @media (max-width: 900px) {
    .prog__item { grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr); }
    .prog__item-footer { grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .prog__item { display: flex; flex-direction: column; align-items: stretch; gap: 1.4rem; }
    .prog__summary { padding: 1.2rem 0; gap: 1rem 1.6rem; }
    .prog__summary-value { font-size: 1.6rem; }
    .prog__item-stats { grid-template-columns: 1fr; }
    .prog__stat:nth-child(4) { border-left: 0; padding-left: 0; }
    .prog__stat-value { font-size: 1.8rem; }
    .prog__stat-value--hero { font-size: 2.4rem; }
  }
</style>
