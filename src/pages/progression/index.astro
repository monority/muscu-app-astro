---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Card from '../../components/ui/Card.astro';
---

<AppLayout title="Progression">
  <PageHeader
    title="Progression"
    description="Suivez l'évolution de vos performances et de vos records personnels."
  />

  <div
    class="prog"
    x-data="progressionApp()"
    x-init="init()"
    x-cloak
  >
    {/* ── Toolbar: summary + sort ── */}
    <div class="prog__toolbar" x-show="exerciseStats.length > 0">
      <div class="prog__summary">
        <div class="prog__summary-item">
          <svg
            class="prog__summary-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6.5 6.5h11v11h-11z"></path>
            <path d="M2 9v6"></path>
            <path d="M22 9v6"></path>
            <path d="M6.5 6.5L2 9"></path>
            <path d="M17.5 6.5L22 9"></path>
            <path d="M6.5 17.5L2 15"></path>
            <path d="M17.5 17.5L22 15"></path>
          </svg>
          <span class="prog__summary-value" x-text="exerciseStats.length"></span>
          <span class="prog__summary-label">exercice<span x-show="exerciseStats.length > 1">s</span></span>
        </div>
        <div class="prog__summary-item">
          <svg
            class="prog__summary-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
            <polyline points="16 7 22 7 22 13"></polyline>
          </svg>
          <span class="prog__summary-value" x-text="formatNumber(max1RM)"></span>
          <span class="prog__summary-label">kg max 1RM</span>
        </div>
        <div class="prog__summary-item">
          <svg
            class="prog__summary-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span class="prog__summary-value" x-text="totalSessions"></span>
          <span class="prog__summary-label">séance<span x-show="totalSessions > 1">s</span></span>
        </div>
      </div>
    </div>

    {/* ── Grid of exercise progression cards ── */}
    <template x-if="exerciseStats.length > 0">
      <div class="prog__grid">
        <template x-for="stat in exerciseStats" :key="stat.exerciseId">
          <Card hover={true}>
            <article class="prog__item">
              <header class="prog__item-head">
                <div class="prog__item-title">
                  <svg
                    class="prog__item-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M6.5 6.5h11v11h-11z"></path>
                    <path d="M2 9v6"></path>
                    <path d="M22 9v6"></path>
                    <path d="M6.5 6.5L2 9"></path>
                    <path d="M17.5 6.5L22 9"></path>
                    <path d="M6.5 17.5L2 15"></path>
                    <path d="M17.5 17.5L22 15"></path>
                  </svg>
                  <h3 class="prog__item-name" x-text="stat.name"></h3>
                </div>
                <span class="prog__muscle-badge" x-text="stat.muscle"></span>
              </header>

              <div class="prog__item-stats">
                <div class="prog__stat prog__stat--hero">
                  <span class="prog__stat-label">Meilleur 1RM</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value" x-text="formatNumber(stat.estimated1RM)"></span>
                    <span class="prog__stat-unit">kg</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">Meilleur poids</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value" x-text="formatNumber(stat.bestWeight)"></span>
                    <span class="prog__stat-unit">kg</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">Reps max</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value" x-text="stat.bestReps"></span>
                    <span class="prog__stat-unit">reps</span>
                  </div>
                </div>
                <div class="prog__stat">
                  <span class="prog__stat-label">Date</span>
                  <div class="prog__stat-value-row">
                    <span class="prog__stat-value prog__stat-value--sm" x-text="formatDate(stat.date)"></span>
                  </div>
                </div>
              </div>

              <footer class="prog__item-foot">
                <div class="prog__meta">
                  <svg
                    class="prog__meta-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span x-text="stat.sessionCount"></span>
                  <span class="prog__meta-label">séance<span x-show="stat.sessionCount > 1">s</span></span>
                </div>
                <div class="prog__history" x-show="stat.history.length > 1">
                  <span class="prog__history-label">Historique</span>
                  <div class="prog__history-bar" :title="historyTooltip(stat.history)">
                    <template x-for="(record, idx) in stat.history" :key="idx">
                      <span
                        class="prog__history-tick"
                        :style="{ height: historyBarHeight(stat.history, record.estimated1RM) + '%' }"
                        :title="formatNumber(record.estimated1RM) + ' kg · ' + formatDate(record.date)"
                      ></span>
                    </template>
                  </div>
                </div>
              </footer>
            </article>
          </Card>
        </template>
      </div>
    </template>

    {/* ── Empty state ── */}
    <template x-if="exerciseStats.length === 0">
      <Card>
        <EmptyState
          title="Pas encore de données"
          description="Enregistrez vos premières séances pour visualiser votre progression au fil du temps."
          actionLabel="Démarrer une séance"
          actionHref="/seances/creer"
        />
      </Card>
    </template>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    calculate1RM,
    type SessionExercise,
    type ProgressRecord,
  } from '../../lib/storage';

  /**
   * Per-exercise progression row.
   * - `best` is the highest-1RM ProgressRecord found in any session.
   * - `history` is the full series of ProgressRecords, oldest → newest.
   * - `sessionCount` is the number of sessions that included this exercise.
   */
  interface ExerciseProgression {
    exerciseId: string;
    name: string;
    muscle: string;
    estimated1RM: number;
    bestWeight: number;
    bestReps: number;
    date: string;
    sessionCount: number;
    history: ProgressRecord[];
  }

  function fmtNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString('fr-FR');
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('progressionApp', () => ({
      // ── State ──
      exerciseStats: [] as ExerciseProgression[],

      // ── Init ──
      init() {
        this.recompute();
      },

      // ── Derived ──
      get totalSessions(): number {
        return getSessions().length;
      },

      get max1RM(): number {
        let max = 0;
        for (const stat of this.exerciseStats) {
          if (stat.estimated1RM > max) max = stat.estimated1RM;
        }
        return max;
      },

      // ── Computations ──
      recompute() {
        const sessions = getSessions();
        const map = new Map<string, ExerciseProgression>();

        for (const session of sessions) {
          for (const ex of session.exercises) {
            this.accumulateExercise(map, ex, session.date);
          }
        }

        this.exerciseStats = Array.from(map.values()).sort(
          (a, b) => b.estimated1RM - a.estimated1RM,
        );
      },

      accumulateExercise(
        map: Map<string, ExerciseProgression>,
        ex: SessionExercise,
        sessionDate: string,
      ) {
        let stat = map.get(ex.exerciseId);
        if (!stat) {
          stat = {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            estimated1RM: 0,
            bestWeight: 0,
            bestReps: 0,
            date: '',
            sessionCount: 0,
            history: [],
          };
          map.set(ex.exerciseId, stat);
        }
        stat.sessionCount += 1;

        for (const set of ex.sets) {
          if (!set.completed) continue;
          const record: ProgressRecord = {
            exerciseId: ex.exerciseId,
            date: sessionDate,
            estimated1RM: calculate1RM(set.weight, set.reps),
            bestWeight: set.weight,
            bestReps: set.reps,
          };
          stat.history.push(record);
          if (record.estimated1RM > stat.estimated1RM) {
            stat.estimated1RM = record.estimated1RM;
            stat.bestWeight = record.bestWeight;
            stat.bestReps = record.bestReps;
            stat.date = record.date;
          }
        }
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return fmtNum(n);
      },

      formatDate(iso: string): string {
        return fmtDate(iso);
      },

      /**
       * For the mini history bar: percentage height of `value` relative to
       * the max value within the same series (min 8% so single records stay
       * visible).
       */
      historyBarHeight(history: ProgressRecord[], value: number): number {
        if (history.length === 0 || value <= 0) return 0;
        const max = history.reduce((m, r) => (r.estimated1RM > m ? r.estimated1RM : m), 0);
        if (max <= 0) return 8;
        const pct = (value / max) * 100;
        return Math.max(8, Math.min(100, Math.round(pct)));
      },

      historyTooltip(history: ProgressRecord[]): string {
        return history
          .map((r) => `${fmtNum(r.estimated1RM)} kg · ${fmtDate(r.date)}`)
          .join('\n');
      },
    }));
  });
</script>

{/* Alpine.js CDN — MUST be AFTER the app script (type="module" runs before defer) */}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<style>
  /* Hide Alpine elements until initialized (prevents flash) */
  [x-cloak] {
    display: none !important;
  }

  /* ════════════════════════════════════════════════════
     CONTAINER
     ════════════════════════════════════════════════════ */
  .prog {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  /* ════════════════════════════════════════════════════
     TOOLBAR — summary stats
     ════════════════════════════════════════════════════ */
  .prog__toolbar {
    margin-bottom: 0.4rem;
  }

  .prog__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
    padding: 1.6rem 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .prog__summary-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .prog__summary-icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-accent);
    flex-shrink: 0;
    align-self: center;
  }

  .prog__summary-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .prog__summary-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* ════════════════════════════════════════════════════
     GRID — 1 / 2 / 3 columns
     ════════════════════════════════════════════════════ */
  .prog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  @media (min-width: 640px) {
    .prog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .prog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ════════════════════════════════════════════════════
     ITEM — one exercise card
     ════════════════════════════════════════════════════ */
  .prog__item {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-normal);
  }

  .prog__item:hover {
    background-color: var(--color-surface-2);
  }

  .prog__item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }

  .prog__item-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .prog__item-icon {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .prog__item-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    word-break: break-word;
  }

  .prog__muscle-badge {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 1rem;
    background-color: hsl(32 95% 50% / 0.12);
    border: 1px solid hsl(32 95% 50% / 0.30);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
    flex-shrink: 0;
  }

  /* ── Stats grid ── */
  .prog__item-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .prog__stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.2rem 1.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .prog__stat--hero {
    grid-column: 1 / -1;
    background-color: hsl(32 95% 50% / 0.08);
    border-color: hsl(32 95% 50% / 0.30);
  }

  .prog__stat-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .prog__stat-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .prog__stat-value {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .prog__stat--hero .prog__stat-value {
    font-size: 2.8rem;
    color: var(--color-accent);
  }

  .prog__stat-value--sm {
    font-size: 1.4rem;
  }

  .prog__stat-unit {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  /* ── Footer: sessions + history bar ── */
  .prog__item-foot {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.4rem;
  }

  .prog__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-muted);
    font-size: 1.2rem;
  }

  .prog__meta-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  .prog__meta-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .prog__history {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .prog__history-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .prog__history-bar {
    display: flex;
    align-items: flex-end;
    gap: 0.3rem;
    height: 4.8rem;
    padding: 0.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .prog__history-tick {
    flex: 1 1 auto;
    min-width: 0.4rem;
    background-color: hsl(32 95% 50% / 0.55);
    border-radius: 2px;
    transition: background-color 200ms ease;
  }

  .prog__history-tick:first-child {
    background-color: var(--color-accent);
  }

  .prog__history-bar:hover .prog__history-tick {
    background-color: hsl(32 95% 50% / 0.75);
  }

  .prog__history-bar:hover .prog__history-tick:first-child {
    background-color: hsl(32 95% 50% / 0.95);
  }

  /* ════════════════════════════════════════════════════
     RESPONSIVE — small screens
     ════════════════════════════════════════════════════ */
  @media (max-width: 480px) {
    .prog__summary {
      padding: 1.2rem 1.4rem;
      gap: 1rem 1.6rem;
    }
    .prog__summary-value {
      font-size: 1.6rem;
    }
    .prog__item-stats {
      grid-template-columns: 1fr;
    }
    .prog__stat-value {
      font-size: 1.8rem;
    }
    .prog__stat--hero .prog__stat-value {
      font-size: 2.4rem;
    }
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .prog__history-tick,
    .prog__item {
      transition: none;
    }
  }
</style>
