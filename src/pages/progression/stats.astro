---

import { t, setLocale, defaultLocale } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();
---

<AppLayout title={L.stats.title}>
  <PageHeader
    title={L.stats.title}
    description={L.stats.description}
  />

  <div class="stats" x-data="statsApp()" x-init="init()" x-cloak>
    {/* ═══ Top summary row ═══ */}
    <div class="stats__summary">
      <div class="stats__sum stats__sum--hero">
        <span class="stats__sum-label">{L.stats.volumeTotal}</span>
        <div class="stats__sum-value-row">
          <span class="stats__sum-value" x-text="formatNumber(totalVolume12w)"></span>
          <span class="stats__sum-unit">{L.common.kg}</span>
        </div>
        <span class="stats__sum-foot" x-text="sessions12w + ' ' + labels.sessionSingular + (sessions12w > 1 ? 's' : '') + ' ' + labels.completed"></span>
      </div>

      <div class="stats__sum">
        <span class="stats__sum-label">{L.stats.sessions12w}</span>
        <div class="stats__sum-value-row">
          <span class="stats__sum-value" x-text="sessions12w"></span>
        </div>
        <span class="stats__sum-foot">{L.stats.completed}</span>
      </div>

      <div class="stats__sum">
        <span class="stats__sum-label">{L.stats.avgDuration}</span>
        <div class="stats__sum-value-row">
          <span class="stats__sum-value" x-text="formatDuration(avgDuration)"></span>
        </div>
        <span class="stats__sum-foot" x-text="durationSessionCount > 0 ? labels.on + durationSessionCount + ' ' + labels.sessionSingular + (durationSessionCount > 1 ? 's' : '') : labels.noTimed"></span>
      </div>

      <div class="stats__sum">
        <span class="stats__sum-label">{L.stats.regularity}</span>
        <div class="stats__sum-value-row">
          <span class="stats__sum-value" x-text="consistencyPct + '%'"></span>
        </div>
          <span class="stats__sum-foot" x-text="activeWeeks + ' ' + labels.week + ' active' + (activeWeeks > 1 ? 's' : '') + ' / 12'"></span>
      </div>
    </div>

    {/* ═══ Volume chart (12 weeks) ═══ */}
    <Card>
      <CardHeader>
        <div class="stats__chart-head">
          <CardTitle>{L.stats.volumeChart}</CardTitle>
          <span class="stats__chart-meta">{L.stats.last12wKg}</span>
        </div>
      </CardHeader>
      <CardContent>
        <div class="stats__chart-wrap" x-html="renderVolumeChart()"></div>
      </CardContent>
    </Card>

    {/* ═══ Two-col: muscle distribution + training frequency ═══ */}
    <div class="stats__grid">
      <Card>
        <CardHeader>
          <div class="stats__chart-head">
            <CardTitle>{L.stats.volumeByMuscle}</CardTitle>
            <div class="stats__chart-actions">
              <span class="stats__chart-meta" x-text="periodMeta"></span>
              <div class="stats__segmented" role="group" aria-label={L.stats.volumePeriod}>
                <button
                  type="button"
                  class="stats__seg"
                  :class="{ 'is-active': period === 'week' }"
                  @click="period = 'week'"
                >
                  {L.stats.volumePeriodWeek}
                </button>
                <button
                  type="button"
                  class="stats__seg"
                  :class="{ 'is-active': period === 'month' }"
                  @click="period = 'month'"
                >
                  {L.stats.volumePeriodMonth}
                </button>
              </div>
            </div>
          </div>
        </CardHeader>
        <CardContent>
          <div class="stats__chart-wrap" x-html="renderMuscleChart()"></div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <div class="stats__chart-head">
            <CardTitle>{L.stats.freqChart}</CardTitle>
            <span class="stats__chart-meta">{L.stats.last8w}</span>
          </div>
        </CardHeader>
        <CardContent>
          <div class="stats__chart-wrap" x-html="renderFrequencyChart()"></div>
        </CardContent>
      </Card>
    </div>

    {/* ═══ Top 5 exercises ═══ */}
    <Card>
      <CardHeader>
        <div class="stats__chart-head">
          <CardTitle>{L.stats.topExercises}</CardTitle>
          <span class="stats__chart-meta">par volume total (12 sem.)</span>
        </div>
      </CardHeader>
      <CardContent>
        <div class="stats__top-wrap" x-html="renderTopExercises()"></div>
      </CardContent>
    </Card>

    {/* ═══ Benchmarks vs reference data (opt-in local, aucun réseau) ═══ */}
    <Card>
      <CardHeader>
        <div class="stats__chart-head">
          <CardTitle>{L.stats.benchmarksTitle}</CardTitle>
          <span class="stats__chart-meta">{L.stats.benchmarksThresholdHeader} · {L.common.kg}</span>
        </div>
      </CardHeader>
      <CardContent>
        <p class="stats__bench-desc">{L.stats.benchmarksDesc}</p>

        {/* ── Opt-in : enregistre l'INTENTION, ne déclenche AUCUN appel réseau ── */}
        <div class="stats__bench-optin">
          <div class="stats__bench-optin-label">
            <span class="stats__bench-optin-title">{L.stats.benchmarksOptInLabel}</span>
            <span class="stats__bench-optin-hint">{L.stats.benchmarksOptInDesc}</span>
          </div>
          <label class="stats__bench-toggle-wrap">
            <input
              type="checkbox"
              class="sr-only stats__bench-toggle-input"
              role="switch"
              :checked="settings.benchmarksOptIn"
              :aria-checked="settings.benchmarksOptIn ? 'true' : 'false'"
              @change="setBenchmarksOptIn($event.target.checked)"
            />
            <span class="stats__bench-toggle-track">
              <span class="stats__bench-toggle-thumb"></span>
            </span>
          </label>
        </div>

        {/* ── Table des benchmarks (1RM Epley vs références) ── */}
        <div class="stats__chart-wrap" x-html="renderBenchmarksTable()"></div>

        {/* ── Honnêteté des données : source étiquetée, non-communautaire ── */}
        <p class="stats__bench-note">{L.stats.benchmarksSourceNote}</p>
      </CardContent>
    </Card>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getSettings,
    updateSettings,
    calculate1RM,
    type Session,
  } from '../../lib/storage';

  import {
    buildBenchmarkRows,
    type PercentileBand,
  } from '../../lib/benchmarks';

  import { REFERENCE_DATA } from '../../lib/benchmarks-data';

  import { t, getLocale, trExercise, trMuscle } from '../../i18n';

  import {
    volumeByMuscle,
    type MuscleVolumeSlice,
    type VolumePeriod,
  } from '../../lib/volume-stats';

  const LABELS = t();

  // ============================================================================
  // Types
  // ============================================================================

  interface WeekBucket {
    /** Sunday (start) of the week, at 00:00 local. */
    start: Date;
    /** ISO YYYY-MM-DD for the bucket's start (stable key). */
    key: string;
    /** Sum of weight * reps across completed sets. */
    volume: number;
    /** Count of completed sessions. */
    sessionCount: number;
    /** Average duration (seconds) across sessions with a recorded duration. */
    durationSum: number;
    durationCount: number;
  }

  interface TopExercise {
    exerciseId: string;
    name: string;
    muscle: string;
    volume: number;
  }

  // ============================================================================
  // Helpers
  // ============================================================================

  function fmtNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString('fr-FR');
  }

  /** Locale-aware number formatting for the volume-by-muscle card. */
  function fmtLocalNum(n: number): string {
    if (!Number.isFinite(n) || n <= 0) return '0';
    return Math.round(n).toLocaleString(getLocale() === 'fr' ? 'fr-FR' : 'en-US');
  }

  function fmtDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'short',
    });
  }

  function fmtDuration(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds <= 0) return '—';
    const totalMin = Math.round(seconds / 60);
    if (totalMin < 60) return totalMin + ' min';
    const h = Math.floor(totalMin / 60);
    const m = totalMin % 60;
    return m === 0 ? `${h} h` : `${h} h ${m}`;
  }

  /** Palette for the muscle donut (high-hue-distance, theme-agnostic). */
  const MUSCLE_PALETTE: ReadonlyArray<string> = [
    '#3B82F6', // blue
    '#F97316', // orange
    '#10B981', // emerald
    '#EC4899', // pink
    '#EAB308', // yellow
    '#6366F1', // indigo
    '#D97706', // amber
    '#14B8A6', // teal
    '#EF4444', // red
    '#84CC16', // lime
    '#A855F7', // purple
    '#06B6D4', // cyan
  ];

  // ============================================================================
  // Pure helpers (testable, kept small)
  // ============================================================================

  /** Returns the Sunday (00:00 local) of the week containing `d`. */
  function startOfWeek(d: Date): Date {
    const out = new Date(d);
    out.setDate(d.getDate() - d.getDay()); // getDay(): 0=Sun
    out.setHours(0, 0, 0, 0);
    return out;
  }

  function isoDate(d: Date): string {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  /**
   * Build the last `n` week buckets ending with the current week, oldest
   * first. Each bucket starts on Sunday at 00:00 local time, matching
   * the codebase's `getSessionsThisWeek` convention.
   */
  function buildWeeks(n: number, anchor: Date = new Date()): WeekBucket[] {
    const end = startOfWeek(anchor);
    const buckets: WeekBucket[] = [];
    for (let i = n - 1; i >= 0; i--) {
      const start = new Date(end);
      start.setDate(end.getDate() - i * 7);
      buckets.push({
        start,
        key: isoDate(start),
        volume: 0,
        sessionCount: 0,
        durationSum: 0,
        durationCount: 0,
      });
    }
    return buckets;
  }

  /**
   * Aggregate sessions into a pre-built set of week buckets. Sessions
   * outside the bucket range are ignored. The session's date is parsed
   * as local time (YYYY-MM-DD), so it always lines up with the Sunday
   * bucket it belongs to.
   */
  function aggregateByWeek(
    sessions: Session[],
    buckets: WeekBucket[],
  ): void {
    if (buckets.length === 0) return;
    const minKey = buckets[0].key;
    const maxKey = buckets[buckets.length - 1].key;
    const idxByKey = new Map(buckets.map((b, i) => [b.key, i] as const));

    for (const session of sessions) {
      if (session.status !== 'completed') continue;
      if (!session.date) continue;

      // Date string YYYY-MM-DD → local Date at midnight (matches bucket keys).
      const d = new Date(session.date + 'T00:00:00');
      if (isNaN(d.getTime())) continue;
      const sessionKey = isoDate(d);
      if (sessionKey < minKey || sessionKey > maxKey) continue;

      const idx = idxByKey.get(sessionKey);
      if (idx === undefined) continue;
      const bucket = buckets[idx];
      bucket.sessionCount += 1;

      if (typeof session.duration === 'number' && session.duration > 0) {
        bucket.durationSum += session.duration;
        bucket.durationCount += 1;
      }

      for (const ex of session.exercises) {
        for (const set of ex.sets) {
          if (!set.completed) continue;
          bucket.volume += set.weight * set.reps;
        }
      }
    }
  }

  /** Top N exercises by volume, descending. */
  function topExercisesByVolume(
    sessions: Session[],
    n: number,
    weekCount: number,
  ): TopExercise[] {
    const buckets = buildWeeks(weekCount);
    const minKey = buckets[0].key;
    const maxKey = buckets[buckets.length - 1].key;
    const totals = new Map<string, TopExercise>();

    for (const session of sessions) {
      if (session.status !== 'completed') continue;
      if (!session.date) continue;
      if (session.date < minKey || session.date > maxKey) continue;

      for (const ex of session.exercises) {
        let total = totals.get(ex.exerciseId)?.volume ?? 0;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          total += set.weight * set.reps;
        }
        if (total > 0) {
          totals.set(ex.exerciseId, {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            volume: total,
          });
        }
      }
    }

    return Array.from(totals.values())
      .sort((a, b) => b.volume - a.volume)
      .slice(0, n);
  }

// ============================================================================
// SVG renderers
// ============================================================================

/**
 * Badge de bande percentile pour les benchmarks (« ≥ 50ᵉ », « ≥ 75ᵉ »,
 * « ≥ 90ᵉ »). Bandes sous le p50 (below-p25 / p25-p50) → aucun badge : la
 * performance reste sous la médiane. `null` → aucun badge (pas de valeur).
 */
function benchmarkBadge(band: PercentileBand | null): string {
  const lower: Record<string, string> = {
    'p50-p75': '50',
    'p75-p90': '75',
    'p90+': '90',
  };
  if (!band || !(band in lower)) return '';
  return `<span class="stats__bench-badge">≥ ${lower[band]}ᵉ</span>`;
}

  function svgEscape(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('statsApp', () => ({
      // ── Labels ──
      labels: {
        sessionSingular: LABELS.stats.sessionSingular,
        completed: LABELS.stats.completed,
        on: LABELS.records.on,
        week: LABELS.stats.week,
        noTimed: LABELS.stats.noTimed,
      },

      // ── Aggregated state ──
      weeks12: [] as WeekBucket[],
      weeks8: [] as WeekBucket[],
      sessions12w: 0,
      totalVolume12w: 0,
      activeWeeks: 0,
      consistencyPct: 0,
      avgDuration: 0,
      durationSessionCount: 0,
      period: 'week' as VolumePeriod,
      muscleWeek: [] as MuscleVolumeSlice[],
      muscleMonth: [] as MuscleVolumeSlice[],
      top5: [] as TopExercise[],

      // ── Benchmarks (V1 locale, référence étiquetée) ──
      settings: getSettings(),
      hasCompletedSessions: false,
      benchmarkRows: [] as Array<{
        exercise: string;
        userValue: number | null;
        band: PercentileBand | null;
        p50: number;
        p75: number;
        p90: number;
      }>,

      // ── Init ──
      init() {
        const sessions = getSessions();

        this.weeks12 = buildWeeks(12);
        aggregateByWeek(sessions, this.weeks12);
        this.sessions12w = this.weeks12.reduce((s, b) => s + b.sessionCount, 0);
        this.totalVolume12w = this.weeks12.reduce((s, b) => s + b.volume, 0);
        this.activeWeeks = this.weeks12.filter((b) => b.sessionCount > 0).length;
        this.consistencyPct = Math.round((this.activeWeeks / 12) * 100);

        const totalDur = this.weeks12.reduce((s, b) => s + b.durationSum, 0);
        const durCount = this.weeks12.reduce((s, b) => s + b.durationCount, 0);
        this.avgDuration = durCount > 0 ? totalDur / durCount : 0;
        this.durationSessionCount = durCount;

        this.weeks8 = buildWeeks(8);
        aggregateByWeek(sessions, this.weeks8);

        this.muscleWeek = volumeByMuscle(sessions, { period: 'week' });
        this.muscleMonth = volumeByMuscle(sessions, { period: 'month' });
        this.top5 = topExercisesByVolume(sessions, 5, 12);

        // ── Benchmarks (séances terminées uniquement) ──
        this.settings = getSettings();
        this.hasCompletedSessions = sessions.some(
          (s) => s.status === 'completed',
        );
        this.benchmarkRows = buildBenchmarkRows(sessions, REFERENCE_DATA);
      },

      // ── Derived (volume-by-muscle donut) ──
      get slices(): MuscleVolumeSlice[] {
        return this.period === 'week' ? this.muscleWeek : this.muscleMonth;
      },

      get periodMeta(): string {
        return this.period === 'week'
          ? LABELS.stats.volumeLast7d
          : LABELS.stats.volumeLast30d;
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return fmtNum(n);
      },
      formatDate(iso: string): string {
        return fmtDate(iso);
      },
      formatDuration(seconds: number): string {
        return fmtDuration(seconds);
      },

      // ════════════════════════════════════════════════════════
      // SVG: 12-week volume bar chart
      // ════════════════════════════════════════════════════════
      renderVolumeChart(): string {
        const W = 1000;
        const H = 280;
        const PAD_L = 50;
        const PAD_R = 16;
        const PAD_T = 16;
        const PAD_B = 48;
        const plotW = W - PAD_L - PAD_R;
        const plotH = H - PAD_T - PAD_B;

        if (this.weeks12.length === 0) {
          return `<p class="stats__empty">${LABELS.common.noData}</p>`;
        }

        const maxVol = this.weeks12.reduce(
          (m, b) => (b.volume > m ? b.volume : m),
          0,
        );
        const peak = maxVol > 0 ? maxVol * 1.1 : 1;

        // Y-axis ticks at 0, 25, 50, 75, 100%.
        const ticks = 4;
        const tickPositions: { y: number; value: number }[] = [];
        for (let i = 0; i <= ticks; i++) {
          tickPositions.push({
            value: (peak * i) / ticks,
            y: PAD_T + (1 - i / ticks) * plotH,
          });
        }

        // Bar geometry.
        const slotW = plotW / this.weeks12.length;
        const barW = Math.max(8, slotW * 0.62);
        const barGap = (slotW - barW) / 2;

        // X labels: show first, every 2nd, and last to avoid clutter.
        const labelIdxs: number[] = [];
        this.weeks12.forEach((_, i) => {
          if (
            i === 0 ||
            i === this.weeks12.length - 1 ||
            i % 2 === 0
          ) {
            labelIdxs.push(i);
          }
        });

        let svg = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="stats__chart" role="img" aria-label="${LABELS.stats.volumeChart}">`;

        // Grid + Y labels
        for (const t of tickPositions) {
          svg += `<line x1="${PAD_L}" y1="${t.y.toFixed(1)}" x2="${W - PAD_R}" y2="${t.y.toFixed(1)}" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>`;
          svg += `<text x="${PAD_L - 8}" y="${(t.y + 4).toFixed(1)}" font-size="13" fill="#9CA3AF" text-anchor="end" font-family="var(--font-body, sans-serif)">${fmtNum(t.value)}</text>`;
        }

        // Bars
        const accentCurrent = '#D97706';
        const accentMuted = 'rgba(217, 119, 6, 0.55)';
        this.weeks12.forEach((b, i) => {
          const x = PAD_L + i * slotW + barGap;
          const h = peak > 0 ? (b.volume / peak) * plotH : 0;
          const y = PAD_T + plotH - h;
          const isCurrent = i === this.weeks12.length - 1;
          const fill = isCurrent ? accentCurrent : accentMuted;
          const heightPx = Math.max(0, h);
          svg += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${heightPx.toFixed(1)}" rx="2" fill="${fill}"><title>${fmtDate(b.key)} · ${fmtNum(b.volume)} ${LABELS.common.kg}</title></rect>`;
        });

        // X axis baseline
        svg += `<line x1="${PAD_L}" y1="${(PAD_T + plotH).toFixed(1)}" x2="${W - PAD_R}" y2="${(PAD_T + plotH).toFixed(1)}" stroke="var(--color-border, #2a2a2a)" stroke-width="1"/>`;

        // X labels
        for (const i of labelIdxs) {
          const b = this.weeks12[i];
          const cx = PAD_L + i * slotW + slotW / 2;
          svg += `<text x="${cx.toFixed(1)}" y="${(PAD_T + plotH + 24).toFixed(1)}" font-size="12" fill="#9CA3AF" text-anchor="middle" font-family="var(--font-body, sans-serif)">${fmtDate(b.key)}</text>`;
        }

        svg += `</svg>`;
        return svg;
      },

      // ════════════════════════════════════════════════════════
      // SVG: Volume-by-muscle donut (period-selectable)
      // Segments = circles with stroke-dasharray/dashoffset so each
      // group is a ring arc starting at 12 o'clock. A full-circle
      // single slice is handled naturally: gapLen clamps to 0.
      // ════════════════════════════════════════════════════════
      renderMuscleChart(): string {
        const slices = this.slices;
        if (slices.length === 0) {
          return `<p class="stats__empty">${LABELS.stats.volumeEmpty}</p>`;
        }

        const W = 300;
        const H = 300;
        const cx = W / 2;
        const cy = H / 2;
        const r = 100;
        const thickness = 14;
        const C = 2 * Math.PI * r;

        // Ring arcs, biggest share first (stabilises the palette order).
        let arcs = '';
        let cursor = 0; // cumulative share already drawn (0..1)
        for (let i = 0; i < slices.length; i++) {
          const sl = slices[i];
          const frac = sl.pct / 100;
          const segLen = C * frac;
          const gapLen = Math.max(0, C - segLen);
          const offset = -(C * cursor);
          cursor += frac;

          const color = MUSCLE_PALETTE[i % MUSCLE_PALETTE.length];
          const tip = `${svgEscape(trMuscle(sl.muscle))} · ${fmtLocalNum(sl.volume)} ${LABELS.common.kg} · ${Math.round(sl.pct)}%`;
          arcs += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="${thickness}" stroke-dasharray="${segLen.toFixed(2)} ${gapLen.toFixed(2)}" stroke-dashoffset="${offset.toFixed(2)}" tabindex="0"><title>${tip}</title></circle>`;
        }

        const total = slices.reduce((s, sl) => s + sl.volume, 0);

        const legend = slices
          .map((sl, i) => {
            const color = MUSCLE_PALETTE[i % MUSCLE_PALETTE.length];
            const name = svgEscape(trMuscle(sl.muscle));
            const tip = `${name} · ${fmtLocalNum(sl.volume)} ${LABELS.common.kg} · ${Math.round(sl.pct)}%`;
            return `
              <li class="stats__legend-row" title="${tip}">
                <span class="stats__legend-swatch" style="background: ${color}" aria-hidden="true"></span>
                <span class="stats__legend-name">${name}</span>
                <span class="stats__legend-pct">${Math.round(sl.pct)}%</span>
                <span class="stats__legend-value">${fmtLocalNum(sl.volume)} ${LABELS.common.kg}</span>
              </li>`;
          })
          .join('');

        return `
<div class="stats__donut">
  <svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="stats__donut-svg" role="img" aria-label="${LABELS.stats.volumeByMuscle}">
    <g transform="rotate(-90 ${cx} ${cy})">
      ${arcs}
    </g>
    <text x="${cx}" y="${cy - 4}" font-size="13" fill="var(--color-muted)" text-anchor="middle" font-family="var(--font-body, sans-serif)" letter-spacing="0.1em">${LABELS.stats.total.toUpperCase()}</text>
    <text x="${cx}" y="${cy + 20}" font-size="22" fill="var(--color-accent)" text-anchor="middle" font-family="var(--font-display, sans-serif)" font-weight="700">${fmtLocalNum(total)} ${LABELS.common.kg}</text>
  </svg>
  <ul class="stats__donut-legend" aria-label="${LABELS.stats.volumeByMuscle}">
    ${legend}
  </ul>
</div>`.trim();
      },

      // ════════════════════════════════════════════════════════
      // SVG: 8-week training frequency bar chart
      // ════════════════════════════════════════════════════════
      renderFrequencyChart(): string {
        const W = 480;
        const H = 280;
        const PAD_L = 40;
        const PAD_R = 16;
        const PAD_T = 16;
        const PAD_B = 48;
        const plotW = W - PAD_L - PAD_R;
        const plotH = H - PAD_T - PAD_B;

        if (this.weeks8.length === 0) {
          return `<p class="stats__empty">${LABELS.common.noData}</p>`;
        }

        const maxCount = this.weeks8.reduce(
          (m, b) => (b.sessionCount > m ? b.sessionCount : m),
          0,
        );
        // Round the Y peak up to the next integer so the grid has nice labels.
        const peak = Math.max(1, maxCount);

        const ticks = Math.min(4, peak);
        const tickPositions: { y: number; value: number }[] = [];
        for (let i = 0; i <= ticks; i++) {
          tickPositions.push({
            value: (peak * i) / ticks,
            y: PAD_T + (1 - i / ticks) * plotH,
          });
        }

        const slotW = plotW / this.weeks8.length;
        const barW = Math.max(10, slotW * 0.55);
        const barGap = (slotW - barW) / 2;

        // X labels: every week (only 8 buckets).
        const labelIdxs = this.weeks8.map((_, i) => i);

        let svg = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="stats__chart" role="img" aria-label="${LABELS.stats.freqChart}">`;

        for (const t of tickPositions) {
          svg += `<line x1="${PAD_L}" y1="${t.y.toFixed(1)}" x2="${W - PAD_R}" y2="${t.y.toFixed(1)}" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>`;
          svg += `<text x="${PAD_L - 8}" y="${(t.y + 4).toFixed(1)}" font-size="12" fill="#9CA3AF" text-anchor="end" font-family="var(--font-body, sans-serif)">${Math.round(t.value)}</text>`;
        }

        const accent = '#D97706';
        const accentSoft = 'rgba(217, 119, 6, 0.55)';
        this.weeks8.forEach((b, i) => {
          const x = PAD_L + i * slotW + barGap;
          const h = peak > 0 ? (b.sessionCount / peak) * plotH : 0;
          const y = PAD_T + plotH - h;
          const isCurrent = i === this.weeks8.length - 1;
          const fill = isCurrent ? accent : accentSoft;
          svg += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${Math.max(0, h).toFixed(1)}" rx="2" fill="${fill}"><title>${fmtDate(b.key)} · ${b.sessionCount} ${LABELS.stats.sessionSingular}${b.sessionCount > 1 ? 's' : ''}</title></rect>`;
        });

        svg += `<line x1="${PAD_L}" y1="${(PAD_T + plotH).toFixed(1)}" x2="${W - PAD_R}" y2="${(PAD_T + plotH).toFixed(1)}" stroke="var(--color-border, #2a2a2a)" stroke-width="1"/>`;

        for (const i of labelIdxs) {
          const b = this.weeks8[i];
          const cx = PAD_L + i * slotW + slotW / 2;
          svg += `<text x="${cx.toFixed(1)}" y="${(PAD_T + plotH + 24).toFixed(1)}" font-size="11" fill="#9CA3AF" text-anchor="middle" font-family="var(--font-body, sans-serif)">${fmtDate(b.key)}</text>`;
        }

        svg += `</svg>`;
        return svg;
      },

      // ════════════════════════════════════════════════════════
      // Top 5 exercises — HTML bars
      // ════════════════════════════════════════════════════════
      renderTopExercises(): string {
        if (this.top5.length === 0) {
          return `<p class="stats__empty">${LABELS.stats.noData}</p>`;
        }

        const peak = this.top5[0].volume;
        const items = this.top5
          .map((item, idx) => {
            const pct = peak > 0 ? (item.volume / peak) * 100 : 0;
            const rank = idx + 1;
            return `
              <li class="stats__top-row">
                <span class="stats__top-rank">${rank}</span>
                <div class="stats__top-main">
                  <div class="stats__top-head">
                    <span class="stats__top-name">${svgEscape(trExercise(item.name))}</span>
                    <span class="stats__top-muscle">${svgEscape(trMuscle(item.muscle))}</span>
                    <span class="stats__top-value">${fmtNum(item.volume)} ${LABELS.common.kg}</span>
                  </div>
                  <div class="stats__top-bar" role="presentation">
                    <span class="stats__top-fill" style="width: ${pct.toFixed(1)}%"></span>
                  </div>
                </div>
              </li>
            `;
          })
          .join('');

        return `<ol class="stats__top-list">${items}</ol>`;
      },

      // ════════════════════════════════════════════════════════
      // Benchmarks — opt-in (intention ONLY ; aucun réseau) + table
      // ════════════════════════════════════════════════════════
      setBenchmarksOptIn(checked: boolean) {
        // Persiste l'intention dans Settings. Aucun fetch/envioi réseau :
        // l'upload anonyme arrivera avec la synchronisation serveur.
        this.settings = updateSettings({ benchmarksOptIn: checked });
      },

      renderBenchmarksTable(): string {
        if (!this.hasCompletedSessions) {
          return `<p class="stats__empty">${svgEscape(LABELS.stats.benchmarksEmpty)}</p>`;
        }

        const head = `
          <thead>
            <tr>
              <th>${svgEscape(LABELS.stats.benchmarksColExercise)}</th>
              <th>${svgEscape(LABELS.stats.benchmarksColYour1RM)}</th>
              <th>${LABELS.stats.benchmarksPctl50}</th>
              <th>${LABELS.stats.benchmarksPctl75}</th>
              <th>${LABELS.stats.benchmarksPctl90}</th>
            </tr>
          </thead>`;

        const body = this.benchmarkRows
          .map((row) => {
            const value =
              row.userValue != null
                ? `<span class="stats__bench-num">${fmtLocalNum(row.userValue)} ${LABELS.common.kg}</span>`
                : '—';
            const isTop = row.band === 'p75-p90' || row.band === 'p90+';
            return `
              <tr class="stats__bench-row${isTop ? ' stats__bench-row--top' : ''}">
                <th scope="row">${svgEscape(trExercise(row.exercise))}</th>
                <td class="stats__bench-value">${value}${benchmarkBadge(row.band)}</td>
                <td>${fmtLocalNum(row.p50)}</td>
                <td>${fmtLocalNum(row.p75)}</td>
                <td>${fmtLocalNum(row.p90)}</td>
              </tr>`;
          })
          .join('');

        const anyMissing = this.benchmarkRows.some((r) => r.userValue == null);
        const legend = anyMissing
          ? `<p class="stats__bench-legend">— : ${svgEscape(LABELS.stats.benchmarksNoBands)}</p>`
          : '';

        return `
          <div class="stats__bench-scroll" role="region" aria-label="${LABELS.stats.benchmarksTitle}">
            <table class="stats__bench-table">
              ${head}
              <tbody>${body}</tbody>
            </table>
            ${legend}
          </div>`;
      },
    }));
  });
</script>

