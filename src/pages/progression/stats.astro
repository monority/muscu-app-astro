---
import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import PanelHeader from '../../components/ui/PanelHeader.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Toggle from '../../components/ui/Toggle.astro';
const L = t();
---

<AppLayout title={L.stats.title}>
  <PageHeader
    title={L.stats.title}
    description={L.stats.description}
  />

  <div
    class="pb-24 flex flex-col gap-[1.8rem]"
    x-data="statsApp()"
    x-init="init()"
    x-cloak
  >
    <div
      class="flex flex-col items-start gap-2 py-8 border-y border-[var(--color-border)]"
      x-show="!hasCompletedSessions"
      x-cloak
      role="status"
    >
      <span class="text-display text-[clamp(2rem,4vw,3rem)] font-bold text-[var(--color-text)]">{L.stats.noData}</span>
      <p class="max-w-42rem m-0 text-[var(--color-muted)] text-[1.4rem]">{L.stats.empty}</p>
      <a
        href={localizedPath("/sessions/create")}
        class="inline-flex items-center min-h-[4.4rem] mt-2 px-[1.8rem] rounded-[var(--radius-sm)] bg-[var(--color-accent)] text-[var(--color-accent-foreground)] text-[1.3rem] font-bold no-underline"
      >{L.common.startSession}</a>
    </div>

    <div class="flex flex-col gap-0" x-show="hasCompletedSessions" x-cloak>
    {/* ═══ Top summary row ═══ */}
    <div class="stats__summary grid grid-cols-2 gap-0 border-y border-[var(--color-border)] md:grid-cols-4">
      <div class="stats__sum stats__sum--hero flex flex-col gap-1 min-w-0 py-[1.6rem] px-[1.8rem] bg-transparent border-0 border-b border-[var(--color-border)] rounded-none max-md:[&:nth-child(even)]:border-l max-md:border-[var(--color-border)] md:border-b-0 md:[&+*]:border-l md:border-[var(--color-border)]">
        <span class="stats__sum-label text-[1.0rem] uppercase tracking-[0.14em] text-[var(--color-muted)] font-bold">{L.stats.volumeTotal}</span>
        <div class="stats__sum-value-row flex items-baseline gap-1">
          <span class="stats__sum-value text-display text-[2.6rem] font-bold text-[var(--color-accent)] tabular-nums leading-[1.1]" x-text="formatNumber(totalVolume12w)"></span>
          <span class="stats__sum-unit font-[var(--font-body)] text-[1.3rem] text-[var(--color-muted)] font-semibold">{L.common.kg}</span>
        </div>
        <span class="stats__sum-foot text-[1.1rem] text-[var(--color-muted)]" x-text="sessions12w + ' ' + labels.sessionSingular + (sessions12w > 1 ? 's' : '') + ' ' + labels.completed"></span>
      </div>

      <div class="stats__sum flex flex-col gap-1 min-w-0 py-[1.6rem] px-[1.8rem] bg-transparent border-0 border-b border-[var(--color-border)] rounded-none max-md:[&:nth-child(even)]:border-l max-md:border-[var(--color-border)] md:border-b-0 md:[&+*]:border-l md:border-[var(--color-border)]">
        <span class="stats__sum-label text-[1.0rem] uppercase tracking-[0.14em] text-[var(--color-muted)] font-bold">{L.stats.sessions12w}</span>
        <div class="stats__sum-value-row flex items-baseline gap-1">
          <span class="stats__sum-value text-display text-[2.4rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="sessions12w"></span>
        </div>
        <span class="stats__sum-foot text-[1.1rem] text-[var(--color-muted)]">{L.stats.completed}</span>
      </div>

      <div class="stats__sum flex flex-col gap-1 min-w-0 py-[1.6rem] px-[1.8rem] bg-transparent border-0 border-b border-[var(--color-border)] rounded-none max-md:[&:nth-child(even)]:border-l max-md:border-[var(--color-border)] md:border-b-0 md:[&+*]:border-l md:border-[var(--color-border)]">
        <span class="stats__sum-label text-[1.0rem] uppercase tracking-[0.14em] text-[var(--color-muted)] font-bold">{L.stats.avgDuration}</span>
        <div class="stats__sum-value-row flex items-baseline gap-1">
          <span class="stats__sum-value text-display text-[2.4rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="formatDuration(avgDuration)"></span>
        </div>
        <span class="stats__sum-foot text-[1.1rem] text-[var(--color-muted)]" x-text="durationSessionCount > 0 ? labels.on + durationSessionCount + ' ' + labels.sessionSingular + (durationSessionCount > 1 ? 's' : '') : labels.noTimed"></span>
      </div>

      <div class="stats__sum flex flex-col gap-1 min-w-0 py-[1.6rem] px-[1.8rem] bg-transparent border-0 border-b border-[var(--color-border)] rounded-none max-md:[&:nth-child(even)]:border-l max-md:border-[var(--color-border)] md:border-b-0 md:[&+*]:border-l md:border-[var(--color-border)]">
        <span class="stats__sum-label text-[1.0rem] uppercase tracking-[0.14em] text-[var(--color-muted)] font-bold">{L.stats.regularity}</span>
        <div class="stats__sum-value-row flex items-baseline gap-1">
          <span class="stats__sum-value text-display text-[2.4rem] font-bold text-[var(--color-text)] tabular-nums leading-[1.1]" x-text="consistencyPct + '%'"></span>
        </div>
          <span class="stats__sum-foot text-[1.1rem] text-[var(--color-muted)]" x-text="activeWeeks + ' ' + (activeWeeks > 1 ? labels.activeWeeks : labels.activeWeek) + ' / 12'"></span>
      </div>
    </div>

    {/* ═══ Volume chart (12 weeks) ═══ */}
    <Card>
      <PanelHeader title={L.stats.volumeChart} meta={L.stats.last12wKg} />
      <CardContent>
        <div class="stats__chart-wrap w-full overflow-x-auto" x-html="renderVolumeChart()"></div>
      </CardContent>
    </Card>

    {/* ═══ Two-col: muscle distribution + training frequency ═══ */}
    <div class="stats__grid grid grid-cols-1 gap-4 lg:grid-cols-2">
      <Card>
        <div class="flex items-baseline justify-between gap-4 flex-wrap">
          <PanelHeader title={L.stats.volumeByMuscle} />
          <div class="flex items-center gap-4 flex-wrap">
              <span class="stats__chart-meta text-[1.1rem] uppercase tracking-[0.10em] text-[var(--color-muted)] font-bold" x-text="periodMeta"></span>
              <Segmented
                items={[
                  { value: 'week', label: L.stats.volumePeriodWeek },
                  { value: 'month', label: L.stats.volumePeriodMonth },
                ]}
                model="period"
                ariaLabel={L.stats.volumePeriod}
              />
            </div>
          </div>
        <CardContent>
          <div class="stats__chart-wrap w-full overflow-x-auto" x-html="renderMuscleChart()"></div>
        </CardContent>
      </Card>

      <Card>
        <PanelHeader title={L.stats.freqChart} meta={L.stats.last8w} />
        <CardContent>
          <div class="stats__chart-wrap w-full overflow-x-auto" x-html="renderFrequencyChart()"></div>
        </CardContent>
      </Card>
    </div>

    {/* ═══ Top 5 exercises ═══ */}
    <Card>
      <PanelHeader title={L.stats.topExercises} meta={L.stats.volumeTotalMeta} />
      <CardContent>
        <div class="stats__top-wrap w-full" x-html="renderTopExercises()"></div>
      </CardContent>
    </Card>

    {/* ═══ Benchmarks vs reference data (opt-in local, aucun réseau) ═══ */}
    <Card>
      <PanelHeader title={L.stats.benchmarksTitle} meta={`${L.stats.benchmarksThresholdHeader} · ${L.common.kg}`} />
      <CardContent>
        <p class="stats__bench-desc text-[1.2rem] text-[var(--color-muted)] m-0 mb-1 leading-[1.4]">{L.stats.benchmarksDesc}</p>

        {/* ── Opt-in : enregistre l'INTENTION, ne déclenche AUCUN appel réseau ── */}
        <div class="stats__bench-optin flex items-center justify-between gap-8 py-[1.4rem] px-[1.6rem] my-[1.2rem] mb-[1.6rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-md)] max-md:flex-col max-md:items-start max-md:gap-2">
          <div class="stats__bench-optin-label flex flex-col gap-[0.3rem] min-w-0">
            <span class="stats__bench-optin-title text-display text-[1.4rem] font-semibold text-[var(--color-text)] leading-[1.2]">{L.stats.benchmarksOptInLabel}</span>
            <span class="stats__bench-optin-hint text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.stats.benchmarksOptInDesc}</span>
          </div>
          <Toggle
            :checked="settings.benchmarksOptIn"
            :aria-checked="settings.benchmarksOptIn ? 'true' : 'false'"
            @change="setBenchmarksOptIn($event.target.checked)"
          />
        </div>

        {/* ── Table des benchmarks (1RM Epley vs références) ── */}
        <div class="stats__chart-wrap w-full overflow-x-auto" x-html="renderBenchmarksTable()"></div>

        {/* ── Honnêteté des données : source étiquetée, non-communautaire ── */}
        <p class="stats__bench-note text-[1.05rem] text-[var(--color-muted)] mt-[1.3rem] mb-0 leading-[1.4]">{L.stats.benchmarksSourceNote}</p>
      </CardContent>
    </Card>
    </div>
  </div>
</AppLayout>

<script>
  import {
    getSessions,
    getSettings,
    updateSettings,
    type Session,
  } from '../../lib/storage';

  import {
    buildBenchmarkRows,
    type PercentileBand,
  } from '../../lib/benchmarks';

  import { REFERENCE_DATA } from '../../lib/benchmarks-data';

  import { t, trExercise, trMuscle } from '../../i18n';

  import { formatDateShort, formatNumber, formatDuration } from '../../lib/format';

  import {
    volumeByMuscle,
    type MuscleVolumeSlice,
    type VolumePeriod,
  } from '../../lib/volume-stats';

  import { cssVar, cssVarAlpha } from '../../lib/css-var';
  import { muscleHue, type MuscleTone } from '../../lib/colors';

  const LABELS = t();

  // ============================================================================
  // Types
  // ============================================================================

  interface WeekBucket {
    /** Sunday (start) of the week, at 00:00 local. */
    start: Date;
    /** ISO YYYY-MM-DD for the bucket's start (stable key). */
    key: string;
    /** Sum of weight * reps across completed sets. */
    volume: number;
    /** Count of completed sessions. */
    sessionCount: number;
    /** Average duration (seconds) across sessions with a recorded duration. */
    durationSum: number;
    durationCount: number;
  }

  interface TopExercise {
    exerciseId: string;
    name: string;
    muscle: string;
    volume: number;
  }

  /**
   * Donut palette — the 6 muscle-category hues from src/styles/tokens.css
   * (`--color-cat-*`), the SAME families the muscle badges render via
   * `muscleHue()` (src/lib/colors.ts) + `badge--cat-<tone>`.
   *
   * This is the "abandon des 12 couleurs, 6 familles thématiques" decision
   * (REFONTE §4 residual) : the previous 12-color MUSCLE_PALETTE is gone.
   * Each slice's color is read live from the theme tokens at render time,
   * so dark/light is honored and donut arcs + legend swatches match the
   * category badges exactly. Unknown muscles (`other`/« Autre ») fall back
   * to the neutral muted tone.
   */
  const CAT_TONE_VAR: Record<string, string> = {
    chest: '--color-cat-chest',
    back: '--color-cat-back',
    shoulders: '--color-cat-shoulders',
    arms: '--color-cat-arms',
    legs: '--color-cat-legs',
    core: '--color-cat-core',
  };

  /** Donut/légende color for a stored muscle key — family token value. */
  function muscleToneColor(muscle: string): string {
    const token = CAT_TONE_VAR[muscleHue(muscle)];
    return cssVar(token || '--color-muted');
  }

  /** One donut slice after aggregation: a whole muscle FAMILY. */
  interface FamilySlice {
    /** Hue family (`muscleHue()` tones chest/back/shoulders/arms/legs/core/other). */
    tone: MuscleTone;
    /** Σ volume of every stored muscle in the family, kg. */
    volume: number;
    /** Family share of the period's total, 0..100 (recomputed from grouped totals). */
    pct: number;
    /** Largest-volume muscle of the family — its translated name labels the arc. */
    dominant: MuscleVolumeSlice;
    /** How many distinct stored muscles share this family (label suffix ×N). */
    count: number;
  }

  /**
   * Donut aggregation (REFONTE §4): group per-muscle slices from
   * `volumeByMuscle()` into the 6 muscle FAMILIES via `muscleHue()`
   * (+ `other`), so the ring shows one arc per hue family — not one
   * per stored muscle (e.g. 5 green leg arcs collapse into one « legs »
   * family arc). pct is recomputed from the grouped totals so the ring
   * still sums to 100%. Families sort by aggregate volume desc; the
   * dominant muscle (largest volume within the family) labels it.
   */
  function groupByFamily(slices: MuscleVolumeSlice[]): FamilySlice[] {
    const byTone = new Map<
      MuscleTone,
      { volume: number; count: number; dominant: MuscleVolumeSlice }
    >();
    for (const sl of slices) {
      const tone = muscleHue(sl.muscle);
      const entry = byTone.get(tone) ?? { volume: 0, count: 0, dominant: sl };
      entry.volume += sl.volume;
      entry.count += 1;
      if (sl.volume > entry.dominant.volume) entry.dominant = sl;
      byTone.set(tone, entry);
    }

    const grouped = Array.from(byTone.entries()).map(([tone, e]) => ({
      tone,
      volume: e.volume,
      pct: 0,
      dominant: e.dominant,
      count: e.count,
    }));
    const total = grouped.reduce((s, g) => s + g.volume, 0);
    for (const g of grouped) {
      g.pct = total > 0 ? (g.volume / total) * 100 : 0;
    }
    return grouped.sort((a, b) => b.volume - a.volume);
  }

  /**
   * Donut/légende label for a family slice: the dominant muscle's
   * translated name (matches the exercise-badge language via `trMuscle`),
   * suffixed ` ×N` when several stored muscles share the family — honest
   * about the aggregation without inventing a family-level name.
   */
  function familyLabel(g: FamilySlice): string {
    const name = trMuscle(g.dominant.muscle);
    return g.count > 1 ? `${name} ×${g.count}` : name;
  }

  // ============================================================================
  // Pure helpers (testable, kept small)
  // ============================================================================

  /** Returns the Sunday (00:00 local) of the week containing `d`. */
  function startOfWeek(d: Date): Date {
    const out = new Date(d);
    out.setDate(d.getDate() - d.getDay()); // getDay(): 0=Sun
    out.setHours(0, 0, 0, 0);
    return out;
  }

  function isoDate(d: Date): string {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  /**
   * Build the last `n` week buckets ending with the current week, oldest
   * first. Each bucket starts on Sunday at 00:00 local time, matching
   * the codebase's `getSessionsThisWeek` convention.
   */
  function buildWeeks(n: number, anchor: Date = new Date()): WeekBucket[] {
    const end = startOfWeek(anchor);
    const buckets: WeekBucket[] = [];
    for (let i = n - 1; i >= 0; i--) {
      const start = new Date(end);
      start.setDate(end.getDate() - i * 7);
      buckets.push({
        start,
        key: isoDate(start),
        volume: 0,
        sessionCount: 0,
        durationSum: 0,
        durationCount: 0,
      });
    }
    return buckets;
  }

  /**
   * Aggregate sessions into a pre-built set of week buckets. Sessions
   * outside the bucket range are ignored. The session's date is parsed
   * as local time (YYYY-MM-DD), so it always lines up with the Sunday
   * bucket it belongs to.
   */
  function aggregateByWeek(
    sessions: Session[],
    buckets: WeekBucket[],
  ): void {
    if (buckets.length === 0) return;
    const minKey = buckets[0].key;
    const maxKey = buckets[buckets.length - 1].key;
    const idxByKey = new Map(buckets.map((b, i) => [b.key, i] as const));

    for (const session of sessions) {
      if (session.status !== 'completed') continue;
      if (!session.date) continue;

      // Date string YYYY-MM-DD → local Date at midnight (matches bucket keys).
      const d = new Date(session.date + 'T00:00:00');
      if (isNaN(d.getTime())) continue;
      const sessionKey = isoDate(d);
      if (sessionKey < minKey || sessionKey > maxKey) continue;

      const idx = idxByKey.get(sessionKey);
      if (idx === undefined) continue;
      const bucket = buckets[idx];
      bucket.sessionCount += 1;

      if (typeof session.duration === 'number' && session.duration > 0) {
        bucket.durationSum += session.duration;
        bucket.durationCount += 1;
      }

      for (const ex of session.exercises) {
        for (const set of ex.sets) {
          if (!set.completed) continue;
          bucket.volume += set.weight * set.reps;
        }
      }
    }
  }

  /** Top N exercises by volume, descending. */
  function topExercisesByVolume(
    sessions: Session[],
    n: number,
    weekCount: number,
  ): TopExercise[] {
    const buckets = buildWeeks(weekCount);
    const minKey = buckets[0].key;
    const maxKey = buckets[buckets.length - 1].key;
    const totals = new Map<string, TopExercise>();

    for (const session of sessions) {
      if (session.status !== 'completed') continue;
      if (!session.date) continue;
      if (session.date < minKey || session.date > maxKey) continue;

      for (const ex of session.exercises) {
        let total = totals.get(ex.exerciseId)?.volume ?? 0;
        for (const set of ex.sets) {
          if (!set.completed) continue;
          total += set.weight * set.reps;
        }
        if (total > 0) {
          totals.set(ex.exerciseId, {
            exerciseId: ex.exerciseId,
            name: ex.name,
            muscle: ex.muscle,
            volume: total,
          });
        }
      }
    }

    return Array.from(totals.values())
      .sort((a, b) => b.volume - a.volume)
      .slice(0, n);
  }

// ============================================================================
// SVG renderers
// ============================================================================

/**
 * Badge de bande percentile pour les benchmarks (« ≥ 50ᵉ », « ≥ 75ᵉ »,
 * « ≥ 90ᵉ »). Bandes sous le p50 (below-p25 / p25-p50) → aucun badge : la
 * performance reste sous la médiane. `null` → aucun badge (pas de valeur).
 */
function benchmarkBadge(band: PercentileBand | null): string {
  const lower: Record<string, string> = {
    'p50-p75': '50',
    'p75-p90': '75',
    'p90+': '90',
  };
  if (!band || !(band in lower)) return '';
  return `<span class="stats__bench-badge">≥ ${lower[band]}ᵉ</span>`;
}

  function svgEscape(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('statsApp', () => ({
      // ── Labels ──
      labels: {
        sessionSingular: LABELS.stats.sessionSingular,
        completed: LABELS.stats.completed,
        on: LABELS.records.on,
        noTimed: LABELS.stats.noTimed,
        activeWeek: LABELS.stats.activeWeek,
        activeWeeks: LABELS.stats.activeWeeks,
      },

      // ── Aggregated state ──
      weeks12: [] as WeekBucket[],
      weeks8: [] as WeekBucket[],
      sessions12w: 0,
      totalVolume12w: 0,
      activeWeeks: 0,
      consistencyPct: 0,
      avgDuration: 0,
      durationSessionCount: 0,
      period: 'week' as VolumePeriod,
      muscleWeek: [] as MuscleVolumeSlice[],
      muscleMonth: [] as MuscleVolumeSlice[],
      top5: [] as TopExercise[],

      // ── Benchmarks (V1 locale, référence étiquetée) ──
      settings: getSettings(),
      hasCompletedSessions: false,
      benchmarkRows: [] as Array<{
        exercise: string;
        userValue: number | null;
        band: PercentileBand | null;
        p50: number;
        p75: number;
        p90: number;
      }>,

      // ── Init ──
      init() {
        const sessions = getSessions();

        this.weeks12 = buildWeeks(12);
        aggregateByWeek(sessions, this.weeks12);
        this.sessions12w = this.weeks12.reduce((s, b) => s + b.sessionCount, 0);
        this.totalVolume12w = this.weeks12.reduce((s, b) => s + b.volume, 0);
        this.activeWeeks = this.weeks12.filter((b) => b.sessionCount > 0).length;
        this.consistencyPct = Math.round((this.activeWeeks / 12) * 100);

        const totalDur = this.weeks12.reduce((s, b) => s + b.durationSum, 0);
        const durCount = this.weeks12.reduce((s, b) => s + b.durationCount, 0);
        this.avgDuration = durCount > 0 ? totalDur / durCount : 0;
        this.durationSessionCount = durCount;

        this.weeks8 = buildWeeks(8);
        aggregateByWeek(sessions, this.weeks8);

        this.muscleWeek = volumeByMuscle(sessions, { period: 'week' });
        this.muscleMonth = volumeByMuscle(sessions, { period: 'month' });
        this.top5 = topExercisesByVolume(sessions, 5, 12);

        // ── Benchmarks (séances terminées uniquement) ──
        this.settings = getSettings();
        this.hasCompletedSessions = sessions.some(
          (s) => s.status === 'completed',
        );
        this.benchmarkRows = buildBenchmarkRows(sessions, REFERENCE_DATA);
      },

      // ── Derived (volume-by-muscle donut) ──
      get slices(): MuscleVolumeSlice[] {
        return this.period === 'week' ? this.muscleWeek : this.muscleMonth;
      },

      get periodMeta(): string {
        return this.period === 'week'
          ? LABELS.stats.volumeLast7d
          : LABELS.stats.volumeLast30d;
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return formatNumber(n);
      },
      formatDate(iso: string): string {
        return formatDateShort(iso);
      },
      formatDuration(seconds: number): string {
        return formatDuration(seconds);
      },

      // ════════════════════════════════════════════════════════
      // SVG: 12-week volume bar chart
      // ════════════════════════════════════════════════════════
      renderVolumeChart(): string {
        const W = 1000;
        const H = 280;
        const PAD_L = 50;
        const PAD_R = 16;
        const PAD_T = 16;
        const PAD_B = 48;
        const plotW = W - PAD_L - PAD_R;
        const plotH = H - PAD_T - PAD_B;

        // Chart colors — read from the design tokens (theme-aware).
        const accent = cssVar('--color-accent');
        const muted = cssVar('--color-muted');
        const grid = cssVar('--color-border');

        if (this.weeks12.length === 0) {
          return `<p class="stats__empty" role="status">${LABELS.common.noData}</p>`;
        }

        const maxVol = this.weeks12.reduce(
          (m, b) => (b.volume > m ? b.volume : m),
          0,
        );
        const peak = maxVol > 0 ? maxVol * 1.1 : 1;

        // Y-axis ticks at 0, 25, 50, 75, 100%.
        const ticks = 4;
        const tickPositions: { y: number; value: number }[] = [];
        for (let i = 0; i <= ticks; i++) {
          tickPositions.push({
            value: (peak * i) / ticks,
            y: PAD_T + (1 - i / ticks) * plotH,
          });
        }

        // Line geometry: the trend is the visual, not a bar widget.
        const slotW = plotW / Math.max(1, this.weeks12.length - 1);
        const baselineY = PAD_T + plotH;
        const points = this.weeks12.map((bucket, i) => ({
          bucket,
          x: this.weeks12.length === 1 ? PAD_L + plotW / 2 : PAD_L + i * slotW,
          y: baselineY - (bucket.volume / peak) * plotH,
        }));

        // X labels: show first, every 2nd, and last to avoid clutter.
        const labelIdxs: number[] = [];
        this.weeks12.forEach((_, i) => {
          if (
            i === 0 ||
            i === this.weeks12.length - 1 ||
            i % 2 === 0
          ) {
            labelIdxs.push(i);
          }
        });

        let svg = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="stats__chart" role="img" aria-label="${LABELS.stats.volumeChart}">`;

        // Grid + Y labels
        for (const t of tickPositions) {
          svg += `<line x1="${PAD_L}" y1="${t.y.toFixed(1)}" x2="${W - PAD_R}" y2="${t.y.toFixed(1)}" stroke="${grid}" stroke-width="1"/>`;
          svg += `<text x="${PAD_L - 8}" y="${(t.y + 4).toFixed(1)}" font-size="13" fill="${muted}" text-anchor="end" font-family="var(--font-body, sans-serif)">${formatNumber(t.value)}</text>`;
        }

        const linePath = points
          .map((point, i) => `${i === 0 ? 'M' : 'L'} ${point.x.toFixed(1)} ${point.y.toFixed(1)}`)
          .join(' ');
        const areaPath = `${linePath} L ${points[points.length - 1].x.toFixed(1)} ${baselineY.toFixed(1)} L ${points[0].x.toFixed(1)} ${baselineY.toFixed(1)} Z`;
        svg += `<path d="${areaPath}" fill="${cssVarAlpha('--color-accent', 0.08)}" aria-hidden="true"/>`;
        svg += `<path d="${linePath}" fill="none" stroke="${accent}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;
        points.forEach((point, i) => {
          const radius = i === points.length - 1 ? 4.5 : 3;
          svg += `<circle cx="${point.x.toFixed(1)}" cy="${point.y.toFixed(1)}" r="${radius}" fill="${accent}"><title>${formatDateShort(point.bucket.key)} · ${formatNumber(point.bucket.volume)} ${LABELS.common.kg}</title></circle>`;
        });

        // X axis baseline
        svg += `<line x1="${PAD_L}" y1="${(PAD_T + plotH).toFixed(1)}" x2="${W - PAD_R}" y2="${(PAD_T + plotH).toFixed(1)}" stroke="${grid}" stroke-width="1"/>`;

        // X labels
        for (const i of labelIdxs) {
          const b = this.weeks12[i];
          const cx = points[i].x;
          svg += `<text x="${cx.toFixed(1)}" y="${(PAD_T + plotH + 24).toFixed(1)}" font-size="12" fill="${muted}" text-anchor="middle" font-family="var(--font-body, sans-serif)">${formatDateShort(b.key)}</text>`;
        }

        svg += `</svg>`;
        return svg;
      },

      // ════════════════════════════════════════════════════════
      // SVG: Volume-by-muscle donut (period-selectable)
      // Slices are FIRST grouped by muscle FAMILY (`muscleHue` → the 6
      // `--color-cat-*` tones + `other`), so the ring shows one arc and
      // legend row per family instead of per stored muscle. Ring arcs
      // keep the same geometry as before: circles with
      // stroke-dasharray/dashoffset, each group a ring arc starting at
      // 12 o'clock (full-circle single family handled naturally: gapLen
      // clamps to 0). Arc and legend come from the same aggregated
      // array, so their order/count always match 1:1.
      // ════════════════════════════════════════════════════════
      renderMuscleChart(): string {
        const groups = groupByFamily(this.slices);
        if (groups.length === 0) {
          return `<p class="stats__empty" role="status">${LABELS.stats.volumeEmpty}</p>`;
        }

        const W = 300;
        const H = 300;
        const cx = W / 2;
        const cy = H / 2;
        const r = 100;
        const thickness = 14;
        const C = 2 * Math.PI * r;

        // Donut colors — token values (same hues as the category badges).
        const accent = cssVar('--color-accent');
        const muted = cssVar('--color-muted');

        // Ring arcs, biggest share first (stabilises the palette order).
        let arcs = '';
        let cursor = 0; // cumulative share already drawn (0..1)
        for (let i = 0; i < groups.length; i++) {
          const g = groups[i];
          const frac = g.pct / 100;
          const segLen = C * frac;
          const gapLen = Math.max(0, C - segLen);
          const offset = -(C * cursor);
          cursor += frac;

          const color = muscleToneColor(g.dominant.muscle);
          const tip = `${svgEscape(familyLabel(g))} · ${formatNumber(g.volume)} ${LABELS.common.kg} · ${Math.round(g.pct)}%`;
          arcs += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="${thickness}" stroke-dasharray="${segLen.toFixed(2)} ${gapLen.toFixed(2)}" stroke-dashoffset="${offset.toFixed(2)}"><title>${tip}</title></circle>`;
        }

        const total = groups.reduce((s, g) => s + g.volume, 0);

        const legend = groups
          .map((g) => {
            const color = muscleToneColor(g.dominant.muscle);
            const name = svgEscape(familyLabel(g));
            const tip = `${name} · ${formatNumber(g.volume)} ${LABELS.common.kg} · ${Math.round(g.pct)}%`;
            return `
              <li class="stats__legend-row" title="${tip}">
                <span class="stats__legend-swatch" style="background: ${color}" aria-hidden="true"></span>
                <span class="stats__legend-name">${name}</span>
                <span class="stats__legend-pct">${Math.round(g.pct)}%</span>
                <span class="stats__legend-value">${formatNumber(g.volume)} ${LABELS.common.kg}</span>
              </li>`;
          })
          .join('');

        return `
<div class="stats__donut">
  <svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="stats__donut-svg" role="img" aria-label="${LABELS.stats.volumeByMuscle}">
    <g transform="rotate(-90 ${cx} ${cy})">
      ${arcs}
    </g>
    <text x="${cx}" y="${cy - 4}" font-size="13" fill="${muted}" text-anchor="middle" font-family="var(--font-body, sans-serif)" letter-spacing="0.1em">${LABELS.stats.total.toUpperCase()}</text>
    <text x="${cx}" y="${cy + 20}" font-size="22" fill="${accent}" text-anchor="middle" font-family="var(--font-display, sans-serif)" font-weight="700">${formatNumber(total)} ${LABELS.common.kg}</text>
  </svg>
  <ul class="stats__donut-legend" aria-label="${LABELS.stats.volumeByMuscle}">
    ${legend}
  </ul>
</div>`.trim();
      },

      // ════════════════════════════════════════════════════════
      // SVG: 8-week training frequency bar chart
      // ════════════════════════════════════════════════════════
      renderFrequencyChart(): string {
        const W = 480;
        const H = 280;
        const PAD_L = 40;
        const PAD_R = 16;
        const PAD_T = 16;
        const PAD_B = 48;
        const plotW = W - PAD_L - PAD_R;
        const plotH = H - PAD_T - PAD_B;

        // Chart colors — read from the design tokens (theme-aware).
        const accent = cssVar('--color-accent');
        const muted = cssVar('--color-muted');
        const grid = cssVar('--color-border');

        if (this.weeks8.length === 0) {
          return `<p class="stats__empty" role="status">${LABELS.common.noData}</p>`;
        }

        const maxCount = this.weeks8.reduce(
          (m, b) => (b.sessionCount > m ? b.sessionCount : m),
          0,
        );
        // Round the Y peak up to the next integer so the grid has nice labels.
        const peak = Math.max(1, maxCount);

        const ticks = Math.min(4, peak);
        const tickPositions: { y: number; value: number }[] = [];
        for (let i = 0; i <= ticks; i++) {
          tickPositions.push({
            value: (peak * i) / ticks,
            y: PAD_T + (1 - i / ticks) * plotH,
          });
        }

        const slotW = plotW / this.weeks8.length;
        const barW = Math.max(10, slotW * 0.55);
        const barGap = (slotW - barW) / 2;

        // X labels: every week (only 8 buckets).
        const labelIdxs = this.weeks8.map((_, i) => i);

        let svg = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" class="stats__chart" role="img" aria-label="${LABELS.stats.freqChart}">`;

        for (const t of tickPositions) {
          svg += `<line x1="${PAD_L}" y1="${t.y.toFixed(1)}" x2="${W - PAD_R}" y2="${t.y.toFixed(1)}" stroke="${grid}" stroke-width="1"/>`;
          svg += `<text x="${PAD_L - 8}" y="${(t.y + 4).toFixed(1)}" font-size="12" fill="${muted}" text-anchor="end" font-family="var(--font-body, sans-serif)">${Math.round(t.value)}</text>`;
        }

        const accentSoft = cssVarAlpha('--color-accent', 0.55);
        this.weeks8.forEach((b, i) => {
          const x = PAD_L + i * slotW + barGap;
          const h = peak > 0 ? (b.sessionCount / peak) * plotH : 0;
          const y = PAD_T + plotH - h;
          const isCurrent = i === this.weeks8.length - 1;
          const fill = isCurrent ? accent : accentSoft;
          svg += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${Math.max(0, h).toFixed(1)}" rx="2" fill="${fill}"><title>${formatDateShort(b.key)} · ${b.sessionCount} ${LABELS.stats.sessionSingular}${b.sessionCount > 1 ? 's' : ''}</title></rect>`;
        });

        svg += `<line x1="${PAD_L}" y1="${(PAD_T + plotH).toFixed(1)}" x2="${W - PAD_R}" y2="${(PAD_T + plotH).toFixed(1)}" stroke="${grid}" stroke-width="1"/>`;

        for (const i of labelIdxs) {
          const b = this.weeks8[i];
          const cx = PAD_L + i * slotW + slotW / 2;
          svg += `<text x="${cx.toFixed(1)}" y="${(PAD_T + plotH + 24).toFixed(1)}" font-size="11" fill="${muted}" text-anchor="middle" font-family="var(--font-body, sans-serif)">${formatDateShort(b.key)}</text>`;
        }

        svg += `</svg>`;
        return svg;
      },

      // ════════════════════════════════════════════════════════
      // Top 5 exercises — HTML bars
      // ════════════════════════════════════════════════════════
      renderTopExercises(): string {
        if (this.top5.length === 0) {
          return `<p class="stats__empty" role="status">${LABELS.stats.noData}</p>`;
        }

        const peak = this.top5[0].volume;
        const items = this.top5
          .map((item, idx) => {
            const pct = peak > 0 ? (item.volume / peak) * 100 : 0;
            const rank = idx + 1;
            return `
              <li class="stats__top-row">
                <span class="stats__top-rank">${rank}</span>
                <div class="stats__top-main">
                  <div class="stats__top-head">
                    <span class="stats__top-name">${svgEscape(trExercise(item.name))}</span>
                    <span class="badge--category badge--cat-${muscleHue(item.muscle)} inline-flex items-center font-semibold whitespace-nowrap rounded-[var(--radius-pill)] px-2 py-0.5 text-[1.0rem] uppercase tracking-wider self-start">${svgEscape(trMuscle(item.muscle))}</span>
                    <span class="stats__top-value">${formatNumber(item.volume)} ${LABELS.common.kg}</span>
                  </div>
                  <div class="stats__top-bar" role="presentation">
                    <span class="stats__top-fill" style="width: ${pct.toFixed(1)}%"></span>
                  </div>
                </div>
              </li>
            `;
          })
          .join('');

        return `<ol class="stats__top-list">${items}</ol>`;
      },

      // ════════════════════════════════════════════════════════
      // Benchmarks — opt-in (intention ONLY ; aucun réseau) + table
      // ════════════════════════════════════════════════════════
      setBenchmarksOptIn(checked: boolean) {
        // Persiste l'intention dans Settings. Aucun fetch/envioi réseau :
        // l'upload anonyme arrivera avec la synchronisation serveur.
        this.settings = updateSettings({ benchmarksOptIn: checked });
      },

      renderBenchmarksTable(): string {
        if (!this.hasCompletedSessions) {
          return `<p class="stats__empty" role="status">${svgEscape(LABELS.stats.benchmarksEmpty)}</p>`;
        }

        const head = `
          <thead>
            <tr>
              <th>${svgEscape(LABELS.stats.benchmarksColExercise)}</th>
              <th>${svgEscape(LABELS.stats.benchmarksColYour1RM)}</th>
              <th>${LABELS.stats.benchmarksPctl50}</th>
              <th>${LABELS.stats.benchmarksPctl75}</th>
              <th>${LABELS.stats.benchmarksPctl90}</th>
            </tr>
          </thead>`;

        const body = this.benchmarkRows
          .map((row) => {
            const value =
              row.userValue != null
                ? `<span class="stats__bench-num">${formatNumber(row.userValue)} ${LABELS.common.kg}</span>`
                : '—';
            const isTop = row.band === 'p75-p90' || row.band === 'p90+';
            return `
              <tr class="stats__bench-row${isTop ? ' stats__bench-row--top' : ''}">
                <th scope="row">${svgEscape(trExercise(row.exercise))}</th>
                <td class="stats__bench-value">${value}${benchmarkBadge(row.band)}</td>
                <td>${formatNumber(row.p50)}</td>
                <td>${formatNumber(row.p75)}</td>
                <td>${formatNumber(row.p90)}</td>
              </tr>`;
          })
          .join('');

        const anyMissing = this.benchmarkRows.some((r) => r.userValue == null);
        const legend = anyMissing
          ? `<p class="stats__bench-legend">— : ${svgEscape(LABELS.stats.benchmarksNoBands)}</p>`
          : '';

        return `
          <div class="stats__bench-scroll" role="region" aria-label="${LABELS.stats.benchmarksTitle}">
            <table class="stats__bench-table">
              ${head}
              <tbody>${body}</tbody>
            </table>
            ${legend}
          </div>`;
      },
    }));
  });
</script>

<style>
  /* ── SVG donut chart: stroke-dasharray / dashoffset arcs ── */
  .stats__donut-svg circle {
    fill: none;
  }
  .stats__donut-svg circle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Benchmarks table (thead / tbody) ── */
  .stats__bench-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.3rem;
  }
  .stats__bench-table th,
  .stats__bench-table td {
    padding: 1rem 1.1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stats__bench-table thead th {
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--color-muted);
    font-weight: 700;
    border-bottom: 1px solid var(--color-border);
  }
  .stats__bench-table thead th:nth-child(n+2) {
    text-align: right;
  }
  .stats__bench-table tbody td {
    color: var(--color-muted);
    text-align: right;
  }
  .stats__bench-table tbody th {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
    word-break: break-word;
    white-space: normal;
  }
  .stats__bench-row:hover {
    background-color: var(--color-surface-2);
  }
  .stats__bench-row--top {
    background-color: color-mix(in srgb, var(--color-success) 12%, transparent);
  }
  .stats__bench-row--top:hover {
    background-color: color-mix(in srgb, var(--color-success) 12%, transparent);
  }
  .stats__bench-value {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-muted);
  }
  .stats__bench-num {
    color: var(--color-text);
  }
  .stats__bench-badge {
    display: inline-flex;
    align-items: center;
    height: 2.2rem;
    padding: 0 0.8rem;
    background-color: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
    font-size: 1.0rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* ── Top-fill gradient (color-mix) ── */
  .stats__top-fill {
    background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 80%, white));
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .stats__top-fill {
      transition: none;
    }
  }

  /* ── Data canvas: charts in document flow, not stacked cards ── */
  :global(.stats__content > .surface),
  :global(.stats__grid > .surface) { background: transparent; border: 0; border-top: 1px solid var(--color-border); border-radius: 0; }
  :global(.stats__content > .surface:last-child) { border-bottom: 1px solid var(--color-border); }
</style>

<style is:global>
