---
import AppLayout from '../layouts/AppLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CardHeader from '../components/ui/CardHeader.astro';
import CardTitle from '../components/ui/CardTitle.astro';
import CardContent from '../components/ui/CardContent.astro';
import CardFooter from '../components/ui/CardFooter.astro';
import Badge from '../components/ui/Badge.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import Checkbox from '../components/ui/Checkbox.astro';
import Toggle from '../components/ui/Toggle.astro';
import Tabs from '../components/ui/Tabs.astro';
import TabList from '../components/ui/TabList.astro';
import TabPanel from '../components/ui/TabPanel.astro';
import Dialog from '../components/ui/Dialog.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Table from '../components/ui/Table.astro';
import TableHead from '../components/ui/TableHead.astro';
import TableBody from '../components/ui/TableBody.astro';
import TableRow from '../components/ui/TableRow.astro';
import TableCell from '../components/ui/TableCell.astro';
import Pagination from '../components/ui/Pagination.astro';
import Tooltip from '../components/ui/Tooltip.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import Avatar from '../components/ui/Avatar.astro';
import Progress from '../components/ui/Progress.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import StatsCard from '../components/workout/StatsCard.astro';
import ExerciseCard from '../components/workout/ExerciseCard.astro';
import WorkoutCard from '../components/workout/WorkoutCard.astro';

const swatches = [
  { name: 'bg', token: '--color-bg', value: '#050505' },
  { name: 'surface', token: '--color-surface', value: '#0B0B0B' },
  { name: 'surface-2', token: '--color-surface-2', value: '#111111' },
  { name: 'surface-3', token: '--color-surface-3', value: '#151515' },
  { name: 'accent', token: '--color-accent', value: 'hsl(32 55% 45%)' },
  { name: 'success', token: '--color-success', value: '#22C55E' },
  { name: 'destructive', token: '--color-destructive', value: '#EF4444' },
  { name: 'warning', token: '--color-warning', value: '#EAB308' },
  { name: 'info', token: '--color-info', value: '#3B82F6' },
  { name: 'muted', token: '--color-muted', value: '#9CA3AF' },
  { name: 'border', token: '--color-border', value: 'hsl(0 0% 100% / 0.08)' },
];

const tabItems = [
  { id: 'overview', label: "Vue d'ensemble" },
  { id: 'specs', label: 'Spécifications' },
  { id: 'reviews', label: 'Avis' },
];

const exerciseSets = [
  { weight: 60, reps: 10, completed: true, type: 'échauff.' },
  { weight: 80, reps: 8, completed: true },
  { weight: 85, reps: 8, completed: true },
  { weight: 90, reps: 6, completed: false },
  { weight: 90, reps: 6, completed: false },
];

const tableRows = [
  { exercise: 'Développé couché', muscle: 'Pectoraux', sets: '4 × 8' },
  { exercise: 'Squat', muscle: 'Quadriceps', sets: '5 × 5' },
  { exercise: 'Soulevé de terre', muscle: 'Ischio-jambiers', sets: '3 × 5' },
  { exercise: 'Tractions', muscle: 'Dos', sets: '4 × 10' },
  { exercise: 'Curl biceps', muscle: 'Biceps', sets: '3 × 12' },
];

const selectOptions = [
  { value: 'pectoraux', label: 'Pectoraux' },
  { value: 'dos', label: 'Dos' },
  { value: 'jambes', label: 'Jambes' },
  { value: 'bras', label: 'Bras' },
  { value: 'epaules', label: 'Épaules' },
];

const workoutCards = [
  {
    name: 'Push Day',
    date: '2026-07-28',
    duration: '1h 12min',
    exerciseCount: 5,
    totalVolume: '4 280 kg',
    status: 'completed' as const,
    exercises: [
      { name: 'Développé couché', muscle: 'Pectoraux', setCount: 4 },
      { name: 'Développé incliné', muscle: 'Pectoraux', setCount: 3 },
      { name: 'Écarté haltères', muscle: 'Pectoraux', setCount: 3 },
      { name: 'Dips', muscle: 'Triceps', setCount: 3 },
      { name: 'Extension triceps', muscle: 'Triceps', setCount: 3 },
    ],
  },
  {
    name: 'Pull Day',
    date: '2026-08-02',
    duration: '1h 04min',
    exerciseCount: 4,
    totalVolume: '3 640 kg',
    status: 'in-progress' as const,
    exercises: [
      { name: 'Tractions', muscle: 'Dos', setCount: 4 },
      { name: 'Rowing barre', muscle: 'Dos', setCount: 4 },
      { name: 'Tirage poulie', muscle: 'Dos', setCount: 3 },
      { name: 'Curl biceps', muscle: 'Biceps', setCount: 3 },
    ],
  },
  {
    name: 'Legs Day',
    date: '2026-08-05',
    exerciseCount: 4,
    status: 'planned' as const,
    exercises: [
      { name: 'Squat', muscle: 'Quadriceps', setCount: 5 },
      { name: 'Leg press', muscle: 'Quadriceps', setCount: 4 },
      { name: 'Soulevé de terre', muscle: 'Ischio', setCount: 3 },
      { name: 'Mollets debout', muscle: 'Mollets', setCount: 4 },
    ],
  },
];
---

<AppLayout title="UI Kit" groups={[]}>
  <!-- ─── Page header ─────────────────────────────────────────── -->
  <header style="margin-bottom: 4.8rem; padding-bottom: 2.4rem; border-bottom: 1px solid var(--color-border);">
    <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.8rem;">
      Design System
    </div>
    <h1 style="font-family: var(--font-display); font-size: clamp(2.8rem, 6vw, 4.4rem); font-weight: 700; line-height: 1.05; margin-bottom: 1.2rem; letter-spacing: -0.02em;">
      UI Kit
    </h1>
    <p style="color: var(--color-muted); font-size: 1.6rem; max-width: 64rem; line-height: 1.5;">
      Aperçu complet de tous les composants disponibles dans l'application&nbsp;: typographie, couleurs, formulaires, navigation, données, et plus encore.
    </p>
  </header>

  <!-- ─── 1. Typography ──────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">01</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Typographie</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Échelle typographique avec Barlow pour le corps et Barlow Condensed pour les titres.</p>
    </header>

    <Card>
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 1.6rem;">
          <div>
            <div style="font-family: var(--font-display); font-size: clamp(2.8rem, 5vw, 4.2rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em;">Push Day Intense</div>
            <div style="color: var(--color-muted); font-size: 1.1rem; margin-top: 0.4rem; text-transform: uppercase; letter-spacing: 0.05em;">Display · var(--font-display) · clamp(2.8rem, 5vw, 4.2rem) · 700</div>
          </div>
          <div>
            <h1 style="margin-bottom: 0.4rem;">Tableau de bord</h1>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">H1 · var(--font-display) · clamp(1.6rem, 3vw, 2rem) · 700</div>
          </div>
          <div>
            <h2 style="margin-bottom: 0.4rem;">Séances récentes</h2>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">H2 · var(--font-display) · 1.6rem · 700</div>
          </div>
          <div>
            <h3 style="margin-bottom: 0.4rem;">Développé couché</h3>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">H3 · var(--font-display) · 1.4rem · 700</div>
          </div>
          <div>
            <p style="font-family: var(--font-body); font-size: 1.6rem; line-height: 1.5; margin-bottom: 0.4rem; color: var(--color-text);">
              Corps de texte principal pour les paragraphes et descriptions. La police Barlow assure une lecture confortable à toutes les tailles d'écran.
            </p>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Body · var(--font-body) · 1.6rem · 400</div>
          </div>
          <div>
            <p style="font-family: var(--font-body); font-size: 1.3rem; line-height: 1.4; margin-bottom: 0.4rem; color: var(--color-text);">
              Texte secondaire pour les labels et informations complémentaires dans les formulaires.
            </p>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Small · var(--font-body) · 1.3rem · 400</div>
          </div>
          <div>
            <p style="font-family: var(--font-body); font-size: 1.1rem; line-height: 1.3; margin-bottom: 0.4rem; color: var(--color-muted);">
              Légende, métadonnées, horodatages, identifiants.
            </p>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Caption · var(--font-body) · 1.1rem · 400</div>
          </div>
        </div>
      </CardContent>
    </Card>
  </section>

  <!-- ─── 2. Colors ──────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">02</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Couleurs</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Palette de tokens du design system. Chaque couleur est accessible via une variable CSS.</p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1.6rem;">
      {swatches.map((swatch) => (
        <div>
          <div style={`height: 7.2rem; border-radius: var(--radius-md); background: var(${swatch.token}); border: 1px solid var(--color-border);`}></div>
          <div style="margin-top: 0.8rem; font-size: 1.3rem; font-weight: 600; color: var(--color-text); font-family: var(--font-body);">
            {swatch.name}
          </div>
          <div style="font-size: 1.1rem; color: var(--color-muted); font-family: 'Courier New', monospace; margin-top: 0.2rem;">
            {swatch.value}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── 3. Buttons ─────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">03</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Boutons</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Quatre variantes (primary, secondary, destructive, ghost) en trois tailles (sm, md, lg), avec états loading, disabled et fullWidth.</p>
    </header>

    <Card>
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 1.6rem;">
          {(['primary', 'secondary', 'destructive', 'ghost'] as const).map((variant) => (
            <div>
              <div style="font-family: var(--font-body); font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.8rem; font-weight: 600;">
                {variant}
              </div>
              <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap;">
                <Button variant={variant} size="sm">Petit</Button>
                <Button variant={variant} size="md">Moyen</Button>
                <Button variant={variant} size="lg">Grand</Button>
              </div>
            </div>
          ))}

          <div style="border-top: 1px solid var(--color-border); padding-top: 1.6rem; margin-top: 0.8rem;">
            <div style="font-family: var(--font-body); font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.8rem; font-weight: 600;">
              États
            </div>
            <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap;">
              <Button variant="primary" loading>Chargement</Button>
              <Button variant="primary" disabled>Désactivé</Button>
              <Button variant="secondary" disabled>Désactivé</Button>
              <Button variant="primary" fullWidth>Bouton pleine largeur</Button>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
  </section>

  <!-- ─── 4. Cards ───────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">04</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Cartes</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Trois variantes (default, elevated, interactive) et un exemple composé avec sous-composants.</p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr)); gap: 1.6rem; margin-bottom: 1.6rem;">
      <Card>
        <CardHeader>
          <CardTitle>Default</CardTitle>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">Surface standard avec bordure subtile. Utilisée par défaut pour la plupart des contenus.</p>
        </CardContent>
      </Card>

      <Card variant="elevated">
        <CardHeader>
          <CardTitle>Elevated</CardTitle>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">Surface surélevée avec ombre légère. Idéale pour mettre en avant un contenu.</p>
        </CardContent>
      </Card>

      <Card variant="interactive" clickable>
        <CardHeader>
          <CardTitle>Interactive</CardTitle>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">Carte cliquable avec halo cyan au survol. Utilisée pour les éléments de navigation.</p>
        </CardContent>
      </Card>
    </div>

    <Card>
      <CardHeader>
        <CardTitle>Carte composée</CardTitle>
        <Badge variant="success" size="sm">Terminée</Badge>
      </CardHeader>
      <CardContent>
        <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">
          Démonstration de l'assemblage CardHeader + CardTitle + CardContent + CardFooter avec un badge de statut et deux actions en pied de carte.
        </p>
      </CardContent>
      <CardFooter>
        <Button variant="ghost" size="sm">Détails</Button>
        <Button variant="primary" size="sm">Voir la séance</Button>
      </CardFooter>
    </Card>
  </section>

  <!-- ─── 5. Forms ───────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">05</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Formulaires</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Champs de saisie, listes déroulantes, cases à cocher et interrupteurs dans tous leurs états.</p>
    </header>

    <Card>
      <CardContent>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr)); gap: 1.6rem;">
          <Input
            id="demo-input-1"
            label="Nom de la séance"
            placeholder="ex. Push Day"
            hint="Le nom apparaît dans la liste de vos séances."
          />
          <Input
            id="demo-input-2"
            label="Charge maximale"
            value="120"
            type="number"
            error="La charge doit être supérieure à 0 kg."
          />
          <Input
            id="demo-input-3"
            label="Champ désactivé"
            value="Lecture seule"
            disabled
          />

          <Select
            id="demo-select-1"
            label="Groupe musculaire"
            placeholder="Sélectionnez un groupe"
            options={selectOptions}
          />
          <Select
            id="demo-select-2"
            label="Avec erreur"
            options={selectOptions}
            error="Veuillez sélectionner un groupe musculaire."
          />

          <div style="display: flex; flex-direction: column; gap: 1.6rem;">
            <Checkbox id="demo-cb-1" label="Case non cochée" />
            <Checkbox id="demo-cb-2" label="Case cochée" checked />
            <Checkbox id="demo-cb-3" label="Case désactivée" disabled />
          </div>

          <div style="display: flex; flex-direction: column; gap: 1.6rem;">
            <Toggle id="demo-tg-1" label="Interrupteur désactivé" />
            <Toggle id="demo-tg-2" label="Interrupteur activé" checked />
            <Toggle id="demo-tg-3" label="Désactivé" disabled />
          </div>
        </div>
      </CardContent>
    </Card>
  </section>

  <!-- ─── 6. Feedback ────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">06</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Feedback</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Badges, barres de progression, états de chargement et placeholders.</p>
    </header>

    <div style="display: flex; flex-direction: column; gap: 1.6rem;">
      <Card>
        <CardHeader>
          <CardTitle>Badges</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap;">
            <Badge variant="default">Default</Badge>
            <Badge variant="success">Succès</Badge>
            <Badge variant="warning">Avertissement</Badge>
            <Badge variant="danger">Erreur</Badge>
            <Badge variant="info">Info</Badge>
            <Badge variant="accent">Accent</Badge>
          </div>
          <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap; margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px solid var(--color-border);">
            <Badge variant="default" size="sm">SM · Default</Badge>
            <Badge variant="success" size="sm">SM · Succès</Badge>
            <Badge variant="warning" size="sm">SM · Avert.</Badge>
            <Badge variant="danger" size="sm">SM · Erreur</Badge>
            <Badge variant="info" size="sm">SM · Info</Badge>
            <Badge variant="accent" size="sm">SM · Accent</Badge>
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Barres de progression</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; flex-direction: column; gap: 1.6rem;">
            <Progress value={65} variant="default" label="Défaut · 65 %" />
            <Progress value={100} variant="success" label="Succès · 100 %" />
            <Progress value={40} variant="warning" label="Avertissement · 40 %" />
            <Progress value={15} variant="danger" label="Erreur · 15 %" />
            <Progress value={85} variant="accent" label="Accent · 85 %" />
          </div>
        </CardContent>
      </Card>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr)); gap: 1.6rem;">
        <Card>
          <CardHeader>
            <CardTitle>Skeletons</CardTitle>
          </CardHeader>
          <CardContent>
            <div style="display: flex; flex-direction: column; gap: 1.6rem;">
              <div style="display: flex; align-items: center; gap: 1.6rem;">
                <Skeleton variant="circle" width="48px" height="48px" />
                <div style="flex: 1;">
                  <Skeleton variant="text" lines={2} />
                </div>
              </div>
              <Skeleton variant="rect" width="100%" height="64px" />
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>État vide</CardTitle>
          </CardHeader>
          <CardContent>
            <EmptyState
              title="Aucune séance"
              description="Commencez par créer votre première séance d'entraînement."
              actionLabel="Créer une séance"
              actionHref="/seances/creer"
            />
          </CardContent>
        </Card>
      </div>
    </div>
  </section>

  <!-- ─── 7. Navigation ──────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">07</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Navigation</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Onglets, pagination et infobulles pour structurer l'information.</p>
    </header>

    <div style="display: flex; flex-direction: column; gap: 1.6rem;">
      <Card>
        <CardHeader>
          <CardTitle>Onglets</CardTitle>
        </CardHeader>
        <CardContent>
          <Tabs>
            <TabList tabs={tabItems} activeTab="overview" />
            <TabPanel id="overview">
              <p style="color: var(--color-muted); font-size: 1.3rem; padding: 1.6rem 0; margin: 0;">Vue d'ensemble de la séance : résumé des exercices, volume et durée.</p>
            </TabPanel>
            <TabPanel id="specs">
              <p style="color: var(--color-muted); font-size: 1.3rem; padding: 1.6rem 0; margin: 0;">Spécifications détaillées : séries, répétitions, charges, RPE et temps de repos.</p>
            </TabPanel>
            <TabPanel id="reviews">
              <p style="color: var(--color-muted); font-size: 1.3rem; padding: 1.6rem 0; margin: 0;">Historique et comparaisons avec les séances précédentes.</p>
            </TabPanel>
          </Tabs>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Pagination</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; justify-content: center; padding: 0.8rem 0;">
            <Pagination currentPage={3} totalPages={10} hrefPattern="#page-{n}" />
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Infobulles</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap; padding: 2.4rem 0; justify-content: center;">
            <Tooltip content="Au-dessus du déclencheur" position="top">
              <Button variant="secondary">Haut</Button>
            </Tooltip>
            <Tooltip content="Sous le déclencheur" position="bottom">
              <Button variant="secondary">Bas</Button>
            </Tooltip>
            <Tooltip content="À gauche du déclencheur" position="left">
              <Button variant="secondary">Gauche</Button>
            </Tooltip>
            <Tooltip content="À droite du déclencheur" position="right">
              <Button variant="secondary">Droite</Button>
            </Tooltip>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  <!-- ─── 8. Overlays ────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">08</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Overlays</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Boîtes de dialogue modales et menus déroulants contextuels.</p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr)); gap: 1.6rem;">
      <Card>
        <CardHeader>
          <CardTitle>Dialog</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; flex-direction: column; gap: 1.6rem; align-items: flex-start;">
            <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">
              Modale native avec backdrop, focus trap, fermeture par Échap et restauration du focus.
            </p>
            <Button variant="primary" data-dialog-trigger="demo-dialog">
              Ouvrir la boîte de dialogue
            </Button>
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Dropdown</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; flex-direction: column; gap: 1.6rem; align-items: flex-start;">
            <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">
              Menu contextuel qui s'ouvre au clic, se ferme en cliquant ailleurs ou avec Échap.
            </p>
            <Dropdown align="start">
              <Button variant="secondary">Actions ▾</Button>
              <button slot="menu" role="menuitem">Modifier</button>
              <button slot="menu" role="menuitem">Dupliquer</button>
              <hr slot="menu" />
              <button slot="menu" role="menuitem">Exporter</button>
              <hr slot="menu" />
              <button slot="menu" role="menuitem">Supprimer</button>
            </Dropdown>
          </div>
        </CardContent>
      </Card>
    </div>

    <Dialog id="demo-dialog" title="Confirmation requise">
      <p style="margin: 0;">
        Cette action est irréversible. Voulez-vous vraiment supprimer cette séance ? Toutes les données associées seront perdues.
      </p>
      <Button slot="footer" variant="secondary" data-dialog-close>Annuler</Button>
      <Button slot="footer" variant="destructive" data-dialog-close>Confirmer</Button>
    </Dialog>
  </section>

  <!-- ─── 9. Data ────────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">09</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Données</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Tableaux et avatars pour présenter les informations structurées.</p>
    </header>

    <div style="display: flex; flex-direction: column; gap: 1.6rem;">
      <Card>
        <CardHeader>
          <CardTitle>Tableau</CardTitle>
        </CardHeader>
        <CardContent>
          <Table>
            <TableHead>
              <TableRow>
                <th>Exercice</th>
                <th>Muscle</th>
                <th style="text-align: right;">Sets</th>
              </TableRow>
            </TableHead>
            <TableBody>
              {tableRows.map((row) => (
                <TableRow>
                  <TableCell>{row.exercise}</TableCell>
                  <TableCell>{row.muscle}</TableCell>
                  <TableCell numeric>{row.sets}</TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Avatars</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; gap: 1.6rem; align-items: center;">
            <Avatar size="sm" fallback="Jean Dupont" />
            <Avatar size="md" fallback="Marie Lambert" />
            <Avatar size="lg" fallback="Alex Martin" />
          </div>
        </CardContent>
      </Card>
    </div>
  </section>

  <!-- ─── 10. Workout ────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">10</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Workout</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">Composants métier : cartes de statistiques, exercices et résumés de séance.</p>
    </header>

    <div style="display: flex; flex-direction: column; gap: 1.6rem;">
      <div>
        <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin-bottom: 1.2rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">Statistiques</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1.6rem;">
          <StatsCard label="Volume total" value="12 940" unit="kg" trend="up" trendValue="+8 %" icon="📊" />
          <StatsCard label="Séances" value="24" trend="up" trendValue="+3" icon="🏋️" />
          <StatsCard label="Records personnels" value="2" trend="neutral" trendValue="stable" icon="🏆" />
          <StatsCard label="Série actuelle" value="12" unit="jours" trend="up" trendValue="record" icon="🔥" />
        </div>
      </div>

      <div>
        <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin-bottom: 1.2rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">Carte d'exercice</h3>
        <ExerciseCard
          name="Développé couché"
          muscle="Pectoraux"
          sets={exerciseSets}
          expanded
        />
      </div>

      <div>
        <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin-bottom: 1.2rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">Cartes de séance</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(30rem, 1fr)); gap: 1.6rem;">
          {workoutCards.map((card) => (
            <WorkoutCard
              name={card.name}
              date={card.date}
              duration={card.duration}
              exerciseCount={card.exerciseCount}
              totalVolume={card.totalVolume}
              exercises={card.exercises}
              status={card.status}
            />
          ))}
        </div>
      </div>
    </div>
  </section>
</AppLayout>
