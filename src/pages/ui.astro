---

import { t, setLocale, defaultLocale, localizedPath } from '../i18n';
import AppLayout from '../layouts/AppLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CardHeader from '../components/ui/CardHeader.astro';
import CardTitle from '../components/ui/CardTitle.astro';
import CardContent from '../components/ui/CardContent.astro';
import CardFooter from '../components/ui/CardFooter.astro';
import Badge from '../components/ui/Badge.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import Checkbox from '../components/ui/Checkbox.astro';
import Toggle from '../components/ui/Toggle.astro';
import Tabs from '../components/ui/Tabs.astro';
import TabList from '../components/ui/TabList.astro';
import TabPanel from '../components/ui/TabPanel.astro';
import Dialog from '../components/ui/Dialog.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Table from '../components/ui/Table.astro';
import TableHead from '../components/ui/TableHead.astro';
import TableBody from '../components/ui/TableBody.astro';
import TableRow from '../components/ui/TableRow.astro';
import TableCell from '../components/ui/TableCell.astro';
import Pagination from '../components/ui/Pagination.astro';
import Tooltip from '../components/ui/Tooltip.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import Avatar from '../components/ui/Avatar.astro';
import Progress from '../components/ui/Progress.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Segmented from '../components/ui/Segmented.astro';
import StatsCard from '../components/workout/StatsCard.astro';
import ExerciseCard from '../components/workout/ExerciseCard.astro';
import WorkoutCard from '../components/workout/WorkoutCard.astro';
setLocale(Astro.currentLocale ?? defaultLocale);
const L = t();

// Design-token showcase — the `value` strings below deliberately mirror
// the raw token literals from styles/tokens.css. They are the specimen
// data this page exists to display, NOT style drifts; keep them in sync
// with tokens.css and out of any color-purge pass.
const swatches = [
  { name: 'bg', token: '--color-bg', value: '#050505' },
  { name: 'surface', token: '--color-surface', value: '#0B0B0B' },
  { name: 'surface-2', token: '--color-surface-2', value: '#111111' },
  { name: 'surface-3', token: '--color-surface-3', value: '#151515' },
  { name: 'accent', token: '--color-accent', value: 'hsl(32 55% 45%)' },
  { name: 'success', token: '--color-success', value: '#22C55E' },
  { name: 'destructive', token: '--color-destructive', value: '#EF4444' },
  { name: 'warning', token: '--color-warning', value: '#EAB308' },
  { name: 'info', token: '--color-info', value: '#3B82F6' },
  { name: 'muted', token: '--color-muted', value: '#9CA3AF' },
  { name: 'border', token: '--color-border', value: 'hsl(0 0% 100% / 0.08)' },
];

const tabItems = [
  { id: 'overview', label: L.ui.tabsOverview },
  { id: 'specs', label: L.ui.tabsSpecs },
  { id: 'reviews', label: L.ui.tabsReviews },
];

const exerciseSets = [
  { weight: 60, reps: 10, completed: true, type: L.ui.setTypeWarmup },
  { weight: 80, reps: 8, completed: true },
  { weight: 85, reps: 8, completed: true },
  { weight: 90, reps: 6, completed: false },
  { weight: 90, reps: 6, completed: false },
];

const tableRows = [
  { exercise: L.ui.exos.benchPress, muscle: L.exercices.muscles.pecs, sets: '4 × 8' },
  { exercise: L.ui.exos.squat, muscle: L.ui.muscleQuads, sets: '5 × 5' },
  { exercise: L.ui.exos.deadlift, muscle: L.ui.muscleHamstrings, sets: '3 × 5' },
  { exercise: L.ui.exos.pullUps, muscle: L.exercices.muscles.dos, sets: '4 × 10' },
  { exercise: L.ui.exos.curl, muscle: L.exercices.muscles.biceps, sets: '3 × 12' },
];

const selectOptions = [
  { value: 'pectoraux', label: L.exercices.muscles.pecs },
  { value: 'dos', label: L.exercices.muscles.dos },
  { value: 'jambes', label: L.exercices.muscles.jambes },
  { value: 'bras', label: L.ui.muscleArms },
  { value: 'epaules', label: L.exercices.muscles.epaules },
];

const workoutCards = [
  {
    name: 'Push Day',
    date: '2026-07-28',
    duration: '1h 12min',
    exerciseCount: 5,
    totalVolume: '4 280 kg',
    status: 'completed' as const,
    exercises: [
      { name: L.ui.exos.benchPress, muscle: L.exercices.muscles.pecs, setCount: 4 },
      { name: L.ui.exos.inclinePress, muscle: L.exercices.muscles.pecs, setCount: 3 },
      { name: L.ui.exos.flyes, muscle: L.exercices.muscles.pecs, setCount: 3 },
      { name: L.ui.exos.dips, muscle: L.exercices.muscles.triceps, setCount: 3 },
      { name: L.ui.exos.tricepsExtension, muscle: L.exercices.muscles.triceps, setCount: 3 },
    ],
  },
  {
    name: 'Pull Day',
    date: '2026-08-02',
    duration: '1h 04min',
    exerciseCount: 4,
    totalVolume: '3 640 kg',
    status: 'in-progress' as const,
    exercises: [
      { name: L.ui.exos.pullUps, muscle: L.exercices.muscles.dos, setCount: 4 },
      { name: L.ui.exos.barbellRow, muscle: L.exercices.muscles.dos, setCount: 4 },
      { name: L.ui.exos.latPulldown, muscle: L.exercices.muscles.dos, setCount: 3 },
      { name: L.ui.exos.curl, muscle: L.exercices.muscles.biceps, setCount: 3 },
    ],
  },
  {
    name: 'Legs Day',
    date: '2026-08-05',
    exerciseCount: 4,
    status: 'planned' as const,
    exercises: [
      { name: L.ui.exos.squat, muscle: L.ui.muscleQuads, setCount: 5 },
      { name: L.ui.exos.legPress, muscle: L.ui.muscleQuads, setCount: 4 },
      { name: L.ui.exos.deadlift, muscle: L.ui.muscleHamstringsShort, setCount: 3 },
      { name: L.ui.exos.standingCalf, muscle: L.ui.muscleCalves, setCount: 4 },
    ],
  },
];
---

<AppLayout title={L.ui.title} groups={[]}>
  <!-- ─── Page header ─────────────────────────────────────────── -->
  <header style="margin-bottom: 4.8rem; padding-bottom: 2.4rem; border-bottom: 1px solid var(--color-border);">
    <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.8rem;">
      Design System
    </div>
    <h1 style="font-family: var(--font-display); font-size: clamp(2.8rem, 6vw, 4.4rem); font-weight: 700; line-height: 1.05; margin-bottom: 1.2rem; letter-spacing: -0.02em;">
      {L.ui.title}
    </h1>
    <p style="color: var(--color-muted); font-size: 1.6rem; max-width: 64rem; line-height: 1.5;">
      {L.ui.description}
    </p>
  </header>

  <!-- ─── 1. Typography ──────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">01</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">{L.ui.typography}</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">{L.ui.typographyDesc}</p>
    </header>

    <Card>
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 1.6rem;">
          <div>
            <div style="font-family: var(--font-display); font-size: clamp(2.8rem, 5vw, 4.2rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em;">Push Day Intense</div>
            <div style="color: var(--color-muted); font-size: 1.1rem; margin-top: 0.4rem; text-transform: uppercase; letter-spacing: 0.05em;">Display · var(--font-display) · clamp(2.8rem, 5vw, 4.2rem) · 700</div>
          </div>
          <div>
            <h1 style="margin-bottom: 0.4rem;">{L.ui.demoDashboard}</h1>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">H1 · var(--font-display) · clamp(1.6rem, 3vw, 2rem) · 700</div>
          </div>
          <div>
            <h2 style="margin-bottom: 0.4rem;">{L.ui.demoRecentSessions}</h2>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">H2 · var(--font-display) · 1.6rem · 700</div>
          </div>
          <div>
            <h3 style="margin-bottom: 0.4rem;">{L.ui.exos.benchPress}</h3>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">H3 · var(--font-display) · 1.4rem · 700</div>
          </div>
          <div>
            <p style="font-family: var(--font-body); font-size: 1.6rem; line-height: 1.5; margin-bottom: 0.4rem; color: var(--color-text);">
              {L.ui.bodyText}
            </p>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Body · var(--font-body) · 1.6rem · 400</div>
          </div>
          <div>
            <p style="font-family: var(--font-body); font-size: 1.3rem; line-height: 1.4; margin-bottom: 0.4rem; color: var(--color-text);">
              {L.ui.secondaryText}
            </p>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Small · var(--font-body) · 1.3rem · 400</div>
          </div>
          <div>
            <p style="font-family: var(--font-body); font-size: 1.1rem; line-height: 1.3; margin-bottom: 0.4rem; color: var(--color-muted);">
              {L.ui.captionText}
            </p>
            <div style="color: var(--color-muted); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Caption · var(--font-body) · 1.1rem · 400</div>
          </div>
        </div>
      </CardContent>
    </Card>
  </section>

  <!-- ─── 2. Colors ──────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">02</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">{L.ui.colors}</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">{L.ui.colorsDesc}</p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1.6rem;">
      {swatches.map((swatch) => (
        <div>
          <div style={`height: 7.2rem; border-radius: var(--radius-md); background: var(${swatch.token}); border: 1px solid var(--color-border);`}></div>
          <div style="margin-top: 0.8rem; font-size: 1.3rem; font-weight: 600; color: var(--color-text); font-family: var(--font-body);">
            {swatch.name}
          </div>
          <div style="font-size: 1.1rem; color: var(--color-muted); font-family: 'Courier New', monospace; margin-top: 0.2rem;">
            {swatch.value}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── 3. Buttons ─────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">03</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">{L.ui.buttons}</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">{L.ui.buttonsDesc}</p>
    </header>

    <Card>
      <CardContent>
        <div style="display: flex; flex-direction: column; gap: 1.6rem;">
          {(['primary', 'secondary', 'destructive', 'ghost'] as const).map((variant) => (
            <div>
              <div style="font-family: var(--font-body); font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.8rem; font-weight: 600;">
                {variant}
              </div>
              <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap;">
                <Button variant={variant} size="sm">{L.ui.btnSmall}</Button>
                <Button variant={variant} size="md">{L.ui.btnMedium}</Button>
                <Button variant={variant} size="lg">{L.ui.btnLarge}</Button>
              </div>
            </div>
          ))}

          <div style="border-top: 1px solid var(--color-border); padding-top: 1.6rem; margin-top: 0.8rem;">
            <div style="font-family: var(--font-body); font-size: 1.1rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.8rem; font-weight: 600;">
              {L.ui.states}
            </div>
            <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap;">
              <Button variant="primary" loading>{L.common.loading}</Button>
              <Button variant="primary" disabled>{L.ui.disabled}</Button>
              <Button variant="secondary" disabled>{L.ui.disabled}</Button>
              <Button variant="primary" fullWidth>{L.ui.fullWidthBtn}</Button>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
  </section>

  <!-- ─── 4. Cards ───────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">04</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">{L.ui.cards}</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">{L.ui.cardsDesc}</p>
    </header>

    <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin: 0 0 1.2rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">{L.ui.surfaceVariants}</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr)); gap: 1.6rem; margin-bottom: 2.4rem;">
      <Card>
        <CardHeader>
          <CardTitle>Default</CardTitle>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">{L.ui.cardDefaultDesc}</p>
        </CardContent>
      </Card>

      <Card variant="elevated">
        <CardHeader>
          <CardTitle>Elevated</CardTitle>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">{L.ui.cardElevatedDesc}</p>
        </CardContent>
      </Card>

      <Card variant="interactive" clickable>
        <CardHeader>
          <CardTitle>Interactive</CardTitle>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">{L.ui.cardInteractiveDesc}</p>
        </CardContent>
      </Card>
    </div>

    <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin: 0 0 1.2rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">{L.ui.headerComposition}</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr)); gap: 1.6rem; margin-bottom: 2.4rem;">
      <Card>
        <CardHeader>
          <CardTitle>{L.ui.titlePlusDesc}</CardTitle>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0; line-height: 1.5;">
            {L.ui.headerCompoBefore}<code style="font-family: 'Courier New', monospace; font-size: 1.1rem; background: var(--color-surface-2); padding: 0.1rem 0.4rem; border-radius: 0.3rem;">flex-col</code>{L.ui.headerCompoAfter}
          </p>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">{L.ui.cardContentDesc}</p>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <div class="flex flex-row items-center justify-between gap-[var(--spacing-3)]">
            <CardTitle>{L.ui.titlePlusBadge}</CardTitle>
            <Badge variant="accent" size="sm">{L.ui.new}</Badge>
          </div>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0; line-height: 1.5;">
            {L.ui.badgeWrapperBefore}<code style="font-family: 'Courier New', monospace; font-size: 1.1rem; background: var(--color-surface-2); padding: 0.1rem 0.4rem; border-radius: 0.3rem;">flex-row</code>{L.ui.badgeWrapperAfter}
          </p>
        </CardHeader>
        <CardContent>
          <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">{L.ui.wrapperCoexistDesc}</p>
        </CardContent>
      </Card>
    </div>

    <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; margin: 0 0 1.2rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em;">{L.ui.fullCard}</h3>
    <Card>
      <CardHeader>
        <div class="flex flex-row items-center justify-between gap-[var(--spacing-3)]">
          <CardTitle>{L.ui.compositeCard}</CardTitle>
          <Badge variant="success" size="sm">{L.sessions.completed}</Badge>
        </div>
      </CardHeader>
      <CardContent>
        <p style="color: var(--color-muted); font-size: 1.3rem; margin: 0;">
          {L.ui.compositeCardDesc}
        </p>
      </CardContent>
      <CardFooter>
        <Button variant="ghost" size="sm">{L.ui.details}</Button>
        <Button variant="primary" size="sm">{L.ui.viewSession}</Button>
      </CardFooter>
    </Card>
  </section>

  <!-- ─── 5. Forms ───────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">05</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">{L.ui.forms}</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">{L.ui.formsDesc}</p>
    </header>

    <Card>
      <CardContent>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr)); gap: 1.6rem;">
          <Input
            id="demo-input-1"
            label={L.builder.name}
            placeholder={L.ui.inputPlaceholder}
            hint={L.ui.inputHint}
          />
          <Input
            id="demo-input-2"
            label={L.ui.maxLoad}
            value="120"
            type="number"
            error={L.ui.loadError}
          />
          <Input
            id="demo-input-3"
            label={L.ui.disabledField}
            value={L.ui.readOnly}
            disabled
          />

          <Select
            id="demo-select-1"
            label={L.ui.muscleGroup}
            placeholder={L.ui.selectPlaceholder}
            options={selectOptions}
          />
          <Select
            id="demo-select-2"
            label={L.ui.withError}
            options={selectOptions}
            error={L.ui.selectError}
          />

          <div style="display: flex; flex-direction: column; gap: 1.6rem;">
            <Checkbox id="demo-cb-1" label={L.ui.checkboxUnchecked} />
            <Checkbox id="demo-cb-2" label={L.ui.checkboxChecked} checked />
            <Checkbox id="demo-cb-3" label={L.ui.checkboxDisabled} disabled />
          </div>

          <div style="display: flex; flex-direction: column; gap: 1.6rem;">
            <Toggle id="demo-tg-1" label={L.ui.toggleDisabled} />
            <Toggle id="demo-tg-2" label={L.ui.toggleEnabled} checked />
            <Toggle id="demo-tg-3" label={L.ui.disabled} disabled />
          </div>
        </div>
      </CardContent>
    </Card>
  </section>

  <!-- ─── 6. Feedback ────────────────────────────────────────── -->
  <section style="margin-bottom: 4.8rem;">
    <header style="margin-bottom: 2.4rem;">
      <div style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem;">06</div>
      <h2 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.8rem;">Feedback</h2>
      <p style="color: var(--color-muted); font-size: 1.4rem; max-width: 60rem;">{L.ui.feedbackDesc}</p>
    </header>

    <div style="display: flex; flex-direction: column; gap: 1.6rem;">
      <Card>
        <CardHeader>
          <CardTitle>{L.ui.badges}</CardTitle>
        </CardHeader>
        <CardContent>
          <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap;">
            <Badge variant="default">Default</Badge>
            <Badge variant="success">{L.common.success}</Badge>
            <Badge variant="warning">{L.common.warning}</Badge>
            <Badge variant="danger">{L.common.error}</Badge>
            <Badge variant="info">{L.common.info}</Badge>
            <Badge variant="accent">{L.ui.accent}</Badge>
          </div>
          <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap; margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px solid var(--color-border);">
            <Badge variant="default" size="sm">SM · Default</Badge>
            <Badge variant="success" size="sm">SM · {L.common.success}</Badge>
            <Badge variant="warning" size="sm">SM · {L.ui.avert}</Badge>
            <Badge variant="danger" size="sm">SM · {L.common.error}</Badge>
            <Badge variant="info" size="sm">SM · {L.common.info}</Badge>
            <Badge variant="accent" size="sm">SM · {L.ui.accent}</Badge>
          </div>
          <div style="display: flex; gap: 1.6rem; align-items: center; flex-wrap: wrap; margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px solid var(--color-border);">
            <Badge variant="category" tone="chest" size="sm">{L.exercices.muscles.pecs}</Badge>
            <Badge variant="category" tone="back" size="sm">{L.exercices.muscles.dos}</Badge>
            <Badge variant="category" tone="shoulders" size="sm">{L.exercices.muscles.epaules}</Badge>
