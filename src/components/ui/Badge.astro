---
type Variant =
  | 'default'
  | 'success'
  | 'warning'
  | 'danger'
  | 'info'
  | 'accent'
  | 'category'
  | 'superset';

type Tone = 'chest' | 'back' | 'shoulders' | 'arms' | 'legs' | 'core' | 'other';
type Group = 'g1' | 'g2' | 'g3' | 'g4' | 'g5' | 'none';

interface Props {
  variant?: Variant;
  size?: 'sm' | 'md';
  /** Hue family when variant="category" (renders `badge--cat-<tone>`).
      Optional so Alpine consumers can inject a dynamic tone via `:class` */
  tone?: Tone;
  /** Superset group when variant="superset" (renders `badge--group-gN`).
      Optional; a superset badge without a group renders a neutral muted
      pill instead of silently defaulting to g1. */
  group?: Group;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'default',
  size = 'md',
  tone,
  group = 'none',
  class: className = '',
  ...attrs
} = Astro.props;

const sizeMap: Record<NonNullable<Props['size']>, string> = {
  sm: 'px-2 py-0.5 text-[1.0rem] uppercase tracking-wider',
  md: 'px-2.5 py-1 text-[1.2rem]',
};

const variantClasses: Record<Variant, string> = {
  default: 'bg-white/5 text-[var(--color-muted)]',
  success: 'bg-green-500/10 text-[var(--color-success)]',
  warning: 'bg-yellow-500/10 text-[var(--color-warning)]',
  danger: 'bg-red-500/10 text-[var(--color-destructive)]',
  info: 'bg-blue-500/10 text-[var(--color-info)]',
  accent: 'bg-orange-500/10 text-[var(--color-accent)]',
  category: tone
    ? `badge--category badge--cat-${tone}`
    : 'badge--category',
  superset:
    group !== 'none'
      ? `badge--superset badge--group-${group}`
      : 'badge--superset badge--category',
};

const baseClasses =
  'inline-flex items-center font-semibold whitespace-nowrap rounded-[var(--radius-pill)]';

const classes = [
  baseClasses,
  variantClasses[variant],
  sizeMap[size],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<span class={classes} {...attrs}>
  <slot />
</span>

<style>
  /* Category + superset tones come from tokens.css (dark + light).
     Backgrounds use the 10% wash (-bg tokens) so the hue reads as a
     tint, not a fill. A category badge without a tone falls back to
     the neutral muted look. */
  .badge--category {
    background-color: var(--alpha-bg-soft);
    color: var(--color-muted);
  }
  .badge--cat-chest {
    background-color: var(--color-cat-chest-bg);
    color: var(--color-cat-chest);
  }
  .badge--cat-back {
    background-color: var(--color-cat-back-bg);
    color: var(--color-cat-back);
  }
  .badge--cat-shoulders {
    background-color: var(--color-cat-shoulders-bg);
    color: var(--color-cat-shoulders);
  }
  .badge--cat-arms {
    background-color: var(--color-cat-arms-bg);
    color: var(--color-cat-arms);
  }
  .badge--cat-legs {
    background-color: var(--color-cat-legs-bg);
    color: var(--color-cat-legs);
  }
  .badge--cat-core {
    background-color: var(--color-cat-core-bg);
    color: var(--color-cat-core);
  }
  .badge--cat-other {
    background-color: var(--alpha-bg-soft);
    color: var(--color-muted);
  }

  .badge--group-g1 {
    background-color: var(--color-superset-g1-bg);
    color: var(--color-superset-g1);
  }
  .badge--group-g2 {
    background-color: var(--color-superset-g2-bg);
    color: var(--color-superset-g2);
  }
  .badge--group-g3 {
    background-color: var(--color-superset-g3-bg);
    color: var(--color-superset-g3);
  }
  .badge--group-g4 {
    background-color: var(--color-superset-g4-bg);
    color: var(--color-superset-g4);
  }
  .badge--group-g5 {
    background-color: var(--color-superset-g5-bg);
    color: var(--color-superset-g5);
  }
</style>