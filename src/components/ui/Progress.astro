---
interface Props {
  value: number;
  max?: number;
  variant?: 'default' | 'success' | 'warning' | 'danger' | 'accent';
  size?: 'sm' | 'md';
  label?: string;
  class?: string;
}

const {
  value,
  max = 100,
  variant = 'default',
  size = 'md',
  label,
  class: className = '',
} = Astro.props;

const sizeMap: Record<NonNullable<Props['size']>, string> = {
  sm: 'h-2',
  md: 'h-3',
};

const fillVariantClasses: Record<NonNullable<Props['variant']>, string> = {
  default: 'bg-[var(--color-accent)]',
  success: 'bg-[var(--color-success)]',
  warning: 'bg-[var(--color-warning)]',
  danger: 'bg-[var(--color-destructive)]',
  accent: 'bg-[var(--color-accent)]',
};

const safeMax = max > 0 ? max : 1;
const clamped = Math.max(0, Math.min(value, safeMax));
const percent = (clamped / safeMax) * 100;

const trackClasses = [
  'w-full bg-[var(--color-surface-2)] rounded-full overflow-hidden',
  sizeMap[size],
  className,
]
  .filter(Boolean)
  .join(' ');

const fillClasses = [
  'h-full rounded-full transition-all duration-300',
  fillVariantClasses[variant],
]
  .filter(Boolean)
  .join(' ');
---
{label && (
  <div class="text-[1.1rem] text-[var(--color-muted)] mb-1">{label}</div>
)}
<div
  class={trackClasses}
  role="progressbar"
  aria-valuenow={clamped}
  aria-valuemin="0"
  aria-valuemax={safeMax}
  aria-label={label}
>
  <div class={fillClasses} style={`width: ${percent}%;`}></div>
</div>
