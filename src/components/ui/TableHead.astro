---
/**
 * TableHead — <thead> wrapper with bottom border.
 * Renders <th> children with the default styling (uppercase / muted / small)
 * defined globally in Table.astro.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<thead class:list={['table-head', className]}>
  <slot />
</thead>

<style>
  .table-head {
    border-bottom: 1px solid var(--color-border);
  }
</style>
