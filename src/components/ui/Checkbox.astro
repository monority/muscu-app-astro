---
interface Props {
  label?: string;
  checked?: boolean;
  disabled?: boolean;
  name?: string;
  id?: string;
  class?: string;
}

const {
  label,
  checked = false,
  disabled = false,
  name,
  id,
  class: className = "",
} = Astro.props;

const classes = [
  "checkbox",
  disabled && "is-disabled",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<label for={id} class:list={["checkbox__label", classes]}>
  <input
    type="checkbox"
    id={id}
    name={name}
    checked={checked}
    disabled={disabled}
    class="checkbox__input"
  />

  <span aria-hidden="true" class="checkbox__box">
    <svg
      class="checkbox__check"
      viewBox="0 0 16 16"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M3.5 8L6.5 11L12.5 5"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  {label && <span class="checkbox__text">{label}</span>}
</label>

<style>
  .checkbox__label {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    min-width: 4.4rem;
    padding: 0.8rem 0.8rem 0.8rem 0.4rem;
    cursor: pointer;
    user-select: none;
    font-size: 1.3rem;
    color: var(--color-text);
  }

  .checkbox__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .checkbox__box {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: transparent;
    transition: background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .checkbox__check {
    width: 1.4rem;
    height: 1.4rem;
    color: white;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .checkbox__text {
    line-height: 1;
  }

  /* Hover */
  .checkbox__label:hover .checkbox__box {
    border-color: var(--color-muted);
  }

  /* Focus-visible */
  .checkbox__input:focus-visible ~ .checkbox__box {
    box-shadow: var(--focus-ring);
  }

  /* Checked */
  .checkbox__input:checked ~ .checkbox__box {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .checkbox__input:checked ~ .checkbox__box .checkbox__check {
    opacity: 1;
  }
  .checkbox__label:hover .checkbox__input:checked ~ .checkbox__box {
    border-color: var(--color-accent);
  }

  /* Disabled */
  .checkbox__label.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
