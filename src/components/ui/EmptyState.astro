---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  iconName?: IconName;
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
  variant?: 'default' | 'error';
  class?: string;
}

const {
  iconName,
  title,
  description,
  actionLabel,
  actionHref,
  variant = 'default',
  class: className = "",
} = Astro.props;

const hasAction = Boolean(actionLabel && actionHref);
const isError = variant === 'error';
---

{isError ? (
  <Card class={className}>
    <div class="empty-state empty-state--centered">
      {iconName && (
        <div
          class="empty-state__icon empty-state__icon--error"
          aria-hidden="true"
        >
          <Icon name={iconName} size={30} />
        </div>
      )}
      <h2 class="empty-state__title empty-state__title--large">{title}</h2>
      {description && <p class="empty-state__desc">{description}</p>}
      {hasAction && (
        <Button href={actionHref} variant="primary" class="empty-state__action">
          {actionLabel}
        </Button>
      )}
    </div>
  </Card>
) : (
  <div class:list={['empty-state', className]} role="status">
    {iconName && (
      <div
        class="empty-state__icon"
        aria-hidden="true"
      >
        <Icon name={iconName} size={24} />
      </div>
    )}
    <h3 class="empty-state__title">
      {title}
    </h3>
    {description && (
      <p class="empty-state__desc">
        {description}
      </p>
    )}
    {hasAction && (
      <Button href={actionHref} variant="primary" class="empty-state__action--lg">
        {actionLabel}
      </Button>
    )}
  </div>
)}

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4.8rem 2.4rem;
    max-width: 32rem;
    margin-inline: auto;
    text-align: center;
  }

  .empty-state--centered {
    padding: 2rem 0;
  }

  .empty-state__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 50%;
    color: var(--color-muted);
    background-color: var(--alpha-bg-soft);
  }

  .empty-state__icon--error {
    width: 6rem;
    height: 6rem;
    color: var(--color-destructive);
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
  }

  .empty-state__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.6rem;
    text-align: center;
  }

  .empty-state__title--large {
    font-size: 2rem;
    margin-top: 0;
  }

  .empty-state__desc {
    font-size: 1.2rem;
    color: var(--color-muted);
    margin-top: 0.8rem;
    text-align: center;
  }

  .empty-state--centered .empty-state__desc {
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .empty-state__action { margin-top: 0.4rem; }
  .empty-state__action--lg { margin-top: 1.6rem; }
</style>
