---
/**
 * EmptyState — design-system primitive.
 *
 * Centered placeholder used when a list/table/section has no data.
 * Renders an optional icon disc, a title, an optional description, and an
 * optional call-to-action rendered as an <a> link styled as a primary button.
 *
 * The disc icon is decorative (aria-hidden) — the title carries the meaning.
 * Icons are stroke-based (currentColor, 1.6 width, round caps) to match the
 * app's inline SVG style; catalogue only contains icons actually used.
 * `package` was dropped when call sites moved to dedicated icons (calendar,
 * scale, …).
 */
interface Props {
  iconName?: 'calendar' | 'scale' | 'dumbbell' | 'chart' | 'clock';
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
  class?: string;
}

const ICON_PATHS: Record<NonNullable<Props['iconName']>, string> = {
  calendar:
    '<path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path>',
  scale:
    '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>',
  dumbbell:
    '<path d="M14.4 14.4 9.6 9.6"></path><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l1.768-1.768a2 2 0 1 1 2.828 2.829Z"></path><path d="m21.5 21.5-1.4-1.4"></path><path d="M3.9 3.9 2.5 2.5"></path><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829Z"></path>',
  chart:
    '<path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path>',
  clock:
    '<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>',
};

const {
  iconName,
  title,
  description,
  actionLabel,
  actionHref,
  class: className = '',
} = Astro.props;

const hasAction = Boolean(actionLabel && actionHref);

const wrapperClasses = [
  'flex flex-col items-center justify-center',
  'py-12 px-6',
  'max-w-sm mx-auto',
  'text-center',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={wrapperClasses} role="status">
  {iconName && (
    <div
      class="flex items-center justify-center w-12 h-12 rounded-full text-[var(--color-muted)]"
      style="background-color: var(--alpha-bg-soft)"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-6 h-6"
        set:html={ICON_PATHS[iconName]}
      ></svg>
    </div>
  )}

  <h3 class="font-[var(--font-display)] text-[1.5rem] font-bold text-[var(--color-text)] mt-4 text-center">
    {title}
  </h3>

  {description && (
    <p class="text-[1.2rem] text-[var(--color-muted)] mt-2 text-center">
      {description}
    </p>
  )}

  {hasAction && (
    <a
      href={actionHref}
      class="inline-flex items-center justify-center min-h-[4.4rem] bg-[var(--color-accent)] text-white rounded-[var(--radius-md)] px-4 py-2 text-[1.2rem] font-semibold mt-4 transition-all duration-[160ms] hover:brightness-110 active:scale-[0.97] focus-visible:outline-none"
    >
      {actionLabel}
    </a>
  )}
</div>

<style>
  a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>