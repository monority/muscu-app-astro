---
interface Props {
  icon?: string;
  title?: string;
  description?: string;
  class?: string;
}

const { icon, title, description, class: className } = Astro.props;
---

<div class={"empty-state" + (className ? " " + className : "")}>
  {icon && <span class="empty-icon" set:html={icon} />}
  {title && <p class="empty-title">{title}</p>}
  {description && <p class="empty-desc">{description}</p>}
  <slot />
</div>


