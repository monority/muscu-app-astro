---
import { icons } from '../../lib/icons';
import Button from './Button.astro';

interface Props {
  iconName?: keyof typeof icons;
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
  class?: string;
}

const {
  iconName,
  title,
  description,
  actionLabel,
  actionHref,
  class: className = "",
} = Astro.props;

const hasAction = Boolean(actionLabel && actionHref);

const wrapperClasses = [
  "flex flex-col items-center justify-center",
  "py-12 px-6",
  "max-w-sm mx-auto",
  "text-center",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={wrapperClasses} role="status">
  {
    iconName && (
      <div
        class="flex items-center justify-center w-12 h-12 rounded-full text-[var(--color-muted)] bg-[var(--alpha-bg-soft)]"
        aria-hidden="true"
      >
        <Fragment set:html={(icons as Record<string, (w?: number, h?: number) => string>)[iconName]?.(24, 24) ?? ''} />
      </div>
    )
  }

  <h3 class="font-[var(--font-display)] text-[1.5rem] font-bold text-[var(--color-text)] mt-4 text-center">
    {title}
  </h3>

  {
    description && (
      <p class="text-[1.2rem] text-[var(--color-muted)] mt-2 text-center">
        {description}
      </p>
    )
  }

  {
    hasAction && (
      <Button href={actionHref} variant="primary" class="mt-4">
        {actionLabel}
      </Button>
    )
  }
</div>
