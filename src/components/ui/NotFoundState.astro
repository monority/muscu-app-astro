---
import { icons } from '../../lib/icons';
import Card from './Card.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
  icon?: keyof typeof icons;
  class?: string;
}

const {
  title,
  description,
  actionLabel,
  actionHref,
  icon = 'infoCircle',
  class: className = '',
} = Astro.props;
---

<Card class={className}>
  <div class="flex flex-col items-center text-center gap-3 py-5 max-w-[32rem] mx-auto">
    <div
      class="inline-flex items-center justify-center w-[6rem] h-[6rem] rounded-full text-[var(--color-destructive)] bg-[color-mix(in_srgb,var(--color-destructive)_10%,transparent)]"
      aria-hidden="true"
    >
      <Fragment set:html={(icons as Record<string, (w?: number, h?: number) => string>)[icon]?.(30, 30) ?? ''} />
    </div>
    <h2 class="font-[var(--font-display)] text-[2rem] text-[var(--color-text)]">{title}</h2>
    {description && <p class="text-[var(--color-muted)] text-[1.3rem] leading-[1.5]">{description}</p>}
    {actionLabel && actionHref && (
      <Button href={actionHref} variant="primary" class="mt-1">
        {actionLabel}
      </Button>
    )}
  </div>
</Card>
