---
interface Props {
  variant?: "primary" | "secondary" | "destructive" | "ghost";
  size?: "sm" | "md" | "lg";
  /** When true, applies an accent-tinted "selected" treatment on top of
   *  the current variant. Used by segmented presets / toggles. */
  active?: boolean;
  /** Pill shape (fully rounded). Defaults to the system's subtle radius. */
  pill?: boolean;
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  /** Allow arbitrary HTML attributes to flow through to the underlying
   *  element (target, rel, data-*, aria-*, Alpine x-*, etc.). */
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  active = false,
  pill = false,
  disabled = false,
  loading = false,
  fullWidth = false,
  href,
  type = "button",
  class: className = "",
  ...rest
} = Astro.props as Props & Record<string, unknown>;

const isInactive = disabled || loading;
const classes = [
  "button",
  `button--${variant}`,
  `button--${size}`,
  pill && "button--pill",
  fullWidth && "button--full",
  active && "is-active",
  isInactive && "is-inactive",
  className,
].filter(Boolean).join(" ");
---

{href ? (
  <a
    {...rest}
    href={isInactive ? undefined : href}
    class={classes}
    aria-disabled={isInactive ? "true" : undefined}
    aria-busy={loading ? "true" : undefined}
    tabindex={isInactive ? -1 : undefined}
  >
    {loading && <span class="button__spinner" aria-hidden="true"></span>}
    <span class={loading ? "button__label button__label--loading" : "button__label"}>
      <slot />
    </span>
  </a>
) : (
  <button
    {...rest}
    type={type}
    class={classes}
    disabled={isInactive}
    aria-busy={loading ? "true" : undefined}
  >
    {loading && <span class="button__spinner" aria-hidden="true"></span>}
    <span class={loading ? "button__label button__label--loading" : "button__label"}>
      <slot />
    </span>
  </button>
)}

---

<style>
  @import '../../styles/button.css';
</style>
