---
interface Props {
  variant?: "primary" | "secondary" | "destructive" | "ghost";
  size?: "sm" | "md" | "lg";
  /** When true, applies an accent-tinted "selected" treatment on top of
   *  the current variant. Used by segmented presets / toggles. */
  active?: boolean;
  /** Pill shape (fully rounded). Defaults to the system's subtle radius. */
  pill?: boolean;
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  /** Allow arbitrary HTML attributes to flow through to the underlying
   *  element (target, rel, data-*, aria-*, Alpine x-*, etc.). */
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  active = false,
  pill = false,
  disabled = false,
  loading = false,
  fullWidth = false,
  href,
  type = "button",
  class: className = "",
  ...rest
} = Astro.props as Props & Record<string, unknown>;

const isInactive = disabled || loading;
const classes = [
  "button",
  `button--${variant}`,
  `button--${size}`,
  pill && "button--pill",
  fullWidth && "button--full",
  active && "is-active",
  isInactive && "is-inactive",
  className,
].filter(Boolean).join(" ");
---

{href ? (
  <a
    {...rest}
    href={isInactive ? undefined : href}
    class={classes}
    aria-disabled={isInactive ? "true" : undefined}
    aria-busy={loading ? "true" : undefined}
    tabindex={isInactive ? -1 : undefined}
  >
    {loading && <span class="button__spinner" aria-hidden="true"></span>}
    <span class={loading ? "button__label button__label--loading" : "button__label"}>
      <slot />
    </span>
  </a>
) : (
  <button
    {...rest}
    type={type}
    class={classes}
    disabled={isInactive}
    aria-busy={loading ? "true" : undefined}
  >
    {loading && <span class="button__spinner" aria-hidden="true"></span>}
    <span class={loading ? "button__label button__label--loading" : "button__label"}>
      <slot />
    </span>
  </button>
)}

<style>
  /* ── Button primitive ──────────────────────────────────────
   * One coherent control system. Variants: primary | secondary
   * | ghost | destructive. Sizes: sm | md | lg. Built for a
   * serious performance tool: restrained radius, precise
   * typography, tactile press, no glow, no oversized pills. */
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-width: 8rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  /* Icons inside buttons stay optically aligned and never shrink. */
  .button svg {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  .button--sm { min-height: 3.6rem; padding: 0 1.2rem; font-size: 1.3rem; gap: 0.5rem; }
  .button--md { min-height: 4.4rem; padding: 0 1.6rem; }
  .button--lg { min-height: 4.8rem; padding: 0 2rem; font-size: 1.5rem; }
  .button--full { width: 100%; }

  /* ── Pill — fully rounded shape (presets, quick actions) ── */
  .button--pill { border-radius: var(--radius-pill); }

  /* ── Active — selected/pressed state. Tints the border + bg with the
   *    accent on top of any variant (typically secondary). Pairs with
   *    the `active` prop — pages toggle it via :class binding. */
  .button.is-active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .button.is-active:hover {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }

  /* ── Primary — strongest hierarchy, single obvious CTA ── */
  .button--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-foreground);
    box-shadow: var(--shadow-1), inset 0 1px 0 var(--alpha-highlight);
  }
  .button--primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
  .button--primary:active:not(:disabled) {
    box-shadow: inset 0 1px 2px hsl(30 90% 20% / 0.35);
    transform: translateY(1px);
  }

  /* ── Secondary — supports primary, quieter surface ── */
  .button--secondary {
    background: var(--color-surface-2);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }
  .button--secondary:hover {
    background: var(--color-surface-3);
    border-color: var(--alpha-border);
  }
  .button--secondary:active:not(:disabled) {
    background: var(--color-surface-3);
    transform: translateY(1px);
  }

  /* ── Ghost — low-emphasis, still clearly interactive ── */
  .button--ghost {
    background: transparent;
    color: var(--color-muted);
  }
  .button--ghost:hover {
    background: var(--alpha-bg-subtle);
    color: var(--color-text);
  }
  .button--ghost:active:not(:disabled) {
    background: var(--alpha-bg-soft);
    transform: translateY(1px);
  }

  /* ── Destructive — distinct, not aggressive ── */
  .button--destructive {
    background: transparent;
    border-color: color-mix(in srgb, var(--color-destructive) 45%, transparent);
    color: var(--color-destructive);
  }
  .button--destructive:hover {
    background: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 65%, transparent);
  }
  .button--destructive:active:not(:disabled) {
    background: color-mix(in srgb, var(--color-destructive) 16%, transparent);
    transform: translateY(1px);
  }

  /* ── Focus — keyboard mandatory, never removed ── */
  .button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ── Disabled — dimmed, no hover/active, text stays readable ── */
  .button.is-inactive,
  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
    pointer-events: none;
  }

  /* ── Loading — preserves dimensions, inline spinner ── */
  .button[aria-busy="true"] { cursor: progress; }
  .button__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }
  .button__label--loading { visibility: hidden; }
  .button__spinner {
    position: absolute;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: button-spin 700ms linear infinite;
  }

  @keyframes button-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .button, .button__spinner { transition: none; animation: none; }
  }
</style>
