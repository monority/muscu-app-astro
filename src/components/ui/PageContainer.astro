---
interface Props {
  name: string;
  app: string;
  init?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  name,
  app,
  init = 'init()',
  class: className = '',
  ...rest
} = Astro.props;
---

<div class:list={[name, className]} x-data={app} x-init={init} x-cloak {...rest}>
  <slot />
</div>
