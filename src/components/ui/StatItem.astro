---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  foot?: string;
  variant?: 'default' | 'hero';
  class?: string;
}

const {
  label,
  value,
  unit,
  foot,
  variant = 'default',
  class: className = '',
} = Astro.props;

const isHero = variant === 'hero';
---

<div class:list={['flex flex-col gap-[0.2rem] p-[1.2rem] rounded-[var(--radius-sm)]', isHero ? 'stat-item--hero' : 'bg-[var(--alpha-bg-subtle)]', className]}>
  <span class="text-[1.1rem] font-medium text-[var(--color-muted)] uppercase tracking-[0.04em]">{label}</span>
  <div class="flex items-baseline gap-[0.4rem]">
    <span class:list={['text-display text-[2rem] font-bold leading-[1.2]', isHero ? 'text-[var(--color-accent)]' : 'text-[var(--color-text)]']}>{value}</span>
    {unit && <span class="text-[1.2rem] font-medium text-[var(--color-muted)]">{unit}</span>}
  </div>
  {foot && <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.4]">{foot}</span>}
</div>

<style>
  .stat-item--hero {
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
</style>
