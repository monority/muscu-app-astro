---
/**
 * KpiItem — single KPI card for dashboard metric display.
 *
 * Icon + label + value + unit + optional subtitle.
 * Supports Alpine.js expressions via props.
 */
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  icon: IconName;
  label: string;
  valueExpr?: string;
  value?: string;
  unitExpr?: string;
  unit?: string;
  subExpr?: string;
  sub?: string;
  color?: string;
  class?: string;
}

const {
  icon,
  label,
  valueExpr,
  value = '',
  unitExpr,
  unit = '',
  subExpr,
  sub,
  color,
  class: className = '',
} = Astro.props;

const style = color ? `--kpi-icon-color:${color}` : '';
---

<div class:list={['kpi-item', className]} style={style || undefined}>
  <div class="kpi-item__content">
    <div class="kpi-item__head">
      <span class="kpi-item__icon" aria-hidden="true">
        <Icon name={icon} size={18} />
      </span>
      <span class="kpi-item__label">{label}</span>
    </div>
    <div class="kpi-item__row">
      {valueExpr ? (
        <span class="kpi-item__value" x-text={valueExpr}></span>
      ) : (
        <span class="kpi-item__value">{value}</span>
      )}
      {unitExpr ? (
        <span class="kpi-item__unit" x-text={unitExpr}></span>
      ) : (
        <span class="kpi-item__unit">{unit}</span>
      )}
    </div>
    {subExpr ? (
      <div class="kpi-item__sub" x-text={subExpr}></div>
    ) : sub ? (
      <div class="kpi-item__sub">{sub}</div>
    ) : null}
  </div>
</div>

<style>
  .kpi-item {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .kpi-item__content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .kpi-item__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .kpi-item__icon {
    display: inline-flex;
    color: var(--kpi-icon-color, var(--color-muted));
    flex-shrink: 0;
  }

  .kpi-item__label {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .kpi-item__row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .kpi-item__value {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .kpi-item__unit {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .kpi-item__sub {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-top: 0.1rem;
  }
</style>
