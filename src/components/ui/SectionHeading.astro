---
interface Props {
  icon?: string;
  title: string;
  description?: string;
  class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;
---

<div class:list={['flex items-center gap-[1rem]', className]}>
  {icon && (
    <span class="flex items-center justify-center w-[3.2rem] h-[3.2rem] rounded-[var(--radius-sm)] bg-[var(--alpha-bg-soft)] text-[var(--color-accent)] shrink-0" aria-hidden="true">
      <Fragment set:html={icon} />
    </span>
  )}
  <h2 class="text-display text-[1.6rem] font-bold text-[var(--color-text)]">{title}</h2>
</div>
{description && <p class="text-[1.3rem] text-[var(--color-muted)] mt-[0.4rem] mb-[1.6rem] leading-[1.5]">{description}</p>}

<style>
  span :global(svg) {
    width: 1.8rem;
    height: 1.8rem;
  }
</style>
