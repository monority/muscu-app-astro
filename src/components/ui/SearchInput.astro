---
import { icons } from '../../lib/icons';

interface Props {
  placeholder?: string;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { placeholder, label, class: className = '', ...rest } = Astro.props;
---

<div class:list={['search-input', className]}>
  <Fragment set:html={icons.searchLine(18, 18)} />
  <input
    type="search"
    class="search-input__field"
    placeholder={placeholder}
    aria-label={label}
    {...rest}
  />
</div>

<style>
  .search-input {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-input :global(svg) {
    position: absolute;
    left: 1.2rem;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  .search-input__field {
    width: 100%;
    height: 4.4rem;
    padding: 0 1.2rem 0 4rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: 1.4rem;
    font-family: var(--font-body);
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .search-input__field::placeholder {
    color: var(--color-muted);
    opacity: 0.6;
  }
  .search-input__field:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }
</style>
