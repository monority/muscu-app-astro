---
import { icons } from '../../lib/icons';

interface Props {
  placeholder?: string;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { placeholder, label, class: className = '', ...rest } = Astro.props;
---

<div class:list={['relative flex items-center', className]}>
  <Fragment set:html={icons.searchLine(18, 18)} />
  <input
    type="search"
    class="w-full h-[4.4rem] pl-[4rem] pr-[1.2rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-sm)] text-[var(--color-text)] text-[1.4rem] font-[var(--font-body)] outline-none transition-[border-color,box-shadow] duration-[var(--transition-fast)] placeholder:text-[var(--color-muted)] placeholder:opacity-60 focus:border-[var(--color-accent)] focus:shadow-[var(--focus-ring)]"
    placeholder={placeholder}
    aria-label={label}
    {...rest}
  />
</div>

<style>
  div :global(svg) {
    position: absolute;
    left: 1.2rem;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-muted);
    pointer-events: none;
    flex-shrink: 0;
  }
</style>
