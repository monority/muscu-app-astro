---
import Button from './Button.astro';

interface Props {
  cancelLabel?: string;
  confirmLabel?: string;
  variant?: 'primary' | 'destructive';
  class?: string;
}

const {
  cancelLabel = 'Annuler',
  confirmLabel = 'Confirmer',
  variant = 'primary',
  class: className = '',
} = Astro.props;
---

<div class:list={['flex justify-end gap-[0.8rem] pt-[1.6rem]', className]}>
  <Button variant="secondary" type="button" data-dialog-close>
    {cancelLabel}
  </Button>
  <Button variant={variant === 'destructive' ? 'destructive' : 'primary'} type="button">
    <slot />
  </Button>
</div>
