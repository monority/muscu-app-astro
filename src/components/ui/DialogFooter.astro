---
import Button from './Button/Button.astro';

interface Props {
  cancelLabel?: string;
  confirmLabel?: string;
  variant?: 'primary' | 'destructive';
  class?: string;
}

const {
  cancelLabel = 'Annuler',
  confirmLabel = 'Confirmer',
  variant = 'primary',
  class: className = '',
} = Astro.props;
---

<div class:list={['dialog-footer', className]}>
  <Button variant="secondary" type="button" data-dialog-close>
    {cancelLabel}
  </Button>
  <Button variant={variant === 'destructive' ? 'destructive' : 'primary'} type="button">
    <slot />
  </Button>
</div>

<style>
  .dialog-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    padding-top: 1.6rem;
  }
</style>
