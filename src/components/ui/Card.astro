---
interface Props {
  variant?: 'default' | 'elevated' | 'interactive';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
  clickable?: boolean;
  class?: string;
}

const {
  variant = 'default',
  padding = 'md',
  hover = false,
  clickable = false,
  class: className = '',
} = Astro.props;

const classes = [
  'surface',
  `surface--${variant}`,
  `surface--pad-${padding}`,
  (hover || clickable || variant === 'interactive') && 'surface--interactive',
  className,
].filter(Boolean).join(' ');
---

<div class={classes}>
  <slot />
</div>

<style>
  .surface {
    min-width: 0;
    background: var(--surface-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .surface--elevated { background: var(--surface-panel-elevated); border-color: var(--color-border-strong); }
  .surface--interactive { transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast); }
  .surface--interactive:hover { background: var(--surface-panel-elevated); border-color: var(--alpha-border); }
  .surface--interactive:active { transform: translateY(1px); }

  .surface--pad-none { padding: 0; }
  .surface--pad-sm { padding: 1.2rem; }
  .surface--pad-md { padding: 1.6rem; }
  .surface--pad-lg { padding: 2.4rem; }

  @media (prefers-reduced-motion: reduce) { .surface--interactive { transition: none; } }
</style>
