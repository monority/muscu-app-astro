---
interface Props {
  variant?: 'default' | 'elevated' | 'interactive';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
  clickable?: boolean;
  class?: string;
}

const {
  variant = 'default',
  padding = 'md',
  hover = false,
  clickable = false,
  class: className = '',
} = Astro.props;

const padClasses: Record<string, string> = {
  none: 'p-0',
  sm: 'p-[1.2rem]',
  md: 'p-[1.6rem]',
  lg: 'p-[2.4rem]',
};

const isInteractive = hover || clickable || variant === 'interactive';

const classes = [
  'min-w-0 bg-[var(--surface-panel)] border border-[var(--color-border)] rounded-[var(--radius-md)]',
  `surface--${variant}`,
  padClasses[padding],
  isInteractive && 'surface--interactive',
  className,
].filter(Boolean).join(' ');
---

<div class={classes}>
  <slot />
</div>

<style>
  .surface--elevated {
    background: var(--surface-panel-elevated);
    border-color: var(--color-border-strong);
  }
  .surface--interactive {
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }
  .surface--interactive:hover {
    background: var(--surface-panel-elevated);
    border-color: var(--alpha-border);
  }
  .surface--interactive:active {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .surface--interactive {
      transition: none;
    }
  }
</style>
