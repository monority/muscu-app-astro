---
interface Props {
  variant?: 'default' | 'elevated' | 'interactive';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
  clickable?: boolean;
  class?: string;
}

const {
  variant = 'default',
  padding = 'md',
  hover = false,
  clickable = false,
  class: className = '',
} = Astro.props;

const paddingMap: Record<NonNullable<Props['padding']>, string> = {
  none: 'p-0',
  sm: 'p-3',
  md: 'p-4',
  lg: 'p-6',
};

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  default:
    'bg-[var(--color-surface)] border border-[var(--color-border)]',
  elevated:
    'bg-[var(--color-surface-2)] border border-[var(--color-border)] shadow-[var(--shadow-1)]',
  interactive:
    'bg-[var(--color-surface)] border border-[var(--color-border)] hover:shadow-[var(--shadow-2)] hover:border-[var(--color-accent)]/20 cursor-pointer',
};

const baseClasses = 'rounded-[var(--radius-lg)] transition-all duration-200';

const hoverClasses = hover
  ? 'hover:shadow-[var(--shadow-2)] hover:border-[var(--color-accent)]/20'
  : '';

const clickableClasses = clickable ? 'cursor-pointer' : '';

const classes = [
  baseClasses,
  variantClasses[variant],
  paddingMap[padding],
  hoverClasses,
  clickableClasses,
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  <slot />
</div>
