---
interface Props {
  keyLabel: string;
  description: string;
  class?: string;
}

const { keyLabel, description, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-[0.6rem]', className]}>
  <kbd class="inline-flex items-center justify-center min-w-[2.8rem] h-[2.8rem] px-[0.6rem] bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-sm)] font-[var(--font-body)] text-[1.2rem] font-semibold text-[var(--color-muted)] leading-none">{keyLabel}</kbd>
  <span class="text-[1.2rem] text-[var(--color-muted)]">{description}</span>
</span>
