---
/**
 * TabPanel — content region for a single tab.
 *
 * Hidden by default. The TabList controller (data-tab-trigger handler)
 * removes the `hidden` attribute on the panel whose id matches the
 * currently selected trigger. With JS disabled, all panels remain
 * hidden — this is the standard trade-off of the ARIA tabs pattern.
 *
 * `id` must match the `id` of the corresponding tab passed to <TabList>
 * (used both as `aria-controls` on the trigger and as the lookup key).
 */
interface Props {
  id: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;
---

<div
  role="tabpanel"
  id={id}
  aria-labelledby={`tab-${id}`}
  data-tab-panel
  hidden
  class={className}
>
  <slot />
</div>
