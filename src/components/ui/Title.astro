---
type Props = {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  eyebrow?: string;
  align?: 'left' | 'center';
  class?: string;
};

const { as = 'h2', eyebrow, align = 'left', class: className = '' } = Astro.props as Props;
const Tag = as;
---

<div class={`ui-title ui-title-${align} ${className}`.trim()}>
  {eyebrow && <p class="ui-title-eyebrow">{eyebrow}</p>}
  <Tag class="ui-title-heading">
    <slot />
  </Tag>
</div>

<style>
  .ui-title {
    display: grid;
    gap: 0.6rem;
  }

  .ui-title-center {
    justify-items: center;
    text-align: center;
  }

  .ui-title-eyebrow {
    margin: 0;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 1.2rem;
  }

  .ui-title-heading {
    margin: 0;
    color: var(--text);
    font-size: clamp(3rem, 3vw, 5.4rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    font-weight: 600;
    text-wrap: balance;
    font-family: var(--font-display, inherit);
  }

  .ui-title-left .ui-title-heading {
    text-align: left;
  }

  .ui-title-center .ui-title-heading {
    text-align: center;
  }

  :where(h2.ui-title-heading) {
    font-size: clamp(2.1rem, 2vw, 3rem);
  }

  :where(h3.ui-title-heading) {
    font-size: clamp(1.6rem, 1.5vw, 1.9rem);
  }

  :where(h4.ui-title-heading) {
    font-size: 1.7rem;
  }
</style>
