---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['card-footer', className]}>
  <slot />
</div>

<style>
  .card-footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 0.8rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
