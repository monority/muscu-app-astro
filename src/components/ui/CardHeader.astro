---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['card-header', className]}>
  <slot />
</div>

<style>
  .card-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding-bottom: var(--spacing-3);
  }
</style>
