---
interface Props {
  align?: "start" | "end";
  class?: string;
}

const { align = "start", class: className = "" } = Astro.props;
---

<div class:list={["dropdown", className]} data-dropdown>
  <div data-dropdown-trigger>
    <slot />
  </div>

  <div
    class:list={["dropdown__menu", align === "end" && "dropdown__menu--end"]}
    role="menu"
    data-dropdown-menu
    aria-hidden="true"
    tabindex={-1}
  >
    <slot name="menu" />
  </div>
</div>

<script>
  function initDropdowns() {
    document
      .querySelectorAll<HTMLElement>("[data-dropdown]")
      .forEach((root) => {
        if (root.dataset.dropdownInited === "true") return;
        root.dataset.dropdownInited = "true";

        const trigger = root.querySelector<HTMLElement>(
          "[data-dropdown-trigger]",
        );
        const menu = root.querySelector<HTMLElement>("[data-dropdown-menu]");
        if (!trigger || !menu) return;

        const isOpen = () => !menu.classList.contains("is-hidden");

        const open = () => {
          document
            .querySelectorAll<HTMLElement>(
              "[data-dropdown-menu]:not(.is-hidden)",
            )
            .forEach((other) => {
              if (other === menu) return;
              other.classList.add("is-hidden");
              other.setAttribute("aria-hidden", "true");
              other
                .closest("[data-dropdown]")
                ?.querySelector("[data-dropdown-trigger]")
                ?.setAttribute("aria-expanded", "false");
            });

          menu.classList.remove("is-hidden");
          menu.setAttribute("aria-hidden", "false");
          trigger.setAttribute("aria-expanded", "true");
        };

        const close = () => {
          menu.classList.add("is-hidden");
          menu.setAttribute("aria-hidden", "true");
          trigger.setAttribute("aria-expanded", "false");
        };

        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          if (isOpen()) {
            close();
          } else {
            open();
          }
        });

        menu.addEventListener("click", (e) => {
          const target = e.target as Element | null;
          if (target?.closest('[role="menuitem"]')) {
            close();
          }
        });

        document.addEventListener("click", (e) => {
          if (!isOpen()) return;
          if (!root.contains(e.target as Node)) {
            close();
          }
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            close();
          }
        });
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDropdowns);
  } else {
    initDropdowns();
  }

  document.addEventListener("astro:page-load", initDropdowns);
</script>

<style>
  .dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown__menu {
    position: absolute;
    z-index: 2; /* level 2: dropdowns */
    margin-top: 0.4rem;
    left: 0;
    min-width: 19.2rem;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-2);
    padding: 0.4rem 0;
  }

  .dropdown__menu--end {
    left: auto;
    right: 0;
  }

  .is-hidden {
    display: none;
  }

  [data-dropdown-menu] :global([role="menuitem"]) {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-text);
    background: transparent;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 160ms ease;
    white-space: nowrap;
  }

  [data-dropdown-menu] :global([role="menuitem"]:hover),
  [data-dropdown-menu] :global([role="menuitem"]:focus-visible) {
    background-color: var(--alpha-bg-soft);
    outline: none;
  }

  [data-dropdown-menu] :global([role="menuitem"]:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  [data-dropdown-menu] :global(hr),
  [data-dropdown-menu] :global([role="separator"]) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 0.25rem 0;
    height: 0;
  }
</style>
