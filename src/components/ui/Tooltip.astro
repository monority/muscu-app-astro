---
/**
 * Tooltip — design-system primitive.
 *
 * Wrap any trigger element; a small bubble surfaces on hover/focus.
 * Pure CSS reveal (group-hover + group-focus-within) — no JS runtime cost.
 * Reveal is delayed 200ms to avoid flicker on quick pointer traversal.
 */
interface Props {
  content: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  class?: string;
}

const {
  content,
  position = 'top',
  class: className = '',
} = Astro.props;

const id = `tooltip-${crypto.randomUUID()}`;
---

<span class:list={['tooltip-wrapper', className]} aria-describedby={id}>
  <slot />
  <span id={id} role="tooltip" class:list={['tooltip', `tooltip--${position}`]}>
    {content}
    <span class:list={['tooltip__arrow', `tooltip__arrow--${position}`]} aria-hidden="true"></span>
  </span>
</span>

<style>
  .tooltip-wrapper {
    position: relative;
    display: inline-flex;
  }

  .tooltip {
    position: absolute;
    z-index: 2; /* level 2: tooltips */
    padding: 0.8rem 1.2rem;
    font-size: 1.2rem;
    font-weight: 500;
    white-space: nowrap;
    background-color: var(--color-surface-3);
    color: var(--color-text);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-1);
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease 200ms;
    min-width: 80px;
    text-align: center;
  }

  .tooltip-wrapper:hover .tooltip,
  .tooltip-wrapper:focus-within .tooltip {
    opacity: 1;
  }

  /* Positions */
  .tooltip--top {
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 0.8rem;
  }

  .tooltip--bottom {
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0.8rem;
  }

  .tooltip--left {
    right: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin-right: 0.8rem;
  }

  .tooltip--right {
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin-left: 0.8rem;
  }

  /* Arrows */
  .tooltip__arrow {
    position: absolute;
    height: 0;
    width: 0;
    border-style: solid;
    border-color: transparent;
  }

  .tooltip__arrow--top {
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px 5px 0 5px;
    border-top-color: var(--color-surface-3);
  }

  .tooltip__arrow--bottom {
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 0 5px 6px 5px;
    border-bottom-color: var(--color-surface-3);
  }

  .tooltip__arrow--left {
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-width: 5px 6px 5px 0;
    border-left-color: var(--color-surface-3);
  }

  .tooltip__arrow--right {
    right: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-width: 5px 0 5px 6px;
    border-right-color: var(--color-surface-3);
  }
</style>
