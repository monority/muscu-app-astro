---
interface Props {
  id?: string;
  title?: string;
  class?: string;
}

import { t } from "../../i18n";
import Icon from "./Icon.astro";

const L = t();

const { id = "dialog", title, class: className = "" } = Astro.props;
---

<dialog
  id={id}
  class:list={['dialog', className]}
  aria-labelledby={title ? `${id}-title` : undefined}
>
  {
    title && (
      <header class="dialog__header">
        <h2 id={`${id}-title`} class="dialog__title">
          {title}
        </h2>
        <button
          type="button"
          data-dialog-close
          aria-label={L.common.close}
          class="dialog__close"
        >
          <Icon name="closeX" size={16} />
        </button>
      </header>
    )
  }

  <div class="dialog__body">
    <slot />
  </div>

  <footer class="dialog__footer">
    <slot name="footer" />
  </footer>
</dialog>

<style>
  .dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 2.4rem;
    width: 100%;
    max-width: 60rem;
    color: var(--color-text);
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .dialog::backdrop {
    background-color: color-mix(in srgb, #000 60%, transparent);
  }

  .dialog__header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.6rem;
    gap: 1.2rem;
  }

  .dialog__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }

  .dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: hsl(0 0% 100% / 0.05);
    color: var(--color-muted);
    border: none;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .dialog__close:hover {
    background: hsl(0 0% 100% / 0.10);
    color: var(--color-text);
  }

  .dialog__body {
    font-size: 1.3rem;
  }

  .dialog__footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-top: 2.4rem;
  }

  @keyframes dialog-in {
    from { opacity: 0; transform: scale(0.96) translateY(4px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .dialog[open] {
    animation: dialog-in 180ms ease-out;
  }

  .dialog[open]::backdrop {
    animation: backdrop-in 180ms ease-out;
  }

</style>

<script>
  declare global {
    interface Window {
      openDialog?: (id: string) => void;
      closeDialog?: (id: string) => void;
    }
  }

  const FOCUSABLE_SELECTOR = [
    "a[href]",
    "area[href]",
    "button:not([disabled])",
    'input:not([disabled]):not([type="hidden"])',
    "select:not([disabled])",
    "textarea:not([disabled])",
    "iframe",
    "object",
    "embed",
    '[contenteditable="true"]',
    '[tabindex]:not([tabindex="-1"])',
  ].join(",");

  const openerMap = new WeakMap<HTMLDialogElement, HTMLElement | null>();

  function getFocusable(dialog: HTMLDialogElement): HTMLElement[] {
    return Array.from(
      dialog.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR),
    ).filter(
      (el) =>
        !el.hasAttribute("disabled") &&
        el.tabIndex !== -1 &&
        el.offsetParent !== null,
    );
  }

  function trapFocus(dialog: HTMLDialogElement, e: KeyboardEvent) {
    if (e.key !== "Tab") return;
    const focusables = getFocusable(dialog);
    if (focusables.length === 0) {
      e.preventDefault();
      return;
    }
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement as HTMLElement | null;

    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function attach(dialog: HTMLDialogElement) {
    if (dialog.dataset.dialogReady === "true") return;
    dialog.dataset.dialogReady = "true";

    dialog.addEventListener("click", (e) => {
      if (e.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const inside =
        e.clientX >= rect.left &&
        e.clientX <= rect.right &&
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom;
      if (!inside) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      trapFocus(dialog, e);
    });

    dialog.addEventListener("close", () => {
      const opener = openerMap.get(dialog);
      if (opener && typeof opener.focus === "function") {
        opener.focus();
      }
      openerMap.set(dialog, null);
    });
  }

  function openDialog(id: string) {
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    if (!dialog || dialog.tagName !== "DIALOG") return;
    attach(dialog);
    openerMap.set(dialog, document.activeElement as HTMLElement | null);
    if (!dialog.open) {
      dialog.showModal();
      const focusables = getFocusable(dialog);
      const target = focusables[0] ?? dialog;
      requestAnimationFrame(() => target.focus());
    }
  }

  function closeDialog(id: string) {
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    if (dialog?.open) dialog.close();
  }

  window.openDialog = openDialog;
  window.closeDialog = closeDialog;

  function bindTriggers() {
    document
      .querySelectorAll<HTMLElement>("[data-dialog-trigger]")
      .forEach((el) => {
        if (el.dataset.dialogBound === "true") return;
        el.dataset.dialogBound = "true";
        el.addEventListener("click", (e) => {
          e.preventDefault();
          const id = el.dataset.dialogTrigger;
          if (id) openDialog(id);
        });
      });

    document
      .querySelectorAll<HTMLElement>("[data-dialog-close]")
      .forEach((el) => {
        if (el.dataset.dialogCloseBound === "true") return;
        el.dataset.dialogCloseBound = "true";
        el.addEventListener("click", (e) => {
          e.preventDefault();
          const dialog = el.closest("dialog") as HTMLDialogElement | null;
          if (dialog) dialog.close();
        });
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindTriggers);
  } else {
    bindTriggers();
  }

  document.addEventListener("astro:page-load", bindTriggers);
</script>
