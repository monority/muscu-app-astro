---
/**
 * Dialog — native <dialog> modal primitive.
 *
 * Usage:
 *   <Dialog id="confirm-delete" title="Supprimer la séance ?">
 *     <p>Cette action est irréversible.</p>
 *     <div slot="footer">
 *       <Button variant="secondary" data-dialog-close>Annuler</Button>
 *       <Button variant="destructive">Confirmer</Button>
 *     </div>
 *   </Dialog>
 *
 * Open from anywhere:
 *   - <button data-dialog-trigger="confirm-delete">…</button>
 *   - window.openDialog('confirm-delete')
 *   - document.getElementById('confirm-delete').showModal()
 *
 * Close:
 *   - <button data-dialog-close>…</button>
 *   - window.closeDialog('confirm-delete')
 *   - Escape key, backdrop click (auto-handled)
 */
interface Props {
  id?: string;
  title?: string;
  class?: string;
}

import { t } from '../../i18n';

const L = t();

const {
  id = 'dialog',
  title,
  class: className = '',
} = Astro.props;

const classes = [
  'bg-[var(--color-surface)]',
  'border border-[var(--color-border)]',
  'rounded-[var(--radius-xl)]',
  'p-6',
  'w-full max-w-6xl',
  'text-[var(--color-text)]',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<dialog id={id} class={classes} aria-labelledby={title ? `${id}-title` : undefined}>
  {title && (
    <header class="flex flex-row justify-between items-center mb-4 gap-3">
      <h2
        id={`${id}-title`}
        class="font-[var(--font-display)] text-[1.5rem] font-bold leading-tight"
      >
        {title}
      </h2>
      <button
        type="button"
        data-dialog-close
        aria-label={L.common.close}
        class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/5 text-[var(--color-muted)] hover:bg-white/10 hover:text-[var(--color-text)] transition-colors duration-[160ms] cursor-pointer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>
  )}

  <div class="dialog-body text-[1.3rem]">
    <slot />
  </div>

  <footer class="flex flex-row justify-end gap-2 mt-6">
    <slot name="footer" />
  </footer>
</dialog>

<style>
  /* ════════════════════════════════════════════════════
     BASE DIALOG STYLES
     The native <dialog> element relies on UA stylesheet
     centering (position: fixed; inset-block: 0; margin: auto)
     that breaks the moment Tailwind's `w-full` (width: 100%)
     is applied. We re-assert explicit centering here so the
     modal is reliably centered both horizontally and
     vertically on every browser, regardless of utility
     classes layered on top.
     ════════════════════════════════════════════════════ */
  dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    background-color: var(--color-surface);
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    color: inherit;
  }

  /* Backdrop */
  dialog::backdrop {
    background-color: rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  /* Open animation — fade + scale */
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  dialog[open] {
    animation: dialog-in 180ms ease-out;
  }

  dialog[open]::backdrop {
    animation: backdrop-in 180ms ease-out;
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    dialog[open],
    dialog[open]::backdrop {
      animation: none;
    }
  }
</style>

<script>
  // ─── Public API ───────────────────────────────────────────────
  // Expose helpers so any page can open/close a Dialog by id.
  declare global {
    interface Window {
      openDialog?: (id: string) => void;
      closeDialog?: (id: string) => void;
    }
  }

  const FOCUSABLE_SELECTOR = [
    'a[href]',
    'area[href]',
    'button:not([disabled])',
    'input:not([disabled]):not([type="hidden"])',
    'select:not([disabled])',
    'textarea:not([disabled])',
    'iframe',
    'object',
    'embed',
    '[contenteditable="true"]',
    '[tabindex]:not([tabindex="-1"])',
  ].join(',');

  // Track the element that opened each dialog so we can restore focus.
  const openerMap = new WeakMap<HTMLDialogElement, HTMLElement | null>();

  function getFocusable(dialog: HTMLDialogElement): HTMLElement[] {
    return Array.from(
      dialog.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR),
    ).filter(
      (el) =>
        !el.hasAttribute('disabled') &&
        el.tabIndex !== -1 &&
        el.offsetParent !== null,
    );
  }

  function trapFocus(dialog: HTMLDialogElement, e: KeyboardEvent) {
    if (e.key !== 'Tab') return;
    const focusables = getFocusable(dialog);
    if (focusables.length === 0) {
      e.preventDefault();
      return;
    }
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement as HTMLElement | null;

    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function attach(dialog: HTMLDialogElement) {
    if (dialog.dataset.dialogReady === 'true') return;
    dialog.dataset.dialogReady = 'true';

    // Backdrop click → close (target === dialog when click is on backdrop,
    // because the dialog element itself fills the backdrop area only at the
    // edge, not in the content; we also check rect to be safe).
    dialog.addEventListener('click', (e) => {
      if (e.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const inside =
        e.clientX >= rect.left &&
        e.clientX <= rect.right &&
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom;
      if (!inside) dialog.close();
    });

    // Focus trap
    dialog.addEventListener('keydown', (e) => {
      trapFocus(dialog, e);
    });

    // Restore focus on close
    dialog.addEventListener('close', () => {
      const opener = openerMap.get(dialog);
      if (opener && typeof opener.focus === 'function') {
        opener.focus();
      }
      openerMap.set(dialog, null);
    });
  }

  function openDialog(id: string) {
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    if (!dialog || dialog.tagName !== 'DIALOG') return;
    attach(dialog);
    openerMap.set(dialog, document.activeElement as HTMLElement | null);
    if (!dialog.open) {
      dialog.showModal();
      // Focus the first focusable inside, falling back to the dialog itself.
      const focusables = getFocusable(dialog);
      const target = focusables[0] ?? dialog;
      // Defer to next frame so the animation/transition doesn't fight focus.
      requestAnimationFrame(() => target.focus());
    }
  }

  function closeDialog(id: string) {
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    if (dialog?.open) dialog.close();
  }

  window.openDialog = openDialog;
  window.closeDialog = closeDialog;

  // ─── Wire up triggers & close buttons ────────────────────────
  function bindTriggers() {
    document.querySelectorAll<HTMLElement>('[data-dialog-trigger]').forEach((el) => {
      if (el.dataset.dialogBound === 'true') return;
      el.dataset.dialogBound = 'true';
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const id = el.dataset.dialogTrigger;
        if (id) openDialog(id);
      });
    });

    document.querySelectorAll<HTMLElement>('[data-dialog-close]').forEach((el) => {
      if (el.dataset.dialogCloseBound === 'true') return;
      el.dataset.dialogCloseBound = 'true';
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const dialog = el.closest('dialog') as HTMLDialogElement | null;
        if (dialog) dialog.close();
      });
    });
  }

  // Run after DOM ready; safe to call multiple times.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindTriggers);
  } else {
    bindTriggers();
  }

  // Re-bind on Astro view transitions / dynamic content
  document.addEventListener('astro:page-load', bindTriggers);
</script>
