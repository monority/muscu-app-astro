---
interface Props {
  width?: string;
  height?: string;
  borderRadius?: string;
  class?: string;
}

const { width = "100%", height = "1.6rem", borderRadius = "var(--radius-sm)", class: className } = Astro.props;
---

<div class={"skeleton" + (className ? " " + className : "")} style={{ width, height, borderRadius }} aria-hidden="true"></div>

<style>
  .skeleton {
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(0 0% 100% / 0.03) 40%,
      hsl(0 0% 100% / 0.06) 50%,
      hsl(0 0% 100% / 0.03) 60%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
  }

  @keyframes shimmer {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }
</style>
