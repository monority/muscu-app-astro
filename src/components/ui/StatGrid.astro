---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['stat-grid', className]}>
  <slot />
</div>

<style>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .stat-grid {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
</style>
