---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<h3 class:list={["card-title", className]}>
  <slot />
</h3>

<style>
  .card-title {
    display: flex;
    gap: var(--spacing-1);
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-text);
    font-weight: 700;
  }
</style>
