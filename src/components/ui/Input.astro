---
import FormField from './FormField.astro';
import { buildDescribedBy } from '../../lib/form-utils';

type InputType =
  | 'button'
  | 'checkbox'
  | 'date'
  | 'datetime-local'
  | 'email'
  | 'file'
  | 'hidden'
  | 'image'
  | 'month'
  | 'number'
  | 'password'
  | 'radio'
  | 'range'
  | 'reset'
  | 'search'
  | 'submit'
  | 'tel'
  | 'text'
  | 'time'
  | 'url'
  | 'week';

interface Props {
  label?: string;
  hint?: string;
  error?: string;
  disabled?: boolean;
  required?: boolean;
  type?: InputType;
  placeholder?: string;
  name?: string;
  id?: string;
  value?: string;
  autocomplete?: string;
  maxlength?: number;
  class?: string;
  [key: string]: unknown;
}

const {
  label,
  hint,
  error,
  disabled = false,
  required = false,
  type = "text",
  placeholder,
  name,
  id,
  value,
  class: className = "",
  ...rest
} = Astro.props;

const describedBy = buildDescribedBy(id, hint, error);
---

<FormField id={id} label={label} hint={hint} error={error} required={required}>
  <input
    {...rest}
    type={type}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
    class:list={['input', error && 'input--error', className]}
  />
</FormField>

<style>
  .input {
    width: 100%;
    padding: 0.8rem 1.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .input--error {
    border-color: var(--color-destructive);
  }
</style>
