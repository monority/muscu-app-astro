---
import FormField from './FormField.astro';
import { buildDescribedBy } from '../../lib/form-utils';

type InputType =
  | 'button'
  | 'checkbox'
  | 'date'
  | 'datetime-local'
  | 'email'
  | 'file'
  | 'hidden'
  | 'image'
  | 'month'
  | 'number'
  | 'password'
  | 'radio'
  | 'range'
  | 'reset'
  | 'search'
  | 'submit'
  | 'tel'
  | 'text'
  | 'time'
  | 'url'
  | 'week';

interface Props {
  label?: string;
  hint?: string;
  error?: string;
  disabled?: boolean;
  required?: boolean;
  type?: InputType;
  placeholder?: string;
  name?: string;
  id?: string;
  value?: string;
  autocomplete?: string;
  maxlength?: number | string;
  /** Renders input without FormField wrapper. */
  bare?: boolean;
  size?: "sm" | "md" | "lg";
  class?: string;
  [key: string]: unknown;
}

const {
  label,
  hint,
  error,
  disabled = false,
  required = false,
  type = "text",
  placeholder,
  name,
  id,
  value,
  bare = false,
  size = "md",
  class: className = "",
  ...rest
} = Astro.props;

const describedBy = buildDescribedBy(id, hint, error);
const isBare = bare || (!label && !hint && !error);
---

{isBare ? (
  <input
    {...rest}
    type={type}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
    class:list={['input', `input--${size}`, error && 'input--error', className]}
  />
) : (
  <FormField id={id} label={label} hint={hint} error={error} required={required}>
    <input
      {...rest}
      type={type}
      id={id}
      name={name}
      value={value}
      placeholder={placeholder}
      disabled={disabled}
      required={required}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
      class:list={['input', `input--${size}`, error && 'input--error', className]}
    />
  </FormField>
)}

<style>
  .input {
    width: 100%;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .input--sm {
    height: 3.6rem;
    padding: 0 1rem;
    font-size: 1.3rem;
  }

  .input--md {
    padding: 0.8rem 1.2rem;
    font-size: 1.4rem;
  }

  .input--lg {
    height: 5.2rem;
    padding: 0 1.6rem;
    font-size: 1.5rem;
  }

  .input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .input--error {
    border-color: var(--color-destructive);
  }
</style>
