---
import FormField from './FormField.astro';
import { buildDescribedBy } from '../../lib/form-utils';

type InputType =
  | 'button'
  | 'checkbox'
  | 'date'
  | 'datetime-local'
  | 'email'
  | 'file'
  | 'hidden'
  | 'image'
  | 'month'
  | 'number'
  | 'password'
  | 'radio'
  | 'range'
  | 'reset'
  | 'search'
  | 'submit'
  | 'tel'
  | 'text'
  | 'time'
  | 'url'
  | 'week';

interface Props {
  label?: string;
  hint?: string;
  error?: string;
  disabled?: boolean;
  required?: boolean;
  type?: InputType;
  placeholder?: string;
  name?: string;
  id?: string;
  value?: string;
  autocomplete?: string;
  maxlength?: number;
  class?: string;
  [key: string]: unknown;
}

const {
  label,
  hint,
  error,
  disabled = false,
  required = false,
  type = "text",
  placeholder,
  name,
  id,
  value,
  class: className = "",
  ...rest
} = Astro.props;

const describedBy = buildDescribedBy(id, hint, error);

const inputClasses = [
  "w-full",
  "px-3",
  "p-2",
  "bg-[var(--color-surface-2)]",
  "border",
  error ? "border-[var(--color-destructive)]" : "border-[var(--color-border)]",
  "rounded-[var(--radius-sm)]",
  "text-[var(--color-text)]",
  "placeholder:text-white/25",
  "outline-none",
  "transition-[border-color,box-shadow]",
  "duration-[160ms]",
  "ease-[ease]",
  "focus:border-[var(--color-accent)]",
  "focus:shadow-[var(--focus-ring)]",
  "disabled:opacity-50",
  "disabled:cursor-not-allowed",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<FormField id={id} label={label} hint={hint} error={error} required={required}>
  <input
    {...rest}
    type={type}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
    class={inputClasses}
  />
</FormField>
