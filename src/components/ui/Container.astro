---
type Props = {
  as?: keyof HTMLElementTagNameMap;
  size?: 'md' | 'lg' | 'xl';
  class?: string;
};

const { as = 'div', size = 'xl', class: className = '' } = Astro.props as Props;

const Tag = as;
---

<Tag class={`ui-container ui-container-${size} ${className}`.trim()}>
  <slot />
</Tag>

<style>
  .ui-container {
    width: min(100%, var(--container-width, 92rem));
    margin-inline: auto;
    padding-inline: 1.4rem;
  }

  .ui-container-md {
    --container-width: 72rem;
  }

  .ui-container-lg {
    --container-width: 84rem;
  }

  .ui-container-xl {
    --container-width: 92rem;
  }

  @media (min-width: 700px) {
    .ui-container {
      padding-inline: 1.8rem;
    }
  }
</style>
