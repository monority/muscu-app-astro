---
import EmptyState from './EmptyState.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  description?: string;
  searchValue?: string;
  resetLabel?: string;
  class?: string;
}

const {
  title,
  description,
  searchValue,
  resetLabel = 'Réinitialiser',
  class: className = '',
} = Astro.props;
---

<div class:list={['flex flex-col items-center gap-[1.6rem] p-[2rem] text-center', className]}>
  <EmptyState title={title} description={description} />
  {(searchValue || resetLabel) && (
    <div class="flex flex-col items-center gap-[1rem]">
      {searchValue && (
        <p class="text-[1.3rem] text-[var(--color-muted)]">
          Aucun résultat pour « <span x-text={searchValue}></span> ».
        </p>
      )}
      <Button variant="ghost" size="sm" data-dialog-close x-on:click={searchValue ? `${searchValue} = ''` : undefined}>
        {resetLabel}
      </Button>
    </div>
  )}
</div>
