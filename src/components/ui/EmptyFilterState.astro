---
/**
 * EmptyFilterState — "no results" card with search reset.
 *
 * Shows when a search/filter yields no matches.
 * Supports Alpine.js for dynamic text.
 */
import Card from './Card.astro';

interface Props {
  titleExpr?: string;
  title?: string;
  textExpr?: string;
  text?: string;
  resetLabel?: string;
  resetClick?: string;
  hideReset?: boolean;
  class?: string;
}

const {
  titleExpr,
  title = 'Aucun résultat',
  textExpr,
  text = '',
  resetLabel = 'Réinitialiser',
  resetClick = "search = ''",
  hideReset = false,
  class: className = '',
} = Astro.props;
---

<Card class={className}>
  <div class="empty-filter">
    {titleExpr ? (
      <h3 class="empty-filter__title" x-text={titleExpr}></h3>
    ) : (
      <h3 class="empty-filter__title">{title}</h3>
    )}
    {textExpr ? (
      <p class="empty-filter__text" x-html={textExpr}></p>
    ) : text ? (
      <p class="empty-filter__text">{text}</p>
    ) : null}
    {!hideReset && (
      <button
        type="button"
        class="empty-filter__reset"
        {...resetClick && { '@click': resetClick }}
      >
        {resetLabel}
      </button>
    )}
  </div>
</Card>

<style>
  .empty-filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    padding: 1.6rem 0.8rem;
  }

  .empty-filter__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .empty-filter__text {
    color: var(--color-muted);
    font-size: 1.3rem;
    text-align: center;
    margin: 0;
  }

  .empty-filter__text :global(span) {
    color: var(--color-text);
    font-weight: 600;
  }

  .empty-filter__reset {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0 1.6rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 140ms ease;
  }

  .empty-filter__reset:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  .empty-filter__reset:active {
    transform: scale(0.97);
  }
</style>
