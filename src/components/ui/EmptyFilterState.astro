---
import EmptyState from './EmptyState.astro';
import Button from './Button/Button.astro';

interface Props {
  title: string;
  description?: string;
  searchValue?: string;
  resetLabel?: string;
  class?: string;
}

const {
  title,
  description,
  searchValue,
  resetLabel = 'RÃƒÂ©initialiser',
  class: className = '',
} = Astro.props;
---

<div class:list={['empty-filter-state', className]}>
  <EmptyState title={title} description={description} />
  {(searchValue || resetLabel) && (
    <div class="empty-filter-state__action">
      {searchValue && (
        <p class="empty-filter-state__text">
          Aucun rÃƒÂ©sultat pour Ã‚Â« <span x-text={searchValue}></span> Ã‚Â».
        </p>
      )}
      <Button variant="ghost" size="sm" data-dialog-close x-on:click={searchValue ? `${searchValue} = ''` : undefined}>
        {resetLabel}
      </Button>
    </div>
  )}
</div>

<style>
  .empty-filter-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
    padding: 2rem;
    text-align: center;
  }

  .empty-filter-state__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .empty-filter-state__text {
    font-size: 1.3rem;
    color: var(--color-muted);
  }
</style>
