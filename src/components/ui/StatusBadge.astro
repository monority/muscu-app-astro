---
import Badge from './Badge.astro';

interface Props {
  status: 'completed' | 'in-progress' | 'planned';
  labels: {
    completed: string;
    inProgress: string;
    planned: string;
  };
  size?: 'sm' | 'md';
  class?: string;
}

const { status, labels, size = 'sm', class: className = '' } = Astro.props;

const variantMap: Record<string, 'success' | 'info' | 'default'> = {
  completed: 'success',
  'in-progress': 'info',
  planned: 'default',
};

const labelMap: Record<string, string> = {
  completed: labels.completed,
  'in-progress': labels.inProgress,
  planned: labels.planned,
};
---

<Badge variant={variantMap[status]} size={size} class={className}>
  {labelMap[status]}
</Badge>
