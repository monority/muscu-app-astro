---
interface Props {
  label: string;
  for?: string;
  required?: boolean;
  hint?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  label,
  for: forId,
  required = false,
  hint,
  class: className = '',
  ...rest
} = Astro.props;
---

<div class:list={['flex flex-col gap-[0.6rem]', className]}>
  <label for={forId} class="text-[1.3rem] font-medium text-[var(--color-muted)] leading-[1.3]">
    {label}
    {required && <span class="text-[var(--color-destructive)] ml-[0.2rem]" aria-hidden="true">*</span>}
  </label>
  <slot />
  {hint && <p class="text-[1.1rem] text-[var(--color-muted)] leading-[1.4]">{hint}</p>}
</div>
