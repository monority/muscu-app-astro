---
import { icons } from '../../lib/icons';
interface Props { name: string; size?: number; class?: string; [key: string]: unknown; }
const { name, size = 20, class: className = '', ...rest } = Astro.props;
---
<Fragment set:html={(icons as Record<string, (w?: number, h?: number) => string>)[name]?.(size, size) ?? ''} />
