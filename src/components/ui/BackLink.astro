---
import { icons } from '../../lib/icons';

interface Props {
  href: string;
  label: string;
  class?: string;
  [key: string]: unknown;
}

const { href, label, class: className = '', ...rest } = Astro.props;
---

<a {href} class:list={['inline-flex items-center gap-[0.6rem] text-[var(--color-muted)] text-[1.4rem] font-medium no-underline transition-colors duration-[var(--transition-fast)] mb-[1.2rem] hover:text-[var(--color-text)]', className]} {...rest}>
  <Fragment set:html={icons.arrowLeft(20, 20)} />
  <span>{label}</span>
</a>

<style>
  a :global(svg) {
    flex-shrink: 0;
  }
</style>
