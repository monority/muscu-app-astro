---
import { icons } from '../../lib/icons';

interface Props {
  href: string;
  label: string;
  class?: string;
  [key: string]: unknown;
}

const { href, label, class: className = '', ...rest } = Astro.props;
---

<a {href} class:list={['back-link', className]} {...rest}>
  <Fragment set:html={icons.arrowLeft(20, 20)} />
  <span>{label}</span>
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-muted);
    font-size: 1.4rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-fast);
    margin-bottom: 1.2rem;
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .back-link :global(svg) {
    flex-shrink: 0;
  }
</style>
