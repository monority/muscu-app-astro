---
import FormField from './FormField.astro';
import Icon from './Icon.astro';
import { buildDescribedBy } from '../../lib/form-utils';

interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  label?: string;
  hint?: string;
  error?: string;
  disabled?: boolean;
  required?: boolean;
  name?: string;
  id?: string;
  value?: string;
  placeholder?: string;
  options: Option[];
  class?: string;
  [key: string]: unknown;
}

const {
  label,
  hint,
  error,
  disabled = false,
  required = false,
  name,
  id,
  value,
  placeholder,
  options,
  class: className = "",
  ...rest
} = Astro.props;

const describedBy = buildDescribedBy(id, hint, error);

const selectClasses = [
  "w-full",
  "px-3",
  "p-2",
  "bg-[var(--color-surface-2)]",
  "border",
  error ? "border-[var(--color-destructive)]" : "border-[var(--color-border)]",
  "rounded-[var(--radius-sm)]",
  "text-[var(--color-text)]",
  "outline-none",
  "appearance-none",
  "cursor-pointer",
  "transition-[border-color,box-shadow]",
  "duration-[160ms]",
  "ease-[ease]",
  "focus:border-[var(--color-accent)]",
  "focus:shadow-[var(--focus-ring)]",
  "disabled:opacity-50",
  "disabled:cursor-not-allowed",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<FormField id={id} label={label} hint={hint} error={error} required={required}>
  <div class="relative w-full">
    <select
      id={id}
      name={name}
      value={value}
      disabled={disabled}
      required={required}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
      class={selectClasses}
      {...rest}
    >
      {placeholder && (
        <option value="" disabled selected={!value}>
          {placeholder}
        </option>
      )}
      {options.map((opt) => (
        <option value={opt.value} disabled={opt.disabled} selected={opt.value === value}>
          {opt.label}
        </option>
      ))}
    </select>

    <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[var(--color-muted)]">
      <Icon name="chevronDown" size={16} />
    </span>
  </div>
</FormField>
