---
/**
 * MobileNav — bottom navigation bar for ≤ 640px viewports.
 *
 * Fixed, full-width, with a 5.6rem content area + safe-area-inset-bottom
 * for notched devices. Hidden on desktop (sidebar/topbar take over).
 *
 * Each item is a tappable column: a 2.4rem icon tile (placeholder slot)
 * above a 1.0rem label. Active state tints both icon and label with the
 * accent color and adds a subtle background pill behind the icon.
 *
 * The `icon` prop is a string (e.g. "home", "dumbbell"); for now we
 * render the first letter as a placeholder so the slot is obvious and
 * the shape stays balanced. Swap in a real <svg> / icon component later
 * without touching the surrounding layout.
 */
interface Props {
  items: Array<{ label: string; href: string; icon: string; active?: boolean }>;
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav class:list={['mobile-nav', className]} aria-label="Navigation principale">
  <ul class="mobile-nav__list">
    {
      items.map(({ label, href, icon, active }) => (
        <li class="mobile-nav__item-wrap">
          <a
            href={href}
            class:list={['mobile-nav__item', active && 'is-active']}
            aria-current={active ? 'page' : undefined}
            aria-label={label}
          >
            <span class="mobile-nav__icon" aria-hidden="true">
              <span class="mobile-nav__icon-glyph">{icon.charAt(0).toUpperCase()}</span>
            </span>
            <span class="mobile-nav__label">{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* ── Shell ─────────────────────────────────────────────────── */
  .mobile-nav {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-bottom: env(safe-area-inset-bottom, 0);
    box-shadow: 0 -4px 14px hsl(0 0% 0% / 0.22);
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-nav {
      display: flex;
    }
  }

  /* ── List ──────────────────────────────────────────────────── */
  .mobile-nav__list {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    width: 100%;
    height: var(--bottom-nav-height, 5.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── Item wrap (keeps <a> square, distributes equally) ─────── */
  .mobile-nav__item-wrap {
    flex: 1 1 0;
    min-width: 0;
  }

  /* ── Link / touch target ───────────────────────────────────── */
  .mobile-nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    height: 100%;
    min-height: 44px;
    padding: 0.4rem 0.2rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.0rem;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.01em;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--transition-fast);
  }

  .mobile-nav__item:hover {
    color: var(--color-text);
  }

  .mobile-nav__item.is-active {
    color: var(--color-accent);
  }

  /* ── Icon slot (placeholder shape) ─────────────────────────── */
  .mobile-nav__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-md);
    background-color: hsl(0 0% 100% / 0.04);
    transition: background-color var(--transition-fast);
  }

  .mobile-nav__item.is-active .mobile-nav__icon {
    background-color: hsl(32 95% 50% / 0.14);
  }

  .mobile-nav__icon-glyph {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    color: currentColor;
  }

  /* ── Label ─────────────────────────────────────────────────── */
  .mobile-nav__label {
    font-size: 1.0rem;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* ── Focus visible (keyboard) ──────────────────────────────── */
  .mobile-nav__item:focus-visible {
    outline: none;
  }

  .mobile-nav__item:focus-visible .mobile-nav__icon {
    box-shadow: var(--focus-ring);
  }

  /* ── Reduced motion ────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav__item,
    .mobile-nav__icon {
      transition: none;
    }
  }
</style>
