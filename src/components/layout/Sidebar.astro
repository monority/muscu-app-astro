---
/**
 * Sidebar — fixed left navigation, palworld.tools style.
 *
 * Visible on desktop (≥1024px) only. On smaller viewports, the
 * AppShell renders a slide-in drawer with the same nav data so
 * users get the same IA on every screen size.
 *
 * Structure:
 *   [logo + brand]
 *   [search input (decorative, disabled)]
 *   [nav groups → items (with optional sub-items)]
 *   [footer]
 */
interface NavLeaf {
  label: string;
  href: string;
  active?: boolean;
}
interface NavItem {
  label: string;
  href: string;
  icon?: string;
  children?: NavLeaf[];
  active?: boolean;
}
interface NavGroup {
  label: string;
  items: NavItem[];
}

interface Props {
  groups: NavGroup[];
  class?: string;
}

const { groups, class: className = "" } = Astro.props;

// Icon registry — Lucide-style line icons, 20×20, stroke=currentColor.
// The parent <a> sets the color (muted → accent on active), so the
// SVG inherits the right tint without us hardcoding anything.
const renderIcon = (name?: string): string => {
  if (!name) return "";
  const attrs =
    'viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
  const icons: Record<string, string> = {
    dashboard: `<svg ${attrs}><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>`,
    clipboard: `<svg ${attrs}><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>`,
    timer: `<svg ${attrs}><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    dumbbell: `<svg ${attrs}><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/></svg>`,
    "trending-up": `<svg ${attrs}><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    settings: `<svg ${attrs}><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,
  };
  return icons[name] ?? "";
};
---

<aside class:list={["sidebar", className]} aria-label="Navigation principale">
  {/* Logo */}
  <div class="sidebar__logo">
    <div class="sidebar__logo-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M14.4 14.4 9.6 9.6"></path>
        <path
          d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"
        ></path>
        <path d="m21.5 21.5-1.4-1.4"></path>
        <path d="M3.9 3.9 2.5 2.5"></path>
        <path
          d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"
        ></path>
      </svg>
    </div>
    <div class="sidebar__logo-text">
      <span class="sidebar__logo-name">muscu.app</span>
      <span class="sidebar__logo-subtitle">TRAINING LOG</span>
    </div>
  </div>

  {/* Search */}
  <div class="sidebar__search">
    <div class="sidebar__search-field">
      <svg
        class="sidebar__search-icon"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="search"
        placeholder="Rechercher…"
        disabled
        aria-label="Rechercher"
      />
      <kbd aria-hidden="true">/</kbd>
    </div>
  </div>

  {/* Nav */}
  <nav class="sidebar__nav">
    {
      groups.map((group) => (
        <div class="nav-group">
          <div class="nav-group__label">{group.label}</div>
          {group.items.map((item) => (
            <div class="nav-item-wrap">
              <a
                href={item.href}
                class:list={["nav-item", item.active && "is-active"]}
                aria-current={item.active ? "page" : undefined}
              >
                {item.icon && (
                  <span
                    class="nav-item__icon"
                    aria-hidden="true"
                    set:html={renderIcon(item.icon)}
                  />
                )}
                <span class="nav-item__label">{item.label}</span>
              </a>
              {item.children && item.children.length > 0 && (
                <div class="nav-subitems">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={["nav-subitem", child.active && "is-active"]}
                      aria-current={child.active ? "page" : undefined}
                    >
                      <span class="nav-subitem__label">{child.label}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      ))
    }
  </nav>

  {/* Footer */}
  <div class="sidebar__footer">
    <p>TRACK YOUR GAINS · STAY CONSISTENT</p>
  </div>
</aside>

<style>
  /* ── Shell ─────────────────────────────────────────────── */
  .sidebar {
    width: 26rem;
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-border);
    height: 100vh;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    flex-shrink: 0;
  }

  /* ── Logo ──────────────────────────────────────────────── */
  .sidebar__logo {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 2.0rem 1.6rem 1.2rem;
  }

  .sidebar__logo-icon {
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 1.0rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .sidebar__logo-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .sidebar__logo-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .sidebar__logo-subtitle {
    font-size: 0.95rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  /* ── Search ────────────────────────────────────────────── */
  .sidebar__search {
    padding: 0 1.2rem 1.6rem;
  }

  .sidebar__search-field {
    position: relative;
  }

  .sidebar__search input {
    width: 100%;
    height: 3.6rem;
    padding: 0 4.0rem 0 3.6rem;
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    background-color: var(--color-surface-2);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.3rem;
    line-height: 1;
    transition: border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .sidebar__search input::placeholder {
    color: var(--color-muted);
  }

  .sidebar__search input:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .sidebar__search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-muted);
    pointer-events: none;
  }

  .sidebar__search kbd {
    position: absolute;
    right: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    padding: 0.1rem 0.6rem;
    line-height: 1.2;
    pointer-events: none;
  }

  /* ── Nav ───────────────────────────────────────────────── */
  .sidebar__nav {
    flex: 1;
    padding: 0 0.8rem;
  }

  .nav-group {
    margin-bottom: 1.6rem;
  }

  .nav-group__label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.8rem 1.2rem 0.4rem;
    font-weight: 600;
  }

  .nav-item-wrap {
    display: flex;
    flex-direction: column;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    padding: 1.0rem 1.4rem;
    border-radius: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    transition: background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-item:hover {
    background-color: hsl(0 0% 100% / 0.04);
    color: var(--color-text);
  }

  .nav-item.is-active {
    background-color: hsl(32 95% 50% / 0.14);
    color: var(--color-accent);
  }

  .nav-item__icon {
    width: 2.0rem;
    height: 2.0rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .nav-item__icon :global(svg) {
    display: block;
  }

  .nav-item__label {
    flex: 1;
    min-width: 0;
  }

  /* ── Sub-items ─────────────────────────────────────────── */
  .nav-subitems {
    display: flex;
    flex-direction: column;
    padding-left: 3.2rem;
    margin-top: 0.2rem;
  }

  .nav-subitem {
    display: block;
    padding: 0.8rem 1.4rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.2;
    border-radius: 0.6rem;
    transition: background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-subitem:hover {
    color: var(--color-text);
    background-color: hsl(0 0% 100% / 0.03);
  }

  .nav-subitem.is-active {
    color: var(--color-accent);
    background-color: hsl(32 95% 50% / 0.08);
  }

  .nav-subitem__label {
    display: block;
  }

  /* ── Footer ────────────────────────────────────────────── */
  .sidebar__footer {
    padding: 1.6rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  .sidebar__footer p {
    margin: 0;
  }

  /* ── Focus visible ─────────────────────────────────────── */
  .nav-item:focus-visible,
  .nav-subitem:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .sidebar {
      display: none;
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .nav-item,
    .nav-subitem,
    .sidebar__search input {
      transition: none;
    }
  }
</style>
