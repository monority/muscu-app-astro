---
/**
 * Sidebar — fixed left navigation, palworld.tools style.
 *
 * Visible on desktop (≥1024px) only. On smaller viewports, the
 * AppShell renders a slide-in drawer with the same nav data so
 * users get the same IA on every screen size.
 *
 * Structure:
 *   [logo + brand]
 *   [search input (decorative, disabled)]
 *   [nav groups → items (with optional sub-items)]
 *   [footer]
 */
import { t, getLocale } from "../../i18n";

interface NavLeaf {
  label: string;
  href: string;
  active?: boolean;
}
interface NavItem {
  label: string;
  href: string;
  icon?: string;
  children?: NavLeaf[];
  active?: boolean;
}
interface NavGroup {
  label: string;
  items: NavItem[];
}

interface Props {
  groups: NavGroup[];
  class?: string;
}

const { groups, class: className = "" } = Astro.props;
const L = t();

// Icon registry — Lucide-style line icons, 20×20, stroke=currentColor.
// The parent <a> sets the color (muted → accent on active), so the
// SVG inherits the right tint without us hardcoding anything.
const renderIcon = (name?: string): string => {
  if (!name) return "";
  const attrs =
    'viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
  const icons: Record<string, string> = {
    dashboard: `<svg ${attrs}><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>`,
    clipboard: `<svg ${attrs}><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>`,
    timer: `<svg ${attrs}><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    calendar: `<svg ${attrs}><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
    dumbbell: `<svg ${attrs}><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/></svg>`,
    "trending-up": `<svg ${attrs}><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    calculator: `<svg ${attrs}><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><line x1="8" y1="14" x2="12" y2="14"/><line x1="8" y1="18" x2="12" y2="18"/><line x1="8" y1="10" x2="8.01" y2="10"/><line x1="12" y1="10" x2="12.01" y2="10"/><line x1="16" y1="10" x2="16.01" y2="10"/></svg>`,
    settings: `<svg ${attrs}><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,
    zap: `<svg ${attrs}><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  };
  return icons[name] ?? "";
};
---

<aside class:list={["sidebar", className]} aria-label={L.layout.mainNavAria}>
  {/* Logo */}
  <div class="sidebar__logo">
    <div class="sidebar__logo-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M14.4 14.4 9.6 9.6"></path>
        <path
          d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"
        ></path>
        <path d="m21.5 21.5-1.4-1.4"></path>
        <path d="M3.9 3.9 2.5 2.5"></path>
        <path
          d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"
        ></path>
      </svg>
    </div>
    <div class="sidebar__logo-text">
      <span class="sidebar__logo-name">muscu.app</span>
      <span class="sidebar__logo-subtitle">{L.layout.brandSubtitle}</span>
    </div>
  </div>

  {/* Search */}
  <div class="sidebar__search">
    <div class="sidebar__search-field">
      <svg
        class="sidebar__search-icon"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="search"
        placeholder={L.layout.searchPlaceholder}
        disabled
        aria-label={L.layout.searchAria}
      />
      <kbd aria-hidden="true">/</kbd>
    </div>
  </div>

  {/* Nav */}
  <nav class="sidebar__nav">
    {
      groups.map((group) => (
        <div class="nav-group">
          <div class="nav-group__label">{group.label}</div>
          {group.items.map((item) => (
            <div class="nav-item-wrap">
              <a
                href={item.href}
                class:list={["nav-item", item.active && "is-active"]}
                aria-current={item.active ? "page" : undefined}
              >
                {item.icon && (
                  <span
                    class="nav-item__icon"
                    aria-hidden="true"
                    set:html={renderIcon(item.icon)}
                  />
                )}
                <span class="nav-item__label">{item.label}</span>
              </a>
              {item.children && item.children.length > 0 && (
                <div class="nav-subitems">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={["nav-subitem", child.active && "is-active"]}
                      aria-current={child.active ? "page" : undefined}
                    >
                      <span class="nav-subitem__label">{child.label}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      ))
    }
  </nav>

  {/* Footer — user session + logout */}
  <div class="sidebar__footer" x-data="localeApp()">
    <div class="sidebar__user" data-user-zone hidden>
      <div class="sidebar__user-info">
        <span class="sidebar__user-label">{L.layout.signedInAs}</span>
        <span class="sidebar__user-name" data-user-name>—</span>
        <span class="sidebar__user-email" data-user-email>—</span>
      </div>
      <button
        type="button"
        class="sidebar__logout"
        data-logout
        aria-label={L.layout.logoutAria}
      >
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>{L.layout.logout}</span>
      </button>
    </div>

    {/* ── Theme toggle (added 2026-08-04) ──
        Switches between dark (default) and light themes. The
        `data-theme` attribute on <html> is the single source of
        truth; tokens.css applies the matching palette. */}
    <button
      type="button"
      class="sidebar__theme-toggle"
      @click="toggleTheme()"
      :aria-label="isDark() ? switchToLight : switchToDark"
      :title="isDark() ? switchToLight : switchToDark"
    >
      <span class="sidebar__theme-icon sidebar__theme-icon--sun" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
      </span>
      <span class="sidebar__theme-icon sidebar__theme-icon--moon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </span>
      <span class="sidebar__theme-label" x-text="isDark() ? themeLight : themeDark"></span>
    </button>

    {/* ── Locale switcher ──
        Toggles between the default (unprefixed) locale and /en,
        preserving the current path, query string and hash. */}
    <button
      type="button"
      class="sidebar__theme-toggle"
      @click="switchLocale()"
      :aria-label="switchLocaleAria"
      :title="switchLocaleAria"
    >
      <span class="sidebar__theme-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
      </span>
      <span class="sidebar__theme-label" x-text="localeLabel"></span>
    </button>

    <p class="sidebar__tagline">{L.layout.tagline}</p>
  </div>
</aside>

<script>
  import { t, getLocale } from "../../i18n";

  const L = t();

  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data("localeApp", () => ({
      locale: getLocale(),
      switchToLight: L.layout.switchToLight,
      switchToDark: L.layout.switchToDark,
      themeLight: L.layout.themeLight,
      themeDark: L.layout.themeDark,
      switchLocaleAria: L.layout.switchLocale,

      get localeLabel(): string {
        return this.locale === "en" ? L.layout.langEn : L.layout.langFr;
      },

      switchLocale() {
        const path = window.location.pathname;
        const search = window.location.search;
        const hash = window.location.hash;
        let target: string;
        if (this.locale === "en") {
          target = path.startsWith("/en") ? path.slice(3) : path;
          if (!target) target = "/";
        } else {
          target = "/en" + (path === "/" ? "" : path);
        }
        window.location.href = target + search + hash;
      },
    }));
  });
</script>

<style>
  /* ── Shell ─────────────────────────────────────────────── */
  /* Fixed on desktop (≥1024px) so it stays pinned to the viewport
     regardless of long page content (e.g. session builder with many
     exercises + notes). Hidden on mobile via the responsive block
     at the bottom, where `position` is irrelevant. */
  .sidebar {
    width: 26rem;
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-border);
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    flex-shrink: 0;
    z-index: 1;
  }

  /* ── Logo ──────────────────────────────────────────────── */
  .sidebar__logo {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 2rem 1.6rem 1.2rem;
  }

  .sidebar__logo-icon {
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 1rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .sidebar__logo-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .sidebar__logo-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .sidebar__logo-subtitle {
    font-size: 0.95rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  /* ── Search ────────────────────────────────────────────── */
  .sidebar__search {
    padding: 0 1.2rem 1.6rem;
  }

  .sidebar__search-field {
    position: relative;
  }

  .sidebar__search input {
    width: 100%;
    height: 3.6rem;
    padding: 0 4rem 0 3.6rem;
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    background-color: var(--color-surface-2);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.3rem;
    line-height: 1;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .sidebar__search input::placeholder {
    color: var(--color-muted);
  }

  .sidebar__search input:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .sidebar__search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-muted);
    pointer-events: none;
  }

  .sidebar__search kbd {
    position: absolute;
    right: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    padding: 0.1rem 0.6rem;
    line-height: 1.2;
    pointer-events: none;
  }

  /* ── Nav ───────────────────────────────────────────────── */
  .sidebar__nav {
    flex: 1;
    padding: 0 0.8rem;
  }

  .nav-group {
    margin-bottom: 1.6rem;
  }

  .nav-group__label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.8rem 1.2rem 0.4rem;
    font-weight: 600;
  }

  .nav-item-wrap {
    display: flex;
    flex-direction: column;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.4rem;
    border-radius: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-item:hover {
    background-color: var(--alpha-bg-subtle);
    color: var(--color-text);
  }

  .nav-item.is-active {
    background: none;
    color: var(--color-accent);
    border-left: 3px solid var(--color-accent);
    padding-left: calc(1.4rem - 3px);
    box-shadow: -2px 0 8px rgba(217, 119, 6, 0.3);
  }

  .nav-item__icon {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .nav-item__icon :global(svg) {
    display: block;
  }

  .nav-item__label {
    flex: 1;
    min-width: 0;
  }

  /* ── Sub-items ─────────────────────────────────────────── */
  .nav-subitems {
    display: flex;
    flex-direction: column;
    padding-left: 3.2rem;
    margin-top: 0.2rem;
  }

  .nav-subitem {
    display: block;
    padding: 0.8rem 1.4rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.2;
    border-radius: 0.6rem;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-subitem:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-subtle);
  }

  .nav-subitem.is-active {
    background: none;
    color: var(--color-accent);
    border-left: 2px solid var(--color-accent);
    padding-left: calc(1.4rem - 2px);
    box-shadow: -1px 0 6px rgba(217, 119, 6, 0.25);
  }

  .nav-subitem__label {
    display: block;
  }

  /* ── Footer ────────────────────────────────────────────── */
  .sidebar__footer {
    padding: 1.6rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .sidebar__tagline {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1.4;
    margin: 0;
  }

  /* ── User session block ────────────────────────────────── */
  .sidebar__user {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .sidebar__user[hidden] {
    display: none;
  }

  .sidebar__user-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .sidebar__user-label {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    line-height: 1;
  }

  .sidebar__user-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-text);
    font-weight: 700;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar__user-email {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar__logout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    height: 3.6rem;
    padding: 0 1.2rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .sidebar__logout:hover {
    background-color: hsl(0 80% 55% / 0.1);
    border-color: hsl(0 80% 55% / 0.35);
    color: var(--color-destructive);
  }

  .sidebar__logout:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .sidebar__logout:active {
    transform: scale(0.98);
  }

  /* ── Theme toggle (added 2026-08-04) ────────────────────── */
  .sidebar__theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    height: 3.6rem;
    padding: 0 1.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .sidebar__theme-toggle:hover {
    background-color: var(--color-surface-3);
    border-color: var(--alpha-border);
  }

  .sidebar__theme-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .sidebar__theme-toggle:active {
    transform: scale(0.98);
  }

  .sidebar__theme-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
