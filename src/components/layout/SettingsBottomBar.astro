---
/**
 * SettingsBottomBar — sticky right sidebar navigation for the settings page.
 *
 * Desktop (≥1024px): vertical column on the right side (sticky, no background).
 * Mobile  (<1024px): horizontally scrollable tab strip at bottom (original behavior).
 */
interface Props {
  sections: { id: string; label: string }[];
  activeSection?: string;
}

import { t } from "../../i18n";

const L = t();

const { sections, activeSection = "profile" } = Astro.props as Props;
---

<nav
  class="set-bar"
  aria-label={L.settings.sectionsAria}
  x-data={`settingsBarApp(${JSON.stringify(activeSection)})`}
  data-sections={JSON.stringify(sections)}
>
  <div class="set-bar__tabs" x-ref="tabs">
    <template x-for="sec in sections" :key="sec.id">
      <button
        type="button"
        class="set-bar__tab"
        :class="{ 'is-active': activeSection === sec.id }"
        :aria-current="activeSection === sec.id ? 'true' : null"
        :data-tab="sec.id"
        @click="select(sec.id)"
      >
        <span class="set-bar__tab-icon" x-html="iconFor(sec.id)"></span>
        <span class="set-bar__tab-label--full" x-text="sec.label"></span>
        <span class="set-bar__tab-label--short" x-text="shortFor(sec.label)"></span>
      </button>
    </template>
  </div>
</nav>

<script>
  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    const svgWrap = (body: string): string =>
      `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;

    // Icons keyed by section id (Lucide-style, stroke = currentColor).
    const iconFor = (id: string): string => {
      const icons: Record<string, string> = {
        profile: svgWrap(
          '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
        ),
        goals: svgWrap(
          '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
        ),
        units: svgWrap(
          '<path d="M6.5 6.5h11"/><path d="M6.5 17.5h11"/><path d="M3 12h18"/>',
        ),
        timer: svgWrap(
          '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/>',
        ),
        data: svgWrap(
          '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
        ),
        sync: svgWrap(
          '<path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25"/><polyline points="8 16 12 20 16 16"/>',
        ),
        about: svgWrap(
          '<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>',
        ),
      };
      return icons[id] ?? "";
    };

    Alpine.data("settingsBarApp", (initialActive: string) => ({
      activeSection: initialActive || "profile",
      sections: [] as { id: string; label: string }[],
      observer: null as IntersectionObserver | null,

      init() {
        const alpine = this as unknown as AlpineMagicThis;
        const el = alpine.$root;
        const raw = el.getAttribute("data-sections");
        if (raw) {
          try {
            this.sections = JSON.parse(raw);
          } catch {
            this.sections = [];
          }
        }

        alpine.$nextTick(() => {
          this.setupScrollspy();
          this.scrollTabIntoView(this.activeSection);
        });
      },

      iconFor(id: string) {
        return iconFor(id.replace(/^set-/, ""));
      },

      shortFor(label: string) {
        const short: Record<string, string> = {
          Profil: "Profil",
          Objectifs: "Obj.",
          Unités: "Unités",
          Timer: "Timer",
          Rappels: "Rappels",
          "Rappel d'entraînement": "Rappel",
          "Rappel du jour": "Rappel",
          Reminders: "Reminder",
          "Training reminder": "Reminder",
          Données: "Données",
          "Synchronisation WebDAV": "Synchro",
          "WebDAV sync": "Synchro",
          "À propos": "À propos",
        };
        return short[label] || label;
      },

      scrollTabIntoView(id: string, behavior: ScrollBehavior = "smooth") {
        const alpine = this as unknown as AlpineMagicThis;
        const tab = alpine.$root.querySelector(`[data-tab="${id}"]`);
        if (tab && "scrollIntoView" in tab) {
          tab.scrollIntoView({
            behavior,
            inline: "center",
            block: "nearest",
          });
        }
      },

      select(id: string) {
        this.activeSection = id;
        const el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
        this.scrollTabIntoView(id);
      },

      setupScrollspy() {
        const ids = this.sections.map((s) => s.id);
        this.observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.filter((e) => e.isIntersecting);
            if (visible.length === 0) return;
            const top = visible.reduce((a, b) =>
              b.boundingClientRect.top < a.boundingClientRect.top ? b : a,
            );
            const id = (top.target as HTMLElement).id;
            if (id && this.activeSection !== id) {
              this.activeSection = id;
              this.scrollTabIntoView(id, "auto");
            }
          },
          { rootMargin: "-10% 0px -30% 0px", threshold: 0 },
        );
        ids.forEach((id) => {
          const el = document.getElementById(id);
          if (el) this.observer?.observe(el);
        });
      },
    }));
  });
</script>

<style>
  .set-bar {
    position: fixed;
    top: calc(var(--topbar-height, 5.6rem) + 1rem);
    right: 1rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-body);
  }

  .set-bar__tabs {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .set-bar__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.2rem;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 1.3rem;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color var(--transition-fast),
      color var(--transition-fast);
  }
  .set-bar__tab:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-subtle);
  }
  .set-bar__tab.is-active {
    color: var(--color-accent);
    background-color: var(--alpha-bg-subtle);
  }
  .set-bar__tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .set-bar__tab-icon :global(svg) {
    width: 2.0rem;
    height: 2.0rem;
  }

  /* Full labels on desktop, short labels on mobile. */
  .set-bar__tab-label--full {
    display: none;
  }
  .set-bar__tab-label--short {
    display: inline;
  }

  @media (min-width: 1024px) {
    .set-bar__tab-label--full {
      display: inline;
    }
    .set-bar__tab-label--short {
      display: none;
    }
    .set-bar__tab {
      font-size: 1.4rem;
    }
  }

  /* Mobile: horizontal bottom bar */
  @media (max-width: 1023px) {
    .set-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: row;
      height: var(--bottom-nav-height, 5.6rem);
      align-items: center;
      padding: 0.8rem 0;
      background-color: var(--color-surface);
      border-top: 1px solid var(--color-border);
      box-shadow: var(--shadow-1);
    }
    .set-bar__tabs {
      flex-direction: row;
      gap: 0.4rem;
      padding: 0 1.2rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .set-bar__tabs::-webkit-scrollbar {
      display: none;
    }
  }
</style>