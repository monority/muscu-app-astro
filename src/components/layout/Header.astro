---
/**
 * Header â€” slim top bar.
 *
 * Layout (palworld.tools-style):
 *   [ â˜° ]   [ page title ]                              [ actions â€¦ ]
 *
 * - Hamburger is visible only on mobile/tablet (<1024px); it toggles
 *   a slide-in drawer (rendered by AppShell) that mirrors the
 *   sidebar's navigation.
 * - The brand logo lives in the Sidebar; this topbar stays minimal
 *   so the IA is owned by the side nav on every screen size.
 * - Quick-search trigger (icon + hint + "/" shortcut) sits right
 *   next to the hamburger in the topbar, always visible, so it stays
 *   reachable on every screen size.
 * - `title` is the current page title â€” shows the heading right
 *   where the user is looking, no need to scroll the content.
 */
interface Props {
  title?: string;
  class?: string;
}

import { t } from "../../i18n";
import Icon from "../ui/Icon.astro";

const L = t();

const { title, class: className = "" } = Astro.props as Props;
---

<header class:list={["topbar", className]} data-topbar>
  <div class="topbar__inner">
    {/* Hamburger (mobile/tablet only) */}
    <button
      type="button"
      class="topbar__hamburger"
      aria-label={L.layout.openMenu}
      aria-expanded="false"
      aria-controls="primary-drawer"
      data-mobile-toggle
    >
      <span class="topbar__hamburger-bar"></span>
      <span class="topbar__hamburger-bar"></span>
      <span class="topbar__hamburger-bar"></span>
    </button>

    {
      /* Search â€” opens the global quick-search palette on every
        screen size. */
    }
    <button
      type="button"
      class="topbar__search"
      data-quick-search-trigger
      aria-label={L.layout.searchAria}
      aria-haspopup="dialog"
      title={L.layout.searchAria}
    >
      <Icon name="search" size={18} />
      <span class="topbar__search-hint">{L.layout.searchPlaceholder}</span>
      <kbd aria-hidden="true">/</kbd>
    </button>

    <div class="topbar__context" aria-live="polite">
      <strong class="topbar__title">{title}</strong>
    </div>

    <div class="topbar__right">
      <slot name="actions" />

      {
        /* User / theme / locale controls â€” moved up from the sidebar
          footer so they stay reachable on every screen size. */
      }
      <div class="topbar__controls" x-data="localeApp()">
        {/* User info (populated by the AppShell auth script) */}
        <div class="topbar__user" data-user-zone hidden>
          <span class="topbar__user-name" data-user-name>â€”</span>
          <span class="topbar__user-email" data-user-email>â€”</span>
        </div>

        {/* Logout */}
        <button
          type="button"
          class="topbar__logout"
          data-logout
          aria-label={L.layout.logoutAria}
          title={L.layout.logoutAria}
        >
          <Icon name="logout" size={18} />
        </button>

        {
          /* Theme toggle â€” toggleTheme()/isDark() resolve from the
            parent themeApp scope on the AppShell root. */
        }
        <button
          type="button"
          class="topbar__control"
          @click="toggleTheme()"
          :aria-label="isDark() ? switchToLight : switchToDark"
          :title="isDark() ? switchToLight : switchToDark"
        >
          <span
            class="topbar__control-icon topbar__control-icon--sun"
            aria-hidden="true"
          >
            <Icon name="sun" size={18} />
          </span>
          <span
            class="topbar__control-icon topbar__control-icon--moon"
            aria-hidden="true"
          >
            <Icon name="moon" size={18} />
          </span>
        </button>

        {/* Locale switcher */}
        <button
          type="button"
          class="topbar__control"
          @click="switchLocale()"
          :aria-label="switchLocaleAria"
          :title="switchLocaleAria"
        >
          <Icon name="globe" size={18} />
          <span class="topbar__control-label" x-text="localeLabel"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import { t, getLocale } from "../../i18n";

  const L = t();

  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data("localeApp", () => ({
      get locale(): string {
        const l = (window as { __LOCALE__?: string }).__LOCALE__;
        return l === "en" ? "en" : "fr";
      },
      switchToLight: L.layout.switchToLight,
      switchToDark: L.layout.switchToDark,
      switchLocaleAria: L.layout.switchLocale,

      get localeLabel(): string {
        return this.locale === "en" ? L.layout.langEn : L.layout.langFr;
      },

      switchLocale() {
        const path = window.location.pathname;
        const search = window.location.search;
        const hash = window.location.hash;
        let target: string;
        if (this.locale === "en") {
          target = path.startsWith("/en") ? path.slice(3) : path;
          if (!target) target = "/";
        } else {
          target = "/en" + (path === "/" ? "" : path);
        }
        window.location.href = target + search + hash;
      },
    }));
  });
</script>

<style>
  /* â”€â”€ Shell â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .topbar {
    top: 0;
    /* Translucent + blur so the decorative background shows through
       a soft glass edge; solid fallback if unsupported. */
    background-color: color-mix(in srgb, var(--color-surface) 78%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--color-border);
  }

  /* â”€â”€ Solid fallback when backdrop-filter is unavailable â”€â”€ */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .topbar {
      background-color: var(--color-surface);
    }
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    height: var(--topbar-height);
    padding: 0 var(--page-padding-tablet);
  }

  /* â”€â”€ Page title â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .topbar__context {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .topbar__context-kicker {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .topbar__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* â”€â”€ Right cluster â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .topbar__right {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-left: auto;
    flex: 0 0 auto;
  }

  /* â”€â”€ Hamburger â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .topbar__hamburger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 4.4rem;
    height: 4.4rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0 1rem;
    color: var(--color-text);
    flex: 0 0 auto;
    transition: background-color var(--transition-fast);
  }

  .topbar__hamburger:hover {
    background-color: var(--alpha-bg-subtle);
  }

  .topbar__hamburger-bar {
    display: block;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast);
  }

  .topbar__hamburger[aria-expanded="true"] .topbar__hamburger-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .topbar__hamburger[aria-expanded="true"] .topbar__hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .topbar__hamburger[aria-expanded="true"] .topbar__hamburger-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* â”€â”€ Search trigger â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  /* Same visual language as the hamburger; opens the global
     quick-search palette on every screen size. */
  .topbar__search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 4.4rem;
    padding: 0 1.2rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-text);
    flex: 0 0 auto;
    transition: background-color var(--transition-fast);
  }

  .topbar__search:hover {
    background-color: var(--alpha-bg-subtle);
  }

  .topbar__search-hint {
    font-family: var(--font-body);
    font-size: 1.2rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .topbar__search kbd {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    padding: 0.1rem 0.6rem;
    line-height: 1.2;
    pointer-events: none;
  }

  /* â”€â”€ User / theme / locale controls â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .topbar__controls {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex: 0 0 auto;
  }

  /* User chip (name + email), compact inside the slim topbar. */
  .topbar__user {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    min-width: 0;
    max-width: 16rem;
    margin-right: 0.4rem;
    line-height: 1.2;
  }

  .topbar__user[hidden] {
    display: none;
  }

  .topbar__user-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .topbar__user-email {
    font-size: 1.05rem;
    color: var(--color-muted);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Icon buttons â€” same visual language as the hamburger/search. */
  .topbar__logout,
  .topbar__control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-width: 4.4rem;
    height: 4.4rem;
    padding: 0 1rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-text);
    flex: 0 0 auto;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .topbar__logout:hover,
  .topbar__control:hover {
    background-color: var(--alpha-bg-subtle);
  }

  .topbar__logout:focus-visible,
  .topbar__control:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .topbar__logout:active,
  .topbar__control:active {
    transform: scale(0.98);
  }

  /* Logout keeps its destructive hint on hover. */
  .topbar__logout:hover {
    background-color: color-mix(
      in srgb,
      var(--color-destructive) 10%,
      transparent
    );
    border-color: color-mix(in srgb, var(--color-destructive) 35%, transparent);
    color: var(--color-destructive);
  }

  .topbar__control-label {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    flex: 0 0 auto;
  }

  /* Sun visible in dark mode (suggests "switch to light"),
     moon visible in light mode (suggests "switch to dark"). */
  .topbar__control-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .topbar__control-icon--sun {
    display: inline-flex;
  }
  .topbar__control-icon--moon {
    display: none;
  }
  :global([data-theme="light"]) .topbar__control-icon--sun {
    display: none;
  }
  :global([data-theme="light"]) .topbar__control-icon--moon {
    display: inline-flex;
  }

  /* â”€â”€ Responsive â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  @media (min-width: 1024px) {
    .topbar__hamburger {
      display: none;
    }
    .topbar__inner {
      padding: 0 var(--page-padding-desktop);
    }
  }

  @media (max-width: 640px) {
    .topbar__inner {
      padding: 0 var(--page-padding-mobile);
    }
    .topbar__context-kicker {
      display: none;
    }
    .topbar__title {
      font-size: 1.3rem;
    }
    /* Save topbar space on small screens â€” keep the controls usable
       without allowing the search hint to push the right cluster offscreen. */
    .topbar__user-email,
    .topbar__control-label,
    .topbar__search-hint,
    .topbar__search kbd {
      display: none;
    }
    .topbar__search {
      width: 4.4rem;
      padding: 0;
      justify-content: center;
    }
    .topbar__inner {
      gap: 0.6rem;
    }
  }

  /* â”€â”€ Performance command bar overrides â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .topbar {
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    backdrop-filter: blur(12px);
  }
  .topbar__inner {
    gap: 1.6rem;
  }
  .topbar__context {
    border-left: 1px solid var(--color-border);
    padding-left: 1.6rem;
  }
  .topbar__search {
    background: var(--alpha-bg-subtle);
    border-color: var(--color-border);
  }
  .topbar__search:hover {
    background: var(--alpha-bg-soft);
  }
  .topbar__control,
  .topbar__logout,
  .topbar__hamburger {
    border-radius: var(--radius-sm);
  }
</style>
