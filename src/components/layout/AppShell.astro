---
/**
 * AppShell â€” orchestrates Sidebar + Header into the full layout.
 *
 * - Desktop (â‰¥1024px): sidebar (left) + topbar (top) + content
 * - Mobile  (<1024px): topbar (with hamburger) + content
 *                    + slide-in drawer (same nav as the sidebar)
 *
 * The brand lives in the Sidebar. The topbar carries the page
 * title and an actions slot. The drawer mirrors the sidebar nav
 * so the IA is identical on every screen size.
 */
import Sidebar from "./Sidebar.astro";
import Header from "./Header.astro";
import Icon from "../ui/Icon/Icon.astro";
import { t } from "../../i18n";
import { navId, renderIcon, chevronDown } from "../../lib/nav";
import type { NavGroup } from "../../lib/types";

interface Props {
  groups: NavGroup[];
  title?: string;
  class?: string;
}

const { groups, title, class: className = "" } = Astro.props as unknown as Props;
const L = t();

const classes = ["app-shell", className].filter(Boolean).join(" ");
---

<div class={classes} x-data="themeApp()" x-init="init()">
  <Sidebar groups={groups} />

  <div class="main-area">
    <Header title={title}>
      <slot name="actions" slot="actions" />
    </Header>
    <main class="page-content anim-fade-in">
      <slot />
    </main>
  </div>

  {/* Mobile drawer (hidden on desktop via CSS) */}
  <div
    class="drawer"
    id="primary-drawer"
    data-mobile-panel
    hidden
    aria-hidden="true"
  >
    <div class="drawer__backdrop" data-mobile-backdrop></div>
    <div
      class="drawer__panel"
      role="dialog"
      aria-modal="true"
      aria-label={L.layout.menuAria}
    >
      <div class="drawer__header">
        <div class="drawer__brand">
          <span class="drawer__brand-icon" aria-hidden="true">
            <Icon name="dumbbell" size={20} />
          </span>
          <span class="drawer__brand-text">muscu.app</span>
        </div>
        <button
          type="button"
          class="drawer__close"
          aria-label={L.layout.closeMenu}
          data-mobile-close
        >
          <Icon name="closeCross" size={20} />
        </button>
      </div>

      <nav class="drawer__nav" aria-label={L.layout.mobileNavAria}>
        {
          groups.map((group) => (
            <div class="drawer__group">
              <div class="drawer__group-label">{group.label}</div>
              {group.items.map((item) => (
                <div class="drawer__item-wrap">
                  {item.children && item.children.length > 0 ? (
                    <>
                      <button
                        type="button"
                        class="drawer__item drawer__item--toggle"
                        :class={`{ 'drawer__item--open': isExpanded('${navId(item.href)}'), 'drawer__item--parent-active': ${item.parentActive ?? false} }`}
                        :aria-expanded={`isExpanded('${navId(item.href)}')`}
                        aria-controls={`drawer-children-${navId(item.href)}`}
                        @click={`toggleNav('${navId(item.href)}')`}
                      >
                        {item.icon && (
                          <span
                            class="drawer__item-icon"
                            aria-hidden="true"
                            set:html={renderIcon(item.icon)}
                          />
                        )}
                        <span class="drawer__item-label">{item.label}</span>
                        <span
                          class="drawer__item-chevron"
                          aria-hidden="true"
                          set:html={chevronDown}
                        />
                      </button>
                      <div
                        class="drawer__children"
                        id={`drawer-children-${navId(item.href)}`}
                        data-nav-group={navId(item.href)}
                        :class={`{ 'is-open': isExpanded('${navId(item.href)}') }`}
                        role="region"
                      >
                        <div class="drawer__children-inner">
                          {item.children.map((child) => (
                            <a
                              href={child.href}
                              class:list={[
                                "drawer__subitem",
                                child.active && "is-active",
                              ]}
                              aria-current={child.active ? "page" : undefined}
                            >
                              <span>{child.label}</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    </>
                  ) : (
                    <>
                      <a
                        href={item.href}
                        class:list={["drawer__item", item.active && "is-active"]}
                        aria-current={item.active ? "page" : undefined}
                      >
                        {item.icon && (
                          <span
                            class="drawer__item-icon"
                            aria-hidden="true"
                            set:html={renderIcon(item.icon)}
                          />
                        )}
                        <span class="drawer__item-label">{item.label}</span>
                      </a>
                    </>
                  )}
                </div>
              ))}
            </div>
          ))
        }
      </nav>

      {/* Footer â€” user session + logout (mirrors sidebar) */}
      <div class="drawer__user" data-user-zone hidden>
        <div class="drawer__user-info">
          <span class="drawer__user-label">{L.layout.signedInAs}</span>
          <span class="drawer__user-name" data-user-name>â€”</span>
          <span class="drawer__user-email" data-user-email>â€”</span>
        </div>
        <button
          type="button"
          class="drawer__logout"
          data-logout
          aria-label={L.layout.logoutAria}
        >
          <Icon name="logout" size={16} />
        <span>{L.layout.logout}</span>
      </button>
    </div>
  </div>
</div>
</div>

<script>
  // â”€â”€ Mobile drawer toggle â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  (() => {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-mobile-toggle]"
    );
    const panel = document.querySelector<HTMLElement>("[data-mobile-panel]");
    const closeBtn = document.querySelector<HTMLButtonElement>(
      "[data-mobile-close]"
    );
    const backdrop = document.querySelector<HTMLElement>(
      "[data-mobile-backdrop]"
    );

    if (!toggle || !panel) return;

    let previouslyFocused: HTMLElement | null = null;

    const open = () => {
      previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.hidden = false;
      panel.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => {
        panel.classList.add("is-open");
        closeBtn?.focus();
      });
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      if (panel.hidden) return;
      panel.classList.remove("is-open");
      panel.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        if (panel && !panel.classList.contains("is-open")) {
          panel.hidden = true;
          previouslyFocused?.focus();
          previouslyFocused = null;
        }
      }, 240);
    };

    toggle.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);

    const getFocusable = (): HTMLElement[] =>
      Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => !element.hasAttribute("hidden"));

    document.addEventListener("keydown", (e) => {
      if (panel.hidden) return;
      if (e.key === "Escape") {
        close();
        return;
      }
      if (e.key !== "Tab" || !panel.classList.contains("is-open")) return;

      // Keep keyboard focus inside the modal drawer until it is closed.
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    panel.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => {
      a.addEventListener("click", () => close());
    });
  })();

  // â”€â”€ Auth gate + session display â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Runs only for pages that render the AppShell (every page except
  // /login, which uses AppLayout with empty groups and therefore
  // doesn't get this script). Keeps the public/login surface small
  // while protecting the rest of the app behind a localStorage check.
  import { getAuth, clearAuth } from "../../lib/auth";
  import { localizedPath } from "../../i18n";

  const logout = () => {
    clearAuth();
    window.location.href = localizedPath("/login");
  };

  // â”€â”€ Wire logout buttons (sidebar + drawer) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document
    .querySelectorAll<HTMLButtonElement>("[data-logout]")
    .forEach((btn) => {
      btn.addEventListener("click", logout);
    });

  // â”€â”€ Populate user session zones â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  const auth = getAuth();
  if (auth) {
    document.querySelectorAll<HTMLElement>("[data-user-name]").forEach((el) => {
      el.textContent = auth.name;
    });
    document
      .querySelectorAll<HTMLElement>("[data-user-email]")
      .forEach((el) => {
        el.textContent = auth.email;
      });
    document.querySelectorAll<HTMLElement>("[data-user-zone]").forEach((el) => {
      el.removeAttribute("hidden");
    });
  } else {
    // No session â†’ bounce to the login page. /login itself does NOT
    // render the AppShell, so this redirect never loops.
    window.location.replace("/login");
  }

  // â”€â”€ Theme + nav accordion Alpine data factory (added 2026-08-04) â”€
  // Exposed as `themeApp()` on the AppShell root. The <head> init
  // script in AppLayout.astro sets `data-theme` synchronously
  // before paint, so by the time Alpine boots we just need to
  // read the current value into reactive state and persist any
  // toggle to localStorage.
  //
  // The accordion state (`collapsed`) is shared between the desktop
  // sidebar and the mobile drawer â€” both live under this single
  // x-data root, so the same id toggles both copies.
  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    const ACCORDION_KEY = "muscu:nav:collapsed";

    Alpine.data("themeApp", () => ({
      theme: "dark" as "dark" | "light",
      collapsed: [] as string[],

      init() {
        const current =
          document.documentElement.getAttribute("data-theme") || "dark";
        this.theme = current === "light" ? "light" : "dark";
        this.initAccordion();
      },

      toggleTheme() {
        this.theme = this.theme === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", this.theme);
        try {
          window.localStorage.setItem("muscu-theme", this.theme);
        } catch {
          // private mode / quota â€” silently ignore, the in-memory
          // theme still applies for the current session
        }
      },

      isDark(): boolean {
        return this.theme === "dark";
      },

      // â”€â”€ Nav accordion â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
      // Groups are expanded by default; `collapsed` holds the ids of
      // the collapsed groups (persisted under `muscu:nav:collapsed`).
      isExpanded(id: string): boolean {
        return !this.collapsed.includes(id);
      },

      toggleNav(id: string) {
        const i = this.collapsed.indexOf(id);
        if (i >= 0) this.collapsed.splice(i, 1);
        else this.collapsed.push(id);
        try {
          window.localStorage.setItem(ACCORDION_KEY, JSON.stringify(this.collapsed));
        } catch {
          // private mode / quota â€” in-memory state still applies
        }
      },

      initAccordion() {
        try {
          const raw = window.localStorage.getItem(ACCORDION_KEY);
          const saved = raw ? JSON.parse(raw) : [];
          this.collapsed = Array.isArray(saved) ? saved : [];
        } catch {
          this.collapsed = [];
        }
        // Auto-expand any group whose children contain the active page
        // (e.g. /progression/records opens the "Progression" group even
        // if the user collapsed it earlier).
        const alpine = this as unknown as AlpineMagicThis;
        alpine.$nextTick(() => {
          alpine.$el
            .querySelectorAll<HTMLElement>("[data-nav-group]")
            .forEach((el) => {
              if (el.querySelector(".is-active")) {
                const id = el.getAttribute("data-nav-group");
                if (id) {
                  const i = this.collapsed.indexOf(id);
                  if (i >= 0) this.collapsed.splice(i, 1);
                }
              }
            });
        });
      },
    }));
  });
</script>

<style>
  /* â”€â”€ Shell layout â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .app-shell {
    display: flex;
    min-height: 100vh;
    align-items: stretch;
    /* Transparent so the decorative background layer (Background.astro)
       shows through â€” the html/body still carry the base color. */
  }

  .main-area {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    /* No background â€” the decorative layer shows through. */
    /* Mobile: the body is the scroll container, the topbar is
       `position: sticky` in Header.astro and pins to the top of
       the viewport. Desktop overrides below switch to an in-page
       scroll container (`.main-area` itself) so the fixed sidebar
       and fixed topbar stay anchored regardless of content height. */
  }

  .page-content {
    position: relative;
    flex: 1;
    padding: var(--page-padding-desktop);
    width: 100%;
    max-width: var(--page-max-w);
    margin-inline: auto;
    /* Allow the flex child to shrink below its content height so any
       visual overflow propagates to the scroll container instead of
       being clipped or pushing the body. */
    min-height: 0;
  }

  /* â”€â”€ Desktop: fixed sidebar + header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  /* Take the sidebar and topbar out of the flex flow so long pages
     (e.g. session builder with many exercises + notes) can no
     longer push them off screen. The main column gets the
     corresponding offsets and becomes the scroll container. */
  @media (min-width: 1024px) {
    :global(.sidebar) {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      width: var(--sidebar-width);
      z-index: 40;
    }

    :global(.topbar) {
      position: fixed;
      top: 0;
      left: var(--sidebar-width);
      right: 0;
      height: var(--topbar-height);
      z-index: 50;
      /* Translucent + blur â€” same glass edge as Header.astro. */
      background-color: color-mix(in srgb, var(--color-bg) 78%, transparent);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      backdrop-filter: blur(16px) saturate(1.4);
      border-bottom: 1px solid var(--color-border);
    }

    .main-area {
      margin-left: var(--sidebar-width);
      padding-top: var(--topbar-height); /* offset of the fixed topbar */
      height: 100vh;
      overflow-y: auto;
    }
  }

  /* â”€â”€ Drawer shell â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__backdrop {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, #000 55%, transparent);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .drawer.is-open .drawer__backdrop {
    opacity: 1;
  }

  .drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(30rem, 88vw);
    /* Translucent so the background shows through the drawer; blur
       keeps labels crisp (solid fallback below). */
    background-color: color-mix(in srgb, var(--color-surface) 64%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    backdrop-filter: blur(20px) saturate(1.2);
    border-right: 1px solid var(--color-border);
    box-shadow: 8px 0 24px color-mix(in srgb, #000 50%, transparent);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 240ms ease;
  }

  .drawer.is-open .drawer__panel {
    transform: translateX(0);
  }

  /* â”€â”€ Drawer header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 2.0rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer__brand {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    min-width: 0;
  }

  .drawer__brand-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 0.8rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .drawer__brand-text {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .drawer__close:hover {
    background-color: var(--alpha-bg-soft);
  }

  .drawer__close:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* â”€â”€ Drawer nav â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: 1.2rem 0.8rem 2.4rem;
  }

  .drawer__group {
    margin-bottom: 1.6rem;
  }

  .drawer__group-label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.8rem 1.2rem 0.4rem;
    font-weight: 600;
  }

  .drawer__item-wrap {
    display: flex;
    flex-direction: column;
  }

  .drawer__item {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    padding: 1.0rem 1.4rem;
    border-radius: var(--radius-md);
    background: transparent;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
    -webkit-appearance: none;
    appearance: none;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    transition: background-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .drawer__item:hover {
    background-color: var(--alpha-bg-subtle);
    color: var(--color-text);
  }

  .drawer__item.is-active {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  /* Parent with the deepest active child: accent text only (the pill
     stays on the active leaf, matching the desktop sidebar). */
  .drawer__item--parent-active {
    color: var(--color-accent);
  }

  .drawer__item-icon {
    width: 2.0rem;
    height: 2.0rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .drawer__item-icon :global(svg) {
    display: block;
  }

  .drawer__item-label {
    flex: 1;
    min-width: 0;
  }

  /* Collapsible toggle chevron â€” rotates when the group is expanded. */
  .drawer__item-chevron {
    display: inline-flex;
    flex-shrink: 0;
    color: currentColor;
    transition: transform var(--transition-fast);
  }

  .drawer__item--toggle.drawer__item--open .drawer__item-chevron {
    transform: rotate(180deg);
  }

  /* â”€â”€ Drawer child items (accordion body) â”€â”€ */
  /* Same 0fr â†’ 1fr grid animation as the desktop sidebar. */
  .drawer__children {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms ease;
  }

  .drawer__children.is-open {
    grid-template-rows: 1fr;
  }

  .drawer__children > .drawer__children-inner {
    overflow: hidden;
    min-height: 0;
    padding-left: 1.6rem;
  }

  .drawer__subitem {
    display: block;
    min-height: 4.4rem;
    padding: 1.0rem 1.4rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.2;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .drawer__subitem:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-subtle);
  }

  .drawer__subitem.is-active {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .drawer__item:focus-visible,
