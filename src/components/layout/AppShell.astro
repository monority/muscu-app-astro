---
/**
 * AppShell - orchestrates Sidebar + Header into the full layout.
 *
 * - Desktop (>=1024px): sidebar (left) + topbar (top) + content
 * - Mobile  (<1024px): topbar (with hamburger) + content
 *                    + slide-in drawer (same nav as the sidebar)
 */
import Sidebar from "./Sidebar.astro";
import Header from "./Header.astro";
import Icon from "../ui/Icon.astro";
import { t } from "../../i18n";
import { renderIcon } from "../../lib/nav";
import type { NavGroup, NavItem } from "../../lib/types";

interface Props {
  groups: NavGroup[];
  title?: string;
  class?: string;
}

const { groups, title, class: className = "" } = Astro.props as unknown as Props;
const L = t();

const classes = ["app-shell", className].filter(Boolean).join(" ");

// Flatten groups into items + children for the mobile drawer
const drawerItems = groups.map((group) => ({
  label: group.label,
  items: group.items.flatMap((item) => {
    const base = { ...item, children: undefined as undefined };
    if (!item.children?.length) return [base];
    return [base, ...item.children.map((c) => ({ ...c, isChild: true as const }))];
  }) as Array<NavItem & { isChild?: boolean; children: undefined }>,
}));
---

<div class={classes} x-data="themeApp()" x-init="init()">
  <Sidebar groups={groups} />

  <div class="main-area">
    <Header title={title}>
      <slot name="actions" slot="actions" />
    </Header>
    <main class="page-content">
      <slot />
    </main>
  </div>

  {/* Mobile drawer (hidden on desktop via CSS) */}
  <div
    class="drawer"
    id="primary-drawer"
    data-mobile-panel
    hidden
    aria-hidden="true"
  >
    <div class="drawer__backdrop" data-mobile-backdrop></div>
    <div
      class="drawer__panel"
      role="dialog"
      aria-modal="true"
      aria-label={L.layout.menuAria}
    >
      <div class="drawer__header">
        <div class="drawer__brand">
          <span class="drawer__brand-icon" aria-hidden="true">
            <Icon name="dumbbell" size={20} />
          </span>
          <span class="drawer__brand-text">muscu.app</span>
        </div>
        <button
          type="button"
          class="drawer__close"
          aria-label={L.layout.closeMenu}
          data-mobile-close
        >
          <Icon name="closeCross" size={20} />
        </button>
      </div>

      <nav class="drawer__nav" aria-label={L.layout.mobileNavAria}>
        {
          drawerItems.map((group) => (
            <div class="drawer__group">
              <div class="drawer__group-label">{group.label}</div>
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class:list={["drawer__item", item.active && "is-active", item.isChild && "drawer__item--child"]}
                  aria-current={item.active ? "page" : undefined}
                >
                  {item.icon && (
                    <span
                      class="drawer__item-icon"
                      aria-hidden="true"
                      set:html={renderIcon(item.icon)}
                    />
                  )}
                  <span class="drawer__item-label">{item.label}</span>
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      {/* Footer - user session + logout */}
      <div class="drawer__user" data-user-zone hidden>
        <div class="drawer__user-info">
          <span class="drawer__user-label">{L.layout.signedInAs}</span>
          <span class="drawer__user-name" data-user-name>--</span>
          <span class="drawer__user-email" data-user-email>--</span>
        </div>
        <button
          type="button"
          class="drawer__logout"
          data-logout
          aria-label={L.layout.logoutAria}
        >
          <Icon name="logout" size={16} />
          <span>{L.layout.logout}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile drawer toggle
  (() => {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-mobile-toggle]"
    );
    const panel = document.querySelector<HTMLElement>("[data-mobile-panel]");
    const closeBtn = document.querySelector<HTMLButtonElement>(
      "[data-mobile-close]"
    );
    const backdrop = document.querySelector<HTMLElement>(
      "[data-mobile-backdrop]"
    );

    if (!toggle || !panel) return;

    let previouslyFocused: HTMLElement | null = null;

    const open = () => {
      previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.hidden = false;
      panel.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => {
        panel.classList.add("is-open");
        closeBtn?.focus();
      });
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      if (panel.hidden) return;
      panel.classList.remove("is-open");
      panel.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        if (panel && !panel.classList.contains("is-open")) {
          panel.hidden = true;
          previouslyFocused?.focus();
          previouslyFocused = null;
        }
      }, 240);
    };

    toggle.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);

    const getFocusable = (): HTMLElement[] =>
      Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => !element.hasAttribute("hidden"));

    document.addEventListener("keydown", (e) => {
      if (panel.hidden) return;
      if (e.key === "Escape") {
        close();
        return;
      }
      if (e.key !== "Tab" || !panel.classList.contains("is-open")) return;

      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    panel.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => {
      a.addEventListener("click", () => close());
    });
  })();

  // Auth gate + session display
  import { getAuth, clearAuth } from "../../lib/auth";
  import { localizedPath } from "../../i18n";

  const logout = () => {
    clearAuth();
    window.location.href = localizedPath("/login");
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-logout]")
    .forEach((btn) => {
      btn.addEventListener("click", logout);
    });

  const auth = getAuth();
  if (auth) {
    document.querySelectorAll<HTMLElement>("[data-user-name]").forEach((el) => {
      el.textContent = auth.name;
    });
    document
      .querySelectorAll<HTMLElement>("[data-user-email]")
      .forEach((el) => {
        el.textContent = auth.email;
      });
    document.querySelectorAll<HTMLElement>("[data-user-zone]").forEach((el) => {
      el.removeAttribute("hidden");
    });
  } else {
    window.location.replace("/login");
  }

  // Theme + nav accordion Alpine data factory
  document.addEventListener("alpine:init", () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    const ACCORDION_KEY = "muscu:nav:collapsed";

    function readCollapsed(): string[] {
      try {
        const raw = window.localStorage.getItem(ACCORDION_KEY);
        const saved = raw ? JSON.parse(raw) : [];
        return Array.isArray(saved) ? saved : [];
      } catch {
        return [];
      }
    }

    Alpine.data("themeApp", () => ({
      theme: "dark" as "dark" | "light",
      collapsed: [] as string[],

      init() {
        const current =
          document.documentElement.getAttribute("data-theme") || "dark";
        this.theme = current === "light" ? "light" : "dark";
        this.collapsed = readCollapsed();
      },

      toggleTheme() {
        this.theme = this.theme === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", this.theme);
        try {
          window.localStorage.setItem("muscu-theme", this.theme);
        } catch {}
      },

      isDark(): boolean {
        return this.theme === "dark";
      },

      isExpanded(id: string): boolean {
        return !this.collapsed.includes(id);
      },

      toggleNav(id: string) {
        const i = this.collapsed.indexOf(id);
        if (i >= 0) this.collapsed.splice(i, 1);
        else this.collapsed.push(id);
        try {
          window.localStorage.setItem(ACCORDION_KEY, JSON.stringify(this.collapsed));
        } catch {}
      },
    }));
  });
</script>

<style>
  .app-shell {
    display: flex;
    min-height: 100vh;
    align-items: stretch;
  }

  .main-area {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    position: relative;
    flex: 1;
    padding: var(--page-padding-desktop);
    width: 100%;
    max-width: var(--page-max-w);
    margin-inline: auto;
    min-height: 0;
  }

  @media (min-width: 1024px) {
    :global(.sidebar) {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      width: var(--sidebar-width);
      z-index: 4;
    }

    :global(.topbar) {
      position: fixed;
      top: 0;
      left: var(--sidebar-width);
      right: 0;
      height: var(--topbar-height);
      z-index: 5;
      background-color: color-mix(in srgb, var(--color-bg) 78%, transparent);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      backdrop-filter: blur(16px) saturate(1.4);
      border-bottom: 1px solid var(--color-border);
    }

    .main-area {
      margin-left: var(--sidebar-width);
      padding-top: var(--topbar-height);
      height: 100vh;
      overflow-y: auto;
    }
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 6;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__backdrop {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, #000 55%, transparent);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .drawer.is-open .drawer__backdrop {
    opacity: 1;
  }

  .drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(30rem, 88vw);
    background-color: color-mix(in srgb, var(--color-surface) 64%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    backdrop-filter: blur(20px) saturate(1.2);
    border-right: 1px solid var(--color-border);
    box-shadow: 8px 0 24px color-mix(in srgb, #000 50%, transparent);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 240ms ease;
  }

  .drawer.is-open .drawer__panel {
    transform: translateX(0);
  }

  .drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 2.0rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer__brand {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    min-width: 0;
  }

  .drawer__brand-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 0.8rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .drawer__brand-text {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .drawer__close:hover {
    background-color: var(--alpha-bg-soft);
  }

  .drawer__close:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: 1.2rem 0.8rem 2.4rem;
  }

  .drawer__group {
    margin-bottom: 1.6rem;
  }

  .drawer__group-label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 0.8rem 1.2rem 0.4rem;
    font-weight: 600;
  }

  .drawer__item {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    min-height: 4.2rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-sm);
    background: transparent;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
    -webkit-appearance: none;
    appearance: none;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.2;
    position: relative;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .drawer__item:hover {
    background-color: var(--alpha-bg-subtle);
    color: var(--color-text);
  }

  .drawer__item.is-active {
    background: var(--alpha-bg-soft);
    color: var(--color-text);
  }

  .drawer__item.is-active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8rem;
    bottom: 0.8rem;
    width: 0.3rem;
    background: var(--color-accent);
    border-radius: 0 2px 2px 0;
  }

  .drawer__item-icon {
    width: 1.8rem;
    height: 1.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .drawer__item-icon :global(svg) {
    display: block;
  }

  .drawer__item-label {
    flex: 1;
    min-width: 0;
  }

  .drawer__item:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .drawer__item--child {
    padding-left: 3.2rem;
    min-height: 3.8rem;
    font-size: 1.2rem;
  }

  @media (min-width: 1024px) {
    .drawer {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .page-content {
      padding: var(--page-padding-tablet);
    }
  }

  @media (max-width: 640px) {
    .page-content {
      padding: var(--page-padding-mobile);
    }
  }

  .drawer__user {
    display: flex;
    flex-direction: column;
    gap: 1.0rem;
    margin: 1.2rem 0.8rem 1.2rem;
    padding: 1.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .drawer__user[hidden] {
    display: none;
  }

  .drawer__user-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .drawer__user-label {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    line-height: 1;
  }

  .drawer__user-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-text);
    font-weight: 700;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drawer__user-email {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drawer__logout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    height: 4.4rem;
    padding: 0 1.2rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .drawer__logout:hover {
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 35%, transparent);
    color: var(--color-destructive);
  }

  .drawer__logout:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .drawer__logout:active {
    transform: scale(0.98);
  }
</style>
