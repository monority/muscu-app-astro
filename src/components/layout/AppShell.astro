---
/**
 * AppShell — orchestrates Sidebar + Header into the full layout.
 *
 * - Desktop (≥1024px): sidebar (left) + topbar (top) + content
 * - Mobile  (<1024px): topbar (with hamburger) + content
 *                    + slide-in drawer (same nav as the sidebar)
 *
 * The brand lives in the Sidebar. The topbar carries the page
 * title and an actions slot. The drawer mirrors the sidebar nav
 * so the IA is identical on every screen size.
 */
import Sidebar from "./Sidebar.astro";
import Header from "./Header.astro";

export type NavLeaf = { label: string; href: string; active?: boolean };
export type NavItem = {
  label: string;
  href: string;
  icon?: string;
  children?: NavLeaf[];
  active?: boolean;
};
export type NavGroup = { label: string; items: NavItem[] };

interface Props {
  groups: NavGroup[];
  title?: string;
  class?: string;
}

const { groups, title, class: className = "" } = Astro.props;

const classes = ["app-shell", className].filter(Boolean).join(" ");

// Icon registry — Lucide-style line icons, 20×20, stroke=currentColor.
// The parent <a> sets the color (muted → accent on active), so the
// SVG inherits the right tint without us hardcoding anything.
const renderIcon = (name?: string): string => {
  if (!name) return "";
  const attrs =
    'viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
  const icons: Record<string, string> = {
    dashboard: `<svg ${attrs}><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>`,
    clipboard: `<svg ${attrs}><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>`,
    timer: `<svg ${attrs}><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    dumbbell: `<svg ${attrs}><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/></svg>`,
    "trending-up": `<svg ${attrs}><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    settings: `<svg ${attrs}><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,
  };
  return icons[name] ?? "";
};
---

<div class={classes}>
  <Sidebar groups={groups} />

  <div class="main-area">
    <Header title={title}>
      <slot name="actions" slot="actions" />
    </Header>
    <main class="page-content">
      <slot />
    </main>
  </div>

  {/* Mobile drawer (hidden on desktop via CSS) */}
  <div
    class="drawer"
    id="primary-drawer"
    data-mobile-panel
    hidden
    aria-hidden="true"
  >
    <div class="drawer__backdrop" data-mobile-backdrop></div>
    <div
      class="drawer__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Menu de navigation"
    >
      <div class="drawer__header">
        <div class="drawer__brand">
          <span class="drawer__brand-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14.4 14.4 9.6 9.6"></path>
              <path
                d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"
              ></path>
              <path d="m21.5 21.5-1.4-1.4"></path>
              <path d="M3.9 3.9 2.5 2.5"></path>
              <path
                d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"
              ></path>
            </svg>
          </span>
          <span class="drawer__brand-text">muscu.app</span>
        </div>
        <button
          type="button"
          class="drawer__close"
          aria-label="Fermer le menu"
          data-mobile-close
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 5L15 15M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>

      <nav class="drawer__nav" aria-label="Navigation mobile">
        {
          groups.map((group) => (
            <div class="drawer__group">
              <div class="drawer__group-label">{group.label}</div>
              {group.items.map((item) => (
                <div class="drawer__item-wrap">
                  <a
                    href={item.href}
                    class:list={["drawer__item", item.active && "is-active"]}
                    aria-current={item.active ? "page" : undefined}
                  >
                    {item.icon && (
                      <span
                        class="drawer__item-icon"
                        aria-hidden="true"
                        set:html={renderIcon(item.icon)}
                      />
                    )}
                    <span class="drawer__item-label">{item.label}</span>
                  </a>
                  {item.children && item.children.length > 0 && (
                    <div class="drawer__subitems">
                      {item.children.map((child) => (
                        <a
                          href={child.href}
                          class:list={[
                            "drawer__subitem",
                            child.active && "is-active",
                          ]}
                          aria-current={child.active ? "page" : undefined}
                        >
                          <span>{child.label}</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          ))
        }
      </nav>
    </div>
  </div>
</div>

<script>
  // ── Mobile drawer toggle ────────────────────────────────
  (() => {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-mobile-toggle]"
    );
    const panel = document.querySelector<HTMLElement>("[data-mobile-panel]");
    const closeBtn = document.querySelector<HTMLButtonElement>(
      "[data-mobile-close]"
    );
    const backdrop = document.querySelector<HTMLElement>(
      "[data-mobile-backdrop]"
    );

    if (!toggle || !panel) return;

    const open = () => {
      panel.hidden = false;
      panel.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => panel.classList.add("is-open"));
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      if (panel.hidden) return;
      panel.classList.remove("is-open");
      panel.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        if (panel && !panel.classList.contains("is-open")) panel.hidden = true;
      }, 240);
    };

    toggle.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) close();
    });

    panel.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => {
      a.addEventListener("click", () => close());
    });
  })();
</script>

<style>
  /* ── Shell layout ─────────────────────────────────────── */
  .app-shell {
    display: flex;
    min-height: 100vh;
    align-items: stretch;
  }

  .main-area {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    flex: 1;
    padding: 2.4rem;
  }

  /* ── Drawer shell ──────────────────────────────────────── */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__backdrop {
    position: absolute;
    inset: 0;
    background-color: hsl(0 0% 0% / 0.55);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .drawer.is-open .drawer__backdrop {
    opacity: 1;
  }

  .drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(30rem, 88vw);
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-border);
    box-shadow: 8px 0 24px hsl(0 0% 0% / 0.5);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 240ms ease;
  }

  .drawer.is-open .drawer__panel {
    transform: translateX(0);
  }

  /* ── Drawer header ────────────────────────────────────── */
  .drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 2.0rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer__brand {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    min-width: 0;
  }

  .drawer__brand-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 0.8rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .drawer__brand-text {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .drawer__close:hover {
    background-color: hsl(0 0% 100% / 0.05);
  }

  /* ── Drawer nav ────────────────────────────────────────── */
  .drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: 1.2rem 0.8rem 2.4rem;
  }

  .drawer__group {
    margin-bottom: 1.6rem;
  }

  .drawer__group-label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.8rem 1.2rem 0.4rem;
    font-weight: 600;
  }

  .drawer__item-wrap {
    display: flex;
    flex-direction: column;
  }

  .drawer__item {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    padding: 1.0rem 1.4rem;
    border-radius: 0.8rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.2;
    transition: background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .drawer__item:hover {
    background-color: hsl(0 0% 100% / 0.04);
    color: var(--color-text);
  }

  .drawer__item.is-active {
    background: none;
    color: var(--color-accent);
    border-left: 3px solid var(--color-accent);
    padding-left: calc(1.4rem - 3px);
    box-shadow: -2px 0 8px rgba(217, 119, 6, 0.3);
  }

  .drawer__item-icon {
    width: 2.0rem;
    height: 2.0rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .drawer__item-icon :global(svg) {
    display: block;
  }

  .drawer__item-label {
    flex: 1;
    min-width: 0;
  }

  .drawer__subitems {
    display: flex;
    flex-direction: column;
    padding-left: 3.2rem;
    margin-top: 0.2rem;
  }

  .drawer__subitem {
    display: block;
    padding: 0.8rem 1.4rem;
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.2;
    border-radius: 0.6rem;
    transition: background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .drawer__subitem:hover {
    color: var(--color-text);
    background-color: hsl(0 0% 100% / 0.03);
  }

  .drawer__subitem.is-active {
    background: none;
    color: var(--color-accent);
    border-left: 2px solid var(--color-accent);
    padding-left: calc(1.4rem - 2px);
    box-shadow: -1px 0 6px rgba(217, 119, 6, 0.25);
  }

  .drawer__item:focus-visible,
  .drawer__subitem:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .drawer {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .page-content {
      padding: 1.6rem;
    }
  }

  @media (max-width: 640px) {
    .page-content {
      padding: 1.2rem;
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .drawer__backdrop,
    .drawer__panel,
    .drawer__item,
    .drawer__subitem {
      transition: none;
    }
  }
</style>
