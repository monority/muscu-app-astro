---
/**
 * Session reminders â€” settings card + notification watcher.
 *
 * Follows the settings page conventions (Card primitives, CSS vars,
 * auto-save via `updateSettings`). The Alpine data registered below
 * both drives the form AND runs the reminder watcher: an immediate
 * check on page load plus a 30s interval. A reminder fires only when
 * the current day + minute match a configured slot, no session has
 * been completed today, and the same slot wasn't already notified
 * (cooldown persisted in localStorage + module-level fallback).
 *
 * Notification permission is requested ONLY when the user clicks the
 * explicit "Activer les notifications" button â€” never on page load.
 * When permission is not granted, the reminder falls back to the
 * in-app toast (`window.showToast`).
 */
import Card from '../ui/Card/Card.astro';
import CardHeader from '../ui/CardHeader.astro';
import CardTitle from '../ui/CardTitle.astro';
import CardContent from '../ui/CardContent.astro';
import Button from '../ui/Button/Button.astro';
import Toggle from '../ui/Toggle.astro';
import { t } from '../../i18n';
import { icons } from '../../lib/icons';

const L = t();
---

<section
  class="scroll-mt-[calc(var(--topbar-height,6.4rem)+1rem)]"
  id="set-reminder"
  x-data="reminderSettings()"
  x-init="init()"
  x-cloak
>
  <Card>
    <CardHeader>
      <div class="flex items-center gap-4 min-w-0">
        <span class="set__heading-icon inline-flex items-center justify-center w-[3.6rem] h-[3.6rem] shrink-0 text-[var(--color-accent)] rounded-[var(--radius-md)] border border-[color-mix(in_srgb,var(--color-accent)_28%,transparent)] bg-[color-mix(in_srgb,var(--color-accent)_12%,transparent)] max-[480px]:w-[3.2rem] max-[480px]:h-[3.2rem]" aria-hidden="true">
          <Fragment set:html={icons.bell(24, 24)} />
        </span>
        <CardTitle>{L.settings.reminders}</CardTitle>
      </div>
      <p class="text-[1.2rem] text-[var(--color-muted)] m-0 leading-normal">{L.settings.remindersDesc}</p>
    </CardHeader>

    <CardContent>
      <div class="rem__rows flex flex-col gap-0 mt-[1.2rem]" :class="{ 'rem__rows--disabled': !settings.reminders.enabled }">
        {/* â”€â”€ Master toggle â”€â”€ */}
        <div class="rem__row flex items-center justify-between gap-8 py-[1.6rem] border-b border-[var(--alpha-bg-soft)] first:pt-0 last:border-b-0 last:pb-0">
          <div class="rem__row-label flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="text-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-tight">{L.settings.reminderToggleLabel}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.reminderToggleDesc}</span>
          </div>
          <div class="rem__row-value shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums">
            <Toggle
              :checked="settings.reminders.enabled"
              :aria-checked="settings.reminders.enabled ? 'true' : 'false'"
              @change="setEnabled($event.target.checked)"
            />
          </div>
        </div>

        {/* â”€â”€ Day-of-week pickers â”€â”€ */}
        <div class="rem__row rem__row--form flex items-start justify-between gap-8 py-[1.6rem] border-b border-[var(--alpha-bg-soft)] first:pt-0 last:border-b-0 last:pb-0">
          <div class="rem__row-label flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="text-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-tight">{L.settings.reminderDaysLabel}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.reminderDaysDesc}</span>
          </div>
          <div class="rem__row-value--days shrink-0 max-w-[24rem]">
            <div class="rem__days flex flex-wrap gap-2 justify-end max-[480px]:justify-start" role="group" :aria-disabled="!settings.reminders.enabled">
              <template x-for="d in days" :key="d.v">
                <button
                  type="button"
                  class="rem__day appearance-none bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-pill)] text-[var(--color-muted)] text-[var(--font-body)] text-[1.1rem] font-bold tracking-[0.02em] h-[4.4rem] min-w-[4.8rem] px-[0.8rem] cursor-pointer transition-[background-color,color,border-color,transform] duration-[var(--transition-fast)]"
                  :class="{ 'rem__day--active': settings.reminders.days.includes(d.v) }"
                  :aria-pressed="settings.reminders.days.includes(d.v)"
                  :disabled="!settings.reminders.enabled"
                  @click="toggleDay(d.v)"
                  x-text="d.label"
                ></button>
              </template>
            </div>
          </div>
        </div>

        {/* â”€â”€ Time input â”€â”€ */}
        <div class="rem__row rem__row--form flex items-start justify-between gap-8 py-[1.6rem] border-b border-[var(--alpha-bg-soft)] first:pt-0 last:border-b-0 last:pb-0">
          <div class="rem__row-label flex flex-col gap-[var(--spacing-1)] min-w-0 flex-1">
            <span class="text-[var(--font-display)] text-[1.4rem] font-semibold text-[var(--color-text)] leading-tight">{L.settings.reminderTimeLabel}</span>
            <span class="text-[1.1rem] text-[var(--color-muted)] leading-[1.3]">{L.settings.reminderTimeDesc}</span>
          </div>
          <div class="rem__row-value shrink-0 text-right text-[1.3rem] text-[var(--color-muted)] tabular-nums">
            <input
              type="time"
              class="rem__time appearance-none bg-[var(--color-surface-2)] border border-[var(--color-border)] rounded-[var(--radius-sm)] text-[var(--color-text)] text-[var(--font-display)] text-[1.4rem] font-bold tabular-nums h-[4.4rem] w-[12rem] px-[1.2rem] outline-none transition-[border-color,box-shadow] duration-[var(--transition-fast)]"
              :value="settings.reminders.time"
              :disabled="!settings.reminders.enabled"
              @change="setTime($event.target.value)"
              aria-label={L.settings.reminderTimeLabel}
            />
          </div>
        </div>

        {/* â”€â”€ Permission request / status (only when reminders are on) â”€â”€ */}
        <div
          class="rem__status flex flex-col gap-[0.6rem] mt-[1.6rem] pt-[1.4rem] border-t border-[var(--alpha-bg-soft)]"
          x-show="settings.reminders.enabled"
          x-cloak
          x-transition.opacity.duration.200ms
        >
          {/* Unsupported browser â†’ graceful info message */}
          <p
            class="rem__status-text text-[1.2rem] leading-[1.4] m-0 text-[var(--color-muted)]"
            x-show="!supported"
            x-cloak
            x-text="labels.unsupported"
          >
            {L.settings.reminderUnsupported}
          </p>

          {/* Permission not yet asked â†’ explicit opt-in button */}
          <template x-if="supported && permission === 'default'">
            <div>
              <Button
                type="button"
                variant="secondary"
                size="sm"
                @click="requestPermission()"
              >
                {L.settings.reminderEnableNotifications}
              </Button>
            </div>
          </template>

          {/* Granted */}
          <p
            class="rem__status-text text-[1.2rem] leading-[1.4] m-0 text-[var(--color-success)] font-semibold"
            x-show="supported && permission === 'granted'"
            x-cloak
            x-text="labels.granted"
          >
            {L.settings.reminderGranted}
          </p>

          {/* Denied â†’ explain how to unblock */}
          <template x-if="supported && permission === 'denied'">
            <div>
              <p class="rem__status-text text-[1.2rem] leading-[1.4] m-0 text-[var(--color-warning)] font-semibold" x-text="labels.denied">
                {L.settings.reminderDenied}
              </p>
              <p class="text-[1.1rem] text-[var(--color-muted)] leading-[1.4] m-0" x-text="labels.deniedDesc">
                {L.settings.reminderDeniedDesc}
              </p>
            </div>
          </template>
        </div>
      </div>
    </CardContent>
  </Card>
</section>

<script>
  import {
    getSettings,
    updateSettings,
    getSessions,
    getStore,
    setStore,
    STORAGE_KEYS,
  } from '../../lib/storage';
  import { t } from '../../i18n';

  const L = t();

  // In-session cooldown fallback (also survives reloads via localStorage).
  let lastNotifiedSlot = '';

  document.addEventListener('alpine:init', () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('reminderSettings', () => ({
      settings: getSettings(),
      // Mon â†’ Sun UI order; values are Date#getDay() (0 = Sunday).
      days: [
        { v: 1, label: L.settings.reminderDayMon },
        { v: 2, label: L.settings.reminderDayTue },
        { v: 3, label: L.settings.reminderDayWed },
        { v: 4, label: L.settings.reminderDayThu },
        { v: 5, label: L.settings.reminderDayFri },
        { v: 6, label: L.settings.reminderDaySat },
        { v: 0, label: L.settings.reminderDaySun },
      ],
      supported: typeof Notification !== 'undefined',
      permission:
        typeof Notification !== 'undefined' ? Notification.permission : 'unsupported',
      labels: {
        granted: L.settings.reminderGranted,
        denied: L.settings.reminderDenied,
        deniedDesc: L.settings.reminderDeniedDesc,
        unsupported: L.settings.reminderUnsupported,
        notifTitle: L.settings.reminderTitle,
        notifBody: L.settings.reminderBody,
      },
      _timer: 0,

      init() {
        // Re-sync in case another tab wrote defaults/settings.
        this.settings = getSettings();
        this.syncPermission();
        // Immediate check on page load, then every 30s while open.
        this.check();
        this._timer = window.setInterval(() => this.check(), 30000);
      },

      // â”€â”€ Notification permission â”€â”€
      syncPermission() {
        this.supported = typeof Notification !== 'undefined';
        this.permission = this.supported
          ? Notification.permission
          : 'unsupported';
      },

      requestPermission() {
        if (!this.supported || typeof Notification.requestPermission !== 'function') {
          return;
        }
        try {
          const result = Notification.requestPermission();
          if (result && typeof result.then === 'function') {
            result.then((p: NotificationPermission) => {
              this.permission = p;
            });
          } else {
            this.permission = Notification.permission;
          }
        } catch {
          this.syncPermission();
        }
      },

      // â”€â”€ Persistence (auto-save, unit/goal section pattern) â”€â”€
      setEnabled(checked: boolean) {
        this.settings = updateSettings({
          reminders: { ...this.settings.reminders, enabled: checked },
        });
      },

      toggleDay(v: number) {
        const days = new Set(this.settings.reminders.days);
        if (days.has(v)) days.delete(v);
        else days.add(v);
        this.settings = updateSettings({
          reminders: { ...this.settings.reminders, days: [...days] },
        });
      },

      setTime(value: string) {
        if (typeof value !== 'string' || !/^(\d{2}):(\d{2})$/.test(value)) return;
        this.settings = updateSettings({
          reminders: { ...this.settings.reminders, time: value },
        });
      },

      // â”€â”€ Reminder watcher â”€â”€
      check() {
        const r = this.settings?.reminders;
        if (!r || !r.enabled) return;

        const now = new Date();
        // Day honored: only fire on configured days (getDay index).
        if (!r.days.includes(now.getDay())) return;

        const match = /^(\d{1,2}):(\d{2})$/.exec(r.time || '');
        if (!match) return;
        const slotMin = Number(match[1]) * 60 + Number(match[2]);
        const curMin = now.getHours() * 60 + now.getMinutes();
        // Time honored to the minute (interval is 30s, minute equality
        // can't be skipped).
        if (slotMin !== curMin) return;

        // Cooldown: never re-notify the same slot (day + minute).
        const key = this.slotKey(now);
        if (lastNotifiedSlot === key) return;
        if (getStore<string>(STORAGE_KEYS.reminderNotified, '') === key) return;

        // Skip when a session was already completed today.
        if (this.hasCompletedSessionToday(now)) return;

        lastNotifiedSlot = key;
        setStore(STORAGE_KEYS.reminderNotified, key);
        this.fire();
      },

      slotKey(d: Date): string {
        const p = (n: number) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
      },

      hasCompletedSessionToday(d: Date): boolean {
        const p = (n: number) => String(n).padStart(2, '0');
        const today = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
        return getSessions().some(
          (s) => s.status === 'completed' && s.date === today,
        );
      },

      fire() {
        if (this.supported && this.permission === 'granted') {
          try {
            const n = new Notification(this.labels.notifTitle, {
              body: this.labels.notifBody,
              tag: 'muscu-reminder',
            });
            // Notification created â€” a browser click focuses the app URL
            // by default. Keeping the handle avoids an unused binding.
            void n;
            return;
          } catch {
            // Permission type drift or blocked context â†’ toast fallback.
          }
        }
        // In-app toast fallback when Notification API is unavailable or
        // permission is not granted.
        if (typeof (window as { showToast?: (m: string, v?: string) => void }).showToast === 'function') {
          (window as { showToast?: (m: string, v?: string) => void }).showToast?.(
            this.labels.notifTitle,
            'info',
          );
        }
      },
    }));
  });
</script>

<style>
  /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     STATE-DEPENDENT SELECTORS (cannot be Tailwind utilities)
     â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
  .rem__rows--disabled .rem__row-label,
  .rem__rows--disabled .rem__row-title,
  .rem__rows--disabled .rem__row-hint,
  .rem__rows--disabled .rem__row-value {
    opacity: 0.55;
  }

  .rem__day:hover:not(:disabled):not(.rem__day--active) {
    background-color: var(--alpha-bg-subtle);
    color: var(--color-text);
  }

  .rem__day:active:not(:disabled) {
    transform: scale(0.95);
  }

  .rem__day.rem__day--active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-foreground);
    box-shadow: var(--shadow-1);
  }

  .rem__day:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .rem__day:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .rem__time:focus:not(:disabled) {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring);
  }

  .rem__time:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .rem__time::-webkit-calendar-picker-indicator {
    filter: invert(0.6);
    cursor: pointer;
  }

  /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     RESPONSIVE
     â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
  @media (max-width: 640px) {
    .rem__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
    .rem__row-value {
      text-align: left;
      max-width: 100%;
      width: 100%;
    }
    .rem__row-value--days {
      max-width: 100%;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rem__day,
    .rem__time { transition: none; }
  }
</style>
