---
import Badge from '../ui/Badge.astro';
import { t, getLocale, trExercise, trMuscle } from '../../i18n';

const L = t();
interface Props {
  name: string;
  date: string;
  duration?: string;
  exerciseCount: number;
  totalVolume?: string;
  exercises?: Array<{ name: string; muscle: string; setCount: number }>;
  status?: 'completed' | 'in-progress' | 'planned';
  class?: string;
}

const { name, date, duration, exerciseCount, totalVolume, exercises = [], status = 'planned', class: className = '' } = Astro.props as Props;
const statusConfig = { completed: { variant: 'success' as const, label: L.sessions.completed }, 'in-progress': { variant: 'accent' as const, label: L.sessions.inProgress }, planned: { variant: 'default' as const, label: L.sessions.planned } };
const config = statusConfig[status];
const formattedDate = (() => { const d = new Date(date); return Number.isNaN(d.getTime()) ? date : d.toLocaleDateString(getLocale() === 'fr' ? 'fr-FR' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' }); })();
const visibleExercises = exercises.slice(0, 4);
const hiddenCount = Math.max(0, exercises.length - visibleExercises.length);
---

<article class:list={['workout-record grid grid-cols-[0.5rem_minmax(0,1fr)auto] gap-4 items-start py-8 border-b border-[var(--color-border)]', `workout-record--${status}`, className]}>
  <div class="workout-record__status w-[0.5rem] h-full min-h-[8rem] bg-[var(--color-border-strong)]" aria-hidden="true"><span></span></div>
  <div class="min-w-0">
    <div class="flex items-center justify-between gap-[1.2rem] max-[480px]:items-start max-[480px]:flex-col">
      <h3 class="m-0 text-[2rem] tracking-tight">{name}</h3>
      <Badge variant={config.variant} size="sm">{config.label}</Badge>
    </div>
    <dl class="flex flex-wrap gap-[1.2rem_2.4rem] mt-4 max-[480px]:gap-[1rem_1.4rem]">
      <div class="flex flex-col gap-[0.2rem]"><dt class="text-[var(--color-muted)] text-[0.95rem] font-extrabold tracking-[0.12em] uppercase">{L.common.date}</dt><dd class="text-[var(--color-text)] text-[1.3rem] font-[650] tabular-nums">{formattedDate}</dd></div>
      <div class="flex flex-col gap-[0.2rem]"><dt class="text-[var(--color-muted)] text-[0.95rem] font-extrabold tracking-[0.12em] uppercase">{L.common.exercises}</dt><dd class="text-[var(--color-text)] text-[1.3rem] font-[650] tabular-nums">{exerciseCount}</dd></div>
      {duration && <div class="flex flex-col gap-[0.2rem]"><dt class="text-[var(--color-muted)] text-[0.95rem] font-extrabold tracking-[0.12em] uppercase">{L.common.duration}</dt><dd class="text-[var(--color-text)] text-[1.3rem] font-[650] tabular-nums">{duration}</dd></div>}
      {totalVolume && <div class="flex flex-col gap-[0.2rem]"><dt class="text-[var(--color-muted)] text-[0.95rem] font-extrabold tracking-[0.12em] uppercase">{L.sessions.volume}</dt><dd class="text-[var(--color-text)] text-[1.3rem] font-[650] tabular-nums">{totalVolume}</dd></div>}
    </dl>
    {visibleExercises.length > 0 && <div class="flex flex-wrap gap-[0.6rem_1.2rem] mt-[1.2rem] text-[var(--color-muted)] text-[1.2rem]">
      {visibleExercises.map((ex) => <span class="inline-flex gap-1 items-baseline">{trExercise(ex.name)} <small class="text-[var(--color-accent)] text-[1rem]">{trMuscle(ex.muscle)} · {ex.setCount}</small></span>)}
      {hiddenCount > 0 && <span class="text-[var(--color-muted)] !important">+{hiddenCount} {L.common.exercises}</span>}
    </div>}
  </div>
  <span class="text-[var(--color-accent)] text-[1.8rem]" aria-hidden="true">↗</span>
</article>

<style>
  .workout-record--completed .workout-record__status { background: var(--color-accent); }
  .workout-record--in-progress .workout-record__status { background: var(--color-info); }
  @media (max-width: 480px) { .workout-record { gap: 1rem; padding: 1.6rem 0; } }
</style>
