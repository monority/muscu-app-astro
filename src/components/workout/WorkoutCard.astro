---
/**
 * WorkoutCard — résumé compact d'une séance : nom, statut, métriques clés
 * (date, durée, nombre d'exercices, volume total) et liste condensée
 * des exercices avec leur muscle principal.
 */
import Card from '../ui/Card.astro';
import CardHeader from '../ui/CardHeader.astro';
import CardTitle from '../ui/CardTitle.astro';
import CardContent from '../ui/CardContent.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  name: string;
  date: string;
  duration?: string;
  exerciseCount: number;
  totalVolume?: string;
  exercises?: Array<{ name: string; muscle: string; setCount: number }>;
  status?: 'completed' | 'in-progress' | 'planned';
  class?: string;
}

const {
  name,
  date,
  duration,
  exerciseCount,
  totalVolume,
  exercises = [],
  status = 'planned',
  class: className = '',
} = Astro.props;

const statusConfig: Record<
  NonNullable<Props['status']>,
  { variant: 'success' | 'accent' | 'default'; label: string }
> = {
  completed: { variant: 'success', label: 'Terminée' },
  'in-progress': { variant: 'accent', label: 'En cours' },
  planned: { variant: 'default', label: 'Planifiée' },
};

const config = statusConfig[status];

const formattedDate = (() => {
  const d = new Date(date);
  if (Number.isNaN(d.getTime())) return date;
  return d.toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
})();

const visibleExercises = exercises.slice(0, 4);
const hiddenCount = Math.max(0, exercises.length - visibleExercises.length);
---

<Card variant="interactive" class={className}>
  <CardHeader>
    <CardTitle>{name}</CardTitle>
    <Badge variant={config.variant} size="sm">
      {config.label}
    </Badge>
  </CardHeader>

  <CardContent>
    <dl class="grid grid-cols-2 gap-x-4 gap-y-3 pb-3 sm:grid-cols-4">
      <div class="flex flex-col gap-0.5">
        <dt class="text-[1.1rem] uppercase tracking-wider text-[var(--color-muted)]">
          Date
        </dt>
        <dd class="text-[1.3rem] font-semibold text-[var(--color-text)]">
          {formattedDate}
        </dd>
      </div>

      <div class="flex flex-col gap-0.5">
        <dt class="text-[1.1rem] uppercase tracking-wider text-[var(--color-muted)]">
          Exercices
        </dt>
        <dd
          class="text-[1.3rem] font-semibold text-[var(--color-text)] tabular-nums"
        >
          {exerciseCount}
        </dd>
      </div>

      {duration && (
        <div class="flex flex-col gap-0.5">
          <dt class="text-[1.1rem] uppercase tracking-wider text-[var(--color-muted)]">
            Durée
          </dt>
          <dd
            class="text-[1.3rem] font-semibold text-[var(--color-text)] tabular-nums"
          >
            {duration}
          </dd>
        </div>
      )}

      {totalVolume && (
        <div class="flex flex-col gap-0.5">
          <dt class="text-[1.1rem] uppercase tracking-wider text-[var(--color-muted)]">
            Volume
          </dt>
          <dd
            class="text-[1.3rem] font-semibold text-[var(--color-text)] tabular-nums"
          >
            {totalVolume}
          </dd>
        </div>
      )}
    </dl>

    {visibleExercises.length > 0 && (
      <div
        class="flex flex-col gap-2 border-t border-[var(--color-border)] pt-3"
      >
        {visibleExercises.map((ex) => (
          <div class="flex items-center justify-between gap-2">
            <span class="truncate text-[1.3rem] text-[var(--color-text)]">
              {ex.name}
            </span>
            <div class="flex shrink-0 items-center gap-2">
              <Badge variant="default" size="sm">
                {ex.muscle}
              </Badge>
              <span
                class="text-[1.1rem] tabular-nums text-[var(--color-muted)]"
                aria-label={`${ex.setCount} séries`}
              >
                {ex.setCount} sets
              </span>
            </div>
          </div>
        ))}

        {hiddenCount > 0 && (
          <div
            class="pt-1 text-center text-[1.2rem] text-[var(--color-muted)]"
          >
            +{hiddenCount} autre{hiddenCount > 1 ? 's' : ''} exercice{hiddenCount > 1 ? 's' : ''}
          </div>
        )}
      </div>
    )}
  </CardContent>
</Card>
