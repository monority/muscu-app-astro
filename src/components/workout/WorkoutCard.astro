---
import Badge from '../ui/Badge.astro';
import { t, trExercise, trMuscle } from '../../i18n';
import { formatDateShort } from '../../lib/format';

const L = t();
interface Props {
  name: string;
  date: string;
  duration?: string;
  exerciseCount: number;
  totalVolume?: string;
  exercises?: Array<{ name: string; muscle: string; setCount: number }>;
  status?: 'completed' | 'in-progress' | 'planned';
  class?: string;
}

const { name, date, duration, exerciseCount, totalVolume, exercises = [], status = 'planned', class: className = '' } = Astro.props as Props;
const statusConfig = { completed: { variant: 'success' as const, label: L.sessions.completed }, 'in-progress': { variant: 'accent' as const, label: L.sessions.inProgress }, planned: { variant: 'default' as const, label: L.sessions.planned } };
const config = statusConfig[status];
const formattedDate = formatDateShort(date);
const visibleExercises = exercises.slice(0, 4);
const hiddenCount = Math.max(0, exercises.length - visibleExercises.length);
---

<article class:list={['workout-record', `workout-record--${status}`, className]}>
  <div class="workout-record__status" aria-hidden="true"><span></span></div>
  <div class="workout-record__body">
    <div class="workout-record__top">
      <h3 class="workout-record__name">{name}</h3>
      <Badge variant={config.variant} size="sm">{config.label}</Badge>
    </div>
    <dl class="workout-record__meta">
      <div class="workout-record__meta-item"><dt class="dt-label">{L.common.date}</dt><dd class="workout-record__meta-value">{formattedDate}</dd></div>
      <div class="workout-record__meta-item"><dt class="dt-label">{L.common.exercises}</dt><dd class="workout-record__meta-value">{exerciseCount}</dd></div>
      {duration && <div class="workout-record__meta-item"><dt class="dt-label">{L.common.duration}</dt><dd class="workout-record__meta-value">{duration}</dd></div>}
      {totalVolume && <div class="workout-record__meta-item"><dt class="dt-label">{L.sessions.volume}</dt><dd class="workout-record__meta-value">{totalVolume}</dd></div>}
    </dl>
    {visibleExercises.length > 0 && <div class="workout-record__exercises">
      {visibleExercises.map((ex) => <span class="workout-record__ex">{trExercise(ex.name)} <small class="workout-record__ex-detail">{trMuscle(ex.muscle)} · {ex.setCount}</small></span>)}
      {hiddenCount > 0 && <span class="workout-record__ex-more">+{hiddenCount} {L.common.exercises}</span>}
    </div>}
  </div>
  <span class="workout-record__arrow" aria-hidden="true">↗</span>
</article>

<style>
  .workout-record {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr) auto;
    gap: 1.6rem;
    align-items: start;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .workout-record__status {
    width: 0.5rem;
    height: 100%;
    min-height: 8rem;
    background: var(--color-border-strong);
    border-radius: 2px;
  }
  .workout-record--completed .workout-record__status { background: var(--color-accent); }
  .workout-record--in-progress .workout-record__status { background: var(--color-info); }

  .workout-record__body { min-width: 0; }

  .workout-record__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .workout-record__name {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.02em;
  }

  .workout-record__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
    margin-top: 1.6rem;
  }

  .workout-record__meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .workout-record__meta-value {
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .workout-record__exercises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    margin-top: 1.2rem;
    color: var(--color-muted);
    font-size: 1.2rem;
  }

  .workout-record__ex {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
  }

  .workout-record__ex-detail {
    color: var(--color-accent);
    font-size: 1rem;
  }

  .workout-record__ex-more {
    color: var(--color-muted);
  }

  .workout-record__arrow {
    color: var(--color-accent);
    font-size: 1.8rem;
  }

  @media (max-width: 480px) {
    .workout-record { gap: 1rem; padding: 1.6rem 0; }
    .workout-record__top { flex-direction: column; align-items: flex-start; }
    .workout-record__meta { gap: 1rem 1.4rem; }
  }
</style>
