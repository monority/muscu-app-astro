---
import Badge from '../ui/Badge.astro';
import SetRow from './SetRow.astro';
import { t } from '../../i18n';

const L = t();

interface Props {
  name: string;
  muscle: string;
  sets: Array<{ weight: number; reps: number; completed: boolean; type?: string }>;
  expanded?: boolean;
  class?: string;
}

const { name, muscle, sets, expanded = false, class: className = '' } = Astro.props as Props;
const completedCount = sets.filter((set) => set.completed).length;
const classes = ['workout-exercise', completedCount === sets.length && sets.length > 0 && 'workout-exercise--complete', className].filter(Boolean).join(' ');
---

<article class:list={['flex flex-col gap-[1.4rem] py-8 border-b-separator', classes]}>
  <header class="flex items-start justify-between gap-[1.2rem]">
    <div class="flex items-start gap-4 min-w-0">
      <span class="workout-exercise__marker w-2 h-[3.8rem] shrink-0 bg-[var(--color-border-strong)]" aria-hidden="true"></span>
      <div>
        <h3 class="m-0 text-[var(--color-text)] text-[1.9rem] tracking-tight">{name}</h3>
        <span class="block mt-1 text-[var(--color-muted)] text-[1.1rem] font-bold tracking-[0.12em] uppercase">{muscle}</span>
      </div>
    </div>
    <Badge variant={completedCount === sets.length && sets.length > 0 ? 'success' : 'default'} size="sm">
      {completedCount}/{sets.length}
    </Badge>
  </header>

  {sets.length > 0 && (
    <div class="flex gap-[0.8rem] text-[var(--color-muted)] text-[1.2rem]" aria-label={`${sets.length} sets`}>
      <span>{sets.length} {L.common.sets}</span>
      <span class="text-[var(--color-accent)]" aria-hidden="true">/</span>
      <span>{completedCount} {L.sessions.completed.toLowerCase()}</span>
    </div>
  )}

  {expanded && sets.length > 0 && (
    <div class="border-t border-[var(--color-border-strong)]" role="list" aria-label={name}>
      <div class="set-row-grid px-4 py-[0.8rem] text-[var(--color-muted)] text-[0.9rem] font-extrabold tracking-[0.14em] max-[480px]:px-[0.4rem]" aria-hidden="true"><span>SET</span><span>LOAD</span><span></span><span>REPS</span><span>TYPE</span><span></span></div>
      {sets.map((set, i) => <SetRow index={i + 1} weight={set.weight} reps={set.reps} completed={set.completed} type={set.type} />)}
    </div>
  )}
</article>

<style>
  .workout-exercise { padding: 2rem 0; }
  .workout-exercise--complete .workout-exercise__marker { background: var(--color-accent); }
  @media (max-width: 480px) { .workout-exercise { padding: 1.6rem 0; } }
</style>
