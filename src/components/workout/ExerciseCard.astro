---
import Badge from '../ui/Badge.astro';
import SetRow from './SetRow.astro';
import { t } from '../../i18n';

const L = t();

interface Props {
  name: string;
  muscle: string;
  sets: Array<{ weight: number; reps: number; completed: boolean; type?: string }>;
  expanded?: boolean;
  class?: string;
}

const { name, muscle, sets, expanded = false, class: className = '' } = Astro.props as Props;
const completedCount = sets.filter((set) => set.completed).length;
const classes = ['workout-exercise', completedCount === sets.length && sets.length > 0 && 'workout-exercise--complete', className].filter(Boolean).join(' ');
---

<article class={classes}>
  <header class="workout-exercise__header">
    <div class="workout-exercise__identity">
      <span class="workout-exercise__marker" aria-hidden="true"></span>
      <div>
        <h3 class="workout-exercise__name">{name}</h3>
        <span class="workout-exercise__muscle">{muscle}</span>
      </div>
    </div>
    <Badge variant={completedCount === sets.length && sets.length > 0 ? 'success' : 'default'} size="sm">
      {completedCount}/{sets.length}
    </Badge>
  </header>

  {sets.length > 0 && (
    <div class="workout-exercise__summary" aria-label={`${sets.length} sets`}>
      <span>{sets.length} {L.common.sets}</span>
      <span class="workout-exercise__summary-separator" aria-hidden="true">/</span>
      <span>{completedCount} {L.sessions.completed.toLowerCase()}</span>
    </div>
  )}

  {expanded && sets.length > 0 && (
    <div class="workout-exercise__sets" role="list" aria-label={name}>
      <div class="workout-exercise__set-head" aria-hidden="true"><span>SET</span><span>LOAD</span><span></span><span>REPS</span><span>TYPE</span><span></span></div>
      {sets.map((set, i) => <SetRow index={i + 1} weight={set.weight} reps={set.reps} completed={set.completed} type={set.type} />)}
    </div>
  )}
</article>

<style>
  .workout-exercise { display: flex; flex-direction: column; gap: 1.4rem; padding: 2rem 0; border-bottom: 1px solid var(--color-border); }
  .workout-exercise__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.2rem; }
  .workout-exercise__identity { display: flex; align-items: flex-start; gap: 1rem; min-width: 0; }
  .workout-exercise__marker { width: 0.5rem; height: 3.8rem; flex: 0 0 auto; background: var(--color-border-strong); }
  .workout-exercise--complete .workout-exercise__marker { background: var(--color-accent); }
  .workout-exercise__name { margin: 0; color: var(--color-text); font-size: 1.9rem; letter-spacing: -0.03em; }
  .workout-exercise__muscle { display: block; margin-top: 0.4rem; color: var(--color-muted); font-size: 1.1rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .workout-exercise__summary { display: flex; gap: 0.8rem; color: var(--color-muted); font-size: 1.2rem; }
  .workout-exercise__summary-separator { color: var(--color-accent); }
  .workout-exercise__sets { border-top: 1px solid var(--color-border-strong); }
  .workout-exercise__set-head { display: grid; grid-template-columns: 3.2rem minmax(6rem, 1fr) 2rem minmax(6rem, 1fr) auto 2.4rem; gap: 0.8rem; padding: 0.8rem 1rem; color: var(--color-muted); font-size: 0.9rem; font-weight: 800; letter-spacing: 0.14em; }
  @media (max-width: 480px) { .workout-exercise { padding: 1.6rem 0; } .workout-exercise__set-head { grid-template-columns: 2.6rem minmax(5rem, 1fr) 1.4rem minmax(5rem, 1fr) auto 2rem; gap: 0.4rem; padding: 0.8rem 0.4rem; } }
</style>
