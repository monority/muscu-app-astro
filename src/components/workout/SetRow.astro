---
import { t } from '../../i18n';

const L = t();

interface Props {
  index: number;
  weight: number;
  reps: number;
  completed: boolean;
  type?: string;
  class?: string;
}

const { index, weight, reps, completed, type, class: className = '' } = Astro.props as Props;
const classes = ['workout-set', completed && 'workout-set--completed', className].filter(Boolean).join(' ');
const ariaLabel = `${index} · ${weight} ${L.common.kg} × ${reps} ${L.common.reps}${type ? ` · ${type}` : ''}${completed ? ` · ${L.sessions.completed}` : ''}`;
---

<div class={classes} role="listitem" aria-label={ariaLabel}>
  <span class="workout-set__index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
  <span class="workout-set__load">{weight}<small>{L.common.kg}</small></span>
  <span class="workout-set__multiply" aria-hidden="true">×</span>
  <span class="workout-set__reps">{reps}<small>{L.common.reps}</small></span>
  {type && <span class="workout-set__type">{type}</span>}
  <span class:list={['workout-set__status', completed && 'is-complete']} aria-hidden="true">
    {completed ? '✓' : '—'}
  </span>
</div>

<style>
  .workout-set { display: grid; grid-template-columns: 3.2rem minmax(6rem, 1fr) 2rem minmax(6rem, 1fr) auto 2.4rem; align-items: center; gap: 0.8rem; min-height: 4.8rem; padding: 0 1rem; border-bottom: 1px solid var(--color-border); color: var(--color-muted); }
  .workout-set:last-child { border-bottom: 0; }
  .workout-set--completed { color: var(--color-text); }
  .workout-set__index { color: var(--color-muted); font-size: 1.1rem; font-weight: 800; letter-spacing: 0.06em; }
  .workout-set__load, .workout-set__reps { color: var(--color-text); font-size: 1.5rem; font-weight: 750; font-variant-numeric: tabular-nums; }
  .workout-set__load small, .workout-set__reps small { margin-left: 0.4rem; color: var(--color-muted); font-size: 1rem; font-weight: 600; }
  .workout-set__multiply { color: var(--color-accent); font-size: 1.3rem; text-align: center; }
  .workout-set__type { padding: 0.4rem 0.6rem; color: var(--color-info); font-size: 0.95rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .workout-set__status { color: var(--color-muted); font-size: 1.3rem; text-align: center; }
  .workout-set__status.is-complete { color: var(--color-accent); }
  @media (max-width: 480px) { .workout-set { grid-template-columns: 2.6rem minmax(5rem, 1fr) 1.4rem minmax(5rem, 1fr) auto 2rem; gap: 0.4rem; padding: 0 0.4rem; } .workout-set__type { font-size: 0.85rem; } }
</style>
