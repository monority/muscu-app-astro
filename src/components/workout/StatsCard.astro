---
import Card from '../ui/Card.astro';

interface Props {
  label: string;
  value: string | number;
  unit?: string;
  trend?: 'up' | 'down' | 'neutral';
  trendValue?: string;
  icon?: string;
  class?: string;
}

const {
  label,
  value,
  unit,
  trend,
  trendValue,
  icon,
  class: className = '',
} = Astro.props;

const trendColorMap: Record<NonNullable<Props['trend']>, string> = {
  up: 'text-[var(--color-success)]',
  down: 'text-[var(--color-destructive)]',
  neutral: 'text-[var(--color-muted)]',
};

const trendArrowMap: Record<NonNullable<Props['trend']>, string> = {
  up: '↑',
  down: '↓',
  neutral: '→',
};

const trendClasses = trend ? trendColorMap[trend] : '';
const trendArrow = trend ? trendArrowMap[trend] : '';
---
<Card class={className}>
  <div class="flex flex-col gap-1">
    <div class="flex items-center gap-2">
      {icon && (
        <span
          class="text-[var(--color-muted)] inline-flex items-center justify-center w-[1.8rem] h-[1.8rem]"
          aria-hidden="true"
          set:html={icon}
        />
      )}
      <span class="text-[1.1rem] text-[var(--color-muted)] uppercase tracking-wider">
        {label}
      </span>
    </div>

    <div class="flex items-baseline">
      <span
        class="text-display font-bold text-[clamp(2rem,5vw,2.4rem)] tabular-nums"
      >
        {value}
      </span>
      {unit && (
        <span class="text-[1.1rem] text-[var(--color-muted)] ml-1">{unit}</span>
      )}
    </div>

    {(trend || trendValue) && (
      <div class={`flex items-center gap-1 text-[1.1rem] ${trendClasses}`}>
        {trend && <span aria-hidden="true">{trendArrow}</span>}
        {trendValue && <span>{trendValue}</span>}
      </div>
    )}
  </div>
</Card>
