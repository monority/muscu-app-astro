---
import { icons } from "lucide";
import type { LucideIcon } from "lucide";

type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const LucideIcon = icons[name] as LucideIcon;
const svg = LucideIcon?.toSvg ? LucideIcon.toSvg({ width: size, height: size }) : "";
---

{
  svg ? <span class={className} set:html={svg} role="img" aria-label={name} /> : null
}
