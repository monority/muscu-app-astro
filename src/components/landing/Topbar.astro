---
type Props = {
  label?: string;
};

const { label = "Muscu App" } = Astro.props as Props;
---

<header class="topbar" aria-label={label}>
  <div class="topbar-pill">
    <span class="topbar-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="presentation" focusable="false">
        <path d="M4 12h4M16 12h4M8 8v8M16 8v8"></path>
      </svg>
    </span>

    <span class="topbar-brand">{label}</span>

    <span class="topbar-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="presentation" focusable="false">
        <path d="M12 7v5l3 2"></path>
        <circle cx="12" cy="12" r="8"></circle>
      </svg>
    </span>
  </div>
</header>

<style>
  .topbar {
    display: flex;
    justify-content: center;
  }

  .topbar-pill {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.1rem;
    padding: 0.55rem 1.1rem 0.55rem 0.7rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
    border-radius: var(--radius-pill);
    background: hsl(0 0% 100% / 0.025);
    box-shadow: var(--shadow-1);
  }

  .topbar-brand {
    color: var(--text);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .topbar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border: 1px solid hsl(0 0% 100% / 0.08);
    border-radius: var(--radius-pill);
    background: hsl(0 0% 100% / 0.02);
    color: var(--muted);
  }

  .topbar-icon svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
