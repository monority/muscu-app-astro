---
import CityLabel from "../ui/CityLabel.astro";
import LiveClock from "../ui/LiveClock.astro";

type Props = {
  city?: string;
};

const { city = "Paris" } = Astro.props as Props;
---

<footer class="landing-status" aria-label="Contexte actuel">
  <CityLabel city={city} />
  <LiveClock />
</footer>

<style>
  .landing-status {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.6rem;
    width: min(100%, 64rem);
    margin-inline: auto;
    padding-inline: 0.2rem;
  }

  @media (max-width: 640px) {
    .landing-status {
      width: 100%;
      align-items: start;
    }
  }
</style>
