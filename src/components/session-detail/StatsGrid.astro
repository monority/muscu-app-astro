---
import { icons } from '../../lib/icons';
---

<div class="detail__stats-grid">
  <div class="detail__stat">
    <div class="detail__stat-label">
      <span class="detail__stat-icon" set:html={icons.clockStopwatch()} />
      <span x-text="labels.duration"></span>
    </div>
    <div
      class="detail__stat-value"
      x-text="formatDuration(session.duration)"
    ></div>
  </div>
  <div class="detail__stat detail__stat--volume">
    <div class="detail__stat-label">
      <span class="detail__stat-icon" set:html={icons.volumeBox()} />
      <span x-text="labels.totalVolume"></span>
    </div>
    <div
      class="detail__stat-value"
      x-text="formatVolume(sessionTotalVolume)"
    ></div>
  </div>
  <div class="detail__stat">
    <div class="detail__stat-label">
      <span class="detail__stat-icon" set:html={icons.list()} />
      <span x-text="labels.exercises"></span>
    </div>
    <div
      class="detail__stat-value"
      x-text="session.exercises.length"
    ></div>
  </div>
</div>
