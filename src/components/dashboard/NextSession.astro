---
/**
 * NextSession — actionable next workout card.
 *
 * Renders inside Alpine x-data scope (dashboardApp).
 */
import { t, localizedPath } from "../../i18n";

const L = t();
---

<section
  class="dash__next"
  x-show="nextSession"
  aria-label={L.dashboard.nextSession}
>
  <div class="dash__next-kicker" x-text="labels.nextSession">
    {L.dashboard.nextSession}
  </div>
  <div class="dash__next-main">
    <div class="dash__next-copy">
      <h2 class="dash__next-name" x-text="nextSession?.name"></h2>
      <p
        class="dash__next-hint"
        x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.plannedWorkoutHint"
      >
      </p>
    </div>
    <a
      class="dash__next-action"
      :href="localizedPath('/sessions/quick?session=' + nextSession?.id)"
    >
      <span
        x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.startWorkout"
      ></span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .dash__next {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .dash__next-kicker {
    margin-bottom: 0.8rem;
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dash__next-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .dash__next-name {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  .dash__next-hint {
    margin: 0.6rem 0 0;
    color: var(--color-muted);
    font-size: 1.3rem;
  }

  .dash__next-action {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.4rem;
    padding: 0 1.4rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 1.2rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .dash__next-action:hover {
    background: var(--color-accent);
    color: var(--color-accent-foreground);
  }
</style>
