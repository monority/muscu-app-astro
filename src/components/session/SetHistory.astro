---
---

<div class="set-history">
  <p class="set-history-title">Historique des séries</p>
  <div class="set-history-empty">
    <p>Aucune série enregistrée. Commence par sélectionner un exercice.</p>
  </div>
  <ol class="set-history-list" data-set-history hidden></ol>
</div>

<style>
  .set-history {
    display: grid;
    gap: var(--gap-card);
  }

  .set-history-title {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .set-history-empty {
    padding: 2rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .set-history-empty p {
    margin: 0;
    color: var(--muted);
    font-size: 1.3rem;
  }

  .set-history-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .set-history-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    animation: setItemIn 200ms ease both;
  }

  @keyframes setItemIn {
    from { opacity: 0; transform: translateY(-0.4rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  .set-history-list .set-number {
    color: var(--muted);
    font-size: 1.2rem;
    font-weight: 700;
    min-width: 2.4rem;
    flex-shrink: 0;
  }

  .set-history-list .set-detail {
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .set-history-list .set-rest {
    color: var(--muted);
    font-size: 1.2rem;
    flex: 1;
  }

  .set-history-list .set-actions {
    display: flex;
    gap: 0.2rem;
    flex-shrink: 0;
  }

  .set-delete-btn,
  .set-edit-btn {
    width: 2.8rem;
    height: 2.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    font-size: 1.2rem;
    cursor: pointer;
    transition: color var(--motion-fast), background var(--motion-fast);
  }

  .set-delete-btn:hover {
    color: var(--accent);
    background: hsl(0 84% 60% / 0.08);
  }

  .set-edit-btn:hover {
    color: var(--text);
    background: hsl(0 0% 100% / 0.06);
  }
</style>
