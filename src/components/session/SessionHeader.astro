---
type Props = {
  exerciseName?: string;
  setCount?: number;
};

const { exerciseName, setCount } = Astro.props as Props;
---

<div class="session-header">
  <div class="session-header-indicator">
    <span class="session-header-dot" aria-hidden="true"></span>
    <span class="session-header-status">Séance en cours</span>
  </div>
  <p class="session-header-exercise" data-exercise-name>
    {exerciseName ?? "Aucun exercice sélectionné"}
  </p>
  <p class="session-header-meta">
    <span data-set-count>{setCount ?? 0}</span> série(s)
  </p>
</div>

<style>
  .session-header {
    display: grid;
    gap: 0.6rem;
    padding: var(--space-page-padding);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-align: center;
  }

  .session-header-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .session-header-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .session-header-status {
    color: hsl(0 0% 100% / 0.4);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .session-header-exercise {
    margin: 0;
    color: var(--text);
    font-size: 1.8rem;
    font-weight: 600;
    font-family: var(--font-display);
  }

  .session-header-meta {
    margin: 0;
    color: var(--muted);
    font-size: 1.3rem;
  }
</style>
