---

<div class="exercise-picker">
  <label class="exercise-picker-label" for="exercise-search">Exercice</label>
  <div class="exercise-picker-filters" data-ex-filter-chips hidden>
    <button class="ex-filter-chip" type="button" data-filter-muscle="">Tous</button>
  </div>
  <div class="exercise-picker-control">
    <input
      id="exercise-search"
      class="exercise-picker-input"
      type="search"
      placeholder="Chercher un exerciceâ€¦"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-haspopup="listbox"
      aria-autocomplete="list"
      aria-activedescendant=""
      data-exercise-search
    />
    <ul class="exercise-picker-results" data-exercise-results role="listbox" hidden></ul>
  </div>
  <p class="exercise-picker-selected" data-exercise-selected hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    <span data-exercise-name></span>
    <button class="exercise-picker-change" type="button" data-exercise-change>Changer</button>
  </p>
  <div class="recent-exercises hidden" data-recent-exercises>
    <span class="recent-exercises-label">RÃ©cents</span>
    <div class="recent-exercises-list" data-recent-list></div>
  </div>
  <div class="prev-perf hidden" data-prev-perf>
    <a data-prev-perf-session href="" class="prev-perf-link">
      <span class="prev-perf-age" data-prev-perf-age></span>
    </a>
    <span class="prev-perf-sets" data-prev-perf-sets></span>
  </div>
</div>


