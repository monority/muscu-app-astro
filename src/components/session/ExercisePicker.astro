---
---

<div class="exercise-picker">
  <label class="exercise-picker-label" for="exercise-search">Exercice</label>
  <div class="exercise-picker-filters" data-ex-filter-chips hidden>
    <button class="ex-filter-chip" type="button" data-filter-muscle="">Tous</button>
  </div>
  <div class="exercise-picker-control">
    <input
      id="exercise-search"
      class="exercise-picker-input"
      type="search"
      placeholder="Chercher un exercice…"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-haspopup="listbox"
      aria-autocomplete="list"
      aria-activedescendant=""
      data-exercise-search
    />
    <ul class="exercise-picker-results" data-exercise-results role="listbox" hidden></ul>
  </div>
  <p class="exercise-picker-selected" data-exercise-selected hidden>
    ✓ <span data-exercise-name></span>
    <button class="exercise-picker-change" type="button" data-exercise-change>Changer</button>
  </p>
  <div class="recent-exercises hidden" data-recent-exercises>
    <span class="recent-exercises-label">Récents</span>
    <div class="recent-exercises-list" data-recent-list></div>
  </div>
  <div class="prev-perf hidden" data-prev-perf>
    <a data-prev-perf-session href="" class="prev-perf-link">
      <span class="prev-perf-age" data-prev-perf-age></span>
    </a>
    <span class="prev-perf-sets" data-prev-perf-sets></span>
  </div>
</div>

<style>
  .exercise-picker {
    display: grid;
    gap: 0.6rem;
  }

  .exercise-picker-label {
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exercise-picker-control {
    position: relative;
  }

  .exercise-picker-input {
    width: 100%;
    min-height: 4.4rem;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
    font-size: 1.6rem;
    outline: none;
    -webkit-appearance: none;
  }

  .exercise-picker-input:focus {
    border-color: var(--accent);
    box-shadow: var(--focus-ring);
  }

  .exercise-picker-input::placeholder {
    color: hsl(0 0% 100% / 0.25);
  }

  .exercise-picker-results {
    position: absolute;
    z-index: 10;
    top: 100%;
    left: 0;
    right: 0;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-3);
    overflow: hidden;
  }

  .exercise-picker-results li {
    padding: 1rem 1.2rem;
    cursor: pointer;
    font-size: 1.4rem;
    color: var(--text);
  }

  .exercise-picker-results li:hover,
  .exercise-picker-results li[aria-selected="true"] {
    background: hsl(0 84% 60% / 0.1);
  }

  .exercise-picker-results li[data-create] {
    color: var(--accent);
    font-weight: 600;
    border-top: 1px solid var(--border);
  }

  .exercise-picker-selected {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--text);
    font-size: 1.4rem;
  }

  .exercise-picker-change {
    margin-left: auto;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .exercise-picker-change:hover {
    color: var(--text);
    border-color: hsl(0 0% 100% / 0.2);
  }

  .prev-perf {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0.6rem 1rem;
    border: 1px solid hsl(0 0% 100% / 0.1);
    border-radius: var(--radius-sm);
    background: hsl(0 84% 60% / 0.06);
    font-size: 1.2rem;
    color: var(--muted);
  }

  .prev-perf-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .prev-perf-link:hover {
    text-decoration: underline;
  }

  .prev-perf-sets {
    color: var(--text);
  }

  .exercise-picker-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ex-filter-chip {
    min-height: 2.8rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .ex-filter-chip[data-active] {
    border-color: var(--accent);
    color: var(--text);
    background: hsl(0 84% 60% / 0.08);
  }

  .ex-filter-chip:hover {
    border-color: hsl(0 0% 100% / 0.2);
    color: var(--text);
  }

  .recent-exercises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    font-size: 1.2rem;
  }

  .recent-exercises-label {
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .recent-exercises-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .recent-exercise-btn {
    min-height: 2.8rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .recent-exercise-btn:hover {
    border-color: var(--accent);
    color: var(--text);
    background: hsl(0 84% 60% / 0.08);
  }

  .ex-result-meta {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.2rem;
  }

  .ex-result-badge {
    font-size: 1rem;
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  .ex-result-badge.muscle {
    background: hsl(140 50% 40% / 0.15);
    color: hsl(140 70% 60%);
  }

  .ex-result-badge.equipment {
    background: hsl(200 50% 40% / 0.15);
    color: hsl(200 70% 60%);
  }

  .exercise-picker-results li {
    padding: 0.8rem 1.2rem;
  }

  .exercise-picker-results li .ex-result-name {
    font-size: 1.4rem;
    color: var(--text);
  }
</style>
