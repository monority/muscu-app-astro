---
import { icons } from "./icons";

type Props = {
  href: string;
  icon: keyof typeof icons;
  label: string;
  active?: boolean;
};

const { href, icon, label, active = false } = Astro.props;
---

<li class="nav-item" aria-current={active ? "page" : undefined}>
  <a href={href} class:list={["nav-link", { "nav-link-active": active }]}>
    <span class="nav-icon" set:html={icons[icon]} />
    <span class="nav-label">{label}</span>
  </a>
</li>

<style>
  .nav-item {
    list-style: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.6rem;
    border-radius: var(--radius-md);
    color: var(--muted);
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 600;
    transition: all var(--motion-fast);
  }

  .nav-link:hover {
    color: var(--text);
    background: hsl(0 0% 100% / 0.04);
  }

  .nav-link-active,
  .nav-link-active:hover {
    color: var(--text);
    background: hsl(0 84% 60% / 0.1);
    border-left: 3px solid var(--accent);
  }

  .nav-icon {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  .nav-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
