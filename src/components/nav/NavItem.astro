---
export type NavItemProps = {
  href: string;
  icon: string;
  label: string;
  active: boolean;
};

const { href, icon, label, active } = Astro.props;
---

<a href={href} class="nav-item" aria-current={active ? "page" : undefined}>
  <span class="nav-icon" data-icon={icon}></span>
  <span class="nav-label">{label}</span>
</a>


