---
import "../styles/globals.css";
import AppShell from "../components/layout/AppShell.astro";
import { t, setLocale, getLocale, localizedPath } from "../i18n";

/**
 * Nav structure for the sidebar (palworld.tools style).
 *
 * - `label`: group name (rendered as section header)
 * - `items`: top-level links
 * - `icon`:  icon name (rendered as inline SVG by Sidebar/drawer)
 * - `children`: optional sub-links, indented under the parent
 */
export type NavLeaf = { label: string; href: string; active?: boolean };
export type NavItem = {
  label: string;
  href: string;
  icon?: string;
  children?: NavLeaf[];
  active?: boolean;
};
export type NavGroup = { label: string; items: NavItem[] };
export type NavTree = NavGroup[];

interface Props {
  title: string;
  description?: string;
  groups?: NavTree;
}

const L = t();

const defaultGroups: NavTree = [
  {
    label: L.nav.groups.workout,
    items: [
      { label: L.nav.dashboard, href: localizedPath("/"), icon: "dashboard" },
      {
        label: L.nav.seances,
        href: localizedPath("/seances"),
        icon: "clipboard",
        children: [
          { label: L.nav.historique, href: localizedPath("/seances") },
          { label: L.nav.creer, href: localizedPath("/seances/creer") },
        ],
      },
      { label: L.nav.rapide, href: localizedPath("/seances/rapide"), icon: "zap" },
      { label: L.nav.timer, href: localizedPath("/timer"), icon: "timer" },
      { label: L.nav.calendrier, href: localizedPath("/calendrier"), icon: "calendar" },
    ],
  },
  {
    label: L.nav.groups.data,
    items: [
      { label: L.nav.exercices, href: localizedPath("/exercices"), icon: "dumbbell" },
      {
        label: L.nav.progression,
        href: localizedPath("/progression"),
        icon: "trending-up",
        children: [
          { label: L.nav.force, href: localizedPath("/progression") },
          { label: L.nav.poidsMesures, href: localizedPath("/progression/poids") },
          { label: L.nav.records, href: localizedPath("/progression/records") },
          { label: L.nav.statistiques, href: localizedPath("/progression/stats") },
        ],
      },
    ],
  },
  {
    label: L.nav.groups.tools,
    items: [
      { label: L.nav.calculateur, href: localizedPath("/calculateur"), icon: "calculator" },
      { label: L.nav.settings, href: localizedPath("/settings"), icon: "settings" },
    ],
  },
];

const {
  title,
  description,
  groups = defaultGroups,
} = Astro.props;

const currentPath = Astro.url.pathname;

// Derive the active locale from the URL so the nav tree (and the
// <html lang>) always match the page being rendered.
const currentLocale = currentPath.startsWith("/en") ? "en" : "fr";
setLocale(currentLocale);

// Mark active state on each item (and its children when present)
// so the Sidebar and the mobile drawer can highlight the right
// link without recomputing on the client.
const groupsWithActive = groups.map((g) => ({
  label: g.label,
  items: g.items.map((it) => {
    const isActive =
      currentPath === it.href ||
      (it.href !== "/" && currentPath.startsWith(it.href + "/"));
    return {
      ...it,
      active: isActive,
      children: it.children?.map((c) => ({
        ...c,
        active:
          currentPath === c.href ||
          (c.href !== "/" && currentPath.startsWith(c.href + "/")),
      })),
    };
  }),
}));
---

<html lang={getLocale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Muscu App</title>
    <meta
      name="description"
      content={description || L.layout.appTagline}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#D97706" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="muscu.app" />

    {/* ── Locale bootstrap ──
        Exposes the server-rendered locale so client-side Alpine
        components (via t()/getLocale()) resolve the same language
        as the HTML they live in. Runs before the theme block. */}
    <script is:inline>
      window.__LOCALE__ = '{getLocale()}';
    </script>

    {/* ── Theme bootstrap (added 2026-08-04) ──
        Runs synchronously in the head, BEFORE first paint, so the
        page never flashes the wrong palette when the user has
        chosen the light theme. The Alpine-side toggle lives in
        AppShell.astro; this block is the only thing that needs to
        be inline to avoid a flash. */}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('muscu-theme') || 'dark';
          if (theme !== 'light' && theme !== 'dark') theme = 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* localStorage unavailable (SSR / private mode) — keep
             the default dark theme via the @theme block. */
        }
      })();
    </script>
  </head>
  <body>
    {
      groupsWithActive.length > 0 ? (
        <AppShell groups={groupsWithActive} title={title}>
          <slot />
        </AppShell>
      ) : (
        <main style="max-width: 96rem; margin: 0 auto; padding: 2.4rem;">
          <slot />
        </main>
      )
    }

    <script is:inline>
      // Register the service worker for offline use (gym wifi is spotty).
      // Deferred until the load event so it doesn't compete with first paint.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch((err) => {
            console.warn("[muscu] service worker registration failed:", err);
          });
        });
      }
    </script>
  </body>
</html>
