---
import Sidebar from "../components/nav/Sidebar.astro";
import MobileNav from "../components/nav/MobileNav.astro";
import BottomNav from "../components/nav/BottomNav.astro";
import Toast from "../components/ui/Toast.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/index.css";

type Props = {
  title: string;
  activeNav: string;
};

const { title, activeNav } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050505" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} — Muscu App</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link u-sr-only-focusable">Aller au contenu</a>
    <Sidebar activeNav={activeNav} user={user} transition:persist />
    <MobileNav activeNav={activeNav} user={user} transition:persist />
    <BottomNav activeNav={activeNav} transition:persist />
    <main class="app-main" id="main-content">
      <slot />
      <Toast />
    </main>
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }
    </script>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    min-height: 100svh;
    background: var(--color-bg);
  }

  .app-main {
    padding: var(--space-page-padding);
    padding-top: calc(var(--space-page-padding) + var(--nav-toggle-top));
    padding-bottom: calc(var(--space-page-padding) + var(--nav-bar-height) + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    min-height: 100svh;
  }

  .skip-link {
    position: fixed;
    z-index: 9999;
    top: 0.8rem;
    left: 0.8rem;
    padding: 0.8rem 1.6rem;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    body {
      grid-template-columns: 1fr;
    }
  }
</style>
